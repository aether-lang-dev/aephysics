// A world as bytes and back (Box3D's world_snapshot.c, #149): everything a
// step reads, so a world loaded from a snapshot steps on exactly as the
// world it was taken from. The settings, the id pools, the solver sets
// with their sims, the bodies, the shapes with their geometry (each block
// once, however many shapes share it), the fat boxes, the contacts with
// their manifolds and mesh caches, the joints, the sensors, the islands,
// the three trees and the pair set, and the constraint graph's colours.
// What a step builds fresh each time (its events, its scratch, the
// solver's constraints) is not kept, nor is what the host wires in (user
// data, callbacks, the worker count), which the caller's WorldDef gives
// the loaded world.
//
// A snapshot is this build's: its layout tag folds in the sizes of every
// record it copies whole and the geometry's versions, so one from another
// layout is refused rather than misread. Every count is checked against
// the bytes before anything is copied, every geometry block is checked as
// bytes from outside are (hull_bytes_valid and its kin), every pointer a
// record carried is cleared before the record is used, and the loaded
// world must pass the world's own validation; a snapshot that fails any
// of it loads no world.

import std.string
import std.mem
import aephysics.math
import aephysics.native
import aephysics.basics
import aephysics.dynamic_tree
import aephysics.hull
import aephysics.mesh
import aephysics.height_field
import aephysics.compound
import aephysics.shape
import aephysics.broad_phase
import aephysics.mesh_contact
import aephysics.dynamics
import aephysics.joint_solver

exports (
    SNAPSHOT_MAGIC, SNAPSHOT_VERSION, snapshot_layout, save_world, load_world, restore_world, free_snapshot,
    BODY_SET_MAGIC, BODY_SET_VERSION, save_body_set, restore_body_set
)

extern memcpy(dst: ptr, src: ptr, size: int) -> ptr
extern memset(block: ptr, value: int, size: int) -> ptr

const SNAPSHOT_MAGIC = 0x4E535041    // "APSN", little-endian
const SNAPSHOT_VERSION = 13
const NULL_INDEX = 0 - 1

// --- the bytes written -------------------------------------------------------------------------------

struct SnapWriter {
    data: ptr
    size: int
    capacity: int
}

writer_grow(wr: *SnapWriter, n: int) {
    if wr.size + n <= wr.capacity { return }
    capacity = math.max_int(math.max_int(2 * wr.capacity, wr.size + n), 4096)
    block = basics.alloc(capacity)
    if wr.data != null {
        memcpy(block, wr.data, wr.size)
        basics.free_bytes(wr.data, wr.capacity)
    }
    wr.data = block
    wr.capacity = capacity
}

w_bytes(wr: *SnapWriter, src: ptr, n: int) {
    if n <= 0 { return }
    writer_grow(wr, n)
    memcpy(wr.data + wr.size, src, n)
    wr.size = wr.size + n
}

w_int(wr: *SnapWriter, v: int) {
    holder = v
    w_bytes(wr, (&holder) as ptr, 4)
}

w_long(wr: *SnapWriter, v: long) {
    holder = v
    w_bytes(wr, (&holder) as ptr, 8)
}

w_float(wr: *SnapWriter, v: float) {
    holder = v
    w_bytes(wr, (&holder) as ptr, 8)
}

w_bool(wr: *SnapWriter, v: bool) {
    if v { w_int(wr, 1) } else { w_int(wr, 0) }
}

w_vec3(wr: *SnapWriter, v: Vec3) {
    w_float(wr, v.x)
    w_float(wr, v.y)
    w_float(wr, v.z)
}

// A buffer: its stride, its count, its items.
w_buffer(wr: *SnapWriter, b: *Buffer) {
    w_int(wr, b.stride)
    w_int(wr, b.count)
    w_bytes(wr, b.data, b.count * b.stride)
}

w_ints(wr: *SnapWriter, a: *Ints) {
    w_int(wr, a.count)
    w_bytes(wr, a.data, a.count * 4)
}

w_bitset(wr: *SnapWriter, b: *BitSet) {
    w_int(wr, b.block_count)
    w_bytes(wr, b.bits, b.block_count * 8)
}

w_idpool(wr: *SnapWriter, p: *IdPool) {
    w_int(wr, p.next_index)
    w_ints(wr, &p.free_ids)
}

// The world's names, each once: its id, its length and its bytes.
w_names(wr: *SnapWriter, c: *NameCache) {
    count = basics.name_cache_count(c)
    w_int(wr, count)
    i = 0
    while i < count {
        w_int(wr, basics.name_cache_id_at(c, i))
        w_int(wr, basics.name_cache_length_at(c, i))
        w_bytes(wr, basics.name_cache_name_at(c, i), basics.name_cache_length_at(c, i))
        i = i + 1
    }
}

// --- the bytes read ----------------------------------------------------------------------------------

struct SnapReader {
    data: ptr
    size: int
    at: int
    ok: bool
}

r_need(rd: *SnapReader, n: int) -> bool {
    if rd.ok == false { return false }
    if n < 0 || n > rd.size - rd.at {
        rd.ok = false
        return false
    }
    return true
}

r_bytes(rd: *SnapReader, dst: ptr, n: int) {
    if r_need(rd, n) == false { return }
    if n > 0 { memcpy(dst, rd.data + rd.at, n) }
    rd.at = rd.at + n
}

r_int(rd: *SnapReader) -> int {
    holder = 0
    r_bytes(rd, (&holder) as ptr, 4)
    return holder
}

r_long(rd: *SnapReader) -> long {
    holder = 0 as long
    r_bytes(rd, (&holder) as ptr, 8)
    return holder
}

r_float(rd: *SnapReader) -> float {
    holder = 0.0
    r_bytes(rd, (&holder) as ptr, 8)
    return holder
}

r_bool(rd: *SnapReader) -> bool {
    v = r_int(rd)
    if v != 0 && v != 1 { rd.ok = false }
    return v == 1
}

r_vec3(rd: *SnapReader) -> Vec3 {
    x = r_float(rd)
    y = r_float(rd)
    z = r_float(rd)
    return math.vec3(x, y, z)
}

// A count the bytes left can hold, `size` bytes each, or the reader failed.
r_count(rd: *SnapReader, size: int) -> int {
    count = r_int(rd)
    if rd.ok == false { return 0 }
    if count < 0 || basics.section_fits(rd.at, count, size, rd.size) == false {
        rd.ok = false
        return 0
    }
    return count
}

// A buffer of `stride`-byte items; an empty one when the bytes are not one.
r_buffer(rd: *SnapReader, stride: int) -> Buffer {
    s = r_int(rd)
    if rd.ok && s != stride { rd.ok = false }
    count = r_count(rd, stride)
    if rd.ok == false { return basics.buffer_create(stride, 0) }
    b = basics.buffer_create(stride, count)
    r_bytes(rd, b.data, count * stride)
    b.count = count
    return b
}

r_ints(rd: *SnapReader) -> Ints {
    count = r_count(rd, 4)
    if rd.ok == false { return basics.ints_create(0) }
    a = basics.ints_create(count)
    r_bytes(rd, a.data, count * 4)
    a.count = count
    return a
}

r_bitset(rd: *SnapReader) -> BitSet {
    count = r_count(rd, 8)
    b = basics.bitset_create(64 * math.max_int(count, 1))
    if rd.ok == false { return b }
    r_bytes(rd, b.bits, count * 8)
    b.block_count = count
    return b
}

r_idpool(rd: *SnapReader) -> IdPool {
    next_index = r_int(rd)
    free_ids = r_ints(rd)
    if next_index < 0 { rd.ok = false }
    return IdPool { free_ids: free_ids, next_index: next_index }
}

// The world's names into its empty cache, each id once.
r_names(rd: *SnapReader, c: *NameCache) {
    count = r_count(rd, 8)
    i = 0
    while i < count && rd.ok {
        id = r_int(rd)
        n = r_int(rd)
        if rd.ok == false || n <= 0 || r_need(rd, n) == false || basics.name_cache_load(c, id, rd.data + rd.at, n) == false {
            rd.ok = false
            return
        }
        rd.at = rd.at + n
        i = i + 1
    }
}

// A body's or shape's name id: none, or one the cache holds.
name_known(c: *NameCache, id: int) -> bool { return id == basics.NULL_NAME || basics.name_cache_find(c, id) != null }

// --- the layout --------------------------------------------------------------------------------------

// This build's layout: the size of every record copied whole and the
// versions of the geometry and saved trees, folded by FNV-1a. A snapshot
// carries it, and one of another layout is refused.
snapshot_layout() -> long {
    hash = 0 - 3750763034362895579
    prime = 1099511628211 as long
    sizes_block = basics.alloc(25 * 8)
    sizes = sizes_block as long[]
    sizes[0] = sizeof(Body) as long
    sizes[1] = sizeof(WorldShape) as long
    sizes[2] = sizeof(Contact) as long
    sizes[3] = sizeof(Joint) as long
    sizes[4] = sizeof(BodySim) as long
    sizes[5] = sizeof(BodyState) as long
    sizes[6] = sizeof(JointSim) as long
    sizes[7] = sizeof(IslandSim) as long
    sizes[8] = sizeof(ContactLink) as long
    sizes[9] = sizeof(JointLink) as long
    sizes[10] = sizeof(ContactSpec) as long
    sizes[11] = sizeof(Manifold) as long
    sizes[12] = sizeof(DynamicTreeNode) as long
    sizes[13] = sizeof(TreeProxy) as long
    sizes[14] = sizeof(TriangleCache) as long
    sizes[15] = sizeof(SurfaceMaterial) as long
    sizes[16] = sizeof(AABBf) as long
    sizes[17] = sizeof(SetItem) as long
    sizes[18] = hull.HULL_VERSION as long
    sizes[19] = mesh.MESH_VERSION as long
    sizes[20] = height_field.HEIGHT_FIELD_VERSION as long
    sizes[21] = compound.COMPOUND_VERSION as long
    sizes[22] = dynamic_tree.tree_save_version()
    sizes[23] = dynamics.GRAPH_COLOR_COUNT as long
    sizes[24] = sizeof(Capacity) as long
    i = 0
    while i < 25 {
        hash = (hash ^ sizes[i]) * prime
        i = i + 1
    }
    basics.free_bytes(sizes_block, 25 * 8)
    return hash
}

// --- the geometry, each block once --------------------------------------------------------------------

struct GeometryEntry {
    kind: int
    block: ptr
    byte_count: int
}

struct GeometryTable {
    map: LongMap         // a block's address to its entry
    entries: Buffer      // GeometryEntry
}

geometry_entry(t: *GeometryTable, index: int) -> *GeometryEntry { return (t.entries.data + index * sizeof(GeometryEntry)) as *GeometryEntry }

// The shape's geometry block, with its kind and length, or NULL_INDEX for a
// shape that holds none (a sphere, a capsule).
shape_geometry_index(t: *GeometryTable, s: *WorldShape) -> int {
    kind = s.geometry.kind
    if kind == shape.SHAPE_HULL { return table_index(t, kind, s.geometry.hull as ptr, s.geometry.hull.byte_count) }
    if kind == shape.SHAPE_MESH { return table_index(t, kind, s.geometry.mesh.data as ptr, s.geometry.mesh.data.byte_count) }
    if kind == shape.SHAPE_HEIGHT_FIELD { return table_index(t, kind, s.geometry.height_field as ptr, s.geometry.height_field.byte_count) }
    if kind == shape.SHAPE_COMPOUND { return table_index(t, kind, s.geometry.compound as ptr, s.geometry.compound.byte_count) }
    return NULL_INDEX
}

table_index(t: *GeometryTable, kind: int, block: @keep ptr, byte_count: int) -> int {
    if block == null { return NULL_INDEX }
    key = mem.ptr_to_long(block)
    found = basics.map_get(&t.map, key, NULL_INDEX)
    if found != NULL_INDEX { return found }
    index = basics.buffer_push(&t.entries)
    entry = geometry_entry(t, index)
    entry.kind = kind
    entry.block = block
    entry.byte_count = byte_count
    basics.map_set(&t.map, key, index)
    return index
}

// --- saving ------------------------------------------------------------------------------------------

// The world as one block of bytes and its length, the block the caller's
// to free (free_snapshot); null and 0 for a world that is not one or is
// mid-step.
save_world(world_id: WorldId) -> (ptr, int) {
    if dynamics.world_is_valid(world_id) == false { return null, 0 }
    w = dynamics.get_world(world_id.index1 - 1)
    if w.locked { return null, 0 }
    wr = SnapWriter { data: null, size: 0, capacity: 0 }
    w_int(&wr, SNAPSHOT_MAGIC)
    w_int(&wr, SNAPSHOT_VERSION)
    w_long(&wr, snapshot_layout())

    // The settings and the scalars a step carries over.
    w_vec3(&wr, w.gravity)
    w_float(&wr, w.hit_event_threshold)
    w_float(&wr, w.restitution_threshold)
    w_int(&wr, w.restitution_iterations)
    w_bool(&wr, w.enable_restitution_propagation)
    w_bool(&wr, w.enable_kinematic_static_softness)
    w_bool(&wr, w.enable_kinematic_speculation)
    w_bool(&wr, w.enable_travel_speculation)
    w_bool(&wr, w.canonical_begin_order)
    w_bool(&wr, w.loaded_contacts)
    w_bool(&wr, w.loaded_limits)
    w_float(&wr, w.max_linear_speed)
    w_float(&wr, w.contact_speed)
    w_float(&wr, w.contact_hertz)
    w_float(&wr, w.contact_damping_ratio)
    w_float(&wr, w.contact_recycle_distance)
    w_bool(&wr, w.enable_sleep)
    w_bool(&wr, w.enable_warm_starting)
    w_bool(&wr, w.enable_continuous)
    w_bool(&wr, w.enable_speculative)
    w_long(&wr, w.step_index)
    w_int(&wr, w.split_island_id)
    w_int(&wr, w.split_island_candidate)
    w_float(&wr, w.split_sleep_time)
    w_int(&wr, w.compound_shape_count)
    w_float(&wr, w.inv_h)
    w_float(&wr, w.inv_dt)
    w_bytes(&wr, (&w.max_capacity) as ptr, sizeof(Capacity))

    w_idpool(&wr, &w.body_id_pool)
    w_idpool(&wr, &w.solver_set_id_pool)
    w_idpool(&wr, &w.joint_id_pool)
    w_idpool(&wr, &w.contact_id_pool)
    w_idpool(&wr, &w.island_id_pool)
    w_idpool(&wr, &w.shape_id_pool)

    // The solver sets; a free one is its index alone.
    w_int(&wr, w.solver_sets.count)
    i = 0
    while i < w.solver_sets.count {
        set = dynamics.solver_set_at(w, i)
        w_int(&wr, set.set_index)
        if set.set_index != NULL_INDEX {
            w_buffer(&wr, &set.body_sims)
            w_buffer(&wr, &set.body_states)
            w_buffer(&wr, &set.joint_sims)
            w_ints(&wr, &set.contact_indices)
            w_buffer(&wr, &set.island_sims)
        }
        i = i + 1
    }

    // The names, then the bodies, their pointers cleared in the copy.
    w_names(&wr, &w.names)
    w_int(&wr, w.bodies.count)
    i = 0
    while i < w.bodies.count {
        b = dynamics.body_at(w, i)
        start = wr.size
        w_bytes(&wr, b as ptr, sizeof(Body))
        body_copy = (wr.data + start) as *Body
        body_copy.user_data = null
        i = i + 1
    }

    // The geometry the live shapes hold, each block once.
    table = GeometryTable { map: basics.map_create(16), entries: basics.buffer_create(sizeof(GeometryEntry), 0) }
    indices_block = basics.alloc(math.max_int(w.shapes.count, 1) * 4)
    indices = indices_block as int[]
    i = 0
    while i < w.shapes.count {
        s = dynamics.world_shape_at(w, i)
        indices[i] = NULL_INDEX
        if s.id != NULL_INDEX { indices[i] = shape_geometry_index(&table, s) }
        i = i + 1
    }
    w_int(&wr, table.entries.count)
    i = 0
    while i < table.entries.count {
        entry = geometry_entry(&table, i)
        w_int(&wr, entry.kind)
        w_int(&wr, entry.byte_count)
        start = wr.size
        w_bytes(&wr, entry.block, entry.byte_count)
        if entry.kind == shape.SHAPE_COMPOUND {
            // The copy's tree pointers cleared, as convert_compound_to_bytes clears them.
            compound_copy = (wr.data + start) as *CompoundData
            compound_copy.tree.nodes = null
            compound_copy.tree.proxies = null
            compound_copy.tree.stack = null
            compound_copy.tree.stack_dist = null
        }
        i = i + 1
    }

    // The shapes, their pointers cleared in the copy; then each one's
    // geometry entry and its materials.
    w_int(&wr, w.shapes.count)
    i = 0
    while i < w.shapes.count {
        s = dynamics.world_shape_at(w, i)
        start = wr.size
        w_bytes(&wr, s as ptr, sizeof(WorldShape))
        shape_copy = (wr.data + start) as *WorldShape
        shape_copy.geometry.hull = null
        shape_copy.geometry.mesh.data = null
        shape_copy.geometry.height_field = null
        shape_copy.geometry.compound = null
        shape_copy.materials = null
        shape_copy.user_data = null
        shape_copy.user_shape = null
        w_int(&wr, indices[i])
        if s.id != NULL_INDEX && s.materials != null {
            w_int(&wr, s.material_count)
            w_bytes(&wr, s.materials, s.material_count * sizeof(SurfaceMaterial))
        } else {
            w_int(&wr, 0)
        }
        i = i + 1
    }
    basics.free_bytes(indices_block, math.max_int(w.shapes.count, 1) * 4)
    basics.map_destroy(&table.map)
    basics.buffer_destroy(&table.entries)

    w_buffer(&wr, &w.fat_aabbs)

    // The contacts: the record with its pointers cleared, then a live
    // contact's manifolds and, for a mesh contact, its triangles.
    w_int(&wr, w.contacts.count)
    i = 0
    while i < w.contacts.count {
        c = dynamics.contact_at(w, i)
        start = wr.size
        w_bytes(&wr, c as ptr, sizeof(Contact))
        contact_copy = (wr.data + start) as *Contact
        contact_copy.manifolds = null
        is_mesh = (c.flags & dynamics.SIM_MESH_CONTACT) != 0
        if is_mesh {
            // The copy says what a load makes of it: the triangles without
            // their spare room.
            copy_cache = dynamics.mesh_cache_of(contact_copy)
            copy_cache.triangles = null
            copy_cache.capacity = copy_cache.count
        }
        if c.contact_id != NULL_INDEX {
            w_bytes(&wr, c.manifolds, c.manifold_count * sizeof(Manifold))
            if is_mesh {
                cache = dynamics.mesh_cache_of(c)
                w_int(&wr, cache.count)
                w_bytes(&wr, cache.triangles, cache.count * sizeof(TriangleCache))
            }
        }
        i = i + 1
    }

    w_int(&wr, w.joints.count)
    i = 0
    while i < w.joints.count {
        start = wr.size
        w_bytes(&wr, dynamics.joint_at(w, i) as ptr, sizeof(Joint))
        joint_copy = (wr.data + start) as *Joint
        joint_copy.user_data = null
        i = i + 1
    }

    w_int(&wr, w.sensors.count)
    i = 0
    while i < w.sensors.count {
        sensor = dynamics.sensor_at(w, i)
        w_int(&wr, sensor.shape_id)
        w_buffer(&wr, &sensor.hits)
        w_buffer(&wr, &sensor.overlaps1)
        w_buffer(&wr, &sensor.overlaps2)
        i = i + 1
    }

    // The islands; a free one is its scalars alone.
    w_int(&wr, w.islands.count)
    i = 0
    while i < w.islands.count {
        island = dynamics.island_at(w, i)
        w_int(&wr, island.set_index)
        w_int(&wr, island.local_index)
        w_int(&wr, island.island_id)
        w_int(&wr, island.constraint_remove_count)
        if island.island_id != NULL_INDEX {
            w_ints(&wr, &island.bodies)
            w_buffer(&wr, &island.contacts)
            w_buffer(&wr, &island.joints)
        }
        i = i + 1
    }

    // The trees as dynamic_tree saves them, and the pair set whole (its
    // slots in place, so a walk over it meets the pairs in the same order).
    t = 0
    while t < broad_phase.BODY_TYPE_COUNT {
        block, byte_count = dynamic_tree.tree_save_bytes(broad_phase.tree(&w.broad_phase, t))
        w_int(&wr, byte_count)
        w_bytes(&wr, block, byte_count)
        if block != null { basics.free_bytes(block, byte_count) }
        t = t + 1
    }
    w_int(&wr, w.broad_phase.pair_set.capacity)
    w_int(&wr, w.broad_phase.pair_set.count)
    w_bytes(&wr, w.broad_phase.pair_set.items, w.broad_phase.pair_set.capacity * sizeof(SetItem))

    // The colours: each one's bodies (but the overflow's), joints and contacts.
    k = 0
    while k < dynamics.GRAPH_COLOR_COUNT {
        color = graph_color(w, k)
        if k < dynamics.OVERFLOW_INDEX { w_bitset(&wr, &color.body_set) }
        w_buffer(&wr, &color.joint_sims)
        w_ints(&wr, &color.convex_contacts)
        w_buffer(&wr, &color.contacts)
        k = k + 1
    }

    // The block trimmed to its length, so the caller frees what it holds.
    exact = basics.alloc(wr.size)
    memcpy(exact, wr.data, wr.size)
    basics.free_bytes(wr.data, wr.capacity)
    return exact, wr.size
}

graph_color(w: *World, k: int) -> *GraphColor { return (w.constraint_graph.colors + k * sizeof(GraphColor)) as *GraphColor }

// A snapshot block save_world gave.
free_snapshot(block: ptr, byte_count: int) {
    if block != null { basics.free_bytes(block, byte_count) }
}

// --- loading -----------------------------------------------------------------------------------------

// A world made from `def` (its workers, callbacks and user data; the
// snapshot gives everything else) and filled from the snapshot in `size`
// bytes; a null id when the bytes are not a snapshot of this layout or any
// part of them fails its checks, in which case nothing is left behind.
load_world(def: *WorldDef, data: ptr, size: int) -> WorldId {
    null_id = WorldId { index1: 0, generation: 0 }
    if data == null || size < 16 { return null_id }
    rd = SnapReader { data: data, size: size, at: 0, ok: true }
    if r_int(&rd) != SNAPSHOT_MAGIC || r_int(&rd) != SNAPSHOT_VERSION || r_long(&rd) != snapshot_layout() { return null_id }
    world_id = dynamics.create_world(def)
    if dynamics.world_is_valid(world_id) == false { return null_id }
    w = dynamics.get_world(world_id.index1 - 1)
    if fill_world(w, &rd) == false || rd.at != rd.size || world_valid(w) == false {
        dynamics.destroy_world(world_id)
        return null_id
    }
    return world_id
}

// The world `world_id` made what the snapshot holds, in place: its id,
// workers, callbacks, filters and user data stay (the reference's
// deserialize into a shell, what a replay rewinds with). False when the
// world is not one, is mid-step or records, or when the bytes are not a
// snapshot of this layout or fail any check; the world is then left empty,
// as a new world from `def` is, never half loaded. `def` gives the
// capacities the emptied world starts from.
restore_world(world_id: WorldId, def: *WorldDef, data: ptr, size: int) -> bool {
    if data == null || size < 16 { return false }
    rd = SnapReader { data: data, size: size, at: 0, ok: true }
    if r_int(&rd) != SNAPSHOT_MAGIC || r_int(&rd) != SNAPSHOT_VERSION || r_long(&rd) != snapshot_layout() { return false }
    if dynamics.world_is_valid(world_id) == false { return false }
    w = dynamics.get_world(world_id.index1 - 1)
    if w.locked || w.recording != null { return false }
    // The host's drawables are kept for the shapes still in their slot
    // after the restore (the same generation: the same shape), as the
    // reference keeps them, so a seek does not remake every one; the rest
    // are given back.
    kept_count = w.shapes.count
    kept_block = basics.alloc(math.max_int(kept_count, 1) * 8)
    kept = kept_block as ptr[]
    generations_block = basics.alloc(math.max_int(kept_count, 1) * 4)
    generations = generations_block as int[]
    i = 0
    while i < kept_count {
        old = dynamics.world_shape_at(w, i)
        kept[i] = null
        generations[i] = old.generation
        if old.id == i {
            kept[i] = old.user_shape
            old.user_shape = null
        }
        i = i + 1
    }
    restored = dynamics.reset_world(world_id, def)
    if restored && (fill_world(w, &rd) == false || rd.at != rd.size || world_valid(w) == false) {
        dynamics.reset_world(world_id, def)
        restored = false
    }
    i = 0
    while i < kept_count {
        if restored && i < w.shapes.count && kept[i] != null {
            now = dynamics.world_shape_at(w, i)
            if now.id == i && now.generation == generations[i] {
                now.user_shape = kept[i]
                kept[i] = null
            }
        }
        if kept[i] != null {
            destroy = w.destroy_debug_shape
            destroy(kept[i], w.debug_shape_context)
        }
        i = i + 1
    }
    basics.free_bytes(kept_block, math.max_int(kept_count, 1) * 8)
    basics.free_bytes(generations_block, math.max_int(kept_count, 1) * 4)
    return restored
}

// The world's own invariants over everything loaded.
world_valid(w: *World) -> bool {
    if dynamics.validate_solver_sets(w) == false { return false }
    if dynamics.validate_contacts(w) == false { return false }
    if dynamics.validate_joints(w) == false { return false }
    return broad_phase.validate_broad_phase(&w.broad_phase)
}

// Every section into the fresh world. The world stays one destroy_world can
// free at every point: a container is replaced only by a whole one, and a
// record's pointers are cleared before it joins its container.
fill_world(w: *World, rd: *SnapReader) -> bool {
    w.gravity = r_vec3(rd)
    w.hit_event_threshold = r_float(rd)
    w.restitution_threshold = r_float(rd)
    w.restitution_iterations = r_int(rd)
    w.enable_restitution_propagation = r_bool(rd)
    w.enable_kinematic_static_softness = r_bool(rd)
    w.enable_kinematic_speculation = r_bool(rd)
    w.enable_travel_speculation = r_bool(rd)
    w.canonical_begin_order = r_bool(rd)
    w.loaded_contacts = r_bool(rd)
    w.loaded_limits = r_bool(rd)
    w.max_linear_speed = r_float(rd)
    w.contact_speed = r_float(rd)
    w.contact_hertz = r_float(rd)
    w.contact_damping_ratio = r_float(rd)
    w.contact_recycle_distance = r_float(rd)
    w.enable_sleep = r_bool(rd)
    w.enable_warm_starting = r_bool(rd)
    w.enable_continuous = r_bool(rd)
    w.enable_speculative = r_bool(rd)
    w.step_index = r_long(rd)
    w.split_island_id = r_int(rd)
    w.split_island_candidate = r_int(rd)
    w.split_sleep_time = r_float(rd)
    w.compound_shape_count = r_int(rd)
    w.inv_h = r_float(rd)
    w.inv_dt = r_float(rd)
    r_bytes(rd, (&w.max_capacity) as ptr, sizeof(Capacity))
    if rd.ok == false { return false }
    if w.restitution_iterations < 0 || w.restitution_iterations > dynamics.MAX_RESTITUTION_ITERATIONS { return false }

    // The fresh world's solver sets and pools give way first, then each
    // pool and set is read whole.
    i = 0
    while i < w.solver_sets.count {
        if dynamics.solver_set_at(w, i).set_index != NULL_INDEX { dynamics.destroy_solver_set(w, i) }
        i = i + 1
    }
    w.solver_sets.count = 0
    replace_pool(&w.body_id_pool, r_idpool(rd))
    replace_pool(&w.solver_set_id_pool, r_idpool(rd))
    replace_pool(&w.joint_id_pool, r_idpool(rd))
    replace_pool(&w.contact_id_pool, r_idpool(rd))
    replace_pool(&w.island_id_pool, r_idpool(rd))
    replace_pool(&w.shape_id_pool, r_idpool(rd))
    if rd.ok == false { return false }

    set_count = r_count(rd, 4)
    i = 0
    while i < set_count && rd.ok {
        set_index = r_int(rd)
        index = basics.buffer_push(&w.solver_sets)
        set = dynamics.solver_set_at(w, index)
        memset(set as ptr, 0, sizeof(SolverSet))
        set.set_index = NULL_INDEX
        if set_index != NULL_INDEX && rd.ok {
            set.body_sims = r_buffer(rd, sizeof(BodySim))
            set.body_states = r_buffer(rd, sizeof(BodyState))
            set.joint_sims = r_buffer(rd, sizeof(JointSim))
            set.contact_indices = r_ints(rd)
            set.island_sims = r_buffer(rd, sizeof(IslandSim))
            set.set_index = set_index
            if set_index != i { rd.ok = false }
        }
        i = i + 1
    }
    if rd.ok == false || w.solver_sets.count < 3 { return false }

    // The names, then the bodies, each record with its pointers cleared and
    // its name one the names hold.
    r_names(rd, &w.names)
    if rd.ok == false { return false }
    body_count = r_count(rd, sizeof(Body))
    basics.buffer_destroy(&w.bodies)
    w.bodies = basics.buffer_create(sizeof(Body), math.max_int(body_count, 16))
    i = 0
    while i < body_count && rd.ok {
        index = basics.buffer_push(&w.bodies)
        b = dynamics.body_at(w, index)
        r_bytes(rd, b as ptr, sizeof(Body))
        b.user_data = null
        if b.set_index != NULL_INDEX && name_known(&w.names, b.name_id) == false { rd.ok = false }
        i = i + 1
    }
    if rd.ok == false { return false }

    // The geometry, each block copied into the world and checked as bytes
    // from outside are: a hull goes into the hull database when a shape
    // takes it, a mesh, height field or compound becomes the world's own.
    geometry_count = r_count(rd, 8)
    kinds_block = basics.alloc(math.max_int(geometry_count, 1) * 4)
    kinds = kinds_block as int[]
    blocks_block = basics.alloc(math.max_int(geometry_count, 1) * 8)
    blocks = blocks_block as ptr[]
    loaded = 0
    while loaded < geometry_count && rd.ok {
        kind = r_int(rd)
        byte_count = r_int(rd)
        if byte_count <= 0 || r_need(rd, byte_count) == false {
            rd.ok = false
            break
        }
        block = basics.alloc(byte_count)
        memcpy(block, rd.data + rd.at, byte_count)
        rd.at = rd.at + byte_count
        valid = false
        if kind == shape.SHAPE_HULL { valid = hull.bytes_valid(block as *HullData, byte_count) && (block as *HullData).byte_count == byte_count }
        else if kind == shape.SHAPE_MESH { valid = mesh.bytes_valid(block as *MeshData, byte_count) && (block as *MeshData).byte_count == byte_count }
        else if kind == shape.SHAPE_HEIGHT_FIELD { valid = height_field.bytes_valid(block as *HeightFieldData, byte_count) && (block as *HeightFieldData).byte_count == byte_count }
        else if kind == shape.SHAPE_COMPOUND { valid = compound.convert_bytes_to_compound(block, byte_count) != null }
        if valid == false {
            basics.free_bytes(block, byte_count)
            rd.ok = false
            break
        }
        // The world owns all but the hulls, which the database copies.
        if kind != shape.SHAPE_HULL { dynamics.adopt_geometry(w, block, byte_count) }
        kinds[loaded] = kind
        blocks[loaded] = block
        loaded = loaded + 1
    }

    // The shapes: each record with its pointers cleared, then its geometry
    // and materials; its name one the names hold.
    shape_count = r_count(rd, sizeof(WorldShape))
    if rd.ok {
        basics.buffer_destroy(&w.shapes)
        w.shapes = basics.buffer_create(sizeof(WorldShape), math.max_int(shape_count, 16))
    }
    i = 0
    while i < shape_count && rd.ok {
        index = basics.buffer_push(&w.shapes)
        s = dynamics.world_shape_at(w, index)
        r_bytes(rd, s as ptr, sizeof(WorldShape))
        s.geometry.hull = null
        s.geometry.mesh.data = null
        s.geometry.height_field = null
        s.geometry.compound = null
        s.materials = null
        s.user_data = null
        s.user_shape = null
        if s.id != NULL_INDEX && name_known(&w.names, s.name_id) == false { rd.ok = false }
        geometry_index = r_int(rd)
        material_count = r_count(rd, sizeof(SurfaceMaterial))
        if rd.ok == false { break }
        if s.id != NULL_INDEX {
            kind = s.geometry.kind
            needs_block = kind == shape.SHAPE_HULL || kind == shape.SHAPE_MESH || kind == shape.SHAPE_HEIGHT_FIELD || kind == shape.SHAPE_COMPOUND
            if kind < 0 || kind >= shape.SHAPE_KIND_COUNT { rd.ok = false }
            else if needs_block {
                if geometry_index < 0 || geometry_index >= loaded || kinds[geometry_index] != kind { rd.ok = false }
                else if kind == shape.SHAPE_HULL { s.geometry.hull = dynamics.add_hull_to_database(w, blocks[geometry_index] as *HullData) }
                else if kind == shape.SHAPE_MESH { s.geometry.mesh.data = blocks[geometry_index] as *MeshData }
                else if kind == shape.SHAPE_HEIGHT_FIELD { s.geometry.height_field = blocks[geometry_index] as *HeightFieldData }
                else { s.geometry.compound = blocks[geometry_index] as *CompoundData }
            } else if geometry_index != NULL_INDEX { rd.ok = false }
        } else if geometry_index != NULL_INDEX { rd.ok = false }
        if material_count > 0 && rd.ok {
            if s.id == NULL_INDEX || material_count != s.material_count { rd.ok = false }
            else {
                s.materials = basics.alloc(material_count * sizeof(SurfaceMaterial))
                r_bytes(rd, s.materials, material_count * sizeof(SurfaceMaterial))
            }
        }
        i = i + 1
    }
    // The hulls' copies were only for the database to take its own from.
    k = 0
    while k < loaded {
        if kinds[k] == shape.SHAPE_HULL { hull.destroy_hull(blocks[k] as *HullData) }
        k = k + 1
    }
    basics.free_bytes(kinds_block, math.max_int(geometry_count, 1) * 4)
    basics.free_bytes(blocks_block, math.max_int(geometry_count, 1) * 8)
    if rd.ok == false { return false }

    fat = r_buffer(rd, sizeof(AABBf))
    basics.buffer_destroy(&w.fat_aabbs)
    w.fat_aabbs = fat
    if rd.ok == false || w.fat_aabbs.count != w.shapes.count { return false }

    // The contacts: each record with its manifolds and mesh cache cleared,
    // then the live ones' manifolds into the world's allocators.
    contact_count = r_count(rd, sizeof(Contact))
    if rd.ok {
        basics.buffer_destroy(&w.contacts)
        w.contacts = basics.buffer_create(sizeof(Contact), math.max_int(contact_count, 16))
    }
    i = 0
    while i < contact_count && rd.ok {
        index = basics.buffer_push(&w.contacts)
        c = dynamics.contact_at(w, index)
        r_bytes(rd, c as ptr, sizeof(Contact))
        manifold_count = c.manifold_count
        c.manifolds = null
        c.manifold_count = 0
        is_mesh = (c.flags & dynamics.SIM_MESH_CONTACT) != 0
        if is_mesh {
            cache = dynamics.mesh_cache_of(c)
            cache.triangles = null
            cache.count = 0
            cache.capacity = 0
        }
        if c.contact_id != NULL_INDEX {
            if manifold_count < 0 || basics.section_fits(rd.at, manifold_count, sizeof(Manifold), rd.size) == false {
                rd.ok = false
                break
            }
            if manifold_count > 0 {
                dynamics.allocate_manifolds(w, c, manifold_count)
                r_bytes(rd, c.manifolds, manifold_count * sizeof(Manifold))
            }
            if is_mesh {
                triangle_count = r_count(rd, sizeof(TriangleCache))
                if triangle_count > 0 && rd.ok {
                    cache = dynamics.mesh_cache_of(c)
                    cache.triangles = basics.alloc(triangle_count * sizeof(TriangleCache))
                    cache.capacity = triangle_count
                    r_bytes(rd, cache.triangles, triangle_count * sizeof(TriangleCache))
                    cache.count = triangle_count
                }
            }
        } else if manifold_count != 0 { rd.ok = false }
        i = i + 1
    }
    if rd.ok == false { return false }

    joint_count = r_count(rd, sizeof(Joint))
    basics.buffer_destroy(&w.joints)
    w.joints = basics.buffer_create(sizeof(Joint), math.max_int(joint_count, 16))
    i = 0
    while i < joint_count && rd.ok {
        index = basics.buffer_push(&w.joints)
        j = dynamics.joint_at(w, index)
        r_bytes(rd, j as ptr, sizeof(Joint))
        j.user_data = null
        i = i + 1
    }
    if rd.ok == false { return false }

    sensor_count = r_count(rd, 4)
    i = 0
    while i < w.sensors.count {
        sensor = dynamics.sensor_at(w, i)
        basics.buffer_destroy(&sensor.hits)
        basics.buffer_destroy(&sensor.overlaps1)
        basics.buffer_destroy(&sensor.overlaps2)
        i = i + 1
    }
    w.sensors.count = 0
    i = 0
    while i < sensor_count && rd.ok {
        index = basics.buffer_push(&w.sensors)
        sensor = dynamics.sensor_at(w, index)
        memset(sensor as ptr, 0, sizeof(Sensor))
        sensor.shape_id = r_int(rd)
        sensor.hits = r_buffer(rd, 8)
        sensor.overlaps1 = r_buffer(rd, 8)
        sensor.overlaps2 = r_buffer(rd, 8)
        i = i + 1
    }
    if rd.ok == false { return false }

    island_count = r_count(rd, 16)
    basics.buffer_destroy(&w.islands)
    w.islands = basics.buffer_create(sizeof(Island), math.max_int(island_count, 16))
    i = 0
    while i < island_count && rd.ok {
        index = basics.buffer_push(&w.islands)
        island = dynamics.island_at(w, index)
        memset(island as ptr, 0, sizeof(Island))
        island.set_index = r_int(rd)
        island.local_index = r_int(rd)
        island_id = r_int(rd)
        island.constraint_remove_count = r_int(rd)
        island.island_id = NULL_INDEX
        if island_id != NULL_INDEX && rd.ok {
            island.bodies = r_ints(rd)
            island.contacts = r_buffer(rd, sizeof(ContactLink))
            island.joints = r_buffer(rd, sizeof(JointLink))
            island.island_id = island_id
        }
        i = i + 1
    }
    if rd.ok == false { return false }

    // The trees: each loaded as dynamic_tree loads saved bytes (its own
    // checks), then put in place of the fresh one.
    t = 0
    while t < broad_phase.BODY_TYPE_COUNT && rd.ok {
        byte_count = r_int(rd)
        if r_need(rd, byte_count) == false { break }
        aligned = basics.alloc(math.max_int(byte_count, 1))
        memcpy(aligned, rd.data + rd.at, byte_count)
        rd.at = rd.at + byte_count
        tree = dynamic_tree.tree_load_bytes(aligned, byte_count, 1.0)
        basics.free_bytes(aligned, math.max_int(byte_count, 1))
        if tree.nodes == null {
            rd.ok = false
            break
        }
        slot = broad_phase.tree(&w.broad_phase, t)
        dynamic_tree.tree_destroy(slot)
        memcpy(slot as ptr, (&tree) as ptr, sizeof(DynamicTree))
        t = t + 1
    }
    if rd.ok == false { return false }
    capacity = r_int(rd)
    pair_count = r_int(rd)
    if rd.ok == false || capacity < 16 || basics.is_power_of_2(capacity) == false || pair_count < 0 || 2 * pair_count > capacity { return false }
    if basics.section_fits(rd.at, capacity, sizeof(SetItem), rd.size) == false { return false }
    basics.set_destroy(&w.broad_phase.pair_set)
    w.broad_phase.pair_set = HashSet { items: basics.alloc(capacity * sizeof(SetItem)), capacity: capacity, count: pair_count }
    r_bytes(rd, w.broad_phase.pair_set.items, capacity * sizeof(SetItem))

    // The colours: each container read whole in place of the fresh one's;
    // the step's constraints start empty.
    k = 0
    while k < dynamics.GRAPH_COLOR_COUNT && rd.ok {
        color = graph_color(w, k)
        if k < dynamics.OVERFLOW_INDEX {
            bodies = r_bitset(rd)
            basics.bitset_destroy(&color.body_set)
            color.body_set = bodies
        }
        joints = r_buffer(rd, sizeof(JointSim))
        basics.buffer_destroy(&color.joint_sims)
        color.joint_sims = joints
        convex = r_ints(rd)
        basics.ints_destroy(&color.convex_contacts)
        color.convex_contacts = convex
        specs = r_buffer(rd, sizeof(ContactSpec))
        basics.buffer_destroy(&color.contacts)
        color.contacts = specs
        k = k + 1
    }
    return rd.ok
}

// The fresh world's pool given way to the loaded one.
replace_pool(dst: *IdPool, src: @keep IdPool) {
    basics.idpool_destroy(dst)
    dst.free_ids = src.free_ids
    dst.next_index = src.next_index
}

// --- a set of bodies' solver state (#189) ----------------------------------------------------------------

// What a late-joining peer needs to step a ragdoll on as the world it joins
// does: the solver's state of one set of bodies as bytes, ids local to the
// set, written into another world that holds the same bodies (the same
// shapes, the same joints between them) however that world was built. Per
// body its sim and state (pose, velocities, the step's bookkeeping), its
// sleep timer and its shapes' bounds as the broad phase holds them; per
// joint between two of the bodies its warm-start impulses and graph colour;
// per contact of theirs its manifolds, narrow-phase cache, recycling pose
// and colour, made again in the order the first world made them; and their
// island's count of removed constraints. Box3D has no such call: its
// snapshot (save_world here) copies a whole world between worlds built
// alike, which two peers' worlds are not.
//
// The set is read awake or asleep as one (a settled ragdoll sleeps whole,
// the case a late joiner meets most): asleep, the world it is written into
// puts it to sleep too once it is written, so the two lie alike. It is
// written into bodies that are awake. A contact's shape outside the set
// (the ground) is named by its shape id, which restore_body_set translates
// through its shape map.
const BODY_SET_MAGIC = 0x53425041    // "APBS", little-endian
// 2: the body sims lead with the flags and local centre, and a convex
// contact's cache with its axis (aephysics#229); a set of either order is
// the other's bytes misread, so the version says which.
const BODY_SET_VERSION = 2

// The flags a contact carries as its state; the rest are its shapes' and
// bodies' settings, which the world it is made again in gives it.
body_set_contact_state() -> int {
    return dynamics.CONTACT_TOUCHING | dynamics.CONTACT_HIT_EVENT | dynamics.SIM_TOUCHING | dynamics.SIM_ENABLE_HIT_EVENT | dynamics.RELATIVE_TRANSFORM_VALID
}

// The set's world body ids from its BodyId[count], each valid and all in
// one solver set, awake or asleep (`sleeping_too`); with the set's index.
// Null (and the block freed) when one is not.
set_bodies(w: *World, bodies: ptr, count: int, sleeping_too: bool) -> (ptr, int) {
    local_block = basics.alloc(count * 4)
    local = local_block as int[]
    ids = bodies as BodyId[]
    set_index = NULL_INDEX
    i = 0
    while i < count {
        fits = dynamics.body_is_valid(ids[i]) && ids[i].world0 == w.world_id
        if fits {
            body = dynamics.get_body_full_id(w, ids[i])
            if i == 0 { set_index = body.set_index }
            fits = body.set_index == set_index &&
                   (set_index == dynamics.AWAKE_SET || sleeping_too && set_index >= dynamics.FIRST_SLEEPING_SET)
            local[i] = body.id
        }
        if fits == false {
            basics.free_bytes(local_block, count * 4)
            return null, NULL_INDEX
        }
        i = i + 1
    }
    return local_block, set_index
}

// A world body id's place in the set, or -1.
local_index_of(local: int[], count: int, body_id: int) -> int {
    i = 0
    while i < count {
        if local[i] == body_id { return i }
        i = i + 1
    }
    return 0 - 1
}

// A shape's place in its body's list, and the shape at a place (NULL_INDEX past the end).
shape_ordinal(w: *World, body: *Body, shape_id: int) -> int {
    n = 0
    id = body.head_shape_id
    while id != NULL_INDEX && id != shape_id {
        n = n + 1
        id = dynamics.world_shape_at(w, id).next_shape_id
    }
    return n
}

nth_shape(w: *World, body: *Body, n: int) -> int {
    id = body.head_shape_id
    k = 0
    while id != NULL_INDEX && k < n {
        id = dynamics.world_shape_at(w, id).next_shape_id
        k = k + 1
    }
    return id
}

// A joint key's next on its body's list, and the body at its other end.
joint_key_next(w: *World, key: int) -> int {
    j = dynamics.joint_at(w, key >> 1)
    if (key & 1) == 0 { return j.edge_a.next_key }
    return j.edge_b.next_key
}

joint_key_other(w: *World, key: int) -> int {
    j = dynamics.joint_at(w, key >> 1)
    if (key & 1) == 0 { return j.edge_b.body_id }
    return j.edge_a.body_id
}

// A joint's place among the joints on `body_id`'s list that reach the same
// body, of the same kind, from the same side.
joint_ordinal(w: *World, body_id: int, key: int) -> int {
    j = dynamics.joint_at(w, key >> 1)
    other = joint_key_other(w, key)
    n = 0
    k = dynamics.body_at(w, body_id).head_joint_key
    while k != NULL_INDEX && k != key {
        if joint_key_other(w, k) == other && dynamics.joint_at(w, k >> 1).kind == j.kind && (k & 1) == (key & 1) { n = n + 1 }
        k = joint_key_next(w, k)
    }
    return n
}

// A contact key's body at the other end.
contact_key_other(w: *World, key: int) -> int {
    c = dynamics.contact_at(w, key >> 1)
    if (key & 1) == 0 { return c.edge_b.body_id }
    return c.edge_a.body_id
}

// A contact's shape: the set's (its body's place and the shape's place on
// it) or one outside it (its shape id and generation).
w_shape_ref(wr: *SnapWriter, w: *World, shape_id: int, local: int[], count: int) {
    s = dynamics.world_shape_at(w, shape_id)
    at = local_index_of(local, count, s.body_id)
    w_int(wr, at)
    if at >= 0 {
        w_int(wr, shape_ordinal(w, dynamics.body_at(w, s.body_id), shape_id))
        w_int(wr, 0)
    } else {
        w_int(wr, shape_id + 1)
        w_int(wr, s.generation)
    }
}

// The set's solver state as bytes: a heap block of the engine's allocator
// and its size (free_snapshot gives it back); null and 0 when the world or
// a body is not valid, the bodies are not all awake or all asleep in one
// island's set, or the world is stepping.
save_body_set(world_id: WorldId, bodies: ptr, count: int) -> (ptr, int) {
    if count <= 0 || bodies == null || dynamics.world_is_valid(world_id) == false { return null, 0 }
    w = dynamics.get_world(world_id.index1 - 1)
    if w.locked { return null, 0 }
    local_block, set_index = set_bodies(w, bodies, count, true)
    if local_block == null { return null, 0 }
    local = local_block as int[]
    wr = SnapWriter { data: null, size: 0, capacity: 0 }
    w_int(&wr, BODY_SET_MAGIC)
    w_int(&wr, BODY_SET_VERSION)
    w_long(&wr, snapshot_layout())
    w_int(&wr, count)
    asleep = set_index != dynamics.AWAKE_SET
    w_bool(&wr, asleep)
    no_state = basics.alloc(sizeof(BodyState))
    memset(no_state, 0, sizeof(BodyState))
    (no_state as *BodyState).dq = Quatf { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }

    // The bodies, and their shapes' bounds.
    i = 0
    while i < count {
        body = dynamics.body_at(w, local[i])
        w_bytes(&wr, dynamics.get_body_sim(w, body) as ptr, sizeof(BodySim))
        // A sleeping body keeps no state: it is at rest.
        if asleep { w_bytes(&wr, no_state, sizeof(BodyState)) } else { w_bytes(&wr, dynamics.get_body_state(w, body) as ptr, sizeof(BodyState)) }
        w_float(&wr, body.sleep_time)
        w_int(&wr, body.shape_count)
        shape_id = body.head_shape_id
        while shape_id != NULL_INDEX {
            s = dynamics.world_shape_at(w, shape_id)
            w_bytes(&wr, (&s.aabb) as ptr, sizeof(AABB))
            fat = dynamics.shape_fat_aabb(w, shape_id)
            w_bytes(&wr, (&fat) as ptr, sizeof(AABBf))
            shape_id = s.next_shape_id
        }
        i = i + 1
    }

    // The joints between two of them, each once (from the body earlier in the set).
    joint_count = 0
    i = 0
    while i < count {
        key = dynamics.body_at(w, local[i]).head_joint_key
        while key != NULL_INDEX {
            if local_index_of(local, count, joint_key_other(w, key)) > i { joint_count = joint_count + 1 }
            key = joint_key_next(w, key)
        }
        i = i + 1
    }
    w_int(&wr, joint_count)
    impulses = basics.alloc(dynamics.JOINT_IMPULSE_COUNT * 8)
    i = 0
    while i < count {
        key = dynamics.body_at(w, local[i]).head_joint_key
        while key != NULL_INDEX {
            other = local_index_of(local, count, joint_key_other(w, key))
            if other > i {
                j = dynamics.joint_at(w, key >> 1)
                w_int(&wr, i)
                w_int(&wr, other)
                w_int(&wr, key & 1)
                w_int(&wr, j.kind)
                w_int(&wr, joint_ordinal(w, local[i], key))
                w_int(&wr, j.color_index)
                n = dynamics.joint_impulses_io(dynamics.get_joint_sim(w, j), j.kind, impulses as float[], false)
                w_int(&wr, n)
                k = 0
                while k < n {
                    w_float(&wr, (impulses as float[])[k])
                    k = k + 1
                }
            }
            key = joint_key_next(w, key)
        }
        i = i + 1
    }
    basics.free_bytes(impulses, dynamics.JOINT_IMPULSE_COUNT * 8)

    // The contacts of any of them, each once, in the order the world made them.
    total = 0
    i = 0
    while i < count {
        total = total + dynamics.body_at(w, local[i]).contact_count
        i = i + 1
    }
    found_block = basics.alloc(math.max_int(total, 1) * 4)
    found = found_block as int[]
    found_count = 0
    i = 0
    while i < count {
        key = dynamics.body_at(w, local[i]).head_contact_key
        while key != NULL_INDEX {
            other = local_index_of(local, count, contact_key_other(w, key))
            if other < 0 || other > i {
                found[found_count] = key >> 1
                found_count = found_count + 1
            }
            key = dynamics.contact_edge_next(w, key)
        }
        i = i + 1
    }
    sort_ints(found, found_count)
    w_int(&wr, found_count)
    state_flags = body_set_contact_state()
    i = 0
    while i < found_count {
        c = dynamics.contact_at(w, found[i])
        w_shape_ref(&wr, w, c.shape_id_a, local, count)
        w_shape_ref(&wr, w, c.shape_id_b, local, count)
        w_int(&wr, c.child_index)
        w_int(&wr, c.flags & state_flags)
        color = NULL_INDEX
        if (c.flags & dynamics.CONTACT_TOUCHING) != 0 { color = c.color_index }
        w_int(&wr, color)
        w_int(&wr, c.manifold_count)
        w_bytes(&wr, c.manifolds, c.manifold_count * sizeof(Manifold))
        is_mesh = (c.flags & dynamics.SIM_MESH_CONTACT) != 0
        w_bool(&wr, is_mesh)
        if is_mesh {
            cache = dynamics.mesh_cache_of(c)
            w_bytes(&wr, (&cache.query_bounds) as ptr, sizeof(AABB))
            w_int(&wr, cache.count)
            w_bytes(&wr, cache.triangles, cache.count * sizeof(TriangleCache))
        } else {
            w_bytes(&wr, (&c.caches) as ptr, dynamics.CONTACT_CACHE_WORDS * 8)
        }
        w_bytes(&wr, (&c.cached_rotation_a) as ptr, sizeof(Quatf))
        w_bytes(&wr, (&c.cached_rotation_b) as ptr, sizeof(Quatf))
        w_bytes(&wr, (&c.cached_relative_p) as ptr, sizeof(Vec3f))
        w_bytes(&wr, (&c.cached_relative_q) as ptr, sizeof(Quatf))
        w_float(&wr, c.friction as float)
        w_float(&wr, c.restitution as float)
        w_float(&wr, c.rolling_resistance as float)
        w_bytes(&wr, (&c.tangent_velocity) as ptr, sizeof(Vec3f))
        i = i + 1
    }
    basics.free_bytes(found_block, math.max_int(total, 1) * 4)

    // Their island's removed constraints (when to split it before it sleeps).
    island_id = dynamics.body_at(w, local[0]).island_id
    removed = 0 - 1
    if island_id != NULL_INDEX { removed = dynamics.island_at(w, island_id).constraint_remove_count }
    w_int(&wr, removed)
    basics.free_bytes(no_state, sizeof(BodyState))
    basics.free_bytes(local_block, count * 4)
    return wr.data, wr.size
}

sort_ints(a: int[], n: int) {
    i = 1
    while i < n {
        v = a[i]
        k = i - 1
        while k >= 0 && a[k] > v {
            a[k + 1] = a[k]
            k = k - 1
        }
        a[k + 1] = v
        i = i + 1
    }
}

// The set's solver state from save_body_set's bytes into `world_id`, whose
// bodies `bodies` (BodyId[count]) are the saved set's in the same order:
// each body's shapes as many, each joint between two of them found again
// (the same kind between the same bodies), each contact's shapes resolved
// (a shape outside the set through `shape_map`, ShapeId[2 * map_count] of
// pairs: the id in the world saved, then the id here; one not in the map is
// taken as it is). The world's own contacts of the set are destroyed and
// the block's made in their place, touching ones linked and coloured as
// they were (a colour taken by a constraint outside the set gives way to
// the one the world picks). The whole block is checked before anything is
// written: false, and the world as it was, when it does not fit, a body
// is not awake, or the world is stepping or recording.
restore_body_set(world_id: WorldId, bodies: ptr, count: int, shape_map: ptr, map_count: int, data: ptr, size: int) -> bool {
    if count <= 0 || bodies == null || data == null || size <= 0 || map_count < 0 || dynamics.world_is_valid(world_id) == false { return false }
    if map_count > 0 && shape_map == null { return false }
    w = dynamics.get_world(world_id.index1 - 1)
    if w.locked || w.recording != null { return false }
    local_block, _set_index = set_bodies(w, bodies, count, false)
    if local_block == null { return false }
    local = local_block as int[]
    fits = apply_body_set(w, local, count, shape_map, map_count, data, size, false)
    if fits { apply_body_set(w, local, count, shape_map, map_count, data, size, true) }
    basics.free_bytes(local_block, count * 4)
    return fits
}

// A contact's shape from the block: the set's, or one outside it through
// the map; NULL_INDEX when it is not one here.
r_shape_ref(rd: *SnapReader, w: *World, local: int[], count: int, shape_map: ptr, map_count: int) -> int {
    at = r_int(rd)
    first = r_int(rd)
    second = r_int(rd)
    if rd.ok == false || at >= count { return NULL_INDEX }
    if at >= 0 {
        if first < 0 { return NULL_INDEX }
        return nth_shape(w, dynamics.body_at(w, local[at]), first)
    }
    index1 = first
    generation = second
    if map_count > 0 {
        pairs = shape_map as ShapeId[]
        m = 0
        while m < map_count {
            if pairs[2 * m].index1 == first && pairs[2 * m].generation == second {
                index1 = pairs[2 * m + 1].index1
                generation = pairs[2 * m + 1].generation
            }
            m = m + 1
        }
    }
    id = ShapeId { index1: index1, world0: w.world_id, generation: generation }
    if dynamics.shape_is_valid(id) == false { return NULL_INDEX }
    if local_index_of(local, count, dynamics.world_shape_at(w, index1 - 1).body_id) >= 0 { return NULL_INDEX }
    return index1 - 1
}

same_box(a: AABBf, b: AABBf) -> bool {
    return a.lower.x == b.lower.x && a.lower.y == b.lower.y && a.lower.z == b.lower.z &&
           a.upper.x == b.upper.x && a.upper.y == b.upper.y && a.upper.z == b.upper.z
}

// One pass over the block: checking it (apply false) or writing it (apply
// true, once the check passed). Every read is checked in both passes.
apply_body_set(w: *World, local: int[], count: int, shape_map: ptr, map_count: int, data: ptr, size: int, apply: bool) -> bool {
    rd = SnapReader { data: data, size: size, at: 0, ok: true }
    if r_int(&rd) != BODY_SET_MAGIC || r_int(&rd) != BODY_SET_VERSION || r_long(&rd) != snapshot_layout() || r_int(&rd) != count || rd.ok == false { return false }
    asleep = r_bool(&rd)
    // Asleep, the set goes to sleep here as one island: its bodies must be one.
    if asleep {
        island_id = dynamics.body_at(w, local[0]).island_id
        i = 1
        while i < count {
            if dynamics.body_at(w, local[i]).island_id != island_id { return false }
            i = i + 1
        }
    }
    if apply {
        // The world's own contacts of the set make way for the block's,
        // with no end events: the block's come back touching, with none.
        i = 0
        while i < count {
            body = dynamics.body_at(w, local[i])
            while body.head_contact_key != NULL_INDEX {
                gone = dynamics.contact_at(w, body.head_contact_key >> 1)
                gone.flags = gone.flags & (0 - 1 - dynamics.CONTACT_ENABLE_CONTACT_EVENTS)
                dynamics.destroy_contact(w, gone, false)
            }
            i = i + 1
        }
    }
    ok = true
    hold_size = math.max_int(math.max_int(sizeof(BodySim), sizeof(BodyState)), math.max_int(sizeof(AABB), dynamics.CONTACT_CACHE_WORDS * 8))
    hold = basics.alloc(hold_size)

    // The bodies and their shapes' bounds.
    i = 0
    while i < count && ok {
        body = dynamics.body_at(w, local[i])
        if apply {
            sim = dynamics.get_body_sim(w, body)
            keep = sim.body_id
            r_bytes(&rd, sim as ptr, sizeof(BodySim))
            sim.body_id = keep
            r_bytes(&rd, dynamics.get_body_state(w, body) as ptr, sizeof(BodyState))
            body.sleep_time = r_float(&rd)
        } else {
            r_bytes(&rd, hold, sizeof(BodySim))
            r_bytes(&rd, hold, sizeof(BodyState))
            r_float(&rd)
        }
        shape_count = r_int(&rd)
        if rd.ok == false || shape_count != body.shape_count { ok = false }
        shape_id = body.head_shape_id
        while ok && shape_id != NULL_INDEX {
            s = dynamics.world_shape_at(w, shape_id)
            fat = AABBf { lower: Vec3f { x: 0.0, y: 0.0, z: 0.0 }, upper: Vec3f { x: 0.0, y: 0.0, z: 0.0 } }
            if apply { r_bytes(&rd, (&s.aabb) as ptr, sizeof(AABB)) } else { r_bytes(&rd, hold, sizeof(AABB)) }
            r_bytes(&rd, (&fat) as ptr, sizeof(AABBf))
            if apply {
                dynamics.set_shape_fat_aabb(w, shape_id, fat)
                if s.proxy_key != NULL_INDEX && same_box(broad_phase.get_aabb(&w.broad_phase, s.proxy_key), fat) == false {
                    broad_phase.move_proxy(&w.broad_phase, s.proxy_key, fat)
                }
            }
            shape_id = s.next_shape_id
        }
        i = i + 1
    }

    // The joints: each found again, its impulses written, then all coloured.
    joint_count = 0
    if ok { joint_count = r_int(&rd) }
    if rd.ok == false || joint_count < 0 || joint_count > 4096 { ok = false }
    ids_block = basics.alloc(math.max_int(joint_count, 1) * 4)
    colors_block = basics.alloc(math.max_int(joint_count, 1) * 4)
    joint_ids = ids_block as int[]
    joint_colors = colors_block as int[]
    impulses = basics.alloc(dynamics.JOINT_IMPULSE_COUNT * 8)
    probe = basics.alloc(dynamics.JOINT_IMPULSE_COUNT * 8)
    k = 0
    while k < joint_count && ok {
        from = r_int(&rd)
        to = r_int(&rd)
        side = r_int(&rd)
        kind = r_int(&rd)
        ordinal = r_int(&rd)
        color = r_int(&rd)
        n = r_int(&rd)
        if rd.ok == false || from < 0 || from >= count || to < 0 || to >= count || n < 0 || n > dynamics.JOINT_IMPULSE_COUNT {
            ok = false
            break
        }
        m = 0
        while m < n {
            (impulses as float[])[m] = r_float(&rd)
            m = m + 1
        }
        found = NULL_INDEX
        seen = 0
        key = dynamics.body_at(w, local[from]).head_joint_key
        while key != NULL_INDEX && found == NULL_INDEX {
            if joint_key_other(w, key) == local[to] && dynamics.joint_at(w, key >> 1).kind == kind && (key & 1) == side {
                if seen == ordinal { found = key >> 1 }
                seen = seen + 1
            }
            key = joint_key_next(w, key)
        }
        // A joint named twice is refused: it would be coloured twice.
        twice = 0
        while twice < k && found != NULL_INDEX {
            if joint_ids[twice] == found { found = NULL_INDEX }
            twice = twice + 1
        }
        if found == NULL_INDEX || rd.ok == false {
            ok = false
            break
        }
        j = dynamics.joint_at(w, found)
        joint_sim = dynamics.get_joint_sim(w, j)
        if dynamics.joint_impulses_io(joint_sim, kind, probe as float[], false) != n {
            ok = false
            break
        }
        if apply { dynamics.joint_impulses_io(joint_sim, kind, impulses as float[], true) }
        joint_ids[k] = found
        joint_colors[k] = color
        k = k + 1
    }
    if apply && ok { dynamics.recolor_joints(w, ids_block, colors_block, joint_count) }
    basics.free_bytes(ids_block, math.max_int(joint_count, 1) * 4)
    basics.free_bytes(colors_block, math.max_int(joint_count, 1) * 4)
    basics.free_bytes(impulses, dynamics.JOINT_IMPULSE_COUNT * 8)
    basics.free_bytes(probe, dynamics.JOINT_IMPULSE_COUNT * 8)

    // The contacts, made again in the order the world saved made them.
    contact_count = 0
    if ok { contact_count = r_int(&rd) }
    if rd.ok == false || contact_count < 0 || basics.section_fits(rd.at, contact_count, 32, rd.size) == false { ok = false }
    if ok == false { contact_count = 0 }
    pairs_block = basics.alloc(math.max_int(contact_count, 1) * 12)
    pair_a = pairs_block as int[]
    pair_b = (pairs_block + math.max_int(contact_count, 1) * 4) as int[]
    pair_child = (pairs_block + math.max_int(contact_count, 1) * 8) as int[]
    state_flags = body_set_contact_state()
    k = 0
    while k < contact_count && ok {
        shape_a = r_shape_ref(&rd, w, local, count, shape_map, map_count)
        shape_b = r_shape_ref(&rd, w, local, count, shape_map, map_count)
        child_index = r_int(&rd)
        flags = r_int(&rd)
        contact_color = r_int(&rd)
        manifold_count = r_int(&rd)
        if rd.ok == false || shape_a == NULL_INDEX || shape_b == NULL_INDEX || manifold_count < 0 ||
           basics.section_fits(rd.at, manifold_count, sizeof(Manifold), rd.size) == false {
            ok = false
            break
        }
        // A contact the world makes as the block's was made (a pair that
        // collides, in that order, mesh or convex as recorded), reaching the
        // set, and named once: what the check passes, the write does.
        contact_kind = dynamics.contact_kind_for(w, shape_a, shape_b, child_index)
        in_set = local_index_of(local, count, dynamics.world_shape_at(w, shape_a).body_id) >= 0 ||
                 local_index_of(local, count, dynamics.world_shape_at(w, shape_b).body_id) >= 0
        named = 0
        while named < k && contact_kind >= 0 {
            if pair_a[named] == shape_a && pair_b[named] == shape_b && pair_child[named] == child_index { contact_kind = 0 - 1 }
            named = named + 1
        }
        if contact_kind < 0 || in_set == false {
            ok = false
            break
        }
        pair_a[k] = shape_a
        pair_b[k] = shape_b
        pair_child[k] = child_index
        made = NULL_INDEX
        if apply {
            dynamics.create_contact(w, dynamics.world_shape_at(w, shape_a), dynamics.world_shape_at(w, shape_b), child_index)
            made = dynamics.find_contact(w, shape_a, shape_b, child_index)
            if made == NULL_INDEX {
                ok = false
                break
            }
            c = dynamics.contact_at(w, made)
            c.flags = (c.flags & (0 - 1 - state_flags)) | (flags & state_flags & (0 - 1 - dynamics.CONTACT_TOUCHING))
            dynamics.allocate_manifolds(w, c, manifold_count)
            r_bytes(&rd, c.manifolds, manifold_count * sizeof(Manifold))
        } else {
            rd.at = rd.at + manifold_count * sizeof(Manifold)
        }
        is_mesh = r_bool(&rd)
        if is_mesh != (contact_kind == 1) {
            ok = false
            break
        }
        if is_mesh {
            if apply {
                r_bytes(&rd, (&dynamics.mesh_cache_of(dynamics.contact_at(w, made)).query_bounds) as ptr, sizeof(AABB))
            } else {
                r_bytes(&rd, hold, sizeof(AABB))
            }
            triangle_count = r_count(&rd, sizeof(TriangleCache))
            if rd.ok == false {
                ok = false
                break
            }
            if apply {
                cache = dynamics.mesh_cache_of(dynamics.contact_at(w, made))
                mesh_contact.cache_destroy(cache)
                cache.triangles = basics.alloc(math.max_int(triangle_count, 1) * sizeof(TriangleCache))
                cache.capacity = math.max_int(triangle_count, 1)
                r_bytes(&rd, cache.triangles, triangle_count * sizeof(TriangleCache))
                cache.count = triangle_count
            } else {
                rd.at = rd.at + triangle_count * sizeof(TriangleCache)
            }
        } else if apply {
            r_bytes(&rd, (&dynamics.contact_at(w, made).caches) as ptr, dynamics.CONTACT_CACHE_WORDS * 8)
        } else {
            r_bytes(&rd, hold, dynamics.CONTACT_CACHE_WORDS * 8)
        }
        if apply {
            c = dynamics.contact_at(w, made)
            r_bytes(&rd, (&c.cached_rotation_a) as ptr, sizeof(Quatf))
            r_bytes(&rd, (&c.cached_rotation_b) as ptr, sizeof(Quatf))
            r_bytes(&rd, (&c.cached_relative_p) as ptr, sizeof(Vec3f))
            r_bytes(&rd, (&c.cached_relative_q) as ptr, sizeof(Quatf))
            c.friction = r_float(&rd) as f32
            c.restitution = r_float(&rd) as f32
            c.rolling_resistance = r_float(&rd) as f32
            r_bytes(&rd, (&c.tangent_velocity) as ptr, sizeof(Vec3f))
            if (flags & dynamics.CONTACT_TOUCHING) != 0 { dynamics.touch_restored_contact(w, c, contact_color) }
        } else {
            r_bytes(&rd, hold, 3 * sizeof(Quatf) + sizeof(Vec3f))
            r_float(&rd)
            r_float(&rd)
            r_float(&rd)
            r_bytes(&rd, hold, sizeof(Vec3f))
        }
        if rd.ok == false || rd.at > size { ok = false }
        k = k + 1
    }
    basics.free_bytes(pairs_block, math.max_int(contact_count, 1) * 12)
    removed = 0
    if ok { removed = r_int(&rd) }
    if apply && ok && removed >= 0 {
        island_id = dynamics.body_at(w, local[0]).island_id
        if island_id != NULL_INDEX {
            island = dynamics.island_at(w, island_id)
            // The saved island's count, but an island that also holds bodies
            // outside the set (a contact this world had merged it through,
            // destroyed above) keeps its own removals, so it still splits.
            if island.bodies.count > count { island.constraint_remove_count = island.constraint_remove_count + removed }
            else { island.constraint_remove_count = removed }
            // Read asleep, the set sleeps here too, as one island: put to
            // sleep with no split pending, then given its count back, which
            // the sleeping island keeps until it wakes.
            if asleep {
                island.constraint_remove_count = 0
                dynamics.try_sleep_island(w, island_id)
                dynamics.island_at(w, island_id).constraint_remove_count = removed
            }
        }
    }
    basics.free_bytes(hold, hold_size)
    return ok && rd.ok && rd.at == size
}
