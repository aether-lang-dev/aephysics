motor_joint_get_max_spring_force(id: JointId) -> float { return dynamics.motor_joint_of(sim_of(id, dynamics.JOINT_MOTOR)).max_spring_force }
motor_joint_set_max_spring_torque(id: JointId, value: float) {
    if nonnegative(value) == false { return }
    base = sim_of(id, dynamics.JOINT_MOTOR)
