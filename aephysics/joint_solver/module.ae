// aephysics.joint_solver -- the seven joints solved: for each kind its
// prepare (the frames in world space relative to the centres of mass,
// the effective masses, the springs' softness), warm start (last
// step's impulses reapplied), and solve (soft or rigid constraints
// with speculative limits, springs and motors, the position error from
// the bodies' deltas); the kinds' accessors (limits, springs, motors,
// the current angles and translations, the forces and torques from the
// impulses); and joint.c's dispatch, which clamps the constraint hertz
// to a quarter of the sub-step rate.
//
// This is Box3D's distance_joint.c, motor_joint.c, parallel_joint.c,
// prismatic_joint.c, revolute_joint.c, spherical_joint.c, weld_joint.c
// and wheel_joint.c with joint.c's solver half (Erin Catto, MIT), the
// reference this engine is measured against. Names are the reference's
// without its prefix, in snake case: b3PrepareRevoluteJoint is
// prepare_revolute_joint, b3DistanceJoint_SetLength is
// distance_joint_set_length. The kinds' data lives in the joint sim's
// block (dynamics.distance_joint_of and its siblings); the step
// context is the contact solver's.
import std.string
import aephysics.math
import aephysics.basics
import aephysics.dynamics
import aephysics.contact_solver

exports (
    prepare_joint, warm_start_joint, solve_joint, dummy_state, point_mass_matrix, prepare_joints, warm_start_joints, solve_joints, prepare_joints_range, warm_start_joints_range, solve_joints_range,
    joint_get_constraint_force, joint_get_constraint_torque, get_joint_constraint_force, get_joint_constraint_torque,
    prepare_distance_joint, warm_start_distance_joint, solve_distance_joint,
    prepare_motor_joint, warm_start_motor_joint, solve_motor_joint,
    prepare_parallel_joint, warm_start_parallel_joint, solve_parallel_joint,
    prepare_prismatic_joint, warm_start_prismatic_joint, solve_prismatic_joint,
    prepare_revolute_joint, warm_start_revolute_joint, solve_revolute_joint,
    prepare_spherical_joint, warm_start_spherical_joint, solve_spherical_joint,
    prepare_weld_joint, warm_start_weld_joint, solve_weld_joint,
    prepare_wheel_joint, warm_start_wheel_joint, solve_wheel_joint,
    distance_joint_set_length, distance_joint_get_length, distance_joint_enable_limit, distance_joint_is_limit_enabled,
    distance_joint_set_length_range, distance_joint_get_min_length, distance_joint_get_max_length, distance_joint_get_current_length,
    distance_joint_enable_spring, distance_joint_is_spring_enabled, distance_joint_set_spring_force_range,
    distance_joint_get_lower_spring_force, distance_joint_get_upper_spring_force, distance_joint_set_spring_hertz,
    distance_joint_set_spring_damping_ratio, distance_joint_get_spring_hertz, distance_joint_get_spring_damping_ratio,
    distance_joint_enable_motor, distance_joint_is_motor_enabled, distance_joint_set_motor_speed, distance_joint_get_motor_speed,
    distance_joint_get_motor_force, distance_joint_set_max_motor_force, distance_joint_get_max_motor_force,
    motor_joint_set_linear_velocity, motor_joint_get_linear_velocity, motor_joint_set_angular_velocity, motor_joint_get_angular_velocity,
    motor_joint_set_max_velocity_torque, motor_joint_get_max_velocity_torque, motor_joint_set_max_velocity_force,
    motor_joint_get_max_velocity_force, motor_joint_set_linear_hertz, motor_joint_get_linear_hertz, motor_joint_set_linear_damping_ratio,
    motor_joint_get_linear_damping_ratio, motor_joint_set_angular_hertz, motor_joint_get_angular_hertz,
    motor_joint_set_angular_damping_ratio, motor_joint_get_angular_damping_ratio, motor_joint_set_max_spring_force,
    motor_joint_get_max_spring_force, motor_joint_set_max_spring_torque, motor_joint_get_max_spring_torque,
    parallel_joint_set_spring_hertz, parallel_joint_get_spring_hertz, parallel_joint_set_spring_damping_ratio,
    parallel_joint_get_spring_damping_ratio, parallel_joint_set_max_torque, parallel_joint_get_max_torque,
    prismatic_joint_enable_spring, prismatic_joint_is_spring_enabled, prismatic_joint_set_spring_hertz, prismatic_joint_get_spring_hertz,
    prismatic_joint_set_spring_damping_ratio, prismatic_joint_get_spring_damping_ratio, prismatic_joint_set_target_translation,
    prismatic_joint_get_target_translation, prismatic_joint_enable_limit, prismatic_joint_is_limit_enabled, prismatic_joint_get_lower_limit,
    prismatic_joint_get_upper_limit, prismatic_joint_set_limits, prismatic_joint_get_translation, prismatic_joint_enable_motor,
    prismatic_joint_is_motor_enabled, prismatic_joint_set_motor_speed, prismatic_joint_get_motor_speed, prismatic_joint_set_max_motor_force,
    prismatic_joint_get_max_motor_force, prismatic_joint_get_motor_force, prismatic_joint_get_speed,
    revolute_joint_enable_limit, revolute_joint_is_limit_enabled, revolute_joint_get_lower_limit, revolute_joint_get_upper_limit,
    revolute_joint_set_limits, revolute_joint_get_angle, revolute_joint_enable_spring, revolute_joint_is_spring_enabled,
    revolute_joint_set_target_angle, revolute_joint_get_target_angle, revolute_joint_set_spring_hertz, revolute_joint_get_spring_hertz,
    revolute_joint_set_spring_damping_ratio, revolute_joint_get_spring_damping_ratio, revolute_joint_enable_motor,
    revolute_joint_is_motor_enabled, revolute_joint_set_motor_speed, revolute_joint_get_motor_speed, revolute_joint_set_max_motor_torque,
    revolute_joint_get_max_motor_torque, revolute_joint_get_motor_torque,
    spherical_joint_enable_cone_limit, spherical_joint_is_cone_limit_enabled, spherical_joint_get_cone_limit, spherical_joint_set_cone_limit,
    spherical_joint_get_cone_angle, spherical_joint_set_cone_axis, spherical_joint_get_cone_axis,
    spherical_joint_set_cone_ellipse, spherical_joint_get_cone_minor_angle, spherical_joint_get_cone_major_axis, spherical_joint_enable_twist_limit, spherical_joint_is_twist_limit_enabled,
    spherical_joint_get_lower_twist_limit, spherical_joint_get_upper_twist_limit, spherical_joint_set_twist_limits,
    spherical_joint_get_twist_angle, spherical_joint_enable_spring, spherical_joint_is_spring_enabled, spherical_joint_set_target_rotation,
    spherical_joint_get_target_rotation, spherical_joint_set_spring_hertz, spherical_joint_get_spring_hertz,
    spherical_joint_set_spring_damping_ratio, spherical_joint_get_spring_damping_ratio, spherical_joint_enable_motor,
    spherical_joint_is_motor_enabled, spherical_joint_set_motor_velocity, spherical_joint_get_motor_velocity,
    spherical_joint_set_max_motor_torque, spherical_joint_get_max_motor_torque, spherical_joint_get_motor_torque,
    weld_joint_set_linear_hertz, weld_joint_get_linear_hertz, weld_joint_set_linear_damping_ratio, weld_joint_get_linear_damping_ratio,
    weld_joint_set_angular_hertz, weld_joint_get_angular_hertz, weld_joint_set_angular_damping_ratio, weld_joint_get_angular_damping_ratio,
    wheel_joint_enable_suspension, wheel_joint_is_suspension_enabled, wheel_joint_set_suspension_hertz, wheel_joint_get_suspension_hertz,
    wheel_joint_set_suspension_damping_ratio, wheel_joint_get_suspension_damping_ratio, wheel_joint_enable_suspension_limit,
    wheel_joint_is_suspension_limit_enabled, wheel_joint_get_lower_suspension_limit, wheel_joint_get_upper_suspension_limit,
    wheel_joint_set_suspension_limits, wheel_joint_enable_spin_motor, wheel_joint_is_spin_motor_enabled, wheel_joint_set_spin_motor_speed,
    wheel_joint_get_spin_motor_speed, wheel_joint_set_max_spin_torque, wheel_joint_get_max_spin_torque, wheel_joint_enable_steering,
    wheel_joint_is_steering_enabled, wheel_joint_set_steering_hertz, wheel_joint_get_steering_hertz, wheel_joint_set_steering_damping_ratio,
    wheel_joint_get_steering_damping_ratio, wheel_joint_set_max_steering_torque, wheel_joint_get_max_steering_torque,
    wheel_joint_enable_steering_limit, wheel_joint_is_steering_limit_enabled, wheel_joint_get_lower_steering_limit,
    wheel_joint_get_upper_steering_limit, wheel_joint_set_steering_limits, wheel_joint_set_target_steering_angle,
    wheel_joint_get_target_steering_angle, wheel_joint_get_spin_speed, wheel_joint_get_spin_torque, wheel_joint_get_steering_angle,
    wheel_joint_get_steering_torque
)

extern sqrt(x: float) -> float

const NULL_INDEX = 0 - 1

// --- shared pieces --------------------------------------------------------------------------------------------

var g_dummy: ptr = null   // BodyState: a static body's, identity, never written

dummy_state() -> *BodyState {
    if g_dummy == null {
        g_dummy = basics.alloc(sizeof(BodyState))
        d = g_dummy as *BodyState
        d.dq = math.quatf_identity()
    }
    return g_dummy as *BodyState
}

state_of(ctx: *StepContext, index: int) -> *BodyState {
    if index == NULL_INDEX { return dummy_state() }
    return (ctx.states + index * sizeof(BodyState)) as *BodyState
}

// The bodies of a joint for its prepare: their sims (wherever their sets
// are) and their indices in the awake set (NULL_INDEX when not awake).
struct JointBodies {
    sim_a: *BodySim
    sim_b: *BodySim
    index_a: int
    index_b: int
}

// The base of every prepare: the bodies' inverse masses onto the sim,
// the fixed-rotation flag when the inertias sum to nothing.
prepare_base(base: *JointSim, ctx: *StepContext) -> JointBodies {
    w = ctx.world
    body_a = dynamics.body_at(w, base.body_id_a)
    body_b = dynamics.body_at(w, base.body_id_b)
    sim_a = dynamics.get_body_sim(w, body_a)
    sim_b = dynamics.get_body_sim(w, body_b)
    base.inv_mass_a = sim_a.inv_mass
    base.inv_mass_b = sim_b.inv_mass
    base.inv_inertia_a = sim_a.inv_inertia_world
    base.inv_inertia_b = sim_b.inv_inertia_world
    base.fixed_rotation = math.det(math.add_mm(math.widen_mat3(sim_a.inv_inertia_world), math.widen_mat3(sim_b.inv_inertia_world))) < 1000.0 * math.TINY
    index_a = NULL_INDEX
    if body_a.set_index == dynamics.AWAKE_SET { index_a = body_a.local_index }
    index_b = NULL_INDEX
    if body_b.set_index == dynamics.AWAKE_SET { index_b = body_b.local_index }
    return JointBodies { sim_a: sim_a, sim_b: sim_b, index_a: index_a, index_b: index_b }
}

// A joint frame in world rotation, its origin relative to the centre of mass.
world_frame(sim: *BodySim, local_frame: Transform) -> Transform {
    return Transform { p: math.rotate_vector(sim.transform.q, math.sub(local_frame.p, math.widen3(sim.local_center))),
                       q: math.mul_quat(sim.transform.q, local_frame.q) }
}

// The perpendicular axes of a hinge: half the rotated relative rotation's x and y.
perp_axis(quat_a: Quat, rel_q: Quat, axis: Vec3) -> Vec3 {
    return math.mul_sv(0.5, math.rotate_vector(quat_a, math.add(math.mul_sv(rel_q.w, axis), math.cross(math.qv(rel_q), axis))))
}

// skew(r) i skew(r), the products with skew's zeros left out: each
// surviving term is the one mul_mm forms, in the order it adds them, and
// a product with zero added to a sum is exact, so the result is
// mul_mm(skew(r), mul_mm(i, skew(r))) to the bit at a quarter of the work.
skew_sandwich(i: *Matrix3, r: Vec3) -> Matrix3 {
    // m = i skew(r), column by column.
    mx = math.vec3(i.cy.x * r.z + i.cz.x * (0.0 - r.y), i.cy.y * r.z + i.cz.y * (0.0 - r.y), i.cy.z * r.z + i.cz.z * (0.0 - r.y))
    my = math.vec3(i.cx.x * (0.0 - r.z) + i.cz.x * r.x, i.cx.y * (0.0 - r.z) + i.cz.y * r.x, i.cx.z * (0.0 - r.z) + i.cz.z * r.x)
    mz = math.vec3(i.cx.x * r.y + i.cy.x * (0.0 - r.x), i.cx.y * r.y + i.cy.y * (0.0 - r.x), i.cx.z * r.y + i.cy.z * (0.0 - r.x))
    // skew(r) m.
    return Matrix3 { cx: skew_times(r, mx), cy: skew_times(r, my), cz: skew_times(r, mz) }
}

// skew(r) c: mul_mv's terms without its zero ones.
skew_times(r: Vec3, c: Vec3) -> Vec3 {
    return math.vec3((0.0 - r.z) * c.y + r.y * c.z, r.z * c.x + (0.0 - r.x) * c.z, (0.0 - r.y) * c.x + r.x * c.y)
}

// The point constraint's mass matrix: (mA + mB) I - skew(rA) iA skew(rA) - skew(rB) iB skew(rB).
point_mass_matrix(m_a: float, i_a: Matrix3, r_a: Vec3, m_b: float, i_b: Matrix3, r_b: Vec3) -> Matrix3 {
    k_a = skew_sandwich(&i_a, r_a)
    k_b = skew_sandwich(&i_b, r_b)
    k = math.negate_mat3(math.add_mm(k_a, k_b))
    k.cx.x = k.cx.x + m_a + m_b
    k.cy.y = k.cy.y + m_a + m_b
    k.cz.z = k.cz.z + m_a + m_b
    return k
}

// The velocities written back to the dynamic bodies only.
store_velocities(state_a: *BodyState, v_a: Vec3, w_a: Vec3, state_b: *BodyState, v_b: Vec3, w_b: Vec3) {
    if (state_a.flags & dynamics.DYNAMIC_FLAG) != 0 {
        state_a.v = math.narrow3(v_a)
        state_a.w = math.narrow3(w_a)
    }
    if (state_b.flags & dynamics.DYNAMIC_FLAG) != 0 {
        state_b.v = math.narrow3(v_b)
        state_b.w = math.narrow3(w_b)
    }
}

// The bias, mass scale and impulse scale of a limit: speculative when
// the limit is clear, the constraint's softness when violated and biased.
struct LimitScales {
    bias: float
    mass_scale: float
    impulse_scale: float
}

limit_scales(base: *JointSim, ctx: *StepContext, c: float, use_bias: bool) -> LimitScales {
    if c > 0.0 { return LimitScales { bias: c * ctx.inv_h, mass_scale: 1.0, impulse_scale: 0.0 } }
    if use_bias {
        return LimitScales { bias: base.constraint_softness.bias_rate * c, mass_scale: base.constraint_softness.mass_scale,
                             impulse_scale: base.constraint_softness.impulse_scale }
    }
    return LimitScales { bias: 0.0, mass_scale: 1.0, impulse_scale: 0.0 }
}

// A joint id's sim when it is of the kind, else null.
sim_of(id: JointId, kind: int) -> *JointSim { return dynamics.get_joint_sim_of_kind(id, kind) }

// A setter's number: finite and not below zero (stiffness, damping,
// maximum forces and torques, lengths). A NaN or an infinity, or a
// negative one of these, leaves the joint as it was, as the reference
// asserts at the same places (b3IsValidFloat).
nonnegative(x: float) -> bool { return math.is_valid_float(x) && x >= 0.0 }

// --- distance joint -----------------------------------------------------------------------------------------------

// C = |pB - pA| - L along the axis u: K = mA + mB + (rA x u) iA (rA x u) + (rB x u) iB (rB x u).
prepare_distance_joint(base: *JointSim, ctx: *StepContext) {
    bodies = prepare_base(base, ctx)
    j = dynamics.distance_joint_of(base)
    j.index_a = bodies.index_a
    j.index_b = bodies.index_b
    sim_a = bodies.sim_a
    sim_b = bodies.sim_b
    j.anchor_a = math.rotate_vector(sim_a.transform.q, math.sub(base.local_frame_a.p, math.widen3(sim_a.local_center)))
    j.anchor_b = math.rotate_vector(sim_b.transform.q, math.sub(base.local_frame_b.p, math.widen3(sim_b.local_center)))
    j.delta_center = math.sub(sim_b.center, sim_a.center)
    r_a = j.anchor_a
    r_b = j.anchor_b
    axis = math.normalize(math.add(math.sub(r_b, r_a), j.delta_center))
    cr_a = math.cross(r_a, axis)
    cr_b = math.cross(r_b, axis)
    k = base.inv_mass_a + base.inv_mass_b + math.dot(cr_a, math.mul_mv(math.widen_mat3(base.inv_inertia_a), cr_a)) + math.dot(cr_b, math.mul_mv(math.widen_mat3(base.inv_inertia_b), cr_b))
    j.axial_mass = 0.0
    if k > 0.0 { j.axial_mass = 1.0 / k }
    j.distance_softness = dynamics.make_soft(j.hertz, j.damping_ratio, ctx.h)
    if ctx.enable_warm_starting == false {
        j.impulse = 0.0
        j.lower_impulse = 0.0
        j.upper_impulse = 0.0
        j.motor_impulse = 0.0
    }
    // The warm start applies every impulse; the solve updates only those
    // of the parts it runs. An impulse whose part will not run this step
    // (a limit or motor switched off, the limits and motor of a rigid rod,
    // a spring of no stiffness) is dropped here, or it would be warm-started
    // every sub-step for as long as the part stays off -- a disabled limit
    // that was pushing went on pushing for good. The reference's setters
    // leave them.
    soft = j.enable_spring && (j.min_length < j.max_length || j.enable_limit == false)
    if soft == false || j.enable_limit == false {
        j.lower_impulse = 0.0
        j.upper_impulse = 0.0
    }
    if soft == false || j.enable_motor == false { j.motor_impulse = 0.0 }
    if soft && j.hertz <= 0.0 { j.impulse = 0.0 }
}

warm_start_distance_joint(base: *JointSim, ctx: *StepContext) {
    j = dynamics.distance_joint_of(base)
    state_a = state_of(ctx, j.index_a)
    state_b = state_of(ctx, j.index_b)
    r_a = math.rotate_vector(math.widen_quat(state_a.dq), j.anchor_a)
    r_b = math.rotate_vector(math.widen_quat(state_b.dq), j.anchor_b)
    ds = math.add(math.sub(math.widen3(state_b.dp), math.widen3(state_a.dp)), math.sub(r_b, r_a))
    axis = math.normalize(math.add(j.delta_center, ds))
    p = math.mul_sv(j.impulse + j.lower_impulse - j.upper_impulse + j.motor_impulse, axis)
    if (state_a.flags & dynamics.DYNAMIC_FLAG) != 0 {
        state_a.v = math.narrow3(math.mul_sub(math.widen3(state_a.v), base.inv_mass_a, p))
        state_a.w = math.narrow3(math.sub(math.widen3(state_a.w), math.mul_mv(math.widen_mat3(base.inv_inertia_a), math.cross(r_a, p))))
    }
    if (state_b.flags & dynamics.DYNAMIC_FLAG) != 0 {
        state_b.v = math.narrow3(math.mul_add(math.widen3(state_b.v), base.inv_mass_b, p))
        state_b.w = math.narrow3(math.add(math.widen3(state_b.w), math.mul_mv(math.widen_mat3(base.inv_inertia_b), math.cross(r_b, p))))
    }
}

// Soft when the spring is on and the limits leave room (spring, then
// the limits as speculative inequalities, then the motor); rigid otherwise.
solve_distance_joint(base: *JointSim, ctx: *StepContext, use_bias: bool) {
    m_a = base.inv_mass_a
    m_b = base.inv_mass_b
    i_a = math.widen_mat3(base.inv_inertia_a)
    i_b = math.widen_mat3(base.inv_inertia_b)
    j = dynamics.distance_joint_of(base)
    state_a = state_of(ctx, j.index_a)
    state_b = state_of(ctx, j.index_b)
    v_a = math.widen3(state_a.v)
    w_a = math.widen3(state_a.w)
    v_b = math.widen3(state_b.v)
    w_b = math.widen3(state_b.w)
    r_a = math.rotate_vector(math.widen_quat(state_a.dq), j.anchor_a)
    r_b = math.rotate_vector(math.widen_quat(state_b.dq), j.anchor_b)
    ds = math.add(math.sub(math.widen3(state_b.dp), math.widen3(state_a.dp)), math.sub(r_b, r_a))
    separation = math.add(j.delta_center, ds)
    len = math.length(separation)
    axis = math.normalize(separation)
    if j.enable_spring && (j.min_length < j.max_length || j.enable_limit == false) {
        if j.hertz > 0.0 {
            vr = math.add(math.sub(v_b, v_a), math.sub(math.cross(w_b, r_b), math.cross(w_a, r_a)))
            cdot = math.dot(axis, vr)
            c = len - j.length
            bias = j.distance_softness.bias_rate * c
            m = j.distance_softness.mass_scale * j.axial_mass
            old_impulse = j.impulse
            impulse = 0.0 - m * (cdot + bias) - j.distance_softness.impulse_scale * old_impulse
            j.impulse = math.clamp_float(j.impulse + impulse, j.lower_spring_force * ctx.h, j.upper_spring_force * ctx.h)
            impulse = j.impulse - old_impulse
            p = math.mul_sv(impulse, axis)
            v_a = math.mul_sub(v_a, m_a, p)
            w_a = math.sub(w_a, math.mul_mv(i_a, math.cross(r_a, p)))
            v_b = math.mul_add(v_b, m_b, p)
            w_b = math.add(w_b, math.mul_mv(i_b, math.cross(r_b, p)))
        }
        if j.enable_limit {
            // Lower.
            vr = math.add(math.sub(v_b, v_a), math.sub(math.cross(w_b, r_b), math.cross(w_a, r_a)))
            cdot = math.dot(axis, vr)
            scales = limit_scales(base, ctx, len - j.min_length, use_bias)
            impulse = 0.0 - scales.mass_scale * j.axial_mass * (cdot + scales.bias) - scales.impulse_scale * j.lower_impulse
            new_impulse = math.max_float(0.0, j.lower_impulse + impulse)
            impulse = new_impulse - j.lower_impulse
            j.lower_impulse = new_impulse
            p = math.mul_sv(impulse, axis)
            v_a = math.mul_sub(v_a, m_a, p)
            w_a = math.sub(w_a, math.mul_mv(i_a, math.cross(r_a, p)))
            v_b = math.mul_add(v_b, m_b, p)
            w_b = math.add(w_b, math.mul_mv(i_b, math.cross(r_b, p)))
            // Upper.
            vr = math.add(math.sub(v_a, v_b), math.sub(math.cross(w_a, r_a), math.cross(w_b, r_b)))
            cdot = math.dot(axis, vr)
            scales = limit_scales(base, ctx, j.max_length - len, use_bias)
            impulse = 0.0 - scales.mass_scale * j.axial_mass * (cdot + scales.bias) - scales.impulse_scale * j.upper_impulse
            new_impulse = math.max_float(0.0, j.upper_impulse + impulse)
            impulse = new_impulse - j.upper_impulse
            j.upper_impulse = new_impulse
            p = math.mul_sv(0.0 - impulse, axis)
            v_a = math.mul_sub(v_a, m_a, p)
            w_a = math.sub(w_a, math.mul_mv(i_a, math.cross(r_a, p)))
            v_b = math.mul_add(v_b, m_b, p)
            w_b = math.add(w_b, math.mul_mv(i_b, math.cross(r_b, p)))
        }
        if j.enable_motor {
            vr = math.add(math.sub(v_b, v_a), math.sub(math.cross(w_b, r_b), math.cross(w_a, r_a)))
            cdot = math.dot(axis, vr)
            impulse = j.axial_mass * (j.motor_speed - cdot)
            old_impulse = j.motor_impulse
            max_impulse = ctx.h * j.max_motor_force
            j.motor_impulse = math.clamp_float(j.motor_impulse + impulse, 0.0 - max_impulse, max_impulse)
            impulse = j.motor_impulse - old_impulse
            p = math.mul_sv(impulse, axis)
            v_a = math.mul_sub(v_a, m_a, p)
            w_a = math.sub(w_a, math.mul_mv(i_a, math.cross(r_a, p)))
            v_b = math.mul_add(v_b, m_b, p)
            w_b = math.add(w_b, math.mul_mv(i_b, math.cross(r_b, p)))
        }
    } else {
        vr = math.add(math.sub(v_b, v_a), math.sub(math.cross(w_b, r_b), math.cross(w_a, r_a)))
        cdot = math.dot(axis, vr)
        c = len - j.length
        bias = 0.0
        mass_scale = 1.0
        impulse_scale = 0.0
        if use_bias {
            bias = base.constraint_softness.bias_rate * c
            mass_scale = base.constraint_softness.mass_scale
            impulse_scale = base.constraint_softness.impulse_scale
        }
        impulse = 0.0 - mass_scale * j.axial_mass * (cdot + bias) - impulse_scale * j.impulse
        j.impulse = j.impulse + impulse
        p = math.mul_sv(impulse, axis)
        v_a = math.mul_sub(v_a, m_a, p)
        w_a = math.sub(w_a, math.mul_mv(i_a, math.cross(r_a, p)))
        v_b = math.mul_add(v_b, m_b, p)
        w_b = math.add(w_b, math.mul_mv(i_b, math.cross(r_b, p)))
    }
    store_velocities(state_a, v_a, w_a, state_b, v_b, w_b)
}

get_distance_joint_force(w: *World, base: *JointSim) -> Vec3 {
    j = dynamics.distance_joint_of(base)
    xf_a = dynamics.get_body_transform(w, base.body_id_a)
    xf_b = dynamics.get_body_transform(w, base.body_id_b)
    p_a = math.transform_point(xf_a, base.local_frame_a.p)
    p_b = math.transform_point(xf_b, base.local_frame_b.p)
    axis = math.normalize(math.sub(p_b, p_a))
    return math.mul_sv((j.impulse + j.lower_impulse - j.upper_impulse + j.motor_impulse) * w.inv_h, axis)
}

distance_joint_set_length(id: JointId, length: float) {
    if nonnegative(length) == false { return }
    base = sim_of(id, dynamics.JOINT_DISTANCE)
    if base == null { return }
    j = dynamics.distance_joint_of(base)
    j.length = math.clamp_float(length, math.LINEAR_SLOP, math.HUGE)
    j.impulse = 0.0
    j.lower_impulse = 0.0
    j.upper_impulse = 0.0
}
distance_joint_get_length(id: JointId) -> float { return dynamics.distance_joint_of(sim_of(id, dynamics.JOINT_DISTANCE)).length }
distance_joint_enable_limit(id: JointId, flag: bool) {
    base = sim_of(id, dynamics.JOINT_DISTANCE)
    if base != null { dynamics.distance_joint_of(base).enable_limit = flag }
}
distance_joint_is_limit_enabled(id: JointId) -> bool { return dynamics.distance_joint_of(sim_of(id, dynamics.JOINT_DISTANCE)).enable_limit }
distance_joint_set_length_range(id: JointId, min_length: float, max_length: float) {
    if math.is_valid_float(min_length) == false || math.is_valid_float(max_length) == false { return }
    base = sim_of(id, dynamics.JOINT_DISTANCE)
    if base == null { return }
    j = dynamics.distance_joint_of(base)
    lo = math.clamp_float(min_length, math.LINEAR_SLOP, math.HUGE)
    hi = math.clamp_float(max_length, math.LINEAR_SLOP, math.HUGE)
    j.min_length = math.min_float(lo, hi)
    j.max_length = math.max_float(lo, hi)
    j.impulse = 0.0
    j.lower_impulse = 0.0
    j.upper_impulse = 0.0
}
distance_joint_get_min_length(id: JointId) -> float { return dynamics.distance_joint_of(sim_of(id, dynamics.JOINT_DISTANCE)).min_length }
distance_joint_get_max_length(id: JointId) -> float { return dynamics.distance_joint_of(sim_of(id, dynamics.JOINT_DISTANCE)).max_length }
distance_joint_get_current_length(id: JointId) -> float {
    base = sim_of(id, dynamics.JOINT_DISTANCE)
    if base == null { return 0.0 }
    w = dynamics.get_world(id.world0)
    xf_a = dynamics.get_body_transform(w, base.body_id_a)
    xf_b = dynamics.get_body_transform(w, base.body_id_b)
    return math.distance(math.transform_point(xf_b, base.local_frame_b.p), math.transform_point(xf_a, base.local_frame_a.p))
}
distance_joint_enable_spring(id: JointId, flag: bool) {
    base = sim_of(id, dynamics.JOINT_DISTANCE)
    if base != null { dynamics.distance_joint_of(base).enable_spring = flag }
}
distance_joint_is_spring_enabled(id: JointId) -> bool { return dynamics.distance_joint_of(sim_of(id, dynamics.JOINT_DISTANCE)).enable_spring }
distance_joint_set_spring_force_range(id: JointId, lower: float, upper: float) {
    if math.is_valid_float(lower) == false || math.is_valid_float(upper) == false { return }
    base = sim_of(id, dynamics.JOINT_DISTANCE)
    if base == null { return }
    j = dynamics.distance_joint_of(base)
    j.lower_spring_force = lower
    j.upper_spring_force = upper
}
distance_joint_get_lower_spring_force(id: JointId) -> float { return dynamics.distance_joint_of(sim_of(id, dynamics.JOINT_DISTANCE)).lower_spring_force }
distance_joint_get_upper_spring_force(id: JointId) -> float { return dynamics.distance_joint_of(sim_of(id, dynamics.JOINT_DISTANCE)).upper_spring_force }
distance_joint_set_spring_hertz(id: JointId, hertz: float) {
    if nonnegative(hertz) == false { return }
    base = sim_of(id, dynamics.JOINT_DISTANCE)
    if base != null { dynamics.distance_joint_of(base).hertz = hertz }
}
distance_joint_set_spring_damping_ratio(id: JointId, ratio: float) {
    if nonnegative(ratio) == false { return }
    base = sim_of(id, dynamics.JOINT_DISTANCE)
    if base != null { dynamics.distance_joint_of(base).damping_ratio = ratio }
}
distance_joint_get_spring_hertz(id: JointId) -> float { return dynamics.distance_joint_of(sim_of(id, dynamics.JOINT_DISTANCE)).hertz }
distance_joint_get_spring_damping_ratio(id: JointId) -> float { return dynamics.distance_joint_of(sim_of(id, dynamics.JOINT_DISTANCE)).damping_ratio }
distance_joint_enable_motor(id: JointId, flag: bool) {
    base = sim_of(id, dynamics.JOINT_DISTANCE)
    if base == null { return }
    j = dynamics.distance_joint_of(base)
    if flag != j.enable_motor {
        j.enable_motor = flag
        j.motor_impulse = 0.0
    }
}
distance_joint_is_motor_enabled(id: JointId) -> bool { return dynamics.distance_joint_of(sim_of(id, dynamics.JOINT_DISTANCE)).enable_motor }
distance_joint_set_motor_speed(id: JointId, speed: float) {
    if math.is_valid_float(speed) == false { return }
    base = sim_of(id, dynamics.JOINT_DISTANCE)
    if base != null { dynamics.distance_joint_of(base).motor_speed = speed }
}
distance_joint_get_motor_speed(id: JointId) -> float { return dynamics.distance_joint_of(sim_of(id, dynamics.JOINT_DISTANCE)).motor_speed }
distance_joint_get_motor_force(id: JointId) -> float {
    base = sim_of(id, dynamics.JOINT_DISTANCE)
    if base == null { return 0.0 }
    return dynamics.get_world(id.world0).inv_h * dynamics.distance_joint_of(base).motor_impulse
}
distance_joint_set_max_motor_force(id: JointId, force: float) {
    if nonnegative(force) == false { return }
    base = sim_of(id, dynamics.JOINT_DISTANCE)
    if base != null { dynamics.distance_joint_of(base).max_motor_force = force }
}
distance_joint_get_max_motor_force(id: JointId) -> float { return dynamics.distance_joint_of(sim_of(id, dynamics.JOINT_DISTANCE)).max_motor_force }

// --- motor joint --------------------------------------------------------------------------------------------------

prepare_motor_joint(base: *JointSim, ctx: *StepContext) {
    bodies = prepare_base(base, ctx)
    j = dynamics.motor_joint_of(base)
    j.index_a = bodies.index_a
    j.index_b = bodies.index_b
    j.frame_a = world_frame(bodies.sim_a, base.local_frame_a)
    j.frame_b = world_frame(bodies.sim_b, base.local_frame_b)
    j.delta_center = math.sub(bodies.sim_b.center, bodies.sim_a.center)
    j.linear_spring = dynamics.make_soft(j.linear_hertz, j.linear_damping_ratio, ctx.h)
    j.angular_spring = dynamics.make_soft(j.angular_hertz, j.angular_damping_ratio, ctx.h)
    j.angular_mass = math.invert_matrix(math.add_mm(math.widen_mat3(base.inv_inertia_a), math.widen_mat3(base.inv_inertia_b)))
    if ctx.enable_warm_starting == false {
        j.linear_velocity_impulse = math.vec3_zero()
        j.angular_velocity_impulse = math.vec3_zero()
        j.linear_spring_impulse = math.vec3_zero()
        j.angular_spring_impulse = math.vec3_zero()
    }
    // The warm start applies all four impulses; the solve runs a part only
    // with a cap above zero (and a spring only with a stiffness). A part
    // switched off kept its impulse, and the warm start pushed with it every
    // sub-step for as long as the joint lived: a bone let go of by zeroing
    // its anchor's caps never hung (aephysics#76). Here a part that will not
    // run drops its impulse, and one that will is held to its cap now, so a
    // lowered cap is not overshot by the warm start either.
    j.angular_spring_impulse = capped_impulse(j.angular_spring_impulse, j.max_spring_torque > 0.0 && j.angular_hertz > 0.0, ctx.h * j.max_spring_torque)
    j.angular_velocity_impulse = capped_impulse(j.angular_velocity_impulse, j.max_velocity_torque > 0.0, ctx.h * j.max_velocity_torque)
    j.linear_spring_impulse = capped_impulse(j.linear_spring_impulse, j.max_spring_force > 0.0 && j.linear_hertz > 0.0, ctx.h * j.max_spring_force)
    j.linear_velocity_impulse = capped_impulse(j.linear_velocity_impulse, j.max_velocity_force > 0.0, ctx.h * j.max_velocity_force)
}

// An accumulated impulse kept only while its part runs, and within its cap.
capped_impulse(impulse: Vec3, runs: bool, max_impulse: float) -> Vec3 {
    if runs == false { return math.vec3_zero() }
    if math.length_squared(impulse) > max_impulse * max_impulse { return math.mul_sv(max_impulse, math.normalize(impulse)) }
    return impulse
}

warm_start_motor_joint(base: *JointSim, ctx: *StepContext) {
    j = dynamics.motor_joint_of(base)
    state_a = state_of(ctx, j.index_a)
    state_b = state_of(ctx, j.index_b)
    r_a = math.rotate_vector(math.widen_quat(state_a.dq), j.frame_a.p)
    r_b = math.rotate_vector(math.widen_quat(state_b.dq), j.frame_b.p)
    linear = math.add(j.linear_velocity_impulse, j.linear_spring_impulse)
    angular = math.add(j.angular_velocity_impulse, j.angular_spring_impulse)
    // The reference writes both bodies here, static ones included (a
    // static body's dummy state is written and forgotten).
    if (state_a.flags & dynamics.DYNAMIC_FLAG) != 0 {
        state_a.v = math.narrow3(math.mul_sub(math.widen3(state_a.v), base.inv_mass_a, linear))
        state_a.w = math.narrow3(math.sub(math.widen3(state_a.w), math.mul_mv(math.widen_mat3(base.inv_inertia_a), math.add(math.cross(r_a, linear), angular))))
    }
    if (state_b.flags & dynamics.DYNAMIC_FLAG) != 0 {
        state_b.v = math.narrow3(math.mul_add(math.widen3(state_b.v), base.inv_mass_b, linear))
        state_b.w = math.narrow3(math.add(math.widen3(state_b.w), math.mul_mv(math.widen_mat3(base.inv_inertia_b), math.add(math.cross(r_b, linear), angular))))
    }
}

// The angular spring towards frame alignment, the angular velocity
// target, the linear spring towards frame coincidence, the linear
// velocity target; each bounded by its maximum over the sub-step.
solve_motor_joint(base: *JointSim, ctx: *StepContext) {
    m_a = base.inv_mass_a
    m_b = base.inv_mass_b
    i_a = math.widen_mat3(base.inv_inertia_a)
    i_b = math.widen_mat3(base.inv_inertia_b)
    j = dynamics.motor_joint_of(base)
    state_a = state_of(ctx, j.index_a)
    state_b = state_of(ctx, j.index_b)
    v_a = math.widen3(state_a.v)
    w_a = math.widen3(state_a.w)
    v_b = math.widen3(state_b.v)
    w_b = math.widen3(state_b.w)
    quat_a = math.mul_quat(math.widen_quat(state_a.dq), j.frame_a.q)
    quat_b = math.mul_quat(math.widen_quat(state_b.dq), j.frame_b.q)
    if math.dot_quat(quat_a, quat_b) < 0.0 { quat_b = math.negate_quat(quat_b) }
    rel_q = math.inv_mul_quat(quat_a, quat_b)
    if j.max_spring_torque > 0.0 && j.angular_hertz > 0.0 {
        delta_rotation = math.delta_quat_to_rotation(rel_q, math.quat_identity())
        c = math.neg(math.rotate_vector(quat_a, delta_rotation))
        bias = math.mul_sv(j.angular_spring.bias_rate, c)
        cdot = math.sub(w_b, w_a)
        max_impulse = ctx.h * j.max_spring_torque
        old_impulse = j.angular_spring_impulse
        impulse = math.mul_sub(math.mul_sv(0.0 - j.angular_spring.mass_scale, math.mul_mv(j.angular_mass, math.add(cdot, bias))), j.angular_spring.impulse_scale, old_impulse)
        j.angular_spring_impulse = math.add(old_impulse, impulse)
        if math.length_squared(j.angular_spring_impulse) > max_impulse * max_impulse {
            j.angular_spring_impulse = math.mul_sv(max_impulse, math.normalize(j.angular_spring_impulse))
        }
        impulse = math.sub(j.angular_spring_impulse, old_impulse)
        w_a = math.sub(w_a, math.mul_mv(i_a, impulse))
        w_b = math.add(w_b, math.mul_mv(i_b, impulse))
    }
    if j.max_velocity_torque > 0.0 {
        cdot = math.sub(math.sub(w_b, w_a), j.angular_velocity)
        impulse = math.neg(math.mul_mv(j.angular_mass, cdot))
        max_impulse = ctx.h * j.max_velocity_torque
        old_impulse = j.angular_velocity_impulse
        j.angular_velocity_impulse = math.add(old_impulse, impulse)
        if math.length_squared(j.angular_velocity_impulse) > max_impulse * max_impulse {
            j.angular_velocity_impulse = math.mul_sv(max_impulse, math.normalize(j.angular_velocity_impulse))
        }
        impulse = math.sub(j.angular_velocity_impulse, old_impulse)
        w_a = math.sub(w_a, math.mul_mv(i_a, impulse))
        w_b = math.add(w_b, math.mul_mv(i_b, impulse))
    }
    r_a = math.rotate_vector(math.widen_quat(state_a.dq), j.frame_a.p)
    r_b = math.rotate_vector(math.widen_quat(state_b.dq), j.frame_b.p)
    if j.max_spring_force > 0.0 && j.linear_hertz > 0.0 {
        c = math.add(math.add(math.sub(math.widen3(state_b.dp), math.widen3(state_a.dp)), math.sub(r_b, r_a)), j.delta_center)
        bias = math.mul_sv(j.linear_spring.bias_rate, c)
        cdot = math.sub(math.add(v_b, math.cross(w_b, r_b)), math.add(v_a, math.cross(w_a, r_a)))
        k = point_mass_matrix(m_a, i_a, r_a, m_b, i_b, r_b)
        b = math.solve3(k, math.add(cdot, bias))
        old_impulse = j.linear_spring_impulse
        impulse = math.mul_sub(math.mul_sv(0.0 - j.linear_spring.mass_scale, b), j.linear_spring.impulse_scale, old_impulse)
        max_impulse = ctx.h * j.max_spring_force
        j.linear_spring_impulse = math.add(j.linear_spring_impulse, impulse)
        if math.length_squared(j.linear_spring_impulse) > max_impulse * max_impulse {
            j.linear_spring_impulse = math.mul_sv(max_impulse, math.normalize(j.linear_spring_impulse))
        }
        impulse = math.sub(j.linear_spring_impulse, old_impulse)
        v_a = math.mul_sub(v_a, m_a, impulse)
        w_a = math.sub(w_a, math.mul_mv(i_a, math.cross(r_a, impulse)))
        v_b = math.mul_add(v_b, m_b, impulse)
        w_b = math.add(w_b, math.mul_mv(i_b, math.cross(r_b, impulse)))
    }
    if j.max_velocity_force > 0.0 {
        cdot = math.sub(math.sub(math.add(v_b, math.cross(w_b, r_b)), math.add(v_a, math.cross(w_a, r_a))), j.linear_velocity)
        k = point_mass_matrix(m_a, i_a, r_a, m_b, i_b, r_b)
        impulse = math.neg(math.solve3(k, cdot))
        old_impulse = j.linear_velocity_impulse
        max_impulse = ctx.h * j.max_velocity_force
        j.linear_velocity_impulse = math.add(j.linear_velocity_impulse, impulse)
        if math.length_squared(j.linear_velocity_impulse) > max_impulse * max_impulse {
            j.linear_velocity_impulse = math.mul_sv(max_impulse, math.normalize(j.linear_velocity_impulse))
        }
        impulse = math.sub(j.linear_velocity_impulse, old_impulse)
        v_a = math.mul_sub(v_a, m_a, impulse)
        w_a = math.sub(w_a, math.mul_mv(i_a, math.cross(r_a, impulse)))
        v_b = math.mul_add(v_b, m_b, impulse)
        w_b = math.add(w_b, math.mul_mv(i_b, math.cross(r_b, impulse)))
    }
    store_velocities(state_a, v_a, w_a, state_b, v_b, w_b)
}

get_motor_joint_force(w: *World, base: *JointSim) -> Vec3 {
    j = dynamics.motor_joint_of(base)
    return math.mul_sv(w.inv_h, math.add(j.linear_velocity_impulse, j.linear_spring_impulse))
}
get_motor_joint_torque(w: *World, base: *JointSim) -> Vec3 {
    j = dynamics.motor_joint_of(base)
    return math.mul_sv(w.inv_h, math.add(j.angular_velocity_impulse, j.angular_spring_impulse))
}

motor_joint_set_linear_velocity(id: JointId, v: Vec3) {
    if math.is_valid_vec3(v) == false { return }
    base = sim_of(id, dynamics.JOINT_MOTOR)
    if base != null { dynamics.motor_joint_of(base).linear_velocity = v }
}
motor_joint_get_linear_velocity(id: JointId) -> Vec3 { return dynamics.motor_joint_of(sim_of(id, dynamics.JOINT_MOTOR)).linear_velocity }
motor_joint_set_angular_velocity(id: JointId, v: Vec3) {
    if math.is_valid_vec3(v) == false { return }
    base = sim_of(id, dynamics.JOINT_MOTOR)
    if base != null { dynamics.motor_joint_of(base).angular_velocity = v }
}
motor_joint_get_angular_velocity(id: JointId) -> Vec3 { return dynamics.motor_joint_of(sim_of(id, dynamics.JOINT_MOTOR)).angular_velocity }
motor_joint_set_max_velocity_torque(id: JointId, value: float) {
    if nonnegative(value) == false { return }
    base = sim_of(id, dynamics.JOINT_MOTOR)
    if base != null { dynamics.motor_joint_of(base).max_velocity_torque = value }
}
