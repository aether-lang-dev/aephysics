motor_joint_set_max_velocity_force(id: JointId, value: float) {
    if nonnegative(value) == false { return }
    base = sim_of(id, dynamics.JOINT_MOTOR)
    if base != null { dynamics.motor_joint_of(base).max_velocity_force = value }
}
motor_joint_get_max_velocity_force(id: JointId) -> float { return dynamics.motor_joint_of(sim_of(id, dynamics.JOINT_MOTOR)).max_velocity_force }
motor_joint_set_linear_hertz(id: JointId, value: float) {
    if nonnegative(value) == false { return }
    base = sim_of(id, dynamics.JOINT_MOTOR)
    if base != null { dynamics.motor_joint_of(base).linear_hertz = value }
}
motor_joint_get_linear_hertz(id: JointId) -> float { return dynamics.motor_joint_of(sim_of(id, dynamics.JOINT_MOTOR)).linear_hertz }
motor_joint_set_linear_damping_ratio(id: JointId, value: float) {
    if nonnegative(value) == false { return }
    base = sim_of(id, dynamics.JOINT_MOTOR)
    if base != null { dynamics.motor_joint_of(base).linear_damping_ratio = value }
}
motor_joint_get_linear_damping_ratio(id: JointId) -> float { return dynamics.motor_joint_of(sim_of(id, dynamics.JOINT_MOTOR)).linear_damping_ratio }
motor_joint_set_angular_hertz(id: JointId, value: float) {
    if nonnegative(value) == false { return }
    base = sim_of(id, dynamics.JOINT_MOTOR)
    if base != null { dynamics.motor_joint_of(base).angular_hertz = value }
}
motor_joint_get_angular_hertz(id: JointId) -> float { return dynamics.motor_joint_of(sim_of(id, dynamics.JOINT_MOTOR)).angular_hertz }
motor_joint_set_angular_damping_ratio(id: JointId, value: float) {
    if nonnegative(value) == false { return }
    base = sim_of(id, dynamics.JOINT_MOTOR)
    if base != null { dynamics.motor_joint_of(base).angular_damping_ratio = value }
}
motor_joint_get_angular_damping_ratio(id: JointId) -> float { return dynamics.motor_joint_of(sim_of(id, dynamics.JOINT_MOTOR)).angular_damping_ratio }
motor_joint_set_max_spring_force(id: JointId, value: float) {
    if nonnegative(value) == false { return }
    base = sim_of(id, dynamics.JOINT_MOTOR)
    if base != null { dynamics.motor_joint_of(base).max_spring_force = value }
