// aephysics.physics_world -- the world's face: the step (the pairs, the
// narrow phase, the Soft Step solve, the sensors, the events cleared
// and swapped), the events read back, the settings, the counters, the
// queries against every shape in the world (overlap of a box or a
// proxy, the character mover's planes, ray, shape and mover casts, the
// closest ray hit) and against one body at a transform of the caller's
// choosing, and explosions.
//
// This is Box3D's physics_world.c and the query half of body.c (Erin
// Catto, MIT), the reference this engine is measured against, on one
// thread and without its recording hooks. Names are the reference's
// without its prefix, in snake case: b3World_Step is step,
// b3World_CastRayClosest is cast_ray_closest, b3Body_CastRay is
// body_cast_ray. Every query re-centres on its origin so the collision
// math keeps its precision far from the world's origin, as the
// reference does.
import std.string
import std.os
import aephysics.math
import aephysics.native
import aephysics.basics
import aephysics.dynamic_tree
import aephysics.distance
import aephysics.mesh
import aephysics.shape
import aephysics.broad_phase
import aephysics.dynamics
import aephysics.contact_solver
import aephysics.joint_solver
import aephysics.solver
import aephysics.parallel
import aephysics.debug_draw

exports (
    get_profile, get_max_capacity, world_byte_count, dump_memory_stats, world_draw, Version, get_version, is_double_precision, is_avx2_available, get_world_count, get_max_world_count,
    RayResult, BodyCastResult, BodyPlaneResult, BodyTOIResult, ExplosionDef, Counters,
    step, world_of, is_valid,
    body_event_count, body_event, contact_begin_event_count, contact_begin_event, contact_end_event_count, contact_end_event,
    contact_hit_event_count, contact_hit_event, sensor_begin_event_count, sensor_begin_event, sensor_end_event_count, sensor_end_event,
    joint_event_count, joint_event,
    enable_sleeping, is_sleeping_enabled, enable_warm_starting, is_warm_starting_enabled, enable_continuous, is_continuous_enabled,
    enable_speculative, set_restitution_threshold, get_restitution_threshold, set_restitution_iterations, get_restitution_iterations,
    enable_restitution_propagation, is_restitution_propagation_enabled, enable_kinematic_static_softness, is_kinematic_static_softness_enabled, enable_kinematic_speculation, is_kinematic_speculation_enabled, set_hit_event_threshold, get_hit_event_threshold,
    set_contact_tuning, set_contact_recycle_distance, get_contact_recycle_distance, set_maximum_linear_speed, get_maximum_linear_speed,
    set_gravity, get_gravity, set_user_data, get_user_data, set_friction_callback, set_restitution_callback,
    set_custom_filter_callback, set_pre_solve_callback, get_awake_body_count, get_counters, get_bounds, rebuild_static_tree,
    set_worker_count, get_worker_count,
    overlap_aabb, overlap_shape, collide_mover, cast_ray, cast_ray_closest, cast_shape, cast_mover,
    body_cast_ray, body_cast_shape, body_overlap_shape, body_collide_mover, body_time_of_impact_mover, shape_ray_cast,
    default_explosion_def, explode
)

const NULL_INDEX = 0 - 1
const BODY_KIND_COUNT = 3

// The closest hit of a ray (b3RayResult).
struct RayResult {
    shape_id: ShapeId
    point: Vec3
    normal: Vec3
    user_material_id: long
    fraction: float
    triangle_index: int
    child_index: int
    node_visits: int
    leaf_visits: int
    hit: bool
}

// A cast against one body's shapes (b3BodyCastResult).
struct BodyCastResult {
    shape_id: ShapeId
    point: Vec3
    normal: Vec3
    fraction: float
    triangle_index: int
    user_material_id: long
    iterations: int
    hit: bool
}

struct BodyPlaneResult {
    shape_id: ShapeId
    result: PlaneResult
}

// The mover's time of impact against one body (b3BodyTOIResult).
struct BodyTOIResult {
    point: Vec3
    normal: Vec3
    fraction: float
    shape_id: ShapeId
}

struct ExplosionDef {
    mask_bits: long
    position: Vec3
    radius: float
    falloff: float
    impulse_per_area: float
}

// A version (b3Version).
struct Version {
    major: int
    minor: int
    revision: int
}

// The reference version this engine follows, in its API and its results:
// e77352c, which calls itself 0.2.0 (b3GetVersion).
get_version() -> Version { return Version { major: 0, minor: 2, revision: 0 } }

// World positions are double, as in the reference's large-world build
// (b3IsDoublePrecision); the rest single where the reference has it.
is_double_precision() -> bool { return true }

// Whether this CPU runs AVX2 (b3IsAVX2Available). The wide contact solver's
// width is still the build's (-mavx2), #156.
is_avx2_available() -> bool { return native.has_avx2() }

// The worlds there are, and the most there have been at once.
get_world_count() -> int { return dynamics.get_world_count() }
get_max_world_count() -> int { return dynamics.get_max_world_count() }

// The most the world has held at a step's start (b3World_GetMaxCapacity):
// sized from it, the next world's def grows nothing while it steps.
get_max_capacity(id: WorldId) -> Capacity {
    w = world_of(id)
    if w == null { return Capacity { static_shape_count: 0, dynamic_shape_count: 0, contact_count: 0, static_body_count: 0, dynamic_body_count: 0 } }
    return w.max_capacity
}

struct Counters {
    body_count: int
    shape_count: int
    contact_count: int
    joint_count: int
    island_count: int
    stack_used: int
    static_tree_height: int
    tree_height: int
    sat_call_count: int
    sat_cache_hit_count: int
    awake_contact_count: int       // the contacts the collide pass touches: the graph's and the awake non-touching
    recycled_contact_count: int
    color_counts: int[24]          // each colour's contacts and joints, the overflow last
    byte_count: long               // what the world holds, as world_byte_count adds it up
    arena_capacity: int            // the most any worker's arena was asked for at once
    task_count: int                // the tasks the last step spread over the workers
    manifold_counts: int[8]        // the last collide pass's contacts with 1, 2, ... 7 or more manifolds
    distance_iterations: int       // the most a time of impact's outer loop took, over the world's life
    push_back_iterations: int      // the most push backs
    root_iterations: int           // the most root solver iterations
}

// The world of an id, or null when the id is stale or the world is locked.
world_of(id: WorldId) -> *World {
    if dynamics.world_is_valid(id) == false { return null }
    w = dynamics.get_world(id.index1 - 1)
    if w.locked { return null }
    return w
}

is_valid(id: WorldId) -> bool { return dynamics.world_is_valid(id) }

// --- the step ----------------------------------------------------------------------------------------------------

// One step of the world (b3World_Step): the events cleared, the broad
// phase's new pairs made contacts, the step's context (the contact
// hertz reduced for large steps, the static contacts twice as stiff
// and half as damped), the narrow phase, the solve when time passes,
// the sensors, the stack grown to the step's peak, the end events
// swapped. A zero time step collides without solving.
step(id: WorldId, time_step: float, sub_step_count: int) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_STEP); dynamics.rec_float(recorder, time_step); dynamics.rec_int(recorder, sub_step_count); dynamics.rec_end(recorder) }
    w = world_of(id)
    if w == null { return }
    // An infinite step would make every sub-step infinite; a NaN one is
    // refused with it. Zero and negative steps collide without solving,
    // as the reference's do.
    if math.is_valid_float(time_step) == false { return }
    // The step runs on the calling thread as the world's first worker slot
    // (its task context and scratch), whatever the thread's index in a host's
    // pool; the index is given back at the end.
    caller_index = dynamics.enter_world(w)
    solver.stage_step()
    dynamics.track_capacity(w)
    tasks_before = parallel.scheduler_task_count(w.scheduler as *Scheduler)
    w.locked = true
    basics.buffer_clear(&w.body_move_events)
    basics.buffer_clear(&w.sensor_begin_events)
    basics.buffer_clear(&w.contact_begin_events)
    basics.buffer_clear(&w.contact_hit_events)
    basics.buffer_clear(&w.joint_events)
    t0 = os.now_monotonic_ns()
    dynamics.update_pairs(w)
    t1 = os.now_monotonic_ns()
    w.profile.pairs = ms(t1 - t0)
    ctx = contact_solver.default_step_context(w)
    ctx.dt = time_step
    ctx.sub_step_count = math.max_int(1, sub_step_count)
    if time_step > 0.0 {
        ctx.inv_dt = 1.0 / time_step
        ctx.h = time_step / (ctx.sub_step_count as float)
        ctx.inv_h = (ctx.sub_step_count as float) * ctx.inv_dt
    } else {
        ctx.inv_dt = 0.0
        ctx.h = 0.0
        ctx.inv_h = 0.0
    }
    w.inv_h = ctx.inv_h
    w.inv_dt = ctx.inv_dt
    contact_hertz = math.min_float(w.contact_hertz, 0.125 * ctx.inv_h)
    ctx.contact_softness = dynamics.make_soft(contact_hertz, w.contact_damping_ratio, ctx.h)
    ctx.static_softness = dynamics.make_soft(2.0 * contact_hertz, 0.5 * w.contact_damping_ratio, ctx.h)
    ctx.restitution_threshold = w.restitution_threshold
    ctx.any_restitution = 0
    ctx.max_linear_velocity = w.max_linear_speed
    ctx.enable_warm_starting = w.enable_warm_starting
    t2 = os.now_monotonic_ns()
    dynamics.collide(w)
    t3 = os.now_monotonic_ns()
    w.profile.collide = ms(t3 - t2)
    w.profile.solve = 0.0
    if time_step > 0.0 {
        solver.solve(w, &ctx)
        w.profile.solve = ms(os.now_monotonic_ns() - t3)
    }
    t4 = os.now_monotonic_ns()
    dynamics.overlap_sensors(w)
    t5 = os.now_monotonic_ns()
    w.profile.sensors = ms(t5 - t4)
    basics.stack_grow(&w.stack)
    dynamics.swap_end_events(w)
    w.profile.step = ms(os.now_monotonic_ns() - t0)
    // The step's tasks: exact on the world's own scheduler; on one a host
    // shares between worlds stepping at once, theirs are counted too.
    w.task_count = parallel.scheduler_task_count(w.scheduler as *Scheduler) - tasks_before
    w.locked = false
    dynamics.leave_world(caller_index)
    if dynamics.recording_on(id.index1 - 1) { record_step_result(id, w) }
}

// What a recorded step left: the state's hash, which a player checks its
// own against, and the world's bounds joined into the recording's for a
// viewer to frame it.
record_step_result(id: WorldId, w: *World) {
    recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_STATE_HASH)
    dynamics.rec_long(recorder, dynamics.hash_world_state(w))
    dynamics.rec_end(recorder)
    bounds = get_bounds(id)
    if recorder.have_bounds { recorder.bounds = math.aabb_union(recorder.bounds, bounds) }
    else {
        recorder.bounds = bounds
        recorder.have_bounds = true
    }
}

ms(ns: long) -> float { return (ns as float) / 1000000.0 }

// Where the last step's time went (b3World_GetProfile).
get_profile(id: WorldId) -> Profile {
    w = world_of(id)
    return w.profile
}

// --- events ----------------------------------------------------------------------------------------------------------

// The end events are read from the buffer the last step filled (it swapped to the other one).
previous_end_index(w: *World) -> int { return 1 - w.end_event_index }

body_event_count(id: WorldId) -> int {
    w = world_of(id)
    if w == null { return 0 }
    return w.body_move_events.count
}
body_event(id: WorldId, index: int) -> BodyMoveEvent { return dynamics.world_body_move_event(dynamics.get_world(id.index1 - 1), index) }
contact_begin_event_count(id: WorldId) -> int {
    w = world_of(id)
    if w == null { return 0 }
    return w.contact_begin_events.count
}
contact_begin_event(id: WorldId, index: int) -> ContactBeginTouchEvent { return dynamics.world_contact_begin_event(dynamics.get_world(id.index1 - 1), index) }
contact_end_event_count(id: WorldId) -> int {
    w = world_of(id)
    if w == null { return 0 }
    if previous_end_index(w) == 0 { return w.contact_end_events0.count }
    return w.contact_end_events1.count
}
contact_end_event(id: WorldId, index: int) -> ContactEndTouchEvent {
    w = dynamics.get_world(id.index1 - 1)
    events = w.contact_end_events0.data as ContactEndTouchEvent[]
    if previous_end_index(w) == 1 { events = w.contact_end_events1.data as ContactEndTouchEvent[] }
    return events[index]
}
contact_hit_event_count(id: WorldId) -> int {
    w = world_of(id)
    if w == null { return 0 }
    return w.contact_hit_events.count
}
contact_hit_event(id: WorldId, index: int) -> ContactHitEvent { return dynamics.world_contact_hit_event(dynamics.get_world(id.index1 - 1), index) }
sensor_begin_event_count(id: WorldId) -> int {
    w = world_of(id)
    if w == null { return 0 }
    return w.sensor_begin_events.count
}
sensor_begin_event(id: WorldId, index: int) -> SensorBeginTouchEvent { return dynamics.world_sensor_begin_event(dynamics.get_world(id.index1 - 1), index) }
sensor_end_event_count(id: WorldId) -> int {
    w = world_of(id)
    if w == null { return 0 }
    if previous_end_index(w) == 0 { return w.sensor_end_events0.count }
    return w.sensor_end_events1.count
}
sensor_end_event(id: WorldId, index: int) -> SensorEndTouchEvent {
    w = dynamics.get_world(id.index1 - 1)
    events = w.sensor_end_events0.data as SensorEndTouchEvent[]
    if previous_end_index(w) == 1 { events = w.sensor_end_events1.data as SensorEndTouchEvent[] }
    return events[index]
}
joint_event_count(id: WorldId) -> int {
    w = world_of(id)
    if w == null { return 0 }
    return w.joint_events.count
}
joint_event(id: WorldId, index: int) -> JointEvent { return dynamics.world_joint_event(dynamics.get_world(id.index1 - 1), index) }

// --- settings ---------------------------------------------------------------------------------------------------------

// Sleeping off wakes every sleeping set (the sets above the awake one, from the last down).
enable_sleeping(id: WorldId, flag: bool) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_ENABLE_SLEEPING); dynamics.rec_bool(recorder, flag); dynamics.rec_end(recorder) }
    w = world_of(id)
    if w == null { return }
    if flag == w.enable_sleep { return }
    w.enable_sleep = flag
    if flag == false {
        i = w.solver_sets.count - 1
        while i >= dynamics.FIRST_SLEEPING_SET {
            set = dynamics.get_solver_set(w, i)
            if set.set_index != NULL_INDEX && set.body_sims.count > 0 { dynamics.wake_solver_set(w, i) }
            i = i - 1
        }
    }
}
is_sleeping_enabled(id: WorldId) -> bool { return dynamics.get_world(id.index1 - 1).enable_sleep }
enable_warm_starting(id: WorldId, flag: bool) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_ENABLE_WARM_STARTING); dynamics.rec_bool(recorder, flag); dynamics.rec_end(recorder) }
    w = world_of(id)
    if w != null { w.enable_warm_starting = flag }
}
is_warm_starting_enabled(id: WorldId) -> bool { return dynamics.get_world(id.index1 - 1).enable_warm_starting }
enable_continuous(id: WorldId, flag: bool) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_ENABLE_CONTINUOUS); dynamics.rec_bool(recorder, flag); dynamics.rec_end(recorder) }
    w = world_of(id)
    if w != null { w.enable_continuous = flag }
}
is_continuous_enabled(id: WorldId) -> bool { return dynamics.get_world(id.index1 - 1).enable_continuous }
enable_speculative(id: WorldId, flag: bool) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_ENABLE_SPECULATIVE); dynamics.rec_bool(recorder, flag); dynamics.rec_end(recorder) }
    w = world_of(id)
    if w != null { w.enable_speculative = flag }
}
set_restitution_threshold(id: WorldId, value: float) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_SET_RESTITUTION_THRESHOLD); dynamics.rec_float(recorder, value); dynamics.rec_end(recorder) }
    if math.is_valid_float(value) == false { return }
    w = world_of(id)
    if w != null { w.restitution_threshold = math.clamp_float(value, 0.0, math.MAX_FLOAT) }
}
get_restitution_threshold(id: WorldId) -> float { return dynamics.get_world(id.index1 - 1).restitution_threshold }
// The restitution passes after the sub-steps (0 to 63; Box3D's b3World_SetRestitutionIterations).
set_restitution_iterations(id: WorldId, count: int) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_SET_RESTITUTION_ITERATIONS); dynamics.rec_int(recorder, count); dynamics.rec_end(recorder) }
    w = world_of(id)
    if w != null { w.restitution_iterations = math.clamp_int(count, 0, dynamics.MAX_RESTITUTION_ITERATIONS) }
}
get_restitution_iterations(id: WorldId) -> int { return dynamics.get_world(id.index1 - 1).restitution_iterations }
// Whether the restitution passes reach contacts without restitution too, so a bounce carries through a stack.
enable_restitution_propagation(id: WorldId, flag: bool) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_ENABLE_RESTITUTION_PROPAGATION); dynamics.rec_bool(recorder, flag); dynamics.rec_end(recorder) }
    w = world_of(id)
    if w != null { w.enable_restitution_propagation = flag }
}
is_restitution_propagation_enabled(id: WorldId) -> bool { return dynamics.get_world(id.index1 - 1).enable_restitution_propagation }
// Whether contacts with a kinematic body take the static softness, so a body
// the game drives hard does not sink into what it meets (off: the reference's).
enable_kinematic_static_softness(id: WorldId, flag: bool) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_ENABLE_KINEMATIC_STATIC_SOFTNESS); dynamics.rec_bool(recorder, flag); dynamics.rec_end(recorder) }
    w = world_of(id)
    if w != null { w.enable_kinematic_static_softness = flag }
}
is_kinematic_static_softness_enabled(id: WorldId) -> bool { return dynamics.get_world(id.index1 - 1).enable_kinematic_static_softness }
// Whether a contact with a kinematic body keeps speculative points out to
// the pair's travel over the step, so a slow body a fast kinematic one
// meets is brought up to speed as the gap closes instead of being found
// inside it (off: the reference's 2 cm whatever the speed; #167).
enable_kinematic_speculation(id: WorldId, flag: bool) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_ENABLE_KINEMATIC_SPECULATION); dynamics.rec_bool(recorder, flag); dynamics.rec_end(recorder) }
    w = world_of(id)
    if w != null { w.enable_kinematic_speculation = flag }
}
is_kinematic_speculation_enabled(id: WorldId) -> bool { return dynamics.get_world(id.index1 - 1).enable_kinematic_speculation }
set_hit_event_threshold(id: WorldId, value: float) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_SET_HIT_EVENT_THRESHOLD); dynamics.rec_float(recorder, value); dynamics.rec_end(recorder) }
    if math.is_valid_float(value) == false { return }
    w = world_of(id)
    if w != null { w.hit_event_threshold = math.clamp_float(value, 0.0, math.MAX_FLOAT) }
}
get_hit_event_threshold(id: WorldId) -> float { return dynamics.get_world(id.index1 - 1).hit_event_threshold }
set_contact_tuning(id: WorldId, hertz: float, damping_ratio: float, contact_speed: float) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_SET_CONTACT_TUNING); dynamics.rec_float(recorder, hertz); dynamics.rec_float(recorder, damping_ratio); dynamics.rec_float(recorder, contact_speed); dynamics.rec_end(recorder) }
    if math.is_valid_float(hertz) == false || math.is_valid_float(damping_ratio) == false || math.is_valid_float(contact_speed) == false { return }
    w = world_of(id)
    if w == null { return }
    w.contact_hertz = math.clamp_float(hertz, 0.0, math.MAX_FLOAT)
    w.contact_damping_ratio = math.clamp_float(damping_ratio, 0.0, math.MAX_FLOAT)
    w.contact_speed = math.clamp_float(contact_speed, 0.0, math.MAX_FLOAT)
}
set_contact_recycle_distance(id: WorldId, distance: float) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_SET_CONTACT_RECYCLE_DISTANCE); dynamics.rec_float(recorder, distance); dynamics.rec_end(recorder) }
    if math.is_valid_float(distance) == false { return }
    w = world_of(id)
    if w != null { w.contact_recycle_distance = math.clamp_float(distance, 0.0, math.MAX_FLOAT) }
}
get_contact_recycle_distance(id: WorldId) -> float { return dynamics.get_world(id.index1 - 1).contact_recycle_distance }
set_maximum_linear_speed(id: WorldId, speed: float) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_SET_MAXIMUM_LINEAR_SPEED); dynamics.rec_float(recorder, speed); dynamics.rec_end(recorder) }
    if math.is_valid_float(speed) == false || speed <= 0.0 { return }
    w = world_of(id)
    if w != null { w.max_linear_speed = speed }
}
get_maximum_linear_speed(id: WorldId) -> float { return dynamics.get_world(id.index1 - 1).max_linear_speed }
// Gravity and the user data change even mid-step, from a callback, as the reference's do (no lock).
set_gravity(id: WorldId, gravity: Vec3) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_SET_GRAVITY); dynamics.rec_vec3(recorder, gravity); dynamics.rec_end(recorder) }
    if math.is_valid_vec3(gravity) == false { return }
    if dynamics.world_is_valid(id) { dynamics.get_world(id.index1 - 1).gravity = gravity }
}
get_gravity(id: WorldId) -> Vec3 { return dynamics.get_world(id.index1 - 1).gravity }
set_user_data(id: WorldId, data: ptr) {
    if dynamics.world_is_valid(id) { dynamics.get_world(id.index1 - 1).user_data = data }
}
get_user_data(id: WorldId) -> ptr { return dynamics.get_world(id.index1 - 1).user_data }
set_friction_callback(id: WorldId, callback_fn: fn(float, long, float, long) -> float) {
    w = world_of(id)
    if w != null { w.friction_callback = callback_fn }
}
set_restitution_callback(id: WorldId, callback_fn: fn(float, long, float, long) -> float) {
    w = world_of(id)
    if w != null { w.restitution_callback = callback_fn }
}
set_custom_filter_callback(id: WorldId, callback_fn: fn(ShapeId, ShapeId, ptr) -> bool, context: ptr) {
    w = world_of(id)
    if w != null { dynamics.world_set_custom_filter(w, callback_fn, context) }
}
set_pre_solve_callback(id: WorldId, callback_fn: fn(ShapeId, ShapeId, Vec3, Vec3, ptr) -> bool, context: ptr) {
    w = world_of(id)
    if w != null { dynamics.world_set_pre_solve(w, callback_fn, context) }
}
get_awake_body_count(id: WorldId) -> int {
    w = world_of(id)
    if w == null { return 0 }
    return dynamics.world_awake_body_count(w)
}

get_counters(id: WorldId) -> Counters {
    w = dynamics.get_world(id.index1 - 1)
    bodies = dynamics.world_body_count(w)
    shapes = dynamics.world_shape_count(w)
    contacts = dynamics.world_contact_count(w)
    joints = dynamics.world_joint_count(w)
    islands = dynamics.world_island_count(w)
    stack_used = basics.stack_max_allocation(&w.stack)
    static_height = dynamic_tree.tree_get_height(broad_phase.broad_phase_tree(&w.broad_phase, dynamics.BODY_STATIC))
    dynamic_height = dynamic_tree.tree_get_height(broad_phase.broad_phase_tree(&w.broad_phase, dynamics.BODY_DYNAMIC))
    // As the reference counts them (b3World_GetCounters): every colour's
    // convex and scalar contacts and joints, and the awake contacts are
    // those plus the awake set's non-touching ones.
    c = Counters { body_count: bodies, shape_count: shapes, contact_count: contacts, joint_count: joints, island_count: islands,
                   stack_used: stack_used, static_tree_height: static_height, tree_height: dynamic_height,
                   sat_call_count: w.sat_call_count, sat_cache_hit_count: w.sat_cache_hit_count,
                   awake_contact_count: 0, recycled_contact_count: w.recycled_contact_count }
    awake_contacts = dynamics.get_solver_set(w, dynamics.AWAKE_SET).contact_indices.count
    i = 0
    while i < dynamics.GRAPH_COLOR_COUNT {
        color = dynamics.graph_color(w, i)
        color_contacts = color.convex_contacts.count + color.contacts.count
        c.color_counts[i] = color_contacts + color.joint_sims.count
        awake_contacts = awake_contacts + color_contacts
        i = i + 1
    }
    c.awake_contact_count = awake_contacts
    c.byte_count = world_byte_count(w, false)
    c.task_count = w.task_count
    k = 0
    while k < dynamics.MANIFOLD_COUNT_BUCKETS {
        c.manifold_counts[k] = w.manifold_counts[k]
        k = k + 1
    }
    i = 0
    while i < w.worker_count {
        tc = dynamics.task_context_at(w, i)
        c.arena_capacity = math.max_int(c.arena_capacity, basics.arena_peak(&tc.arena))
        c.distance_iterations = math.max_int(c.distance_iterations, tc.distance_iterations)
        c.push_back_iterations = math.max_int(c.push_back_iterations, tc.push_back_iterations)
        c.root_iterations = math.max_int(c.root_iterations, tc.root_iterations)
        i = i + 1
    }
    return c
}

// The bytes a world holds, part by part as the reference adds them up
// (b3GetWorldByteCount), and logged part by part when asked; ours adds the
// fat boxes, the geometry it owns and the names.
world_byte_count(w: *World, logged: bool) -> long {
    total = 0 as long
    body_ids = id_bytes(&w.body_id_pool)
    set_ids = id_bytes(&w.solver_set_id_pool)
    joint_ids = id_bytes(&w.joint_id_pool)
    contact_ids = id_bytes(&w.contact_id_pool)
    island_ids = id_bytes(&w.island_id_pool)
    shape_ids = id_bytes(&w.shape_id_pool)
    total = total + ((body_ids + set_ids + joint_ids + contact_ids + island_ids + shape_ids) as long)
    if logged {
        basics.log("id pools")
        basics.log("body ids: ${body_ids}")
        basics.log("solver set ids: ${set_ids}")
        basics.log("joint ids: ${joint_ids}")
        basics.log("contact ids: ${contact_ids}")
        basics.log("island ids: ${island_ids}")
        basics.log("shape ids: ${shape_ids}")
    }

    island_links = 0
    i = 0
    while i < w.islands.count {
        island = dynamics.island_at(w, i)
        if island.island_id != NULL_INDEX {
            island_links = island_links + basics.ints_bytes(&island.bodies) + basics.buffer_bytes(&island.contacts) + basics.buffer_bytes(&island.joints)
        }
        i = i + 1
    }
    bodies = basics.buffer_bytes(&w.bodies)
    sets = basics.buffer_bytes(&w.solver_sets)
    joints = basics.buffer_bytes(&w.joints)
    contacts = basics.buffer_bytes(&w.contacts)
    islands = basics.buffer_bytes(&w.islands)
    shapes = basics.buffer_bytes(&w.shapes)
    sensors = basics.buffer_bytes(&w.sensors)
    fat_boxes = basics.buffer_bytes(&w.fat_aabbs)
    total = total + ((bodies + sets + joints + contacts + islands + island_links + shapes + sensors + fat_boxes) as long)
    if logged {
        basics.log("world arrays")
        basics.log("bodies: ${bodies}")
        basics.log("solver sets: ${sets}")
        basics.log("joints: ${joints}")
        basics.log("contacts: ${contacts}")
        basics.log("islands: ${islands}")
        basics.log("island links: ${island_links}")
        basics.log("shapes: ${shapes}")
        basics.log("sensors: ${sensors}")
        basics.log("fat bounds: ${fat_boxes}")
    }

    overlaps = 0
    i = 0
    while i < w.sensors.count {
        sensor = dynamics.sensor_at(w, i)
        overlaps = overlaps + basics.buffer_bytes(&sensor.hits) + basics.buffer_bytes(&sensor.overlaps1) + basics.buffer_bytes(&sensor.overlaps2)
        i = i + 1
    }
    total = total + (overlaps as long)
    if logged {
        basics.log("owned arrays")
        basics.log("sensor overlaps: ${overlaps}")
    }

    hull_map = basics.buffer_bytes(&w.hull_entries) + basics.map_bytes(&w.hull_heads)
    hull_data = 0
    i = 0
    while i < w.hull_entries.count {
        entry = dynamics.hull_entry_at(w, i)
        if entry.hull != null { hull_data = hull_data + (entry.hull as *HullData).byte_count }
        i = i + 1
    }
    owned = basics.buffer_bytes(&w.owned_geometry)
    i = 0
    while i < w.owned_geometry.count {
        owned = owned + ((w.owned_geometry.data + i * sizeof(OwnedGeometry)) as *OwnedGeometry).byte_count
        i = i + 1
    }
    total = total + ((hull_map + hull_data + owned) as long)
    if logged {
        basics.log("hulls")
        basics.log("database: ${hull_map} (${w.hull_count}, ${w.hull_entries.count})")
        basics.log("hull data: ${hull_data}")
        basics.log("owned geometry: ${owned}")
    }

    static_tree = dynamic_tree.tree_get_byte_count(broad_phase.broad_phase_tree(&w.broad_phase, dynamics.BODY_STATIC))
    kinematic_tree = dynamic_tree.tree_get_byte_count(broad_phase.broad_phase_tree(&w.broad_phase, dynamics.BODY_KINEMATIC))
    dynamic_tree_bytes = dynamic_tree.tree_get_byte_count(broad_phase.broad_phase_tree(&w.broad_phase, dynamics.BODY_DYNAMIC))
    pair_set = basics.set_bytes(&w.broad_phase.pair_set)
    total = total + ((static_tree + kinematic_tree + dynamic_tree_bytes + pair_set) as long)
    if logged {
        basics.log("broad-phase")
        basics.log("static tree: ${static_tree}")
        basics.log("kinematic tree: ${kinematic_tree}")
        basics.log("dynamic tree: ${dynamic_tree_bytes}")
        basics.log("pairSet: ${pair_set} (${basics.set_count(&w.broad_phase.pair_set)}, ${w.broad_phase.pair_set.capacity})")
    }

    allocator_array = basics.buffer_bytes(&w.manifold_allocators)
    allocator_blocks = 0
    allocators = w.manifold_allocators.data as BlockAllocator[]
    i = 0
    while i < w.manifold_allocators.count {
        allocator_blocks = allocator_blocks + basics.buffer_bytes(&allocators[i].blocks) + allocators[i].blocks.count * basics.BLOCK_SIZE * allocators[i].element_size
        i = i + 1
    }
    total = total + ((allocator_array + allocator_blocks) as long)
    if logged {
        basics.log("manifold allocators")
        basics.log("allocator array: ${allocator_array}")
        basics.log("blocks: ${allocator_blocks}")
    }

    body_sims = 0
    body_states = 0
    joint_sims = 0
    contact_sims = 0
    island_sims = 0
    i = 0
    while i < w.solver_sets.count {
        set = dynamics.solver_set_at(w, i)
        if set.set_index != NULL_INDEX {
            body_sims = body_sims + basics.buffer_bytes(&set.body_sims)
            body_states = body_states + basics.buffer_bytes(&set.body_states)
            joint_sims = joint_sims + basics.buffer_bytes(&set.joint_sims)
            contact_sims = contact_sims + basics.ints_bytes(&set.contact_indices)
            island_sims = island_sims + basics.buffer_bytes(&set.island_sims)
        }
        i = i + 1
    }
    total = total + ((body_sims + body_states + joint_sims + contact_sims + island_sims) as long)
    if logged {
        basics.log("solver sets")
        basics.log("body sim: ${body_sims}")
        basics.log("body state: ${body_states}")
        basics.log("joint sim: ${joint_sims}")
        basics.log("contact sim: ${contact_sims}")
        basics.log("island sim: ${island_sims}")
    }

    body_bits = 0
    graph_contacts = 0
    graph_joints = 0
    i = 0
    while i < dynamics.GRAPH_COLOR_COUNT {
        color = dynamics.graph_color(w, i)
        body_bits = body_bits + basics.bitset_bytes(&color.body_set)
        graph_contacts = graph_contacts + basics.ints_bytes(&color.convex_contacts) + basics.buffer_bytes(&color.contacts)
        graph_joints = graph_joints + basics.buffer_bytes(&color.joint_sims)
        i = i + 1
    }
    total = total + ((body_bits + graph_joints + graph_contacts) as long)
    if logged {
        basics.log("constraint graph")
        basics.log("body bit sets: ${body_bits}")
        basics.log("joint sim: ${graph_joints}")
        basics.log("contact sim: ${graph_contacts}")
    }

    task_contexts = w.worker_count * sizeof(TaskContext)
    i = 0
    while i < w.worker_count {
        tc = dynamics.task_context_at(w, i)
        task_contexts = task_contexts + basics.buffer_bytes(&tc.sensor_hits) + basics.bitset_bytes(&tc.contact_state) + basics.bitset_bytes(&tc.joint_state_bits) +
                        basics.bitset_bytes(&tc.hit_event_bits) + basics.bitset_bytes(&tc.awake_island_bits) + basics.arena_capacity(&tc.arena)
        i = i + 1
    }
    total = total + (task_contexts as long)
    if logged {
        basics.log("task contexts")
        basics.log("worker: ${task_contexts}")
    }

    events = basics.buffer_bytes(&w.body_move_events) + basics.buffer_bytes(&w.sensor_begin_events) + basics.buffer_bytes(&w.contact_begin_events) +
             basics.buffer_bytes(&w.sensor_end_events0) + basics.buffer_bytes(&w.sensor_end_events1) + basics.buffer_bytes(&w.contact_end_events0) +
             basics.buffer_bytes(&w.contact_end_events1) + basics.buffer_bytes(&w.contact_hit_events) + basics.buffer_bytes(&w.joint_events)
    names = basics.name_cache_bytes(&w.names)
    total = total + ((events + names) as long)
    if logged {
        basics.log("events: ${events}")
        basics.log("names: ${names}")
    }

    stack = basics.stack_capacity(&w.stack)
    total = total + (stack as long)
    if logged {
        basics.log("stack allocator: ${stack}")
        basics.log("total: ${total / (1024 as long)} KB")
    }
    return total
}

// An id pool's free list, in bytes (the reference's b3GetIdBytes).
id_bytes(p: *IdPool) -> int { return basics.ints_bytes(&p.free_ids) }

// The world's memory, part by part, to the host's log (b3World_DumpMemoryStats).
dump_memory_stats(id: WorldId) {
    w = world_of(id)
    if w == null { return }
    world_byte_count(w, true)
}

// The worker count, set between steps and clamped to [1, MAX_WORKERS]
// (b3World_SetWorkerCount); a world on a host's scheduler keeps the
// scheduler's count.
set_worker_count(id: WorldId, count: int) {
    w = world_of(id)
    if w == null { return }
    dynamics.set_worker_count(w, count)
}

get_worker_count(id: WorldId) -> int {
    if dynamics.world_is_valid(id) == false { return 0 }
    return dynamics.get_world(id.index1 - 1).worker_count
}

// The bounds of everything in the trees.
get_bounds(id: WorldId) -> AABB {
    w = dynamics.get_world(id.index1 - 1)
    bounds = math.aabb_empty()
    i = 0
    while i < BODY_KIND_COUNT {
        tree = broad_phase.broad_phase_tree(&w.broad_phase, i)
        if dynamic_tree.tree_get_proxy_count(tree) > 0 { bounds = math.aabb_union(bounds, dynamic_tree.tree_get_root_bounds(tree)) }
        i = i + 1
    }
    return bounds
}

rebuild_static_tree(id: WorldId) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_REBUILD_STATIC_TREE); dynamics.rec_end(recorder) }
    w = world_of(id)
    if w != null { dynamic_tree.tree_rebuild(broad_phase.broad_phase_tree(&w.broad_phase, dynamics.BODY_STATIC), true) }
}

// --- the world queries ------------------------------------------------------------------------------------------------

// The user material id of a shape's material by index.
material_user_id(s: *WorldShape, material_index: int) -> long {
    index = math.clamp_int(material_index, 0, s.material_count - 1)
    if s.materials == null { return s.material.user_material_id }
    materials = s.materials as SurfaceMaterial[]
    return materials[index].user_material_id
}

// A body's transform relative to a query origin.
relative_transform(w: *World, body_id: int, origin: Vec3) -> Transform {
    t = dynamics.get_body_transform(w, body_id)
    return Transform { p: math.sub(t.p, origin), q: t.q }
}

struct WorldQueryContext {
    w: *World
    visitor: fn(ShapeId, ptr) -> bool
    filter: QueryFilter
    proxy: ShapeProxy
    origin: Vec3
    user_context: ptr
}

// A query's or a setter's number: finite and not below zero.
nonnegative(x: float) -> bool { return math.is_valid_float(x) && x >= 0.0 }

// A mover's capsule: its two centres finite, its radius finite and not below zero.
valid_capsule(c: Capsule) -> bool { return math.is_valid_vec3(c.center1) && math.is_valid_vec3(c.center2) && nonnegative(c.radius) }

aabb_query_visitor(proxy_id: int, user_data: long, context: ptr) -> bool {
    qc = context as *WorldQueryContext
    w = qc.w
    s = dynamics.world_shape_at(w, user_data as int)
    if shape.should_query_collide(s.filter, qc.filter) == false { return true }
    visitor = qc.visitor
    return visitor(dynamics.make_shape_id(w, s), qc.user_context)
}

// overlap_aabb's work, unrecorded.
overlap_aabb_internal(id: WorldId, box: AABB, filter: QueryFilter, visitor: fn(ShapeId, ptr) -> bool, context: ptr) -> TreeStats {
    stats = TreeStats { node_visits: 0, leaf_visits: 0 }
    w = world_of(id)
    if w == null { return stats }
    if math.is_valid_aabb(box) == false { return stats }
    qc = WorldQueryContext { w: w, visitor: visitor, filter: filter, proxy: distance.shape_proxy(null, 0, 0.0), origin: math.vec3_zero(), user_context: context }
    i = 0
    while i < BODY_KIND_COUNT {
        result = dynamic_tree.tree_query(broad_phase.broad_phase_tree(&w.broad_phase, i), box, filter.mask_bits, false, aabb_query_visitor, (&qc) as ptr)
        stats.node_visits = stats.node_visits + result.node_visits
        stats.leaf_visits = stats.leaf_visits + result.leaf_visits
        i = i + 1
    }
    return stats
}

shape_overlap_visitor(proxy_id: int, user_data: long, context: ptr) -> bool {
    qc = context as *WorldQueryContext
    w = qc.w
    s = dynamics.world_shape_at(w, user_data as int)
    if shape.should_query_collide(s.filter, qc.filter) == false { return true }
    t = relative_transform(w, s.body_id, qc.origin)
    if shape.overlap_shape(&s.geometry, t, qc.proxy) == false { return true }
    visitor = qc.visitor
    return visitor(dynamics.make_shape_id(w, s), qc.user_context)
}

// overlap_shape's work, unrecorded.
overlap_shape_internal(id: WorldId, origin: Vec3, proxy: ShapeProxy, filter: QueryFilter, visitor: fn(ShapeId, ptr) -> bool, context: ptr) -> TreeStats {
    stats = TreeStats { node_visits: 0, leaf_visits: 0 }
    w = world_of(id)
    if w == null { return stats }
    if math.is_valid_position(origin) == false { return stats }
    box = math.offset_aabb(math.make_aabb(proxy.points as float[], proxy.count, proxy.radius), origin)
    qc = WorldQueryContext { w: w, visitor: visitor, filter: filter, proxy: proxy, origin: origin, user_context: context }
    i = 0
    while i < BODY_KIND_COUNT {
        result = dynamic_tree.tree_query(broad_phase.broad_phase_tree(&w.broad_phase, i), box, filter.mask_bits, false, shape_overlap_visitor, (&qc) as ptr)
        stats.node_visits = stats.node_visits + result.node_visits
        stats.leaf_visits = stats.leaf_visits + result.leaf_visits
        i = i + 1
    }
    return stats
}

struct WorldMoverContext {
    w: *World
    visitor: fn(ShapeId, PlaneResult[], int, ptr) -> bool
    filter: QueryFilter
    mover: Capsule
    origin: Vec3
    user_context: ptr
    planes: ptr              // PlaneResult[MOVER_PLANE_CAPACITY], this query's own
}

const MOVER_PLANE_CAPACITY = 64
mover_collide_visitor(proxy_id: int, user_data: long, context: ptr) -> bool {
    mc = context as *WorldMoverContext
    w = mc.w
    s = dynamics.world_shape_at(w, user_data as int)
    if shape.should_query_collide(s.filter, mc.filter) == false { return true }
    t = relative_transform(w, s.body_id, mc.origin)
    planes = mc.planes as PlaneResult[]
    count = shape.collide_mover(planes, MOVER_PLANE_CAPACITY, &s.geometry, t, mc.mover)
    if count > 0 {
        visitor = mc.visitor
        return visitor(dynamics.make_shape_id(w, s), planes, count, mc.user_context)
    }
    return true
}

// collide_mover's work, unrecorded.
collide_mover_internal(id: WorldId, origin: Vec3, mover: Capsule, filter: QueryFilter, visitor: fn(ShapeId, PlaneResult[], int, ptr) -> bool, context: ptr) {
    w = world_of(id)
    if w == null { return }
    if math.is_valid_position(origin) == false || valid_capsule(mover) == false { return }
    r = math.vec3(mover.radius, mover.radius, mover.radius)
    box = math.offset_aabb(AABB { lower: math.sub(math.min_vec3(mover.center1, mover.center2), r), upper: math.add(math.max_vec3(mover.center1, mover.center2), r) }, origin)
    // The planes a visitor reads are this query's own block, as the
    // reference's are on its stack: a visitor that queries the mover again
    // (a character checking a platform) does not overwrite them.
    planes_block = basics.alloc(MOVER_PLANE_CAPACITY * sizeof(PlaneResult))
    mc = WorldMoverContext { w: w, visitor: visitor, filter: filter, mover: mover, origin: origin, user_context: context, planes: planes_block }
    i = 0
    while i < BODY_KIND_COUNT {
        dynamic_tree.tree_query(broad_phase.broad_phase_tree(&w.broad_phase, i), box, filter.mask_bits, false, mover_collide_visitor, (&mc) as ptr)
        i = i + 1
    }
    basics.free_bytes(planes_block, MOVER_PLANE_CAPACITY * sizeof(PlaneResult))
}

struct WorldCastContext {
    w: *World
    visitor: fn(ShapeId, Vec3, Vec3, float, long, int, int, ptr) -> float
    filter: QueryFilter
    fraction: float
    origin: Vec3
    proxy: ShapeProxy
    translation: Vec3
    can_encroach: bool
    user_context: ptr
}

ray_cast_visitor(input: *RayCastInput, proxy_id: int, user_data: long, context: ptr) -> float {
    cc = context as *WorldCastContext
    w = cc.w
    s = dynamics.world_shape_at(w, user_data as int)
    if shape.should_query_collide(s.filter, cc.filter) == false { return input.max_fraction }
    t = relative_transform(w, s.body_id, cc.origin)
    output = shape.ray_cast_shape(&s.geometry, t, math.vec3_zero(), input.translation, input.max_fraction)
    if output.hit {
        visitor = cc.visitor
        fraction = visitor(dynamics.make_shape_id(w, s), math.add(cc.origin, output.point), output.normal, output.fraction,
                           material_user_id(s, output.material_index), output.triangle_index, output.child_index, cc.user_context)
        // A visitor returning -1 skips the shape.
        if 0.0 <= fraction && fraction <= 1.0 { cc.fraction = fraction }
        return fraction
    }
    return input.max_fraction
}

// cast_ray's work, unrecorded.
cast_ray_internal(id: WorldId, origin: Vec3, translation: Vec3, filter: QueryFilter,
         visitor: fn(ShapeId, Vec3, Vec3, float, long, int, int, ptr) -> float, context: ptr) -> TreeStats {
    stats = TreeStats { node_visits: 0, leaf_visits: 0 }
    w = world_of(id)
    if w == null { return stats }
    if math.is_valid_position(origin) == false || math.is_valid_vec3(translation) == false { return stats }
    input = RayCastInput { origin: origin, translation: translation, max_fraction: 1.0 }
    cc = WorldCastContext { w: w, visitor: visitor, filter: filter, fraction: 1.0, origin: origin, proxy: distance.shape_proxy(null, 0, 0.0),
                       translation: translation, can_encroach: false, user_context: context }
    i = 0
    while i < BODY_KIND_COUNT {
        result = dynamic_tree.tree_ray_cast(broad_phase.broad_phase_tree(&w.broad_phase, i), &input, filter.mask_bits, false, ray_cast_visitor, (&cc) as ptr)
        stats.node_visits = stats.node_visits + result.node_visits
        stats.leaf_visits = stats.leaf_visits + result.leaf_visits
        if cc.fraction == 0.0 { return stats }
        input.max_fraction = cc.fraction
        i = i + 1
    }
    return stats
}

closest_ray_visitor(shape_id: ShapeId, point: Vec3, normal: Vec3, fraction: float, user_material_id: long, triangle_index: int, child_index: int, context: ptr) -> float {
    // An initial overlap is ignored.
    if fraction == 0.0 { return 0.0 - 1.0 }
    result = context as *RayResult
    result.shape_id = shape_id
    result.point = point
    result.normal = normal
    result.fraction = fraction
    result.user_material_id = user_material_id
    result.triangle_index = triangle_index
    result.child_index = child_index
    result.hit = true
    return fraction
}

// cast_ray_closest's work, unrecorded.
cast_ray_closest_internal(id: WorldId, origin: Vec3, translation: Vec3, filter: QueryFilter) -> RayResult {
    result = RayResult { shape_id: dynamics.null_shape_id(), point: math.vec3_zero(), normal: math.vec3_zero(), user_material_id: 0 as long,
                         fraction: 0.0, triangle_index: 0, child_index: 0, node_visits: 0, leaf_visits: 0, hit: false }
    w = world_of(id)
    if w == null { return result }
    if math.is_valid_position(origin) == false || math.is_valid_vec3(translation) == false { return result }
    input = RayCastInput { origin: origin, translation: translation, max_fraction: 1.0 }
    cc = WorldCastContext { w: w, visitor: closest_ray_visitor, filter: filter, fraction: 1.0, origin: origin, proxy: distance.shape_proxy(null, 0, 0.0),
                       translation: translation, can_encroach: false, user_context: (&result) as ptr }
    i = 0
    while i < BODY_KIND_COUNT {
        stats = dynamic_tree.tree_ray_cast(broad_phase.broad_phase_tree(&w.broad_phase, i), &input, filter.mask_bits, false, ray_cast_visitor, (&cc) as ptr)
        result.node_visits = result.node_visits + stats.node_visits
        result.leaf_visits = result.leaf_visits + stats.leaf_visits
        if cc.fraction == 0.0 { return result }
        input.max_fraction = cc.fraction
        i = i + 1
    }
    return result
}

shape_cast_visitor(input: *BoxCastInput, proxy_id: int, user_data: long, context: ptr) -> float {
    cc = context as *WorldCastContext
    w = cc.w
    s = dynamics.world_shape_at(w, user_data as int)
    if shape.should_query_collide(s.filter, cc.filter) == false { return input.max_fraction }
    t = relative_transform(w, s.body_id, cc.origin)
    output = shape.shape_cast_shape(&s.geometry, t, cc.proxy, cc.translation, input.max_fraction, cc.can_encroach)
    if output.hit {
        visitor = cc.visitor
        fraction = visitor(dynamics.make_shape_id(w, s), math.add(cc.origin, output.point), output.normal, output.fraction,
                           material_user_id(s, output.material_index), output.triangle_index, output.child_index, cc.user_context)
        if 0.0 <= fraction && fraction <= 1.0 { cc.fraction = fraction }
        return fraction
    }
    return input.max_fraction
}

// cast_shape's work, unrecorded.
cast_shape_internal(id: WorldId, origin: Vec3, proxy: ShapeProxy, translation: Vec3, filter: QueryFilter,
           visitor: fn(ShapeId, Vec3, Vec3, float, long, int, int, ptr) -> float, context: ptr) -> TreeStats {
    stats = TreeStats { node_visits: 0, leaf_visits: 0 }
    w = world_of(id)
    if w == null { return stats }
    if math.is_valid_position(origin) == false || math.is_valid_vec3(translation) == false { return stats }
    local_box = math.make_aabb(proxy.points as float[], proxy.count, proxy.radius)
    input = BoxCastInput { box: math.offset_aabb(local_box, origin), translation: translation, max_fraction: 1.0 }
    cc = WorldCastContext { w: w, visitor: visitor, filter: filter, fraction: 1.0, origin: origin, proxy: proxy, translation: translation,
                       can_encroach: false, user_context: context }
    i = 0
    while i < BODY_KIND_COUNT {
        result = dynamic_tree.tree_box_cast(broad_phase.broad_phase_tree(&w.broad_phase, i), &input, filter.mask_bits, false, shape_cast_visitor, (&cc) as ptr)
        stats.node_visits = stats.node_visits + result.node_visits
        stats.leaf_visits = stats.leaf_visits + result.leaf_visits
        if cc.fraction == 0.0 { return stats }
        input.max_fraction = cc.fraction
        i = i + 1
    }
    return stats
}

struct WorldMoverCastContext {
    w: *World
    filter_fn: fn(ShapeId, ptr) -> bool
    has_filter: bool
    filter: QueryFilter
    fraction: float
    origin: Vec3
    proxy: ShapeProxy
    translation: Vec3
    can_encroach: bool
    user_context: ptr
    point1: Vec3             // the mover's segment, which proxy points at: this cast's own
    point2: Vec3
}

mover_cast_visitor(input: *BoxCastInput, proxy_id: int, user_data: long, context: ptr) -> float {
    mc = context as *WorldMoverCastContext
    w = mc.w
    s = dynamics.world_shape_at(w, user_data as int)
    if shape.should_query_collide(s.filter, mc.filter) == false { return mc.fraction }
    if mc.has_filter {
        filter_fn = mc.filter_fn
        if filter_fn(dynamics.make_shape_id(w, s), mc.user_context) == false { return mc.fraction }
    }
    t = relative_transform(w, s.body_id, mc.origin)
    output = shape.shape_cast_shape(&s.geometry, t, mc.proxy, mc.translation, input.max_fraction, mc.can_encroach)
    // A shape already overlapped is ignored.
    if output.fraction == 0.0 { return mc.fraction }
    mc.fraction = output.fraction
    return output.fraction
}

var g_mover_points: ptr = null   // Vec3[2]
mover_points() -> ptr { return native.scratch(g_mover_points, 2 * sizeof(Vec3)) }

// cast_mover's work, unrecorded.
cast_mover_internal(id: WorldId, origin: Vec3, mover: Capsule, translation: Vec3, filter: QueryFilter, has_filter: bool, filter_fn: fn(ShapeId, ptr) -> bool, context: ptr) -> float {
    w = world_of(id)
    if w == null { return 1.0 }
    if math.is_valid_position(origin) == false || math.is_valid_vec3(translation) == false || valid_capsule(mover) == false { return 1.0 }
    // The segment lives in this cast's context, as the reference's on its
    // stack: a filter that casts again (or asks a body's time of impact) does
    // not move it under this cast.
    mc = WorldMoverCastContext { w: w, filter_fn: filter_fn, has_filter: has_filter, filter: filter, fraction: 1.0, origin: origin,
                            proxy: distance.shape_proxy(null, 2, mover.radius), translation: translation,
                            can_encroach: mover.radius > 0.0, user_context: context, point1: mover.center1, point2: mover.center2 }
    mc.proxy.points = (&mc.point1) as ptr
    input = BoxCastInput { box: math.offset_aabb(math.make_aabb(mc.proxy.points as float[], 2, mover.radius), origin), translation: translation, max_fraction: 1.0 }
    i = 0
    while i < BODY_KIND_COUNT {
        dynamic_tree.tree_box_cast(broad_phase.broad_phase_tree(&w.broad_phase, i), &input, filter.mask_bits, false, mover_cast_visitor, (&mc) as ptr)
        if mc.fraction == 0.0 { return 0.0 }
        input.max_fraction = mc.fraction
        i = i + 1
    }
    return mc.fraction
}

// --- the queries recorded (#149) ------------------------------------------------------------------

// A query while its world records (the reference's b3RecQueryWriter): its
// own bytes, and the caller's visitor and context, which a trampoline
// calls, writing each visit and the caller's answer so a replay can ask
// the same query and give the same answers. Queries do not change the
// world, so the record goes in after the query, whole.
struct QueryRecorder {
    payload: *Recording
    overlap: fn(ShapeId, ptr) -> bool
    cast: fn(ShapeId, Vec3, Vec3, float, long, int, int, ptr) -> float
    planes: fn(ShapeId, PlaneResult[], int, ptr) -> bool
    has_overlap: bool              // the caller gave an overlap visitor (a cast mover's filter is optional)
    context: ptr
    count: int                     // the visits written
}

accept_shape(shape_id: ShapeId, context: ptr) -> bool { return true }
keep_cast(shape_id: ShapeId, point: Vec3, normal: Vec3, fraction: float, user_material_id: long, triangle_index: int, child_index: int, context: ptr) -> float { return 1.0 }
accept_planes(shape_id: ShapeId, planes: PlaneResult[], count: int, context: ptr) -> bool { return true }

query_recorder(context: ptr) -> QueryRecorder {
    return QueryRecorder { payload: dynamics.rec_payload_create(), overlap: accept_shape, cast: keep_cast, planes: accept_planes,
                           has_overlap: false, context: context, count: 0 }
}

// Whether the query asked of `id` is one to record: the world records and
// is not stepping (a stepping world answers no query).
recording_query(id: WorldId) -> bool { return world_of(id) != null && dynamics.recording_on(id.index1 - 1) }

// The query's record committed with its caller's tag, its bytes freed.
finish_query(id: WorldId, op: int, q: *QueryRecorder, filter: QueryFilter) {
    dynamics.rec_commit_query(id.index1 - 1, op, q.payload, filter.id, filter.name)
    dynamics.rec_payload_destroy(q.payload)
}

rec_tree_stats(payload: *Recording, stats: TreeStats) {
    dynamics.rec_int(payload, stats.node_visits)
    dynamics.rec_int(payload, stats.leaf_visits)
}

// A visit written: the shape and the caller's answer.
record_overlap_visit(shape_id: ShapeId, context: ptr) -> bool {
    q = context as *QueryRecorder
    answer = true
    if q.has_overlap {
        visitor = q.overlap
        answer = visitor(shape_id, q.context)
    }
    dynamics.rec_id(q.payload, shape_id.index1, shape_id.generation)
    dynamics.rec_bool(q.payload, answer)
    q.count = q.count + 1
    return answer
}

// A hit written: everything the visitor was given and its answer.
record_cast_visit(shape_id: ShapeId, point: Vec3, normal: Vec3, fraction: float, user_material_id: long, triangle_index: int, child_index: int, context: ptr) -> float {
    q = context as *QueryRecorder
    visitor = q.cast
    answer = visitor(shape_id, point, normal, fraction, user_material_id, triangle_index, child_index, q.context)
    dynamics.rec_id(q.payload, shape_id.index1, shape_id.generation)
    dynamics.rec_vec3(q.payload, point)
    dynamics.rec_vec3(q.payload, normal)
    dynamics.rec_float(q.payload, fraction)
    dynamics.rec_long(q.payload, user_material_id)
    dynamics.rec_int(q.payload, triangle_index)
    dynamics.rec_int(q.payload, child_index)
    dynamics.rec_float(q.payload, answer)
    q.count = q.count + 1
    return answer
}

// A shape's planes written: the shape, its planes and the caller's answer.
record_plane_visit(shape_id: ShapeId, planes: PlaneResult[], count: int, context: ptr) -> bool {
    q = context as *QueryRecorder
    visitor = q.planes
    answer = visitor(shape_id, planes, count, q.context)
    dynamics.rec_id(q.payload, shape_id.index1, shape_id.generation)
    dynamics.rec_int(q.payload, count)
    i = 0
    while i < count {
        dynamics.rec_plane_result(q.payload, planes[i])
        i = i + 1
    }
    dynamics.rec_bool(q.payload, answer)
    q.count = q.count + 1
    return answer
}

// Every shape whose fat bounds overlap the box, through the visitor
// until it returns false; the tree visits made.
overlap_aabb(id: WorldId, box: AABB, filter: QueryFilter, visitor: fn(ShapeId, ptr) -> bool, context: ptr) -> TreeStats {
    if recording_query(id) == false { return overlap_aabb_internal(id, box, filter, visitor, context) }
    q = query_recorder(context)
    q.overlap = visitor
    q.has_overlap = true
    dynamics.rec_aabb(q.payload, box)
    dynamics.rec_query_filter(q.payload, filter)
    count_at = q.payload.size
    dynamics.rec_int(q.payload, 0)
    stats = overlap_aabb_internal(id, box, filter, record_overlap_visit, (&q) as ptr)
    dynamics.rec_patch_int(q.payload, count_at, q.count)
    rec_tree_stats(q.payload, stats)
    finish_query(id, dynamics.OP_QUERY_OVERLAP_AABB, &q, filter)
    return stats
}

// Every shape a convex proxy (given relative to the origin) overlaps.
overlap_shape(id: WorldId, origin: Vec3, proxy: ShapeProxy, filter: QueryFilter, visitor: fn(ShapeId, ptr) -> bool, context: ptr) -> TreeStats {
    if recording_query(id) == false { return overlap_shape_internal(id, origin, proxy, filter, visitor, context) }
    q = query_recorder(context)
    q.overlap = visitor
    q.has_overlap = true
    dynamics.rec_vec3(q.payload, origin)
    dynamics.rec_shape_proxy(q.payload, proxy)
    dynamics.rec_query_filter(q.payload, filter)
    count_at = q.payload.size
    dynamics.rec_int(q.payload, 0)
    stats = overlap_shape_internal(id, origin, proxy, filter, record_overlap_visit, (&q) as ptr)
    dynamics.rec_patch_int(q.payload, count_at, q.count)
    rec_tree_stats(q.payload, stats)
    finish_query(id, dynamics.OP_QUERY_OVERLAP_SHAPE, &q, filter)
    return stats
}

// The planes of every shape the character mover's capsule (relative to
// the origin) touches, a shape's planes at a time (up to 64), through
// the visitor until it returns false.
collide_mover(id: WorldId, origin: Vec3, mover: Capsule, filter: QueryFilter, visitor: fn(ShapeId, PlaneResult[], int, ptr) -> bool, context: ptr) {
    if recording_query(id) == false {
        collide_mover_internal(id, origin, mover, filter, visitor, context)
        return
    }
    q = query_recorder(context)
    q.planes = visitor
    dynamics.rec_vec3(q.payload, origin)
    dynamics.rec_capsule_value(q.payload, mover)
    dynamics.rec_query_filter(q.payload, filter)
    count_at = q.payload.size
    dynamics.rec_int(q.payload, 0)
    collide_mover_internal(id, origin, mover, filter, record_plane_visit, (&q) as ptr)
    dynamics.rec_patch_int(q.payload, count_at, q.count)
    finish_query(id, dynamics.OP_QUERY_COLLIDE_MOVER, &q, filter)
}

// A ray from the origin along the translation: each hit through the
// visitor, whose return clips the ray (0 stops it, 1 keeps everything,
// -1 ignores that shape); the tree visits made.
cast_ray(id: WorldId, origin: Vec3, translation: Vec3, filter: QueryFilter,
         visitor: fn(ShapeId, Vec3, Vec3, float, long, int, int, ptr) -> float, context: ptr) -> TreeStats {
    if recording_query(id) == false { return cast_ray_internal(id, origin, translation, filter, visitor, context) }
    q = query_recorder(context)
    q.cast = visitor
    dynamics.rec_vec3(q.payload, origin)
    dynamics.rec_vec3(q.payload, translation)
    dynamics.rec_query_filter(q.payload, filter)
    count_at = q.payload.size
    dynamics.rec_int(q.payload, 0)
    stats = cast_ray_internal(id, origin, translation, filter, record_cast_visit, (&q) as ptr)
    dynamics.rec_patch_int(q.payload, count_at, q.count)
    rec_tree_stats(q.payload, stats)
    finish_query(id, dynamics.OP_QUERY_CAST_RAY, &q, filter)
    return stats
}

// The closest hit of a ray, the common query of games.
cast_ray_closest(id: WorldId, origin: Vec3, translation: Vec3, filter: QueryFilter) -> RayResult {
    if recording_query(id) == false { return cast_ray_closest_internal(id, origin, translation, filter) }
    payload = dynamics.rec_payload_create()
    dynamics.rec_vec3(payload, origin)
    dynamics.rec_vec3(payload, translation)
    dynamics.rec_query_filter(payload, filter)
    result = cast_ray_closest_internal(id, origin, translation, filter)
    rec_ray_result(payload, result)
    dynamics.rec_commit_query(id.index1 - 1, dynamics.OP_QUERY_CAST_RAY_CLOSEST, payload, filter.id, filter.name)
    dynamics.rec_payload_destroy(payload)
    return result
}

rec_ray_result(payload: *Recording, result: RayResult) {
    dynamics.rec_bool(payload, result.hit)
    dynamics.rec_id(payload, result.shape_id.index1, result.shape_id.generation)
    dynamics.rec_vec3(payload, result.point)
    dynamics.rec_vec3(payload, result.normal)
    dynamics.rec_float(payload, result.fraction)
    dynamics.rec_long(payload, result.user_material_id)
    dynamics.rec_int(payload, result.triangle_index)
    dynamics.rec_int(payload, result.child_index)
    dynamics.rec_int(payload, result.node_visits)
    dynamics.rec_int(payload, result.leaf_visits)
}

// A convex proxy (relative to the origin) swept along the translation,
// each hit through the visitor as the ray cast's.
cast_shape(id: WorldId, origin: Vec3, proxy: ShapeProxy, translation: Vec3, filter: QueryFilter,
           visitor: fn(ShapeId, Vec3, Vec3, float, long, int, int, ptr) -> float, context: ptr) -> TreeStats {
    if recording_query(id) == false { return cast_shape_internal(id, origin, proxy, translation, filter, visitor, context) }
    q = query_recorder(context)
    q.cast = visitor
    dynamics.rec_vec3(q.payload, origin)
    dynamics.rec_shape_proxy(q.payload, proxy)
    dynamics.rec_vec3(q.payload, translation)
    dynamics.rec_query_filter(q.payload, filter)
    count_at = q.payload.size
    dynamics.rec_int(q.payload, 0)
    stats = cast_shape_internal(id, origin, proxy, translation, filter, record_cast_visit, (&q) as ptr)
    dynamics.rec_patch_int(q.payload, count_at, q.count)
    rec_tree_stats(q.payload, stats)
    finish_query(id, dynamics.OP_QUERY_CAST_SHAPE, &q, filter)
    return stats
}

// The fraction of the translation the mover's capsule can travel before
// touching a shape (its filter asked per shape when given). Recorded, the
// filter is asked through the recorder for every candidate, given or not,
// so a replay sees the same decisions.
cast_mover(id: WorldId, origin: Vec3, mover: Capsule, translation: Vec3, filter: QueryFilter, has_filter: bool, filter_fn: fn(ShapeId, ptr) -> bool, context: ptr) -> float {
    if recording_query(id) == false { return cast_mover_internal(id, origin, mover, translation, filter, has_filter, filter_fn, context) }
    q = query_recorder(context)
    q.overlap = filter_fn
    q.has_overlap = has_filter
    dynamics.rec_vec3(q.payload, origin)
    dynamics.rec_capsule_value(q.payload, mover)
    dynamics.rec_vec3(q.payload, translation)
    dynamics.rec_query_filter(q.payload, filter)
    count_at = q.payload.size
    dynamics.rec_int(q.payload, 0)
    fraction = cast_mover_internal(id, origin, mover, translation, filter, true, record_overlap_visit, (&q) as ptr)
    dynamics.rec_patch_int(q.payload, count_at, q.count)
    dynamics.rec_float(q.payload, fraction)
    finish_query(id, dynamics.OP_QUERY_CAST_MOVER, &q, filter)
    return fraction
}

// --- debug draw (the reference's b3World_Draw) ---------------------------------------------------------

struct DrawContext {
    w: *World
    draw: *DebugDraw
}

// A shape's colour as the reference picks it: its material's own colour
// when it has one, else its body's state as a hue and its energy as a
// material (calm matte for resting masses, glossy for fast bodies,
// metallic for a driven kinematic; diagnostic states saturated).
shape_draw_color(w: *World, s: *WorldShape, body: *Body, sim: *BodySim) -> int {
    first = s.material
    if s.materials != null { first = (s.materials as SurfaceMaterial[])[0] }
    if first.custom_color != 0 { return first.custom_color }
    flags = body.flags | sim.flags
    rgb = debug_draw.COLOR_LIGHT_SLATE_GRAY
    look = debug_draw.DEBUG_MATERIAL_DEAD
    if body.kind == dynamics.BODY_DYNAMIC && body.mass == 0.0 {
        // A dynamic body without mass.
        rgb = debug_draw.COLOR_RED
        look = debug_draw.DEBUG_MATERIAL_DEFAULT
    } else if body.set_index == dynamics.DISABLED_SET {
        rgb = debug_draw.COLOR_SLATE_GRAY
        look = debug_draw.DEBUG_MATERIAL_DEFAULT
    } else if s.sensor_index != NULL_INDEX {
        rgb = debug_draw.COLOR_WHEAT
        look = debug_draw.DEBUG_MATERIAL_DEFAULT
    } else if (flags & dynamics.HAD_TIME_OF_IMPACT) != 0 {
        rgb = debug_draw.COLOR_LIME
        look = debug_draw.DEBUG_MATERIAL_DEFAULT
    } else if (flags & dynamics.IS_BULLET) != 0 && body.set_index == dynamics.AWAKE_SET {
        rgb = debug_draw.COLOR_TURQUOISE
        look = debug_draw.DEBUG_MATERIAL_DEFAULT
    } else if (flags & dynamics.IS_SPEED_CAPPED) != 0 {
        rgb = debug_draw.COLOR_YELLOW
        look = debug_draw.DEBUG_MATERIAL_DEFAULT
    } else if (flags & dynamics.IS_FAST) != 0 {
        rgb = debug_draw.COLOR_ORANGE
        look = debug_draw.DEBUG_MATERIAL_GLOSSY
    } else if body.kind == dynamics.BODY_STATIC {
        rgb = debug_draw.COLOR_DARK_GRAY
        look = debug_draw.DEBUG_MATERIAL_MATTE
    } else if body.kind == dynamics.BODY_KINEMATIC {
        if body.set_index == dynamics.AWAKE_SET {
            rgb = debug_draw.COLOR_STEEL_BLUE
            look = debug_draw.DEBUG_MATERIAL_METALLIC
        } else {
            rgb = debug_draw.COLOR_LIGHT_STEEL_BLUE
            look = debug_draw.DEBUG_MATERIAL_MATTE
        }
    } else if body.set_index == dynamics.AWAKE_SET {
        rgb = debug_draw.COLOR_TAN
        look = debug_draw.DEBUG_MATERIAL_SOFT
    }
    return debug_draw.make_debug_color(rgb, look)
}

// The host's drawable for the shape, made the first time the shape is drawn.
debug_shape_of(w: *World, s: *WorldShape) -> ptr {
    if s.user_shape != null { return s.user_shape }
    g = &s.geometry
    shown = DebugShape { shape_id: dynamics.make_shape_id(w, s), kind: g.kind, sphere: null, capsule: null, hull: null, mesh: null,
                         height_field: null, compound: null }
    if g.kind == shape.SHAPE_SPHERE { shown.sphere = &g.sphere }
    else if g.kind == shape.SHAPE_CAPSULE { shown.capsule = &g.capsule }
    else if g.kind == shape.SHAPE_HULL { shown.hull = g.hull }
    else if g.kind == shape.SHAPE_MESH { shown.mesh = &g.mesh }
    else if g.kind == shape.SHAPE_HEIGHT_FIELD { shown.height_field = g.height_field }
    else if g.kind == shape.SHAPE_COMPOUND { shown.compound = g.compound }
    create = w.create_debug_shape
    s.user_shape = create(&shown, w.debug_shape_context)
    return s.user_shape
}

draw_query_visitor(proxy_id: int, user_data: long, context: ptr) -> bool {
    dc = context as *DrawContext
    w = dc.w
    draw = dc.draw
    s = dynamics.world_shape_at(w, user_data as int)
    basics.bitset_set(&w.debug_body_set, s.body_id)
    if draw.draw_shapes {
        body = dynamics.body_at(w, s.body_id)
        sim = dynamics.get_body_sim(w, body)
        color = shape_draw_color(w, s, body, sim)
        user_shape = debug_shape_of(w, s)
        if user_shape != null {
            show = draw.draw_shape
            show(user_shape, sim.transform, color, draw.context)
        }
    }
    if draw.draw_bounds_option {
        bounds = draw.draw_bounds
        bounds(math.aabb_widen(dynamics.shape_fat_aabb(w, s.id)), debug_draw.COLOR_GOLD, draw.context)
    }
    return true
}

// The world drawn through the host's callbacks (b3World_Draw): the shapes
// whose bounds overlap the drawing bounds (and whose categories the mask
// takes), then for their bodies what the options ask: names, mass, sleep,
// joints, contacts (points by state or graph colour, normals with
// separations, forces, features) and islands. Nothing while the world
// steps.
world_draw(id: WorldId, draw: *DebugDraw, mask_bits: long) {
    w = world_of(id)
    if w == null || math.is_valid_aabb(draw.drawing_bounds) == false { return }
    axis_scale = 0.3
    basics.bitset_set_count_and_clear(&w.debug_body_set, basics.idpool_capacity(&w.body_id_pool))
    basics.bitset_set_count_and_clear(&w.debug_joint_set, basics.idpool_capacity(&w.joint_id_pool))
    basics.bitset_set_count_and_clear(&w.debug_contact_set, basics.idpool_capacity(&w.contact_id_pool))
    basics.bitset_set_count_and_clear(&w.debug_island_set, basics.idpool_capacity(&w.island_id_pool))
    dc = DrawContext { w: w, draw: draw }
    i = 0
    while i < BODY_KIND_COUNT {
        dynamic_tree.tree_query(broad_phase.broad_phase_tree(&w.broad_phase, i), draw.drawing_bounds, mask_bits, false, draw_query_visitor, (&dc) as ptr)
        i = i + 1
    }
    body_id = 0
    while body_id < w.bodies.count {
        if basics.bitset_get(&w.debug_body_set, body_id) { draw_body_extras(w, draw, body_id, axis_scale) }
        body_id = body_id + 1
    }
}

// What the options ask of one drawn body.
draw_body_extras(w: *World, draw: *DebugDraw, body_id: int, axis_scale: float) {
    point = draw.draw_point
    label = draw.draw_string
    body = dynamics.body_at(w, body_id)
    sim = dynamics.get_body_sim(w, body)
    at_center = Transform { p: sim.center, q: sim.transform.q }
    offset = math.vec3(0.05, 0.05, 0.05)
    if draw.draw_body_names && body.name_id != basics.NULL_NAME {
        name = basics.name_cache_find(&w.names, body.name_id)
        if name != null { label(math.transform_point(at_center, offset), native.name_text(name), debug_draw.COLOR_WHITE, draw.context) }
    }
    if draw.draw_mass {
        show_transform = draw.draw_transform
        show_transform(at_center, draw.context)
        if body.kind == dynamics.BODY_DYNAMIC { label(math.transform_point(at_center, offset), debug_draw.fixed(body.mass, 2), debug_draw.COLOR_WHITE, draw.context) }
    }
    if draw.draw_sleep && dynamics.get_body_state(w, body) != null {
        color = debug_draw.COLOR_BLACK
        if body.sleep_threshold > 0.0 {
            index = math.clamp_int((body.sleep_velocity / body.sleep_threshold) as int, 0, 3)
            if index == 0 { color = debug_draw.COLOR_BLUE }
            else if index == 1 { color = debug_draw.COLOR_SKY_BLUE }
            else if index == 2 { color = debug_draw.COLOR_ORANGE }
            else { color = debug_draw.COLOR_RED }
        }
        point(sim.center, 10.0, color, draw.context)
        label(math.add(sim.center, math.vec3(0.1, 0.1, 0.1)), "  ${debug_draw.fixed(body.sleep_velocity, 3)}", color, draw.context)
    }
    if draw.draw_joints {
        key = body.head_joint_key
        while key != NULL_INDEX {
            joint_index = key >> 1
            j = dynamics.joint_at(w, joint_index)
            if basics.bitset_get(&w.debug_joint_set, joint_index) == false {
                joint_solver.draw_joint(draw, w, j)
                basics.bitset_set(&w.debug_joint_set, joint_index)
            }
            key = dynamics.joint_edge_next(w, key)
        }
    }
    if draw.draw_contacts && body.kind == dynamics.BODY_DYNAMIC && body.set_index == dynamics.AWAKE_SET {
        key = body.head_contact_key
        while key != NULL_INDEX {
            contact_index = key >> 1
            c = dynamics.contact_at(w, contact_index)
            key = dynamics.contact_edge_next(w, key)
            if c.set_index == dynamics.AWAKE_SET && c.color_index != NULL_INDEX && basics.bitset_get(&w.debug_contact_set, contact_index) == false {
                draw_contact(w, draw, c, axis_scale)
                basics.bitset_set(&w.debug_contact_set, contact_index)
            }
        }
    }
    if draw.draw_islands && body.island_id != NULL_INDEX && basics.bitset_get(&w.debug_island_set, body.island_id) == false {
        island = dynamics.island_at(w, body.island_id)
        if island.set_index != NULL_INDEX {
            shapes = 0
            box = AABB { lower: math.vec3(math.HUGE, math.HUGE, math.HUGE), upper: math.vec3(0.0 - math.HUGE, 0.0 - math.HUGE, 0.0 - math.HUGE) }
            members = island.bodies.data as int[]
            b = 0
            while b < island.bodies.count {
                shape_id = dynamics.body_at(w, members[b]).head_shape_id
                while shape_id != NULL_INDEX {
                    box = math.aabb_union(box, math.aabb_widen(dynamics.shape_fat_aabb(w, shape_id)))
                    shapes = shapes + 1
                    shape_id = dynamics.world_shape_at(w, shape_id).next_shape_id
                }
                b = b + 1
            }
            if shapes > 0 {
                bounds = draw.draw_bounds
                bounds(box, debug_draw.COLOR_ORANGE_RED, draw.context)
            }
            basics.bitset_set(&w.debug_island_set, body.island_id)
        }
    }
}

// A contact's manifolds: each point at an anchor of A or of B, coloured
// by whether it was added, is speculative far or near, or persists (or by
// its graph colour), with its normal and separation, its force, or its
// feature, and the friction's anchor and force.
draw_contact(w: *World, draw: *DebugDraw, c: *Contact, axis_scale: float) {
    segment = draw.draw_segment
    point = draw.draw_point
    label = draw.draw_string
    sim_a = dynamics.get_body_sim(w, dynamics.body_at(w, c.edge_a.body_id))
    sim_b = dynamics.get_body_sim(w, dynamics.body_at(w, c.edge_b.body_id))
    // Hack inv_dt for single step debugging, as the reference does.
    inv_dt = w.inv_dt
    if inv_dt <= 0.0 { inv_dt = 60.0 }
    inv_tau = 1.0 / dynamics.SPECULATIVE_DISTANCE
    m = 0
    while m < c.manifold_count {
        manifold = dynamics.manifold_at(c, m)
        normal = math.widen3(manifold.normal)
        center = sim_b.center
        if draw.draw_anchor_a { center = sim_a.center }
        friction_anchor = math.vec3_zero()
        total_weight = 0.0
        k = 0
        while k < manifold.point_count {
            mp = dynamics.manifold_point_at(manifold, k)
            anchor = math.widen3(mp.anchor_b)
            if draw.draw_anchor_a { anchor = math.widen3(mp.anchor_a) }
            p = math.add(center, anchor)
            separation = mp.separation as float
            weight = math.clamp_float(2.0 - separation * inv_tau, contact_solver.MIN_FRICTION_WEIGHT, 1.0)
            friction_anchor = math.add(friction_anchor, math.mul_sv(weight, anchor))
            total_weight = total_weight + weight
            if draw.draw_contact_normals {
                segment(p, math.add(p, math.mul_sv(axis_scale, normal)), debug_draw.COLOR_LIGHT_GRAY, draw.context)
                label(p, "   ${debug_draw.fixed(100.0 * separation, 2)}", debug_draw.COLOR_WHITE, draw.context)
            } else if draw.draw_contact_forces {
                force = (mp.total_normal_impulse as float) * inv_dt
                tip = math.add(p, math.mul_sv(draw.force_scale * force, normal))
                segment(p, tip, debug_draw.COLOR_MAGENTA, draw.context)
                label(p, "  ${debug_draw.fixed(force, 1)}", debug_draw.COLOR_WHITE, draw.context)
            } else if draw.draw_contact_features {
                label(p, "   ${debug_draw.hex(mp.feature_id)}", debug_draw.COLOR_WHITE, draw.context)
            }
            if draw.draw_graph_colors {
                size = 10.0
                if c.color_index == dynamics.OVERFLOW_INDEX { size = 15.0 }
                point(p, size, debug_draw.graph_color(c.color_index), draw.context)
            } else if mp.persisted == false {
                point(p, 20.0, debug_draw.COLOR_LIME_GREEN, draw.context)
            } else if separation > dynamics.SPECULATIVE_DISTANCE {
                point(p, 10.0, debug_draw.COLOR_DARK_BLUE, draw.context)
            } else if separation > 0.0 {
                point(p, 10.0, debug_draw.COLOR_BLUE, draw.context)
            } else {
                point(p, 10.0, debug_draw.COLOR_LIGHT_BLUE, draw.context)
            }
            k = k + 1
        }
        if draw.draw_contact_forces && total_weight > 0.0 {
            p1 = math.add(center, math.mul_sv(1.0 / total_weight, friction_anchor))
            friction_force = math.mul_sv(0.5 * inv_dt, math.widen3(manifold.friction_impulse))
            segment(p1, math.add(p1, math.mul_sv(draw.force_scale, friction_force)), debug_draw.COLOR_YELLOW, draw.context)
            point(p1, 5.0, debug_draw.COLOR_YELLOW, draw.context)
            label(math.add(p1, math.mul_sv(0.05, normal)), debug_draw.fixed(math.length(friction_force), 2), debug_draw.COLOR_WHITE, draw.context)
        }
        m = m + 1
    }
}

// --- the body queries ------------------------------------------------------------------------------------------------

no_body_hit() -> BodyCastResult {
    return BodyCastResult { shape_id: dynamics.null_shape_id(), point: math.vec3_zero(), normal: math.vec3_zero(), fraction: 0.0,
                            triangle_index: 0, user_material_id: 0 as long, iterations: 0, hit: false }
}

body_world(id: BodyId) -> *World {
    if dynamics.body_is_valid(id) == false { return null }
    w = dynamics.get_world(id.world0)
    if w.locked { return null }
    return w
}

// A ray against one body's shapes at a transform of the caller's (the
// body's stored pose is not used), centred on the ray's origin.
body_cast_ray(id: BodyId, origin: Vec3, translation: Vec3, filter: QueryFilter, max_fraction: float, body_transform: Transform) -> BodyCastResult {
    result = no_body_hit()
    w = body_world(id)
    if w == null { return result }
    if math.is_valid_position(origin) == false || math.is_valid_vec3(translation) == false || math.is_valid_float(max_fraction) == false || math.is_valid_world_transform(body_transform) == false { return result }
    body = dynamics.get_body_full_id(w, id)
    t = Transform { p: math.sub(body_transform.p, origin), q: body_transform.q }
    fraction_left = max_fraction
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = dynamics.world_shape_at(w, shape_id)
        shape_id = s.next_shape_id
        if shape.should_query_collide(s.filter, filter) == false { continue }
        output = shape.ray_cast_shape(&s.geometry, t, math.vec3_zero(), translation, fraction_left)
        if output.hit == false || output.fraction > fraction_left { continue }
        result = BodyCastResult { shape_id: dynamics.make_shape_id(w, s), point: math.add(origin, output.point), normal: output.normal,
                                  fraction: output.fraction, triangle_index: output.triangle_index,
                                  user_material_id: material_user_id(s, output.material_index), iterations: output.iterations, hit: true }
        fraction_left = output.fraction
    }
    return result
}

// A ray against one shape (b3Shape_RayCast), re-centred on the origin
// so the cast runs close to it however far the world's origin is; the
// hit point lifted back.
shape_ray_cast(id: ShapeId, origin: Vec3, translation: Vec3) -> CastOutput {
    if math.is_valid_position(origin) == false || math.is_valid_vec3(translation) == false { return distance.empty_cast_output() }
    w = dynamics.get_world(id.world0)
    s = dynamics.get_shape_full_id(w, id)
    body_transform = dynamics.get_body_transform(w, s.body_id)
    t = Transform { p: math.sub(body_transform.p, origin), q: body_transform.q }
    output = shape.ray_cast_shape(&s.geometry, t, math.vec3_zero(), translation, 1.0)
    output.point = math.add(origin, output.point)
    return output
}

body_cast_shape(id: BodyId, origin: Vec3, proxy: ShapeProxy, translation: Vec3, filter: QueryFilter, max_fraction: float, can_encroach: bool, body_transform: Transform) -> BodyCastResult {
    result = no_body_hit()
    w = body_world(id)
    if w == null { return result }
    if math.is_valid_position(origin) == false || math.is_valid_vec3(translation) == false || math.is_valid_float(max_fraction) == false || math.is_valid_world_transform(body_transform) == false { return result }
    body = dynamics.get_body_full_id(w, id)
    t = Transform { p: math.sub(body_transform.p, origin), q: body_transform.q }
    fraction_left = max_fraction
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = dynamics.world_shape_at(w, shape_id)
        shape_id = s.next_shape_id
        if shape.should_query_collide(s.filter, filter) == false { continue }
        output = shape.shape_cast_shape(&s.geometry, t, proxy, translation, fraction_left, can_encroach)
        if output.hit == false || output.fraction > fraction_left { continue }
        result = BodyCastResult { shape_id: dynamics.make_shape_id(w, s), point: math.add(origin, output.point), normal: output.normal,
                                  fraction: output.fraction, triangle_index: output.triangle_index,
                                  user_material_id: material_user_id(s, output.material_index), iterations: output.iterations, hit: true }
        fraction_left = output.fraction
    }
    return result
}

body_overlap_shape(id: BodyId, origin: Vec3, proxy: ShapeProxy, filter: QueryFilter, body_transform: Transform) -> bool {
    w = body_world(id)
    if w == null { return false }
    if math.is_valid_position(origin) == false || math.is_valid_world_transform(body_transform) == false { return false }
    body = dynamics.get_body_full_id(w, id)
    t = Transform { p: math.sub(body_transform.p, origin), q: body_transform.q }
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = dynamics.world_shape_at(w, shape_id)
        shape_id = s.next_shape_id
        if shape.should_query_collide(s.filter, filter) == false { continue }
        if shape.overlap_shape(&s.geometry, t, proxy) { return true }
    }
    return false
}

// The mover's planes against one body's convex shapes (one plane each), up to the capacity.
body_collide_mover(id: BodyId, planes: BodyPlaneResult[], capacity: int, origin: Vec3, mover: Capsule, filter: QueryFilter, body_transform: Transform) -> int {
    w = body_world(id)
    if w == null || capacity == 0 { return 0 }
    if math.is_valid_position(origin) == false || valid_capsule(mover) == false || math.is_valid_world_transform(body_transform) == false { return 0 }
    body = dynamics.get_body_full_id(w, id)
    t = Transform { p: math.sub(body_transform.p, origin), q: body_transform.q }
    count = 0
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = dynamics.world_shape_at(w, shape_id)
        shape_id = s.next_shape_id
        if shape.should_query_collide(s.filter, filter) == false { continue }
        if shape.is_convex(s.geometry.kind) == false { continue }
        // Straight into the caller's result, no shared scratch to overwrite.
        if shape.collide_mover((&planes[count].result) as ptr as PlaneResult[], 1, &s.geometry, t, mover) > 0 {
            planes[count].shape_id = dynamics.make_shape_id(w, s)
            count = count + 1
            if count == capacity { return count }
        }
    }
    return count
}

// The mover's time of impact against one body moving from one transform
// to another (the body's stored pose is not used); shapes already
// overlapped are ignored, as the continuous pass ignores them.
body_time_of_impact_mover(id: BodyId, origin: Vec3, mover: Capsule, mover_translation: Vec3, filter: QueryFilter, transform1: Transform, transform2: Transform) -> BodyTOIResult {
    result = BodyTOIResult { point: math.vec3_zero(), normal: math.vec3_zero(), fraction: 1.0, shape_id: dynamics.null_shape_id() }
    w = body_world(id)
    if w == null { return result }
    if math.is_valid_position(origin) == false || valid_capsule(mover) == false || math.is_valid_vec3(mover_translation) == false || math.is_valid_world_transform(transform1) == false || math.is_valid_world_transform(transform2) == false { return result }
    if g_mover_points == null { g_mover_points = basics.alloc(native.MAX_WORKERS * (2 * sizeof(Vec3))) }
    points = mover_points() as Vec3[]
    points[0] = mover.center1
    points[1] = mover.center2
    xf1 = Transform { p: math.sub(transform1.p, origin), q: transform1.q }
    xf2 = Transform { p: math.sub(transform2.p, origin), q: transform2.q }
    body = dynamics.get_body_full_id(w, id)
    local_center = math.widen3(dynamics.get_body_sim(w, body).local_center)
    input = TOIInput { proxy_a: distance.shape_proxy(null, 0, 0.0), proxy_b: distance.shape_proxy(mover_points(), 2, mover.radius),
                       sweep_a: Sweep { local_center: local_center, c1: math.transform_point(xf1, local_center), c2: math.transform_point(xf2, local_center), q1: transform1.q, q2: transform2.q },
                       sweep_b: Sweep { local_center: math.vec3_zero(), c1: math.vec3_zero(), c2: mover_translation, q1: math.quat_identity(), q2: math.quat_identity() },
                       max_fraction: 1.0 }
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = dynamics.world_shape_at(w, shape_id)
        shape_id = s.next_shape_id
        if shape.should_query_collide(s.filter, filter) == false { continue }
        if shape.is_convex(s.geometry.kind) == false { continue }
        input.proxy_a = shape.make_shape_proxy(&s.geometry)
        output = distance.time_of_impact(&input)
        if 0.0 < output.fraction && output.fraction < result.fraction {
            input.max_fraction = output.fraction
            result.point = math.add(origin, output.point)
            result.normal = output.normal
            result.fraction = output.fraction
            result.shape_id = dynamics.make_shape_id(w, s)
        }
    }
    return result
}

// --- explosions ------------------------------------------------------------------------------------------------------

// An explosion def into a recording, field by field.
rec_explosion_def(r: *Recording, v: *ExplosionDef) {
    dynamics.rec_long(r, v.mask_bits)
    dynamics.rec_vec3(r, v.position)
    dynamics.rec_float(r, v.radius)
    dynamics.rec_float(r, v.falloff)
    dynamics.rec_float(r, v.impulse_per_area)
}

default_explosion_def() -> ExplosionDef {
    return ExplosionDef { mask_bits: dynamic_tree.default_mask_bits(), position: math.vec3_zero(), radius: 0.0, falloff: 0.0, impulse_per_area: 0.0 }
}

struct WorldExplosionContext {
    w: *World
    position: Vec3
    radius: float
    falloff: float
    impulse_per_area: float
    local_position: Vec3
}

// An impulse on a dynamic shape within reach: along the direction from
// the explosion to its closest point (its centroid when inside), by the
// area it presents, fading over the falloff, scaled by the shape's own factor.
explosion_visitor(proxy_id: int, user_data: long, context: ptr) -> bool {
    ec = context as *WorldExplosionContext
    w = ec.w
    s = dynamics.world_shape_at(w, user_data as int)
    if s.explosion_scale == 0.0 { return true }
    body = dynamics.body_at(w, s.body_id)
    xf = dynamics.get_body_transform(w, s.body_id)
    ec.local_position = math.inv_transform_point(xf, ec.position)
    input = DistanceInput { proxy_a: shape.make_shape_proxy(&s.geometry), proxy_b: distance.shape_proxy((&ec.local_position) as ptr, 1, 0.0),
                            transform: math.transform_identity(), use_radii: true }
    cache = distance.empty_cache()
    output = distance.shape_distance(&input, &cache, null, 0)
    if output.distance > ec.radius + ec.falloff { return true }
    dynamics.wake_body(w, body)
    if body.set_index != dynamics.AWAKE_SET { return true }
    closest = output.point_a
    if output.distance == 0.0 { closest = shape.get_shape_centroid(&s.geometry) }
    direction = math.sub(closest, ec.local_position)
    if math.length_squared(direction) > 100.0 * math.EPSILON * math.EPSILON { direction = math.normalize(direction) } else { direction = math.vec3_axis_x() }
    area = shape.get_shape_projected_area(&s.geometry, direction)
    scale = 1.0
    if output.distance > ec.radius && ec.falloff > 0.0 { scale = math.clamp_float((ec.radius + ec.falloff - output.distance) / ec.falloff, 0.0, 1.0) }
    magnitude = ec.impulse_per_area * area * scale * s.explosion_scale
    impulse = math.mul_sv(magnitude, math.rotate_vector(xf.q, direction))
    set = dynamics.get_solver_set(w, dynamics.AWAKE_SET)
    state = dynamics.body_state_at(set, body.local_index)
    sim = dynamics.body_sim_at(set, body.local_index)
    state.v = math.narrow3(math.mul_add(math.widen3(state.v), sim.inv_mass, impulse))
    r = math.rotate_vector(xf.q, math.sub(closest, math.widen3(sim.local_center)))
    state.w = math.narrow3(math.add(math.widen3(state.w), math.mul_mv(math.widen_mat3(sim.inv_inertia_world), math.cross(r, impulse))))
    return true
}

explode(id: WorldId, def: *ExplosionDef) {
    if dynamics.recording_on(id.index1 - 1) { recorder = dynamics.rec_begin(id.index1 - 1, dynamics.OP_EXPLODE); rec_explosion_def(recorder, def); dynamics.rec_end(recorder) }
    if math.is_valid_position(def.position) == false || nonnegative(def.radius) == false || nonnegative(def.falloff) == false || math.is_valid_float(def.impulse_per_area) == false { return }
    w = world_of(id)
    if w == null { return }
    w.locked = true
    ec = WorldExplosionContext { w: w, position: def.position, radius: def.radius, falloff: def.falloff, impulse_per_area: def.impulse_per_area, local_position: math.vec3_zero() }
    extent = def.radius + def.falloff
    box = math.offset_aabb(AABB { lower: math.vec3(0.0 - extent, 0.0 - extent, 0.0 - extent), upper: math.vec3(extent, extent, extent) }, def.position)
    dynamic_tree.tree_query(broad_phase.broad_phase_tree(&w.broad_phase, dynamics.BODY_DYNAMIC), box, def.mask_bits, false, explosion_visitor, (&ec) as ptr)
    w.locked = false
}
