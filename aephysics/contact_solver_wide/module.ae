// aephysics.contact_solver_wide -- the convex contacts of a graph
// colour solved four at a time: the constraints of four contacts laid
// side by side, one lane each (a structure of arrays: every scalar of
// the constraint is four floats), so the prepare, warm start, solve,
// restitution and store run the same instruction on four contacts at
// once. The bodies' states are gathered into lanes before a constraint
// and the velocities scattered back after; a colour's contacts share
// no body, so the lanes never alias. A static body is lane zero of the
// identity state; a colour's tail slot has its spare lanes zeroed, so
// they compute nothing that reaches a body.
//
// This is Box3D's wide contact path (contact_solver.c, Erin Catto,
// MIT): b3PrepareContacts_Convex is prepare_wide_contacts,
// b3SolveContacts_Convex is solve_wide_contacts, and the lane types
// (b3FloatW, b3Vec3W, b3ContactConstraintWide) are f32x4, Vec3W and
// WideConstraint. A lane here is the language's `f32x4` (std.lanes,
// Aether 0.706) -- four floats in a register, which is what the
// reference's SSE2 and NEON lanes are -- where it used to be four
// doubles in a record, left to the C compiler to vectorise. The mesh and
// overflow contacts stay with aephysics.contact_solver.
import std.lanes
import std.string
import aephysics.math
import aephysics.native
import aephysics.basics
import aephysics.dynamics
import aephysics.contact_solver

exports (
    WIDTH, Vec3W, IntW, WideConstraintPoint, WideConstraint,
    wide_constraint_at, wide_constraint_count, wide_point_at, lane, int_lane,
    prepare_wide_contacts, prepare_wide_range, zero_wide_tail, warm_start_wide_contacts, solve_wide_contacts, apply_wide_restitution, store_wide_impulses, store_wide_range
)

const WIDTH = 4
const NULL_INDEX = 0 - 1

// --- lanes ---------------------------------------------------------------------------------------------------

// A lane of four is `f32x4`, the language's (std.lanes, Aether 0.706):
// four single-precision lanes in one register, where this module used to
// carry four doubles in a record and leave the vectorising to the C
// compiler. Single precision is what the reference computes a contact in
// and what the native file's lanes already computed; the constraint is
// the same record in both, so there is one arithmetic here, not two.
struct Vec2W {
    x: f32x4
    y: f32x4
}

struct Vec3W {
    x: f32x4
    y: f32x4
    z: f32x4
}

struct QuatW {
    v: Vec3W
    s: f32x4
}

// Symmetric matrices: the upper triangles.
struct SymMatrix2W {
    cxx: f32x4
    cxy: f32x4
    cyy: f32x4
}

struct SymMatrix3W {
    cxx: f32x4
    cxy: f32x4
    cxz: f32x4
    cyy: f32x4
    cyz: f32x4
    czz: f32x4
}

// Four ints and four pointers, one per contact.
struct IntW {
    x: int
    y: int
    z: int
    w: int
}

struct PtrW {
    x: ptr
    y: ptr
    z: ptr
    w: ptr
}

// A lane of a wide value, read by index: the store works a contact at
// a time, where the stages before it work four.
lane(f: f32x4, index: int) -> float { return (lanes.lane4(f, index as long)) as float }

int_lane(v: *IntW, index: int) -> int {
    lanes = (v as ptr) as int[]
    return lanes[index]
}

ptr_lane(v: *PtrW, index: int) -> ptr {
    lanes = (v as ptr) as ptr[]
    return lanes[index]
}

zero_w() -> f32x4 { return lanes.splat4(0.0) }
splat_w(s: float) -> f32x4 { return lanes.splat4(s as f32) }
neg_w(a: f32x4) -> f32x4 { return lanes.splat4(0.0) - a }
add_w(a: f32x4, b: f32x4) -> f32x4 { return a + b }
sub_w(a: f32x4, b: f32x4) -> f32x4 { return a - b }
mul_w(a: f32x4, b: f32x4) -> f32x4 { return a * b }
div_w(a: f32x4, b: f32x4) -> f32x4 { return a / b }
// One instruction, and exact: an IEEE square root is correctly rounded,
// so it is the four scalar roots (std.lanes.sqrt4, aether#2158).
sqrt_w(a: f32x4) -> f32x4 { return lanes.sqrt4(a) }
// a + b * c, as two operations: a fused multiply-add would differ from the scalar path.
mul_add_w(a: f32x4, b: f32x4, c: f32x4) -> f32x4 { return a + b * c }
min_w(a: f32x4, b: f32x4) -> f32x4 { return lanes.min4(a, b) }
max_w(a: f32x4, b: f32x4) -> f32x4 { return lanes.max4(a, b) }
// a clamped to [-b, b].
sym_clamp_w(a: f32x4, b: f32x4) -> f32x4 { return max_w(neg_w(b), min_w(a, b)) }
// A mask is the lanes a comparison sets, and blend picks by it.
or_w(a: i32x4, b: i32x4) -> i32x4 { return lanes.mask_or(a, b) }
greater_w(a: f32x4, b: f32x4) -> i32x4 { return lanes.gt4(a, b) }
equals_w(a: f32x4, b: f32x4) -> i32x4 { return lanes.eq4(a, b) }
all_zero_w(a: f32x4) -> bool { return lanes.all4(lanes.eq4(a, lanes.splat4(0.0))) }
// Per lane: b where the mask is set, a elsewhere.
blend_w(a: f32x4, b: f32x4, m: i32x4) -> f32x4 { return lanes.select4(m, b, a) }

mul_sv_w(s: f32x4, a: Vec3W) -> Vec3W { return Vec3W { x: mul_w(s, a.x), y: mul_w(s, a.y), z: mul_w(s, a.z) } }
// a - s * b and a + s * b.
mul_sub_sv_w(a: Vec3W, s: f32x4, b: Vec3W) -> Vec3W {
    return Vec3W { x: sub_w(a.x, mul_w(s, b.x)), y: sub_w(a.y, mul_w(s, b.y)), z: sub_w(a.z, mul_w(s, b.z)) }
}
mul_add_sv_w(a: Vec3W, s: f32x4, b: Vec3W) -> Vec3W {
    return Vec3W { x: add_w(a.x, mul_w(s, b.x)), y: add_w(a.y, mul_w(s, b.y)), z: add_w(a.z, mul_w(s, b.z)) }
}
add_v2_w(a: Vec2W, b: Vec2W) -> Vec2W { return Vec2W { x: add_w(a.x, b.x), y: add_w(a.y, b.y) } }
sub_v_w(a: Vec3W, b: Vec3W) -> Vec3W { return Vec3W { x: sub_w(a.x, b.x), y: sub_w(a.y, b.y), z: sub_w(a.z, b.z) } }
add_v_w(a: Vec3W, b: Vec3W) -> Vec3W { return Vec3W { x: add_w(a.x, b.x), y: add_w(a.y, b.y), z: add_w(a.z, b.z) } }
mul_mv2_w(m: SymMatrix2W, a: Vec2W) -> Vec2W {
    return Vec2W { x: add_w(mul_w(m.cxx, a.x), mul_w(m.cxy, a.y)), y: add_w(mul_w(m.cxy, a.x), mul_w(m.cyy, a.y)) }
}
mul_mv_w(m: SymMatrix3W, a: Vec3W) -> Vec3W {
    return Vec3W { x: add_w(mul_w(m.cxx, a.x), add_w(mul_w(m.cxy, a.y), mul_w(m.cxz, a.z))),
                   y: add_w(mul_w(m.cxy, a.x), add_w(mul_w(m.cyy, a.y), mul_w(m.cyz, a.z))),
                   z: add_w(mul_w(m.cxz, a.x), add_w(mul_w(m.cyz, a.y), mul_w(m.czz, a.z))) }
}
// a - m * b and a + m * b.
mul_sub_mv_w(a: Vec3W, m: SymMatrix3W, b: Vec3W) -> Vec3W { return sub_v_w(a, mul_mv_w(m, b)) }
mul_add_mv_w(a: Vec3W, m: SymMatrix3W, b: Vec3W) -> Vec3W { return add_v_w(a, mul_mv_w(m, b)) }
dot_w(a: Vec3W, b: Vec3W) -> f32x4 { return add_w(add_w(mul_w(a.x, b.x), mul_w(a.y, b.y)), mul_w(a.z, b.z)) }
cross_w(a: Vec3W, b: Vec3W) -> Vec3W {
    return Vec3W { x: sub_w(mul_w(a.y, b.z), mul_w(a.z, b.y)),
                   y: sub_w(mul_w(a.z, b.x), mul_w(a.x, b.z)),
                   z: sub_w(mul_w(a.x, b.y), mul_w(a.y, b.x)) }
}
// v + 2 (q.v x (q.v x v + q.s v)), the reference's rotation (math.rotate_vector's form).
rotate_vector_w(q: QuatW, a: Vec3W) -> Vec3W {
    t1 = cross_w(q.v, a)
    t2 = Vec3W { x: mul_add_w(t1.x, q.s, a.x), y: mul_add_w(t1.y, q.s, a.y), z: mul_add_w(t1.z, q.s, a.z) }
    t3 = cross_w(q.v, t2)
    two = splat_w(2.0)
    return Vec3W { x: mul_add_w(a.x, two, t3.x), y: mul_add_w(a.y, two, t3.y), z: mul_add_w(a.z, two, t3.z) }
}

// --- the constraint ------------------------------------------------------------------------------------------

// One manifold point of four contacts (b3ContactConstraintPointWide).
struct WideConstraintPoint {
    anchor_a: Vec3W
    anchor_b: Vec3W
    base_separation: f32x4
    normal_impulse: f32x4
    total_normal_impulse: f32x4
    normal_mass: f32x4
    lever_arm: f32x4
    relative_velocity: f32x4
}

// Four convex contacts' constraints (b3ContactConstraintWide): the body
// indices base 1 (0 for a static body), the point counts, and every
// scalar of the constraint by lane.
struct WideConstraint {
    index_a: IntW
    index_b: IntW
    point_counts: IntW
    inv_mass_a: f32x4
    inv_mass_b: f32x4
    inv_inertia_a: SymMatrix3W
    inv_inertia_b: SymMatrix3W
    normal: Vec3W
    tangent1: Vec3W
    tangent2: Vec3W
    center_a: Vec3W                // the friction centres
    center_b: Vec3W
    twist_mass: f32x4
    twist_impulse: f32x4
    tangent_mass: SymMatrix2W
    friction_impulse: Vec2W
    rolling_mass: SymMatrix3W
    rolling_impulse: Vec3W
    friction: f32x4
    rolling_resistance: f32x4
    tangent_velocity1: f32x4
    tangent_velocity2: f32x4
    bias_rate: f32x4
    mass_scale: f32x4
    impulse_scale: f32x4
    restitution: f32x4
    manifolds: PtrW                // *Manifold per lane, null in a spare lane
    hit_lanes: int                 // bit l: lane l's contact wants hit events
    point0: WideConstraintPoint
    point1: WideConstraintPoint
    point2: WideConstraintPoint
    point3: WideConstraintPoint
}

wide_constraint_at(base: ptr, index: int) -> *WideConstraint { return (base + index * sizeof(WideConstraint)) as *WideConstraint }
wide_point_at(c: *WideConstraint, index: int) -> *WideConstraintPoint {
    return ((&c.point0) as ptr + index * sizeof(WideConstraintPoint)) as *WideConstraintPoint
}

// The wide constraints a colour's convex contacts fill: four to a slot.
wide_constraint_count(convex_contact_count: int) -> int {
    if convex_contact_count == 0 { return 0 }
    return ((convex_contact_count - 1) / WIDTH) + 1
}

// The most points any lane has: the loops run over that many, the
// spare lanes' zeroed masses and anchors keeping them inert.
max_point_count(c: *WideConstraint) -> int {
    return math.max_int(math.max_int(c.point_counts.x, c.point_counts.y), math.max_int(c.point_counts.z, c.point_counts.w))
}

// --- gather and scatter --------------------------------------------------------------------------------------

// Four bodies' states in lanes (b3BodyStateW).
struct BodyStateW {
    v: Vec3W
    w: Vec3W
    dp: Vec3W
    dq: QuatW
}

state_or_identity(states: ptr, index1: int) -> *BodyState {
    if index1 == 0 { return contact_solver.dummy_state() }
    return (states + (index1 - 1) * sizeof(BodyState)) as *BodyState
}

gather_bodies(states: ptr, indices: *IntW) -> BodyStateW {
    s0 = state_or_identity(states, indices.x)
    s1 = state_or_identity(states, indices.y)
    s2 = state_or_identity(states, indices.z)
    s3 = state_or_identity(states, indices.w)
    v = Vec3W { x: lanes.f32x4(s0.linear_velocity.x as f32, s1.linear_velocity.x as f32, s2.linear_velocity.x as f32, s3.linear_velocity.x as f32),
                y: lanes.f32x4(s0.linear_velocity.y as f32, s1.linear_velocity.y as f32, s2.linear_velocity.y as f32, s3.linear_velocity.y as f32),
                z: lanes.f32x4(s0.linear_velocity.z as f32, s1.linear_velocity.z as f32, s2.linear_velocity.z as f32, s3.linear_velocity.z as f32) }
    w = Vec3W { x: lanes.f32x4(s0.angular_velocity.x as f32, s1.angular_velocity.x as f32, s2.angular_velocity.x as f32, s3.angular_velocity.x as f32),
                y: lanes.f32x4(s0.angular_velocity.y as f32, s1.angular_velocity.y as f32, s2.angular_velocity.y as f32, s3.angular_velocity.y as f32),
                z: lanes.f32x4(s0.angular_velocity.z as f32, s1.angular_velocity.z as f32, s2.angular_velocity.z as f32, s3.angular_velocity.z as f32) }
    dp = Vec3W { x: lanes.f32x4(s0.delta_position.x as f32, s1.delta_position.x as f32, s2.delta_position.x as f32, s3.delta_position.x as f32),
                 y: lanes.f32x4(s0.delta_position.y as f32, s1.delta_position.y as f32, s2.delta_position.y as f32, s3.delta_position.y as f32),
                 z: lanes.f32x4(s0.delta_position.z as f32, s1.delta_position.z as f32, s2.delta_position.z as f32, s3.delta_position.z as f32) }
    dqv = Vec3W { x: lanes.f32x4(s0.delta_rotation.x as f32, s1.delta_rotation.x as f32, s2.delta_rotation.x as f32, s3.delta_rotation.x as f32),
                  y: lanes.f32x4(s0.delta_rotation.y as f32, s1.delta_rotation.y as f32, s2.delta_rotation.y as f32, s3.delta_rotation.y as f32),
                  z: lanes.f32x4(s0.delta_rotation.z as f32, s1.delta_rotation.z as f32, s2.delta_rotation.z as f32, s3.delta_rotation.z as f32) }
    dqs = lanes.f32x4(s0.delta_rotation.w as f32, s1.delta_rotation.w as f32, s2.delta_rotation.w as f32, s3.delta_rotation.w as f32)
    return BodyStateW { v: v, w: w, dp: dp, dq: QuatW { v: dqv, s: dqs } }
}

// The velocities back to the dynamic bodies of the lanes.
scatter_lane(states: ptr, index1: int, body: *BodyStateW, l: int) {
    if index1 == 0 { return }
    state = (states + (index1 - 1) * sizeof(BodyState)) as *BodyState
    if (state.flags & dynamics.DYNAMIC_FLAG) == 0 { return }
    state.linear_velocity = math.vec3(lane(body.v.x, l), lane(body.v.y, l), lane(body.v.z, l))
    state.angular_velocity = math.vec3(lane(body.w.x, l), lane(body.w.y, l), lane(body.w.z, l))
}

scatter_bodies(states: ptr, indices: *IntW, body: *BodyStateW) {
    scatter_lane(states, indices.x, body, 0)
    scatter_lane(states, indices.y, body, 1)
    scatter_lane(states, indices.z, body, 2)
    scatter_lane(states, indices.w, body, 3)
}

// --- the stages ----------------------------------------------------------------------------------------------

// A zeroed block the size of the largest of a contact, a manifold and a
// body record: what a spare lane and a static body gather from, so the
// prepare reads four lanes without a branch per field (the reference's
// b3_zeroContact, b3_zeroManifold and b3_zeroBodySim). Made before any
// worker runs (zero_wide_tail), never written and never freed: a static,
// so it is outside the counted allocator.
extern calloc(count: int, size: int) -> ptr
var g_zero_record: ptr = null

zero_record() -> ptr {
    if g_zero_record == null {
        g_zero_record = calloc(1, math.max_int(math.max_int(sizeof(Contact), sizeof(Manifold)), sizeof(BodySim)))
    }
    return g_zero_record
}

f4(a: float, b: float, c: float, d: float) -> f32x4 { return lanes.f32x4(a as f32, b as f32, c as f32, d as f32) }

// The contact of a lane: index `index` of the colour's convex contacts, or
// the zero record for a spare lane past `end`.
lane_contact(ctx: *StepContext, color: *GraphColor, index: int, end: int) -> *Contact {
    if index >= end { return zero_record() as *Contact }
    return dynamics.contact_at(ctx.world, basics.ints_get(&color.convex_contacts, index))
}

// A lane's manifold, null for a spare lane.
lane_manifold(c: *Contact) -> *Manifold {
    if (c as ptr) == zero_record() { return null }
    return dynamics.manifold_at(c, 0)
}

// The manifold a lane gathers from: its own, or the zero record.
gather_manifold(m: *Manifold) -> *Manifold {
    if m == null { return zero_record() as *Manifold }
    return m
}

// A lane's body index base 1, 0 for a static body or a spare lane.
lane_index1(c: *Contact, index: int) -> int {
    if (c as ptr) == zero_record() { return 0 }
    return index + 1
}

// Lane l's bit when its contact wants hit events (a spare lane's flags are zero).
hit_bit(c: *Contact, l: int) -> int {
    if (c.flags & dynamics.SIM_ENABLE_HIT_EVENT) != 0 { return 1 << l }
    return 0
}

lane_sim(ctx: *StepContext, index1: int) -> *BodySim {
    if index1 == 0 { return zero_record() as *BodySim }
    return contact_solver.sim_at(ctx.sims, index1 - 1)
}

lane_softness(ctx: *StepContext, index_a1: int, index_b1: int) -> Softness {
    if index_a1 == 0 || index_b1 == 0 { return ctx.static_softness }
    return ctx.contact_softness
}

// Four bodies' inverse world inertias, the upper triangles.
gather_inertia(s0: *BodySim, s1: *BodySim, s2: *BodySim, s3: *BodySim) -> SymMatrix3W {
    return SymMatrix3W {
        cxx: f4(s0.inv_inertia_world.cx.x, s1.inv_inertia_world.cx.x, s2.inv_inertia_world.cx.x, s3.inv_inertia_world.cx.x),
        cxy: f4(s0.inv_inertia_world.cx.y, s1.inv_inertia_world.cx.y, s2.inv_inertia_world.cx.y, s3.inv_inertia_world.cx.y),
        cxz: f4(s0.inv_inertia_world.cx.z, s1.inv_inertia_world.cx.z, s2.inv_inertia_world.cx.z, s3.inv_inertia_world.cx.z),
        cyy: f4(s0.inv_inertia_world.cy.y, s1.inv_inertia_world.cy.y, s2.inv_inertia_world.cy.y, s3.inv_inertia_world.cy.y),
        cyz: f4(s0.inv_inertia_world.cy.z, s1.inv_inertia_world.cy.z, s2.inv_inertia_world.cy.z, s3.inv_inertia_world.cy.z),
        czz: f4(s0.inv_inertia_world.cz.z, s1.inv_inertia_world.cz.z, s2.inv_inertia_world.cz.z, s3.inv_inertia_world.cz.z)
    }
}

gather_vec3(a: Vec3, b: Vec3, c: Vec3, d: Vec3) -> Vec3W {
    return Vec3W { x: f4(a.x, b.x, c.x, d.x), y: f4(a.y, b.y, c.y, d.y), z: f4(a.z, b.z, c.z, d.z) }
}

add_sym_w(a: SymMatrix3W, b: SymMatrix3W) -> SymMatrix3W {
    return SymMatrix3W { cxx: add_w(a.cxx, b.cxx), cxy: add_w(a.cxy, b.cxy), cxz: add_w(a.cxz, b.cxz),
                         cyy: add_w(a.cyy, b.cyy), cyz: add_w(a.cyz, b.cyz), czz: add_w(a.czz, b.czz) }
}

// The inverse of a symmetric matrix by its cofactors, zero where singular (b3InvertSymW).
invert_sym_w(m: SymMatrix3W) -> SymMatrix3W {
    cxx = sub_w(mul_w(m.cyy, m.czz), mul_w(m.cyz, m.cyz))
    cxy = sub_w(mul_w(m.cxz, m.cyz), mul_w(m.cxy, m.czz))
    cxz = sub_w(mul_w(m.cxy, m.cyz), mul_w(m.cxz, m.cyy))
    cyy = sub_w(mul_w(m.cxx, m.czz), mul_w(m.cxz, m.cxz))
    cyz = sub_w(mul_w(m.cxy, m.cxz), mul_w(m.cxx, m.cyz))
    czz = sub_w(mul_w(m.cxx, m.cyy), mul_w(m.cxy, m.cxy))
    det = add_w(mul_w(m.cxx, cxx), add_w(mul_w(m.cxy, cxy), mul_w(m.cxz, cxz)))
    valid = greater_w(lanes.abs4(det), splat_w(1000.0 * math.TINY_F32))
    inv_det = blend_w(zero_w(), div_w(splat_w(1.0), det), valid)
    return SymMatrix3W { cxx: mul_w(inv_det, cxx), cxy: mul_w(inv_det, cxy), cxz: mul_w(inv_det, cxz),
                         cyy: mul_w(inv_det, cyy), cyz: mul_w(inv_det, cyz), czz: mul_w(inv_det, czz) }
}

// A unit vector perpendicular to each lane's, math.perp's choice per
// lane; zero for a zero lane (b3PerpW).
perp_w(a: Vec3W) -> Vec3W {
    zero = zero_w()
    half = splat_w(0.5)
    mask = or_w(greater_w(neg_w(half), a.x), greater_w(a.x, half))
    p = Vec3W { x: blend_w(zero, a.y, mask), y: blend_w(a.z, neg_w(a.x), mask), z: blend_w(neg_w(a.y), zero, mask) }
    length_squared = dot_w(p, p)
    valid = greater_w(length_squared, splat_w(1000.0 * math.TINY_F32))
    s = blend_w(zero, div_w(splat_w(1.0), lanes.sqrt4(length_squared)), valid)
    return mul_sv_w(s, p)
}

// One manifold point of the four lanes' manifolds.
gather_point(m0: *Manifold, m1: *Manifold, m2: *Manifold, m3: *Manifold, index: int) -> WideConstraintPoint {
    p0 = dynamics.manifold_point_at(m0, index)
    p1 = dynamics.manifold_point_at(m1, index)
    p2 = dynamics.manifold_point_at(m2, index)
    p3 = dynamics.manifold_point_at(m3, index)
    zero = zero_w()
    return WideConstraintPoint {
        anchor_a: gather_vec3(p0.anchor_a, p1.anchor_a, p2.anchor_a, p3.anchor_a),
        anchor_b: gather_vec3(p0.anchor_b, p1.anchor_b, p2.anchor_b, p3.anchor_b),
        base_separation: f4(p0.separation, p1.separation, p2.separation, p3.separation),
        normal_impulse: f4(p0.normal_impulse, p1.normal_impulse, p2.normal_impulse, p3.normal_impulse),
        total_normal_impulse: zero, normal_mass: zero, lever_arm: zero, relative_velocity: zero
    }
}

blend_vec3_w(a: Vec3W, b: Vec3W, m: i32x4) -> Vec3W {
    return Vec3W { x: blend_w(a.x, b.x, m), y: blend_w(a.y, b.y, m), z: blend_w(a.z, b.z, m) }
}

// One slot's four convex contacts gathered into lanes and prepared four
// at a time (b3PrepareContacts_Convex): the contacts at `slot * WIDTH`
// on, a lane past `end` spare and zero throughout.
prepare_wide_slot(ctx: *StepContext, color: *GraphColor, slot: int, end: int) {
    c = wide_constraint_at(color.wide_constraints, slot)
    first = slot * WIDTH
    k0 = lane_contact(ctx, color, first, end)
    k1 = lane_contact(ctx, color, first + 1, end)
    k2 = lane_contact(ctx, color, first + 2, end)
    k3 = lane_contact(ctx, color, first + 3, end)
    c.manifolds = PtrW { x: lane_manifold(k0) as ptr, y: lane_manifold(k1) as ptr, z: lane_manifold(k2) as ptr, w: lane_manifold(k3) as ptr }
    m0 = gather_manifold(c.manifolds.x as *Manifold)
    m1 = gather_manifold(c.manifolds.y as *Manifold)
    m2 = gather_manifold(c.manifolds.z as *Manifold)
    m3 = gather_manifold(c.manifolds.w as *Manifold)
    c.index_a = IntW { x: lane_index1(k0, k0.body_sim_index_a), y: lane_index1(k1, k1.body_sim_index_a),
                       z: lane_index1(k2, k2.body_sim_index_a), w: lane_index1(k3, k3.body_sim_index_a) }
    c.index_b = IntW { x: lane_index1(k0, k0.body_sim_index_b), y: lane_index1(k1, k1.body_sim_index_b),
                       z: lane_index1(k2, k2.body_sim_index_b), w: lane_index1(k3, k3.body_sim_index_b) }
    c.point_counts = IntW { x: m0.point_count, y: m1.point_count, z: m2.point_count, w: m3.point_count }
    // The store reads this rather than go back out to the contacts.
    c.hit_lanes = hit_bit(k0, 0) | hit_bit(k1, 1) | hit_bit(k2, 2) | hit_bit(k3, 3)

    sa0 = lane_sim(ctx, c.index_a.x)
    sa1 = lane_sim(ctx, c.index_a.y)
    sa2 = lane_sim(ctx, c.index_a.z)
    sa3 = lane_sim(ctx, c.index_a.w)
    sb0 = lane_sim(ctx, c.index_b.x)
    sb1 = lane_sim(ctx, c.index_b.y)
    sb2 = lane_sim(ctx, c.index_b.z)
    sb3 = lane_sim(ctx, c.index_b.w)
    m_a = f4(sa0.inv_mass, sa1.inv_mass, sa2.inv_mass, sa3.inv_mass)
    m_b = f4(sb0.inv_mass, sb1.inv_mass, sb2.inv_mass, sb3.inv_mass)
    i_a = gather_inertia(sa0, sa1, sa2, sa3)
    i_b = gather_inertia(sb0, sb1, sb2, sb3)
    c.inv_mass_a = m_a
    c.inv_mass_b = m_b
    c.inv_inertia_a = i_a
    c.inv_inertia_b = i_b

    soft0 = lane_softness(ctx, c.index_a.x, c.index_b.x)
    soft1 = lane_softness(ctx, c.index_a.y, c.index_b.y)
    soft2 = lane_softness(ctx, c.index_a.z, c.index_b.z)
    soft3 = lane_softness(ctx, c.index_a.w, c.index_b.w)
    c.bias_rate = f4(soft0.bias_rate, soft1.bias_rate, soft2.bias_rate, soft3.bias_rate)
    c.mass_scale = f4(soft0.mass_scale, soft1.mass_scale, soft2.mass_scale, soft3.mass_scale)
    c.impulse_scale = f4(soft0.impulse_scale, soft1.impulse_scale, soft2.impulse_scale, soft3.impulse_scale)
    c.friction = f4(k0.friction, k1.friction, k2.friction, k3.friction)
    c.restitution = f4(k0.restitution, k1.restitution, k2.restitution, k3.restitution)
    c.rolling_resistance = f4(k0.rolling_resistance, k1.rolling_resistance, k2.rolling_resistance, k3.rolling_resistance)

    zero = zero_w()
    one = splat_w(1.0)
    warm_start_scale = zero
    if ctx.enable_warm_starting { warm_start_scale = one }
    normal = gather_vec3(m0.normal, m1.normal, m2.normal, m3.normal)
    tangent1 = perp_w(normal)
    tangent2 = cross_w(tangent1, normal)
    c.normal = normal
    c.tangent1 = tangent1
    c.tangent2 = tangent2
    tangent_velocity = gather_vec3(k0.tangent_velocity, k1.tangent_velocity, k2.tangent_velocity, k3.tangent_velocity)
    c.tangent_velocity1 = dot_w(tangent_velocity, tangent1)
    c.tangent_velocity2 = dot_w(tangent_velocity, tangent2)
    friction_impulse = gather_vec3(m0.friction_impulse, m1.friction_impulse, m2.friction_impulse, m3.friction_impulse)
    c.friction_impulse = Vec2W { x: mul_w(warm_start_scale, dot_w(friction_impulse, tangent1)),
                                 y: mul_w(warm_start_scale, dot_w(friction_impulse, tangent2)) }
    c.twist_impulse = mul_w(warm_start_scale, f4(m0.twist_impulse, m1.twist_impulse, m2.twist_impulse, m3.twist_impulse))
    c.rolling_impulse = mul_sv_w(warm_start_scale, gather_vec3(m0.rolling_impulse, m1.rolling_impulse, m2.rolling_impulse, m3.rolling_impulse))

    // The normal velocity before the solve, for restitution and the
    // manifold's record, needs the bodies' velocities.
    b_a = gather_bodies(ctx.states, &c.index_a)
    b_b = gather_bodies(ctx.states, &c.index_b)
    inv_tau = splat_w(1.0 / dynamics.SPECULATIVE_DISTANCE)
    two = splat_w(2.0)
    min_weight = splat_w(contact_solver.MIN_FRICTION_WEIGHT)
    point_counts = f4(c.point_counts.x as float, c.point_counts.y as float, c.point_counts.z as float, c.point_counts.w as float)
    zero_v = Vec3W { x: zero, y: zero, z: zero }
    center_a = zero_v
    center_b = zero_v
    total_weight = zero
    point_index = 0
    while point_index < dynamics.MAX_MANIFOLD_POINTS {
        // A point the lane's manifold lacks is zero: nothing reaches the bodies through it.
        has_point = greater_w(point_counts, splat_w(point_index as float))
        g = gather_point(m0, m1, m2, m3, point_index)
        r_a = blend_vec3_w(zero_v, g.anchor_a, has_point)
        r_b = blend_vec3_w(zero_v, g.anchor_b, has_point)
        s = blend_w(zero, g.base_separation, has_point)
        // The friction centre decays with separation (the scalar prepare says why).
        weight = blend_w(zero, min_w(max_w(sub_w(two, mul_w(s, inv_tau)), min_weight), one), has_point)
        center_a = mul_add_sv_w(center_a, weight, r_a)
        center_b = mul_add_sv_w(center_b, weight, r_b)
        total_weight = add_w(total_weight, weight)
        cp = wide_point_at(c, point_index)
        cp.anchor_a = r_a
        cp.anchor_b = r_b
        cp.base_separation = sub_w(s, dot_w(sub_v_w(r_b, r_a), normal))
        cp.normal_impulse = mul_w(warm_start_scale, blend_w(zero, g.normal_impulse, has_point))
        cp.total_normal_impulse = zero
        rn_a = cross_w(r_a, normal)
        rn_b = cross_w(r_b, normal)
        k_normal = add_w(add_w(add_w(m_a, m_b), dot_w(rn_a, mul_mv_w(i_a, rn_a))), dot_w(rn_b, mul_mv_w(i_b, rn_b)))
        valid = lanes.mask_and(greater_w(k_normal, zero), has_point)
        cp.normal_mass = blend_w(zero, div_w(one, k_normal), valid)
        vr_a = add_v_w(b_a.v, cross_w(b_a.w, r_a))
        vr_b = add_v_w(b_b.v, cross_w(b_b.w, r_b))
        cp.relative_velocity = blend_w(zero, dot_w(normal, sub_v_w(vr_b, vr_a)), has_point)
        point_index = point_index + 1
    }
    inv_weight = blend_w(zero, div_w(one, total_weight), greater_w(total_weight, zero))
    center_a = mul_sv_w(inv_weight, center_a)
    center_b = mul_sv_w(inv_weight, center_b)
    c.center_a = center_a
    c.center_b = center_b
    point_index = 0
    while point_index < dynamics.MAX_MANIFOLD_POINTS {
        cp = wide_point_at(c, point_index)
        has_point = greater_w(point_counts, splat_w(point_index as float))
        d = sub_v_w(cp.anchor_a, center_a)
        cp.lever_arm = blend_w(zero, lanes.sqrt4(dot_w(d, d)), has_point)
        point_index = point_index + 1
    }

    rt_a1 = cross_w(center_a, tangent1)
    rt_a2 = cross_w(center_a, tangent2)
    rt_b1 = cross_w(center_b, tangent1)
    rt_b2 = cross_w(center_b, tangent2)
    i_rt_a1 = mul_mv_w(i_a, rt_a1)
    i_rt_a2 = mul_mv_w(i_a, rt_a2)
    i_rt_b1 = mul_mv_w(i_b, rt_b1)
    i_rt_b2 = mul_mv_w(i_b, rt_b2)
    kxx = add_w(add_w(add_w(m_a, m_b), dot_w(rt_a1, i_rt_a1)), dot_w(rt_b1, i_rt_b1))
    kyy = add_w(add_w(add_w(m_a, m_b), dot_w(rt_a2, i_rt_a2)), dot_w(rt_b2, i_rt_b2))
    kxy = add_w(dot_w(rt_a1, i_rt_a2), dot_w(rt_b1, i_rt_b2))
    det = sub_w(mul_w(kxx, kyy), mul_w(kxy, kxy))
    inv_det = blend_w(zero, div_w(one, det), greater_w(lanes.abs4(det), splat_w(1000.0 * math.TINY_F32)))
    c.tangent_mass = SymMatrix2W { cxx: mul_w(inv_det, kyy), cxy: neg_w(mul_w(inv_det, kxy)), cyy: mul_w(inv_det, kxx) }

    i_ab = add_sym_w(i_a, i_b)
    k_twist = dot_w(normal, mul_mv_w(i_ab, normal))
    c.twist_mass = blend_w(zero, div_w(one, k_twist), greater_w(k_twist, zero))
    // The solve reads the rolling mass only where there is rolling resistance.
    if all_zero_w(c.rolling_resistance) {
        c.rolling_mass = SymMatrix3W { cxx: zero, cxy: zero, cxz: zero, cyy: zero, cyz: zero, czz: zero }
    } else {
        c.rolling_mass = invert_sym_w(i_ab)
    }
}

// A colour's convex contacts into its wide constraints, four to a slot
// in the order of the colour's array.
prepare_wide_contacts(ctx: *StepContext, color: *GraphColor) {
    prepare_wide_range(ctx, color, 0, color.convex_contacts.count)
}

// A block [start, end) of a colour's convex contacts into their slots:
// `start` begins a slot, and `end` ends one or is the colour's count.
prepare_wide_range(ctx: *StepContext, color: *GraphColor, start: int, end: int) {
    w = ctx.world
    i = start
    while i < end {
        // The slots to come: the contacts two ahead, the manifolds one ahead.
        j = i + 2 * WIDTH
        while j < end && j < i + 3 * WIDTH {
            native.prefetch(dynamics.contact_at(w, basics.ints_get(&color.convex_contacts, j)) as ptr)
            j = j + 1
        }
        j = i + WIDTH
        while j < end && j < i + 2 * WIDTH {
            native.prefetch(dynamics.contact_at(w, basics.ints_get(&color.convex_contacts, j)).manifolds)
            j = j + 1
        }
        prepare_wide_slot(ctx, color, i / WIDTH, end)
        i = i + WIDTH
    }
}

// Before any block runs: the zero record a spare lane gathers from made,
// so no worker races to make it. (A slot writes every lane, spare ones
// included, so there is no tail to clear.)
zero_wide_tail(color: *GraphColor) {
    if color.convex_contacts.count > 0 { zero_record() }
}

// Last step's impulses applied before solving (b3WarmStartContacts_Convex).
warm_start_wide_contacts(ctx: *StepContext, constraints: ptr, count: int) {
    states = ctx.states
    index = 0
    while index < count {
        c = wide_constraint_at(constraints, index)
        b_a = gather_bodies(states, &c.index_a)
        b_b = gather_bodies(states, &c.index_b)
        point_count = max_point_count(c)
        j = 0
        while j < point_count {
            cp = wide_point_at(c, j)
            impulse = mul_sv_w(cp.normal_impulse, c.normal)
            b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, cross_w(cp.anchor_a, impulse))
            b_a.v = mul_sub_sv_w(b_a.v, c.inv_mass_a, impulse)
            b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, cross_w(cp.anchor_b, impulse))
            b_b.v = mul_add_sv_w(b_b.v, c.inv_mass_b, impulse)
            j = j + 1
        }
        // Central friction.
        friction = mul_add_sv_w(mul_sv_w(c.friction_impulse.x, c.tangent1), c.friction_impulse.y, c.tangent2)
        b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, cross_w(c.center_a, friction))
        b_a.v = mul_sub_sv_w(b_a.v, c.inv_mass_a, friction)
        b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, cross_w(c.center_b, friction))
        b_b.v = mul_add_sv_w(b_b.v, c.inv_mass_b, friction)
        // Twist friction and rolling resistance.
        twist = mul_sv_w(c.twist_impulse, c.normal)
        b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, twist)
        b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, twist)
        b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, c.rolling_impulse)
        b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, c.rolling_impulse)
        scatter_bodies(states, &c.index_a, &b_a)
        scatter_bodies(states, &c.index_b, &b_b)
        index = index + 1
    }
}

// One sequential impulse pass over four contacts at a time
// (b3SolveContacts_Convex): the scalar solve's steps with the branches
// as masks: a lane apart gets the speculative bias, a lane penetrating
// the soft constraint's when biased; then, without bias only, the
// rolling resistance, twist friction and central friction.
solve_wide_contacts(ctx: *StepContext, constraints: ptr, count: int, use_bias: bool) {
    states = ctx.states
    inv_h = splat_w(ctx.inv_h)
    contact_speed = splat_w(0.0 - ctx.world.contact_speed)
    one = splat_w(1.0)
    zero = zero_w()
    epsilon = splat_w(math.EPSILON)
    index = 0
    while index < count {
        c = wide_constraint_at(constraints, index)
        point_count = max_point_count(c)
        b_a = gather_bodies(states, &c.index_a)
        b_b = gather_bodies(states, &c.index_b)
        bias_rate = zero
        mass_scale = one
        impulse_scale = zero
        if use_bias {
            bias_rate = mul_w(c.mass_scale, c.bias_rate)
            mass_scale = c.mass_scale
            impulse_scale = c.impulse_scale
        }
        dp = sub_v_w(b_b.dp, b_a.dp)
        total_normal_impulse = zero
        total_twist_limit = zero
        point_index = 0
        while point_index < point_count {
            cp = wide_point_at(c, point_index)
            r_a = cp.anchor_a
            r_b = cp.anchor_b
            // The anchors turned with the bodies give the current separation.
            rs_a = rotate_vector_w(b_a.dq, r_a)
            rs_b = rotate_vector_w(b_b.dq, r_b)
            ds = add_v_w(dp, sub_v_w(rs_b, rs_a))
            s = add_w(dot_w(c.normal, ds), cp.base_separation)
            apart = greater_w(s, zero)
            spec_bias = mul_w(s, inv_h)
            soft_bias = max_w(mul_w(bias_rate, s), contact_speed)
            bias = blend_w(soft_bias, spec_bias, apart)
            point_mass_scale = blend_w(mass_scale, one, apart)
            point_impulse_scale = blend_w(impulse_scale, zero, apart)
            vr_a = add_v_w(b_a.v, cross_w(b_a.w, r_a))
            vr_b = add_v_w(b_b.v, cross_w(b_b.w, r_b))
            vn = dot_w(sub_v_w(vr_b, vr_a), c.normal)
            neg_impulse = add_w(mul_w(cp.normal_mass, add_w(mul_w(point_mass_scale, vn), bias)), mul_w(point_impulse_scale, cp.normal_impulse))
            new_impulse = max_w(sub_w(cp.normal_impulse, neg_impulse), zero)
            delta_impulse = sub_w(new_impulse, cp.normal_impulse)
            cp.normal_impulse = new_impulse
            cp.total_normal_impulse = add_w(cp.total_normal_impulse, new_impulse)
            total_normal_impulse = add_w(total_normal_impulse, new_impulse)
            total_twist_limit = add_w(total_twist_limit, mul_w(cp.lever_arm, new_impulse))
            p = mul_sv_w(delta_impulse, c.normal)
            b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, cross_w(r_a, p))
            b_a.v = mul_sub_sv_w(b_a.v, c.inv_mass_a, p)
            b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, cross_w(r_b, p))
            b_b.v = mul_add_sv_w(b_b.v, c.inv_mass_b, p)
            point_index = point_index + 1
        }
        if use_bias == false {
            // Rolling resistance, when any lane has it.
            if all_zero_w(c.rolling_resistance) == false {
                delta_rolling = mul_mv_w(c.rolling_mass, sub_v_w(b_a.w, b_b.w))
                old_rolling = c.rolling_impulse
                c.rolling_impulse = add_v_w(old_rolling, delta_rolling)
                max_rolling = mul_w(c.rolling_resistance, total_normal_impulse)
                length_squared = dot_w(c.rolling_impulse, c.rolling_impulse)
                over = greater_w(length_squared, mul_add_w(epsilon, max_rolling, max_rolling))
                normalize = div_w(max_rolling, add_w(sqrt_w(length_squared), epsilon))
                scale = blend_w(one, normalize, over)
                // A lane without rolling resistance keeps no impulse.
                scale = blend_w(zero, scale, greater_w(c.rolling_resistance, zero))
                c.rolling_impulse = mul_sv_w(scale, c.rolling_impulse)
                delta_rolling = sub_v_w(c.rolling_impulse, old_rolling)
                b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, delta_rolling)
                b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, delta_rolling)
            }
            // Central twist friction.
            twist_speed = dot_w(c.normal, sub_v_w(b_b.w, b_a.w))
            max_twist = mul_w(c.friction, total_twist_limit)
            old_twist = c.twist_impulse
            c.twist_impulse = sym_clamp_w(sub_w(old_twist, mul_w(c.twist_mass, twist_speed)), max_twist)
            delta_twist = sub_w(c.twist_impulse, old_twist)
            twist = mul_sv_w(delta_twist, c.normal)
            b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, twist)
            b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, twist)
            // Central friction.
            c_a = c.center_a
            c_b = c.center_b
            vr_a = add_v_w(b_a.v, cross_w(b_a.w, c_a))
            vr_b = add_v_w(b_b.v, cross_w(b_b.w, c_b))
            vr = sub_v_w(vr_b, vr_a)
            vt = Vec2W { x: sub_w(dot_w(vr, c.tangent1), c.tangent_velocity1), y: sub_w(dot_w(vr, c.tangent2), c.tangent_velocity2) }
            tm = mul_mv2_w(c.tangent_mass, vt)
            new_friction = Vec2W { x: sub_w(c.friction_impulse.x, tm.x), y: sub_w(c.friction_impulse.y, tm.y) }
            max_friction = mul_w(c.friction, total_normal_impulse)
            length_squared = add_w(mul_w(new_friction.x, new_friction.x), mul_w(new_friction.y, new_friction.y))
            over = greater_w(length_squared, mul_w(max_friction, max_friction))
            normalize = div_w(max_friction, add_w(sqrt_w(length_squared), epsilon))
            scale = blend_w(one, normalize, over)
            new_friction = Vec2W { x: mul_w(scale, new_friction.x), y: mul_w(scale, new_friction.y) }
            delta_friction = Vec2W { x: sub_w(new_friction.x, c.friction_impulse.x), y: sub_w(new_friction.y, c.friction_impulse.y) }
            c.friction_impulse = new_friction
            p = add_v_w(mul_sv_w(delta_friction.x, c.tangent1), mul_sv_w(delta_friction.y, c.tangent2))
            b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, cross_w(c_a, p))
            b_a.v = mul_sub_sv_w(b_a.v, c.inv_mass_a, p)
            b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, cross_w(c_b, p))
            b_b.v = mul_add_sv_w(b_b.v, c.inv_mass_b, p)
        }
        scatter_bodies(states, &c.index_a, &b_a)
        scatter_bodies(states, &c.index_b, &b_b)
        index = index + 1
    }
}

// The bounce (b3ApplyRestitution_Convex): a slot with no restitution
// in any lane is skipped; in the rest, a lane's point gets a zero mass
// unless it approached faster than the threshold with an impulse.
apply_wide_restitution(ctx: *StepContext, constraints: ptr, count: int) {
    states = ctx.states
    threshold = splat_w(ctx.restitution_threshold)
    zero = zero_w()
    index = 0
    while index < count {
        c = wide_constraint_at(constraints, index)
        if all_zero_w(c.restitution) == false {
            point_count = max_point_count(c)
            b_a = gather_bodies(states, &c.index_a)
            b_b = gather_bodies(states, &c.index_b)
            no_restitution = equals_w(c.restitution, zero)
            point_index = 0
            while point_index < point_count {
                cp = wide_point_at(c, point_index)
                slow = greater_w(add_w(cp.relative_velocity, threshold), zero)
                untouched = equals_w(cp.total_normal_impulse, zero)
                skip = or_w(or_w(slow, untouched), no_restitution)
                mass = blend_w(cp.normal_mass, zero, skip)
                r_a = cp.anchor_a
                r_b = cp.anchor_b
                vr_a = add_v_w(b_a.v, cross_w(b_a.w, r_a))
                vr_b = add_v_w(b_b.v, cross_w(b_b.w, r_b))
                vn = dot_w(sub_v_w(vr_b, vr_a), c.normal)
                neg_impulse = mul_w(mass, add_w(vn, mul_w(c.restitution, cp.relative_velocity)))
                new_impulse = max_w(sub_w(cp.normal_impulse, neg_impulse), zero)
                delta_impulse = sub_w(new_impulse, cp.normal_impulse)
                cp.normal_impulse = new_impulse
                cp.total_normal_impulse = add_w(cp.total_normal_impulse, delta_impulse)
                p = mul_sv_w(delta_impulse, c.normal)
                b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, cross_w(r_a, p))
                b_a.v = mul_sub_sv_w(b_a.v, c.inv_mass_a, p)
                b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, cross_w(r_b, p))
                b_b.v = mul_add_sv_w(b_b.v, c.inv_mass_b, p)
                point_index = point_index + 1
            }
            scatter_bodies(states, &c.index_a, &b_a)
            scatter_bodies(states, &c.index_b, &b_b)
        }
        index = index + 1
    }
}

// The impulses back into the lanes' manifolds (b3StoreImpulses_Convex)
// for next step's warm start and the user's queries; a contact that
// wants hit events and closed faster than the threshold with an impulse
// sets its bit. Whether any did.
store_wide_impulses(ctx: *StepContext, color: *GraphColor, hit_bits: *BitSet) -> bool {
    return store_wide_range(ctx, color, 0, color.convex_contacts.count, hit_bits)
}

store_wide_range(ctx: *StepContext, color: *GraphColor, start: int, end: int, hit_bits: *BitSet) -> bool {
    w = ctx.world
    has_hits = false
    neg_threshold = 0.0 - w.hit_event_threshold
    i = start
    while i < end {
        c = wide_constraint_at(color.wide_constraints, i / WIDTH)
        l = i % WIDTH
        // The next slot's manifolds, which nothing has touched since the
        // collide pass, fetched while this slot's are written.
        if l == 0 && i + WIDTH < end {
            next = wide_constraint_at(color.wide_constraints, i / WIDTH + 1)
            native.prefetch(next.manifolds.x)
            native.prefetch(next.manifolds.y)
            native.prefetch(next.manifolds.z)
            native.prefetch(next.manifolds.w)
        }
        m = ptr_lane(&c.manifolds, l) as *Manifold
        f1 = lane(c.friction_impulse.x, l)
        f2 = lane(c.friction_impulse.y, l)
        m.friction_impulse = math.vec3(f1 * lane(c.tangent1.x, l) + f2 * lane(c.tangent2.x, l),
                                       f1 * lane(c.tangent1.y, l) + f2 * lane(c.tangent2.y, l),
                                       f1 * lane(c.tangent1.z, l) + f2 * lane(c.tangent2.z, l))
        m.twist_impulse = lane(c.twist_impulse, l)
        m.rolling_impulse = math.vec3(lane(c.rolling_impulse.x, l), lane(c.rolling_impulse.y, l), lane(c.rolling_impulse.z, l))
        point_count = m.point_count
        point_index = 0
        while point_index < point_count {
            cp = wide_point_at(c, point_index)
            mp = dynamics.manifold_point_at(m, point_index)
            mp.normal_impulse = lane(cp.normal_impulse, l)
            mp.total_normal_impulse = lane(cp.total_normal_impulse, l)
            mp.normal_velocity = lane(cp.relative_velocity, l)
            point_index = point_index + 1
        }
        if (c.hit_lanes & (1 << l)) != 0 {
            point_index = 0
            while point_index < point_count {
                mp = dynamics.manifold_point_at(m, point_index)
                if mp.normal_velocity < neg_threshold && mp.total_normal_impulse > 0.0 {
                    contact = dynamics.contact_at(w, basics.ints_get(&color.convex_contacts, i))
                    basics.bitset_set_grow(hit_bits, contact.contact_id)
                    has_hits = true
                    break
                }
                point_index = point_index + 1
            }
        }
        i = i + 1
    }
    return has_hits
}
