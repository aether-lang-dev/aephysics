// aephysics.contact_solver_wide -- the convex contacts of a graph
// colour solved eight at a time: the constraints of eight contacts laid
// side by side, one lane each (a structure of arrays: every scalar of
// the constraint is eight floats), so the prepare, warm start, solve,
// restitution and store run the same instruction on eight contacts at
// once. The bodies' states are gathered into lanes before a constraint
// and the velocities scattered back after; a colour's contacts share
// no body, so the lanes never alias. A static body is lane zero of the
// identity state; a colour's tail slot has its spare lanes zeroed, so
// they compute nothing that reaches a body.
//
// This is Box3D's wide contact path (contact_solver.c, Erin Catto,
// MIT): b3PrepareContacts_Convex is prepare_wide_contacts,
// b3SolveContacts_Convex is solve_wide_contacts, and the lane types
// (b3FloatW, b3Vec3W, b3ContactConstraintWide) are f32x8, Vec3W and
// WideConstraint. A lane here is the language's `f32x8` (std.lanes,
// Aether 0.788): eight floats, one 256-bit register when the build has
// AVX2 (AETHER_AEPHYSICS_CFLAGS=-mavx2, the reference's wide8.c) and two
// four-lane halves otherwise (its SSE2 and NEON width, at the same cost
// as four lanes twice). Each lane's arithmetic is the same either way,
// so the width changes the speed, never a result. The mesh and overflow
// contacts stay with aephysics.contact_solver.
import std.lanes
import std.string
import aephysics.math
import aephysics.native
import aephysics.basics
import aephysics.dynamics
import aephysics.contact_solver

exports (
    WIDTH, Vec3W, IntW, WideConstraintPoint, WideConstraint,
    wide_constraint_at, wide_constraint_count, wide_point_at, lane, int_lane,
    prepare_wide_contacts, prepare_wide_range, zero_wide_tail, warm_start_wide_contacts, solve_wide_contacts, apply_wide_restitution, store_wide_impulses, store_wide_range
)

const WIDTH = 8
const NULL_INDEX = 0 - 1

// --- lanes ---------------------------------------------------------------------------------------------------

// A lane of eight is `f32x8`, the language's (std.lanes, Aether 0.788).
// Single precision is what the reference computes a contact in
// and what the native file's lanes already computed; the constraint is
// the same record in both, so there is one arithmetic here, not two.
struct Vec2W {
    x: f32x8
    y: f32x8
}

struct Vec3W {
    x: f32x8
    y: f32x8
    z: f32x8
}

struct QuatW {
    v: Vec3W
    s: f32x8
}

// Symmetric matrices: the upper triangles.
struct SymMatrix2W {
    cxx: f32x8
    cxy: f32x8
    cyy: f32x8
}

struct SymMatrix3W {
    cxx: f32x8
    cxy: f32x8
    cxz: f32x8
    cyy: f32x8
    cyz: f32x8
    czz: f32x8
}

// Eight ints and eight pointers, one per contact.
struct IntW {
    l0: int
    l1: int
    l2: int
    l3: int
    l4: int
    l5: int
    l6: int
    l7: int
}

struct PtrW {
    l0: ptr
    l1: ptr
    l2: ptr
    l3: ptr
    l4: ptr
    l5: ptr
    l6: ptr
    l7: ptr
}

// A lane of a wide value, read by index: the store works a contact at
// a time, where the stages before it work eight.
lane(f: f32x8, index: int) -> float { return (lanes.lane8(f, index as long)) as float }

int_lane(v: *IntW, index: int) -> int {
    lanes = (v as ptr) as int[]
    return lanes[index]
}

ptr_lane(v: *PtrW, index: int) -> ptr {
    lanes = (v as ptr) as ptr[]
    return lanes[index]
}

zero_w() -> f32x8 { return lanes.splat8(0.0) }
splat_w(s: float) -> f32x8 { return lanes.splat8(s as f32) }
neg_w(a: f32x8) -> f32x8 { return lanes.splat8(0.0) - a }
add_w(a: f32x8, b: f32x8) -> f32x8 { return a + b }
sub_w(a: f32x8, b: f32x8) -> f32x8 { return a - b }
mul_w(a: f32x8, b: f32x8) -> f32x8 { return a * b }
div_w(a: f32x8, b: f32x8) -> f32x8 { return a / b }
// One instruction, and exact: an IEEE square root is correctly rounded,
// so it is the eight scalar roots (std.lanes.sqrt8, aether#2158).
sqrt_w(a: f32x8) -> f32x8 { return lanes.sqrt8(a) }
// a + b * c, as two operations: a fused multiply-add would differ from the scalar path.
mul_add_w(a: f32x8, b: f32x8, c: f32x8) -> f32x8 { return a + b * c }
min_w(a: f32x8, b: f32x8) -> f32x8 { return lanes.min8(a, b) }
max_w(a: f32x8, b: f32x8) -> f32x8 { return lanes.max8(a, b) }
// a clamped to [-b, b].
sym_clamp_w(a: f32x8, b: f32x8) -> f32x8 { return max_w(neg_w(b), min_w(a, b)) }
// A mask is the lanes a comparison sets, and blend picks by it.
or_w(a: i32x8, b: i32x8) -> i32x8 { return lanes.mask8_or(a, b) }
greater_w(a: f32x8, b: f32x8) -> i32x8 { return lanes.gt8(a, b) }
equals_w(a: f32x8, b: f32x8) -> i32x8 { return lanes.eq8(a, b) }
all_zero_w(a: f32x8) -> bool { return lanes.all8(lanes.eq8(a, lanes.splat8(0.0))) }
// Per lane: b where the mask is set, a elsewhere.
blend_w(a: f32x8, b: f32x8, m: i32x8) -> f32x8 { return lanes.select8(m, b, a) }

mul_sv_w(s: f32x8, a: Vec3W) -> Vec3W { return Vec3W { x: mul_w(s, a.x), y: mul_w(s, a.y), z: mul_w(s, a.z) } }
// a - s * b and a + s * b.
mul_sub_sv_w(a: Vec3W, s: f32x8, b: Vec3W) -> Vec3W {
    return Vec3W { x: sub_w(a.x, mul_w(s, b.x)), y: sub_w(a.y, mul_w(s, b.y)), z: sub_w(a.z, mul_w(s, b.z)) }
}
mul_add_sv_w(a: Vec3W, s: f32x8, b: Vec3W) -> Vec3W {
    return Vec3W { x: add_w(a.x, mul_w(s, b.x)), y: add_w(a.y, mul_w(s, b.y)), z: add_w(a.z, mul_w(s, b.z)) }
}
add_v2_w(a: Vec2W, b: Vec2W) -> Vec2W { return Vec2W { x: add_w(a.x, b.x), y: add_w(a.y, b.y) } }
sub_v_w(a: Vec3W, b: Vec3W) -> Vec3W { return Vec3W { x: sub_w(a.x, b.x), y: sub_w(a.y, b.y), z: sub_w(a.z, b.z) } }
add_v_w(a: Vec3W, b: Vec3W) -> Vec3W { return Vec3W { x: add_w(a.x, b.x), y: add_w(a.y, b.y), z: add_w(a.z, b.z) } }
mul_mv2_w(m: SymMatrix2W, a: Vec2W) -> Vec2W {
    return Vec2W { x: add_w(mul_w(m.cxx, a.x), mul_w(m.cxy, a.y)), y: add_w(mul_w(m.cxy, a.x), mul_w(m.cyy, a.y)) }
}
mul_mv_w(m: SymMatrix3W, a: Vec3W) -> Vec3W {
    return Vec3W { x: add_w(mul_w(m.cxx, a.x), add_w(mul_w(m.cxy, a.y), mul_w(m.cxz, a.z))),
                   y: add_w(mul_w(m.cxy, a.x), add_w(mul_w(m.cyy, a.y), mul_w(m.cyz, a.z))),
                   z: add_w(mul_w(m.cxz, a.x), add_w(mul_w(m.cyz, a.y), mul_w(m.czz, a.z))) }
}
// a - m * b and a + m * b.
mul_sub_mv_w(a: Vec3W, m: SymMatrix3W, b: Vec3W) -> Vec3W { return sub_v_w(a, mul_mv_w(m, b)) }
mul_add_mv_w(a: Vec3W, m: SymMatrix3W, b: Vec3W) -> Vec3W { return add_v_w(a, mul_mv_w(m, b)) }
dot_w(a: Vec3W, b: Vec3W) -> f32x8 { return add_w(add_w(mul_w(a.x, b.x), mul_w(a.y, b.y)), mul_w(a.z, b.z)) }
cross_w(a: Vec3W, b: Vec3W) -> Vec3W {
    return Vec3W { x: sub_w(mul_w(a.y, b.z), mul_w(a.z, b.y)),
                   y: sub_w(mul_w(a.z, b.x), mul_w(a.x, b.z)),
                   z: sub_w(mul_w(a.x, b.y), mul_w(a.y, b.x)) }
}
// v + 2 (q.v x (q.v x v + q.s v)), the reference's rotation (math.rotate_vector's form).
rotate_vector_w(q: QuatW, a: Vec3W) -> Vec3W {
    t1 = cross_w(q.v, a)
    t2 = Vec3W { x: mul_add_w(t1.x, q.s, a.x), y: mul_add_w(t1.y, q.s, a.y), z: mul_add_w(t1.z, q.s, a.z) }
    t3 = cross_w(q.v, t2)
    two = splat_w(2.0)
    return Vec3W { x: mul_add_w(a.x, two, t3.x), y: mul_add_w(a.y, two, t3.y), z: mul_add_w(a.z, two, t3.z) }
}

// --- the constraint ------------------------------------------------------------------------------------------

// One manifold point of eight contacts (b3ContactConstraintPointWide).
struct WideConstraintPoint {
    anchor_a: Vec3W
    anchor_b: Vec3W
    base_separation: f32x8
    normal_impulse: f32x8
    total_normal_impulse: f32x8
    normal_mass: f32x8
    lever_arm: f32x8
    relative_velocity: f32x8
    restitution_impulse: f32x8     // what the restitution passes added beyond the approach
}

// Eight convex contacts' constraints (b3ContactConstraintWide): the body
// indices base 1 (0 for a static body), the point counts, and every
// scalar of the constraint by lane.
struct WideConstraint {
    index_a: IntW
    index_b: IntW
    point_counts: IntW
    inv_mass_a: f32x8
    inv_mass_b: f32x8
    inv_inertia_a: SymMatrix3W
    inv_inertia_b: SymMatrix3W
    normal: Vec3W
    tangent1: Vec3W
    tangent2: Vec3W
    center_a: Vec3W                // the friction centres
    center_b: Vec3W
    twist_mass: f32x8
    twist_impulse: f32x8
    tangent_mass: SymMatrix2W
    friction_impulse: Vec2W
    rolling_mass: SymMatrix3W
    rolling_impulse: Vec3W
    friction: f32x8
    rolling_resistance: f32x8
    tangent_velocity1: f32x8
    tangent_velocity2: f32x8
    bias_rate: f32x8
    mass_scale: f32x8
    impulse_scale: f32x8
    restitution: f32x8
    manifolds: PtrW                // *Manifold per lane, null in a spare lane
    hit_lanes: int                 // bit l: lane l's contact wants hit events
    point0: WideConstraintPoint
    point1: WideConstraintPoint
    point2: WideConstraintPoint
    point3: WideConstraintPoint
}

wide_constraint_at(base: ptr, index: int) -> *WideConstraint { return (base + index * sizeof(WideConstraint)) as *WideConstraint }
wide_point_at(c: *WideConstraint, index: int) -> *WideConstraintPoint {
    return ((&c.point0) as ptr + index * sizeof(WideConstraintPoint)) as *WideConstraintPoint
}

// The wide constraints a colour's convex contacts fill: eight to a slot.
wide_constraint_count(convex_contact_count: int) -> int {
    if convex_contact_count == 0 { return 0 }
    return ((convex_contact_count - 1) / WIDTH) + 1
}

// The most points any lane has: the loops run over that many, the
// spare lanes' zeroed masses and anchors keeping them inert.
max_point_count(c: *WideConstraint) -> int {
    m = c.point_counts.l0
    m = math.max_int(m, c.point_counts.l1)
    m = math.max_int(m, c.point_counts.l2)
    m = math.max_int(m, c.point_counts.l3)
    m = math.max_int(m, c.point_counts.l4)
    m = math.max_int(m, c.point_counts.l5)
    m = math.max_int(m, c.point_counts.l6)
    m = math.max_int(m, c.point_counts.l7)
    return m
}

// --- gather and scatter --------------------------------------------------------------------------------------

// Eight bodies' states in lanes (b3BodyStateW).
struct BodyStateW {
    v: Vec3W
    w: Vec3W
    dp: Vec3W
    dq: QuatW
}

state_or_identity(states: ptr, index1: int) -> *BodyState {
    if index1 == 0 { return contact_solver.dummy_state() }
    return (states + (index1 - 1) * sizeof(BodyState)) as *BodyState
}

gather_bodies(states: ptr, indices: *IntW) -> BodyStateW {
    s0 = state_or_identity(states, indices.l0)
    s1 = state_or_identity(states, indices.l1)
    s2 = state_or_identity(states, indices.l2)
    s3 = state_or_identity(states, indices.l3)
    s4 = state_or_identity(states, indices.l4)
    s5 = state_or_identity(states, indices.l5)
    s6 = state_or_identity(states, indices.l6)
    s7 = state_or_identity(states, indices.l7)
    v = Vec3W { x: lanes.f32x8(s0.v.x, s1.v.x, s2.v.x, s3.v.x, s4.v.x, s5.v.x, s6.v.x, s7.v.x),
          y: lanes.f32x8(s0.v.y, s1.v.y, s2.v.y, s3.v.y, s4.v.y, s5.v.y, s6.v.y, s7.v.y),
          z: lanes.f32x8(s0.v.z, s1.v.z, s2.v.z, s3.v.z, s4.v.z, s5.v.z, s6.v.z, s7.v.z) }
    w = Vec3W { x: lanes.f32x8(s0.w.x, s1.w.x, s2.w.x, s3.w.x, s4.w.x, s5.w.x, s6.w.x, s7.w.x),
          y: lanes.f32x8(s0.w.y, s1.w.y, s2.w.y, s3.w.y, s4.w.y, s5.w.y, s6.w.y, s7.w.y),
          z: lanes.f32x8(s0.w.z, s1.w.z, s2.w.z, s3.w.z, s4.w.z, s5.w.z, s6.w.z, s7.w.z) }
    dp = Vec3W { x: lanes.f32x8(s0.dp.x, s1.dp.x, s2.dp.x, s3.dp.x, s4.dp.x, s5.dp.x, s6.dp.x, s7.dp.x),
          y: lanes.f32x8(s0.dp.y, s1.dp.y, s2.dp.y, s3.dp.y, s4.dp.y, s5.dp.y, s6.dp.y, s7.dp.y),
          z: lanes.f32x8(s0.dp.z, s1.dp.z, s2.dp.z, s3.dp.z, s4.dp.z, s5.dp.z, s6.dp.z, s7.dp.z) }
    dqv = Vec3W { x: lanes.f32x8(s0.dq.x, s1.dq.x, s2.dq.x, s3.dq.x, s4.dq.x, s5.dq.x, s6.dq.x, s7.dq.x),
          y: lanes.f32x8(s0.dq.y, s1.dq.y, s2.dq.y, s3.dq.y, s4.dq.y, s5.dq.y, s6.dq.y, s7.dq.y),
          z: lanes.f32x8(s0.dq.z, s1.dq.z, s2.dq.z, s3.dq.z, s4.dq.z, s5.dq.z, s6.dq.z, s7.dq.z) }
    dqs = lanes.f32x8(s0.dq.w, s1.dq.w, s2.dq.w, s3.dq.w, s4.dq.w, s5.dq.w, s6.dq.w, s7.dq.w)
    return BodyStateW { v: v, w: w, dp: dp, dq: QuatW { v: dqv, s: dqs } }
}

// The velocities back to the dynamic bodies of the lanes.
scatter_lane(states: ptr, index1: int, body: *BodyStateW, l: int) {
    if index1 == 0 { return }
    state = (states + (index1 - 1) * sizeof(BodyState)) as *BodyState
    if (state.flags & dynamics.DYNAMIC_FLAG) == 0 { return }
    state.v = Vec3f { x: lanes.lane8(body.v.x, l as long), y: lanes.lane8(body.v.y, l as long), z: lanes.lane8(body.v.z, l as long) }
    state.w = Vec3f { x: lanes.lane8(body.w.x, l as long), y: lanes.lane8(body.w.y, l as long), z: lanes.lane8(body.w.z, l as long) }
}

scatter_bodies(states: ptr, indices: *IntW, body: *BodyStateW) {
    scatter_lane(states, indices.l0, body, 0)
    scatter_lane(states, indices.l1, body, 1)
    scatter_lane(states, indices.l2, body, 2)
    scatter_lane(states, indices.l3, body, 3)
    scatter_lane(states, indices.l4, body, 4)
    scatter_lane(states, indices.l5, body, 5)
    scatter_lane(states, indices.l6, body, 6)
    scatter_lane(states, indices.l7, body, 7)
}

// --- the stages ----------------------------------------------------------------------------------------------

// A zeroed block the size of the largest of a contact, a manifold and a
// body record: what a spare lane and a static body gather from, so the
// prepare reads eight lanes without a branch per field (the reference's
// b3_zeroContact, b3_zeroManifold and b3_zeroBodySim). Made before any
// worker runs (zero_wide_tail), never written and never freed: a static,
// so it is outside the counted allocator.
extern calloc(count: int, size: int) -> ptr
var g_zero_record: ptr = null

zero_record() -> ptr {
    if g_zero_record == null {
        g_zero_record = calloc(1, math.max_int(math.max_int(sizeof(Contact), sizeof(Manifold)), sizeof(BodySim)))
    }
    return g_zero_record
}

f8(a0: float, a1: float, a2: float, a3: float, a4: float, a5: float, a6: float, a7: float) -> f32x8 { return lanes.f32x8(a0 as f32, a1 as f32, a2 as f32, a3 as f32, a4 as f32, a5 as f32, a6 as f32, a7 as f32) }

// The contact of a lane: index `index` of the colour's convex contacts, or
// the zero record for a spare lane past `end`.
lane_contact(ctx: *StepContext, color: *GraphColor, index: int, end: int) -> *Contact {
    if index >= end { return zero_record() as *Contact }
    return dynamics.contact_at(ctx.world, basics.ints_get(&color.convex_contacts, index))
}

// A lane's manifold, null for a spare lane.
lane_manifold(c: *Contact) -> *Manifold {
    if (c as ptr) == zero_record() { return null }
    return dynamics.manifold_at(c, 0)
}

// The manifold a lane gathers from: its own, or the zero record.
gather_manifold(m: *Manifold) -> *Manifold {
    if m == null { return zero_record() as *Manifold }
    return m
}

// A lane's body index base 1, 0 for a static body or a spare lane.
lane_index1(c: *Contact, index: int) -> int {
    if (c as ptr) == zero_record() { return 0 }
    return index + 1
}

// Lane l's bit when its contact wants hit events (a spare lane's flags are zero).
hit_bit(c: *Contact, l: int) -> int {
    if (c.flags & dynamics.SIM_ENABLE_HIT_EVENT) != 0 { return 1 << l }
    return 0
}

lane_sim(ctx: *StepContext, index1: int) -> *BodySim {
    if index1 == 0 { return zero_record() as *BodySim }
    return contact_solver.sim_at(ctx.sims, index1 - 1)
}

lane_softness(ctx: *StepContext, index_a1: int, index_b1: int, sim_a: *BodySim, sim_b: *BodySim) -> Softness {
    if index_a1 == 0 || index_b1 == 0 { return ctx.static_softness }
    // A kinematic body, of no inverse mass as a static one, when the world asks.
    if ctx.world.enable_kinematic_static_softness && (sim_a.inv_mass == 0.0 || sim_b.inv_mass == 0.0) { return ctx.static_softness }
    return ctx.contact_softness
}

// Eight bodies' inverse world inertias, the upper triangles.
gather_inertia(s0: *BodySim, s1: *BodySim, s2: *BodySim, s3: *BodySim, s4: *BodySim, s5: *BodySim, s6: *BodySim, s7: *BodySim) -> SymMatrix3W {
    return SymMatrix3W {
        cxx: lanes.f32x8(s0.inv_inertia_world.cx.x, s1.inv_inertia_world.cx.x, s2.inv_inertia_world.cx.x, s3.inv_inertia_world.cx.x, s4.inv_inertia_world.cx.x, s5.inv_inertia_world.cx.x, s6.inv_inertia_world.cx.x, s7.inv_inertia_world.cx.x),
        cxy: lanes.f32x8(s0.inv_inertia_world.cx.y, s1.inv_inertia_world.cx.y, s2.inv_inertia_world.cx.y, s3.inv_inertia_world.cx.y, s4.inv_inertia_world.cx.y, s5.inv_inertia_world.cx.y, s6.inv_inertia_world.cx.y, s7.inv_inertia_world.cx.y),
        cxz: lanes.f32x8(s0.inv_inertia_world.cx.z, s1.inv_inertia_world.cx.z, s2.inv_inertia_world.cx.z, s3.inv_inertia_world.cx.z, s4.inv_inertia_world.cx.z, s5.inv_inertia_world.cx.z, s6.inv_inertia_world.cx.z, s7.inv_inertia_world.cx.z),
        cyy: lanes.f32x8(s0.inv_inertia_world.cy.y, s1.inv_inertia_world.cy.y, s2.inv_inertia_world.cy.y, s3.inv_inertia_world.cy.y, s4.inv_inertia_world.cy.y, s5.inv_inertia_world.cy.y, s6.inv_inertia_world.cy.y, s7.inv_inertia_world.cy.y),
        cyz: lanes.f32x8(s0.inv_inertia_world.cy.z, s1.inv_inertia_world.cy.z, s2.inv_inertia_world.cy.z, s3.inv_inertia_world.cy.z, s4.inv_inertia_world.cy.z, s5.inv_inertia_world.cy.z, s6.inv_inertia_world.cy.z, s7.inv_inertia_world.cy.z),
        czz: lanes.f32x8(s0.inv_inertia_world.cz.z, s1.inv_inertia_world.cz.z, s2.inv_inertia_world.cz.z, s3.inv_inertia_world.cz.z, s4.inv_inertia_world.cz.z, s5.inv_inertia_world.cz.z, s6.inv_inertia_world.cz.z, s7.inv_inertia_world.cz.z)
    }
}

gather_vec3(a: Vec3, b: Vec3, c: Vec3, d: Vec3, e: Vec3, f: Vec3, g: Vec3, h: Vec3) -> Vec3W {
    return Vec3W { x: f8(a.x, b.x, c.x, d.x, e.x, f.x, g.x, h.x),
                   y: f8(a.y, b.y, c.y, d.y, e.y, f.y, g.y, h.y),
                   z: f8(a.z, b.z, c.z, d.z, e.z, f.z, g.z, h.z) }
}

// The manifolds' single-precision vectors, eight into lanes as they are.
gather_vec3f(a: Vec3f, b: Vec3f, c: Vec3f, d: Vec3f, e: Vec3f, f: Vec3f, g: Vec3f, h: Vec3f) -> Vec3W {
    return Vec3W { x: lanes.f32x8(a.x, b.x, c.x, d.x, e.x, f.x, g.x, h.x),
                   y: lanes.f32x8(a.y, b.y, c.y, d.y, e.y, f.y, g.y, h.y),
                   z: lanes.f32x8(a.z, b.z, c.z, d.z, e.z, f.z, g.z, h.z) }
}

add_sym_w(a: SymMatrix3W, b: SymMatrix3W) -> SymMatrix3W {
    return SymMatrix3W { cxx: add_w(a.cxx, b.cxx), cxy: add_w(a.cxy, b.cxy), cxz: add_w(a.cxz, b.cxz),
                         cyy: add_w(a.cyy, b.cyy), cyz: add_w(a.cyz, b.cyz), czz: add_w(a.czz, b.czz) }
}

// The inverse of a symmetric matrix by its cofactors, zero where singular (b3InvertSymW).
invert_sym_w(m: SymMatrix3W) -> SymMatrix3W {
    cxx = sub_w(mul_w(m.cyy, m.czz), mul_w(m.cyz, m.cyz))
    cxy = sub_w(mul_w(m.cxz, m.cyz), mul_w(m.cxy, m.czz))
    cxz = sub_w(mul_w(m.cxy, m.cyz), mul_w(m.cxz, m.cyy))
    cyy = sub_w(mul_w(m.cxx, m.czz), mul_w(m.cxz, m.cxz))
    cyz = sub_w(mul_w(m.cxy, m.cxz), mul_w(m.cxx, m.cyz))
    czz = sub_w(mul_w(m.cxx, m.cyy), mul_w(m.cxy, m.cxy))
    det = add_w(mul_w(m.cxx, cxx), add_w(mul_w(m.cxy, cxy), mul_w(m.cxz, cxz)))
    valid = greater_w(lanes.abs8(det), splat_w(1000.0 * math.TINY_F32))
    inv_det = blend_w(zero_w(), div_w(splat_w(1.0), det), valid)
    return SymMatrix3W { cxx: mul_w(inv_det, cxx), cxy: mul_w(inv_det, cxy), cxz: mul_w(inv_det, cxz),
                         cyy: mul_w(inv_det, cyy), cyz: mul_w(inv_det, cyz), czz: mul_w(inv_det, czz) }
}

// A unit vector perpendicular to each lane's, math.perp's choice per
// lane; zero for a zero lane (b3PerpW).
perp_w(a: Vec3W) -> Vec3W {
    zero = zero_w()
    half = splat_w(0.5)
    mask = or_w(greater_w(neg_w(half), a.x), greater_w(a.x, half))
    p = Vec3W { x: blend_w(zero, a.y, mask), y: blend_w(a.z, neg_w(a.x), mask), z: blend_w(neg_w(a.y), zero, mask) }
    length_squared = dot_w(p, p)
    valid = greater_w(length_squared, splat_w(1000.0 * math.TINY_F32))
    s = blend_w(zero, div_w(splat_w(1.0), lanes.sqrt8(length_squared)), valid)
    return mul_sv_w(s, p)
}

// One manifold point of the eight lanes' manifolds.
gather_point(m0: *Manifold, m1: *Manifold, m2: *Manifold, m3: *Manifold, m4: *Manifold, m5: *Manifold, m6: *Manifold, m7: *Manifold, index: int) -> WideConstraintPoint {
    p0 = dynamics.manifold_point_at(m0, index)
    p1 = dynamics.manifold_point_at(m1, index)
    p2 = dynamics.manifold_point_at(m2, index)
    p3 = dynamics.manifold_point_at(m3, index)
    p4 = dynamics.manifold_point_at(m4, index)
    p5 = dynamics.manifold_point_at(m5, index)
    p6 = dynamics.manifold_point_at(m6, index)
    p7 = dynamics.manifold_point_at(m7, index)
    zero = zero_w()
    return WideConstraintPoint {
        anchor_a: gather_vec3f(p0.anchor_a, p1.anchor_a, p2.anchor_a, p3.anchor_a, p4.anchor_a, p5.anchor_a, p6.anchor_a, p7.anchor_a),
        anchor_b: gather_vec3f(p0.anchor_b, p1.anchor_b, p2.anchor_b, p3.anchor_b, p4.anchor_b, p5.anchor_b, p6.anchor_b, p7.anchor_b),
        base_separation: lanes.f32x8(p0.separation, p1.separation, p2.separation, p3.separation, p4.separation, p5.separation, p6.separation, p7.separation),
        normal_impulse: lanes.f32x8(p0.normal_impulse, p1.normal_impulse, p2.normal_impulse, p3.normal_impulse, p4.normal_impulse, p5.normal_impulse, p6.normal_impulse, p7.normal_impulse),
        total_normal_impulse: zero, normal_mass: zero, lever_arm: zero, relative_velocity: zero, restitution_impulse: zero
    }
}

blend_vec3_w(a: Vec3W, b: Vec3W, m: i32x8) -> Vec3W {
    return Vec3W { x: blend_w(a.x, b.x, m), y: blend_w(a.y, b.y, m), z: blend_w(a.z, b.z, m) }
}

// One slot's eight convex contacts gathered into lanes and prepared eight
// at a time (b3PrepareContacts_Convex): the contacts at `slot * WIDTH`
// on, a lane past `end` spare and zero throughout.
prepare_wide_slot(ctx: *StepContext, color: *GraphColor, slot: int, end: int) {
    c = wide_constraint_at(color.wide_constraints, slot)
    first = slot * WIDTH
    k0 = lane_contact(ctx, color, first, end)
    k1 = lane_contact(ctx, color, first + 1, end)
    k2 = lane_contact(ctx, color, first + 2, end)
    k3 = lane_contact(ctx, color, first + 3, end)
    k4 = lane_contact(ctx, color, first + 4, end)
    k5 = lane_contact(ctx, color, first + 5, end)
    k6 = lane_contact(ctx, color, first + 6, end)
    k7 = lane_contact(ctx, color, first + 7, end)
    c.manifolds = PtrW { l0: lane_manifold(k0) as ptr, l1: lane_manifold(k1) as ptr, l2: lane_manifold(k2) as ptr, l3: lane_manifold(k3) as ptr, l4: lane_manifold(k4) as ptr, l5: lane_manifold(k5) as ptr, l6: lane_manifold(k6) as ptr, l7: lane_manifold(k7) as ptr }
    m0 = gather_manifold(c.manifolds.l0 as *Manifold)
    m1 = gather_manifold(c.manifolds.l1 as *Manifold)
    m2 = gather_manifold(c.manifolds.l2 as *Manifold)
    m3 = gather_manifold(c.manifolds.l3 as *Manifold)
    m4 = gather_manifold(c.manifolds.l4 as *Manifold)
    m5 = gather_manifold(c.manifolds.l5 as *Manifold)
    m6 = gather_manifold(c.manifolds.l6 as *Manifold)
    m7 = gather_manifold(c.manifolds.l7 as *Manifold)
    c.index_a = IntW { l0: lane_index1(k0, k0.body_sim_index_a), l1: lane_index1(k1, k1.body_sim_index_a), l2: lane_index1(k2, k2.body_sim_index_a), l3: lane_index1(k3, k3.body_sim_index_a), l4: lane_index1(k4, k4.body_sim_index_a), l5: lane_index1(k5, k5.body_sim_index_a), l6: lane_index1(k6, k6.body_sim_index_a), l7: lane_index1(k7, k7.body_sim_index_a) }
    c.index_b = IntW { l0: lane_index1(k0, k0.body_sim_index_b), l1: lane_index1(k1, k1.body_sim_index_b), l2: lane_index1(k2, k2.body_sim_index_b), l3: lane_index1(k3, k3.body_sim_index_b), l4: lane_index1(k4, k4.body_sim_index_b), l5: lane_index1(k5, k5.body_sim_index_b), l6: lane_index1(k6, k6.body_sim_index_b), l7: lane_index1(k7, k7.body_sim_index_b) }
    c.point_counts = IntW { l0: m0.point_count, l1: m1.point_count, l2: m2.point_count, l3: m3.point_count, l4: m4.point_count, l5: m5.point_count, l6: m6.point_count, l7: m7.point_count }
    // The store reads this rather than go back out to the contacts.
    c.hit_lanes = hit_bit(k0, 0) | hit_bit(k1, 1) | hit_bit(k2, 2) | hit_bit(k3, 3) | hit_bit(k4, 4) | hit_bit(k5, 5) | hit_bit(k6, 6) | hit_bit(k7, 7)

    sa0 = lane_sim(ctx, c.index_a.l0)
    sa1 = lane_sim(ctx, c.index_a.l1)
    sa2 = lane_sim(ctx, c.index_a.l2)
    sa3 = lane_sim(ctx, c.index_a.l3)
    sa4 = lane_sim(ctx, c.index_a.l4)
    sa5 = lane_sim(ctx, c.index_a.l5)
    sa6 = lane_sim(ctx, c.index_a.l6)
    sa7 = lane_sim(ctx, c.index_a.l7)
    sb0 = lane_sim(ctx, c.index_b.l0)
    sb1 = lane_sim(ctx, c.index_b.l1)
    sb2 = lane_sim(ctx, c.index_b.l2)
    sb3 = lane_sim(ctx, c.index_b.l3)
    sb4 = lane_sim(ctx, c.index_b.l4)
    sb5 = lane_sim(ctx, c.index_b.l5)
    sb6 = lane_sim(ctx, c.index_b.l6)
    sb7 = lane_sim(ctx, c.index_b.l7)
    m_a = lanes.f32x8(sa0.inv_mass, sa1.inv_mass, sa2.inv_mass, sa3.inv_mass, sa4.inv_mass, sa5.inv_mass, sa6.inv_mass, sa7.inv_mass)
    m_b = lanes.f32x8(sb0.inv_mass, sb1.inv_mass, sb2.inv_mass, sb3.inv_mass, sb4.inv_mass, sb5.inv_mass, sb6.inv_mass, sb7.inv_mass)
    i_a = gather_inertia(sa0, sa1, sa2, sa3, sa4, sa5, sa6, sa7)
    i_b = gather_inertia(sb0, sb1, sb2, sb3, sb4, sb5, sb6, sb7)
    c.inv_mass_a = m_a
    c.inv_mass_b = m_b
    c.inv_inertia_a = i_a
    c.inv_inertia_b = i_b

    soft0 = lane_softness(ctx, c.index_a.l0, c.index_b.l0, sa0, sb0)
    soft1 = lane_softness(ctx, c.index_a.l1, c.index_b.l1, sa1, sb1)
    soft2 = lane_softness(ctx, c.index_a.l2, c.index_b.l2, sa2, sb2)
    soft3 = lane_softness(ctx, c.index_a.l3, c.index_b.l3, sa3, sb3)
    soft4 = lane_softness(ctx, c.index_a.l4, c.index_b.l4, sa4, sb4)
    soft5 = lane_softness(ctx, c.index_a.l5, c.index_b.l5, sa5, sb5)
    soft6 = lane_softness(ctx, c.index_a.l6, c.index_b.l6, sa6, sb6)
    soft7 = lane_softness(ctx, c.index_a.l7, c.index_b.l7, sa7, sb7)
    c.bias_rate = f8(soft0.bias_rate, soft1.bias_rate, soft2.bias_rate, soft3.bias_rate, soft4.bias_rate, soft5.bias_rate, soft6.bias_rate, soft7.bias_rate)
    c.mass_scale = f8(soft0.mass_scale, soft1.mass_scale, soft2.mass_scale, soft3.mass_scale, soft4.mass_scale, soft5.mass_scale, soft6.mass_scale, soft7.mass_scale)
    c.impulse_scale = f8(soft0.impulse_scale, soft1.impulse_scale, soft2.impulse_scale, soft3.impulse_scale, soft4.impulse_scale, soft5.impulse_scale, soft6.impulse_scale, soft7.impulse_scale)
    c.friction = lanes.f32x8(k0.friction, k1.friction, k2.friction, k3.friction, k4.friction, k5.friction, k6.friction, k7.friction)
    c.restitution = lanes.f32x8(k0.restitution, k1.restitution, k2.restitution, k3.restitution, k4.restitution, k5.restitution, k6.restitution, k7.restitution)
    c.rolling_resistance = lanes.f32x8(k0.rolling_resistance, k1.rolling_resistance, k2.rolling_resistance, k3.rolling_resistance, k4.rolling_resistance, k5.rolling_resistance, k6.rolling_resistance, k7.rolling_resistance)
    if all_zero_w(c.restitution) == false { contact_solver.note_restitution(ctx, 1.0) }

    zero = zero_w()
    one = splat_w(1.0)
    warm_start_scale = zero
    if ctx.enable_warm_starting { warm_start_scale = one }
    normal = gather_vec3f(m0.normal, m1.normal, m2.normal, m3.normal, m4.normal, m5.normal, m6.normal, m7.normal)
    tangent1 = perp_w(normal)
    tangent2 = cross_w(tangent1, normal)
    c.normal = normal
    c.tangent1 = tangent1
    c.tangent2 = tangent2
    tangent_velocity = gather_vec3f(k0.tangent_velocity, k1.tangent_velocity, k2.tangent_velocity, k3.tangent_velocity, k4.tangent_velocity, k5.tangent_velocity, k6.tangent_velocity, k7.tangent_velocity)
    c.tangent_velocity1 = dot_w(tangent_velocity, tangent1)
    c.tangent_velocity2 = dot_w(tangent_velocity, tangent2)
    friction_impulse = gather_vec3f(m0.friction_impulse, m1.friction_impulse, m2.friction_impulse, m3.friction_impulse, m4.friction_impulse, m5.friction_impulse, m6.friction_impulse, m7.friction_impulse)
    c.friction_impulse = Vec2W { x: mul_w(warm_start_scale, dot_w(friction_impulse, tangent1)),
                                 y: mul_w(warm_start_scale, dot_w(friction_impulse, tangent2)) }
    c.twist_impulse = mul_w(warm_start_scale, lanes.f32x8(m0.twist_impulse, m1.twist_impulse, m2.twist_impulse, m3.twist_impulse, m4.twist_impulse, m5.twist_impulse, m6.twist_impulse, m7.twist_impulse))
    c.rolling_impulse = mul_sv_w(warm_start_scale, gather_vec3f(m0.rolling_impulse, m1.rolling_impulse, m2.rolling_impulse, m3.rolling_impulse, m4.rolling_impulse, m5.rolling_impulse, m6.rolling_impulse, m7.rolling_impulse))

    inv_tau = splat_w(1.0 / dynamics.SPECULATIVE_DISTANCE)
    two = splat_w(2.0)
    min_weight = splat_w(contact_solver.MIN_FRICTION_WEIGHT)
    point_counts = f8(c.point_counts.l0 as float, c.point_counts.l1 as float, c.point_counts.l2 as float, c.point_counts.l3 as float, c.point_counts.l4 as float, c.point_counts.l5 as float, c.point_counts.l6 as float, c.point_counts.l7 as float)
    zero_v = Vec3W { x: zero, y: zero, z: zero }
    center_a = zero_v
    center_b = zero_v
    total_weight = zero
    point_index = 0
    while point_index < dynamics.MAX_MANIFOLD_POINTS {
        // A point the lane's manifold lacks is zero: nothing reaches the bodies through it.
        has_point = greater_w(point_counts, splat_w(point_index as float))
        g = gather_point(m0, m1, m2, m3, m4, m5, m6, m7, point_index)
        r_a = blend_vec3_w(zero_v, g.anchor_a, has_point)
        r_b = blend_vec3_w(zero_v, g.anchor_b, has_point)
        s = blend_w(zero, g.base_separation, has_point)
        // The friction centre decays with separation (the scalar prepare says why).
        weight = blend_w(zero, min_w(max_w(sub_w(two, mul_w(s, inv_tau)), min_weight), one), has_point)
        center_a = mul_add_sv_w(center_a, weight, r_a)
        center_b = mul_add_sv_w(center_b, weight, r_b)
        total_weight = add_w(total_weight, weight)
        cp = wide_point_at(c, point_index)
        cp.anchor_a = r_a
        cp.anchor_b = r_b
        cp.base_separation = sub_w(s, dot_w(sub_v_w(r_b, r_a), normal))
        cp.normal_impulse = mul_w(warm_start_scale, blend_w(zero, g.normal_impulse, has_point))
        cp.total_normal_impulse = zero
        cp.restitution_impulse = zero
        rn_a = cross_w(r_a, normal)
        rn_b = cross_w(r_b, normal)
        k_normal = add_w(add_w(add_w(m_a, m_b), dot_w(rn_a, mul_mv_w(i_a, rn_a))), dot_w(rn_b, mul_mv_w(i_b, rn_b)))
        valid = lanes.mask8_and(greater_w(k_normal, zero), has_point)
        cp.normal_mass = blend_w(zero, div_w(one, k_normal), valid)
        cp.relative_velocity = zero
        point_index = point_index + 1
    }
    // The normal velocity before the solve is for restitution and hit
    // events only (b3PrepareContacts_Convex): sampled, with the bodies'
    // velocities gathered for it, only when a lane has either; zero else,
    // as a manifold's normal velocity is without them.
    if c.hit_lanes != 0 || all_zero_w(c.restitution) == false {
        b_a = gather_bodies(ctx.states, &c.index_a)
        b_b = gather_bodies(ctx.states, &c.index_b)
        point_index = 0
        while point_index < dynamics.MAX_MANIFOLD_POINTS {
            cp = wide_point_at(c, point_index)
            has_point = greater_w(point_counts, splat_w(point_index as float))
            vr_a = add_v_w(b_a.v, cross_w(b_a.w, cp.anchor_a))
            vr_b = add_v_w(b_b.v, cross_w(b_b.w, cp.anchor_b))
            cp.relative_velocity = blend_w(zero, dot_w(normal, sub_v_w(vr_b, vr_a)), has_point)
            point_index = point_index + 1
        }
    }
    inv_weight = blend_w(zero, div_w(one, total_weight), greater_w(total_weight, zero))
    center_a = mul_sv_w(inv_weight, center_a)
    center_b = mul_sv_w(inv_weight, center_b)
    c.center_a = center_a
    c.center_b = center_b
    point_index = 0
    while point_index < dynamics.MAX_MANIFOLD_POINTS {
        cp = wide_point_at(c, point_index)
        has_point = greater_w(point_counts, splat_w(point_index as float))
        d = sub_v_w(cp.anchor_a, center_a)
        cp.lever_arm = blend_w(zero, lanes.sqrt8(dot_w(d, d)), has_point)
        point_index = point_index + 1
    }

    rt_a1 = cross_w(center_a, tangent1)
    rt_a2 = cross_w(center_a, tangent2)
    rt_b1 = cross_w(center_b, tangent1)
    rt_b2 = cross_w(center_b, tangent2)
    i_rt_a1 = mul_mv_w(i_a, rt_a1)
    i_rt_a2 = mul_mv_w(i_a, rt_a2)
    i_rt_b1 = mul_mv_w(i_b, rt_b1)
    i_rt_b2 = mul_mv_w(i_b, rt_b2)
    kxx = add_w(add_w(add_w(m_a, m_b), dot_w(rt_a1, i_rt_a1)), dot_w(rt_b1, i_rt_b1))
    kyy = add_w(add_w(add_w(m_a, m_b), dot_w(rt_a2, i_rt_a2)), dot_w(rt_b2, i_rt_b2))
    kxy = add_w(dot_w(rt_a1, i_rt_a2), dot_w(rt_b1, i_rt_b2))
    det = sub_w(mul_w(kxx, kyy), mul_w(kxy, kxy))
    inv_det = blend_w(zero, div_w(one, det), greater_w(lanes.abs8(det), splat_w(1000.0 * math.TINY_F32)))
    c.tangent_mass = SymMatrix2W { cxx: mul_w(inv_det, kyy), cxy: neg_w(mul_w(inv_det, kxy)), cyy: mul_w(inv_det, kxx) }

    i_ab = add_sym_w(i_a, i_b)
    k_twist = dot_w(normal, mul_mv_w(i_ab, normal))
    c.twist_mass = blend_w(zero, div_w(one, k_twist), greater_w(k_twist, zero))
    // The solve reads the rolling mass only where there is rolling resistance.
    if all_zero_w(c.rolling_resistance) {
        c.rolling_mass = SymMatrix3W { cxx: zero, cxy: zero, cxz: zero, cyy: zero, cyz: zero, czz: zero }
    } else {
        c.rolling_mass = invert_sym_w(i_ab)
    }
}

// A colour's convex contacts into its wide constraints, eight to a slot
// in the order of the colour's array.
prepare_wide_contacts(ctx: *StepContext, color: *GraphColor) {
    prepare_wide_range(ctx, color, 0, color.convex_contacts.count)
}

// A block [start, end) of a colour's convex contacts into their slots:
// `start` begins a slot, and `end` ends one or is the colour's count.
prepare_wide_range(ctx: *StepContext, color: *GraphColor, start: int, end: int) {
    w = ctx.world
    i = start
    while i < end {
        // The slots to come: the contacts two ahead, the manifolds one ahead.
        j = i + 2 * WIDTH
        while j < end && j < i + 3 * WIDTH {
            native.prefetch(dynamics.contact_at(w, basics.ints_get(&color.convex_contacts, j)) as ptr)
            j = j + 1
        }
        j = i + WIDTH
        while j < end && j < i + 2 * WIDTH {
            native.prefetch(dynamics.contact_at(w, basics.ints_get(&color.convex_contacts, j)).manifolds)
            j = j + 1
        }
        prepare_wide_slot(ctx, color, i / WIDTH, end)
        i = i + WIDTH
    }
}

// Before any block runs: the zero record a spare lane gathers from made,
// so no worker races to make it. (A slot writes every lane, spare ones
// included, so there is no tail to clear.)
zero_wide_tail(color: *GraphColor) {
    if color.convex_contacts.count > 0 { zero_record() }
}

// Last step's impulses applied before solving (b3WarmStartContacts_Convex).
warm_start_wide_contacts(ctx: *StepContext, constraints: ptr, count: int) {
    states = ctx.states
    index = 0
    while index < count {
        c = wide_constraint_at(constraints, index)
        b_a = gather_bodies(states, &c.index_a)
        b_b = gather_bodies(states, &c.index_b)
        point_count = max_point_count(c)
        // The impulses summed first and applied once a body (Box3D 79fc559):
        // the normal impulses' total and moments, then one linear and one
        // angular impulse each, the friction, twist and rolling folded in.
        zero = zero_w()
        total_normal_impulse = zero
        moment_a = Vec3W { x: zero, y: zero, z: zero }
        moment_b = moment_a
        j = 0
        while j < point_count {
            cp = wide_point_at(c, j)
            total_normal_impulse = add_w(total_normal_impulse, cp.normal_impulse)
            moment_a = mul_add_sv_w(moment_a, cp.normal_impulse, cp.anchor_a)
            moment_b = mul_add_sv_w(moment_b, cp.normal_impulse, cp.anchor_b)
            j = j + 1
        }
        normal = c.normal
        friction = mul_add_sv_w(mul_sv_w(c.friction_impulse.x, c.tangent1), c.friction_impulse.y, c.tangent2)
        linear = mul_add_sv_w(friction, total_normal_impulse, normal)
        twist = mul_sv_w(c.twist_impulse, normal)
        angular_a = add_v_w(add_v_w(cross_w(moment_a, normal), cross_w(c.center_a, friction)), twist)
        angular_b = add_v_w(add_v_w(cross_w(moment_b, normal), cross_w(c.center_b, friction)), twist)
        if all_zero_w(c.rolling_resistance) == false {
            angular_a = add_v_w(angular_a, c.rolling_impulse)
            angular_b = add_v_w(angular_b, c.rolling_impulse)
        }
        b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, angular_a)
        b_a.v = mul_sub_sv_w(b_a.v, c.inv_mass_a, linear)
        b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, angular_b)
        b_b.v = mul_add_sv_w(b_b.v, c.inv_mass_b, linear)
        scatter_bodies(states, &c.index_a, &b_a)
        scatter_bodies(states, &c.index_b, &b_b)
        index = index + 1
    }
}

// One sequential impulse pass over eight contacts at a time
// (b3SolveContacts_Convex): the scalar solve's steps with the branches
// as masks: a lane apart gets the speculative bias, a lane penetrating
// the soft constraint's when biased; then, without bias only, the
// rolling resistance, twist friction and central friction.
solve_wide_contacts(ctx: *StepContext, constraints: ptr, count: int, use_bias: bool) {
    states = ctx.states
    inv_h = splat_w(ctx.inv_h)
    contact_speed = splat_w(0.0 - ctx.world.contact_speed)
    one = splat_w(1.0)
    zero = zero_w()
    epsilon = splat_w(math.EPSILON)
    index = 0
    while index < count {
        c = wide_constraint_at(constraints, index)
        point_count = max_point_count(c)
        b_a = gather_bodies(states, &c.index_a)
        b_b = gather_bodies(states, &c.index_b)
        bias_rate = zero
        mass_scale = one
        impulse_scale = zero
        if use_bias {
            bias_rate = mul_w(c.mass_scale, c.bias_rate)
            mass_scale = c.mass_scale
            impulse_scale = c.impulse_scale
        }
        dp = sub_v_w(b_b.dp, b_a.dp)
        total_normal_impulse = zero
        total_twist_limit = zero
        point_index = 0
        while point_index < point_count {
            cp = wide_point_at(c, point_index)
            r_a = cp.anchor_a
            r_b = cp.anchor_b
            // The anchors turned with the bodies give the current separation.
            rs_a = rotate_vector_w(b_a.dq, r_a)
            rs_b = rotate_vector_w(b_b.dq, r_b)
            ds = add_v_w(dp, sub_v_w(rs_b, rs_a))
            s = add_w(dot_w(c.normal, ds), cp.base_separation)
            apart = greater_w(s, zero)
            spec_bias = mul_w(s, inv_h)
            soft_bias = max_w(mul_w(bias_rate, s), contact_speed)
            bias = blend_w(soft_bias, spec_bias, apart)
            point_mass_scale = blend_w(mass_scale, one, apart)
            point_impulse_scale = blend_w(impulse_scale, zero, apart)
            vr_a = add_v_w(b_a.v, cross_w(b_a.w, r_a))
            vr_b = add_v_w(b_b.v, cross_w(b_b.w, r_b))
            vn = dot_w(sub_v_w(vr_b, vr_a), c.normal)
            neg_impulse = add_w(mul_w(cp.normal_mass, add_w(mul_w(point_mass_scale, vn), bias)), mul_w(point_impulse_scale, cp.normal_impulse))
            new_impulse = max_w(sub_w(cp.normal_impulse, neg_impulse), zero)
            delta_impulse = sub_w(new_impulse, cp.normal_impulse)
            cp.normal_impulse = new_impulse
            // The pushing pass is not counted: the total is what the relaxed
            // passes and restitution applied (Box3D's push/solve).
            if use_bias == false { cp.total_normal_impulse = add_w(cp.total_normal_impulse, new_impulse) }
            total_normal_impulse = add_w(total_normal_impulse, new_impulse)
            total_twist_limit = add_w(total_twist_limit, mul_w(cp.lever_arm, new_impulse))
            p = mul_sv_w(delta_impulse, c.normal)
            b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, cross_w(r_a, p))
            b_a.v = mul_sub_sv_w(b_a.v, c.inv_mass_a, p)
            b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, cross_w(r_b, p))
            b_b.v = mul_add_sv_w(b_b.v, c.inv_mass_b, p)
            point_index = point_index + 1
        }
        if use_bias == false {
            // Rolling resistance, when any lane has it.
            if all_zero_w(c.rolling_resistance) == false {
                delta_rolling = mul_mv_w(c.rolling_mass, sub_v_w(b_a.w, b_b.w))
                old_rolling = c.rolling_impulse
                c.rolling_impulse = add_v_w(old_rolling, delta_rolling)
                max_rolling = mul_w(c.rolling_resistance, total_normal_impulse)
                length_squared = dot_w(c.rolling_impulse, c.rolling_impulse)
                over = greater_w(length_squared, mul_add_w(epsilon, max_rolling, max_rolling))
                normalize = div_w(max_rolling, add_w(sqrt_w(length_squared), epsilon))
                scale = blend_w(one, normalize, over)
                // A lane without rolling resistance keeps no impulse.
                scale = blend_w(zero, scale, greater_w(c.rolling_resistance, zero))
                c.rolling_impulse = mul_sv_w(scale, c.rolling_impulse)
                delta_rolling = sub_v_w(c.rolling_impulse, old_rolling)
                b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, delta_rolling)
                b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, delta_rolling)
            }
            // Central twist friction.
            twist_speed = dot_w(c.normal, sub_v_w(b_b.w, b_a.w))
            max_twist = mul_w(c.friction, total_twist_limit)
            old_twist = c.twist_impulse
            c.twist_impulse = sym_clamp_w(sub_w(old_twist, mul_w(c.twist_mass, twist_speed)), max_twist)
            delta_twist = sub_w(c.twist_impulse, old_twist)
            twist = mul_sv_w(delta_twist, c.normal)
            b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, twist)
            b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, twist)
            // Central friction.
            c_a = c.center_a
            c_b = c.center_b
            vr_a = add_v_w(b_a.v, cross_w(b_a.w, c_a))
            vr_b = add_v_w(b_b.v, cross_w(b_b.w, c_b))
            vr = sub_v_w(vr_b, vr_a)
            vt = Vec2W { x: sub_w(dot_w(vr, c.tangent1), c.tangent_velocity1), y: sub_w(dot_w(vr, c.tangent2), c.tangent_velocity2) }
            tm = mul_mv2_w(c.tangent_mass, vt)
            new_friction = Vec2W { x: sub_w(c.friction_impulse.x, tm.x), y: sub_w(c.friction_impulse.y, tm.y) }
            max_friction = mul_w(c.friction, total_normal_impulse)
            length_squared = add_w(mul_w(new_friction.x, new_friction.x), mul_w(new_friction.y, new_friction.y))
            over = greater_w(length_squared, mul_w(max_friction, max_friction))
            normalize = div_w(max_friction, add_w(sqrt_w(length_squared), epsilon))
            scale = blend_w(one, normalize, over)
            new_friction = Vec2W { x: mul_w(scale, new_friction.x), y: mul_w(scale, new_friction.y) }
            delta_friction = Vec2W { x: sub_w(new_friction.x, c.friction_impulse.x), y: sub_w(new_friction.y, c.friction_impulse.y) }
            c.friction_impulse = new_friction
            p = add_v_w(mul_sv_w(delta_friction.x, c.tangent1), mul_sv_w(delta_friction.y, c.tangent2))
            b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, cross_w(c_a, p))
            b_a.v = mul_sub_sv_w(b_a.v, c.inv_mass_a, p)
            b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, cross_w(c_b, p))
            b_b.v = mul_add_sv_w(b_b.v, c.inv_mass_b, p)
        }
        scatter_bodies(states, &c.index_a, &b_a)
        scatter_bodies(states, &c.index_b, &b_b)
        index = index + 1
    }
}

// The bounce (b3ApplyRestitution_Convex, Box3D main), eight contacts at a
// time: one pass of the world's restitution iterations, the scalar
// apply_restitution's rule per lane. With propagation off, a slot with no
// restitution in any lane is skipped and a lane without restitution gets
// no impulse; with it on, every lane keeps its contact from closing.
apply_wide_restitution(ctx: *StepContext, constraints: ptr, count: int) {
    states = ctx.states
    inv_h = splat_w(ctx.inv_h)
    neg_threshold = splat_w(0.0 - ctx.restitution_threshold)
    zero = zero_w()
    propagate = ctx.world.enable_restitution_propagation
    index = 0
    while index < count {
        c = wide_constraint_at(constraints, index)
        if propagate || all_zero_w(c.restitution) == false {
            point_count = max_point_count(c)
            b_a = gather_bodies(states, &c.index_a)
            b_b = gather_bodies(states, &c.index_b)
            has_restitution = greater_w(c.restitution, zero)
            dp = sub_v_w(b_b.dp, b_a.dp)
            point_index = 0
            while point_index < point_count {
                cp = wide_point_at(c, point_index)
                r_a = cp.anchor_a
                r_b = cp.anchor_b
                normal_mass = cp.normal_mass
                if propagate == false { normal_mass = blend_w(zero, cp.normal_mass, has_restitution) }
                compression = sub_w(cp.total_normal_impulse, cp.restitution_impulse)
                armed = lanes.mask8_and(lanes.mask8_and(has_restitution, greater_w(neg_threshold, cp.relative_velocity)), greater_w(compression, zero))
                ds = add_v_w(dp, sub_v_w(rotate_vector_w(b_b.dq, r_b), rotate_vector_w(b_a.dq, r_a)))
                s = add_w(dot_w(c.normal, ds), cp.base_separation)
                spec_bias = max_w(zero, mul_w(s, inv_h))
                velocity_bias = blend_w(spec_bias, mul_w(c.restitution, cp.relative_velocity), armed)
                vr_a = add_v_w(b_a.v, cross_w(b_a.w, r_a))
                vr_b = add_v_w(b_b.v, cross_w(b_b.w, r_b))
                vn = dot_w(sub_v_w(vr_b, vr_a), c.normal)
                neg_impulse = mul_w(normal_mass, add_w(vn, velocity_bias))
                new_impulse = max_w(sub_w(cp.normal_impulse, neg_impulse), zero)
                impulse = sub_w(new_impulse, cp.normal_impulse)
                approach = min_w(max_w(neg_w(mul_w(normal_mass, vn)), zero), max_w(impulse, zero))
                // Poisson's kinetic restitution: no energy gained.
                allowance = sub_w(mul_w(c.restitution, add_w(compression, approach)), cp.restitution_impulse)
                impulse = blend_w(impulse, min_w(impulse, add_w(approach, max_w(allowance, zero))), armed)
                cp.normal_impulse = add_w(cp.normal_impulse, impulse)
                cp.restitution_impulse = add_w(cp.restitution_impulse, sub_w(impulse, approach))
                cp.total_normal_impulse = add_w(cp.total_normal_impulse, impulse)
                p = mul_sv_w(impulse, c.normal)
                b_a.w = mul_sub_mv_w(b_a.w, c.inv_inertia_a, cross_w(r_a, p))
                b_a.v = mul_sub_sv_w(b_a.v, c.inv_mass_a, p)
                b_b.w = mul_add_mv_w(b_b.w, c.inv_inertia_b, cross_w(r_b, p))
                b_b.v = mul_add_sv_w(b_b.v, c.inv_mass_b, p)
                point_index = point_index + 1
            }
            scatter_bodies(states, &c.index_a, &b_a)
            scatter_bodies(states, &c.index_b, &b_b)
        }
        index = index + 1
    }
}

// The impulses back into the lanes' manifolds (b3StoreImpulses_Convex)
// for next step's warm start and the user's queries; a contact that
// wants hit events and closed faster than the threshold with an impulse
// sets its bit. Whether any did.
store_wide_impulses(ctx: *StepContext, color: *GraphColor, hit_bits: *BitSet) -> bool {
    return store_wide_range(ctx, color, 0, color.convex_contacts.count, hit_bits)
}

store_wide_range(ctx: *StepContext, color: *GraphColor, start: int, end: int, hit_bits: *BitSet) -> bool {
    w = ctx.world
    has_hits = false
    neg_threshold = 0.0 - w.hit_event_threshold
    i = start
    while i < end {
        c = wide_constraint_at(color.wide_constraints, i / WIDTH)
        l = i % WIDTH
        // The next slot's manifolds, which nothing has touched since the
        // collide pass, fetched while this slot's are written.
        if l == 0 && i + WIDTH < end {
            next = wide_constraint_at(color.wide_constraints, i / WIDTH + 1)
            native.prefetch(next.manifolds.l0)
            native.prefetch(next.manifolds.l1)
            native.prefetch(next.manifolds.l2)
            native.prefetch(next.manifolds.l3)
            native.prefetch(next.manifolds.l4)
            native.prefetch(next.manifolds.l5)
            native.prefetch(next.manifolds.l6)
            native.prefetch(next.manifolds.l7)
        }
        m = ptr_lane(&c.manifolds, l) as *Manifold
        f1 = lane(c.friction_impulse.x, l)
        f2 = lane(c.friction_impulse.y, l)
        m.friction_impulse = math.narrow3(math.vec3(f1 * lane(c.tangent1.x, l) + f2 * lane(c.tangent2.x, l),
                                       f1 * lane(c.tangent1.y, l) + f2 * lane(c.tangent2.y, l),
                                       f1 * lane(c.tangent1.z, l) + f2 * lane(c.tangent2.z, l)))
        m.twist_impulse = lane(c.twist_impulse, l)
        m.rolling_impulse = Vec3f { x: lanes.lane8(c.rolling_impulse.x, l as long), y: lanes.lane8(c.rolling_impulse.y, l as long), z: lanes.lane8(c.rolling_impulse.z, l as long) }
        point_count = m.point_count
        point_index = 0
        while point_index < point_count {
            cp = wide_point_at(c, point_index)
            mp = dynamics.manifold_point_at(m, point_index)
            mp.normal_impulse = lane(cp.normal_impulse, l)
            mp.total_normal_impulse = lane(cp.total_normal_impulse, l)
            mp.normal_velocity = lane(cp.relative_velocity, l)
            point_index = point_index + 1
        }
        if (c.hit_lanes & (1 << l)) != 0 {
            point_index = 0
            while point_index < point_count {
                mp = dynamics.manifold_point_at(m, point_index)
                if mp.normal_velocity < neg_threshold && mp.total_normal_impulse > 0.0 {
                    contact = dynamics.contact_at(w, basics.ints_get(&color.convex_contacts, i))
                    basics.bitset_set_grow(hit_bits, contact.contact_id)
                    has_hits = true
                    break
                }
                point_index = point_index + 1
            }
        }
        i = i + 1
    }
    return has_hits
}
