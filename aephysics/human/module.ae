// aephysics.human -- a ragdoll: twelve bones (pelvis, two spine
// segments, the neck with the head, thighs, calves with their feet,
// upper and lower arms) as capsules on dynamic bodies, joined by
// spherical joints with cone and twist limits (the spine, neck,
// shoulders, hips) and revolute joints with angle limits (the elbows,
// the knees), each with a spring toward its reference pose and a motor
// whose torque limit acts as joint friction; filter joints keep the
// thighs from each other and the head from the shoulders. The bones'
// reference frames and joint frames are the reference's, measured from
// its rigged figure -- or a rig's: human_fit_shape puts the reference's
// joints at a rig's and its lines along the rig's, so a figure whose
// spine curves is built curved, standing in its bind pose. Its joints
// move as a person's do (human_anatomical_limits: shoulders that reach
// overhead, hips that kneel, knees and elbows that never bend past
// straight) unless human_tight_limits puts back the reference's, and its
// soles grip the ground.
//
// Past the reference's twelve, each optional as the ankles are (#152,
// #190): a head on its own body above the neck, clavicles between the
// chest and the upper arms, hands below the forearms, a spine_02 between
// the two spine bodies, and elbows and knees that twist about the bone
// as they bend. Each is a flag on Human, set before the figure is made;
// left off, the figure is built as before, bit for bit.
//
// This is Box3D's shared/human.c (Erin Catto, MIT): CreateHuman is
// create_human, Human_SetJointFrictionTorque is
// set_joint_friction_torque. Beyond the reference's sample it is the
// ground for an active ragdoll: the springs and motors are the pose
// drive, the anchors (a kinematic body per bone through a motor or
// parallel joint) are the pose target, and the torque limits are the
// muscle budget; design.md's research note says what comes next.
import std.string
import aephysics.math
import aephysics.basics
import aephysics.manifold
import aephysics.material
import aephysics.shape
import aephysics.dynamics
import aephysics.joint_solver

exports (
    BONE_PELVIS, BONE_SPINE_01, BONE_SPINE_03, BONE_NECK, BONE_THIGH_L, BONE_CALF_L, BONE_THIGH_R, BONE_CALF_R,
    BONE_UPPER_ARM_L, BONE_LOWER_ARM_L, BONE_UPPER_ARM_R, BONE_LOWER_ARM_R, BONE_COUNT, FILTER_JOINT_COUNT,
    BONE_FOOT_L, BONE_FOOT_R, MAX_BONE_COUNT, ANKLE_PLANTAR_DEGREES, ANKLE_DORSAL_DEGREES, ANKLE_SIDE_DEGREES, ANKLE_ROLL_DEGREES,
    BONE_HEAD, BONE_CLAVICLE_L, BONE_CLAVICLE_R, BONE_HAND_L, BONE_HAND_R, BONE_SPINE_02, ANKLED_BONE_COUNT, MAX_FILTER_JOINT_COUNT,
    HEAD_FLEXION_DEGREES, HEAD_EXTENSION_DEGREES, HEAD_TILT_DEGREES, HEAD_TURN_DEGREES,
    CLAVICLE_ELEVATION_DEGREES, CLAVICLE_DEPRESSION_DEGREES, CLAVICLE_PROTRACTION_DEGREES, CLAVICLE_ROTATION_DEGREES,
    WRIST_FLEXION_DEGREES, WRIST_EXTENSION_DEGREES, WRIST_DEVIATION_DEGREES, WRIST_TWIST_DEGREES,
    ELBOW_TWIST_DEGREES, KNEE_TWIST_DEGREES, SHOULDER_INTERNAL_ROTATION, SHOULDER_EXTERNAL_ROTATION, HIP_INTERNAL_ROTATION, HIP_EXTERNAL_ROTATION,
    HumanBone, Human, BoneSpec, bone_at, filter_joint_at, spec_at,
    human_reference_shape, human_anatomical_limits, human_tight_limits, human_chain_child, human_shape_head, human_shape_tail, human_shape_toe, human_fit_shape, destroy_shape, create_human_shaped,
    human_fit_bone, human_fit_hinge_axis, human_has_bone, human_bone_far_end,
    create_human, destroy_human, human_set_velocity, human_apply_angular_impulse, human_set_joint_friction_torque,
    human_set_joint_spring_hertz, human_set_joint_damping_ratio, human_align_spring, human_release_align_spring, human_create_motor_anchors,
    human_create_parallel_anchors, human_destroy_anchors, human_has_anchors, human_set_anchor_target, human_set_bullet
)

extern sin(x: float) -> float
extern cos(x: float) -> float

const BONE_PELVIS = 0
const BONE_SPINE_01 = 1
const BONE_SPINE_03 = 2
const BONE_NECK = 3
const BONE_THIGH_L = 4
const BONE_CALF_L = 5
const BONE_THIGH_R = 6
const BONE_CALF_R = 7
const BONE_UPPER_ARM_L = 8
const BONE_LOWER_ARM_L = 9
const BONE_UPPER_ARM_R = 10
const BONE_LOWER_ARM_R = 11
const BONE_COUNT = 12
const FILTER_JOINT_COUNT = 3
// With ankles (#152, past the reference, whose figure has no foot bodies)
// the feet are bones of their own after the twelve, each on a joint below
// its calf; without, the reference's twelve, the foot a shape on the calf.
const BONE_FOOT_L = 12
const BONE_FOOT_R = 13
const ANKLED_BONE_COUNT = 14
// The bones past the reference's figure and its feet (#190), at fixed
// indices: a figure with any of them has MAX_BONE_COUNT bones, and those
// it was not given (the feet too, without ankles) have no body: see
// human_has_bone. MAX_BONE_COUNT is the most bones a figure has.
const BONE_HEAD = 14
const BONE_CLAVICLE_L = 15
const BONE_CLAVICLE_R = 16
const BONE_HAND_L = 17
const BONE_HAND_R = 18
const BONE_SPINE_02 = 19
const MAX_BONE_COUNT = 20
// The reference's three filter joints, and room for the ones the extra
// bones bring: the head off the chest, the clavicles and the upper arms,
// the clavicles off each other and the neck, and each bone off the one
// it no longer hangs from or that it was set between (the upper arms off
// the chest, the chest off the lumbar, spine_02 off the pelvis).
const MAX_FILTER_JOINT_COUNT = 15
// A person's ranges for the extra joints, in degrees. The head nods
// forward and back and tilts to the side on the neck, beyond what the
// neck's own joint gives, and turns on it (the atlas): with the neck's
// cone of 30 and twist of 17.5, the cervical spine's 55 / 65 / 50 / 77.
const HEAD_FLEXION_DEGREES = 25.0
const HEAD_EXTENSION_DEGREES = 35.0
const HEAD_TILT_DEGREES = 20.0
const HEAD_TURN_DEGREES = 60.0
// The shoulder girdle: the clavicle lifts 40 and drops 10, swings 20
// forward and back (protraction, retraction) and turns 20 about itself.
const CLAVICLE_ELEVATION_DEGREES = 40.0
const CLAVICLE_DEPRESSION_DEGREES = 10.0
const CLAVICLE_PROTRACTION_DEGREES = 20.0
const CLAVICLE_ROTATION_DEGREES = 20.0
// A clavicle body's density against the default: the girdle's mass.
const CLAVICLE_DENSITY = 2.0
// The wrist: 75 toward the palm, 65 back, 27.5 to either side between the
// radial 20 and ulnar 35, and little turn of its own (the forearm turns).
const WRIST_FLEXION_DEGREES = 75.0
const WRIST_EXTENSION_DEGREES = 65.0
const WRIST_DEVIATION_DEGREES = 27.5
const WRIST_TWIST_DEGREES = 10.0
// A twisting hinge (#190): the forearm turns 80 either way about itself
// (pronation, supination), the shin 10 (the knee's axial turn); either
// bends as its hinge did, and neither bends sideways.
const ELBOW_TWIST_DEGREES = 80.0
const KNEE_TWIST_DEGREES = 10.0
// The ankle's range, a loaded one's: the toes down 50 degrees and up 35 (an
// elliptical cone about a centre tipped toward the toes), 15 to either
// side, and the sole rolled 15 either way about the foot's line.
const ANKLE_PLANTAR_DEGREES = 50.0
const ANKLE_DORSAL_DEGREES = 35.0
const ANKLE_SIDE_DEGREES = 15.0
const ANKLE_ROLL_DEGREES = 15.0
const ANKLE_FRICTION = 0.6

// One bone: its body, the joint to its parent, the anchor a pose drive
// hangs it from, the joint's frames on parent and bone, the bone's
// frame in the reference pose, and the joint's limits and friction.
// Its own capsule (the shin's on a calf, which carries the foot too:
// a body lists its shapes newest first, so the first it lists is the
// foot) and the foot's, a null id on every other bone. With ankles a
// calf carries only its shin, and the shin stops at the ankle (#174).
struct HumanBone {
    body_id: BodyId
    joint_id: JointId
    anchor_id: BodyId
    anchor_joint_id: JointId
    local_frame_a: Transform
    local_frame_b: Transform
    reference_frame: Transform
    joint_kind: int                // dynamics.JOINT_SPHERICAL or JOINT_REVOLUTE; PARALLEL for none
    swing_limit: float             // the spherical cone
    twist_limit: Vec2              // the twist's or the hinge's angles
    joint_friction: float          // this joint's share of the friction torque
    parent_index: int
    shape_id: ShapeId              // the bone's own capsule
    foot_shape_id: ShapeId         // a calf's foot; null on the rest
    cone_axis: Vec3                // the cone's centre in local_frame_a
    swing_minor_limit: float       // an elliptical cone's half angle across cone_major_axis; 0 for a circle
    cone_major_axis: Vec3          // in local_frame_a
}

// The ragdoll: a heap block of bones and filter joints (create allocates,
// destroy frees). The flags, set before it is made, add bones past the
// reference's figure of BONE_COUNT: `ankles` the feet (bone_count
// ANKLED_BONE_COUNT); `head`, `clavicles`, `hands` and `spine_02` those
// bones (bone_count MAX_BONE_COUNT, the ones not asked for left without a
// body); `twist` makes the elbows and knees twisting hinges.
struct Human {
    bones: ptr                     // HumanBone[bone_count]
    filter_joints: ptr             // JointId[MAX_FILTER_JOINT_COUNT]
    filter_joint_count: int
    friction_torque: float
    is_spawned: bool
    ankles: bool
    bone_count: int
    head: bool
    clavicles: bool
    hands: bool
    spine_02: bool
    twist: bool
}

bone_at(h: *Human, index: int) -> *HumanBone { return (h.bones + index * sizeof(HumanBone)) as *HumanBone }
filter_joint_at(h: *Human, index: int) -> JointId { return (h.filter_joints as JointId[])[index] }

// Whether a figure was given a bone (the reference's twelve always; a
// foot with ankles; an extra bone with its flag), whatever it is spawned.
asks_for_bone(h: *Human, index: int) -> bool {
    if index < 0 || index >= MAX_BONE_COUNT { return false }
    if index < BONE_COUNT { return true }
    if index == BONE_FOOT_L || index == BONE_FOOT_R { return h.ankles }
    if index == BONE_HEAD { return h.head }
    if index == BONE_CLAVICLE_L || index == BONE_CLAVICLE_R { return h.clavicles }
    if index == BONE_HAND_L || index == BONE_HAND_R { return h.hands }
    return h.spine_02
}

// Whether a spawned figure has the bone: a body, a joint to its parent.
// The slots past the reference's twelve that its flags did not ask for
// hold no body, so a loop to bone_count asks here first.
human_has_bone(h: *Human, index: int) -> bool {
    if h.is_spawned == false || index < 0 || index >= h.bone_count { return false }
    return asks_for_bone(h, index)
}

// Whether any flag asks for a bone past the feet.
has_extras(h: *Human) -> bool { return h.head || h.clavicles || h.hands || h.spine_02 }

// A built bone's far end in its body's frame: the end of its own capsule
// farther from its joint (a forearm's past the wrist, a foot's at the
// toe), but a calf with ankles ends at its ankle, the foot's joint, which
// its shin stops short of by a radius (#174). A figure not spawned, or an
// index past its bones, has none: zero.
human_bone_far_end(h: *Human, index: int) -> Vec3 {
    if human_has_bone(h, index) == false { return math.vec3_zero() }
    if h.ankles && (index == BONE_CALF_L || index == BONE_CALF_R) {
        foot = BONE_FOOT_L
        if index == BONE_CALF_R { foot = BONE_FOOT_R }
        return bone_at(h, foot).local_frame_a.p
    }
    bone = bone_at(h, index)
    c = dynamics.shape_get_capsule(bone.shape_id)
    joint = bone.local_frame_b.p
    if math.length(math.sub(c.center2, joint)) > math.length(math.sub(c.center1, joint)) { return c.center2 }
    return c.center1
}

transform_of(px: float, py: float, pz: float, qx: float, qy: float, qz: float, qs: float) -> Transform {
    return Transform { p: math.vec3(px, py, pz), q: math.quat_vs(math.vec3(qx, qy, qz), qs) }
}

// A bone as a figure's shape has it: its frame in the figure's own space
// (the joint to its parent at the origin), its capsule in that frame and,
// on a calf, its foot's; the joint's frames on parent and bone, limits
// and friction; and the filter group, surface friction and density.
struct BoneSpec {
    parent: int
    reference: Transform
    group: int                     // the filter group: 0, or -group_index to keep limbs from their neighbours
    friction: float
    capsule: Capsule
    joint_kind: int
    frame_a: Transform
    frame_b: Transform
    swing_degrees: float           // the cone's half angle
    lower_degrees: float           // the twist's or the hinge's range, against the rest
    upper_degrees: float
    joint_friction: float
    density: float                 // a scale on the default density
    has_foot: bool
    foot: Capsule
    foot_friction: float           // the sole's
    cone_axis: Vec3                // the cone's centre in the joint's frame on the parent: z, the rest, or off it
    // An elliptical cone: swing_degrees toward cone_major_axis (in the
    // joint's frame on the parent, across the centre) and
    // swing_minor_degrees across it; 0 for a circle of swing_degrees.
    swing_minor_degrees: float
    cone_major_axis: Vec3
}

// A figure's shape is MAX_BONE_COUNT BoneSpecs in one block from the
// engine's allocator: the reference's from human_reference_shape, a rig's
// once human_fit_shape has fitted it, and create_human_shaped builds
// either. The first BONE_COUNT are the reference's bones; the feet's two
// slots are unused (a foot is built from its calf's spec); the extra
// bones' specs follow, made from the twelve (extra_specs) and fitted to a
// rig with them or bone by bone (human_fit_bone). The caller frees it
// with destroy_shape.
spec_at(shape: @into ptr, index: int) -> *BoneSpec { return (shape + index * sizeof(BoneSpec)) as *BoneSpec }
set_spec(shape: ptr, index: int, spec: BoneSpec) { (shape as BoneSpec[])[index] = spec }

no_foot() -> Capsule { return manifold.capsule(math.vec3(0.0, 0.0, 0.0), math.vec3(0.0, 0.0, 0.0), 0.0) }

// The reference's figure with a body's reach: its bones, capsules and
// masses as the reference measured them, its joints' frames meeting at the
// rest and given the ranges of human_anatomical_limits (human_tight_limits
// puts back the reference's frames and ranges) and its shins and soles a
// grip on the ground.
human_reference_shape() -> ptr {
    shape = reference_tight_shape()
    human_anatomical_limits(shape)
    return shape
}

// The reference's shins slide at 0.1 and its soles too: a figure pushed
// skates on them. A shin grips as a thigh does; a sole as a boot on dry
// ground.
const SHIN_FRICTION = 0.6
const FOOT_FRICTION = 0.9

// The reference's figure, bone by bone (its frames measured from the rig,
// its limits the reference's: cones about the rest, hinges either side of it).
reference_tight_shape() -> ptr {
    shape = basics.alloc(MAX_BONE_COUNT * sizeof(BoneSpec))
    no_joint = math.transform_identity()
    on_axis = math.vec3_axis_z()
    set_spec(shape, BONE_PELVIS, BoneSpec {
        parent: 0 - 1, reference: transform_of(0.0, 0.996219, 0.0 - 0.023868, 1.0, 0.0, 0.0, 0.0), group: 0, friction: 0.6,
        capsule: manifold.capsule(math.vec3(0.04, 0.000001, 0.0), math.vec3(0.0 - 0.04, 0.0 - 0.000001, 0.0), 0.15),
        joint_kind: dynamics.JOINT_PARALLEL, frame_a: no_joint, frame_b: no_joint, swing_degrees: 0.0, lower_degrees: 0.0, upper_degrees: 0.0, joint_friction: 1.0,
        density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis, swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() })
    set_spec(shape, BONE_SPINE_01, BoneSpec {
        parent: BONE_PELVIS, reference: transform_of(0.0, 1.017288, 0.0 - 0.024882, 1.0, 0.0, 0.0, 0.0), group: 0 - 1, friction: 0.5,
        capsule: manifold.capsule(math.vec3(0.029876, 0.0 - 0.146581, 0.00626), math.vec3(0.0 - 0.029876, 0.0 - 0.146574, 0.00626), 0.145663),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.0, 0.0 - 0.021069, 0.001014, 0.0 - 0.642737, 0.0, 0.0, 0.0 - 0.766087),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.707107, 0.0, 0.0, 0.0 - 0.707107),
        swing_degrees: 35.0, lower_degrees: 0.0 - 17.5, upper_degrees: 17.5, joint_friction: 1.0, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis, swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() })
    set_spec(shape, BONE_SPINE_03, BoneSpec {
        parent: BONE_SPINE_01, reference: transform_of(0.0, 1.267766, 0.0 - 0.02232, 1.0, 0.0, 0.0, 0.0), group: 0, friction: 0.5,
        capsule: manifold.capsule(math.vec3(0.063996, 0.0 - 0.117434, 0.0 - 0.040199), math.vec3(0.0 - 0.063996, 0.0 - 0.117432, 0.0 - 0.040199), 0.165004),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.0, 0.0 - 0.250478, 0.0 - 0.002562, 0.0 - 0.642766, 0.0, 0.0, 0.0 - 0.766063),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.707107, 0.0, 0.0, 0.0 - 0.707107),
        swing_degrees: 35.0, lower_degrees: 0.0 - 17.5, upper_degrees: 17.5, joint_friction: 1.0, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis, swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() })
    set_spec(shape, BONE_NECK, BoneSpec {
        parent: BONE_SPINE_03, reference: transform_of(0.0, 1.498783, 0.024462, 0.987879, 0.0, 0.0, 0.155228), group: 0, friction: 0.2,
        capsule: manifold.capsule(math.vec3(0.0, 0.0 - 0.21234, 0.0), math.vec3(0.0, 0.0 - 0.08734, 0.0), 0.11),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.0, 0.0 - 0.231017, 0.0 - 0.046781, 0.0 - 0.516157, 0.0 - 0.000002, 0.000003, 0.0 - 0.856494),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.707108, 0.0 - 0.000002, 0.000002, 0.0 - 0.707106),
        swing_degrees: 30.0, lower_degrees: 0.0 - 17.5, upper_degrees: 17.5, joint_friction: 1.0, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis, swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() })
    set_spec(shape, BONE_THIGH_L, BoneSpec {
        parent: BONE_PELVIS, reference: transform_of(0.092175, 0.971562, 0.0 - 0.011177, 0.471412, 0.52951, 0.0 - 0.499888, 0.0 - 0.497495), group: 0 - 1, friction: 0.6,
        capsule: manifold.capsule(math.vec3(0.0 - 0.047269, 0.000001, 0.0), math.vec3(0.0 - 0.379769, 0.000005, 0.0), 0.091539),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.092175, 0.024656, 0.0 - 0.012691, 0.0 - 0.460186, 0.0 - 0.365368, 0.0 - 0.637662, 0.498118),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.499997, 0.0 - 0.500003, 0.500002, 0.499998),
        swing_degrees: 30.0, lower_degrees: 0.0 - 10.0, upper_degrees: 10.0, joint_friction: 1.0, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis, swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() })
    // The calves carry the shins at half density and the feet at full.
    set_spec(shape, BONE_CALF_L, BoneSpec {
        parent: BONE_THIGH_L, reference: transform_of(0.11872, 0.534541, 0.0 - 0.035362, 0.521188, 0.480597, 0.0 - 0.54638, 0.0 - 0.445935), group: 0, friction: SHIN_FRICTION,
        capsule: manifold.capsule(math.vec3(0.0 - 0.445, 0.000001, 0.0), math.vec3(0.005, 0.0 - 0.000001, 0.0), 0.08),
        joint_kind: dynamics.JOINT_REVOLUTE,
        frame_a: transform_of(0.0 - 0.438494, 0.0 - 0.000175, 0.0, 0.344866, 0.0 - 0.938652, 0.000002, 0.0 - 0.000008),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.008182, 0.0 - 0.999967, 0.000001, 0.0 - 0.000007),
        swing_degrees: 0.0, lower_degrees: 0.0 - 30.0, upper_degrees: 30.0, joint_friction: 1.0, density: 0.5,
        has_foot: true, foot: manifold.capsule(math.vec3(0.0 - 0.456371, 0.129321, 0.000013), math.vec3(0.0 - 0.359977, 0.014394, 0.000013), 0.07), foot_friction: FOOT_FRICTION, cone_axis: on_axis, swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() })
    set_spec(shape, BONE_THIGH_R, BoneSpec {
        parent: BONE_PELVIS, reference: transform_of(0.0 - 0.092175, 0.971562, 0.0 - 0.011177, 0.0 - 0.497495, 0.499888, 0.52951, 0.0 - 0.471412), group: 0 - 1, friction: 0.6,
        capsule: manifold.capsule(math.vec3(0.047269, 0.0 - 0.000001, 0.0), math.vec3(0.379769, 0.0 - 0.000005, 0.0), 0.092587),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.0 - 0.092175, 0.024656, 0.0 - 0.012691, 0.380666, 0.491846, 0.488644, 0.0 - 0.611889),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.500002, 0.499998, 0.0 - 0.499998, 0.500002),
        swing_degrees: 30.0, lower_degrees: 0.0 - 10.0, upper_degrees: 10.0, joint_friction: 1.0, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis, swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() })
    set_spec(shape, BONE_CALF_R, BoneSpec {
        parent: BONE_THIGH_R, reference: transform_of(0.0 - 0.11872, 0.534541, 0.0 - 0.035362, 0.0 - 0.445935, 0.54638, 0.480597, 0.0 - 0.521188), group: 0, friction: SHIN_FRICTION,
        capsule: manifold.capsule(math.vec3(0.445, 0.0 - 0.000002, 0.000003), math.vec3(0.0 - 0.005, 0.0, 0.000003), 0.08),
        joint_kind: dynamics.JOINT_REVOLUTE,
        frame_a: transform_of(0.438494, 0.000175, 0.0, 0.000007, 0.000005, 0.0 - 0.34486, 0.0 - 0.938654),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.000006, 0.000005, 0.008188, 0.0 - 0.999966),
        swing_degrees: 0.0, lower_degrees: 0.0 - 30.0, upper_degrees: 30.0, joint_friction: 1.0, density: 0.5,
        has_foot: true, foot: manifold.capsule(math.vec3(0.369113, 0.0 - 0.00683, 0.000017), math.vec3(0.465507, 0.0 - 0.121757, 0.000017), 0.07), foot_friction: FOOT_FRICTION, cone_axis: on_axis, swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() })
    set_spec(shape, BONE_UPPER_ARM_L, BoneSpec {
        parent: BONE_SPINE_03, reference: transform_of(0.185817, 1.44363, 0.031306, 0.56022, 0.0 - 0.307179, 0.366233, 0.0 - 0.676512), group: 0, friction: 0.6,
        capsule: manifold.capsule(math.vec3(0.296038, 0.004386, 0.0 - 0.000794), math.vec3(0.0 - 0.016086, 0.004384, 0.0 - 0.016127), 0.065),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.185817, 0.0 - 0.175865, 0.0 - 0.053625, 0.0 - 0.559466, 0.0 - 0.213784, 0.0 - 0.670199, 0.438323),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.500953, 0.0 - 0.502617, 0.0 - 0.509318, 0.0 - 0.486844),
        swing_degrees: 45.0, lower_degrees: 0.0 - 20.0, upper_degrees: 20.0, joint_friction: 0.8, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis, swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() })
    set_spec(shape, BONE_LOWER_ARM_L, BoneSpec {
        parent: BONE_UPPER_ARM_L, reference: transform_of(0.347683, 1.193455, 0.029378, 0.406736, 0.0 - 0.493012, 0.089135, 0.0 - 0.763911), group: 0, friction: 0.3,
        capsule: manifold.capsule(math.vec3(0.312329, 0.0 - 0.008256, 0.0 - 0.016454), math.vec3(0.033153, 0.008259, 0.0 - 0.002741), 0.06),
        joint_kind: dynamics.JOINT_REVOLUTE,
        frame_a: transform_of(0.297979, 0.000361, 0.0, 0.916726, 0.399352, 0.000839, 0.0 - 0.011456),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.999922, 0.0 - 0.003857, 0.004659, 0.0 - 0.010908),
        swing_degrees: 0.0, lower_degrees: 0.0 - 35.0, upper_degrees: 35.0, joint_friction: 0.06, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis, swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() })
    set_spec(shape, BONE_UPPER_ARM_R, BoneSpec {
        parent: BONE_SPINE_03, reference: transform_of(0.0 - 0.185817, 1.44363, 0.031306, 0.676512, 0.366233, 0.307179, 0.56022), group: 0, friction: 0.6,
        capsule: manifold.capsule(math.vec3(0.0 - 0.300237, 0.0 - 0.000001, 0.0 - 0.000319), math.vec3(0.011887, 0.000001, 0.015013), 0.065),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.0 - 0.185817, 0.0 - 0.175865, 0.0 - 0.053625, 0.213793, 0.559449, 0.438334, 0.0 - 0.670204),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.509319, 0.486843, 0.500954, 0.0 - 0.502617),
        swing_degrees: 45.0, lower_degrees: 0.0 - 20.0, upper_degrees: 20.0, joint_friction: 0.8, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis, swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() })
    set_spec(shape, BONE_LOWER_ARM_R, BoneSpec {
        parent: BONE_UPPER_ARM_R, reference: transform_of(0.0 - 0.347683, 1.193455, 0.029378, 0.763911, 0.089135, 0.493012, 0.406736), group: 0, friction: 0.3,
        capsule: manifold.capsule(math.vec3(0.0 - 0.312649, 0.0 - 0.000003, 0.016471), math.vec3(0.0 - 0.032986, 0.0, 0.002732), 0.06),
        joint_kind: dynamics.JOINT_REVOLUTE,
        frame_a: transform_of(0.0 - 0.297979, 0.0 - 0.000361, 0.0, 0.0 - 0.405444, 0.914059, 0.010541, 0.000852),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.002794, 0.999936, 0.010042, 0.004364),
        swing_degrees: 0.0, lower_degrees: 0.0 - 35.0, upper_degrees: 35.0, joint_friction: 0.06, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis, swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() })
    set_spec(shape, BONE_FOOT_L, unused_spec())
    set_spec(shape, BONE_FOOT_R, unused_spec())
    extra_specs(shape)
    return shape
}

// The feet's slots: a foot is built from its calf's spec.
unused_spec() -> BoneSpec {
    no_joint = math.transform_identity()
    return BoneSpec {
        parent: 0 - 1, reference: no_joint, group: 0, friction: 0.0, capsule: no_foot(),
        joint_kind: dynamics.JOINT_PARALLEL, frame_a: no_joint, frame_b: no_joint, swing_degrees: 0.0, lower_degrees: 0.0, upper_degrees: 0.0, joint_friction: 0.0,
        density: 0.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: math.vec3_axis_z(), swing_minor_degrees: 0.0, cone_major_axis: math.vec3_zero() }
}

// --- the extra bones' shapes (#190) ------------------------------------------------------------------------

// An extra bone's spec: its frame `reference` looks down the bone (its z
// from the joint along the bone, its x the way the joint's main range
// reaches), so the joint's frames are the bone's own, one at rest. Its
// cone is an ellipse about a centre tipped `tilt` degrees toward x,
// reaching `major` degrees either side of it along x and `minor` across
// (a circle when minor is 0), and it turns `twist` degrees either way.
extra_spec(parent: int, reference: Transform, capsule: Capsule, group: int, friction: float, joint_friction: float,
           tilt: float, major: float, minor: float, twist: float) -> BoneSpec {
    t = tilt * math.DEG_TO_RAD
    return BoneSpec {
        parent: parent, reference: reference, group: group, friction: friction, capsule: capsule,
        joint_kind: dynamics.JOINT_SPHERICAL, frame_a: math.transform_identity(), frame_b: math.transform_identity(),
        swing_degrees: major, lower_degrees: 0.0 - twist, upper_degrees: twist, joint_friction: joint_friction,
        density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: math.vec3(sin(t), 0.0, cos(t)),
        swing_minor_degrees: minor, cone_major_axis: math.vec3_zero() }
}

// A rotation looking down `line` (its z), its x the part of `hint` across it.
line_frame(line: Vec3, hint: Vec3) -> Quat {
    z = math.normalize(line)
    x = math.normalize(across(hint, z))
    return math.make_quat_from_matrix(Matrix3 { cx: x, cy: math.cross(z, x), cz: z })
}

// The figure's up (the pelvis's joint to the neck's) and forward (the
// way its toes point, across the up), measured on the shape as it stands.
figure_up(shape: ptr) -> Vec3 { return math.normalize(math.sub(human_shape_head(shape, BONE_NECK), human_shape_head(shape, BONE_PELVIS))) }

figure_forward(shape: ptr, up: Vec3) -> Vec3 {
    toes = math.add(math.sub(human_shape_toe(shape, BONE_CALF_L), human_shape_tail(shape, BONE_CALF_L)),
                    math.sub(human_shape_toe(shape, BONE_CALF_R), human_shape_tail(shape, BONE_CALF_R)))
    return math.normalize(across(toes, up))
}

// Away from the figure's middle line at `point`, across its up and forward.
out_from_middle(shape: ptr, point: Vec3, up: Vec3, forward: Vec3) -> Vec3 {
    return across(across(math.sub(point, human_shape_head(shape, BONE_PELVIS)), up), forward)
}

// A capsule's end nearer its body's origin, and the farther.
near_end(c: Capsule) -> Vec3 {
    if math.length(c.center2) < math.length(c.center1) { return c.center2 }
    return c.center1
}

far_end(c: Capsule) -> Vec3 {
    if math.length(c.center2) > math.length(c.center1) { return c.center2 }
    return c.center1
}

// The extra bones made from the twelve, where a person has them:
//   the head above the neck, its joint at the near end of the neck's
//   capsule (which carries the head on the reference's figure), its own
//   capsule the head's part of it;
//   each clavicle from the sternoclavicular joint (in from the shoulder,
//   a little below and ahead of it, in proportion to the shoulders'
//   width) to the shoulder;
//   each hand from the wrist, four fifths along the forearm's capsule
//   line, as long as a hand is to a forearm of that length;
//   spine_02 halfway between the spine bodies' joints, as wide as the
//   lumbar body it splits with spine_01.
extra_specs(shape: ptr) {
    up = figure_up(shape)
    forward = figure_forward(shape, up)
    neck = spec_at(shape, BONE_NECK)
    near = near_end(neck.capsule)
    far = far_end(neck.capsule)
    length = math.length(math.sub(far, near))
    head_frame = Transform { p: math.transform_point(neck.reference, near), q: line_frame(math.rotate_vector(neck.reference.q, math.sub(far, near)), forward) }
    set_spec(shape, BONE_HEAD, extra_spec(BONE_NECK, head_frame,
        manifold.capsule(math.vec3(0.0, 0.0, 0.24 * length), math.vec3(0.0, 0.0, length), 0.91 * neck.capsule.radius), 0, neck.friction, 1.0,
        0.5 * (HEAD_FLEXION_DEGREES - HEAD_EXTENSION_DEGREES), 0.5 * (HEAD_FLEXION_DEGREES + HEAD_EXTENSION_DEGREES), HEAD_TILT_DEGREES, HEAD_TURN_DEGREES))
    clavicle_spec(shape, BONE_CLAVICLE_L, BONE_UPPER_ARM_L, up, forward)
    clavicle_spec(shape, BONE_CLAVICLE_R, BONE_UPPER_ARM_R, up, forward)
    hand_spec(shape, BONE_HAND_L, BONE_LOWER_ARM_L, up, forward)
    hand_spec(shape, BONE_HAND_R, BONE_LOWER_ARM_R, up, forward)
    lumbar = spec_at(shape, BONE_SPINE_01)
    chest = spec_at(shape, BONE_SPINE_03)
    line = math.sub(chest.reference.p, lumbar.reference.p)
    span = math.length(line)
    middle = Transform { p: math.mul_add(lumbar.reference.p, 0.5, line), q: line_frame(line, forward) }
    set_spec(shape, BONE_SPINE_02, extra_spec(BONE_SPINE_01, middle,
        manifold.capsule(math.vec3(0.0, 0.12 * span, 0.32 * span), math.vec3(0.0, 0.0 - 0.12 * span, 0.32 * span), 0.45 * span), lumbar.group, lumbar.friction, 1.0,
        0.0, 0.5 * chest.swing_degrees, 0.0, 0.5 * chest.upper_degrees))
    i = BONE_HEAD
    while i < MAX_BONE_COUNT {
        rest_frames(shape, i)
        i = i + 1
    }
}

clavicle_spec(shape: ptr, index: int, arm_index: int, up: Vec3, forward: Vec3) {
    shoulder = human_shape_head(shape, arm_index)
    out = out_from_middle(shape, shoulder, up, forward)
    half_width = math.length(out)
    side = math.mul_sv(1.0 / half_width, out)
    joint = math.add(math.sub(math.sub(shoulder, math.mul_sv(0.84 * half_width, side)), math.mul_sv(0.21 * half_width, up)), math.mul_sv(0.27 * half_width, forward))
    line = math.sub(shoulder, joint)
    length = math.length(line)
    set_spec(shape, index, extra_spec(BONE_SPINE_03, Transform { p: joint, q: line_frame(line, up) },
        manifold.capsule(math.vec3(0.0, 0.0, 0.12 * length), math.vec3(0.0, 0.0, 0.82 * length), 0.3 * length), 0, spec_at(shape, arm_index).friction, 1.0,
        0.5 * (CLAVICLE_ELEVATION_DEGREES - CLAVICLE_DEPRESSION_DEGREES), 0.5 * (CLAVICLE_ELEVATION_DEGREES + CLAVICLE_DEPRESSION_DEGREES),
        CLAVICLE_PROTRACTION_DEGREES, CLAVICLE_ROTATION_DEGREES))
    // The shoulder girdle it stands for (the clavicle, the scapula and the
    // muscles over them), not the bone alone: a body light against the arm
    // it carries leaves the solver too little to hold the shoulder by.
    spec_at(shape, index).density = CLAVICLE_DENSITY
}

hand_spec(shape: ptr, index: int, forearm_index: int, up: Vec3, forward: Vec3) {
    forearm = spec_at(shape, forearm_index)
    far = far_end(forearm.capsule)
    reach = math.length(far)
    wrist = math.transform_point(forearm.reference, math.mul_sv(0.8, far))
    palm = math.neg(out_from_middle(shape, wrist, up, forward))
    set_spec(shape, index, extra_spec(forearm_index, Transform { p: wrist, q: line_frame(math.rotate_vector(forearm.reference.q, far), palm) },
        manifold.capsule(math.vec3(0.0, 0.0, 0.096 * reach), math.vec3(0.0, 0.0, 0.35 * reach), 0.67 * forearm.capsule.radius), 0, forearm.friction, forearm.joint_friction,
        0.5 * (WRIST_FLEXION_DEGREES - WRIST_EXTENSION_DEGREES), 0.5 * (WRIST_FLEXION_DEGREES + WRIST_EXTENSION_DEGREES), WRIST_DEVIATION_DEGREES, WRIST_TWIST_DEGREES))
}

// An extra bone's joint frames from its frame and its parent's: the
// bone's own frame on both sides, so the joint is one at rest and its
// cone and twist read from there.
rest_frames(shape: ptr, index: int) {
    spec = spec_at(shape, index)
    spec.frame_b = math.transform_identity()
    spec.frame_a = math.inv_mul_transforms(spec_at(shape, spec.parent).reference, spec.reference)
}

// Whether a bone index is one of the extra bones.
is_extra(index: int) -> bool { return index >= BONE_HEAD && index < MAX_BONE_COUNT }

// --- a shape's landmarks, and a shape fitted to a rig's --------------------------------------------

// A bone's next along the chain the figure is measured by -- the spine up
// to the neck, each leg to its calf, each arm to its forearm -- or -1 for
// the neck, the calves and the forearms, which end their chains.
human_chain_child(index: int) -> int {
    if index == BONE_PELVIS { return BONE_SPINE_01 }
    if index == BONE_SPINE_01 { return BONE_SPINE_03 }
    if index == BONE_SPINE_03 { return BONE_NECK }
    if index == BONE_THIGH_L { return BONE_CALF_L }
    if index == BONE_THIGH_R { return BONE_CALF_R }
    if index == BONE_UPPER_ARM_L { return BONE_LOWER_ARM_L }
    if index == BONE_UPPER_ARM_R { return BONE_LOWER_ARM_R }
    return 0 - 1
}

// A bone's head in the figure's space: its joint to its parent, its body's origin.
human_shape_head(shape: ptr, index: int) -> Vec3 { return spec_at(shape, index).reference.p }

// A bone's tail: where the line it is measured by ends -- its next
// joint along the chain, or for a bone that ends one the end of its own
// capsule farther from its joint: a calf's at the ankle, a forearm's
// past the wrist (it carries the hand), the neck's at the head's middle.
// An extra bone's: a clavicle's at the shoulder, spine_02's at the
// chest's joint, the head's at its crown and a hand's at its tip (its
// capsule's far end and cap).
human_shape_tail(shape: ptr, index: int) -> Vec3 {
    if index == BONE_CLAVICLE_L { return spec_at(shape, BONE_UPPER_ARM_L).reference.p }
    if index == BONE_CLAVICLE_R { return spec_at(shape, BONE_UPPER_ARM_R).reference.p }
    if index == BONE_SPINE_02 { return spec_at(shape, BONE_SPINE_03).reference.p }
    if index == BONE_HEAD || index == BONE_HAND_L || index == BONE_HAND_R {
        extra = spec_at(shape, index)
        end = far_end(extra.capsule)
        return math.transform_point(extra.reference, math.mul_add(end, extra.capsule.radius, math.normalize(end)))
    }
    child = human_chain_child(index)
    if child >= 0 { return spec_at(shape, child).reference.p }
    spec = spec_at(shape, index)
    far = spec.capsule.center1
    if math.length(spec.capsule.center2) > math.length(far) { far = spec.capsule.center2 }
    return math.transform_point(spec.reference, far)
}

// A calf's foot's toe end in the figure's space: the end of the foot's
// capsule farther off the shin's line.
human_shape_toe(shape: ptr, index: int) -> Vec3 {
    spec = spec_at(shape, index)
    return math.transform_point(spec.reference, foot_toe(spec))
}

foot_toe(spec: *BoneSpec) -> Vec3 {
    axis = math.normalize(math.sub(spec.capsule.center2, spec.capsule.center1))
    if off_line(spec.foot.center2, spec.capsule.center1, axis) > off_line(spec.foot.center1, spec.capsule.center1, axis) { return spec.foot.center2 }
    return spec.foot.center1
}

off_line(p: Vec3, origin: Vec3, axis: Vec3) -> float {
    d = math.sub(p, origin)
    return math.length(math.sub(d, math.mul_sv(math.dot(d, axis), axis)))
}

// Whether a bone's tail measures its own length. The neck's capsule
// carries the head and a forearm's the hand, past the joints a rig names
// their tails by, so those two take their parent's scale; the pelvis's
// line, two centimetres to the spine's joint, the figure's.
measures_length(index: int) -> bool {
    return index != BONE_PELVIS && index != BONE_NECK && index != BONE_LOWER_ARM_L && index != BONE_LOWER_ARM_R
}

// Shorter than this, a line has no direction to fit to.
const LINE_MIN = 0.005

// A shape fitted to a figure: every bone's joint put at `heads[i]` and
// turned so its line runs to `tails[i]` (both Vec3[BONE_COUNT], in the
// figure's space, landmarks as human_shape_head and human_shape_tail
// name them), and so the rig's bind pose is the shape's rest pose.
// A bone's capsule is stretched along its line by the length its tail
// measures (by its parent's where it measures none), every radius by
// the figure's size against the reference's; a calf's foot rides the
// shin and, when `toes` (Vec3[2]: left, right) is not null, is turned
// about the shin so its toe points the rig's way. Each joint's frame on
// the parent turns with the bone, so the joint's rest angle -- what its
// spring and its limits are taken from -- is what it was.
//
// The extra bones ride their parents: each keeps its place and turn on
// its parent, its offsets scaled as the parent's line was, its radius as
// the figure was; a clavicle then reaches to the fitted shoulder and
// spine_02 sits halfway up the fitted spine. A rig that has those bones
// puts each on its own with human_fit_bone, after this.
human_fit_shape(shape: ptr, heads: ptr, tails: ptr, toes: ptr) {
    on_parents = basics.alloc(MAX_BONE_COUNT * sizeof(Transform))
    on_parent = on_parents as Transform[]
    extra_lengths = basics.alloc(MAX_BONE_COUNT * 8)
    extra_length = extra_lengths as float[]
    e = BONE_HEAD
    while e < MAX_BONE_COUNT {
        extra = spec_at(shape, e)
        on_parent[e] = math.inv_mul_transforms(spec_at(shape, extra.parent).reference, extra.reference)
        extra_length[e] = math.length(math.sub(human_shape_tail(shape, e), extra.reference.p))
        e = e + 1
    }
    // Each hinge's axis as it sits against the figure's anatomy, to be put
    // back after the fit (#194): the bones turn by their shortest arcs,
    // which carry a hinge's axis off the anatomical one when an arm swings
    // far (a T-posed rig's elbows bent in the wrong plane).
    anatomy_block = basics.alloc(BONE_COUNT * sizeof(Vec3))
    in_anatomy = anatomy_block as Vec3[]
    i = 0
    while i < BONE_COUNT {
        if spec_at(shape, i).joint_kind == dynamics.JOINT_REVOLUTE { in_anatomy[i] = in_hinge_frame(shape, i, hinge_axis(shape, i)) }
        i = i + 1
    }
    head_at = heads as Vec3[]
    tail_at = tails as Vec3[]
    turns = basics.alloc(BONE_COUNT * sizeof(Quat))
    turn = turns as Quat[]
    olds = basics.alloc(BONE_COUNT * sizeof(Quat))
    old = olds as Quat[]
    units = basics.alloc(BONE_COUNT * sizeof(Vec3))
    unit = units as Vec3[]
    scales = basics.alloc(BONE_COUNT * 8)
    scale = scales as float[]
    bends = basics.alloc(BONE_COUNT * 8)
    bend = bends as float[]
    reference_total = 0.0
    fitted_total = 0.0
    i = 0
    while i < BONE_COUNT {
        spec = spec_at(shape, i)
        old[i] = spec.reference.q
        line = math.sub(human_shape_tail(shape, i), spec.reference.p)
        fitted = math.sub(tail_at[i], head_at[i])
        reference_length = math.length(line)
        fitted_length = math.length(fitted)
        turn[i] = math.quat_identity()
        unit[i] = math.vec3(0.0, 0.0, 0.0)
        scale[i] = 0.0
        bend[i] = 0.0
        if spec.joint_kind == dynamics.JOINT_REVOLUTE { bend[i] = hinge_bend(shape, i) }
        if reference_length > LINE_MIN {
            unit[i] = math.inv_rotate_vector(spec.reference.q, math.mul_sv(1.0 / reference_length, line))
            if fitted_length > LINE_MIN {
                turn[i] = math.compute_quat_between_unit_vectors(math.mul_sv(1.0 / reference_length, line), math.mul_sv(1.0 / fitted_length, fitted))
                if measures_length(i) {
                    scale[i] = fitted_length / reference_length
                    reference_total = reference_total + reference_length
                    fitted_total = fitted_total + fitted_length
                }
            }
        }
        i = i + 1
    }
    figure = 1.0
    if reference_total > 0.0 { figure = fitted_total / reference_total }
    // Parents come before children in the bones' order.
    i = 0
    while i < BONE_COUNT {
        spec = spec_at(shape, i)
        if scale[i] == 0.0 {
            scale[i] = figure
            if spec.parent >= 0 { scale[i] = scale[spec.parent] }
        }
        spec.reference = Transform { p: head_at[i], q: math.normalize_quat(math.mul_quat(turn[i], old[i])) }
        spec.capsule = stretch(spec.capsule, unit[i], scale[i], figure)
        if spec.has_foot { spec.foot = stretch(spec.foot, unit[i], scale[i], figure) }
        if spec.parent >= 0 {
            parent = spec_at(shape, spec.parent)
            centre = math.rotate_vector(spec.frame_a.q, spec.cone_axis)
            major = math.rotate_vector(spec.frame_a.q, spec.cone_major_axis)
            spec.frame_a.p = math.inv_rotate_vector(parent.reference.q, math.sub(head_at[i], head_at[spec.parent]))
            spec.frame_a.q = math.normalize_quat(math.inv_mul_quat(parent.reference.q, math.mul_quat(turn[i], math.mul_quat(old[spec.parent], spec.frame_a.q))))
            // A cone centred off the rest stays where it was on the parent;
            // one about the rest turns with it, as the reference's does.
            if cone_off_axis(spec.cone_axis) {
                spec.cone_axis = math.inv_rotate_vector(spec.frame_a.q, centre)
                spec.cone_major_axis = math.inv_rotate_vector(spec.frame_a.q, major)
            }
        }
        i = i + 1
    }
    if toes != null {
        toe_at = toes as Vec3[]
        point_foot(spec_at(shape, BONE_CALF_L), unit[BONE_CALF_L], toe_at[0], head_at[BONE_CALF_L])
        point_foot(spec_at(shape, BONE_CALF_R), unit[BONE_CALF_R], toe_at[1], head_at[BONE_CALF_R])
    }
    // Each hinge's axis put back where it sat against the anatomy, both of
    // its joint's frames turned together so its rest angle is what it was.
    i = 0
    while i < BONE_COUNT {
        spec = spec_at(shape, i)
        if spec.joint_kind == dynamics.JOINT_REVOLUTE { turn_hinge_axis(shape, i, from_hinge_frame(shape, i, in_anatomy[i])) }
        i = i + 1
    }
    basics.free_bytes(anatomy_block, BONE_COUNT * sizeof(Vec3))
    // A hinge's range is held against the rest; the rig's rest bends the
    // joint more or less than the reference's, so the range moves by the
    // difference and still ends where it did: straight stays straight.
    i = 0
    while i < BONE_COUNT {
        spec = spec_at(shape, i)
        if spec.joint_kind == dynamics.JOINT_REVOLUTE {
            shift = (bend[i] - hinge_bend(shape, i)) * math.RAD_TO_DEG
            spec.lower_degrees = spec.lower_degrees + shift
            spec.upper_degrees = spec.upper_degrees + shift
        }
        i = i + 1
    }
    e = BONE_HEAD
    while e < MAX_BONE_COUNT {
        extra = spec_at(shape, e)
        held = on_parent[e]
        extra.reference = math.mul_transforms(spec_at(shape, extra.parent).reference, Transform { p: math.mul_sv(scale[extra.parent], held.p), q: held.q })
        extra.capsule = manifold.capsule(math.mul_sv(scale[extra.parent], extra.capsule.center1), math.mul_sv(scale[extra.parent], extra.capsule.center2), extra.capsule.radius * figure)
        e = e + 1
    }
    aim_extra(shape, BONE_CLAVICLE_L, human_shape_head(shape, BONE_CLAVICLE_L), human_shape_head(shape, BONE_UPPER_ARM_L),
              extra_length[BONE_CLAVICLE_L] * scale[BONE_SPINE_03])
    aim_extra(shape, BONE_CLAVICLE_R, human_shape_head(shape, BONE_CLAVICLE_R), human_shape_head(shape, BONE_UPPER_ARM_R),
              extra_length[BONE_CLAVICLE_R] * scale[BONE_SPINE_03])
    aim_extra(shape, BONE_SPINE_02, math.mul_sv(0.5, math.add(human_shape_head(shape, BONE_SPINE_01), human_shape_head(shape, BONE_SPINE_03))),
              human_shape_head(shape, BONE_SPINE_03), extra_length[BONE_SPINE_02] * scale[BONE_SPINE_01])
    e = BONE_HEAD
    while e < MAX_BONE_COUNT {
        rest_frames(shape, e)
        e = e + 1
    }
    basics.free_bytes(on_parents, MAX_BONE_COUNT * sizeof(Transform))
    basics.free_bytes(extra_lengths, MAX_BONE_COUNT * 8)
    basics.free_bytes(turns, BONE_COUNT * sizeof(Quat))
    basics.free_bytes(olds, BONE_COUNT * sizeof(Quat))
    basics.free_bytes(units, BONE_COUNT * sizeof(Vec3))
    basics.free_bytes(scales, BONE_COUNT * 8)
    basics.free_bytes(bends, BONE_COUNT * 8)
}

// An extra bone put on a rig's: its joint at `head` and its line turned to
// run to `tail` (in the figure's space, landmarks as human_shape_head and
// human_shape_tail name them: a clavicle's tail is the shoulder, a hand's
// its tip), its capsule stretched along the line to the rig's length.
// Its joint's frames follow; its limits are held against its rest, so
// they turn with it. Nothing happens for the reference's bones (fitted by
// human_fit_shape, which is called first: it moves the extras with their
// parents) or for lines too short to have a direction.
human_fit_bone(shape: ptr, index: int, head: Vec3, tail: Vec3) {
    if is_extra(index) == false { return }
    aim_extra(shape, index, head, tail, math.length(math.sub(human_shape_tail(shape, index), human_shape_head(shape, index))))
}

// A hinge's axis given by the host (#199): `axis`, in the figure's space,
// is the axis a rig's elbow or knee flexes about (as its takes measure
// it), for a revolute joint and for a twisting hinge's bend alike. Both
// of the joint's frames turn together onto it, so its rest angle is what
// it was; the axis takes the sign of the one it replaces, so the range
// still bends the bone the way it did, and the range moves by the change
// in the rest's bend, so straight stays straight. Call it after
// human_fit_shape and before human_anatomical_limits, which aims the
// range about the given axis. Nothing happens for a joint that is not a
// hinge or an axis too short to have a direction.
human_fit_hinge_axis(shape: ptr, index: int, axis: Vec3) {
    if index <= BONE_PELVIS || index >= MAX_BONE_COUNT { return }
    spec = spec_at(shape, index)
    if spec.joint_kind != dynamics.JOINT_REVOLUTE { return }
    length = math.length(axis)
    if length < AXIS_MIN { return }
    wanted = math.mul_sv(1.0 / length, axis)
    if math.dot(wanted, hinge_axis(shape, index)) < 0.0 { wanted = math.neg(wanted) }
    before = hinge_bend(shape, index)
    turn_hinge_axis(shape, index, wanted)
    shift = (before - hinge_bend(shape, index)) * math.RAD_TO_DEG
    spec.lower_degrees = spec.lower_degrees + shift
    spec.upper_degrees = spec.upper_degrees + shift
}

const AXIS_MIN = 0.000001

// A hinge's frames on its parent and on its bone turned together, in the
// figure's space, by the shortest arc from its axis to `wanted` (a unit
// vector): the joint's rest angle stays what it was.
turn_hinge_axis(shape: ptr, index: int, wanted: Vec3) {
    spec = spec_at(shape, index)
    parent = spec_at(shape, spec.parent)
    fix = math.compute_quat_between_unit_vectors(hinge_axis(shape, index), wanted)
    spec.frame_a.q = math.normalize_quat(math.inv_mul_quat(parent.reference.q, math.mul_quat(fix, math.mul_quat(parent.reference.q, spec.frame_a.q))))
    spec.frame_b.q = math.normalize_quat(math.inv_mul_quat(spec.reference.q, math.mul_quat(fix, math.mul_quat(spec.reference.q, spec.frame_b.q))))
}

// An extra bone's line is its frame's z, `length` long as it stands (a
// clavicle's or spine_02's tail is another bone's joint, which a fit may
// have moved already, so the caller says how long the bone is). The
// capsule's centres are stretched along the line; a head's or a hand's
// tail is its capsule's cap, which keeps its radius, so its centres are
// stretched over the line less the radius and the cap ends on the tail
// (stretched over the whole line, the cap overshot by r(1 - s), #192).
aim_extra(shape: ptr, index: int, head: Vec3, tail: Vec3, length: float) {
    spec = spec_at(shape, index)
    fitted = math.sub(tail, head)
    fitted_length = math.length(fitted)
    if length <= LINE_MIN || fitted_length <= LINE_MIN { return }
    turn = math.compute_quat_between_unit_vectors(math.rotate_vector(spec.reference.q, math.vec3_axis_z()), math.mul_sv(1.0 / fitted_length, fitted))
    along = fitted_length / length
    if index == BONE_HEAD || index == BONE_HAND_L || index == BONE_HAND_R {
        r = spec.capsule.radius
        if length - r > LINE_MIN && fitted_length - r > LINE_MIN { along = (fitted_length - r) / (length - r) }
    }
    spec.capsule = stretch(spec.capsule, math.vec3_axis_z(), along, 1.0)
    spec.reference = Transform { p: head, q: math.normalize_quat(math.mul_quat(turn, spec.reference.q)) }
    rest_frames(shape, index)
}

// A figure's shape given back (human_reference_shape's block).
destroy_shape(shape: ptr) { basics.free_bytes(shape, MAX_BONE_COUNT * sizeof(BoneSpec)) }

cone_off_axis(axis: Vec3) -> bool { return axis.x != 0.0 || axis.y != 0.0 || axis.z <= 0.0 }

// --- a body's reach ----------------------------------------------------------------------------

// The ranges a person's joints move through. A shoulder lifts the arm
// ahead and overhead (flexion past 180 degrees), out to the side and over
// the head (abduction), and 55 degrees back (extension): one cone of 120
// degrees whose centre leans forward, down and out from the rest -- and
// turns the arm 70 degrees inward and 90 outward about itself (#201). A hip
// lifts the thigh 125 degrees for kneeling and sitting and takes it 25
// back: a cone of 78 leaning forward and out -- and turns it 45 degrees
// inward and 45 outward about itself (#205). A knee bends from straight
// to 150 degrees and an elbow to 145, neither past straight. The spine,
// the neck and the other twists keep the reference's. Measured on the shape as
// it stands -- forward the way its toes point, up from the pelvis to the
// neck, out from a limb's parent to its joint -- so a fitted shape takes
// them as well as the reference's.
//
// Every joint's frames are made to meet at the rest first (#202). The
// reference's do not: its frames' zero is a pose of their own, the thighs
// 14 and 18 degrees back and out of the rest (not as mirrors), the knees
// bent 30 and the spine leaning, so twist ranges were centred off the
// rest, a swinging limb read a twist against frames off its line, and a
// spring pulled each side to a pose of its own. Frame A turns onto frame
// B, which stays on the bone's line (the cones are aimed against it):
// swing, twist and a hinge's angle are nothing at the rest, a spring holds
// the rest, and every range is held against it. human_tight_limits puts
// the reference's frames back.
const SHOULDER_CONE = 120.0
// Published ranges for the arm turning about itself (American Academy of
// Orthopaedic Surgeons, "Joint Motion: Method of Measuring and Recording",
// 1965; Greene and Heckman, "The Clinical Measurement of Joint Motion",
// 1994): 70 degrees inward (the hand to the belly) and 90 outward.
const SHOULDER_INTERNAL_ROTATION = 70.0
const SHOULDER_EXTERNAL_ROTATION = 90.0
// A person's hip, from standing: the thigh flexes ahead to 125 degrees
// and extends back to 25; it abducts out to 45 and adducts across to 30.
const HIP_FLEXION = 125.0
const HIP_EXTENSION = 25.0
const HIP_ABDUCTION = 45.0
const HIP_ADDUCTION = 30.0
// Published ranges for the thigh turning about itself, from standing
// (the same sources as the shoulder's): 45 degrees inward, 45 outward.
const HIP_INTERNAL_ROTATION = 45.0
const HIP_EXTERNAL_ROTATION = 45.0
const KNEE_FLEXION = 150.0
const ELBOW_FLEXION = 145.0

human_anatomical_limits(shape: ptr) {
    up = math.normalize(math.sub(human_shape_head(shape, BONE_NECK), human_shape_head(shape, BONE_PELVIS)))
    toes = math.add(math.sub(human_shape_toe(shape, BONE_CALF_L), human_shape_tail(shape, BONE_CALF_L)),
                    math.sub(human_shape_toe(shape, BONE_CALF_R), human_shape_tail(shape, BONE_CALF_R)))
    forward = math.normalize(across(toes, up))
    i = 0
    while i < BONE_COUNT {
        if spec_at(shape, i).parent >= 0 { meet_at_rest(shape, i) }
        i = i + 1
    }
    aim_cone(shape, BONE_UPPER_ARM_L, up, forward, SHOULDER_CONE, 0.3, 0.0 - 0.4, 0.866)
    aim_cone(shape, BONE_UPPER_ARM_R, up, forward, SHOULDER_CONE, 0.3, 0.0 - 0.4, 0.866)
    aim_twist(shape, BONE_UPPER_ARM_L, up, forward, SHOULDER_INTERNAL_ROTATION, SHOULDER_EXTERNAL_ROTATION)
    aim_twist(shape, BONE_UPPER_ARM_R, up, forward, SHOULDER_INTERNAL_ROTATION, SHOULDER_EXTERNAL_ROTATION)
    aim_ellipse(shape, BONE_THIGH_L, up, forward, HIP_FLEXION, HIP_EXTENSION, HIP_ABDUCTION, HIP_ADDUCTION)
    aim_ellipse(shape, BONE_THIGH_R, up, forward, HIP_FLEXION, HIP_EXTENSION, HIP_ABDUCTION, HIP_ADDUCTION)
    aim_twist(shape, BONE_THIGH_L, up, forward, HIP_INTERNAL_ROTATION, HIP_EXTERNAL_ROTATION)
    aim_twist(shape, BONE_THIGH_R, up, forward, HIP_INTERNAL_ROTATION, HIP_EXTERNAL_ROTATION)
    set_hinge(shape, BONE_CALF_L, math.neg(forward), KNEE_FLEXION)
    set_hinge(shape, BONE_CALF_R, math.neg(forward), KNEE_FLEXION)
    set_hinge(shape, BONE_LOWER_ARM_L, forward, ELBOW_FLEXION)
    set_hinge(shape, BONE_LOWER_ARM_R, forward, ELBOW_FLEXION)
}

// The reference's limits put back on a shape: cones about its frames (45
// degrees at the shoulders, 30 at the hips) and hinges 30 (the knees) and
// 35 degrees (the elbows) either side of their zero, with the reference's
// frames (each joint's frame on the parent turned so the joint's angle at
// the shape's rest is the reference's again, #202). A stiffer, steadier
// figure: the one the reference's sample drops.
human_tight_limits(shape: ptr) {
    tight = reference_tight_shape()
    i = 0
    while i < BONE_COUNT {
        spec = spec_at(shape, i)
        t = spec_at(tight, i)
        if spec.parent >= 0 {
            at_rest = math.inv_mul_quat(math.mul_quat(spec_at(tight, t.parent).reference.q, t.frame_a.q), math.mul_quat(t.reference.q, t.frame_b.q))
            on_bone = math.mul_quat(spec.reference.q, spec.frame_b.q)
            spec.frame_a.q = math.normalize_quat(math.inv_mul_quat(spec_at(shape, spec.parent).reference.q, math.mul_quat(on_bone, math.conjugate(at_rest))))
        }
        spec.swing_degrees = t.swing_degrees
        spec.lower_degrees = t.lower_degrees
        spec.upper_degrees = t.upper_degrees
        spec.cone_axis = t.cone_axis
        spec.swing_minor_degrees = t.swing_minor_degrees
        spec.cone_major_axis = t.cone_major_axis
        i = i + 1
    }
    destroy_shape(tight)
}

// A joint's frame on its parent turned onto its frame on the bone as the
// shape stands, so the two meet at the rest (#202). The cone stays where it
// was on the parent, as human_fit_shape keeps an off-axis one: turning the
// frame is a change of where the zero is read from, not of the range (#224).
// The reference's spine_01, spine_03 and neck frames sit 10 degrees forward
// of the rest, so their cones of 35, 35 and 30 degrees are centred 10
// forward of upright: the trunk flexes 90 over the two spine joints and
// extends 50, as a person's flexes further than it extends (AAOS 1965:
// thoracolumbar flexion 80, extension 25), and the neck flexes 40 and
// extends 20. Turned with the frame onto the rest, the trunk flexed 70 and
// extended 70, and the neck 30 each way. The turn at these joints is a
// swing alone (its twist under 0.0001 degrees), so the twist read about the
// kept centre is the reference's to 2e-6 rad, and the rest reads none. The
// limbs' cones are aimed afresh after this.
meet_at_rest(shape: ptr, index: int) {
    spec = spec_at(shape, index)
    parent = spec_at(shape, spec.parent)
    centre = math.rotate_vector(spec.frame_a.q, spec.cone_axis)
    // An ellipse whose major axis is left zero reaches along frame A's x:
    // kept as that, or it would turn with the frame while its centre stays.
    stored_major = spec.cone_major_axis
    if spec.swing_minor_degrees > 0.0 && math.length_squared(stored_major) == 0.0 { stored_major = math.vec3_axis_x() }
    major = math.rotate_vector(spec.frame_a.q, stored_major)
    spec.frame_a.q = math.normalize_quat(math.inv_mul_quat(parent.reference.q, math.mul_quat(spec.reference.q, spec.frame_b.q)))
    spec.cone_axis = math.inv_rotate_vector(spec.frame_a.q, centre)
    spec.cone_major_axis = math.inv_rotate_vector(spec.frame_a.q, major)
}

// A limb's twist range, `inward` and `outward` degrees about itself from
// the rest (internal and external rotation). Which sign is inward is the
// limb's handedness: seen with the limb hanging and its joint's z down the
// bone, a turn that swings a forward-pointing forearm toward the middle.
// Worked out from the shape (its side, up, forward and the way z runs
// along the bone), so a fitted or mirrored rig needs no rule by name.
aim_twist(shape: ptr, index: int, up: Vec3, forward: Vec3, inward: float, outward: float) {
    spec = spec_at(shape, index)
    parent = spec_at(shape, spec.parent)
    side = math.normalize(across(across(math.sub(spec.reference.p, parent.reference.p), up), forward))
    z = math.rotate_vector(math.mul_quat(spec.reference.q, spec.frame_b.q), math.vec3_axis_z())
    distal = math.neg(up)
    if math.dot(z, math.sub(human_shape_tail(shape, index), human_shape_head(shape, index))) < 0.0 { distal = up }
    if math.dot(math.cross(distal, forward), side) < 0.0 {
        spec.lower_degrees = 0.0 - outward
        spec.upper_degrees = inward
    } else {
        spec.lower_degrees = 0.0 - inward
        spec.upper_degrees = outward
    }
}

across(v: Vec3, axis: Vec3) -> Vec3 { return math.sub(v, math.mul_sv(math.dot(v, axis), axis)) }

// A bone's cone of `degrees` about a centre with parts `out` along the
// figure's side (away from the middle, from the parent's joint to the
// bone's), `along_up` along its up and `ahead` along its forward; the
// centre is held in the joint's frame on the parent.
aim_cone(shape: ptr, index: int, up: Vec3, forward: Vec3, degrees: float, out: float, along_up: float, ahead: float) {
    spec = spec_at(shape, index)
    parent = spec_at(shape, spec.parent)
    side = math.normalize(across(across(math.sub(spec.reference.p, parent.reference.p), up), forward))
    centre = math.normalize(math.add(math.add(math.mul_sv(out, side), math.mul_sv(along_up, up)), math.mul_sv(ahead, forward)))
    spec.cone_axis = math.inv_rotate_vector(math.mul_quat(parent.reference.q, spec.frame_a.q), centre)
    spec.swing_degrees = degrees
}

// A bone's elliptical cone from a person's ranges, degrees from hanging
// straight down: `ahead` and `back` along the figure's forward, `out` and
// `across` along its side. The ellipse is centred between each pair and
// passes through all four from straight down, so a bone swung straight
// out stops at `out` (an ellipse of half each sum would touch each range
// only half way along the other: a hip of 125/25 and 45/30 so centred
// lets a straight thigh out only 35 degrees, and reaches 45 flexed 50).
// Its major axis lies along the forward.
aim_ellipse(shape: ptr, index: int, up: Vec3, forward: Vec3, ahead: float, back: float, out: float, across_degrees: float) {
    spec = spec_at(shape, index)
    parent = spec_at(shape, spec.parent)
    side = math.normalize(across(across(math.sub(spec.reference.p, parent.reference.p), up), forward))
    down = math.neg(up)
    // The centre, turned from straight down by the two ranges' midpoints,
    // the forward and side parts of one rotation off the down.
    offset = math.add(math.mul_sv(0.5 * (ahead - back) * math.DEG_TO_RAD, forward), math.mul_sv(0.5 * (out - across_degrees) * math.DEG_TO_RAD, side))
    turn = math.length(offset)
    centre = down
    if turn > 0.0 {
        cs = math.compute_cos_sin(turn)
        centre = math.add(math.mul_sv(cs.cosine, down), math.mul_sv(cs.sine / turn, offset))
    }
    major = math.normalize(across(forward, centre))
    to_joint = math.mul_quat(parent.reference.q, spec.frame_a.q)
    spec.cone_axis = math.inv_rotate_vector(to_joint, math.normalize(centre))
    spec.cone_major_axis = math.inv_rotate_vector(to_joint, major)
    // The half-angles through the four points: with the centre (cf, cs)
    // off straight down, A^2 (1 - cs^2 / B^2) = hf^2 and
    // B^2 (1 - cf^2 / A^2) = hs^2, by a fixed point from the half-ranges.
    cf = 0.5 * (ahead - back)
    cs = 0.5 * (out - across_degrees)
    hf = 0.5 * (ahead + back)
    hs = 0.5 * (out + across_degrees)
    major_degrees = hf
    minor_degrees = hs
    iteration = 0
    while iteration < 32 {
        minor_degrees = hs / math.sqrt_float(math.max_float(1.0 - (cf * cf) / (major_degrees * major_degrees), 0.01))
        major_degrees = hf / math.sqrt_float(math.max_float(1.0 - (cs * cs) / (minor_degrees * minor_degrees), 0.01))
        iteration = iteration + 1
    }
    spec.swing_degrees = major_degrees
    spec.swing_minor_degrees = minor_degrees
}

// A hinge's frame of anatomy, unit and square: x along its parent bone's
// line, y the figure's forward across it (its up where the line runs
// forward), z their cross. A vector's parts in it, and back.
hinge_frame(shape: ptr, index: int) -> Matrix3 {
    parent = spec_at(shape, index).parent
    x = math.normalize(math.sub(human_shape_tail(shape, parent), human_shape_head(shape, parent)))
    up = figure_up(shape)
    y = across(figure_forward(shape, up), x)
    if math.length(y) < 0.1 { y = across(up, x) }
    y = math.normalize(y)
    return Matrix3 { cx: x, cy: y, cz: math.cross(x, y) }
}

in_hinge_frame(shape: ptr, index: int, v: Vec3) -> Vec3 {
    m = hinge_frame(shape, index)
    return math.vec3(math.dot(v, m.cx), math.dot(v, m.cy), math.dot(v, m.cz))
}

from_hinge_frame(shape: ptr, index: int, parts: Vec3) -> Vec3 {
    m = hinge_frame(shape, index)
    return math.normalize(math.add(math.add(math.mul_sv(parts.x, m.cx), math.mul_sv(parts.y, m.cy)), math.mul_sv(parts.z, m.cz)))
}

// A hinge's axis in the figure's space: its frame on the parent's z.
hinge_axis(shape: ptr, index: int) -> Vec3 {
    spec = spec_at(shape, index)
    return math.rotate_vector(math.mul_quat(spec_at(shape, spec.parent).reference.q, spec.frame_a.q), math.vec3_axis_z())
}

// How far a hinge is bent in the shape, radians: the bone's line from its
// parent's, turned about the hinge's axis (the joint's angle grows with it).
hinge_bend(shape: ptr, index: int) -> float {
    spec = spec_at(shape, index)
    axis = hinge_axis(shape, index)
    p = across(math.sub(human_shape_tail(shape, spec.parent), human_shape_head(shape, spec.parent)), axis)
    b = across(math.sub(human_shape_tail(shape, index), human_shape_head(shape, index)), axis)
    return math.atan2_approx(math.dot(axis, math.cross(p, b)), math.dot(p, b))
}

// A hinge that bends from straight to `degrees` the way `toward` says (the
// way the bone swings as it flexes: back for a knee, ahead for an elbow),
// never past straight; as joint angles, against the rest.
set_hinge(shape: ptr, index: int, toward: Vec3, degrees: float) {
    spec = spec_at(shape, index)
    parent = spec_at(shape, spec.parent)
    // The reference's frames need not meet at the rest: the joint's angle
    // there is its own, and straight lies the rest's bend back from it.
    at_rest = math.get_twist_angle(math.inv_mul_quat(math.mul_quat(parent.reference.q, math.normalize_quat(spec.frame_a.q)),
                                                     math.mul_quat(spec.reference.q, math.normalize_quat(spec.frame_b.q))))
    straight = (at_rest - hinge_bend(shape, index)) * math.RAD_TO_DEG
    line = math.sub(human_shape_tail(shape, spec.parent), human_shape_head(shape, spec.parent))
    if math.dot(hinge_axis(shape, index), math.cross(line, toward)) >= 0.0 {
        spec.lower_degrees = straight
        spec.upper_degrees = straight + degrees
    } else {
        spec.lower_degrees = straight - degrees
        spec.upper_degrees = straight
    }
}

// A capsule stretched by `along` on the line through its body's origin
// along `axis` (a unit vector, or zero for none), its radius by `girth`.
stretch(c: Capsule, axis: Vec3, along: float, girth: float) -> Capsule {
    c1 = math.mul_add(c.center1, (along - 1.0) * math.dot(c.center1, axis), axis)
    c2 = math.mul_add(c.center2, (along - 1.0) * math.dot(c.center2, axis), axis)
    return manifold.capsule(c1, c2, c.radius * girth)
}

// A calf's foot turned about the shin, so its toe, seen down the shin,
// points where the rig's toe does.
point_foot(spec: *BoneSpec, axis: Vec3, toe: Vec3, head: Vec3) {
    if !spec.has_foot || math.length(axis) < 0.5 { return }
    want = math.inv_rotate_vector(spec.reference.q, math.sub(toe, head))
    have = foot_toe(spec)
    want_flat = math.sub(want, math.mul_sv(math.dot(want, axis), axis))
    have_flat = math.sub(have, math.mul_sv(math.dot(have, axis), axis))
    if math.length(want_flat) < LINE_MIN || math.length(have_flat) < LINE_MIN { return }
    q = math.compute_quat_between_unit_vectors(math.normalize(have_flat), math.normalize(want_flat))
    spec.foot = manifold.capsule(math.rotate_vector(q, spec.foot.center1), math.rotate_vector(q, spec.foot.center2), spec.foot.radius)
}

// --- building one ----------------------------------------------------------------------------

// A bone's body and shapes: the body at its frame placed by `placement`,
// the capsule (and a calf's foot) with its material; the joint data on the bone.
place_bone(h: *Human, world_id: WorldId, index: int, placement: Transform, spec: *BoneSpec, user_data: ptr, group_index: int, foot_on_calf: bool) {
    bone = bone_at(h, index)
    bone.parent_index = spec.parent
    bone.reference_frame = spec.reference
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.user_data = user_data
    bdef.rotation = math.mul_quat(placement.q, spec.reference.q)
    bdef.position = math.transform_point(placement, spec.reference.p)
    bone.body_id = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    sdef.density = sdef.density * spec.density
    sdef.filter.group_index = spec.group * group_index
    sdef.base_material.friction = spec.friction
    sdef.base_material.rolling_resistance = 0.1
    // A calf whose foot is a bone of its own stops at the ankle, its cap
    // within the joint: as specified its cap reaches a radius past the
    // ankle, through the foot's place, and stands on the ground beside the
    // foot, so the shins would carry the figure (#174). Its spec keeps the
    // ankle, where the foot's joint is made.
    capsule = spec.capsule
    if spec.has_foot && foot_on_calf == false { capsule = short_of_ankle(spec.capsule) }
    bone.shape_id = dynamics.create_capsule_shape(bone.body_id, &sdef, capsule)
    bone.foot_shape_id = dynamics.null_shape_id()
    if spec.has_foot && foot_on_calf {
        fdef = dynamics.default_shape_def()
        fdef.base_material.friction = spec.foot_friction
        fdef.base_material.rolling_resistance = 0.1
        bone.foot_shape_id = dynamics.create_capsule_shape(bone.body_id, &fdef, spec.foot)
    }
    bone.joint_kind = spec.joint_kind
    bone.local_frame_a = spec.frame_a
    bone.local_frame_b = spec.frame_b
    bone.swing_limit = spec.swing_degrees * math.DEG_TO_RAD
    bone.twist_limit = Vec2 { x: spec.lower_degrees * math.DEG_TO_RAD, y: spec.upper_degrees * math.DEG_TO_RAD }
    bone.cone_axis = spec.cone_axis
    bone.swing_minor_limit = spec.swing_minor_degrees * math.DEG_TO_RAD
    bone.cone_major_axis = spec.cone_major_axis
    bone.joint_friction = spec.joint_friction
}

// A calf's capsule with its ankle end, the one farther from the knee,
// drawn in by its radius, so its cap ends at the ankle; one no longer than
// its radius collapses to its knee end (made a sphere, as any capsule that
// short is).
short_of_ankle(c: Capsule) -> Capsule {
    far_is_second = math.length(c.center2) > math.length(c.center1)
    knee = c.center2
    ankle = c.center1
    if far_is_second {
        knee = c.center1
        ankle = c.center2
    }
    along = math.sub(ankle, knee)
    span = math.length(along)
    if span <= 0.0 { return c }
    end = math.sub(ankle, math.mul_sv(math.min_float(c.radius, span) / span, along))
    if far_is_second { return manifold.capsule(knee, end, c.radius) }
    return manifold.capsule(end, knee, c.radius)
}

// A calf's foot as a bone of its own: a body in the calf's frame carrying
// the foot's capsule, on a spherical joint at the ankle (the far end of the
// calf's capsule as specified, where the built shin's cap ends, #174). The
// joint's frame looks down the foot (z from the ankle to the toe) with x
// the way the toes go down (the shin's line across the foot), so its
// elliptical cone reaches ANKLE_PLANTAR_DEGREES toward x and
// ANKLE_DORSAL_DEGREES back (a centre tipped toward x by half their
// difference), ANKLE_SIDE_DEGREES across, and its twist is the sole's roll.
// The foot rests in the calf's frame, so both frames are one at rest.
place_foot(h: *Human, world_id: WorldId, index: int, calf_index: int, placement: Transform, spec: *BoneSpec, user_data: ptr, group_index: int) {
    bone = bone_at(h, index)
    bone.parent_index = calf_index
    bone.reference_frame = spec.reference
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.user_data = user_data
    bdef.rotation = math.mul_quat(placement.q, spec.reference.q)
    bdef.position = math.transform_point(placement, spec.reference.p)
    bone.body_id = dynamics.create_body(world_id, &bdef)
    fdef = dynamics.default_shape_def()
    fdef.density = fdef.density * spec.density
    fdef.filter.group_index = spec.group * group_index
    fdef.base_material.friction = spec.foot_friction
    fdef.base_material.rolling_resistance = 0.1
    bone.shape_id = dynamics.create_capsule_shape(bone.body_id, &fdef, spec.foot)
    bone.foot_shape_id = bone.shape_id
    ankle = spec.capsule.center1
    if math.length(spec.capsule.center2) > math.length(ankle) { ankle = spec.capsule.center2 }
    z = math.normalize(math.sub(foot_toe(spec), ankle))
    shin = math.normalize(ankle)
    x = math.normalize(math.sub(shin, math.mul_sv(math.dot(shin, z), z)))
    y = math.cross(z, x)
    frame = Transform { p: ankle, q: math.make_quat_from_matrix(Matrix3 { cx: x, cy: y, cz: z }) }
    bone.joint_kind = dynamics.JOINT_SPHERICAL
    bone.local_frame_a = frame
    bone.local_frame_b = frame
    tilt = 0.5 * (ANKLE_PLANTAR_DEGREES - ANKLE_DORSAL_DEGREES) * math.DEG_TO_RAD
    bone.cone_axis = math.vec3(sin(tilt), 0.0, cos(tilt))
    bone.swing_limit = 0.5 * (ANKLE_PLANTAR_DEGREES + ANKLE_DORSAL_DEGREES) * math.DEG_TO_RAD
    bone.swing_minor_limit = ANKLE_SIDE_DEGREES * math.DEG_TO_RAD
    bone.cone_major_axis = math.vec3_zero()
    bone.twist_limit = Vec2 { x: 0.0 - ANKLE_ROLL_DEGREES * math.DEG_TO_RAD, y: ANKLE_ROLL_DEGREES * math.DEG_TO_RAD }
    bone.joint_friction = ANKLE_FRICTION
}

// The reference's figure standing at `position`.
create_human(h: *Human, world_id: WorldId, position: Vec3, friction_torque: float, hertz: float, damping_ratio: float, group_index: int, user_data: ptr) {
    shape = human_reference_shape()
    create_human_shaped(h, world_id, Transform { p: position, q: math.quat_identity() }, shape, friction_torque, hertz, damping_ratio, group_index, user_data)
    destroy_shape(shape)
}

// A figure of a shape, its space put in the world by `placement`.
create_human_shaped(h: *Human, world_id: WorldId, placement: Transform, shape: ptr, friction_torque: float, hertz: float, damping_ratio: float, group_index: int, user_data: ptr) {
    // A figure is made whole or not at all: refused inputs leave it
    // unspawned. One already spawned is not made over (its bodies would
    // be lost to it): it is destroyed first.
    if h.is_spawned { return }
    if dynamics.world_is_valid(world_id) == false || shape == null || math.is_valid_world_transform(placement) == false { return }
    if valid_nonnegative(friction_torque) == false || valid_nonnegative(hertz) == false || valid_nonnegative(damping_ratio) == false { return }
    // Ankles need a foot on each calf to stand on.
    if h.ankles && (spec_at(shape, BONE_CALF_L).has_foot == false || spec_at(shape, BONE_CALF_R).has_foot == false) { return }
    h.bone_count = BONE_COUNT
    if h.ankles { h.bone_count = ANKLED_BONE_COUNT }
    if has_extras(h) { h.bone_count = MAX_BONE_COUNT }
    h.bones = basics.alloc(h.bone_count * sizeof(HumanBone))
    h.filter_joints = basics.alloc(MAX_FILTER_JOINT_COUNT * sizeof(JointId))
    h.filter_joint_count = 0
    i = 0
    while i < h.bone_count {
        bone = bone_at(h, i)
        bone.body_id = dynamics.null_body_id()
        bone.anchor_id = dynamics.null_body_id()
        bone.joint_id = dynamics.null_joint_id()
        bone.anchor_joint_id = dynamics.null_joint_id()
        bone.shape_id = dynamics.null_shape_id()
        bone.foot_shape_id = dynamics.null_shape_id()
        bone.cone_axis = math.vec3_axis_z()
        bone.swing_minor_limit = 0.0
        bone.cone_major_axis = math.vec3_zero()
        bone.joint_friction = 1.0
        bone.parent_index = 0 - 1
        i = i + 1
    }
    filters = h.filter_joints as JointId[]
    i = 0
    while i < MAX_FILTER_JOINT_COUNT {
        filters[i] = dynamics.null_joint_id()
        i = i + 1
    }
    h.friction_torque = friction_torque
    specs = shape as BoneSpec[]
    i = 0
    while i < BONE_COUNT {
        spec = specs[i]
        spec.capsule = given_up_capsule(h, i, spec.capsule)
        place_bone(h, world_id, i, placement, &spec, user_data, group_index, h.ankles == false)
        i = i + 1
    }
    if h.ankles {
        place_foot(h, world_id, BONE_FOOT_L, BONE_CALF_L, placement, spec_at(shape, BONE_CALF_L), user_data, group_index)
        place_foot(h, world_id, BONE_FOOT_R, BONE_CALF_R, placement, spec_at(shape, BONE_CALF_R), user_data, group_index)
    }
    i = BONE_HEAD
    while i < MAX_BONE_COUNT {
        if asks_for_bone(h, i) { place_bone(h, world_id, i, placement, spec_at(shape, i), user_data, group_index, true) }
        i = i + 1
    }
    // A bone the world refused (a full world, a shape spec out of range)
    // would leave a figure missing a limb that every later call reaches
    // for: what was made is taken down and the figure stays unspawned.
    i = 0
    while i < h.bone_count {
        if asks_for_bone(h, i) && dynamics.body_is_valid(bone_at(h, i).body_id) == false {
            take_down(h)
            return
        }
        i = i + 1
    }
    // The extra bones between the reference's: the upper arms hang from
    // the clavicles, the chest rides spine_02 (the two sharing the chest
    // joint's range), and the twisting hinges take the elbows and knees.
    if h.clavicles {
        hang_from(h, shape, BONE_UPPER_ARM_L, BONE_CLAVICLE_L)
        hang_from(h, shape, BONE_UPPER_ARM_R, BONE_CLAVICLE_R)
    }
    if h.spine_02 {
        hang_from(h, shape, BONE_SPINE_03, BONE_SPINE_02)
        chest = bone_at(h, BONE_SPINE_03)
        chest.swing_limit = 0.5 * chest.swing_limit
        chest.swing_minor_limit = 0.5 * chest.swing_minor_limit
        chest.twist_limit = Vec2 { x: 0.5 * chest.twist_limit.x, y: 0.5 * chest.twist_limit.y }
    }
    if h.twist {
        twisting_hinge(h, shape, BONE_LOWER_ARM_L, ELBOW_TWIST_DEGREES)
        twisting_hinge(h, shape, BONE_LOWER_ARM_R, ELBOW_TWIST_DEGREES)
        twisting_hinge(h, shape, BONE_CALF_L, KNEE_TWIST_DEGREES)
        twisting_hinge(h, shape, BONE_CALF_R, KNEE_TWIST_DEGREES)
    }

    // The joints: a spring toward the reference pose when asked, the
    // motor's torque limit as friction, the limits as the rig allows.
    i = 1
    while i < h.bone_count {
        if asks_for_bone(h, i) { make_joint(h, world_id, i, hertz, damping_ratio, friction_torque) }
        i = i + 1
    }
    // The thighs pass each other and the head the shoulders; with the
    // extra bones, the head the chest and the shoulders, the clavicles
    // each other and the neck, and each bone the one it no longer hangs
    // from or was set between (hang_from).
    add_filter(h, world_id, BONE_THIGH_L, BONE_THIGH_R)
    add_filter(h, world_id, BONE_NECK, BONE_UPPER_ARM_L)
    add_filter(h, world_id, BONE_NECK, BONE_UPPER_ARM_R)
    if h.head {
        add_filter(h, world_id, BONE_HEAD, BONE_SPINE_03)
        add_filter(h, world_id, BONE_HEAD, BONE_UPPER_ARM_L)
        add_filter(h, world_id, BONE_HEAD, BONE_UPPER_ARM_R)
    }
    if h.clavicles {
        add_filter(h, world_id, BONE_CLAVICLE_L, BONE_CLAVICLE_R)
        add_filter(h, world_id, BONE_CLAVICLE_L, BONE_NECK)
        add_filter(h, world_id, BONE_CLAVICLE_R, BONE_NECK)
        add_filter(h, world_id, BONE_UPPER_ARM_L, BONE_SPINE_03)
        add_filter(h, world_id, BONE_UPPER_ARM_R, BONE_SPINE_03)
        if h.head {
            add_filter(h, world_id, BONE_HEAD, BONE_CLAVICLE_L)
            add_filter(h, world_id, BONE_HEAD, BONE_CLAVICLE_R)
        }
    }
    if h.spine_02 {
        add_filter(h, world_id, BONE_SPINE_01, BONE_SPINE_03)
        add_filter(h, world_id, BONE_PELVIS, BONE_SPINE_02)
    }
    h.is_spawned = true
}

// A bone's capsule as built: the reference's, but the neck gives the head
// to a head bone (keeping a short neck below it, three quarters of the
// head's girth: a person's neck carries the head, so it is no twig),
// a forearm the hand to a hand bone (ending at the wrist's side of the
// hand), and spine_01 the upper lumbar to spine_02 (keeping the lower,
// of a girth that holds the trunk's mass).
given_up_capsule(h: *Human, index: int, c: Capsule) -> Capsule {
    if h.head && index == BONE_NECK {
        near = near_end(c)
        return manifold.capsule(math.mul_sv(0.2, near), math.mul_sv(0.7, near), 0.75 * c.radius)
    }
    if h.hands && (index == BONE_LOWER_ARM_L || index == BONE_LOWER_ARM_R) {
        if math.length(c.center2) > math.length(c.center1) { return manifold.capsule(c.center1, math.mul_sv(0.67, c.center2), c.radius) }
        return manifold.capsule(math.mul_sv(0.67, c.center1), c.center2, c.radius)
    }
    if h.spine_02 && index == BONE_SPINE_01 {
        return manifold.capsule(math.mul_sv(0.48, c.center1), math.mul_sv(0.48, c.center2), 0.79 * c.radius)
    }
    return c
}

// A bone's joint moved to a new parent between it and its old one: its
// frame on the parent re-read on the new one, the same frame in the
// figure, so its rest, cone and twist are what they were.
hang_from(h: *Human, shape: ptr, index: int, parent_index: int) {
    bone = bone_at(h, index)
    in_figure = math.mul_transforms(spec_at(shape, bone.parent_index).reference, bone.local_frame_a)
    bone.local_frame_a = math.inv_mul_transforms(spec_at(shape, parent_index).reference, in_figure)
    bone.parent_index = parent_index
}

// A hinge that twists (#190): the elbow or knee as a spherical joint whose
// cone is the hinge's range of bend -- a circle about the middle of the
// bend from its lower angle to its upper, its minor locked so the bone
// swings only along the bend's arc (joint_solver.spherical_joint_lock_cone_minor,
// as UE5's locked swing; an ellipse that narrow chatters) -- and whose
// twist is the bone turning about itself, `twist_degrees` either way.
// The joint's frames are one at rest: z the bone's line across the hinge's
// axis (so bending sweeps z along a great circle), y the hinge's axis.
twisting_hinge(h: *Human, shape: ptr, index: int, twist_degrees: float) {
    spec = spec_at(shape, index)
    parent = spec_at(shape, spec.parent)
    axis = hinge_axis(shape, index)
    z = math.normalize(across(math.sub(human_shape_tail(shape, index), human_shape_head(shape, index)), axis))
    frame = math.make_quat_from_matrix(Matrix3 { cx: math.cross(axis, z), cy: axis, cz: z })
    // The hinge's limits are joint angles, and the reference's frames do
    // not meet at the rest: the range against the rest is the limits less
    // the angle there.
    at_rest = math.get_twist_angle(math.inv_mul_quat(math.mul_quat(parent.reference.q, math.normalize_quat(spec.frame_a.q)),
                                                     math.mul_quat(spec.reference.q, math.normalize_quat(spec.frame_b.q))))
    lower = spec.lower_degrees * math.DEG_TO_RAD
    upper = spec.upper_degrees * math.DEG_TO_RAD
    middle = 0.5 * (lower + upper) - at_rest
    bone = bone_at(h, index)
    bone.joint_kind = dynamics.JOINT_SPHERICAL
    bone.local_frame_a = Transform { p: spec.frame_a.p, q: math.inv_mul_quat(parent.reference.q, frame) }
    bone.local_frame_b = Transform { p: spec.frame_b.p, q: math.inv_mul_quat(spec.reference.q, frame) }
    bone.cone_axis = math.vec3(sin(middle), 0.0, cos(middle))
    bone.cone_major_axis = math.vec3(cos(middle), 0.0, 0.0 - sin(middle))
    bone.swing_limit = 0.5 * (upper - lower)
    bone.swing_minor_limit = 0.0
    bone.twist_limit = Vec2 { x: 0.0 - twist_degrees * math.DEG_TO_RAD, y: twist_degrees * math.DEG_TO_RAD }
}

// A bone's joint to its parent: a spring toward the reference pose when
// asked, the motor's torque limit as friction, the limits as the rig allows.
make_joint(h: *Human, world_id: WorldId, i: int, hertz: float, damping_ratio: float, friction_torque: float) {
    bone = bone_at(h, i)
    parent = bone_at(h, bone.parent_index)
    bone.local_frame_a.q = math.normalize_quat(bone.local_frame_a.q)
    bone.local_frame_b.q = math.normalize_quat(bone.local_frame_b.q)
    if bone.joint_kind == dynamics.JOINT_REVOLUTE {
        rdef = dynamics.default_revolute_joint_def()
        rdef.base.body_id_a = parent.body_id
        rdef.base.body_id_b = bone.body_id
        rdef.base.local_frame_a = bone.local_frame_a
        rdef.base.local_frame_b = bone.local_frame_b
        rdef.enable_limit = true
        rdef.lower_angle = bone.twist_limit.x
        rdef.upper_angle = bone.twist_limit.y
        rdef.enable_spring = hertz > 0.0
        rdef.hertz = hertz
        rdef.damping_ratio = damping_ratio
        rdef.enable_motor = true
        rdef.max_motor_torque = bone.joint_friction * friction_torque
        bone.joint_id = dynamics.create_revolute_joint(world_id, &rdef)
    } else {
        sdef = dynamics.default_spherical_joint_def()
        sdef.base.body_id_a = parent.body_id
        sdef.base.body_id_b = bone.body_id
        sdef.base.local_frame_a = bone.local_frame_a
        sdef.base.local_frame_b = bone.local_frame_b
        sdef.enable_cone_limit = true
        sdef.cone_angle = bone.swing_limit
        sdef.cone_axis = bone.cone_axis
        sdef.cone_minor_angle = bone.swing_minor_limit
        sdef.cone_major_axis = bone.cone_major_axis
        sdef.enable_twist_limit = true
        sdef.lower_twist_angle = bone.twist_limit.x
        sdef.upper_twist_angle = bone.twist_limit.y
        sdef.enable_spring = hertz > 0.0
        sdef.hertz = hertz
        sdef.damping_ratio = damping_ratio
        sdef.enable_motor = true
        sdef.max_motor_torque = bone.joint_friction * friction_torque
        bone.joint_id = dynamics.create_spherical_joint(world_id, &sdef)
        if h.twist && is_hinge_bone(i) { joint_solver.spherical_joint_lock_cone_minor(bone.joint_id, true) }
    }
}

// The elbows and knees, the hinges a twisting figure turns into twisting hinges.
is_hinge_bone(index: int) -> bool {
    return index == BONE_LOWER_ARM_L || index == BONE_LOWER_ARM_R || index == BONE_CALF_L || index == BONE_CALF_R
}

add_filter(h: *Human, world_id: WorldId, a: int, b: int) {
    fdef = dynamics.default_filter_joint_def()
    fdef.base.body_id_a = bone_at(h, a).body_id
    fdef.base.body_id_b = bone_at(h, b).body_id
    filters = h.filter_joints as JointId[]
    filters[h.filter_joint_count] = dynamics.create_filter_joint(world_id, &fdef)
    h.filter_joint_count = h.filter_joint_count + 1
}

// A finite number at or above zero.
valid_nonnegative(x: float) -> bool { return math.is_valid_float(x) && x >= 0.0 }

// The joints, then the bodies (and their anchors), then the blocks.
// Nothing happens for a figure not spawned.
destroy_human(h: *Human) {
    if h.is_spawned { take_down(h) }
}

take_down(h: *Human) {
    filters = h.filter_joints as JointId[]
    i = 0
    while i < h.filter_joint_count {
        dynamics.destroy_joint(filters[i], false)
        i = i + 1
    }
    i = 0
    while i < h.bone_count {
        bone = bone_at(h, i)
        if dynamics.joint_is_valid(bone.joint_id) { dynamics.destroy_joint(bone.joint_id, false) }
        if dynamics.joint_is_valid(bone.anchor_joint_id) { dynamics.destroy_joint(bone.anchor_joint_id, false) }
        i = i + 1
    }
    i = 0
    while i < h.bone_count {
        bone = bone_at(h, i)
        if dynamics.body_is_valid(bone.body_id) { dynamics.destroy_body(bone.body_id) }
        if dynamics.body_is_valid(bone.anchor_id) { dynamics.destroy_body(bone.anchor_id) }
        i = i + 1
    }
    basics.free_bytes(h.bones, h.bone_count * sizeof(HumanBone))
    basics.free_bytes(h.filter_joints, MAX_FILTER_JOINT_COUNT * sizeof(JointId))
    h.bones = null
    h.filter_joints = null
    h.filter_joint_count = 0
    h.is_spawned = false
}

human_set_velocity(h: *Human, velocity: Vec3) {
    if h.is_spawned == false { return }
    i = 0
    while i < h.bone_count {
        bone = bone_at(h, i)
        if dynamics.body_is_valid(bone.body_id) { dynamics.body_set_linear_velocity(bone.body_id, velocity) }
        i = i + 1
    }
}

// A kick at the lower spine (the reference draws a random one; the caller picks it here).
human_apply_angular_impulse(h: *Human, impulse: Vec3) {
    if h.is_spawned == false { return }
    dynamics.body_apply_angular_impulse(bone_at(h, BONE_SPINE_01).body_id, impulse, true)
}

human_set_joint_friction_torque(h: *Human, torque: float) {
    if h.is_spawned == false || valid_nonnegative(torque) == false { return }
    h.friction_torque = torque
    i = 1
    while i < h.bone_count {
        bone = bone_at(h, i)
        if human_has_bone(h, i) && bone.joint_kind == dynamics.JOINT_REVOLUTE {
            joint_solver.revolute_joint_set_max_motor_torque(bone.joint_id, bone.joint_friction * torque)
        } else if human_has_bone(h, i) {
            joint_solver.spherical_joint_set_max_motor_torque(bone.joint_id, bone.joint_friction * torque)
        }
        i = i + 1
    }
}

human_set_joint_spring_hertz(h: *Human, hertz: float) {
    if h.is_spawned == false { return }
    i = 1
    while i < h.bone_count {
        bone = bone_at(h, i)
        if human_has_bone(h, i) && bone.joint_kind == dynamics.JOINT_REVOLUTE {
            joint_solver.revolute_joint_set_spring_hertz(bone.joint_id, hertz)
        } else if human_has_bone(h, i) {
            joint_solver.spherical_joint_set_spring_hertz(bone.joint_id, hertz)
        }
        i = i + 1
    }
}

human_set_joint_damping_ratio(h: *Human, damping_ratio: float) {
    if h.is_spawned == false { return }
    i = 1
    while i < h.bone_count {
        bone = bone_at(h, i)
        if human_has_bone(h, i) && bone.joint_kind == dynamics.JOINT_REVOLUTE {
            joint_solver.revolute_joint_set_spring_damping_ratio(bone.joint_id, damping_ratio)
        } else if human_has_bone(h, i) {
            joint_solver.spherical_joint_set_spring_damping_ratio(bone.joint_id, damping_ratio)
        }
        i = i + 1
    }
}

// A parallel joint from the ground to the pelvis that springs the figure
// upright: the frames align the ground's y with the pelvis's z. Called
// again it replaces the spring it made before.
human_align_spring(h: *Human, world_id: WorldId, ground_id: BodyId, hertz: float, damping_ratio: float) {
    if h.is_spawned == false { return }
    bone = bone_at(h, BONE_PELVIS)
    if dynamics.joint_is_valid(bone.joint_id) { dynamics.destroy_joint(bone.joint_id, true) }
    q = math.compute_quat_between_unit_vectors(math.vec3_axis_z(), math.vec3_axis_y())
    qb = dynamics.body_get_rotation(bone.body_id)
    pdef = dynamics.default_parallel_joint_def()
    pdef.base.body_id_a = ground_id
    pdef.base.body_id_b = bone.body_id
    pdef.base.local_frame_a.q = q
    pdef.base.local_frame_b.q = math.inv_mul_quat(qb, q)
    pdef.base.draw_scale = 2.0
    pdef.base.collide_connected = true
    pdef.hertz = hertz
    pdef.damping_ratio = damping_ratio
    bone.joint_id = dynamics.create_parallel_joint(world_id, &pdef)
}

// The align spring let go: the figure falls as a ragdoll would.
human_release_align_spring(h: *Human) {
    if h.is_spawned == false { return }
    bone = bone_at(h, BONE_PELVIS)
    if dynamics.joint_is_valid(bone.joint_id) { dynamics.destroy_joint(bone.joint_id, true) }
    bone.joint_id = dynamics.null_joint_id()
}

// A kinematic anchor per bone at its pose, holding the bone through a
// motor joint's position and rotation springs: move the anchors and the
// figure follows (the pose drive of an active ragdoll).
human_create_motor_anchors(h: *Human, world_id: WorldId) {
    // One set of anchors at a time: a second would hold the bones twice
    // and lose the first to the figure.
    if h.is_spawned == false || human_has_anchors(h) { return }
    adef = dynamics.default_body_def()
    adef.kind = dynamics.BODY_KINEMATIC
    mdef = dynamics.default_motor_joint_def()
    mdef.angular_hertz = 5.0
    mdef.angular_damping_ratio = 1.0
    mdef.linear_hertz = 5.0
    mdef.linear_damping_ratio = 1.0
    mdef.max_spring_force = math.MAX_FLOAT
    mdef.max_spring_torque = math.MAX_FLOAT
    i = 0
    while i < h.bone_count {
        if human_has_bone(h, i) {
            bone = bone_at(h, i)
            xf = dynamics.body_get_transform(bone.body_id)
            adef.position = xf.p
            adef.rotation = xf.q
            bone.anchor_id = dynamics.create_body(world_id, &adef)
            mdef.base.body_id_a = bone.anchor_id
            mdef.base.body_id_b = bone.body_id
            bone.anchor_joint_id = dynamics.create_motor_joint(world_id, &mdef)
        }
        i = i + 1
    }
}

// The same anchors through parallel joints: rotation only, with a torque limit.
human_create_parallel_anchors(h: *Human, world_id: WorldId) {
    // One set of anchors at a time: a second would hold the bones twice
    // and lose the first to the figure.
    if h.is_spawned == false || human_has_anchors(h) { return }
    adef = dynamics.default_body_def()
    adef.kind = dynamics.BODY_KINEMATIC
    q_frame_world = math.compute_quat_between_unit_vectors(math.vec3_axis_z(), math.vec3_axis_y())
    pdef = dynamics.default_parallel_joint_def()
    pdef.hertz = 8.0
    pdef.damping_ratio = 1.0
    // The reference's 800 N m. Box3D capped the parallel joint's half-angle
    // rows, so its figure's anchors applied at most about 400; here the cap
    // is the torque applied (#211), so these hold up to the 800 it names.
    pdef.max_torque = 800.0
    i = 0
    while i < h.bone_count {
        if human_has_bone(h, i) {
            bone = bone_at(h, i)
            xf = dynamics.body_get_transform(bone.body_id)
            adef.position = xf.p
            adef.rotation = xf.q
            bone.anchor_id = dynamics.create_body(world_id, &adef)
            pdef.base.body_id_a = bone.anchor_id
            pdef.base.body_id_b = bone.body_id
            frame_q = math.inv_mul_quat(xf.q, q_frame_world)
            pdef.base.local_frame_a.q = frame_q
            pdef.base.local_frame_b.q = frame_q
            bone.anchor_joint_id = dynamics.create_parallel_joint(world_id, &pdef)
        }
        i = i + 1
    }
}

// Whether the figure is held by anchors of either kind.
human_has_anchors(h: *Human) -> bool {
    if h.is_spawned == false { return false }
    return dynamics.body_is_valid(bone_at(h, BONE_PELVIS).anchor_id)
}

// A bone's anchor driven to a pose over the step: the kinematic anchor
// moves there at the velocity that gets it there in one step, and the
// bone follows through its joint's springs. The pose drive of an active
// ragdoll: an animation sets the anchors every step and the figure walks
// as the animation does, colliding as the ragdoll it is. Nothing happens
// for a bone without an anchor.
human_set_anchor_target(h: *Human, index: int, target: Transform, time_step: float) {
    if h.is_spawned == false || index < 0 || index >= h.bone_count { return }
    bone = bone_at(h, index)
    if dynamics.body_is_valid(bone.anchor_id) == false { return }
    dynamics.body_set_target_transform(bone.anchor_id, target, time_step, true)
}

// The anchors let go, leaving the figure a ragdoll: every anchor joint
// and body destroyed, the bones' slots cleared.
human_destroy_anchors(h: *Human) {
    if h.is_spawned == false { return }
    i = 0
    while i < h.bone_count {
        bone = bone_at(h, i)
        if dynamics.joint_is_valid(bone.anchor_joint_id) { dynamics.destroy_joint(bone.anchor_joint_id, true) }
        if dynamics.body_is_valid(bone.anchor_id) { dynamics.destroy_body(bone.anchor_id) }
        bone.anchor_joint_id = dynamics.null_joint_id()
        bone.anchor_id = dynamics.null_body_id()
        i = i + 1
    }
}

human_set_bullet(h: *Human, flag: bool) {
    if h.is_spawned == false { return }
    i = 0
    while i < h.bone_count {
        if human_has_bone(h, i) { dynamics.body_set_bullet(bone_at(h, i).body_id, flag) }
        i = i + 1
    }
}
