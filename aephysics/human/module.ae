// aephysics.human -- a ragdoll: twelve bones (pelvis, two spine
// segments, the neck with the head, thighs, calves with their feet,
// upper and lower arms) as capsules on dynamic bodies, joined by
// spherical joints with cone and twist limits (the spine, neck,
// shoulders, hips) and revolute joints with angle limits (the elbows,
// the knees), each with a spring toward its reference pose and a motor
// whose torque limit acts as joint friction; filter joints keep the
// thighs from each other and the head from the shoulders. The bones'
// reference frames and joint frames are the reference's, measured from
// its rigged figure -- or a rig's: human_fit_shape puts the reference's
// joints at a rig's and its lines along the rig's, so a figure whose
// spine curves is built curved, standing in its bind pose. Its joints
// move as a person's do (human_anatomical_limits: shoulders that reach
// overhead, hips that kneel, knees and elbows that never bend past
// straight) unless human_tight_limits puts back the reference's, and its
// soles grip the ground.
//
// This is Box3D's shared/human.c (Erin Catto, MIT): CreateHuman is
// create_human, Human_SetJointFrictionTorque is
// set_joint_friction_torque. Beyond the reference's sample it is the
// ground for an active ragdoll: the springs and motors are the pose
// drive, the anchors (a kinematic body per bone through a motor or
// parallel joint) are the pose target, and the torque limits are the
// muscle budget; design.md's research note says what comes next.
import std.string
import aephysics.math
import aephysics.basics
import aephysics.manifold
import aephysics.material
import aephysics.shape
import aephysics.dynamics
import aephysics.joint_solver

exports (
    BONE_PELVIS, BONE_SPINE_01, BONE_SPINE_03, BONE_NECK, BONE_THIGH_L, BONE_CALF_L, BONE_THIGH_R, BONE_CALF_R,
    BONE_UPPER_ARM_L, BONE_LOWER_ARM_L, BONE_UPPER_ARM_R, BONE_LOWER_ARM_R, BONE_COUNT, FILTER_JOINT_COUNT,
    HumanBone, Human, BoneSpec, bone_at, filter_joint_at, spec_at,
    human_reference_shape, human_anatomical_limits, human_tight_limits, human_chain_child, human_shape_head, human_shape_tail, human_shape_toe, human_fit_shape, create_human_shaped,
    create_human, destroy_human, human_set_velocity, human_apply_angular_impulse, human_set_joint_friction_torque,
    human_set_joint_spring_hertz, human_set_joint_damping_ratio, human_align_spring, human_create_motor_anchors,
    human_create_parallel_anchors, human_destroy_anchors, human_has_anchors, human_set_anchor_target, human_set_bullet
)

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const BONE_PELVIS = 0
const BONE_SPINE_01 = 1
const BONE_SPINE_03 = 2
const BONE_NECK = 3
const BONE_THIGH_L = 4
const BONE_CALF_L = 5
const BONE_THIGH_R = 6
const BONE_CALF_R = 7
const BONE_UPPER_ARM_L = 8
const BONE_LOWER_ARM_L = 9
const BONE_UPPER_ARM_R = 10
const BONE_LOWER_ARM_R = 11
const BONE_COUNT = 12
const FILTER_JOINT_COUNT = 3

// One bone: its body, the joint to its parent, the anchor a pose drive
// hangs it from, the joint's frames on parent and bone, the bone's
// frame in the reference pose, and the joint's limits and friction.
// Its own capsule (the shin's on a calf, which carries the foot too:
// a body lists its shapes newest first, so the first it lists is the
// foot) and the foot's, a null id on every other bone.
struct HumanBone {
    body_id: BodyId
    joint_id: JointId
    anchor_id: BodyId
    anchor_joint_id: JointId
    local_frame_a: Transform
    local_frame_b: Transform
    reference_frame: Transform
    joint_kind: int                // dynamics.JOINT_SPHERICAL or JOINT_REVOLUTE; PARALLEL for none
    swing_limit: float             // the spherical cone
    twist_limit: Vec2              // the twist's or the hinge's angles
    joint_friction: float          // this joint's share of the friction torque
    parent_index: int
    shape_id: ShapeId              // the bone's own capsule
    foot_shape_id: ShapeId         // a calf's foot; null on the rest
    cone_axis: Vec3                // the cone's centre in local_frame_a
}

// The ragdoll: a heap block of bones and filter joints (create allocates, destroy frees).
struct Human {
    bones: ptr                     // HumanBone[BONE_COUNT]
    filter_joints: ptr             // JointId[FILTER_JOINT_COUNT]
    filter_joint_count: int
    friction_torque: float
    is_spawned: bool
}

bone_at(h: *Human, index: int) -> *HumanBone { return (h.bones + index * sizeof(HumanBone)) as *HumanBone }
filter_joint_at(h: *Human, index: int) -> JointId { return (h.filter_joints as JointId[])[index] }

transform_of(px: float, py: float, pz: float, qx: float, qy: float, qz: float, qs: float) -> Transform {
    return Transform { p: math.vec3(px, py, pz), q: math.quat_vs(math.vec3(qx, qy, qz), qs) }
}

// A bone as a figure's shape has it: its frame in the figure's own space
// (the joint to its parent at the origin), its capsule in that frame and,
// on a calf, its foot's; the joint's frames on parent and bone, limits
// and friction; and the filter group, surface friction and density.
struct BoneSpec {
    parent: int
    reference: Transform
    group: int                     // the filter group: 0, or -group_index to keep limbs from their neighbours
    friction: float
    capsule: Capsule
    joint_kind: int
    frame_a: Transform
    frame_b: Transform
    swing_degrees: float           // the cone's half angle
    lower_degrees: float           // the twist's or the hinge's range, against the rest
    upper_degrees: float
    joint_friction: float
    density: float                 // a scale on the default density
    has_foot: bool
    foot: Capsule
    foot_friction: float           // the sole's
    cone_axis: Vec3                // the cone's centre in the joint's frame on the parent: z, the rest, or off it
}

// A figure's shape is BONE_COUNT BoneSpecs in one heap block: the
// reference's from human_reference_shape, a rig's once human_fit_shape
// has fitted it, and create_human_shaped builds either. The caller frees
// it with free().
spec_at(shape: ptr, index: int) -> *BoneSpec { return (shape + index * sizeof(BoneSpec)) as *BoneSpec }
set_spec(shape: ptr, index: int, spec: BoneSpec) { (shape as BoneSpec[])[index] = spec }

no_foot() -> Capsule { return manifold.capsule(math.vec3(0.0, 0.0, 0.0), math.vec3(0.0, 0.0, 0.0), 0.0) }

// The reference's figure with a body's reach: its frames, capsules and
// masses as the reference measured them, its joints given the ranges of
// human_anatomical_limits (human_tight_limits puts back the reference's)
// and its shins and soles a grip on the ground.
human_reference_shape() -> ptr {
    shape = reference_tight_shape()
    human_anatomical_limits(shape)
    return shape
}

// The reference's shins slide at 0.1 and its soles too: a figure pushed
// skates on them. A shin grips as a thigh does; a sole as a boot on dry
// ground.
const SHIN_FRICTION = 0.6
const FOOT_FRICTION = 0.9

// The reference's figure, bone by bone (its frames measured from the rig,
// its limits the reference's: cones about the rest, hinges either side of it).
reference_tight_shape() -> ptr {
    shape = calloc(BONE_COUNT, sizeof(BoneSpec))
    no_joint = math.transform_identity()
    on_axis = math.vec3_axis_z()
    set_spec(shape, BONE_PELVIS, BoneSpec {
        parent: 0 - 1, reference: transform_of(0.0, 0.996219, 0.0 - 0.023868, 1.0, 0.0, 0.0, 0.0), group: 0, friction: 0.6,
        capsule: manifold.capsule(math.vec3(0.04, 0.000001, 0.0), math.vec3(0.0 - 0.04, 0.0 - 0.000001, 0.0), 0.15),
        joint_kind: dynamics.JOINT_PARALLEL, frame_a: no_joint, frame_b: no_joint, swing_degrees: 0.0, lower_degrees: 0.0, upper_degrees: 0.0, joint_friction: 1.0,
        density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis })
    set_spec(shape, BONE_SPINE_01, BoneSpec {
        parent: BONE_PELVIS, reference: transform_of(0.0, 1.017288, 0.0 - 0.024882, 1.0, 0.0, 0.0, 0.0), group: 0 - 1, friction: 0.5,
        capsule: manifold.capsule(math.vec3(0.029876, 0.0 - 0.146581, 0.00626), math.vec3(0.0 - 0.029876, 0.0 - 0.146574, 0.00626), 0.145663),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.0, 0.0 - 0.021069, 0.001014, 0.0 - 0.642737, 0.0, 0.0, 0.0 - 0.766087),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.707107, 0.0, 0.0, 0.0 - 0.707107),
        swing_degrees: 35.0, lower_degrees: 0.0 - 17.5, upper_degrees: 17.5, joint_friction: 1.0, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis })
    set_spec(shape, BONE_SPINE_03, BoneSpec {
        parent: BONE_SPINE_01, reference: transform_of(0.0, 1.267766, 0.0 - 0.02232, 1.0, 0.0, 0.0, 0.0), group: 0, friction: 0.5,
        capsule: manifold.capsule(math.vec3(0.063996, 0.0 - 0.117434, 0.0 - 0.040199), math.vec3(0.0 - 0.063996, 0.0 - 0.117432, 0.0 - 0.040199), 0.165004),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.0, 0.0 - 0.250478, 0.0 - 0.002562, 0.0 - 0.642766, 0.0, 0.0, 0.0 - 0.766063),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.707107, 0.0, 0.0, 0.0 - 0.707107),
        swing_degrees: 35.0, lower_degrees: 0.0 - 17.5, upper_degrees: 17.5, joint_friction: 1.0, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis })
    set_spec(shape, BONE_NECK, BoneSpec {
        parent: BONE_SPINE_03, reference: transform_of(0.0, 1.498783, 0.024462, 0.987879, 0.0, 0.0, 0.155228), group: 0, friction: 0.2,
        capsule: manifold.capsule(math.vec3(0.0, 0.0 - 0.21234, 0.0), math.vec3(0.0, 0.0 - 0.08734, 0.0), 0.11),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.0, 0.0 - 0.231017, 0.0 - 0.046781, 0.0 - 0.516157, 0.0 - 0.000002, 0.000003, 0.0 - 0.856494),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.707108, 0.0 - 0.000002, 0.000002, 0.0 - 0.707106),
        swing_degrees: 30.0, lower_degrees: 0.0 - 17.5, upper_degrees: 17.5, joint_friction: 1.0, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis })
    set_spec(shape, BONE_THIGH_L, BoneSpec {
        parent: BONE_PELVIS, reference: transform_of(0.092175, 0.971562, 0.0 - 0.011177, 0.471412, 0.52951, 0.0 - 0.499888, 0.0 - 0.497495), group: 0 - 1, friction: 0.6,
        capsule: manifold.capsule(math.vec3(0.0 - 0.047269, 0.000001, 0.0), math.vec3(0.0 - 0.379769, 0.000005, 0.0), 0.091539),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.092175, 0.024656, 0.0 - 0.012691, 0.0 - 0.460186, 0.0 - 0.365368, 0.0 - 0.637662, 0.498118),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.499997, 0.0 - 0.500003, 0.500002, 0.499998),
        swing_degrees: 30.0, lower_degrees: 0.0 - 10.0, upper_degrees: 10.0, joint_friction: 1.0, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis })
    // The calves carry the shins at half density and the feet at full.
    set_spec(shape, BONE_CALF_L, BoneSpec {
        parent: BONE_THIGH_L, reference: transform_of(0.11872, 0.534541, 0.0 - 0.035362, 0.521188, 0.480597, 0.0 - 0.54638, 0.0 - 0.445935), group: 0, friction: SHIN_FRICTION,
        capsule: manifold.capsule(math.vec3(0.0 - 0.445, 0.000001, 0.0), math.vec3(0.005, 0.0 - 0.000001, 0.0), 0.08),
        joint_kind: dynamics.JOINT_REVOLUTE,
        frame_a: transform_of(0.0 - 0.438494, 0.0 - 0.000175, 0.0, 0.344866, 0.0 - 0.938652, 0.000002, 0.0 - 0.000008),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.008182, 0.0 - 0.999967, 0.000001, 0.0 - 0.000007),
        swing_degrees: 0.0, lower_degrees: 0.0 - 30.0, upper_degrees: 30.0, joint_friction: 1.0, density: 0.5,
        has_foot: true, foot: manifold.capsule(math.vec3(0.0 - 0.456371, 0.129321, 0.000013), math.vec3(0.0 - 0.359977, 0.014394, 0.000013), 0.07), foot_friction: FOOT_FRICTION, cone_axis: on_axis })
    set_spec(shape, BONE_THIGH_R, BoneSpec {
        parent: BONE_PELVIS, reference: transform_of(0.0 - 0.092175, 0.971562, 0.0 - 0.011177, 0.0 - 0.497495, 0.499888, 0.52951, 0.0 - 0.471412), group: 0 - 1, friction: 0.6,
        capsule: manifold.capsule(math.vec3(0.047269, 0.0 - 0.000001, 0.0), math.vec3(0.379769, 0.0 - 0.000005, 0.0), 0.092587),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.0 - 0.092175, 0.024656, 0.0 - 0.012691, 0.380666, 0.491846, 0.488644, 0.0 - 0.611889),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.500002, 0.499998, 0.0 - 0.499998, 0.500002),
        swing_degrees: 30.0, lower_degrees: 0.0 - 10.0, upper_degrees: 10.0, joint_friction: 1.0, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis })
    set_spec(shape, BONE_CALF_R, BoneSpec {
        parent: BONE_THIGH_R, reference: transform_of(0.0 - 0.11872, 0.534541, 0.0 - 0.035362, 0.0 - 0.445935, 0.54638, 0.480597, 0.0 - 0.521188), group: 0, friction: SHIN_FRICTION,
        capsule: manifold.capsule(math.vec3(0.445, 0.0 - 0.000002, 0.000003), math.vec3(0.0 - 0.005, 0.0, 0.000003), 0.08),
        joint_kind: dynamics.JOINT_REVOLUTE,
        frame_a: transform_of(0.438494, 0.000175, 0.0, 0.000007, 0.000005, 0.0 - 0.34486, 0.0 - 0.938654),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.000006, 0.000005, 0.008188, 0.0 - 0.999966),
        swing_degrees: 0.0, lower_degrees: 0.0 - 30.0, upper_degrees: 30.0, joint_friction: 1.0, density: 0.5,
        has_foot: true, foot: manifold.capsule(math.vec3(0.369113, 0.0 - 0.00683, 0.000017), math.vec3(0.465507, 0.0 - 0.121757, 0.000017), 0.07), foot_friction: FOOT_FRICTION, cone_axis: on_axis })
    set_spec(shape, BONE_UPPER_ARM_L, BoneSpec {
        parent: BONE_SPINE_03, reference: transform_of(0.185817, 1.44363, 0.031306, 0.56022, 0.0 - 0.307179, 0.366233, 0.0 - 0.676512), group: 0, friction: 0.6,
        capsule: manifold.capsule(math.vec3(0.296038, 0.004386, 0.0 - 0.000794), math.vec3(0.0 - 0.016086, 0.004384, 0.0 - 0.016127), 0.065),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.185817, 0.0 - 0.175865, 0.0 - 0.053625, 0.0 - 0.559466, 0.0 - 0.213784, 0.0 - 0.670199, 0.438323),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.500953, 0.0 - 0.502617, 0.0 - 0.509318, 0.0 - 0.486844),
        swing_degrees: 45.0, lower_degrees: 0.0 - 20.0, upper_degrees: 20.0, joint_friction: 0.8, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis })
    set_spec(shape, BONE_LOWER_ARM_L, BoneSpec {
        parent: BONE_UPPER_ARM_L, reference: transform_of(0.347683, 1.193455, 0.029378, 0.406736, 0.0 - 0.493012, 0.089135, 0.0 - 0.763911), group: 0, friction: 0.3,
        capsule: manifold.capsule(math.vec3(0.312329, 0.0 - 0.008256, 0.0 - 0.016454), math.vec3(0.033153, 0.008259, 0.0 - 0.002741), 0.06),
        joint_kind: dynamics.JOINT_REVOLUTE,
        frame_a: transform_of(0.297979, 0.000361, 0.0, 0.916726, 0.399352, 0.000839, 0.0 - 0.011456),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.999922, 0.0 - 0.003857, 0.004659, 0.0 - 0.010908),
        swing_degrees: 0.0, lower_degrees: 0.0 - 35.0, upper_degrees: 35.0, joint_friction: 0.06, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis })
    set_spec(shape, BONE_UPPER_ARM_R, BoneSpec {
        parent: BONE_SPINE_03, reference: transform_of(0.0 - 0.185817, 1.44363, 0.031306, 0.676512, 0.366233, 0.307179, 0.56022), group: 0, friction: 0.6,
        capsule: manifold.capsule(math.vec3(0.0 - 0.300237, 0.0 - 0.000001, 0.0 - 0.000319), math.vec3(0.011887, 0.000001, 0.015013), 0.065),
        joint_kind: dynamics.JOINT_SPHERICAL,
        frame_a: transform_of(0.0 - 0.185817, 0.0 - 0.175865, 0.0 - 0.053625, 0.213793, 0.559449, 0.438334, 0.0 - 0.670204),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.509319, 0.486843, 0.500954, 0.0 - 0.502617),
        swing_degrees: 45.0, lower_degrees: 0.0 - 20.0, upper_degrees: 20.0, joint_friction: 0.8, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis })
    set_spec(shape, BONE_LOWER_ARM_R, BoneSpec {
        parent: BONE_UPPER_ARM_R, reference: transform_of(0.0 - 0.347683, 1.193455, 0.029378, 0.763911, 0.089135, 0.493012, 0.406736), group: 0, friction: 0.3,
        capsule: manifold.capsule(math.vec3(0.0 - 0.312649, 0.0 - 0.000003, 0.016471), math.vec3(0.0 - 0.032986, 0.0, 0.002732), 0.06),
        joint_kind: dynamics.JOINT_REVOLUTE,
        frame_a: transform_of(0.0 - 0.297979, 0.0 - 0.000361, 0.0, 0.0 - 0.405444, 0.914059, 0.010541, 0.000852),
        frame_b: transform_of(0.0, 0.0, 0.0, 0.0 - 0.002794, 0.999936, 0.010042, 0.004364),
        swing_degrees: 0.0, lower_degrees: 0.0 - 35.0, upper_degrees: 35.0, joint_friction: 0.06, density: 1.0, has_foot: false, foot: no_foot(), foot_friction: 0.0, cone_axis: on_axis })
    return shape
}

// --- a shape's landmarks, and a shape fitted to a rig's --------------------------------------------

// A bone's next along the chain the figure is measured by -- the spine up
// to the neck, each leg to its calf, each arm to its forearm -- or -1 for
// the neck, the calves and the forearms, which end their chains.
human_chain_child(index: int) -> int {
    if index == BONE_PELVIS { return BONE_SPINE_01 }
    if index == BONE_SPINE_01 { return BONE_SPINE_03 }
    if index == BONE_SPINE_03 { return BONE_NECK }
    if index == BONE_THIGH_L { return BONE_CALF_L }
    if index == BONE_THIGH_R { return BONE_CALF_R }
    if index == BONE_UPPER_ARM_L { return BONE_LOWER_ARM_L }
    if index == BONE_UPPER_ARM_R { return BONE_LOWER_ARM_R }
    return 0 - 1
}

// A bone's head in the figure's space: its joint to its parent, its body's origin.
human_shape_head(shape: ptr, index: int) -> Vec3 { return spec_at(shape, index).reference.p }

// A bone's tail: where the line it is measured by ends -- its next
// joint along the chain, or for a bone that ends one the end of its own
// capsule farther from its joint: a calf's at the ankle, a forearm's
// past the wrist (it carries the hand), the neck's at the head's middle.
human_shape_tail(shape: ptr, index: int) -> Vec3 {
    child = human_chain_child(index)
    if child >= 0 { return spec_at(shape, child).reference.p }
    spec = spec_at(shape, index)
    far = spec.capsule.center1
    if math.length(spec.capsule.center2) > math.length(far) { far = spec.capsule.center2 }
    return math.transform_point(spec.reference, far)
}

// A calf's foot's toe end in the figure's space: the end of the foot's
// capsule farther off the shin's line.
human_shape_toe(shape: ptr, index: int) -> Vec3 {
    spec = spec_at(shape, index)
    return math.transform_point(spec.reference, foot_toe(spec))
}

foot_toe(spec: *BoneSpec) -> Vec3 {
    axis = math.normalize(math.sub(spec.capsule.center2, spec.capsule.center1))
    if off_line(spec.foot.center2, spec.capsule.center1, axis) > off_line(spec.foot.center1, spec.capsule.center1, axis) { return spec.foot.center2 }
    return spec.foot.center1
}

off_line(p: Vec3, origin: Vec3, axis: Vec3) -> float {
    d = math.sub(p, origin)
    return math.length(math.sub(d, math.mul_sv(math.dot(d, axis), axis)))
}

// Whether a bone's tail measures its own length. The neck's capsule
// carries the head and a forearm's the hand, past the joints a rig names
// their tails by, so those two take their parent's scale; the pelvis's
// line, two centimetres to the spine's joint, the figure's.
measures_length(index: int) -> bool {
    return index != BONE_PELVIS && index != BONE_NECK && index != BONE_LOWER_ARM_L && index != BONE_LOWER_ARM_R
}

// Shorter than this, a line has no direction to fit to.
const LINE_MIN = 0.005

// A shape fitted to a figure: every bone's joint put at `heads[i]` and
// turned so its line runs to `tails[i]` (both Vec3[BONE_COUNT], in the
// figure's space, landmarks as human_shape_head and human_shape_tail
// name them), and so the rig's bind pose is the shape's rest pose.
// A bone's capsule is stretched along its line by the length its tail
// measures (by its parent's where it measures none), every radius by
// the figure's size against the reference's; a calf's foot rides the
// shin and, when `toes` (Vec3[2]: left, right) is not null, is turned
// about the shin so its toe points the rig's way. Each joint's frame on
// the parent turns with the bone, so the joint's rest angle -- what its
// spring and its limits are taken from -- is what it was.
human_fit_shape(shape: ptr, heads: ptr, tails: ptr, toes: ptr) {
    head_at = heads as Vec3[]
    tail_at = tails as Vec3[]
    turns = calloc(BONE_COUNT, sizeof(Quat))
    turn = turns as Quat[]
    olds = calloc(BONE_COUNT, sizeof(Quat))
    old = olds as Quat[]
    units = calloc(BONE_COUNT, sizeof(Vec3))
    unit = units as Vec3[]
    scales = calloc(BONE_COUNT, 8)
    scale = scales as float[]
    bends = calloc(BONE_COUNT, 8)
    bend = bends as float[]
    reference_total = 0.0
    fitted_total = 0.0
    i = 0
    while i < BONE_COUNT {
        spec = spec_at(shape, i)
        old[i] = spec.reference.q
        line = math.sub(human_shape_tail(shape, i), spec.reference.p)
        fitted = math.sub(tail_at[i], head_at[i])
        reference_length = math.length(line)
        fitted_length = math.length(fitted)
        turn[i] = math.quat_identity()
        unit[i] = math.vec3(0.0, 0.0, 0.0)
        scale[i] = 0.0
        bend[i] = 0.0
        if spec.joint_kind == dynamics.JOINT_REVOLUTE { bend[i] = hinge_bend(shape, i) }
        if reference_length > LINE_MIN {
            unit[i] = math.inv_rotate_vector(spec.reference.q, math.mul_sv(1.0 / reference_length, line))
            if fitted_length > LINE_MIN {
                turn[i] = math.compute_quat_between_unit_vectors(math.mul_sv(1.0 / reference_length, line), math.mul_sv(1.0 / fitted_length, fitted))
                if measures_length(i) {
                    scale[i] = fitted_length / reference_length
                    reference_total = reference_total + reference_length
                    fitted_total = fitted_total + fitted_length
                }
            }
        }
        i = i + 1
    }
    figure = 1.0
    if reference_total > 0.0 { figure = fitted_total / reference_total }
    // Parents come before children in the bones' order.
    i = 0
    while i < BONE_COUNT {
        spec = spec_at(shape, i)
        if scale[i] == 0.0 {
            scale[i] = figure
            if spec.parent >= 0 { scale[i] = scale[spec.parent] }
        }
        spec.reference = Transform { p: head_at[i], q: math.normalize_quat(math.mul_quat(turn[i], old[i])) }
        spec.capsule = stretch(spec.capsule, unit[i], scale[i], figure)
        if spec.has_foot { spec.foot = stretch(spec.foot, unit[i], scale[i], figure) }
        if spec.parent >= 0 {
            parent = spec_at(shape, spec.parent)
            centre = math.rotate_vector(spec.frame_a.q, spec.cone_axis)
            spec.frame_a.p = math.inv_rotate_vector(parent.reference.q, math.sub(head_at[i], head_at[spec.parent]))
            spec.frame_a.q = math.normalize_quat(math.inv_mul_quat(parent.reference.q, math.mul_quat(turn[i], math.mul_quat(old[spec.parent], spec.frame_a.q))))
            // A cone centred off the rest stays where it was on the parent;
            // one about the rest turns with it, as the reference's does.
            if cone_off_axis(spec.cone_axis) { spec.cone_axis = math.inv_rotate_vector(spec.frame_a.q, centre) }
        }
        i = i + 1
    }
    if toes != null {
        toe_at = toes as Vec3[]
        point_foot(spec_at(shape, BONE_CALF_L), unit[BONE_CALF_L], toe_at[0], head_at[BONE_CALF_L])
        point_foot(spec_at(shape, BONE_CALF_R), unit[BONE_CALF_R], toe_at[1], head_at[BONE_CALF_R])
    }
    // A hinge's range is held against the rest; the rig's rest bends the
    // joint more or less than the reference's, so the range moves by the
    // difference and still ends where it did: straight stays straight.
    i = 0
    while i < BONE_COUNT {
        spec = spec_at(shape, i)
        if spec.joint_kind == dynamics.JOINT_REVOLUTE {
            shift = (bend[i] - hinge_bend(shape, i)) * math.RAD_TO_DEG
            spec.lower_degrees = spec.lower_degrees + shift
            spec.upper_degrees = spec.upper_degrees + shift
        }
        i = i + 1
    }
    free(turns)
    free(olds)
    free(units)
    free(scales)
    free(bends)
}

cone_off_axis(axis: Vec3) -> bool { return axis.x != 0.0 || axis.y != 0.0 || axis.z <= 0.0 }

// --- a body's reach ----------------------------------------------------------------------------

// The ranges a person's joints move through. A shoulder lifts the arm
// ahead and overhead (flexion past 180 degrees), out to the side and over
// the head (abduction), and 55 degrees back (extension): one cone of 120
// degrees whose centre leans forward, down and out from the rest -- and
// turns the arm 60 degrees either way about itself, as a person's does
// (the reference's frames sit 15 degrees apart at the rest, so a raise
// read against them twists the arm on the way up). A hip
// lifts the thigh 125 degrees for kneeling and sitting and takes it 25
// back: a cone of 78 leaning forward and out. A knee bends from straight
// to 150 degrees and an elbow to 145, neither past straight. The spine,
// the neck and the other twists keep the reference's. Measured on the shape as
// it stands -- forward the way its toes point, up from the pelvis to the
// neck, out from a limb's parent to its joint -- so a fitted shape takes
// them as well as the reference's.
const SHOULDER_CONE = 120.0
const SHOULDER_TWIST = 60.0
const HIP_CONE = 78.0
const KNEE_FLEXION = 150.0
const ELBOW_FLEXION = 145.0

human_anatomical_limits(shape: ptr) {
    up = math.normalize(math.sub(human_shape_head(shape, BONE_NECK), human_shape_head(shape, BONE_PELVIS)))
    toes = math.add(math.sub(human_shape_toe(shape, BONE_CALF_L), human_shape_tail(shape, BONE_CALF_L)),
                    math.sub(human_shape_toe(shape, BONE_CALF_R), human_shape_tail(shape, BONE_CALF_R)))
    forward = math.normalize(across(toes, up))
    aim_cone(shape, BONE_UPPER_ARM_L, up, forward, SHOULDER_CONE, 0.3, 0.0 - 0.4, 0.866)
    aim_cone(shape, BONE_UPPER_ARM_R, up, forward, SHOULDER_CONE, 0.3, 0.0 - 0.4, 0.866)
    spec_at(shape, BONE_UPPER_ARM_L).lower_degrees = 0.0 - SHOULDER_TWIST
    spec_at(shape, BONE_UPPER_ARM_L).upper_degrees = SHOULDER_TWIST
    spec_at(shape, BONE_UPPER_ARM_R).lower_degrees = 0.0 - SHOULDER_TWIST
    spec_at(shape, BONE_UPPER_ARM_R).upper_degrees = SHOULDER_TWIST
    aim_cone(shape, BONE_THIGH_L, up, forward, HIP_CONE, 0.3, 0.0 - 0.62, 0.725)
    aim_cone(shape, BONE_THIGH_R, up, forward, HIP_CONE, 0.3, 0.0 - 0.62, 0.725)
    set_hinge(shape, BONE_CALF_L, math.neg(forward), KNEE_FLEXION)
    set_hinge(shape, BONE_CALF_R, math.neg(forward), KNEE_FLEXION)
    set_hinge(shape, BONE_LOWER_ARM_L, forward, ELBOW_FLEXION)
    set_hinge(shape, BONE_LOWER_ARM_R, forward, ELBOW_FLEXION)
}

// The reference's limits put back on a shape: cones about the rest (45
// degrees at the shoulders, 30 at the hips) and hinges 30 (the knees) and
// 35 degrees (the elbows) either side of it. A stiffer, steadier figure:
// the one the reference's sample drops.
human_tight_limits(shape: ptr) {
    tight = reference_tight_shape()
    i = 0
    while i < BONE_COUNT {
        spec = spec_at(shape, i)
        t = spec_at(tight, i)
        spec.swing_degrees = t.swing_degrees
        spec.lower_degrees = t.lower_degrees
        spec.upper_degrees = t.upper_degrees
        spec.cone_axis = t.cone_axis
        i = i + 1
    }
    free(tight)
}

across(v: Vec3, axis: Vec3) -> Vec3 { return math.sub(v, math.mul_sv(math.dot(v, axis), axis)) }

// A bone's cone of `degrees` about a centre with parts `out` along the
// figure's side (away from the middle, from the parent's joint to the
// bone's), `along_up` along its up and `ahead` along its forward; the
// centre is held in the joint's frame on the parent.
aim_cone(shape: ptr, index: int, up: Vec3, forward: Vec3, degrees: float, out: float, along_up: float, ahead: float) {
    spec = spec_at(shape, index)
    parent = spec_at(shape, spec.parent)
    side = math.normalize(across(across(math.sub(spec.reference.p, parent.reference.p), up), forward))
    centre = math.normalize(math.add(math.add(math.mul_sv(out, side), math.mul_sv(along_up, up)), math.mul_sv(ahead, forward)))
    spec.cone_axis = math.inv_rotate_vector(math.mul_quat(parent.reference.q, spec.frame_a.q), centre)
    spec.swing_degrees = degrees
}

// A hinge's axis in the figure's space: its frame on the parent's z.
hinge_axis(shape: ptr, index: int) -> Vec3 {
    spec = spec_at(shape, index)
    return math.rotate_vector(math.mul_quat(spec_at(shape, spec.parent).reference.q, spec.frame_a.q), math.vec3_axis_z())
}

// How far a hinge is bent in the shape, radians: the bone's line from its
// parent's, turned about the hinge's axis (the joint's angle grows with it).
hinge_bend(shape: ptr, index: int) -> float {
    spec = spec_at(shape, index)
    axis = hinge_axis(shape, index)
    p = across(math.sub(human_shape_tail(shape, spec.parent), human_shape_head(shape, spec.parent)), axis)
    b = across(math.sub(human_shape_tail(shape, index), human_shape_head(shape, index)), axis)
    return math.atan2_approx(math.dot(axis, math.cross(p, b)), math.dot(p, b))
}

// A hinge that bends from straight to `degrees` the way `toward` says (the
// way the bone swings as it flexes: back for a knee, ahead for an elbow),
// never past straight; as joint angles, against the rest.
set_hinge(shape: ptr, index: int, toward: Vec3, degrees: float) {
    spec = spec_at(shape, index)
    parent = spec_at(shape, spec.parent)
    // The reference's frames need not meet at the rest: the joint's angle
    // there is its own, and straight lies the rest's bend back from it.
    at_rest = math.get_twist_angle(math.inv_mul_quat(math.mul_quat(parent.reference.q, math.normalize_quat(spec.frame_a.q)),
                                                     math.mul_quat(spec.reference.q, math.normalize_quat(spec.frame_b.q))))
    straight = (at_rest - hinge_bend(shape, index)) * math.RAD_TO_DEG
    line = math.sub(human_shape_tail(shape, spec.parent), human_shape_head(shape, spec.parent))
    if math.dot(hinge_axis(shape, index), math.cross(line, toward)) >= 0.0 {
        spec.lower_degrees = straight
        spec.upper_degrees = straight + degrees
    } else {
        spec.lower_degrees = straight - degrees
        spec.upper_degrees = straight
    }
}

// A capsule stretched by `along` on the line through its body's origin
// along `axis` (a unit vector, or zero for none), its radius by `girth`.
stretch(c: Capsule, axis: Vec3, along: float, girth: float) -> Capsule {
    c1 = math.mul_add(c.center1, (along - 1.0) * math.dot(c.center1, axis), axis)
    c2 = math.mul_add(c.center2, (along - 1.0) * math.dot(c.center2, axis), axis)
    return manifold.capsule(c1, c2, c.radius * girth)
}

// A calf's foot turned about the shin, so its toe, seen down the shin,
// points where the rig's toe does.
point_foot(spec: *BoneSpec, axis: Vec3, toe: Vec3, head: Vec3) {
    if !spec.has_foot || math.length(axis) < 0.5 { return }
    want = math.inv_rotate_vector(spec.reference.q, math.sub(toe, head))
    have = foot_toe(spec)
    want_flat = math.sub(want, math.mul_sv(math.dot(want, axis), axis))
    have_flat = math.sub(have, math.mul_sv(math.dot(have, axis), axis))
    if math.length(want_flat) < LINE_MIN || math.length(have_flat) < LINE_MIN { return }
    q = math.compute_quat_between_unit_vectors(math.normalize(have_flat), math.normalize(want_flat))
    spec.foot = manifold.capsule(math.rotate_vector(q, spec.foot.center1), math.rotate_vector(q, spec.foot.center2), spec.foot.radius)
}

// --- building one ----------------------------------------------------------------------------

// A bone's body and shapes: the body at its frame placed by `placement`,
// the capsule (and a calf's foot) with its material; the joint data on the bone.
place_bone(h: *Human, world_id: WorldId, index: int, placement: Transform, spec: *BoneSpec, user_data: ptr, group_index: int) {
    bone = bone_at(h, index)
    bone.parent_index = spec.parent
    bone.reference_frame = spec.reference
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.user_data = user_data
    bdef.rotation = math.mul_quat(placement.q, spec.reference.q)
    bdef.position = math.transform_point(placement, spec.reference.p)
    bone.body_id = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    sdef.density = sdef.density * spec.density
    sdef.filter.group_index = spec.group * group_index
    sdef.base_material.friction = spec.friction
    sdef.base_material.rolling_resistance = 0.1
    bone.shape_id = dynamics.create_capsule_shape(bone.body_id, &sdef, spec.capsule)
    bone.foot_shape_id = dynamics.null_shape_id()
    if spec.has_foot {
        fdef = dynamics.default_shape_def()
        fdef.base_material.friction = spec.foot_friction
        fdef.base_material.rolling_resistance = 0.1
        bone.foot_shape_id = dynamics.create_capsule_shape(bone.body_id, &fdef, spec.foot)
    }
    bone.joint_kind = spec.joint_kind
    bone.local_frame_a = spec.frame_a
    bone.local_frame_b = spec.frame_b
    bone.swing_limit = spec.swing_degrees * math.DEG_TO_RAD
    bone.twist_limit = Vec2 { x: spec.lower_degrees * math.DEG_TO_RAD, y: spec.upper_degrees * math.DEG_TO_RAD }
    bone.cone_axis = spec.cone_axis
    bone.joint_friction = spec.joint_friction
}

// The reference's figure standing at `position`.
create_human(h: *Human, world_id: WorldId, position: Vec3, friction_torque: float, hertz: float, damping_ratio: float, group_index: int, user_data: ptr) {
    shape = human_reference_shape()
    create_human_shaped(h, world_id, Transform { p: position, q: math.quat_identity() }, shape, friction_torque, hertz, damping_ratio, group_index, user_data)
    free(shape)
}

// A figure of a shape, its space put in the world by `placement`.
create_human_shaped(h: *Human, world_id: WorldId, placement: Transform, shape: ptr, friction_torque: float, hertz: float, damping_ratio: float, group_index: int, user_data: ptr) {
    // A figure is made whole or not at all: refused inputs leave it unspawned.
    h.is_spawned = false
    if dynamics.world_is_valid(world_id) == false || shape == null || math.is_valid_world_transform(placement) == false { return }
    if valid_nonnegative(friction_torque) == false || valid_nonnegative(hertz) == false || valid_nonnegative(damping_ratio) == false { return }
    h.bones = calloc(BONE_COUNT, sizeof(HumanBone))
    h.filter_joints = calloc(FILTER_JOINT_COUNT, sizeof(JointId))
    h.filter_joint_count = 0
    i = 0
    while i < BONE_COUNT {
        bone = bone_at(h, i)
        bone.body_id = dynamics.null_body_id()
        bone.anchor_id = dynamics.null_body_id()
        bone.joint_id = dynamics.null_joint_id()
        bone.anchor_joint_id = dynamics.null_joint_id()
        bone.shape_id = dynamics.null_shape_id()
        bone.foot_shape_id = dynamics.null_shape_id()
        bone.cone_axis = math.vec3_axis_z()
        bone.joint_friction = 1.0
        bone.parent_index = 0 - 1
        i = i + 1
    }
    filters = h.filter_joints as JointId[]
    i = 0
    while i < FILTER_JOINT_COUNT {
        filters[i] = dynamics.null_joint_id()
        i = i + 1
    }
    h.friction_torque = friction_torque
    i = 0
    while i < BONE_COUNT {
        place_bone(h, world_id, i, placement, spec_at(shape, i), user_data, group_index)
        i = i + 1
    }
    // A bone the world refused (a full world, a shape spec out of range)
    // would leave a figure missing a limb that every later call reaches
    // for: what was made is taken down and the figure stays unspawned.
    i = 0
    while i < BONE_COUNT {
        if dynamics.body_is_valid(bone_at(h, i).body_id) == false {
            destroy_human(h)
            return
        }
        i = i + 1
    }

    // The joints: a spring toward the reference pose when asked, the
    // motor's torque limit as friction, the limits as the rig allows.
    i = 1
    while i < BONE_COUNT {
        bone = bone_at(h, i)
        parent = bone_at(h, bone.parent_index)
        bone.local_frame_a.q = math.normalize_quat(bone.local_frame_a.q)
        bone.local_frame_b.q = math.normalize_quat(bone.local_frame_b.q)
        if bone.joint_kind == dynamics.JOINT_REVOLUTE {
            rdef = dynamics.default_revolute_joint_def()
            rdef.base.body_id_a = parent.body_id
            rdef.base.body_id_b = bone.body_id
            rdef.base.local_frame_a = bone.local_frame_a
            rdef.base.local_frame_b = bone.local_frame_b
            rdef.enable_limit = true
            rdef.lower_angle = bone.twist_limit.x
            rdef.upper_angle = bone.twist_limit.y
            rdef.enable_spring = hertz > 0.0
            rdef.hertz = hertz
            rdef.damping_ratio = damping_ratio
            rdef.enable_motor = true
            rdef.max_motor_torque = bone.joint_friction * friction_torque
            bone.joint_id = dynamics.create_revolute_joint(world_id, &rdef)
        } else {
            sdef = dynamics.default_spherical_joint_def()
            sdef.base.body_id_a = parent.body_id
            sdef.base.body_id_b = bone.body_id
            sdef.base.local_frame_a = bone.local_frame_a
            sdef.base.local_frame_b = bone.local_frame_b
            sdef.enable_cone_limit = true
            sdef.cone_angle = bone.swing_limit
            sdef.cone_axis = bone.cone_axis
            sdef.enable_twist_limit = true
            sdef.lower_twist_angle = bone.twist_limit.x
            sdef.upper_twist_angle = bone.twist_limit.y
            sdef.enable_spring = hertz > 0.0
            sdef.hertz = hertz
            sdef.damping_ratio = damping_ratio
            sdef.enable_motor = true
            sdef.max_motor_torque = bone.joint_friction * friction_torque
            bone.joint_id = dynamics.create_spherical_joint(world_id, &sdef)
        }
        i = i + 1
    }
    // The thighs pass each other and the head the shoulders.
    add_filter(h, world_id, BONE_THIGH_L, BONE_THIGH_R)
    add_filter(h, world_id, BONE_NECK, BONE_UPPER_ARM_L)
    add_filter(h, world_id, BONE_NECK, BONE_UPPER_ARM_R)
    h.is_spawned = true
}

add_filter(h: *Human, world_id: WorldId, a: int, b: int) {
    fdef = dynamics.default_filter_joint_def()
    fdef.base.body_id_a = bone_at(h, a).body_id
    fdef.base.body_id_b = bone_at(h, b).body_id
    filters = h.filter_joints as JointId[]
    filters[h.filter_joint_count] = dynamics.create_filter_joint(world_id, &fdef)
    h.filter_joint_count = h.filter_joint_count + 1
}

// A finite number at or above zero.
valid_nonnegative(x: float) -> bool { return math.is_valid_float(x) && x >= 0.0 }

// The joints, then the bodies (and their anchors), then the blocks.
destroy_human(h: *Human) {
    filters = h.filter_joints as JointId[]
    i = 0
    while i < h.filter_joint_count {
        dynamics.destroy_joint(filters[i], false)
        i = i + 1
    }
    i = 0
    while i < BONE_COUNT {
        bone = bone_at(h, i)
        if dynamics.joint_is_valid(bone.joint_id) { dynamics.destroy_joint(bone.joint_id, false) }
        if dynamics.joint_is_valid(bone.anchor_joint_id) { dynamics.destroy_joint(bone.anchor_joint_id, false) }
        i = i + 1
    }
    i = 0
    while i < BONE_COUNT {
        bone = bone_at(h, i)
        if dynamics.body_is_valid(bone.body_id) { dynamics.destroy_body(bone.body_id) }
        if dynamics.body_is_valid(bone.anchor_id) { dynamics.destroy_body(bone.anchor_id) }
        i = i + 1
    }
    free(h.bones)
    free(h.filter_joints)
    h.bones = null
    h.filter_joints = null
    h.filter_joint_count = 0
    h.is_spawned = false
}

human_set_velocity(h: *Human, velocity: Vec3) {
    i = 0
    while i < BONE_COUNT {
        bone = bone_at(h, i)
        if dynamics.body_is_valid(bone.body_id) { dynamics.body_set_linear_velocity(bone.body_id, velocity) }
        i = i + 1
    }
}

// A kick at the lower spine (the reference draws a random one; the caller picks it here).
human_apply_angular_impulse(h: *Human, impulse: Vec3) {
    dynamics.body_apply_angular_impulse(bone_at(h, BONE_SPINE_01).body_id, impulse, true)
}

human_set_joint_friction_torque(h: *Human, torque: float) {
    h.friction_torque = torque
    i = 1
    while i < BONE_COUNT {
        bone = bone_at(h, i)
        if bone.joint_kind == dynamics.JOINT_REVOLUTE {
            joint_solver.revolute_joint_set_max_motor_torque(bone.joint_id, bone.joint_friction * torque)
        } else {
            joint_solver.spherical_joint_set_max_motor_torque(bone.joint_id, bone.joint_friction * torque)
        }
        i = i + 1
    }
}

human_set_joint_spring_hertz(h: *Human, hertz: float) {
    i = 1
    while i < BONE_COUNT {
        bone = bone_at(h, i)
        if bone.joint_kind == dynamics.JOINT_REVOLUTE {
            joint_solver.revolute_joint_set_spring_hertz(bone.joint_id, hertz)
        } else {
            joint_solver.spherical_joint_set_spring_hertz(bone.joint_id, hertz)
        }
        i = i + 1
    }
}

human_set_joint_damping_ratio(h: *Human, damping_ratio: float) {
    i = 1
    while i < BONE_COUNT {
        bone = bone_at(h, i)
        if bone.joint_kind == dynamics.JOINT_REVOLUTE {
            joint_solver.revolute_joint_set_spring_damping_ratio(bone.joint_id, damping_ratio)
        } else {
            joint_solver.spherical_joint_set_spring_damping_ratio(bone.joint_id, damping_ratio)
        }
        i = i + 1
    }
}

// A parallel joint from the ground to the pelvis that springs the figure
// upright: the frames align the ground's y with the pelvis's z.
human_align_spring(h: *Human, world_id: WorldId, ground_id: BodyId, hertz: float, damping_ratio: float) {
    bone = bone_at(h, BONE_PELVIS)
    q = math.compute_quat_between_unit_vectors(math.vec3_axis_z(), math.vec3_axis_y())
    qb = dynamics.body_get_rotation(bone.body_id)
    pdef = dynamics.default_parallel_joint_def()
    pdef.base.body_id_a = ground_id
    pdef.base.body_id_b = bone.body_id
    pdef.base.local_frame_a.q = q
    pdef.base.local_frame_b.q = math.inv_mul_quat(qb, q)
    pdef.base.draw_scale = 2.0
    pdef.base.collide_connected = true
    pdef.hertz = hertz
    pdef.damping_ratio = damping_ratio
    bone.joint_id = dynamics.create_parallel_joint(world_id, &pdef)
}

// A kinematic anchor per bone at its pose, holding the bone through a
// motor joint's position and rotation springs: move the anchors and the
// figure follows (the pose drive of an active ragdoll).
human_create_motor_anchors(h: *Human, world_id: WorldId) {
    adef = dynamics.default_body_def()
    adef.kind = dynamics.BODY_KINEMATIC
    mdef = dynamics.default_motor_joint_def()
    mdef.angular_hertz = 5.0
    mdef.angular_damping_ratio = 1.0
    mdef.linear_hertz = 5.0
    mdef.linear_damping_ratio = 1.0
    mdef.max_spring_force = math.MAX_FLOAT
    mdef.max_spring_torque = math.MAX_FLOAT
    i = 0
    while i < BONE_COUNT {
        bone = bone_at(h, i)
        xf = dynamics.body_get_transform(bone.body_id)
        adef.position = xf.p
        adef.rotation = xf.q
        bone.anchor_id = dynamics.create_body(world_id, &adef)
        mdef.base.body_id_a = bone.anchor_id
        mdef.base.body_id_b = bone.body_id
        bone.anchor_joint_id = dynamics.create_motor_joint(world_id, &mdef)
        i = i + 1
    }
}

// The same anchors through parallel joints: rotation only, with a torque limit.
human_create_parallel_anchors(h: *Human, world_id: WorldId) {
    adef = dynamics.default_body_def()
    adef.kind = dynamics.BODY_KINEMATIC
    q_frame_world = math.compute_quat_between_unit_vectors(math.vec3_axis_z(), math.vec3_axis_y())
    pdef = dynamics.default_parallel_joint_def()
    pdef.hertz = 8.0
    pdef.damping_ratio = 1.0
    pdef.max_torque = 800.0
    i = 0
    while i < BONE_COUNT {
        bone = bone_at(h, i)
        xf = dynamics.body_get_transform(bone.body_id)
        adef.position = xf.p
        adef.rotation = xf.q
        bone.anchor_id = dynamics.create_body(world_id, &adef)
        pdef.base.body_id_a = bone.anchor_id
        pdef.base.body_id_b = bone.body_id
        frame_q = math.inv_mul_quat(xf.q, q_frame_world)
        pdef.base.local_frame_a.q = frame_q
        pdef.base.local_frame_b.q = frame_q
        bone.anchor_joint_id = dynamics.create_parallel_joint(world_id, &pdef)
        i = i + 1
    }
}

// Whether the figure is held by anchors of either kind.
human_has_anchors(h: *Human) -> bool {
    return dynamics.body_is_valid(bone_at(h, BONE_PELVIS).anchor_id)
}

// A bone's anchor driven to a pose over the step: the kinematic anchor
// moves there at the velocity that gets it there in one step, and the
// bone follows through its joint's springs. The pose drive of an active
// ragdoll: an animation sets the anchors every step and the figure walks
// as the animation does, colliding as the ragdoll it is. Nothing happens
// for a bone without an anchor.
human_set_anchor_target(h: *Human, index: int, target: Transform, time_step: float) {
    bone = bone_at(h, index)
    if dynamics.body_is_valid(bone.anchor_id) == false { return }
    dynamics.body_set_target_transform(bone.anchor_id, target, time_step, true)
}

// The anchors let go, leaving the figure a ragdoll: every anchor joint
// and body destroyed, the bones' slots cleared.
human_destroy_anchors(h: *Human) {
    i = 0
    while i < BONE_COUNT {
        bone = bone_at(h, i)
        if dynamics.joint_is_valid(bone.anchor_joint_id) { dynamics.destroy_joint(bone.anchor_joint_id, true) }
        if dynamics.body_is_valid(bone.anchor_id) { dynamics.destroy_body(bone.anchor_id) }
        bone.anchor_joint_id = dynamics.null_joint_id()
        bone.anchor_id = dynamics.null_body_id()
        i = i + 1
    }
}

human_set_bullet(h: *Human, flag: bool) {
    i = 0
    while i < BONE_COUNT {
        dynamics.body_set_bullet(bone_at(h, i).body_id, flag)
        i = i + 1
    }
}
