    COLOR_MEDIUM_SPRING_GREEN, COLOR_MEDIUM_TURQUOISE, COLOR_MEDIUM_VIOLET_RED, COLOR_MIDNIGHT_BLUE, COLOR_MINT_CREAM,
    COLOR_MISTY_ROSE, COLOR_MOCCASIN, COLOR_NAVAJO_WHITE, COLOR_NAVY, COLOR_OLD_LACE, COLOR_OLIVE, COLOR_OLIVE_DRAB,
