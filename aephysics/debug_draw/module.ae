struct DebugDraw {
    draw_shape: fn(ptr, Transform, int, ptr)               // a user shape at a transform
    draw_segment: fn(Vec3, Vec3, int, ptr)
    draw_transform: fn(Transform, ptr)                     // axes of the host's own length
    draw_point: fn(Vec3, float, int, ptr)                  // a point of a size in pixels
    draw_sphere: fn(Vec3, float, int, float, ptr)          // centre, radius, colour, alpha
    draw_capsule: fn(Vec3, Vec3, float, int, float, ptr)   // the two centres, radius, colour, alpha
    draw_bounds: fn(AABB, int, ptr)
    draw_box: fn(Vec3, Transform, int, ptr)                // half extents at a transform
    draw_string: fn(Vec3, string, int, ptr)                // text at a world point
    drawing_bounds: AABB           // what is drawn: the shapes whose bounds overlap it
    force_scale: float             // a contact force's length per newton
    joint_scale: float             // the joints' drawing, scaled
    draw_shapes: bool
    draw_joints: bool
    draw_joint_extras: bool        // each joint's constraint force and torque
    draw_bounds_option: bool       // each shape's fat bounds (the reference's drawBounds)
    draw_mass: bool                // the centre of mass and the mass of dynamic bodies
    draw_sleep: bool               // the sleep velocity against the threshold
    draw_body_names: bool
    draw_contacts: bool
    draw_anchor_a: bool            // contact points at body A's anchors, else B's
    draw_graph_colors: bool        // the constraint graph's colour of each contact and joint
    draw_contact_features: bool
    draw_contact_normals: bool
    draw_contact_forces: bool
    draw_islands: bool             // each island's bounds
    context: ptr                   // given to every callback
}

no_shape(user_shape: ptr, transform: Transform, color: int, context: ptr) { }
no_segment(p1: Vec3, p2: Vec3, color: int, context: ptr) { }
no_transform(transform: Transform, context: ptr) { }
no_point(p: Vec3, size: float, color: int, context: ptr) { }
no_sphere(p: Vec3, radius: float, color: int, alpha: float, context: ptr) { }
no_capsule(p1: Vec3, p2: Vec3, radius: float, color: int, alpha: float, context: ptr) { }
no_bounds(box: AABB, color: int, context: ptr) { }
no_box(extents: Vec3, transform: Transform, color: int, context: ptr) { }
no_string(p: Vec3, text: string, color: int, context: ptr) { }

// Callbacks that draw nothing (a host sets the ones it has), every option
// off, bounds a hundred metres out every way, unit scales
// (b3DefaultDebugDraw).
default_debug_draw() -> DebugDraw {
    h = 100.0
    return DebugDraw { draw_shape: no_shape, draw_segment: no_segment, draw_transform: no_transform, draw_point: no_point,
                       draw_sphere: no_sphere, draw_capsule: no_capsule, draw_bounds: no_bounds, draw_box: no_box, draw_string: no_string,
                       drawing_bounds: AABB { lower: math.vec3(0.0 - h, 0.0 - h, 0.0 - h), upper: math.vec3(h, h, h) },
                       force_scale: 1.0, joint_scale: 1.0, draw_shapes: false, draw_joints: false, draw_joint_extras: false,
                       draw_bounds_option: false, draw_mass: false, draw_sleep: false, draw_body_names: false, draw_contacts: false,
                       draw_anchor_a: false, draw_graph_colors: false, draw_contact_features: false, draw_contact_normals: false,
                       draw_contact_forces: false, draw_islands: false, context: null }
}

// A preset of how a drawn colour should look, packed in a colour's high
// byte (the reference's b3DebugMaterial); 0 keeps the host's own look.
const DEBUG_MATERIAL_DEFAULT = 0
const DEBUG_MATERIAL_MATTE = 1
const DEBUG_MATERIAL_SOFT = 2
const DEBUG_MATERIAL_DEAD = 3
const DEBUG_MATERIAL_GLOSSY = 4
const DEBUG_MATERIAL_METALLIC = 5

// An RGB colour with a material preset in its high byte (b3MakeDebugColor).
make_debug_color(rgb: int, material: int) -> int { return (rgb & 0x00FFFFFF) | (material << 24) }

// The colour drawn for a constraint graph colour, the overflow last (b3GetGraphColor).
graph_color(index: int) -> int {
    if index == 0 { return COLOR_RED }
    if index == 1 { return COLOR_ORANGE }
    if index == 2 { return COLOR_YELLOW }
    if index == 3 { return COLOR_GREEN }
    if index == 4 { return COLOR_CYAN }
    if index == 5 { return COLOR_BLUE }
    if index == 6 { return COLOR_VIOLET }
    if index == 7 { return COLOR_PINK }
    if index == 8 { return COLOR_CHOCOLATE }
    if index == 9 { return COLOR_GOLDEN_ROD }
    if index == 10 { return COLOR_CORAL }
    if index == 11 { return COLOR_ROSY_BROWN }
    if index == 12 { return COLOR_AQUA }
    if index == 13 { return COLOR_PERU }
    if index == 14 { return COLOR_LIME }
    if index == 15 { return COLOR_GOLD }
    if index == 16 { return COLOR_PLUM }
    if index == 17 { return COLOR_SNOW }
    if index == 18 { return COLOR_TEAL }
    if index == 19 { return COLOR_KHAKI }
    if index == 20 { return COLOR_SALMON }
    if index == 21 { return COLOR_PEACH_PUFF }
    if index == 22 { return COLOR_HONEY_DEW }
    return COLOR_BLACK
}

// A number with `digits` decimals, rounded half away from zero, for the
// drawing's labels (the reference's "%.2f" and its siblings).
fixed(value: float, digits: int) -> string {
    scale = 1 as long
    i = 0
    while i < digits {
        scale = scale * (10 as long)
        i = i + 1
    }
    negative = value < 0.0
    magnitude = value
    if negative { magnitude = 0.0 - value }
    units = (magnitude * (scale as float) + 0.5) as long
    whole = units / scale
    sign = ""
    if negative && units != (0 as long) { sign = "-" }
    if digits <= 0 { return "${sign}${whole}" }
    rest = "${units % scale}"
    while string.length(rest) < digits { rest = "0${rest}" }
    return "${sign}${whole}.${rest}"
}

// A value in hexadecimal with the reference's "%#X" look: 0X and capitals,
// 0 alone.
hex(value: int) -> string {
    if value == 0 { return "0" }
    digits = "0123456789ABCDEF"
    bits = value as long
    if bits < (0 as long) { bits = bits + (1 as long << 32) }
    text = ""
    while bits > (0 as long) {
        nibble = (bits % (16 as long)) as int
        text = "${string.substring(digits, nibble, nibble + 1)}${text}"
        bits = bits / (16 as long)
    }
    return "0X${text}"
}

