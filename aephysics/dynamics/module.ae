// aephysics.dynamics -- the world's state and its bookkeeping: the
// world with its sparse arrays of bodies, shapes, contacts, joints and
// islands (each keyed by a recycled id with a generation, so a stale id
// is caught), the solver sets that keep the simulation data of static,
// disabled, awake and sleeping bodies in contiguous arrays, the islands
// that group bodies by their constraints, the shapes' place in the
// broad phase, and the mass properties of a body from its shapes.
// Nothing here steps time: the solver and the world's step are the
// layers above.
//
// This is the organisational half of Box3D's body.c, shape.c,
// solver_set.c, island.c and physics_world.c (Erin Catto, MIT), the
// reference this engine is measured against: a body is an entry in a
// sparse array pointing at its sim (and, when awake, its state) inside
// a solver set; the static set holds static bodies, the disabled set
// disabled ones, the awake set everything simulated, and each sleeping
// island is a set of its own; a shape lives in a doubly linked list on
// its body and in the broad phase's tree of its body's type. Names are
// the reference's without its prefix, in snake case: b3CreateBody is
// create_body, b3Body_SetMassData is body_set_mass_data.
//
// This layer so far: worlds, bodies (creation, destruction, transforms,
// velocities, mass data, extents, damping, sleep and enable flags),
// shapes (creation of every kind, destruction, proxies), islands of one
// body, solver sets for sleeping bodies, and the validation. Contacts,
// joints and sensors are declared and come next.
//
// Differences: no hull database (a hull shape keeps the pointer it was
// given; the owner keeps the hull alive), no name cache, no recording
// hooks; a world's callbacks are plain function values.
import std.string
import aephysics.math
import aephysics.core
import aephysics.dynamic_tree
import aephysics.hull
import aephysics.distance
import aephysics.manifold
import aephysics.triangle_manifold
import aephysics.mesh
import aephysics.height_field
import aephysics.material
import aephysics.sphere
import aephysics.capsule
import aephysics.compound
import aephysics.shape
import aephysics.broad_phase
import aephysics.mesh_contact

exports (
    WorldDef, BodyDef, ShapeDef, MotionLocks, WorldId, BodyId, ShapeId,
    World, Body, BodySim, BodyState, WorldShape, Contact, ContactEdge, Joint, JointEdge,
    SolverSet, Island, IslandSim, ContactLink, JointLink,
    NULL_INDEX, MAX_WORLDS, STATIC_SET, DISABLED_SET, AWAKE_SET, FIRST_SLEEPING_SET,
    BODY_STATIC, BODY_KINEMATIC, BODY_DYNAMIC,
    LOCK_LINEAR_X, LOCK_LINEAR_Y, LOCK_LINEAR_Z, LOCK_ANGULAR_X, LOCK_ANGULAR_Y, LOCK_ANGULAR_Z,
    IS_FAST, IS_BULLET, IS_SPEED_CAPPED, HAD_TIME_OF_IMPACT, ALLOW_FAST_ROTATION, ENLARGE_BOUNDS,
    DYNAMIC_FLAG, ENABLE_SLEEP, ENABLE_CONTACT_RECYCLING, DIRTY_MASS, ALL_LOCKS, FIXED_ROTATION, BODY_TRANSIENT_FLAGS,
    SHAPE_ENABLE_SENSOR_EVENTS, SHAPE_ENABLE_CONTACT_EVENTS, SHAPE_ENABLE_CUSTOM_FILTERING, SHAPE_ENABLE_HIT_EVENTS,
    SHAPE_ENABLE_PRE_SOLVE_EVENTS, SHAPE_ENABLE_SPECULATIVE,
    default_world_def, default_body_def, default_shape_def, null_body_id, null_shape_id,
    create_world, destroy_world, world_is_valid, get_world, world_body_count, world_shape_count, world_awake_body_count,
    world_set_gravity, world_get_gravity,
    create_body, destroy_body, body_is_valid, get_body_full_id, get_body, get_body_sim, get_body_state, get_body_transform,
    make_body_id, sync_body_flags, update_body_mass_data, is_body_awake, wake_body,
    body_get_position, body_get_rotation, body_get_transform, body_set_transform,
    body_get_local_point, body_get_world_point, body_get_local_vector, body_get_world_vector,
    body_get_linear_velocity, body_get_angular_velocity, body_set_linear_velocity, body_set_angular_velocity,
    body_get_local_point_velocity, body_get_world_point_velocity,
    body_get_type, body_get_mass, body_get_inverse_mass, body_get_local_rotational_inertia,
    body_get_world_inverse_rotational_inertia, body_get_local_center, body_get_world_center,
    body_set_mass_data, body_get_mass_data, body_apply_mass_from_shapes,
    body_get_min_extent, body_get_max_extent, body_get_max_extent_origin,
    body_set_linear_damping, body_get_linear_damping, body_set_angular_damping, body_get_angular_damping,
    body_set_gravity_scale, body_get_gravity_scale, body_set_user_data, body_get_user_data,
    body_is_awake, body_set_awake, body_is_enabled, body_is_sleep_enabled, body_enable_sleep,
    body_set_sleep_threshold, body_get_sleep_threshold, body_get_shape_count, body_get_shapes, body_compute_aabb,
    body_set_motion_locks, body_get_motion_locks, body_get_flags,
    create_sphere_shape, create_capsule_shape, create_hull_shape, create_mesh_shape, create_height_field_shape,
    create_compound_shape, destroy_shape, shape_is_valid, get_shape_full_id, get_shape, shape_get_body,
    shape_get_aabb, shape_get_type, shape_get_density, shape_set_density, shape_get_filter, shape_set_filter,
    shape_get_surface_material, shape_set_surface_material, shape_get_material_count, shape_is_sensor,
    shape_set_user_data, shape_get_user_data, shape_get_flags,
    create_island, destroy_island, validate_island, create_solver_set, destroy_solver_set, wake_solver_set,
    validate_solver_sets, get_solver_set, get_island, world_island_count, world_solver_set_count,
    body_sim_at, body_state_at, world_shape_at, island_at, solver_set_at, body_at,
    Manifold, ManifoldPoint, ContactSpec, ContactId, ContactBeginTouchEvent, ContactEndTouchEvent, JointSim, GraphColor, ConstraintGraph,
    GRAPH_COLOR_COUNT, OVERFLOW_INDEX, DYNAMIC_COLOR_COUNT, MAX_MANIFOLD_POINTS,
    CONTACT_TOUCHING, CONTACT_ENABLE_CONTACT_EVENTS, CONTACT_STATIC, CONTACT_RECYCLE, SIM_TOUCHING, SIM_MESH_CONTACT,
    SIM_ENABLE_HIT_EVENT, RELATIVE_TRANSFORM_VALID, ENABLE_SPECULATIVE_POINTS,
    contact_at, joint_at, manifold_at, manifold_point_at, graph_color, contact_spec_at, joint_sim_at, contact_link_at, joint_link_at,
    world_contact_count, get_contact, contact_is_valid, make_contact_id, make_shape_id,
    world_contact_begin_event_count, world_contact_begin_event, world_contact_end_event_count, world_contact_end_event, swap_end_events,
    create_graph, destroy_graph, add_contact_to_graph, remove_contact_from_graph, add_joint_to_graph, remove_joint_from_graph,
    create_contact, destroy_contact, update_contact, contact_edge_next, invalidate_body_contacts,
    merge_islands, link_contact, unlink_contact, link_joint, unlink_joint, split_island, try_sleep_island,
    update_pairs, collide, validate_contacts
)

extern memset(block: ptr, value: int, size: int) -> ptr
extern memcpy(dst: ptr, src: ptr, size: int) -> ptr
extern sqrt(x: float) -> float

const NULL_INDEX = 0 - 1
const MAX_WORLDS = 128
const STATIC_SET = 0
const DISABLED_SET = 1
const AWAKE_SET = 2
const FIRST_SLEEPING_SET = 3
const BODY_STATIC = 0
const BODY_KINEMATIC = 1
const BODY_DYNAMIC = 2
const SPECULATIVE_DISTANCE = 0.02
const MAX_AABB_MARGIN = 0.05
const AABB_MARGIN_FRACTION = 0.125
const CONTACT_RECYCLE_DISTANCE = 0.05
const CONTACT_RECYCLE_ANGULAR_DISTANCE = 0.99240388
const GRAPH_COLOR_COUNT = 24
const OVERFLOW_INDEX = 23
const DYNAMIC_COLOR_COUNT = 20
const MAX_MANIFOLD_POINTS = 4
// Contact flags (b3ContactFlags).
const CONTACT_TOUCHING = 0x00000001
const CONTACT_HIT_EVENT = 0x00000002
const CONTACT_ENABLE_CONTACT_EVENTS = 0x00000004
const CONTACT_STATIC = 0x00000008
const CONTACT_RECYCLE = 0x00000010
const SIM_TOUCHING = 0x00010000
const SIM_DISJOINT = 0x00020000
const SIM_STARTED_TOUCHING = 0x00040000
const SIM_STOPPED_TOUCHING = 0x00080000
const SIM_ENABLE_HIT_EVENT = 0x00100000
const SIM_ENABLE_PRE_SOLVE_EVENTS = 0x00200000
const SIM_MESH_CONTACT = 0x00400000
const RELATIVE_TRANSFORM_VALID = 0x00800000
const ENABLE_SPECULATIVE_POINTS = 0x01000000
// The shape kinds (the shape module's, restated).
const KIND_SPHERE = 0
const KIND_CAPSULE = 1
const KIND_HULL = 2
const KIND_MESH = 3
const KIND_HEIGHT_FIELD = 4
const KIND_COMPOUND = 5

// Body flags (b3BodyFlags).
const LOCK_LINEAR_X = 0x00000001
const LOCK_LINEAR_Y = 0x00000002
const LOCK_LINEAR_Z = 0x00000004
const LOCK_ANGULAR_X = 0x00000008
const LOCK_ANGULAR_Y = 0x00000010
const LOCK_ANGULAR_Z = 0x00000020
const IS_FAST = 0x00000040
const IS_BULLET = 0x00000080
const IS_SPEED_CAPPED = 0x00000100
const HAD_TIME_OF_IMPACT = 0x00000200
const ALLOW_FAST_ROTATION = 0x00000400
const ENLARGE_BOUNDS = 0x00000800
const DYNAMIC_FLAG = 0x00001000
const ENABLE_SLEEP = 0x00002000
const ENABLE_CONTACT_RECYCLING = 0x00004000
const DIRTY_MASS = 0x00008000
const ALL_LOCKS = 0x0000003F
const FIXED_ROTATION = 0x00000038
const BODY_TRANSIENT_FLAGS = 0x00000340

// Shape flags (b3ShapeFlags).
const SHAPE_ENABLE_SENSOR_EVENTS = 0x01
const SHAPE_ENABLE_CONTACT_EVENTS = 0x02
const SHAPE_ENABLE_CUSTOM_FILTERING = 0x04
const SHAPE_ENABLE_HIT_EVENTS = 0x08
const SHAPE_ENABLE_PRE_SOLVE_EVENTS = 0x10
const SHAPE_ENABLE_SPECULATIVE = 0x40

// --- definitions and ids -------------------------------------------------------------------------

struct WorldDef {
    gravity: Vec3
    hit_event_threshold: float     // the approach speed that makes a hit event
    restitution_threshold: float   // the approach speed under which there is no bounce
    contact_speed: float           // the push-out speed
    contact_hertz: float           // the contact spring
    contact_damping_ratio: float
    maximum_linear_speed: float
    friction_callback: fn(float, long, float, long) -> float
    restitution_callback: fn(float, long, float, long) -> float
    enable_sleep: bool
    enable_continuous: bool
    static_body_count: int         // the capacities the world starts with
    dynamic_body_count: int
    static_shape_count: int
    dynamic_shape_count: int
    contact_count: int
    user_data: ptr
}

struct MotionLocks {
    linear_x: bool
    linear_y: bool
    linear_z: bool
    angular_x: bool
    angular_y: bool
    angular_z: bool
}

struct BodyDef {
    kind: int                      // BODY_STATIC, BODY_KINEMATIC or BODY_DYNAMIC
    position: Vec3
    rotation: Quat
    linear_velocity: Vec3
    angular_velocity: Vec3
    linear_damping: float
    angular_damping: float
    gravity_scale: float
    sleep_threshold: float
    safety_factor: float
    user_data: ptr
    motion_locks: MotionLocks
    enable_sleep: bool
    is_awake: bool
    is_bullet: bool
    is_enabled: bool
    allow_fast_rotation: bool
    enable_contact_recycling: bool
}

struct ShapeDef {
    user_data: ptr
    materials: ptr                 // SurfaceMaterial[], per triangle material of a mesh, or null
    material_count: int
    base_material: SurfaceMaterial // the one material when materials is null
    density: float
    explosion_scale: float
    filter: Filter
    enable_custom_filtering: bool
    is_sensor: bool
    enable_sensor_events: bool
    enable_contact_events: bool
    enable_hit_events: bool
    enable_pre_solve_events: bool
    invoke_contact_creation: bool  // a static shape finds its pairs at once
    update_body_mass: bool
    enable_speculative_contact: bool
}

// Ids are an index plus one (so zero is null), the world, and the
// generation of the slot, so an id from before a slot was recycled fails.
struct WorldId {
    index1: int
    generation: int
}

struct BodyId {
    index1: int
    world0: int
    generation: int
}

struct ShapeId {
    index1: int
    world0: int
    generation: int
}

default_friction(friction_a: float, user_a: long, friction_b: float, user_b: long) -> float { return sqrt(friction_a * friction_b) }
default_restitution(restitution_a: float, user_a: long, restitution_b: float, user_b: long) -> float { return math.max_float(restitution_a, restitution_b) }

default_world_def() -> WorldDef {
    return WorldDef { gravity: math.vec3(0.0, 0.0 - 10.0, 0.0), hit_event_threshold: 1.0, restitution_threshold: 1.0, contact_speed: 3.0,
                      contact_hertz: 30.0, contact_damping_ratio: 10.0, maximum_linear_speed: 400.0,
                      friction_callback: default_friction, restitution_callback: default_restitution,
                      enable_sleep: true, enable_continuous: true, static_body_count: 0, dynamic_body_count: 0,
                      static_shape_count: 0, dynamic_shape_count: 0, contact_count: 0, user_data: null }
}

default_body_def() -> BodyDef {
    return BodyDef { kind: BODY_STATIC, position: math.vec3_zero(), rotation: math.quat_identity(), linear_velocity: math.vec3_zero(),
                     angular_velocity: math.vec3_zero(), linear_damping: 0.0, angular_damping: 0.0, gravity_scale: 1.0,
                     sleep_threshold: 0.05, safety_factor: 0.5, user_data: null,
                     motion_locks: MotionLocks { linear_x: false, linear_y: false, linear_z: false, angular_x: false, angular_y: false, angular_z: false },
                     enable_sleep: true, is_awake: true, is_bullet: false, is_enabled: true, allow_fast_rotation: false, enable_contact_recycling: true }
}

default_shape_def() -> ShapeDef {
    return ShapeDef { user_data: null, materials: null, material_count: 0, base_material: material.default_surface_material(),
                      density: 1000.0, explosion_scale: 1.0, filter: shape.default_filter(), enable_custom_filtering: false,
                      is_sensor: false, enable_sensor_events: false, enable_contact_events: false, enable_hit_events: false,
                      enable_pre_solve_events: false, invoke_contact_creation: true, update_body_mass: true, enable_speculative_contact: true }
}

null_body_id() -> BodyId { return BodyId { index1: 0, world0: 0, generation: 0 } }
null_shape_id() -> ShapeId { return ShapeId { index1: 0, world0: 0, generation: 0 } }

// --- the state --------------------------------------------------------------------------------------

// A body's organisation: where its sim lives, its lists, its island.
struct Body {
    user_data: ptr
    set_index: int                 // the solver set, or NULL_INDEX when the slot is free
    local_index: int               // the sim (and state) within the set
    head_contact_key: int          // [contact id : 31 | edge : 1]
    contact_count: int
    head_shape_id: int
    shape_count: int
    head_joint_key: int
    joint_count: int
    island_id: int                 // every enabled dynamic or kinematic body is in one
    island_index: int              // within the island's bodies
    sleep_threshold: float
    sleep_time: float
    sleep_velocity: float
    safety_factor: float
    mass: float
    inertia: Matrix3               // about the centre of mass, in the body's frame
    body_move_index: int
    id: int
    flags: int
    kind: int
    generation: int
}

// What the solver reads and writes for an awake body.
struct BodyState {
    linear_velocity: Vec3
    angular_velocity: Vec3
    delta_position: Vec3
    delta_rotation: Quat
    flags: int
}

// What integration and collision need of a body.
struct BodySim {
    transform: Transform           // of the body's origin
    center: Vec3                   // of mass, in world space
    rotation0: Quat                // for the time of impact
    center0: Vec3
    local_center: Vec3
    force: Vec3
    torque: Vec3
    inv_mass: float
    inv_inertia_local: Matrix3
    inv_inertia_world: Matrix3
    min_extent: float
    max_extent: Vec3
    linear_damping: float
    angular_damping: float
    gravity_scale: float
    body_id: int
    flags: int
}

// A shape in the world: its geometry (the shape module's Shape, with
// its density) and its place among its body's shapes and in the broad phase.
struct WorldShape {
    id: int                        // NULL_INDEX when the slot is free
    body_id: int
    prev_shape_id: int
    next_shape_id: int
    sensor_index: int
    proxy_key: int
    geometry: Shape
    explosion_scale: float
    aabb_margin: float
    aabb: AABB
    fat_aabb: AABB
    local_centroid: Vec3
    material_count: int
    material: SurfaceMaterial      // the one material when materials is null
    materials: ptr                 // SurfaceMaterial[] when there are several
    filter: Filter
    user_data: ptr
    generation: int
    flags: int
}

struct ContactEdge {
    body_id: int
    prev_key: int
    next_key: int
}

// The persistent interaction of two shapes (its update comes with the next layer).
struct Contact {
    set_index: int
    color_index: int
    local_index: int
    edge_a: ContactEdge
    edge_b: ContactEdge
    shape_id_a: int
    shape_id_b: int
    child_index: int
    island_id: int
    island_index: int
    contact_id: int
    body_sim_index_a: int
    body_sim_index_b: int
    flags: int
    manifolds: ptr                 // Manifold[manifold_count], a heap block of the contact's
    manifold_count: int
    cached_rotation_a: Quat        // for the recycling
    cached_rotation_b: Quat
    cached_relative_pose: Transform
    friction: float
    restitution: float
    rolling_resistance: float
    tangent_velocity: Vec3
    mesh_cache: MeshContactCache   // a mesh contact's triangles
    convex_cache: TriangleCache    // a convex contact's simplex or axis
    generation: int
}

// A contact point the solver works on: anchors relative to the bodies'
// centres of mass in world space, the separation, the impulses.
struct ManifoldPoint {
    anchor_a: Vec3
    anchor_b: Vec3
    separation: float
    base_separation: float
    normal_impulse: float
    total_normal_impulse: float
    normal_velocity: float
    feature_id: int
    triangle_index: int
    persisted: bool
}

// Up to four points on a normal, with the accumulated friction and rolling.
struct Manifold {
    point0: ManifoldPoint
    point1: ManifoldPoint
    point2: ManifoldPoint
    point3: ManifoldPoint
    normal: Vec3
    twist_impulse: float
    friction_impulse: Vec3
    rolling_impulse: Vec3
    point_count: int
}

// A touching contact in a graph colour: its manifolds' place in the solver's array.
struct ContactSpec {
    contact_id: int
    manifold_start: int
    manifold_count: int
}

struct ContactId {
    index1: int
    world0: int
    generation: int
}

struct ContactBeginTouchEvent {
    shape_id_a: ShapeId
    shape_id_b: ShapeId
    contact_id: ContactId
}

struct ContactEndTouchEvent {
    shape_id_a: ShapeId
    shape_id_b: ShapeId
    contact_id: ContactId
}

struct JointEdge {
    body_id: int
    prev_key: int
    next_key: int
}

// A joint's organisation (its kinds come with the joint layer).
struct Joint {
    user_data: ptr
    set_index: int
    color_index: int
    local_index: int
    edge_a: JointEdge
    edge_b: JointEdge
    joint_id: int
    island_id: int
    island_index: int
    kind: int
    generation: int
}

// A joint's simulation data (its kinds fill this in with the joint layer).
struct JointSim {
    joint_id: int
    kind: int
    body_id_a: int
    body_id_b: int
    local_frame_a: Transform
    local_frame_b: Transform
}

// One colour of the constraint graph: no two constraints in it share a
// dynamic body, so the solver can run them side by side.
struct GraphColor {
    body_set: BitSet               // by body id; unused on the overflow colour
    joint_sims: Buffer             // JointSim
    convex_contacts: IntArray      // contact ids (the wide solver's)
    contacts: Buffer               // ContactSpec (mesh contacts and the overflow's)
}

struct ConstraintGraph {
    colors: ptr                    // GraphColor[GRAPH_COLOR_COUNT], the overflow last
}

struct ContactLink {
    contact_id: int
    body_id_a: int
    body_id_b: int
}

struct JointLink {
    joint_id: int
    body_id_a: int
    body_id_b: int
}

// A group of bodies connected by constraints; it sleeps as one.
struct Island {
    set_index: int
    local_index: int
    island_id: int
    constraint_remove_count: int
    bodies: IntArray
    contacts: Buffer               // ContactLink
    joints: Buffer                 // JointLink
}

struct IslandSim {
    island_id: int
}

// The simulation data of one set of bodies: static, disabled, awake, or one sleeping island.
struct SolverSet {
    body_sims: Buffer              // BodySim
    body_states: Buffer            // BodyState, the awake set only
    joint_sims: Buffer             // the joint layer's JointSim, sleeping and disabled sets
    contact_indices: IntArray      // sleeping sets' contacts; the awake set's non-touching ones
    island_sims: Buffer            // IslandSim
    set_index: int                 // NULL_INDEX when unused
}

struct World {
    stack: Stack
    broad_phase: BroadPhase
    constraint_graph: ConstraintGraph
    arena: Arena                   // the collide pass's scratch (one worker)
    contact_state: BitSet          // the contacts whose touching changed this pass
    contact_begin_events: Buffer   // ContactBeginTouchEvent
    contact_end_events0: Buffer    // ContactEndTouchEvent, double buffered
    contact_end_events1: Buffer
    end_event_index: int
    sat_call_count: int
    sat_cache_hit_count: int
    recycled_contact_count: int
    body_id_pool: IdPool
    bodies: Buffer                 // Body, sparse by id
    solver_set_id_pool: IdPool
    solver_sets: Buffer            // SolverSet
    joint_id_pool: IdPool
    joints: Buffer                 // Joint
    contact_id_pool: IdPool
    contacts: Buffer               // Contact
    island_id_pool: IdPool
    islands: Buffer                // Island
    shape_id_pool: IdPool
    shapes: Buffer                 // WorldShape
    compound_shape_count: int
    step_index: long
    split_island_id: int
    gravity: Vec3
    hit_event_threshold: float
    restitution_threshold: float
    max_linear_speed: float
    contact_speed: float
    contact_hertz: float
    contact_damping_ratio: float
    contact_recycle_distance: float
    friction_callback: fn(float, long, float, long) -> float
    restitution_callback: fn(float, long, float, long) -> float
    generation: int
    inv_h: float
    inv_dt: float
    world_id: int
    enable_sleep: bool
    locked: bool
    enable_warm_starting: bool
    enable_continuous: bool
    enable_speculative: bool
    in_use: bool
    user_data: ptr
}

var g_worlds: ptr = null           // World[MAX_WORLDS]

worlds_ready() {
    if g_worlds == null { g_worlds = core.alloc(MAX_WORLDS * sizeof(World)) }
}

world_at(index: int) -> *World { return (g_worlds + index * sizeof(World)) as *World }

// --- element access ------------------------------------------------------------------------------

body_at(w: *World, id: int) -> *Body { return (w.bodies.data + id * sizeof(Body)) as *Body }
world_shape_at(w: *World, id: int) -> *WorldShape { return (w.shapes.data + id * sizeof(WorldShape)) as *WorldShape }
island_at(w: *World, id: int) -> *Island { return (w.islands.data + id * sizeof(Island)) as *Island }
solver_set_at(w: *World, index: int) -> *SolverSet { return (w.solver_sets.data + index * sizeof(SolverSet)) as *SolverSet }
body_sim_at(set: *SolverSet, index: int) -> *BodySim { return (set.body_sims.data + index * sizeof(BodySim)) as *BodySim }
body_state_at(set: *SolverSet, index: int) -> *BodyState { return (set.body_states.data + index * sizeof(BodyState)) as *BodyState }
island_sim_at(set: *SolverSet, index: int) -> *IslandSim { return (set.island_sims.data + index * sizeof(IslandSim)) as *IslandSim }

get_solver_set(w: *World, index: int) -> *SolverSet { return solver_set_at(w, index) }
get_island(w: *World, id: int) -> *Island { return island_at(w, id) }
world_island_count(w: *World) -> int { return core.idpool_count(&w.island_id_pool) }
world_solver_set_count(w: *World) -> int { return core.idpool_count(&w.solver_set_id_pool) }

// --- worlds --------------------------------------------------------------------------------------------

get_world(index: int) -> *World {
    worlds_ready()
    return world_at(index)
}

world_is_valid(id: WorldId) -> bool {
    if id.index1 < 1 || id.index1 > MAX_WORLDS { return false }
    worlds_ready()
    w = world_at(id.index1 - 1)
    return w.in_use && w.generation == id.generation
}

get_world_from_id(id: WorldId) -> *World {
    worlds_ready()
    return world_at(id.index1 - 1)
}

empty_solver_set() -> SolverSet {
    return SolverSet { body_sims: core.buffer_create(sizeof(BodySim), 0), body_states: core.buffer_create(sizeof(BodyState), 0),
                       joint_sims: core.buffer_create(8, 0), contact_indices: core.ints_create(0),
                       island_sims: core.buffer_create(sizeof(IslandSim), 0), set_index: NULL_INDEX }
}

// A new set at a free slot, reserved for the awake set's capacities.
create_solver_set(w: *World) -> int {
    set_id = core.idpool_alloc(&w.solver_set_id_pool)
    if set_id == w.solver_sets.count {
        index = core.buffer_push(&w.solver_sets)
        s = solver_set_at(w, index)
        made = empty_solver_set()
        s.body_sims = made.body_sims
        s.body_states = made.body_states
        s.joint_sims = made.joint_sims
        s.contact_indices = made.contact_indices
        s.island_sims = made.island_sims
    }
    s = solver_set_at(w, set_id)
    s.set_index = set_id
    return set_id
}

destroy_solver_set(w: *World, set_index: int) {
    s = solver_set_at(w, set_index)
    core.buffer_destroy(&s.body_sims)
    core.buffer_destroy(&s.body_states)
    core.buffer_destroy(&s.joint_sims)
    core.ints_destroy(&s.contact_indices)
    core.buffer_destroy(&s.island_sims)
    core.idpool_free(&w.solver_set_id_pool, set_index)
    s.set_index = NULL_INDEX
}

// A world at the first free slot: its pools, its broad phase, and the
// static, disabled and awake sets.
create_world(def: *WorldDef) -> WorldId {
    worlds_ready()
    index = NULL_INDEX
    i = 0
    while i < MAX_WORLDS && index == NULL_INDEX {
        if world_at(i).in_use == false { index = i }
        i = i + 1
    }
    if index == NULL_INDEX { return WorldId { index1: 0, generation: 0 } }
    w = world_at(index)
    generation = w.generation
    memset(w as ptr, 0, sizeof(World))
    w.world_id = index
    w.generation = generation
    w.in_use = true
    w.stack = core.stack_create(2048)
    w.arena = core.arena_create(1 << 20)
    w.contact_state = core.bitset_create(64)
    w.contact_begin_events = core.buffer_create(sizeof(ContactBeginTouchEvent), 4)
    w.contact_end_events0 = core.buffer_create(sizeof(ContactEndTouchEvent), 4)
    w.contact_end_events1 = core.buffer_create(sizeof(ContactEndTouchEvent), 4)
    w.end_event_index = 0
    create_graph(&w.constraint_graph, 16)
    broad_phase.create_broad_phase(&w.broad_phase, Capacity { static_shape_count: def.static_shape_count, dynamic_shape_count: def.dynamic_shape_count, contact_count: def.contact_count })
    w.body_id_pool = core.idpool_create()
    w.bodies = core.buffer_create(sizeof(Body), math.max_int(16, def.static_body_count + def.dynamic_body_count))
    w.solver_set_id_pool = core.idpool_create()
    w.solver_sets = core.buffer_create(sizeof(SolverSet), 8)
    static_set = create_solver_set(w)
    create_solver_set(w)
    awake_set = create_solver_set(w)
    core.buffer_reserve(&solver_set_at(w, static_set).body_sims, math.max_int(16, def.static_body_count))
    core.buffer_reserve(&solver_set_at(w, awake_set).body_sims, math.max_int(16, def.dynamic_body_count))
    core.buffer_reserve(&solver_set_at(w, awake_set).body_states, math.max_int(16, def.dynamic_body_count))
    w.shape_id_pool = core.idpool_create()
    w.shapes = core.buffer_create(sizeof(WorldShape), math.max_int(16, def.static_shape_count + def.dynamic_shape_count))
    w.contact_id_pool = core.idpool_create()
    w.contacts = core.buffer_create(sizeof(Contact), math.max_int(16, def.contact_count))
    w.joint_id_pool = core.idpool_create()
    w.joints = core.buffer_create(sizeof(Joint), 16)
    w.island_id_pool = core.idpool_create()
    w.islands = core.buffer_create(sizeof(Island), math.max_int(16, def.dynamic_body_count))
    w.step_index = 0 as long
    w.split_island_id = NULL_INDEX
    w.gravity = def.gravity
    w.hit_event_threshold = def.hit_event_threshold
    w.restitution_threshold = def.restitution_threshold
    w.max_linear_speed = def.maximum_linear_speed
    w.contact_speed = def.contact_speed
    w.contact_hertz = def.contact_hertz
    w.contact_damping_ratio = def.contact_damping_ratio
    w.contact_recycle_distance = CONTACT_RECYCLE_DISTANCE
    w.friction_callback = def.friction_callback
    w.restitution_callback = def.restitution_callback
    w.enable_sleep = def.enable_sleep
    w.locked = false
    w.enable_warm_starting = true
    w.enable_continuous = def.enable_continuous
    w.enable_speculative = true
    w.user_data = def.user_data
    return WorldId { index1: index + 1, generation: generation }
}

// Everything the world holds is freed; ids into it die with its generation.
destroy_world(id: WorldId) {
    if world_is_valid(id) == false { return }
    w = get_world_from_id(id)
    // The shapes' materials and the contacts' caches.
    i = 0
    while i < w.shapes.count {
        s = world_shape_at(w, i)
        if s.id != NULL_INDEX && s.materials != null {
            core.free_bytes(s.materials, s.material_count * sizeof(SurfaceMaterial))
            s.materials = null
        }
        i = i + 1
    }
    i = 0
    while i < w.contacts.count {
        c = contact_at(w, i)
        if c.contact_id != NULL_INDEX {
            free_manifolds(c)
            if (c.flags & SIM_MESH_CONTACT) != 0 { mesh_contact.mesh_contact_cache_destroy(&c.mesh_cache) }
        }
        i = i + 1
    }
    i = 0
    while i < w.islands.count {
        island = island_at(w, i)
        if island.island_id != NULL_INDEX {
            core.ints_destroy(&island.bodies)
            core.buffer_destroy(&island.contacts)
            core.buffer_destroy(&island.joints)
        }
        i = i + 1
    }
    i = 0
    while i < w.solver_sets.count {
        set = solver_set_at(w, i)
        if set.set_index != NULL_INDEX { destroy_solver_set(w, i) }
        i = i + 1
    }
    core.buffer_destroy(&w.solver_sets)
    core.idpool_destroy(&w.solver_set_id_pool)
    core.buffer_destroy(&w.bodies)
    core.idpool_destroy(&w.body_id_pool)
    core.buffer_destroy(&w.shapes)
    core.idpool_destroy(&w.shape_id_pool)
    core.buffer_destroy(&w.contacts)
    core.idpool_destroy(&w.contact_id_pool)
    core.buffer_destroy(&w.joints)
    core.idpool_destroy(&w.joint_id_pool)
    core.buffer_destroy(&w.islands)
    core.idpool_destroy(&w.island_id_pool)
    broad_phase.destroy_broad_phase(&w.broad_phase)
    destroy_graph(&w.constraint_graph)
    core.arena_destroy(&w.arena)
    core.bitset_destroy(&w.contact_state)
    core.buffer_destroy(&w.contact_begin_events)
    core.buffer_destroy(&w.contact_end_events0)
    core.buffer_destroy(&w.contact_end_events1)
    core.stack_destroy(&w.stack)
    generation = w.generation
    memset(w as ptr, 0, sizeof(World))
    w.generation = generation + 1
    w.in_use = false
}

world_body_count(w: *World) -> int { return core.idpool_count(&w.body_id_pool) }
world_shape_count(w: *World) -> int { return core.idpool_count(&w.shape_id_pool) }
world_awake_body_count(w: *World) -> int { return solver_set_at(w, AWAKE_SET).body_sims.count }
world_set_gravity(w: *World, gravity: Vec3) { w.gravity = gravity }
world_get_gravity(w: *World) -> Vec3 { return w.gravity }

// --- islands --------------------------------------------------------------------------------------------

// A new island in a set (the awake one or a sleeping one).
create_island(w: *World, set_index: int) -> *Island {
    island_id = core.idpool_alloc(&w.island_id_pool)
    if island_id == w.islands.count {
        index = core.buffer_push(&w.islands)
        fresh = island_at(w, index)
        fresh.island_id = NULL_INDEX
        fresh.set_index = NULL_INDEX
    }
    set = solver_set_at(w, set_index)
    island = island_at(w, island_id)
    island.set_index = set_index
    island.local_index = set.island_sims.count
    island.island_id = island_id
    island.bodies = core.ints_create(0)
    island.contacts = core.buffer_create(sizeof(ContactLink), 0)
    island.joints = core.buffer_create(sizeof(JointLink), 0)
    island.constraint_remove_count = 0
    sim_index = core.buffer_push(&set.island_sims)
    island_sim_at(set, sim_index).island_id = island_id
    return island
}

// An empty island leaves its set (the last island sim moved into its slot) and frees its id.
destroy_island(w: *World, island_id: int) {
    if w.split_island_id == island_id { w.split_island_id = NULL_INDEX }
    island = island_at(w, island_id)
    set = solver_set_at(w, island.set_index)
    local_index = island.local_index
    last_index = set.island_sims.count - 1
    moved_island_id = island_sim_at(set, last_index).island_id
    island_sim_at(set, local_index).island_id = moved_island_id
    island_at(w, moved_island_id).local_index = local_index
    set.island_sims.count = set.island_sims.count - 1
    core.ints_destroy(&island.bodies)
    core.buffer_destroy(&island.contacts)
    core.buffer_destroy(&island.joints)
    island.constraint_remove_count = 0
    island.local_index = NULL_INDEX
    island.island_id = NULL_INDEX
    island.set_index = NULL_INDEX
    core.idpool_free(&w.island_id_pool, island_id)
}

// The island's bodies point back at it, and its set holds it.
validate_island(w: *World, island_id: int) -> bool {
    island = island_at(w, island_id)
    if island.island_id != island_id { return false }
    set = solver_set_at(w, island.set_index)
    if island.local_index < 0 || island.local_index >= set.island_sims.count { return false }
    if island_sim_at(set, island.local_index).island_id != island_id { return false }
    i = 0
    while i < island.bodies.count {
        body_id = core.ints_get(&island.bodies, i)
        body = body_at(w, body_id)
        if body.island_id != island_id || body.island_index != i { return false }
        if body.set_index != island.set_index { return false }
        i = i + 1
    }
    return true
}

create_island_for_body(w: *World, set_index: int, body: *Body) {
    island = create_island(w, set_index)
    core.ints_push(&island.bodies, body.id)
    body.island_id = island.island_id
    body.island_index = 0
}

remove_body_from_island(w: *World, body: *Body) {
    if body.island_id == NULL_INDEX { return }
    island_id = body.island_id
    island = island_at(w, island_id)
    local_index = body.island_index
    moved_body_id = core.ints_get(&island.bodies, island.bodies.count - 1)
    core.ints_set(&island.bodies, local_index, moved_body_id)
    body_at(w, moved_body_id).island_index = local_index
    island.bodies.count = island.bodies.count - 1
    if island.bodies.count == 0 { destroy_island(w, island.island_id) }
    body.island_id = NULL_INDEX
    body.island_index = NULL_INDEX
}

// --- bodies -------------------------------------------------------------------------------------------------

body_is_valid(id: BodyId) -> bool {
    if id.world0 < 0 || id.world0 >= MAX_WORLDS { return false }
    worlds_ready()
    w = world_at(id.world0)
    if w.in_use == false { return false }
    if id.index1 < 1 || id.index1 > w.bodies.count { return false }
    body = body_at(w, id.index1 - 1)
    if body.set_index == NULL_INDEX { return false }
    return body.generation == id.generation
}

get_body_full_id(w: *World, id: BodyId) -> *Body { return body_at(w, id.index1 - 1) }
get_body(w: *World, body_id: int) -> *Body { return body_at(w, body_id) }
get_body_sim(w: *World, body: *Body) -> *BodySim { return body_sim_at(solver_set_at(w, body.set_index), body.local_index) }

// The state exists for the awake set only; null otherwise.
get_body_state(w: *World, body: *Body) -> *BodyState {
    if body.set_index == AWAKE_SET { return body_state_at(solver_set_at(w, AWAKE_SET), body.local_index) }
    return null
}

get_body_transform(w: *World, body_id: int) -> Transform { return get_body_sim(w, body_at(w, body_id)).transform }
make_body_id(w: *World, body_id: int) -> BodyId { return BodyId { index1: body_id + 1, world0: w.world_id, generation: body_at(w, body_id).generation } }

// The body's flags onto its sim and state, never the transient ones.
sync_body_flags(w: *World, body: *Body) {
    flags = body.flags & (0 - 1 - BODY_TRANSIENT_FLAGS)
    get_body_sim(w, body).flags = flags
    state = get_body_state(w, body)
    if state != null { state.flags = flags }
}

// A body in the set its definition puts it in: disabled, static, awake,
// or asleep in a set of its own; dynamic and kinematic bodies get an island.
create_body(world_id: WorldId, def: *BodyDef) -> BodyId {
    if world_is_valid(world_id) == false { return null_body_id() }
    w = get_world_from_id(world_id)
    if w.locked { return null_body_id() }
    w.locked = true
    is_awake = (def.is_awake || def.enable_sleep == false) && def.is_enabled
    set_id = 0
    if def.is_enabled == false { set_id = DISABLED_SET }
    else if def.kind == BODY_STATIC { set_id = STATIC_SET }
    else if is_awake { set_id = AWAKE_SET }
    else { set_id = create_solver_set(w) }

    body_id = core.idpool_alloc(&w.body_id_pool)
    lock_flags = 0
    if def.motion_locks.linear_x { lock_flags = lock_flags | LOCK_LINEAR_X }
    if def.motion_locks.linear_y { lock_flags = lock_flags | LOCK_LINEAR_Y }
    if def.motion_locks.linear_z { lock_flags = lock_flags | LOCK_LINEAR_Z }
    if def.motion_locks.angular_x { lock_flags = lock_flags | LOCK_ANGULAR_X }
    if def.motion_locks.angular_y { lock_flags = lock_flags | LOCK_ANGULAR_Y }
    if def.motion_locks.angular_z { lock_flags = lock_flags | LOCK_ANGULAR_Z }

    set = solver_set_at(w, set_id)
    sim_index = core.buffer_push(&set.body_sims)
    sim = body_sim_at(set, sim_index)
    sim.transform = Transform { p: def.position, q: def.rotation }
    sim.center = def.position
    sim.rotation0 = def.rotation
    sim.center0 = def.position
    sim.local_center = math.vec3_zero()
    sim.force = math.vec3_zero()
    sim.torque = math.vec3_zero()
    sim.inv_mass = 0.0
    sim.inv_inertia_local = math.mat3_zero()
    sim.inv_inertia_world = math.mat3_zero()
    sim.min_extent = math.HUGE
    sim.max_extent = math.vec3_zero()
    sim.linear_damping = def.linear_damping
    sim.angular_damping = def.angular_damping
    sim.gravity_scale = def.gravity_scale
    sim.body_id = body_id
    flags = lock_flags
    if def.is_bullet { flags = flags | IS_BULLET }
    if def.allow_fast_rotation { flags = flags | ALLOW_FAST_ROTATION }
    if def.kind == BODY_DYNAMIC { flags = flags | DYNAMIC_FLAG }
    if def.enable_sleep { flags = flags | ENABLE_SLEEP }
    if def.enable_contact_recycling { flags = flags | ENABLE_CONTACT_RECYCLING }
    sim.flags = flags
    if set_id == AWAKE_SET {
        state_index = core.buffer_push(&set.body_states)
        state = body_state_at(set, state_index)
        state.linear_velocity = def.linear_velocity
        state.angular_velocity = def.angular_velocity
        state.delta_position = math.vec3_zero()
        state.delta_rotation = math.quat_identity()
        state.flags = flags
    }

    if body_id == w.bodies.count {
        index = core.buffer_push(&w.bodies)
        fresh = body_at(w, index)
        fresh.generation = 0
    }
    body = body_at(w, body_id)
    body.user_data = def.user_data
    body.set_index = set_id
    body.local_index = set.body_sims.count - 1
    body.generation = body.generation + 1
    body.head_shape_id = NULL_INDEX
    body.shape_count = 0
    body.head_contact_key = NULL_INDEX
    body.contact_count = 0
    body.head_joint_key = NULL_INDEX
    body.joint_count = 0
    body.island_id = NULL_INDEX
    body.island_index = NULL_INDEX
    body.body_move_index = NULL_INDEX
    body.id = body_id
    body.sleep_threshold = def.sleep_threshold
    body.sleep_time = 0.0
    body.sleep_velocity = 0.0
    body.safety_factor = def.safety_factor
    body.mass = 0.0
    body.inertia = math.mat3_zero()
    body.kind = def.kind
    body.flags = flags
    if set_id >= AWAKE_SET { create_island_for_body(w, set_id, body) }
    w.locked = false
    return BodyId { index1: body_id + 1, world0: w.world_id, generation: body.generation }
}

is_body_awake(w: *World, body: *Body) -> bool { return body.set_index == AWAKE_SET }

// A sleeping body's whole set wakes (the contacts and joints follow with their layers).
wake_body(w: *World, body: *Body) -> bool {
    if body.set_index >= FIRST_SLEEPING_SET {
        wake_solver_set(w, body.set_index)
        return true
    }
    return false
}

// The body's joints and contacts (with their layers), its shapes and their
// proxies, its island, its sim and state, then its id (the generation stays).
destroy_body(id: BodyId) {
    if body_is_valid(id) == false { return }
    w = world_at(id.world0)
    if w.locked { return }
    w.locked = true
    body = body_at(w, id.index1 - 1)
    // Bodies attached through contacts wake, even when this one is static.
    destroy_body_contacts(w, body, true)
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        if s.geometry.kind == KIND_COMPOUND { w.compound_shape_count = w.compound_shape_count - 1 }
        if s.proxy_key != NULL_INDEX {
            broad_phase.broad_phase_destroy_proxy(&w.broad_phase, s.proxy_key)
            s.proxy_key = NULL_INDEX
        }
        if s.materials != null {
            core.free_bytes(s.materials, s.material_count * sizeof(SurfaceMaterial))
            s.materials = null
            s.material_count = 0
        }
        core.idpool_free(&w.shape_id_pool, shape_id)
        s.id = NULL_INDEX
        shape_id = s.next_shape_id
    }
    remove_body_from_island(w, body)
    set = solver_set_at(w, body.set_index)
    moved_index = core.buffer_remove_swap(&set.body_sims, body.local_index)
    if moved_index != NULL_INDEX && moved_index != body.local_index {
        moved_sim = body_sim_at(set, body.local_index)
        body_at(w, moved_sim.body_id).local_index = body.local_index
    }
    if body.set_index == AWAKE_SET {
        core.buffer_remove_swap(&set.body_states, body.local_index)
    } else if set.set_index >= FIRST_SLEEPING_SET && set.body_sims.count == 0 {
        destroy_solver_set(w, set.set_index)
    }
    core.idpool_free(&w.body_id_pool, body.id)
    body.set_index = NULL_INDEX
    body.local_index = NULL_INDEX
    body.id = NULL_INDEX
    w.locked = false
}

// --- shapes -------------------------------------------------------------------------------------------------

// The margin a shape's fat bounds get: a fraction of its size, capped.
compute_shape_margin(g: *Shape) -> float {
    margin = 0.0
    kind = g.kind
    if kind == KIND_SPHERE { margin = g.sphere.radius }
    else if kind == KIND_CAPSULE { margin = 0.5 * math.distance(g.capsule.center2, g.capsule.center1) + g.capsule.radius }
    else if kind == KIND_HULL {
        points = hull.hull_points(g.hull)
        max_extent_sqr = 0.0
        i = 0
        while i < g.hull.vertex_count {
            max_extent_sqr = math.max_float(max_extent_sqr, math.distance_squared(points[i], g.hull.center))
            i = i + 1
        }
        margin = sqrt(max_extent_sqr)
    } else {
        // Static-only shapes: the broad phase uses the speculative distance for static proxies.
        return MAX_AABB_MARGIN
    }
    return math.min_float(MAX_AABB_MARGIN, AABB_MARGIN_FRACTION * margin)
}

// The shape's bounds with the speculative margin, and the fat bounds the
// broad phase holds (a static body's grow only by the speculative distance).
update_shape_aabbs(s: *WorldShape, t: Transform, proxy_kind: int) {
    box = shape.compute_fat_shape_aabb(&s.geometry, t, SPECULATIVE_DISTANCE)
    s.aabb = box
    margin = s.aabb_margin
    if proxy_kind == BODY_STATIC { margin = SPECULATIVE_DISTANCE }
    s.fat_aabb = AABB { lower: math.sub(box.lower, math.vec3(margin, margin, margin)), upper: math.add(box.upper, math.vec3(margin, margin, margin)) }
}

create_shape_proxy(w: *World, s: *WorldShape, kind: int, t: Transform, force_pair_creation: bool) {
    update_shape_aabbs(s, t, kind)
    s.proxy_key = broad_phase.broad_phase_create_proxy(&w.broad_phase, kind, s.fat_aabb, s.filter.category_bits, s.id, force_pair_creation)
}

// A shape on a body: its slot, its geometry, its materials, its proxy in
// the broad phase (unless the body is disabled), its place in the body's
// list, and the body's mass updated or marked dirty.
create_shape(body_id: BodyId, def: *ShapeDef, geometry: Shape) -> ShapeId {
    if body_is_valid(body_id) == false { return null_shape_id() }
    w = world_at(body_id.world0)
    if w.locked { return null_shape_id() }
    body = body_at(w, body_id.index1 - 1)
    kind = geometry.kind
    // Compounds and height fields go on static bodies only.
    if body.kind != BODY_STATIC && (kind == KIND_COMPOUND || kind == KIND_HEIGHT_FIELD) { return null_shape_id() }
    if kind == KIND_COMPOUND && def.is_sensor { return null_shape_id() }
    w.locked = true
    shape_id = core.idpool_alloc(&w.shape_id_pool)
    if shape_id == w.shapes.count {
        index = core.buffer_push(&w.shapes)
        fresh = world_shape_at(w, index)
        fresh.generation = 0
    }
    s = world_shape_at(w, shape_id)
    s.geometry = geometry
    s.geometry.density = def.density
    s.id = shape_id
    s.body_id = body.id
    s.explosion_scale = def.explosion_scale
    s.filter = def.filter
    s.user_data = def.user_data
    flags = 0
    if def.enable_sensor_events { flags = flags | SHAPE_ENABLE_SENSOR_EVENTS }
    if def.enable_contact_events { flags = flags | SHAPE_ENABLE_CONTACT_EVENTS }
    if def.enable_custom_filtering { flags = flags | SHAPE_ENABLE_CUSTOM_FILTERING }
    if def.enable_hit_events { flags = flags | SHAPE_ENABLE_HIT_EVENTS }
    if def.enable_pre_solve_events { flags = flags | SHAPE_ENABLE_PRE_SOLVE_EVENTS }
    if def.enable_speculative_contact { flags = flags | SHAPE_ENABLE_SPECULATIVE }
    s.flags = flags
    s.proxy_key = NULL_INDEX
    s.local_centroid = shape.get_shape_centroid(&s.geometry)
    s.aabb_margin = compute_shape_margin(&s.geometry)
    s.aabb = AABB { lower: math.vec3_zero(), upper: math.vec3_zero() }
    s.fat_aabb = s.aabb
    s.generation = s.generation + 1
    s.sensor_index = NULL_INDEX
    if kind == KIND_COMPOUND {
        w.compound_shape_count = w.compound_shape_count + 1
        // A copy of the compound's materials, so every shape frees its array the same way.
        count = s.geometry.compound.material_count
        s.material_count = count
        s.materials = core.alloc(count * sizeof(SurfaceMaterial))
        memcpy(s.materials, (s.geometry.compound as ptr) + s.geometry.compound.material_offset, count * sizeof(SurfaceMaterial))
        s.material = compound.get_compound_material(s.geometry.compound, 0)
    } else if def.material_count > 1 && def.materials != null {
        s.material_count = def.material_count
        s.materials = core.alloc(def.material_count * sizeof(SurfaceMaterial))
        memcpy(s.materials, def.materials, def.material_count * sizeof(SurfaceMaterial))
        given = def.materials as SurfaceMaterial[]
        s.material = given[0]
    } else {
        s.material = def.base_material
        if def.material_count == 1 && def.materials != null {
            given = def.materials as SurfaceMaterial[]
            s.material = given[0]
        }
        s.material_count = 1
        s.materials = null
    }
    s.geometry.material_count = s.material_count
    if body.set_index != DISABLED_SET {
        force = def.invoke_contact_creation && kind != KIND_COMPOUND
        create_shape_proxy(w, s, body.kind, get_body_sim(w, body).transform, force)
    }
    if body.head_shape_id != NULL_INDEX { world_shape_at(w, body.head_shape_id).prev_shape_id = shape_id }
    s.prev_shape_id = NULL_INDEX
    s.next_shape_id = body.head_shape_id
    body.head_shape_id = shape_id
    body.shape_count = body.shape_count + 1
    if def.is_sensor { s.sensor_index = 0 }   // the sensor layer gives it a sensor

    if def.update_body_mass {
        update_body_mass_data(w, body)
    } else if (body.flags & DIRTY_MASS) == 0 {
        body.flags = body.flags | DIRTY_MASS
        sync_body_flags(w, body)
    }
    w.locked = false
    return ShapeId { index1: shape_id + 1, world0: w.world_id, generation: s.generation }
}

create_sphere_shape(body_id: BodyId, def: *ShapeDef, s: Sphere) -> ShapeId { return create_shape(body_id, def, shape.sphere_shape(s, def.density)) }
create_capsule_shape(body_id: BodyId, def: *ShapeDef, c: Capsule) -> ShapeId { return create_shape(body_id, def, shape.capsule_shape(c, def.density)) }
create_hull_shape(body_id: BodyId, def: *ShapeDef, h: *HullData) -> ShapeId { return create_shape(body_id, def, shape.hull_shape(h, def.density)) }
create_mesh_shape(body_id: BodyId, def: *ShapeDef, m: *MeshData, scale: Vec3) -> ShapeId {
    return create_shape(body_id, def, shape.mesh_shape(mesh.mesh(m, scale), math.max_int(def.material_count, 1)))
}
create_height_field_shape(body_id: BodyId, def: *ShapeDef, h: *HeightFieldData) -> ShapeId {
    return create_shape(body_id, def, shape.height_field_shape(h, math.max_int(def.material_count, 1)))
}
create_compound_shape(body_id: BodyId, def: *ShapeDef, c: *CompoundData) -> ShapeId { return create_shape(body_id, def, shape.compound_shape(c)) }

shape_is_valid(id: ShapeId) -> bool {
    if id.world0 < 0 || id.world0 >= MAX_WORLDS { return false }
    worlds_ready()
    w = world_at(id.world0)
    if w.in_use == false { return false }
    if id.index1 < 1 || id.index1 > w.shapes.count { return false }
    s = world_shape_at(w, id.index1 - 1)
    if s.id == NULL_INDEX { return false }
    return s.generation == id.generation
}

get_shape_full_id(w: *World, id: ShapeId) -> *WorldShape { return world_shape_at(w, id.index1 - 1) }
get_shape(w: *World, shape_id: int) -> *WorldShape { return world_shape_at(w, shape_id) }

// The shape leaves its body's list and the broad phase; the body's mass
// is updated when asked.
destroy_shape(id: ShapeId, update_body_mass: bool) {
    if shape_is_valid(id) == false { return }
    w = world_at(id.world0)
    if w.locked { return }
    w.locked = true
    s = world_shape_at(w, id.index1 - 1)
    body = body_at(w, s.body_id)
    destroy_shape_contacts(w, s, true)
    if s.prev_shape_id != NULL_INDEX { world_shape_at(w, s.prev_shape_id).next_shape_id = s.next_shape_id }
    if s.next_shape_id != NULL_INDEX { world_shape_at(w, s.next_shape_id).prev_shape_id = s.prev_shape_id }
    if body.head_shape_id == s.id { body.head_shape_id = s.next_shape_id }
    body.shape_count = body.shape_count - 1
    if s.geometry.kind == KIND_COMPOUND { w.compound_shape_count = w.compound_shape_count - 1 }
    if s.proxy_key != NULL_INDEX {
        broad_phase.broad_phase_destroy_proxy(&w.broad_phase, s.proxy_key)
        s.proxy_key = NULL_INDEX
    }
    if s.materials != null {
        core.free_bytes(s.materials, s.material_count * sizeof(SurfaceMaterial))
        s.materials = null
        s.material_count = 0
    }
    core.idpool_free(&w.shape_id_pool, s.id)
    s.id = NULL_INDEX
    if update_body_mass { update_body_mass_data(w, body) }
    w.locked = false
}

shape_get_body(id: ShapeId) -> BodyId {
    w = world_at(id.world0)
    return make_body_id(w, get_shape_full_id(w, id).body_id)
}
shape_get_aabb(id: ShapeId) -> AABB { return get_shape_full_id(world_at(id.world0), id).aabb }
shape_get_type(id: ShapeId) -> int { return get_shape_full_id(world_at(id.world0), id).geometry.kind }
shape_get_density(id: ShapeId) -> float { return get_shape_full_id(world_at(id.world0), id).geometry.density }
shape_set_density(id: ShapeId, density: float, update_body_mass: bool) {
    w = world_at(id.world0)
    s = get_shape_full_id(w, id)
    s.geometry.density = density
    if update_body_mass { update_body_mass_data(w, body_at(w, s.body_id)) }
}
shape_get_filter(id: ShapeId) -> Filter { return get_shape_full_id(world_at(id.world0), id).filter }
shape_set_filter(id: ShapeId, filter: Filter) { get_shape_full_id(world_at(id.world0), id).filter = filter }
shape_get_surface_material(id: ShapeId) -> SurfaceMaterial { return get_shape_full_id(world_at(id.world0), id).material }
shape_set_surface_material(id: ShapeId, m: SurfaceMaterial) {
    s = get_shape_full_id(world_at(id.world0), id)
    s.material = m
    if s.materials != null {
        materials = s.materials as SurfaceMaterial[]
        materials[0] = m
    }
}
shape_get_material_count(id: ShapeId) -> int { return get_shape_full_id(world_at(id.world0), id).material_count }
shape_is_sensor(id: ShapeId) -> bool { return get_shape_full_id(world_at(id.world0), id).sensor_index != NULL_INDEX }
shape_set_user_data(id: ShapeId, data: ptr) { get_shape_full_id(world_at(id.world0), id).user_data = data }
shape_get_user_data(id: ShapeId) -> ptr { return get_shape_full_id(world_at(id.world0), id).user_data }
shape_get_flags(id: ShapeId) -> int { return get_shape_full_id(world_at(id.world0), id).flags }

// --- mass ---------------------------------------------------------------------------------------------------

var g_masses: ptr = null   // MassData[]; the shapes' masses during an update
var g_mass_capacity = 0

// The body's mass, centre of mass, inertia about it (each shape's
// carried over by Steiner), the inverse inertia in the world, and its
// extents from the centre; static and kinematic bodies get no mass, and
// a kinematic one keeps its extents (for sleeping). Fixed rotation zeroes
// the inertia.
update_body_mass_data(w: *World, body: *Body) {
    sim = get_body_sim(w, body)
    body.flags = body.flags & (0 - 1 - DIRTY_MASS)
    sync_body_flags(w, body)
    body.mass = 0.0
    body.inertia = math.mat3_zero()
    sim.inv_mass = 0.0
    sim.inv_inertia_local = math.mat3_zero()
    sim.inv_inertia_world = math.mat3_zero()
    sim.local_center = math.vec3_zero()
    sim.min_extent = math.HUGE
    sim.max_extent = math.vec3_zero()
    if body.head_shape_id == NULL_INDEX { return }

    if body.kind != BODY_DYNAMIC {
        sim.center = sim.transform.p
        sim.center0 = sim.center
        if body.kind == BODY_KINEMATIC {
            shape_id = body.head_shape_id
            while shape_id != NULL_INDEX {
                s = world_shape_at(w, shape_id)
                extent = shape.compute_shape_extent(&s.geometry, math.vec3_zero())
                sim.min_extent = math.min_float(sim.min_extent, extent.min_extent)
                sim.max_extent = math.max_vec3(sim.max_extent, extent.max_extent)
                shape_id = s.next_shape_id
            }
        }
        return
    }

    shape_count = body.shape_count
    if shape_count > g_mass_capacity {
        core.free_bytes(g_masses, g_mass_capacity * sizeof(MassData))
        g_mass_capacity = math.max_int(shape_count, 8)
        g_masses = core.alloc(g_mass_capacity * sizeof(MassData))
    }
    masses = g_masses as MassData[]
    local_center = math.vec3_zero()
    shape_id = body.head_shape_id
    shape_index = 0
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        shape_id = s.next_shape_id
        if s.geometry.density == 0.0 {
            masses[shape_index] = MassData { mass: 0.0, center: math.vec3_zero(), inertia: math.mat3_zero() }
        } else {
            mass_data = shape.compute_shape_mass(&s.geometry)
            body.mass = body.mass + mass_data.mass
            local_center = math.mul_add(local_center, mass_data.mass, mass_data.center)
            masses[shape_index] = mass_data
        }
        shape_index = shape_index + 1
    }
    if body.mass > 0.0 {
        sim.inv_mass = 1.0 / body.mass
        local_center = math.mul_sv(sim.inv_mass, local_center)
    }
    shape_index = 0
    while shape_index < shape_count {
        mass_data = masses[shape_index]
        if mass_data.mass != 0.0 {
            // Shifted to the centre of mass; it can only grow.
            offset = math.sub(local_center, mass_data.center)
            body.inertia = math.add_mm(body.inertia, math.add_mm(mass_data.inertia, math.steiner(mass_data.mass, offset)))
        }
        shape_index = shape_index + 1
    }
    determinant = math.det(body.inertia)
    if determinant > 0.0 {
        sim.inv_inertia_local = math.invert_t(body.inertia)
        rotation = math.make_matrix_from_quat(sim.transform.q)
        sim.inv_inertia_world = math.mul_mm(math.mul_mm(rotation, sim.inv_inertia_local), math.transpose(rotation))
    }
    // The centre of mass moves: the velocity follows the new material point.
    old_center = sim.center
    sim.local_center = local_center
    sim.center = math.transform_point(sim.transform, local_center)
    sim.center0 = sim.center
    state = get_body_state(w, body)
    if state != null {
        state.linear_velocity = math.add(state.linear_velocity, math.cross(state.angular_velocity, math.sub(sim.center, old_center)))
    }
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        extent = shape.compute_shape_extent(&s.geometry, local_center)
        sim.min_extent = math.min_float(sim.min_extent, extent.min_extent)
        sim.max_extent = math.max_vec3(sim.max_extent, extent.max_extent)
        shape_id = s.next_shape_id
    }
    // A moved centre of mass invalidates every cached manifold.
    invalidate_body_contacts(w, body)
    if (sim.flags & FIXED_ROTATION) == FIXED_ROTATION {
        body.inertia = math.mat3_zero()
        sim.inv_inertia_local = math.mat3_zero()
        sim.inv_inertia_world = math.mat3_zero()
    }
}

// --- the body's public face ------------------------------------------------------------------------------

body_world(id: BodyId) -> *World { return world_at(id.world0) }

body_get_position(id: BodyId) -> Vec3 { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).transform.p }
body_get_rotation(id: BodyId) -> Quat { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).transform.q }
body_get_transform(id: BodyId) -> Transform { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).transform }
body_get_local_point(id: BodyId, world_point: Vec3) -> Vec3 { return math.inv_transform_point(body_get_transform(id), world_point) }
body_get_world_point(id: BodyId, local_point: Vec3) -> Vec3 { return math.transform_point(body_get_transform(id), local_point) }
body_get_local_vector(id: BodyId, world_vector: Vec3) -> Vec3 { return math.inv_rotate_vector(body_get_rotation(id), world_vector) }
body_get_world_vector(id: BodyId, local_vector: Vec3) -> Vec3 { return math.rotate_vector(body_get_rotation(id), local_vector) }

// The body moved by hand: its centre and inverse world inertia follow,
// its shapes' bounds and proxies are updated at once (a static body's
// too, so contacts begin without a step).
body_set_transform(id: BodyId, position: Vec3, rotation: Quat) {
    w = body_world(id)
    if w.locked { return }
    body = get_body_full_id(w, id)
    sim = get_body_sim(w, body)
    sim.transform = Transform { p: position, q: rotation }
    sim.center = math.transform_point(sim.transform, sim.local_center)
    sim.rotation0 = rotation
    sim.center0 = sim.center
    r = math.make_matrix_from_quat(rotation)
    sim.inv_inertia_world = math.mul_mm(math.mul_mm(r, sim.inv_inertia_local), math.transpose(r))
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        if s.proxy_key != NULL_INDEX {
            update_shape_aabbs(s, sim.transform, body.kind)
            broad_phase.broad_phase_move_proxy(&w.broad_phase, s.proxy_key, s.fat_aabb)
        }
        shape_id = s.next_shape_id
    }
    invalidate_body_contacts(w, body)
}

body_get_linear_velocity(id: BodyId) -> Vec3 {
    w = body_world(id)
    state = get_body_state(w, get_body_full_id(w, id))
    if state == null { return math.vec3_zero() }
    return state.linear_velocity
}

body_get_angular_velocity(id: BodyId) -> Vec3 {
    w = body_world(id)
    state = get_body_state(w, get_body_full_id(w, id))
    if state == null { return math.vec3_zero() }
    return state.angular_velocity
}

// A velocity wakes a sleeping body; a static body has none.
body_set_linear_velocity(id: BodyId, v: Vec3) {
    w = body_world(id)
    body = get_body_full_id(w, id)
    if body.kind == BODY_STATIC { return }
    if math.length_squared(v) > 0.0 { wake_body(w, body) }
    state = get_body_state(w, body)
    if state != null { state.linear_velocity = v }
}

body_set_angular_velocity(id: BodyId, v: Vec3) {
    w = body_world(id)
    body = get_body_full_id(w, id)
    if body.kind == BODY_STATIC { return }
    // The locks apply, so a locked axis does not wake the body.
    wx = v.x
    wy = v.y
    wz = v.z
    if (body.flags & LOCK_ANGULAR_X) != 0 { wx = 0.0 }
    if (body.flags & LOCK_ANGULAR_Y) != 0 { wy = 0.0 }
    if (body.flags & LOCK_ANGULAR_Z) != 0 { wz = 0.0 }
    locked = math.vec3(wx, wy, wz)
    if math.length_squared(locked) != 0.0 { wake_body(w, body) }
    state = get_body_state(w, body)
    if state != null { state.angular_velocity = locked }
}

body_get_local_point_velocity(id: BodyId, local_point: Vec3) -> Vec3 {
    w = body_world(id)
    body = get_body_full_id(w, id)
    state = get_body_state(w, body)
    if state == null { return math.vec3_zero() }
    sim = get_body_sim(w, body)
    r = math.rotate_vector(sim.transform.q, math.sub(local_point, sim.local_center))
    return math.add(state.linear_velocity, math.cross(state.angular_velocity, r))
}

body_get_world_point_velocity(id: BodyId, world_point: Vec3) -> Vec3 {
    w = body_world(id)
    body = get_body_full_id(w, id)
    state = get_body_state(w, body)
    if state == null { return math.vec3_zero() }
    sim = get_body_sim(w, body)
    return math.add(state.linear_velocity, math.cross(state.angular_velocity, math.sub(world_point, sim.center)))
}

body_get_type(id: BodyId) -> int { return get_body_full_id(body_world(id), id).kind }
body_get_mass(id: BodyId) -> float { return get_body_full_id(body_world(id), id).mass }
body_get_inverse_mass(id: BodyId) -> float { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).inv_mass }
body_get_local_rotational_inertia(id: BodyId) -> Matrix3 { return get_body_full_id(body_world(id), id).inertia }
body_get_world_inverse_rotational_inertia(id: BodyId) -> Matrix3 { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).inv_inertia_world }
body_get_local_center(id: BodyId) -> Vec3 { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).local_center }
body_get_world_center(id: BodyId) -> Vec3 { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).center }
body_get_min_extent(id: BodyId) -> float { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).min_extent }
body_get_max_extent(id: BodyId) -> Vec3 { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).max_extent }
body_get_max_extent_origin(id: BodyId) -> Vec3 {
    w = body_world(id)
    sim = get_body_sim(w, get_body_full_id(w, id))
    return math.add(sim.max_extent, math.abs_vec3(sim.local_center))
}

// Mass properties set by hand, bypassing the shapes: the inverses, the
// world inertia under the body's rotation, the velocity re-referenced
// to the new centre, the extents about it; fixed rotation zeroes the inertia.
body_set_mass_data(id: BodyId, mass_data: MassData) {
    w = body_world(id)
    if w.locked { return }
    body = get_body_full_id(w, id)
    sim = get_body_sim(w, body)
    body.flags = body.flags & (0 - 1 - DIRTY_MASS)
    sync_body_flags(w, body)
    body.mass = mass_data.mass
    body.inertia = mass_data.inertia
    sim.local_center = mass_data.center
    old_center = sim.center
    sim.center = math.transform_point(sim.transform, mass_data.center)
    sim.center0 = sim.center
    sim.inv_mass = 0.0
    if body.mass > 0.0 { sim.inv_mass = 1.0 / body.mass }
    state = get_body_state(w, body)
    if state != null {
        state.linear_velocity = math.add(state.linear_velocity, math.cross(state.angular_velocity, math.sub(sim.center, old_center)))
    }
    determinant = math.det(body.inertia)
    if determinant > 0.0 {
        sim.inv_inertia_local = math.invert_t(body.inertia)
        r = math.make_matrix_from_quat(sim.transform.q)
        sim.inv_inertia_world = math.mul_mm(math.mul_mm(r, sim.inv_inertia_local), math.transpose(r))
    } else {
        sim.inv_inertia_local = math.mat3_zero()
        sim.inv_inertia_world = math.mat3_zero()
    }
    if (sim.flags & FIXED_ROTATION) == FIXED_ROTATION {
        body.inertia = math.mat3_zero()
        sim.inv_inertia_local = math.mat3_zero()
        sim.inv_inertia_world = math.mat3_zero()
    }
    sim.min_extent = math.HUGE
    sim.max_extent = math.vec3_zero()
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        extent = shape.compute_shape_extent(&s.geometry, mass_data.center)
        sim.min_extent = math.min_float(sim.min_extent, extent.min_extent)
        sim.max_extent = math.max_vec3(sim.max_extent, extent.max_extent)
        shape_id = s.next_shape_id
    }
    invalidate_body_contacts(w, body)
}

body_get_mass_data(id: BodyId) -> MassData {
    w = body_world(id)
    body = get_body_full_id(w, id)
    return MassData { mass: body.mass, center: get_body_sim(w, body).local_center, inertia: body.inertia }
}

body_apply_mass_from_shapes(id: BodyId) {
    w = body_world(id)
    if w.locked { return }
    update_body_mass_data(w, get_body_full_id(w, id))
}

body_set_linear_damping(id: BodyId, damping: float) { w = body_world(id); get_body_sim(w, get_body_full_id(w, id)).linear_damping = damping }
body_get_linear_damping(id: BodyId) -> float { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).linear_damping }
body_set_angular_damping(id: BodyId, damping: float) { w = body_world(id); get_body_sim(w, get_body_full_id(w, id)).angular_damping = damping }
body_get_angular_damping(id: BodyId) -> float { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).angular_damping }
body_set_gravity_scale(id: BodyId, scale: float) { w = body_world(id); get_body_sim(w, get_body_full_id(w, id)).gravity_scale = scale }
body_get_gravity_scale(id: BodyId) -> float { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).gravity_scale }
body_set_user_data(id: BodyId, data: ptr) { get_body_full_id(body_world(id), id).user_data = data }
body_get_user_data(id: BodyId) -> ptr { return get_body_full_id(body_world(id), id).user_data }
body_is_awake(id: BodyId) -> bool { return get_body_full_id(body_world(id), id).set_index == AWAKE_SET }
body_is_enabled(id: BodyId) -> bool { return get_body_full_id(body_world(id), id).set_index != DISABLED_SET }
body_is_sleep_enabled(id: BodyId) -> bool { return (get_body_full_id(body_world(id), id).flags & ENABLE_SLEEP) != 0 }
body_get_sleep_threshold(id: BodyId) -> float { return get_body_full_id(body_world(id), id).sleep_threshold }
body_set_sleep_threshold(id: BodyId, threshold: float) { get_body_full_id(body_world(id), id).sleep_threshold = threshold }
body_get_shape_count(id: BodyId) -> int { return get_body_full_id(body_world(id), id).shape_count }
body_get_flags(id: BodyId) -> int { return get_body_full_id(body_world(id), id).flags }

// Waking a sleeping body (putting one to sleep needs the island's sleep test, with the solver).
body_set_awake(id: BodyId, awake: bool) {
    w = body_world(id)
    if w.locked { return }
    body = get_body_full_id(w, id)
    if awake { wake_body(w, body) }
}

body_enable_sleep(id: BodyId, enable: bool) {
    w = body_world(id)
    body = get_body_full_id(w, id)
    if enable {
        body.flags = body.flags | ENABLE_SLEEP
    } else {
        body.flags = body.flags & (0 - 1 - ENABLE_SLEEP)
        wake_body(w, body)
    }
    sync_body_flags(w, body)
}

body_set_motion_locks(id: BodyId, locks: MotionLocks) {
    w = body_world(id)
    body = get_body_full_id(w, id)
    flags = body.flags & (0 - 1 - ALL_LOCKS)
    if locks.linear_x { flags = flags | LOCK_LINEAR_X }
    if locks.linear_y { flags = flags | LOCK_LINEAR_Y }
    if locks.linear_z { flags = flags | LOCK_LINEAR_Z }
    if locks.angular_x { flags = flags | LOCK_ANGULAR_X }
    if locks.angular_y { flags = flags | LOCK_ANGULAR_Y }
    if locks.angular_z { flags = flags | LOCK_ANGULAR_Z }
    if flags != body.flags {
        body.flags = flags
        sync_body_flags(w, body)
        update_body_mass_data(w, body)
    }
}

body_get_motion_locks(id: BodyId) -> MotionLocks {
    flags = get_body_full_id(body_world(id), id).flags
    return MotionLocks { linear_x: (flags & LOCK_LINEAR_X) != 0, linear_y: (flags & LOCK_LINEAR_Y) != 0, linear_z: (flags & LOCK_LINEAR_Z) != 0,
                         angular_x: (flags & LOCK_ANGULAR_X) != 0, angular_y: (flags & LOCK_ANGULAR_Y) != 0, angular_z: (flags & LOCK_ANGULAR_Z) != 0 }
}

// The body's shape ids into an array, up to the capacity; returns how many.
body_get_shapes(id: BodyId, shape_ids: ShapeId[], capacity: int) -> int {
    w = body_world(id)
    body = get_body_full_id(w, id)
    count = 0
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX && count < capacity {
        s = world_shape_at(w, shape_id)
        shape_ids[count] = ShapeId { index1: shape_id + 1, world0: w.world_id, generation: s.generation }
        count = count + 1
        shape_id = s.next_shape_id
    }
    return count
}

// The bounds of every shape on the body.
body_compute_aabb(id: BodyId) -> AABB {
    w = body_world(id)
    body = get_body_full_id(w, id)
    if body.head_shape_id == NULL_INDEX {
        p = get_body_sim(w, body).transform.p
        return AABB { lower: p, upper: p }
    }
    s = world_shape_at(w, body.head_shape_id)
    box = s.aabb
    shape_id = s.next_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        box = AABB { lower: math.min_vec3(box.lower, s.aabb.lower), upper: math.max_vec3(box.upper, s.aabb.upper) }
        shape_id = s.next_shape_id
    }
    return box
}

// --- validation ----------------------------------------------------------------------------------------------

// Every live body's sim is where its indices say, with a state in the
// awake set and none elsewhere, every set's sims point back at live
// bodies, every island is consistent, and the shape lists close.
validate_solver_sets(w: *World) -> bool {
    body_count = 0
    i = 0
    while i < w.bodies.count {
        body = body_at(w, i)
        if body.set_index != NULL_INDEX {
            body_count = body_count + 1
            if body.id != i { return false }
            set = solver_set_at(w, body.set_index)
            if set.set_index != body.set_index { return false }
            if body.local_index < 0 || body.local_index >= set.body_sims.count { return false }
            if body_sim_at(set, body.local_index).body_id != i { return false }
            if body.set_index == AWAKE_SET && set.body_states.count != set.body_sims.count { return false }
            if body.set_index == DISABLED_SET && body.island_id != NULL_INDEX { return false }
            if body.set_index >= AWAKE_SET && body.island_id == NULL_INDEX { return false }
            if body.island_id != NULL_INDEX && validate_island(w, body.island_id) == false { return false }
            // The shape list.
            count = 0
            shape_id = body.head_shape_id
            prev = NULL_INDEX
            while shape_id != NULL_INDEX {
                s = world_shape_at(w, shape_id)
                if s.id != shape_id || s.body_id != i || s.prev_shape_id != prev { return false }
                if body.set_index != DISABLED_SET && s.proxy_key == NULL_INDEX { return false }
                if body.set_index == DISABLED_SET && s.proxy_key != NULL_INDEX { return false }
                count = count + 1
                prev = shape_id
                shape_id = s.next_shape_id
            }
            if count != body.shape_count { return false }
        }
        i = i + 1
    }
    if body_count != core.idpool_count(&w.body_id_pool) { return false }
    sim_count = 0
    i = 0
    while i < w.solver_sets.count {
        set = solver_set_at(w, i)
        if set.set_index != NULL_INDEX {
            if set.set_index != i { return false }
            j = 0
            while j < set.body_sims.count {
                body = body_at(w, body_sim_at(set, j).body_id)
                if body.set_index != i || body.local_index != j { return false }
                j = j + 1
            }
            sim_count = sim_count + set.body_sims.count
            if i >= FIRST_SLEEPING_SET && set.body_sims.count == 0 { return false }
            if i == STATIC_SET && set.island_sims.count != 0 { return false }
            if i == DISABLED_SET && set.island_sims.count != 0 { return false }
        }
        i = i + 1
    }
    if sim_count != body_count { return false }
    return true
}

// --- element access, continued ----------------------------------------------------------------------

contact_at(w: *World, id: int) -> *Contact { return (w.contacts.data + id * sizeof(Contact)) as *Contact }
joint_at(w: *World, id: int) -> *Joint { return (w.joints.data + id * sizeof(Joint)) as *Joint }
manifold_at(c: *Contact, index: int) -> *Manifold { return (c.manifolds + index * sizeof(Manifold)) as *Manifold }
graph_color(w: *World, index: int) -> *GraphColor { return (w.constraint_graph.colors + index * sizeof(GraphColor)) as *GraphColor }
contact_spec_at(color: *GraphColor, index: int) -> *ContactSpec { return (color.contacts.data + index * sizeof(ContactSpec)) as *ContactSpec }
joint_sim_at(b: *Buffer, index: int) -> *JointSim { return (b.data + index * sizeof(JointSim)) as *JointSim }
contact_link_at(island: *Island, index: int) -> *ContactLink { return (island.contacts.data + index * sizeof(ContactLink)) as *ContactLink }
joint_link_at(island: *Island, index: int) -> *JointLink { return (island.joints.data + index * sizeof(JointLink)) as *JointLink }

// A manifold's point, by index (the points are four named fields).
manifold_point_at(m: *Manifold, index: int) -> *ManifoldPoint { return ((m as ptr) + index * sizeof(ManifoldPoint)) as *ManifoldPoint }

world_contact_count(w: *World) -> int { return core.idpool_count(&w.contact_id_pool) }
get_contact(w: *World, contact_id: int) -> *Contact { return contact_at(w, contact_id) }

contact_is_valid(id: ContactId) -> bool {
    if id.world0 < 0 || id.world0 >= MAX_WORLDS { return false }
    worlds_ready()
    w = world_at(id.world0)
    if w.in_use == false { return false }
    if id.index1 < 1 || id.index1 > w.contacts.count { return false }
    c = contact_at(w, id.index1 - 1)
    return c.contact_id == id.index1 - 1 && c.generation == id.generation
}

make_contact_id(w: *World, c: *Contact) -> ContactId { return ContactId { index1: c.contact_id + 1, world0: w.world_id, generation: c.generation } }
make_shape_id(w: *World, s: *WorldShape) -> ShapeId { return ShapeId { index1: s.id + 1, world0: w.world_id, generation: s.generation } }

// The events of the last collide pass.
world_contact_begin_event_count(w: *World) -> int { return w.contact_begin_events.count }
world_contact_begin_event(w: *World, index: int) -> ContactBeginTouchEvent {
    events = w.contact_begin_events.data as ContactBeginTouchEvent[]
    return events[index]
}
end_events(w: *World) -> *Buffer {
    if w.end_event_index == 0 { return &w.contact_end_events0 }
    return &w.contact_end_events1
}
world_contact_end_event_count(w: *World) -> int { return end_events(w).count }
world_contact_end_event(w: *World, index: int) -> ContactEndTouchEvent {
    events = end_events(w).data as ContactEndTouchEvent[]
    return events[index]
}

// --- the constraint graph ------------------------------------------------------------------------------

create_graph(g: *ConstraintGraph, body_capacity: int) {
    g.colors = core.alloc(GRAPH_COLOR_COUNT * sizeof(GraphColor))
    capacity = math.max_int(body_capacity, 8)
    i = 0
    while i < GRAPH_COLOR_COUNT {
        color = (g.colors + i * sizeof(GraphColor)) as *GraphColor
        if i < OVERFLOW_INDEX {
            color.body_set = core.bitset_create(capacity)
            core.bitset_set_count_and_clear(&color.body_set, capacity)
        }
        color.joint_sims = core.buffer_create(sizeof(JointSim), 0)
        color.convex_contacts = core.ints_create(0)
        color.contacts = core.buffer_create(sizeof(ContactSpec), 0)
        i = i + 1
    }
}

destroy_graph(g: *ConstraintGraph) {
    i = 0
    while i < GRAPH_COLOR_COUNT {
        color = (g.colors + i * sizeof(GraphColor)) as *GraphColor
        if i < OVERFLOW_INDEX { core.bitset_destroy(&color.body_set) }
        core.buffer_destroy(&color.joint_sims)
        core.ints_destroy(&color.convex_contacts)
        core.buffer_destroy(&color.contacts)
        i = i + 1
    }
    core.free_bytes(g.colors, GRAPH_COLOR_COUNT * sizeof(GraphColor))
    g.colors = null
}

// The first colour where neither dynamic body is taken: dynamic pairs
// from the front, pairs with a static or kinematic body from the back
// (they get priority), the overflow when none is free.
assign_color(g: *ConstraintGraph, body_id_a: int, body_id_b: int, kind_a: int, kind_b: int) -> int {
    if kind_a == BODY_DYNAMIC && kind_b == BODY_DYNAMIC {
        i = 0
        while i < DYNAMIC_COLOR_COUNT {
            color = (g.colors + i * sizeof(GraphColor)) as *GraphColor
            if core.bitset_get(&color.body_set, body_id_a) == false && core.bitset_get(&color.body_set, body_id_b) == false {
                core.bitset_set_grow(&color.body_set, body_id_a)
                core.bitset_set_grow(&color.body_set, body_id_b)
                return i
            }
            i = i + 1
        }
    } else if kind_a == BODY_DYNAMIC {
        i = OVERFLOW_INDEX - 1
        while i >= 1 {
            color = (g.colors + i * sizeof(GraphColor)) as *GraphColor
            if core.bitset_get(&color.body_set, body_id_a) == false {
                core.bitset_set_grow(&color.body_set, body_id_a)
                return i
            }
            i = i - 1
        }
    } else if kind_b == BODY_DYNAMIC {
        i = OVERFLOW_INDEX - 1
        while i >= 1 {
            color = (g.colors + i * sizeof(GraphColor)) as *GraphColor
            if core.bitset_get(&color.body_set, body_id_b) == false {
                core.bitset_set_grow(&color.body_set, body_id_b)
                return i
            }
            i = i - 1
        }
    }
    return OVERFLOW_INDEX
}

// A touching contact into a colour: convex contacts into the wide array,
// mesh contacts and the overflow's into the scalar one.
add_contact_to_graph(w: *World, c: *Contact) {
    body_a = body_at(w, c.edge_a.body_id)
    body_b = body_at(w, c.edge_b.body_id)
    color_index = assign_color(&w.constraint_graph, body_a.id, body_b.id, body_a.kind, body_b.kind)
    is_scalar = (c.flags & SIM_MESH_CONTACT) != 0 || color_index == OVERFLOW_INDEX
    color = graph_color(w, color_index)
    c.color_index = color_index
    c.body_sim_index_a = body_a.local_index
    if body_a.kind == BODY_STATIC { c.body_sim_index_a = NULL_INDEX }
    c.body_sim_index_b = body_b.local_index
    if body_b.kind == BODY_STATIC { c.body_sim_index_b = NULL_INDEX }
    if is_scalar {
        c.local_index = color.contacts.count
        index = core.buffer_push(&color.contacts)
        spec = contact_spec_at(color, index)
        spec.contact_id = c.contact_id
        spec.manifold_start = 0
        spec.manifold_count = c.manifold_count
    } else {
        c.local_index = color.convex_contacts.count
        core.ints_push(&color.convex_contacts, c.contact_id)
    }
}

remove_contact_from_graph(w: *World, body_id_a: int, body_id_b: int, color_index: int, local_index: int, mesh_contact: bool) {
    color = graph_color(w, color_index)
    if color_index != OVERFLOW_INDEX {
        core.bitset_clear(&color.body_set, body_id_a)
        core.bitset_clear(&color.body_set, body_id_b)
    }
    if mesh_contact || color_index == OVERFLOW_INDEX {
        moved = core.buffer_remove_swap(&color.contacts, local_index)
        if moved != NULL_INDEX && moved != local_index {
            contact_at(w, contact_spec_at(color, local_index).contact_id).local_index = local_index
        }
    } else {
        moved = core.ints_remove_swap(&color.convex_contacts, local_index)
        if moved != NULL_INDEX && moved != local_index {
            contact_at(w, core.ints_get(&color.convex_contacts, local_index)).local_index = local_index
        }
    }
}

// --- contacts ------------------------------------------------------------------------------------------------

// The pairs of kinds that collide, with the mesh-like or larger kind first.
contact_pair_supported(kind_a: int, kind_b: int) -> bool {
    convex_b = kind_b == KIND_SPHERE || kind_b == KIND_CAPSULE || kind_b == KIND_HULL
    if convex_b == false { return false }
    return kind_a == KIND_SPHERE && kind_b == KIND_SPHERE ||
           kind_a == KIND_CAPSULE && (kind_b == KIND_SPHERE || kind_b == KIND_CAPSULE) ||
           kind_a == KIND_HULL || kind_a == KIND_MESH || kind_a == KIND_HEIGHT_FIELD || kind_a == KIND_COMPOUND
}

// Whether the pair as given is the primary order, or must be flipped.
contact_pair_primary(kind_a: int, kind_b: int) -> bool {
    if kind_a == kind_b { return true }
    return contact_pair_supported(kind_a, kind_b)
}

// A contact between two shapes (a compound's child named), non-touching,
// in the awake set if either body is awake and the disabled set
// otherwise, linked into both bodies' lists and the broad phase's pair set.
create_contact(w: *World, shape_a: *WorldShape, shape_b: *WorldShape, child_index: int) {
    kind_a = shape_a.geometry.kind
    kind_b = shape_b.geometry.kind
    if contact_pair_supported(kind_a, kind_b) == false && contact_pair_supported(kind_b, kind_a) == false { return }
    if contact_pair_primary(kind_a, kind_b) == false {
        create_contact(w, shape_b, shape_a, child_index)
        return
    }
    body_a = body_at(w, shape_a.body_id)
    body_b = body_at(w, shape_b.body_id)
    set_index = DISABLED_SET
    if body_a.set_index == AWAKE_SET || body_b.set_index == AWAKE_SET { set_index = AWAKE_SET }
    set = solver_set_at(w, set_index)
    contact_id = core.idpool_alloc(&w.contact_id_pool)
    if contact_id == w.contacts.count {
        index = core.buffer_push(&w.contacts)
        contact_at(w, index).generation = 0
    }
    c = contact_at(w, contact_id)
    generation = c.generation
    memset(c as ptr, 0, sizeof(Contact))
    c.contact_id = contact_id
    c.generation = generation + 1
    c.set_index = set_index
    c.color_index = NULL_INDEX
    c.local_index = set.contact_indices.count
    c.island_id = NULL_INDEX
    c.island_index = NULL_INDEX
    c.body_sim_index_a = NULL_INDEX
    c.body_sim_index_b = NULL_INDEX
    c.shape_id_a = shape_a.id
    c.shape_id_b = shape_b.id
    c.child_index = child_index
    c.manifolds = null
    c.manifold_count = 0
    c.mesh_cache = mesh_contact.mesh_contact_cache_create()
    c.convex_cache = TriangleCache { triangle_index: NULL_INDEX, simplex_cache: distance.empty_cache(), sat_cache: manifold.empty_sat_cache() }
    flags = 0
    if (body_a.flags & ENABLE_CONTACT_RECYCLING) != 0 && (body_b.flags & ENABLE_CONTACT_RECYCLING) != 0 { flags = flags | CONTACT_RECYCLE }
    if kind_a == KIND_MESH || kind_a == KIND_HEIGHT_FIELD { flags = flags | SIM_MESH_CONTACT }
    if kind_a == KIND_COMPOUND {
        child = compound.get_compound_child(shape_a.geometry.compound, child_index)
        if child.kind == KIND_MESH { flags = flags | SIM_MESH_CONTACT }
    }
    if body_a.kind == BODY_STATIC || body_b.kind == BODY_STATIC { flags = flags | CONTACT_STATIC }
    if (shape_a.flags & SHAPE_ENABLE_CONTACT_EVENTS) != 0 || (shape_b.flags & SHAPE_ENABLE_CONTACT_EVENTS) != 0 { flags = flags | CONTACT_ENABLE_CONTACT_EVENTS }
    if (shape_a.flags & SHAPE_ENABLE_SPECULATIVE) != 0 && (shape_b.flags & SHAPE_ENABLE_SPECULATIVE) != 0 { flags = flags | ENABLE_SPECULATIVE_POINTS }
    if (shape_a.flags & SHAPE_ENABLE_PRE_SOLVE_EVENTS) != 0 || (shape_b.flags & SHAPE_ENABLE_PRE_SOLVE_EVENTS) != 0 { flags = flags | SIM_ENABLE_PRE_SOLVE_EVENTS }
    c.flags = flags
    // Into body A's list.
    c.edge_a = ContactEdge { body_id: shape_a.body_id, prev_key: NULL_INDEX, next_key: body_a.head_contact_key }
    key_a = (contact_id << 1) | 0
    if body_a.head_contact_key != NULL_INDEX { set_contact_edge_prev(w, body_a.head_contact_key, key_a) }
    body_a.head_contact_key = key_a
    body_a.contact_count = body_a.contact_count + 1
    // Into body B's list.
    c.edge_b = ContactEdge { body_id: shape_b.body_id, prev_key: NULL_INDEX, next_key: body_b.head_contact_key }
    key_b = (contact_id << 1) | 1
    if body_b.head_contact_key != NULL_INDEX { set_contact_edge_prev(w, body_b.head_contact_key, key_b) }
    body_b.head_contact_key = key_b
    body_b.contact_count = body_b.contact_count + 1
    broad_phase.add_pair(&w.broad_phase, core.shape_pair_key(shape_a.id, shape_b.id, child_index))
    core.ints_push(&set.contact_indices, contact_id)
    // The rolling resistance, assumed not to change.
    radius_a = 0.0
    if kind_a == KIND_SPHERE { radius_a = shape_a.geometry.sphere.radius }
    if kind_a == KIND_CAPSULE { radius_a = shape_a.geometry.capsule.radius }
    radius_b = 0.0
    if kind_b == KIND_SPHERE { radius_b = shape_b.geometry.sphere.radius }
    if kind_b == KIND_CAPSULE { radius_b = shape_b.geometry.capsule.radius }
    c.rolling_resistance = math.max_float(shape_a.material.rolling_resistance, shape_b.material.rolling_resistance) * math.max_float(radius_a, radius_b)
}

// The edge a key names (the contact's A or B side).
contact_edge_next(w: *World, key: int) -> int {
    c = contact_at(w, key >> 1)
    if (key & 1) == 0 { return c.edge_a.next_key }
    return c.edge_b.next_key
}

set_contact_edge_prev(w: *World, key: int, prev: int) {
    c = contact_at(w, key >> 1)
    if (key & 1) == 0 { c.edge_a.prev_key = prev } else { c.edge_b.prev_key = prev }
}

set_contact_edge_next(w: *World, key: int, next: int) {
    c = contact_at(w, key >> 1)
    if (key & 1) == 0 { c.edge_a.next_key = next } else { c.edge_b.next_key = next }
}

free_manifolds(c: *Contact) {
    if c.manifold_count > 0 { core.free_bytes(c.manifolds, c.manifold_count * sizeof(Manifold)) }
    c.manifolds = null
    c.manifold_count = 0
}

allocate_manifolds(c: *Contact, count: int) {
    free_manifolds(c)
    if count > 0 {
        c.manifolds = core.alloc(count * sizeof(Manifold))
        c.manifold_count = count
    }
}

// The contact out of the pair set, both bodies' lists, its island, its
// colour or its set's indices; its bodies woken when asked and it was touching.
destroy_contact(w: *World, c: *Contact, wake_bodies: bool) {
    broad_phase.remove_pair(&w.broad_phase, core.shape_pair_key(c.shape_id_a, c.shape_id_b, c.child_index))
    free_manifolds(c)
    body_id_a = c.edge_a.body_id
    body_id_b = c.edge_b.body_id
    body_a = body_at(w, body_id_a)
    body_b = body_at(w, body_id_b)
    flags = c.flags
    touching = (flags & CONTACT_TOUCHING) != 0
    if touching && (flags & CONTACT_ENABLE_CONTACT_EVENTS) != 0 {
        push_end_event(w, c)
    }
    contact_id = c.contact_id
    // Out of body A's list.
    if c.edge_a.prev_key != NULL_INDEX { set_contact_edge_next(w, c.edge_a.prev_key, c.edge_a.next_key) }
    if c.edge_a.next_key != NULL_INDEX { set_contact_edge_prev(w, c.edge_a.next_key, c.edge_a.prev_key) }
    if body_a.head_contact_key == ((contact_id << 1) | 0) { body_a.head_contact_key = c.edge_a.next_key }
    body_a.contact_count = body_a.contact_count - 1
    // Out of body B's list.
    if c.edge_b.prev_key != NULL_INDEX { set_contact_edge_next(w, c.edge_b.prev_key, c.edge_b.next_key) }
    if c.edge_b.next_key != NULL_INDEX { set_contact_edge_prev(w, c.edge_b.next_key, c.edge_b.prev_key) }
    if body_b.head_contact_key == ((contact_id << 1) | 1) { body_b.head_contact_key = c.edge_b.next_key }
    body_b.contact_count = body_b.contact_count - 1
    if (flags & SIM_MESH_CONTACT) != 0 { mesh_contact.mesh_contact_cache_destroy(&c.mesh_cache) }
    if c.island_id != NULL_INDEX { unlink_contact(w, c) }
    if c.color_index != NULL_INDEX {
        remove_contact_from_graph(w, body_id_a, body_id_b, c.color_index, c.local_index, (flags & SIM_MESH_CONTACT) != 0)
    } else {
        set = solver_set_at(w, c.set_index)
        local_index = c.local_index
        moved = core.ints_remove_swap(&set.contact_indices, local_index)
        if moved != NULL_INDEX && moved != local_index {
            contact_at(w, core.ints_get(&set.contact_indices, local_index)).local_index = local_index
        }
    }
    c.contact_id = NULL_INDEX
    c.set_index = NULL_INDEX
    c.color_index = NULL_INDEX
    c.local_index = NULL_INDEX
    core.idpool_free(&w.contact_id_pool, contact_id)
    if wake_bodies && touching {
        wake_body(w, body_a)
        wake_body(w, body_b)
    }
}

push_end_event(w: *World, c: *Contact) {
    shape_a = world_shape_at(w, c.shape_id_a)
    shape_b = world_shape_at(w, c.shape_id_b)
    events = end_events(w)
    index = core.buffer_push(events)
    target = (events.data + index * sizeof(ContactEndTouchEvent)) as *ContactEndTouchEvent
    target.shape_id_a = make_shape_id(w, shape_a)
    target.shape_id_b = make_shape_id(w, shape_b)
    target.contact_id = make_contact_id(w, c)
}

push_begin_event(w: *World, c: *Contact) {
    shape_a = world_shape_at(w, c.shape_id_a)
    shape_b = world_shape_at(w, c.shape_id_b)
    index = core.buffer_push(&w.contact_begin_events)
    target = (w.contact_begin_events.data + index * sizeof(ContactBeginTouchEvent)) as *ContactBeginTouchEvent
    target.shape_id_a = make_shape_id(w, shape_a)
    target.shape_id_b = make_shape_id(w, shape_b)
    target.contact_id = make_contact_id(w, c)
}

// Every contact on a body destroyed (its joints with the joint layer).
destroy_body_contacts(w: *World, body: *Body, wake_bodies: bool) {
    key = body.head_contact_key
    while key != NULL_INDEX {
        c = contact_at(w, key >> 1)
        key = contact_edge_next(w, key)
        destroy_contact(w, c, wake_bodies)
    }
}

// Every contact on a shape destroyed.
destroy_shape_contacts(w: *World, s: *WorldShape, wake_bodies: bool) {
    body = body_at(w, s.body_id)
    key = body.head_contact_key
    while key != NULL_INDEX {
        c = contact_at(w, key >> 1)
        key = contact_edge_next(w, key)
        if c.shape_id_a == s.id || c.shape_id_b == s.id { destroy_contact(w, c, wake_bodies) }
    }
}

// The contacts' cached relative transforms invalidated (a centre of mass moved).
invalidate_body_contacts(w: *World, body: *Body) {
    key = body.head_contact_key
    while key != NULL_INDEX {
        c = contact_at(w, key >> 1)
        c.flags = c.flags & (0 - 1 - RELATIVE_TRANSFORM_VALID)
        key = contact_edge_next(w, key)
    }
}

var g_local_points: ptr = null   // LocalManifoldPoint[MAX_MANIFOLD_POINTS]
var g_old_points: ptr = null     // ManifoldPoint[MAX_MANIFOLD_POINTS]

contact_scratch_ready() {
    if g_local_points == null {
        g_local_points = core.alloc(MAX_MANIFOLD_POINTS * sizeof(LocalManifoldPoint))
        g_old_points = core.alloc(MAX_MANIFOLD_POINTS * sizeof(ManifoldPoint))
    }
}

// The manifold of two convex shapes (A's kind first: sphere < capsule <
// hull), computed in A's frame, its points as world-space anchors
// relative to each shape's origin, the old points' impulses kept by feature.
compute_convex_manifold(w: *World, c: *Contact, geometry_a: *Shape, xf_a: Transform, geometry_b: *Shape, xf_b: Transform) -> bool {
    contact_scratch_ready()
    kind_a = geometry_a.kind
    kind_b = geometry_b.kind
    m = manifold.local_manifold(g_local_points)
    transform_b_to_a = math.inv_mul_transforms(xf_a, xf_b)
    if kind_a == KIND_SPHERE {
        manifold.collide_spheres(&m, MAX_MANIFOLD_POINTS, geometry_a.sphere, geometry_b.sphere, transform_b_to_a)
    } else if kind_a == KIND_CAPSULE {
        if kind_b == KIND_SPHERE { manifold.collide_capsule_and_sphere(&m, MAX_MANIFOLD_POINTS, geometry_a.capsule, geometry_b.sphere, transform_b_to_a) }
        else { manifold.collide_capsules(&m, MAX_MANIFOLD_POINTS, geometry_a.capsule, geometry_b.capsule, transform_b_to_a) }
    } else {
        if kind_b == KIND_SPHERE { manifold.collide_hull_and_sphere(&m, MAX_MANIFOLD_POINTS, geometry_a.hull, geometry_b.sphere, transform_b_to_a, &c.convex_cache.simplex_cache) }
        else if kind_b == KIND_CAPSULE { manifold.collide_hull_and_capsule(&m, MAX_MANIFOLD_POINTS, geometry_a.hull, geometry_b.capsule, transform_b_to_a, &c.convex_cache.simplex_cache) }
        else {
            manifold.collide_hulls(&m, MAX_MANIFOLD_POINTS, geometry_a.hull, geometry_b.hull, transform_b_to_a, &c.convex_cache.sat_cache)
            w.sat_call_count = w.sat_call_count + 1
            w.sat_cache_hit_count = w.sat_cache_hit_count + c.convex_cache.sat_cache.hit
        }
    }
    if m.point_count == 0 {
        free_manifolds(c)
        return false
    }
    old = g_old_points as ManifoldPoint[]
    old_count = 0
    if c.manifold_count == 0 {
        allocate_manifolds(c, 1)
    } else {
        first = manifold_at(c, 0)
        old_count = first.point_count
        i = 0
        while i < old_count {
            old[i] = point_copy(manifold_point_at(first, i))
            i = i + 1
        }
    }
    target = manifold_at(c, 0)
    target.point_count = m.point_count
    matrix_a = math.make_matrix_from_quat(xf_a.q)
    target.normal = math.mul_mv(matrix_a, m.normal)
    offset = math.sub(xf_a.p, xf_b.p)
    i = 0
    while i < m.point_count {
        source = manifold.manifold_point(&m, i)
        p = manifold_point_at(target, i)
        p.anchor_a = math.mul_mv(matrix_a, source.point)
        p.anchor_b = math.add(p.anchor_a, offset)
        p.separation = source.separation
        p.feature_id = manifold.make_feature_id(source.pair)
        p.triangle_index = NULL_INDEX
        p.normal_velocity = 0.0
        p.total_normal_impulse = 0.0
        p.persisted = false
        p.normal_impulse = 0.0
        j = 0
        while j < old_count {
            if old[j].feature_id == p.feature_id && p.persisted == false {
                p.normal_impulse = old[j].normal_impulse
                p.persisted = true
                old[j].feature_id = 0 - 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return true
}

point_copy(p: *ManifoldPoint) -> ManifoldPoint {
    return ManifoldPoint { anchor_a: p.anchor_a, anchor_b: p.anchor_b, separation: p.separation, base_separation: p.base_separation,
                           normal_impulse: p.normal_impulse, total_normal_impulse: p.total_normal_impulse, normal_velocity: p.normal_velocity,
                           feature_id: p.feature_id, triangle_index: p.triangle_index, persisted: p.persisted }
}

// The friction and restitution through the world's callbacks.
mix_materials(w: *World, c: *Contact, material_a: SurfaceMaterial, material_b: SurfaceMaterial) {
    friction_fn = w.friction_callback
    restitution_fn = w.restitution_callback
    c.friction = friction_fn(material_a.friction, material_a.user_material_id, material_b.friction, material_b.user_material_id)
    c.restitution = restitution_fn(material_a.restitution, material_a.user_material_id, material_b.restitution, material_b.user_material_id)
}

// The convex manifold, flipped when the pair was flipped, with the
// materials mixed, the rolling resistance and the tangent velocity.
update_convex_contact(w: *World, c: *Contact, geometry_a: *Shape, material_a: SurfaceMaterial, flags_a: int, xf_a: Transform,
                      geometry_b: *Shape, material_b: SurfaceMaterial, flags_b: int, xf_b: Transform, flip: bool) -> bool {
    touching = compute_convex_manifold(w, c, geometry_a, xf_a, geometry_b, xf_b)
    if touching == false { return false }
    if flip {
        // The feature ids need only match, and flipping is consistent.
        m = manifold_at(c, 0)
        m.normal = math.neg(m.normal)
        i = 0
        while i < m.point_count {
            p = manifold_point_at(m, i)
            swap = p.anchor_a
            p.anchor_a = p.anchor_b
            p.anchor_b = swap
            i = i + 1
        }
    }
    mix_materials(w, c, material_a, material_b)
    if material_a.rolling_resistance > 0.0 || material_b.rolling_resistance > 0.0 {
        radius_a = 0.0
        if geometry_a.kind == KIND_SPHERE { radius_a = geometry_a.sphere.radius }
        else if geometry_a.kind == KIND_CAPSULE { radius_a = geometry_a.capsule.radius }
        else if geometry_a.kind == KIND_HULL { radius_a = 0.25 * geometry_a.hull.inner_radius }
        radius_b = 0.0
        if geometry_b.kind == KIND_SPHERE { radius_b = geometry_b.sphere.radius }
        else if geometry_b.kind == KIND_CAPSULE { radius_b = geometry_b.capsule.radius }
        else if geometry_b.kind == KIND_HULL { radius_b = 0.25 * geometry_b.hull.inner_radius }
        c.rolling_resistance = math.max_float(material_a.rolling_resistance, material_b.rolling_resistance) * math.max_float(radius_a, radius_b)
    } else {
        c.rolling_resistance = 0.0
    }
    c.tangent_velocity = math.sub(math.rotate_vector(xf_a.q, material_a.tangent_velocity), math.rotate_vector(xf_b.q, material_b.tangent_velocity))
    if (flags_a & SHAPE_ENABLE_HIT_EVENTS) != 0 || (flags_b & SHAPE_ENABLE_HIT_EVENTS) != 0 {
        c.flags = c.flags | SIM_ENABLE_HIT_EVENT
    } else {
        c.flags = c.flags & (0 - 1 - SIM_ENABLE_HIT_EVENT)
    }
    return true
}

// A mesh or height field shape (or a compound's mesh child) against the
// convex shape B: the clusters from the mesh contact become manifolds
// matched to the old ones by normal (their friction, rolling and twist
// impulses kept) and by feature and triangle per point (the normal
// impulse kept); the materials per triangle averaged.
update_mesh_contact(w: *World, c: *Contact, mesh_geometry: *Shape, mesh_shape: *WorldShape, material_map: ptr, xf_a: Transform,
                    shape_b: *WorldShape, xf_b: Transform, is_fast: bool) -> bool {
    contact_scratch_ready()
    bounds_b = shape_b.aabb
    enable_speculative = (c.flags & ENABLE_SPECULATIVE_POINTS) != 0
    mark = w.arena.index
    r = mesh_contact.compute_mesh_manifolds(&c.mesh_cache, mesh_geometry, xf_a, &shape_b.geometry, xf_b, bounds_b, is_fast, enable_speculative, &w.arena)
    w.sat_call_count = w.sat_call_count + r.sat_calls
    w.sat_cache_hit_count = w.sat_cache_hit_count + r.sat_cache_hits
    cluster_count = r.cluster_count
    if cluster_count == 0 {
        free_manifolds(c)
        w.arena.index = mark
        return false
    }
    // The old manifolds, kept aside for the matching.
    old_count = c.manifold_count
    old_block = null
    if old_count > 0 {
        old_block = core.arena_bump(&w.arena, old_count * sizeof(Manifold))
        memcpy(old_block, c.manifolds, old_count * sizeof(Manifold))
    }
    if old_count != cluster_count {
        allocate_manifolds(c, cluster_count)
    } else {
        memset(c.manifolds, 0, cluster_count * sizeof(Manifold))
    }
    consumed_block = null
    consumed = null as int[]
    if old_count > 0 {
        consumed_block = core.arena_bump(&w.arena, old_count * 4)
        memset(consumed_block, 0, old_count * 4)
        consumed = consumed_block as int[]
    }
    matrix_b = math.make_matrix_from_quat(xf_b.q)
    offset_a = math.sub(xf_b.p, xf_a.p)
    normal_match_tolerance = 0.995
    clusters = r.clusters as Cluster[]
    i = 0
    while i < cluster_count {
        cluster = clusters[i]
        m = manifold_at(c, i)
        m.point_count = cluster.point_count
        m.normal = math.mul_mv(matrix_b, cluster.manifold_normal)
        best_dot = normal_match_tolerance
        best_index = NULL_INDEX
        j = 0
        while j < old_count {
            if consumed[j] == 0 {
                old_m = (old_block + j * sizeof(Manifold)) as *Manifold
                d = math.dot(old_m.normal, m.normal)
                if d > best_dot {
                    best_index = j
                    best_dot = d
                }
            }
            j = j + 1
        }
        matched = null as *Manifold
        if best_index != NULL_INDEX {
            matched = (old_block + best_index * sizeof(Manifold)) as *Manifold
            m.friction_impulse = matched.friction_impulse
            m.rolling_impulse = matched.rolling_impulse
            m.twist_impulse = matched.twist_impulse
            consumed[best_index] = 1
        }
        points = cluster.points as LocalManifoldPoint[]
        j = 0
        while j < cluster.point_count {
            source = points[j]
            p = manifold_point_at(m, j)
            // The points were computed in B's frame.
            p.anchor_b = math.mul_mv(matrix_b, source.point)
            p.anchor_a = math.add(p.anchor_b, offset_a)
            p.separation = source.separation - mesh_contact.MESH_REST_OFFSET
            p.feature_id = manifold.make_feature_id(source.pair)
            p.triangle_index = source.triangle_index
            p.normal_impulse = 0.0
            p.total_normal_impulse = 0.0
            p.normal_velocity = 0.0
            p.persisted = false
            if matched != null {
                k = 0
                while k < matched.point_count {
                    old_p = manifold_point_at(matched, k)
                    if p.persisted == false && p.feature_id == old_p.feature_id && p.triangle_index == old_p.triangle_index {
                        p.normal_impulse = old_p.normal_impulse
                        p.persisted = true
                        old_p.triangle_index = NULL_INDEX
                    }
                    k = k + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    // The materials: per triangle when the mesh carries several.
    material_b = shape_b.material
    tangent_velocity_a = math.vec3_zero()
    friction_fn = w.friction_callback
    restitution_fn = w.restitution_callback
    if mesh_shape.material_count > 1 {
        friction = 0.0
        restitution = 0.0
        sample_count = 0.0
        materials_a = mesh_shape.materials as SurfaceMaterial[]
        i = 0
        while i < cluster_count {
            m = manifold_at(c, i)
            j = 0
            while j < m.point_count {
                triangle_index = manifold_point_at(m, j).triangle_index
                material_index = 0
                if mesh_geometry.kind == KIND_MESH {
                    indices = mesh.mesh_material_indices(mesh_geometry.mesh.data)
                    material_index = indices[triangle_index]
                    if material_map != null {
                        map = material_map as int[]
                        material_index = map[math.min_int(material_index, 3)]
                    }
                } else {
                    indices = height_field.height_field_material_indices(mesh_geometry.height_field)
                    material_index = indices[triangle_index >> 1]
                }
                material_index = math.clamp_int(material_index, 0, mesh_shape.material_count - 1)
                material_a = materials_a[material_index]
                friction = friction + friction_fn(material_a.friction, material_a.user_material_id, material_b.friction, material_b.user_material_id)
                restitution = restitution + restitution_fn(material_a.restitution, material_a.user_material_id, material_b.restitution, material_b.user_material_id)
                tangent_velocity_a = math.add(tangent_velocity_a, material_a.tangent_velocity)
                sample_count = sample_count + 1.0
                j = j + 1
            }
            i = i + 1
        }
        if sample_count > 0.0 {
            inv = 1.0 / sample_count
            c.friction = inv * friction
            c.restitution = inv * restitution
            tangent_velocity_a = math.mul_sv(inv, tangent_velocity_a)
        }
    } else {
        mix_materials(w, c, mesh_shape.material, material_b)
        tangent_velocity_a = mesh_shape.material.tangent_velocity
    }
    tangent_velocity_a = math.rotate_vector(xf_a.q, tangent_velocity_a)
    radius_b = 0.0
    if shape_b.geometry.kind == KIND_SPHERE { radius_b = shape_b.geometry.sphere.radius }
    else if shape_b.geometry.kind == KIND_CAPSULE { radius_b = shape_b.geometry.capsule.radius }
    else if shape_b.geometry.kind == KIND_HULL { radius_b = shape_b.geometry.hull.inner_radius }
    c.rolling_resistance = material_b.rolling_resistance * radius_b
    c.tangent_velocity = math.sub(tangent_velocity_a, math.rotate_vector(xf_b.q, material_b.tangent_velocity))
    w.arena.index = mark
    return true
}

var g_child_geometry: ptr = null   // Shape: a compound's child as a shape
var g_material_map: ptr = null     // int[4]

// The contact's manifolds and whether it touches, for any pair: a
// compound's child stands in for the compound (its transform composed),
// a mesh or height field goes through the mesh contact, the rest
// through the convex manifolds; the anchors end relative to the centres
// of mass.
update_contact(w: *World, c: *Contact, shape_a: *WorldShape, local_center_a: Vec3, xf_a: Transform, shape_b: *WorldShape,
               local_center_b: Vec3, xf_b: Transform, is_fast: bool) -> bool {
    if g_child_geometry == null {
        g_child_geometry = core.alloc(sizeof(Shape))
        g_material_map = core.alloc(4 * 4)
    }
    touching = false
    kind_a = shape_a.geometry.kind
    if kind_a == KIND_COMPOUND {
        child = compound.get_compound_child(shape_a.geometry.compound, c.child_index)
        child_geometry = g_child_geometry as *Shape
        materials_a = shape_a.materials as SurfaceMaterial[]
        child_material = materials_a[math.clamp_int(child.material_index0, 0, shape_a.material_count - 1)]
        if child.kind == KIND_CAPSULE {
            cg = shape.capsule_shape(child.capsule, 0.0)
            copy_geometry(child_geometry, cg)
            if shape_b.geometry.kind == KIND_HULL {
                touching = update_convex_contact(w, c, &shape_b.geometry, shape_b.material, shape_b.flags, xf_b, child_geometry, child_material, shape_a.flags, xf_a, true)
            } else {
                touching = update_convex_contact(w, c, child_geometry, child_material, shape_a.flags, xf_a, &shape_b.geometry, shape_b.material, shape_b.flags, xf_b, false)
            }
        } else if child.kind == KIND_HULL {
            cg = shape.hull_shape(child.hull, 0.0)
            copy_geometry(child_geometry, cg)
            xf_child = math.mul_transforms(xf_a, child.transform)
            touching = update_convex_contact(w, c, child_geometry, child_material, shape_a.flags, xf_child, &shape_b.geometry, shape_b.material, shape_b.flags, xf_b, false)
        } else if child.kind == KIND_MESH {
            cg = shape.mesh_shape(child.mesh, shape_a.material_count)
            copy_geometry(child_geometry, cg)
            xf_child = math.mul_transforms(xf_a, child.transform)
            map = g_material_map as int[]
            map[0] = child.material_index0
            map[1] = child.material_index1
            map[2] = child.material_index2
            map[3] = child.material_index3
            touching = update_mesh_contact(w, c, child_geometry, shape_a, g_material_map, xf_child, shape_b, xf_b, is_fast)
            set_hit_event_flag(c, touching, shape_a.flags, shape_b.flags)
        } else {
            cg = shape.sphere_shape(child.sphere, 0.0)
            copy_geometry(child_geometry, cg)
            if shape_b.geometry.kind == KIND_CAPSULE || shape_b.geometry.kind == KIND_HULL {
                touching = update_convex_contact(w, c, &shape_b.geometry, shape_b.material, shape_b.flags, xf_b, child_geometry, child_material, shape_a.flags, xf_a, true)
            } else {
                touching = update_convex_contact(w, c, child_geometry, child_material, shape_a.flags, xf_a, &shape_b.geometry, shape_b.material, shape_b.flags, xf_b, false)
            }
        }
        // The anchors are relative to the child's origin: offset to the compound's.
        offset = math.rotate_vector(xf_a.q, child.transform.p)
        i = 0
        while i < c.manifold_count {
            m = manifold_at(c, i)
            j = 0
            while j < m.point_count {
                p = manifold_point_at(m, j)
                p.anchor_a = math.add(p.anchor_a, offset)
                j = j + 1
            }
            i = i + 1
        }
    } else if kind_a == KIND_MESH || kind_a == KIND_HEIGHT_FIELD {
        touching = update_mesh_contact(w, c, &shape_a.geometry, shape_a, null, xf_a, shape_b, xf_b, is_fast)
        set_hit_event_flag(c, touching, shape_a.flags, shape_b.flags)
    } else {
        touching = update_convex_contact(w, c, &shape_a.geometry, shape_a.material, shape_a.flags, xf_a, &shape_b.geometry, shape_b.material, shape_b.flags, xf_b, false)
    }
    if touching {
        center_a = math.rotate_vector(xf_a.q, local_center_a)
        center_b = math.rotate_vector(xf_b.q, local_center_b)
        i = 0
        while i < c.manifold_count {
            m = manifold_at(c, i)
            j = 0
            while j < m.point_count {
                p = manifold_point_at(m, j)
                p.anchor_a = math.sub(p.anchor_a, center_a)
                p.anchor_b = math.sub(p.anchor_b, center_b)
                j = j + 1
            }
            i = i + 1
        }
        c.flags = c.flags | SIM_TOUCHING
    } else {
        c.flags = c.flags & (0 - 1 - SIM_TOUCHING)
    }
    return touching
}

copy_geometry(dst: *Shape, src: Shape) {
    dst.kind = src.kind
    dst.density = src.density
    dst.material_count = src.material_count
    dst.sphere = src.sphere
    dst.capsule = src.capsule
    dst.hull = src.hull
    dst.mesh = src.mesh
    dst.height_field = src.height_field
    dst.compound = src.compound
}

set_hit_event_flag(c: *Contact, touching: bool, flags_a: int, flags_b: int) {
    if touching && ((flags_a & SHAPE_ENABLE_HIT_EVENTS) != 0 || (flags_b & SHAPE_ENABLE_HIT_EVENTS) != 0) {
        c.flags = c.flags | SIM_ENABLE_HIT_EVENT
    } else {
        c.flags = c.flags & (0 - 1 - SIM_ENABLE_HIT_EVENT)
    }
}

// --- islands: linking, merging, splitting ------------------------------------------------------------------

// The smaller island's bodies, contacts and joints move into the larger; the survivor's id.
merge_islands(w: *World, island_id_a: int, island_id_b: int) -> int {
    if island_id_a == island_id_b { return island_id_a }
    if island_id_a == NULL_INDEX { return island_id_b }
    if island_id_b == NULL_INDEX { return island_id_a }
    island_a = island_at(w, island_id_a)
    island_b = island_at(w, island_id_b)
    big = island_a
    small = island_b
    if island_a.bodies.count < island_b.bodies.count {
        big = island_b
        small = island_a
    }
    big_id = big.island_id
    i = 0
    while i < small.bodies.count {
        body_id = core.ints_get(&small.bodies, i)
        body = body_at(w, body_id)
        body.island_id = big_id
        body.island_index = big.bodies.count
        core.ints_push(&big.bodies, body_id)
        i = i + 1
    }
    i = 0
    while i < small.contacts.count {
        link = contact_link_at(small, i)
        c = contact_at(w, link.contact_id)
        c.island_id = big_id
        c.island_index = big.contacts.count
        index = core.buffer_push(&big.contacts)
        target = contact_link_at(big, index)
        target.contact_id = link.contact_id
        target.body_id_a = link.body_id_a
        target.body_id_b = link.body_id_b
        i = i + 1
    }
    i = 0
    while i < small.joints.count {
        jlink = joint_link_at(small, i)
        j = joint_at(w, jlink.joint_id)
        j.island_id = big_id
        j.island_index = big.joints.count
        index = core.buffer_push(&big.joints)
        jtarget = joint_link_at(big, index)
        jtarget.joint_id = jlink.joint_id
        jtarget.body_id_a = jlink.body_id_a
        jtarget.body_id_b = jlink.body_id_b
        i = i + 1
    }
    big.constraint_remove_count = big.constraint_remove_count + small.constraint_remove_count
    destroy_island(w, small.island_id)
    return big_id
}

add_contact_to_island(w: *World, island_id: int, c: *Contact) {
    island = island_at(w, island_id)
    c.island_id = island_id
    c.island_index = island.contacts.count
    index = core.buffer_push(&island.contacts)
    link = contact_link_at(island, index)
    link.contact_id = c.contact_id
    link.body_id_a = c.edge_a.body_id
    link.body_id_b = c.edge_b.body_id
}

// A touching contact joins its bodies' islands (waking a sleeping one
// when the other is awake) and merges them.
link_contact(w: *World, c: *Contact) {
    body_a = body_at(w, c.edge_a.body_id)
    body_b = body_at(w, c.edge_b.body_id)
    if body_a.set_index == AWAKE_SET && body_b.set_index >= FIRST_SLEEPING_SET { wake_solver_set(w, body_b.set_index) }
    if body_b.set_index == AWAKE_SET && body_a.set_index >= FIRST_SLEEPING_SET { wake_solver_set(w, body_a.set_index) }
    final_island = merge_islands(w, body_a.island_id, body_b.island_id)
    add_contact_to_island(w, final_island, c)
}

// A contact leaves its island, which notes a removed constraint (a split candidate).
unlink_contact(w: *World, c: *Contact) {
    island_id = c.island_id
    island = island_at(w, island_id)
    remove_index = c.island_index
    moved = core.buffer_remove_swap(&island.contacts, remove_index)
    if moved != NULL_INDEX && moved != remove_index {
        contact_at(w, contact_link_at(island, remove_index).contact_id).island_index = remove_index
    }
    c.island_id = NULL_INDEX
    c.island_index = NULL_INDEX
    island.constraint_remove_count = island.constraint_remove_count + 1
}

add_joint_to_island(w: *World, island_id: int, j: *Joint) {
    island = island_at(w, island_id)
    j.island_id = island_id
    j.island_index = island.joints.count
    index = core.buffer_push(&island.joints)
    link = joint_link_at(island, index)
    link.joint_id = j.joint_id
    link.body_id_a = j.edge_a.body_id
    link.body_id_b = j.edge_b.body_id
}

link_joint(w: *World, j: *Joint) {
    body_a = body_at(w, j.edge_a.body_id)
    body_b = body_at(w, j.edge_b.body_id)
    if body_a.set_index == AWAKE_SET && body_b.set_index >= FIRST_SLEEPING_SET { wake_solver_set(w, body_b.set_index) }
    else if body_b.set_index == AWAKE_SET && body_a.set_index >= FIRST_SLEEPING_SET { wake_solver_set(w, body_a.set_index) }
    final_island = merge_islands(w, body_a.island_id, body_b.island_id)
    add_joint_to_island(w, final_island, j)
}

unlink_joint(w: *World, j: *Joint) {
    if j.island_id == NULL_INDEX { return }
    island_id = j.island_id
    island = island_at(w, island_id)
    remove_index = j.island_index
    moved = core.buffer_remove_swap(&island.joints, remove_index)
    if moved != NULL_INDEX && moved != remove_index {
        joint_at(w, joint_link_at(island, remove_index).joint_id).island_index = remove_index
    }
    j.island_id = NULL_INDEX
    j.island_index = NULL_INDEX
    island.constraint_remove_count = island.constraint_remove_count + 1
}

// Union-find with path halving.
find_parent(parents: int[], node: int) -> int {
    n = node
    while parents[n] != n {
        grand = parents[parents[n]]
        parents[n] = grand
        n = grand
    }
    return n
}

island_union(parents: int[], ranks: int[], node1: int, node2: int) {
    root1 = find_parent(parents, node1)
    root2 = find_parent(parents, node2)
    if root1 == root2 { return }
    if ranks[root1] < ranks[root2] {
        parents[root1] = root2
    } else if ranks[root1] > ranks[root2] {
        parents[root2] = root1
    } else {
        parents[root2] = root1
        ranks[root1] = ranks[root1] + 1
    }
}

// An awake island whose constraints were removed, split into its
// connected components by union-find over its contacts and joints
// (constraints to static bodies connect nothing); returns how many
// islands it became (one when still connected).
split_island(w: *World, base_id: int) -> int {
    base = island_at(w, base_id)
    body_count = base.bodies.count
    if body_count == 0 { return 1 }
    parents_block = core.stack_alloc(&w.stack, body_count * 4)
    ranks_block = core.stack_alloc(&w.stack, body_count * 4)
    parents = parents_block as int[]
    ranks = ranks_block as int[]
    i = 0
    while i < body_count {
        parents[i] = i
        ranks[i] = 0
        i = i + 1
    }
    i = 0
    while i < base.contacts.count {
        link = contact_link_at(base, i)
        index_a = body_at(w, link.body_id_a).island_index
        index_b = body_at(w, link.body_id_b).island_index
        if index_a != NULL_INDEX && index_b != NULL_INDEX { island_union(parents, ranks, index_a, index_b) }
        i = i + 1
    }
    i = 0
    while i < base.joints.count {
        jlink = joint_link_at(base, i)
        index_a = body_at(w, jlink.body_id_a).island_index
        index_b = body_at(w, jlink.body_id_b).island_index
        if index_a != NULL_INDEX && index_b != NULL_INDEX { island_union(parents, ranks, index_a, index_b) }
        i = i + 1
    }
    core.stack_free(&w.stack, ranks_block)
    component_count = 0
    i = 0
    while i < body_count {
        parents[i] = find_parent(parents, i)
        if parents[i] == i { component_count = component_count + 1 }
        i = i + 1
    }
    if component_count == 1 {
        base.constraint_remove_count = 0
        core.stack_free(&w.stack, parents_block)
        return 1
    }
    // The base island's arrays are detached and freed at the end; the
    // island slot is destroyed after the new ones are filled.
    base_bodies = base.bodies
    base_contacts = base.contacts
    base_joints = base.joints
    base.bodies = core.ints_create(0)
    base.contacts = core.buffer_create(sizeof(ContactLink), 0)
    base.joints = core.buffer_create(sizeof(JointLink), 0)
    root_map_block = core.stack_alloc(&w.stack, body_count * 4)
    root_map = root_map_block as int[]
    i = 0
    while i < body_count {
        root_map[i] = NULL_INDEX
        i = i + 1
    }
    island_ids_block = core.stack_alloc(&w.stack, component_count * 4)
    island_ids = island_ids_block as int[]
    island_count = 0
    i = 0
    while i < body_count {
        root = parents[i]
        if root_map[root] == NULL_INDEX {
            root_map[root] = island_count
            fresh = create_island(w, AWAKE_SET)
            island_ids[island_count] = fresh.island_id
            island_count = island_count + 1
        }
        i = i + 1
    }
    base_body_ids = base_bodies.data as int[]
    i = 0
    while i < body_count {
        body_id = base_body_ids[i]
        new_island_id = island_ids[root_map[parents[i]]]
        body = body_at(w, body_id)
        fresh = island_at(w, new_island_id)
        body.island_id = new_island_id
        body.island_index = fresh.bodies.count
        core.ints_push(&fresh.bodies, body_id)
        i = i + 1
    }
    i = 0
    while i < base_contacts.count {
        link = (base_contacts.data + i * sizeof(ContactLink)) as *ContactLink
        c = contact_at(w, link.contact_id)
        target_id = body_at(w, link.body_id_a).island_id
        if target_id == NULL_INDEX { target_id = body_at(w, link.body_id_b).island_id }
        target = island_at(w, target_id)
        c.island_id = target_id
        c.island_index = target.contacts.count
        index = core.buffer_push(&target.contacts)
        moved = contact_link_at(target, index)
        moved.contact_id = link.contact_id
        moved.body_id_a = link.body_id_a
        moved.body_id_b = link.body_id_b
        i = i + 1
    }
    i = 0
    while i < base_joints.count {
        jlink = (base_joints.data + i * sizeof(JointLink)) as *JointLink
        j = joint_at(w, jlink.joint_id)
        target_id = body_at(w, jlink.body_id_a).island_id
        if target_id == NULL_INDEX { target_id = body_at(w, jlink.body_id_b).island_id }
        target = island_at(w, target_id)
        j.island_id = target_id
        j.island_index = target.joints.count
        index = core.buffer_push(&target.joints)
        jmoved = joint_link_at(target, index)
        jmoved.joint_id = jlink.joint_id
        jmoved.body_id_a = jlink.body_id_a
        jmoved.body_id_b = jlink.body_id_b
        i = i + 1
    }
    destroy_island(w, base_id)
    core.ints_destroy(&base_bodies)
    core.buffer_destroy(&base_contacts)
    core.buffer_destroy(&base_joints)
    core.stack_free(&w.stack, island_ids_block)
    core.stack_free(&w.stack, root_map_block)
    core.stack_free(&w.stack, parents_block)
    return island_count
}

// --- sleeping and waking -------------------------------------------------------------------------------------

// A sleeping set's bodies and islands move into the awake set, its
// non-touching contacts from the disabled set into the awake set's, its
// touching contacts into the constraint graph, its joints too; then the
// set is destroyed.
wake_solver_set(w: *World, set_index: int) {
    set = solver_set_at(w, set_index)
    awake = solver_set_at(w, AWAKE_SET)
    disabled = solver_set_at(w, DISABLED_SET)
    i = 0
    while i < set.body_sims.count {
        sim = body_sim_at(set, i)
        body = body_at(w, sim.body_id)
        target = core.buffer_push(&awake.body_sims)
        memcpy(awake.body_sims.data + target * sizeof(BodySim), sim as ptr, sizeof(BodySim))
        state_index = core.buffer_push(&awake.body_states)
        state = body_state_at(awake, state_index)
        state.linear_velocity = math.vec3_zero()
        state.angular_velocity = math.vec3_zero()
        state.delta_position = math.vec3_zero()
        state.delta_rotation = math.quat_identity()
        state.flags = body.flags
        body.set_index = AWAKE_SET
        body.local_index = target
        body.sleep_time = 0.0
        // The body's non-touching contacts, from the disabled set to the awake one.
        key = body.head_contact_key
        while key != NULL_INDEX {
            c = contact_at(w, key >> 1)
            key = contact_edge_next(w, key)
            if c.set_index == DISABLED_SET {
                local_index = c.local_index
                c.set_index = AWAKE_SET
                c.local_index = awake.contact_indices.count
                core.ints_push(&awake.contact_indices, c.contact_id)
                moved = core.ints_remove_swap(&disabled.contact_indices, local_index)
                if moved != NULL_INDEX && moved != local_index {
                    contact_at(w, core.ints_get(&disabled.contact_indices, local_index)).local_index = local_index
                }
            }
        }
        i = i + 1
    }
    i = 0
    while i < set.contact_indices.count {
        c = contact_at(w, core.ints_get(&set.contact_indices, i))
        add_contact_to_graph(w, c)
        c.set_index = AWAKE_SET
        i = i + 1
    }
    i = 0
    while i < set.joint_sims.count {
        jsim = joint_sim_at(&set.joint_sims, i)
        j = joint_at(w, jsim.joint_id)
        add_joint_to_graph(w, jsim, j)
        j.set_index = AWAKE_SET
        i = i + 1
    }
    i = 0
    while i < set.island_sims.count {
        island_id = island_sim_at(set, i).island_id
        island = island_at(w, island_id)
        island.set_index = AWAKE_SET
        island.local_index = awake.island_sims.count
        target = core.buffer_push(&awake.island_sims)
        island_sim_at(awake, target).island_id = island_id
        i = i + 1
    }
    destroy_solver_set(w, set_index)
}

// A joint sim into a colour of the graph (the joint layer fills the sims).
add_joint_to_graph(w: *World, sim: *JointSim, j: *Joint) {
    body_a = body_at(w, j.edge_a.body_id)
    body_b = body_at(w, j.edge_b.body_id)
    color_index = assign_color(&w.constraint_graph, body_a.id, body_b.id, body_a.kind, body_b.kind)
    color = graph_color(w, color_index)
    index = core.buffer_push(&color.joint_sims)
    memcpy(color.joint_sims.data + index * sizeof(JointSim), sim as ptr, sizeof(JointSim))
    j.color_index = color_index
    j.local_index = index
}

remove_joint_from_graph(w: *World, body_id_a: int, body_id_b: int, color_index: int, local_index: int) {
    color = graph_color(w, color_index)
    if color_index != OVERFLOW_INDEX {
        core.bitset_clear(&color.body_set, body_id_a)
        core.bitset_clear(&color.body_set, body_id_b)
    }
    moved = core.buffer_remove_swap(&color.joint_sims, local_index)
    if moved != NULL_INDEX && moved != local_index {
        joint_at(w, joint_sim_at(&color.joint_sims, local_index).joint_id).local_index = local_index
    }
}

// An awake island put to sleep in a set of its own: its bodies' sims
// move there (their states dropped), their non-touching contacts with
// other sleeping bodies to the disabled set, the island's touching
// contacts and joints out of the graph and into the set. Refused while
// the island has a pending split.
try_sleep_island(w: *World, island_id: int) -> bool {
    island = island_at(w, island_id)
    if island.set_index != AWAKE_SET { return false }
    if island.constraint_remove_count > 0 && island.bodies.count > 1 { return false }
    sleep_set_id = create_solver_set(w)
    sleep_set = solver_set_at(w, sleep_set_id)
    awake = solver_set_at(w, AWAKE_SET)
    disabled = solver_set_at(w, DISABLED_SET)
    core.buffer_reserve(&sleep_set.body_sims, island.bodies.count)
    i = 0
    while i < island.bodies.count {
        body_id = core.ints_get(&island.bodies, i)
        body = body_at(w, body_id)
        awake_index = body.local_index
        sleep_index = core.buffer_push(&sleep_set.body_sims)
        memcpy(sleep_set.body_sims.data + sleep_index * sizeof(BodySim), body_sim_at(awake, awake_index) as ptr, sizeof(BodySim))
        moved = core.buffer_remove_swap(&awake.body_sims, awake_index)
        if moved != NULL_INDEX && moved != awake_index {
            body_at(w, body_sim_at(awake, awake_index).body_id).local_index = awake_index
        }
        core.buffer_remove_swap(&awake.body_states, awake_index)
        body.set_index = sleep_set_id
        body.local_index = sleep_index
        body.body_move_index = NULL_INDEX
        // Its non-touching contacts whose other body is not awake go to the disabled set.
        key = body.head_contact_key
        while key != NULL_INDEX {
            c = contact_at(w, key >> 1)
            edge_index = key & 1
            key = contact_edge_next(w, key)
            if c.set_index == DISABLED_SET { continue }
            if c.color_index != NULL_INDEX { continue }
            other_id = c.edge_b.body_id
            if edge_index == 1 { other_id = c.edge_a.body_id }
            if body_at(w, other_id).set_index == AWAKE_SET { continue }
            local_index = c.local_index
            c.set_index = DISABLED_SET
            c.local_index = disabled.contact_indices.count
            core.ints_push(&disabled.contact_indices, c.contact_id)
            moved_contact = core.ints_remove_swap(&awake.contact_indices, local_index)
            if moved_contact != NULL_INDEX && moved_contact != local_index {
                contact_at(w, core.ints_get(&awake.contact_indices, local_index)).local_index = local_index
            }
        }
        i = i + 1
    }
    i = 0
    while i < island.contacts.count {
        c = contact_at(w, contact_link_at(island, i).contact_id)
        color_index = c.color_index
        color = graph_color(w, color_index)
        if color_index != OVERFLOW_INDEX {
            core.bitset_clear(&color.body_set, c.edge_a.body_id)
            core.bitset_clear(&color.body_set, c.edge_b.body_id)
        }
        sleep_contact_index = sleep_set.contact_indices.count
        core.ints_push(&sleep_set.contact_indices, c.contact_id)
        local_index = c.local_index
        if (c.flags & SIM_MESH_CONTACT) != 0 || color_index == OVERFLOW_INDEX {
            moved = core.buffer_remove_swap(&color.contacts, local_index)
            if moved != NULL_INDEX && moved != local_index {
                contact_at(w, contact_spec_at(color, local_index).contact_id).local_index = local_index
            }
        } else {
            moved = core.ints_remove_swap(&color.convex_contacts, local_index)
            if moved != NULL_INDEX && moved != local_index {
                contact_at(w, core.ints_get(&color.convex_contacts, local_index)).local_index = local_index
            }
        }
        c.set_index = sleep_set_id
        c.color_index = NULL_INDEX
        c.local_index = sleep_contact_index
        i = i + 1
    }
    i = 0
    while i < island.joints.count {
        j = joint_at(w, joint_link_at(island, i).joint_id)
        color_index = j.color_index
        local_index = j.local_index
        color = graph_color(w, color_index)
        if color_index != OVERFLOW_INDEX {
            core.bitset_clear(&color.body_set, j.edge_a.body_id)
            core.bitset_clear(&color.body_set, j.edge_b.body_id)
        }
        sleep_joint_index = core.buffer_push(&sleep_set.joint_sims)
        memcpy(sleep_set.joint_sims.data + sleep_joint_index * sizeof(JointSim), joint_sim_at(&color.joint_sims, local_index) as ptr, sizeof(JointSim))
        moved = core.buffer_remove_swap(&color.joint_sims, local_index)
        if moved != NULL_INDEX && moved != local_index {
            joint_at(w, joint_sim_at(&color.joint_sims, local_index).joint_id).local_index = local_index
        }
        j.set_index = sleep_set_id
        j.color_index = NULL_INDEX
        j.local_index = sleep_joint_index
        i = i + 1
    }
    island_index = island.local_index
    sleep_island = core.buffer_push(&sleep_set.island_sims)
    island_sim_at(sleep_set, sleep_island).island_id = island_id
    moved_island = core.buffer_remove_swap(&awake.island_sims, island_index)
    if moved_island != NULL_INDEX && moved_island != island_index {
        island_at(w, island_sim_at(awake, island_index).island_id).local_index = island_index
    }
    island.set_index = sleep_set_id
    island.local_index = 0
    if w.split_island_id == island_id { w.split_island_id = NULL_INDEX }
    return true
}

// --- the pair filter and the collide pass ----------------------------------------------------------------------

// Whether two shapes may collide: not on one body, no sensors, the
// filters (a joint's collide-connected flag comes with the joint layer).
should_pair(shape_id_a: int, shape_id_b: int, context: ptr) -> bool {
    w = context as *World
    shape_a = world_shape_at(w, shape_id_a)
    shape_b = world_shape_at(w, shape_id_b)
    if shape_a.body_id == shape_b.body_id { return false }
    if shape_a.sensor_index != NULL_INDEX || shape_b.sensor_index != NULL_INDEX { return false }
    if shape.should_shapes_collide(shape_a.filter, shape_b.filter) == false { return false }
    return true
}

compound_tree_of(shape_id: int, context: ptr) -> ptr {
    w = context as *World
    s = world_shape_at(w, shape_id)
    if s.geometry.kind != KIND_COMPOUND { return null }
    return (&s.geometry.compound.tree) as ptr
}

compound_transform_of(shape_id: int, context: ptr) -> Transform {
    w = context as *World
    s = world_shape_at(w, shape_id)
    return get_body_transform(w, s.body_id)
}

// The broad phase's new pairs become contacts.
update_pairs(w: *World) -> int {
    visitors = PairVisitors { should_pair: should_pair, compound_tree_of: compound_tree_of, compound_transform: compound_transform_of, context: w as ptr }
    count = broad_phase.update_broad_phase_pairs(&w.broad_phase, visitors, w.compound_shape_count > 0)
    i = 0
    while i < count {
        key = broad_phase.pair_key(&w.broad_phase, i)
        shape_a = world_shape_at(w, broad_phase.pair_key_shape_a(key))
        shape_b = world_shape_at(w, broad_phase.pair_key_shape_b(key))
        create_contact(w, shape_a, shape_b, broad_phase.pair_key_child(key))
        i = i + 1
    }
    return count
}

// The recycling: when the bodies barely moved relative to each other
// since the manifolds were computed, the anchors are kept and only the
// separations updated (the reference's persistent-manifold shortcut).
try_recycle_contact(w: *World, c: *Contact, sim_a: *BodySim, sim_b: *BodySim, static_a: bool, static_b: bool, tolerance: float) -> bool {
    xf_a = sim_a.transform
    xf_b = sim_b.transform
    angle_a = math.dot_quat(xf_a.q, c.cached_rotation_a)
    angle_b = math.dot_quat(xf_b.q, c.cached_rotation_b)
    angular_distance = math.min_float(angle_a * angle_a, angle_b * angle_b)
    xf = math.inv_mul_transforms(xf_a, xf_b)
    xfc = c.cached_relative_pose
    max_extent_a = sim_a.max_extent
    if static_a { max_extent_a = math.vec3_zero() }
    max_extent_b = sim_b.max_extent
    if static_b { max_extent_b = math.vec3_zero() }
    max_extent = math.max_vec3(max_extent_a, max_extent_b)
    dist_squared = math.distance_squared(xf.p, xfc.p)
    if angular_distance <= CONTACT_RECYCLE_ANGULAR_DISTANCE || dist_squared >= tolerance * tolerance { return false }
    slack = tolerance - sqrt(dist_squared)
    qr = math.inv_mul_quat(xfc.q, xf.q)
    a = math.abs_vec3(qr.v)
    arc = math.vec3(a.y * max_extent.z + a.z * max_extent.y, a.z * max_extent.x + a.x * max_extent.z, a.x * max_extent.y + a.y * max_extent.x)
    if 4.0 * math.length_squared(arc) >= slack * slack { return false }
    dq_a = math.mul_quat(xf_a.q, math.conjugate(c.cached_rotation_a))
    dq_b = math.mul_quat(xf_b.q, math.conjugate(c.cached_rotation_b))
    matrix_a = math.make_matrix_from_quat(dq_a)
    matrix_b = math.make_matrix_from_quat(dq_b)
    dc = math.sub(sim_b.center, sim_a.center)
    i = 0
    while i < c.manifold_count {
        m = manifold_at(c, i)
        j = 0
        while j < m.point_count {
            p = manifold_point_at(m, j)
            r_a = math.mul_mv(matrix_a, p.anchor_a)
            r_b = math.mul_mv(matrix_b, p.anchor_b)
            dp = math.add(dc, math.sub(r_b, r_a))
            p.separation = p.base_separation + math.dot(dp, m.normal)
            p.persisted = true
            j = j + 1
        }
        i = i + 1
    }
    w.recycled_contact_count = w.recycled_contact_count + 1
    return true
}

// One awake contact's pass: destroyed when its proxies no longer
// overlap, recycled when its bodies barely moved, else its manifolds
// recomputed; a change of touching is noted for the state pass.
collide_contact(w: *World, contact_id: int) {
    c = contact_at(w, contact_id)
    shape_a = world_shape_at(w, c.shape_id_a)
    shape_b = world_shape_at(w, c.shape_id_b)
    if math.aabb_overlaps(shape_a.fat_aabb, shape_b.fat_aabb) == false {
        c.flags = (c.flags | SIM_DISJOINT) & (0 - 1 - SIM_TOUCHING)
        core.bitset_set(&w.contact_state, contact_id)
        return
    }
    body_a = body_at(w, shape_a.body_id)
    body_b = body_at(w, shape_b.body_id)
    static_a = body_a.kind == BODY_STATIC
    static_b = body_b.kind == BODY_STATIC
    was_touching = (c.flags & SIM_TOUCHING) != 0
    sim_a = get_body_sim(w, body_a)
    sim_b = get_body_sim(w, body_b)
    is_fast = (sim_a.flags & IS_FAST) != 0 || (sim_b.flags & IS_FAST) != 0
    c.body_sim_index_a = body_a.local_index
    if static_a { c.body_sim_index_a = NULL_INDEX }
    c.body_sim_index_b = body_b.local_index
    if static_b { c.body_sim_index_b = NULL_INDEX }
    recycle_distance = w.contact_recycle_distance
    tolerance = recycle_distance
    if was_touching == false { tolerance = math.min_float(recycle_distance, SPECULATIVE_DISTANCE) }
    if is_fast == false && recycle_distance > 0.0 && (c.flags & RELATIVE_TRANSFORM_VALID) != 0 && (c.flags & CONTACT_RECYCLE) != 0 {
        if try_recycle_contact(w, c, sim_a, sim_b, static_a, static_b, tolerance) { return }
    }
    c.cached_rotation_a = sim_a.transform.q
    c.cached_rotation_b = sim_b.transform.q
    c.cached_relative_pose = math.inv_mul_transforms(sim_a.transform, sim_b.transform)
    c.flags = c.flags | RELATIVE_TRANSFORM_VALID
    touching = update_contact(w, c, shape_a, sim_a.local_center, sim_a.transform, shape_b, sim_b.local_center, sim_b.transform, is_fast)
    if touching && was_touching && (c.flags & SIM_MESH_CONTACT) != 0 {
        contact_spec_at(graph_color(w, c.color_index), c.local_index).manifold_count = c.manifold_count
    }
    if touching && was_touching == false {
        c.flags = c.flags | SIM_STARTED_TOUCHING
        core.bitset_set(&w.contact_state, contact_id)
    } else if touching == false && was_touching {
        c.flags = c.flags | SIM_STOPPED_TOUCHING
        core.bitset_set(&w.contact_state, contact_id)
    }
    i = 0
    while i < c.manifold_count {
        m = manifold_at(c, i)
        j = 0
        while j < m.point_count {
            p = manifold_point_at(m, j)
            p.base_separation = p.separation
            j = j + 1
        }
        i = i + 1
    }
}

add_non_touching_contact(w: *World, c: *Contact) {
    set = solver_set_at(w, AWAKE_SET)
    c.color_index = NULL_INDEX
    c.local_index = set.contact_indices.count
    c.body_sim_index_a = NULL_INDEX
    c.body_sim_index_b = NULL_INDEX
    core.ints_push(&set.contact_indices, c.contact_id)
}

remove_non_touching_contact(w: *World, set_index: int, local_index: int) {
    set = solver_set_at(w, set_index)
    moved = core.ints_remove_swap(&set.contact_indices, local_index)
    if moved != NULL_INDEX && moved != local_index {
        contact_at(w, core.ints_get(&set.contact_indices, local_index)).local_index = local_index
    }
}

// The narrow phase for every awake contact (the graph's touching ones
// and the awake set's non-touching ones), then the state changes in
// contact id order: disjoint contacts destroyed, contacts that began
// touching linked into islands and the graph (with a begin event),
// contacts that stopped unlinked and back among the non-touching (with
// an end event). Returns how many contacts changed state.
collide(w: *World) -> int {
    core.buffer_clear(&w.contact_begin_events)
    touching_count = 0
    i = 0
    while i < GRAPH_COLOR_COUNT {
        color = graph_color(w, i)
        touching_count = touching_count + color.convex_contacts.count + color.contacts.count
        i = i + 1
    }
    awake = solver_set_at(w, AWAKE_SET)
    contact_count = touching_count + awake.contact_indices.count
    if contact_count == 0 { return 0 }
    indices_block = core.stack_alloc(&w.stack, contact_count * 4)
    indices = indices_block as int[]
    n = 0
    i = 0
    while i < GRAPH_COLOR_COUNT {
        color = graph_color(w, i)
        j = 0
        while j < color.convex_contacts.count {
            indices[n] = core.ints_get(&color.convex_contacts, j)
            n = n + 1
            j = j + 1
        }
        j = 0
        while j < color.contacts.count {
            indices[n] = contact_spec_at(color, j).contact_id
            n = n + 1
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < awake.contact_indices.count {
        indices[n] = core.ints_get(&awake.contact_indices, i)
        n = n + 1
        i = i + 1
    }
    core.bitset_set_count_and_clear(&w.contact_state, core.idpool_capacity(&w.contact_id_pool))
    w.sat_call_count = 0
    w.sat_cache_hit_count = 0
    w.recycled_contact_count = 0
    i = 0
    while i < contact_count {
        collide_contact(w, indices[i])
        i = i + 1
    }
    core.stack_free(&w.stack, indices_block)
    core.arena_sync(&w.arena)
    // The state changes, in id order.
    changed = 0
    bits = w.contact_state.bits as long[]
    k = 0
    while k < w.contact_state.block_count {
        block = bits[k]
        while block != (0 as long) {
            bit = core.ctz64(block)
            contact_id = 64 * k + bit
            c = contact_at(w, contact_id)
            flags = c.flags
            if (flags & SIM_DISJOINT) != 0 {
                destroy_contact(w, c, false)
            } else if (flags & SIM_STARTED_TOUCHING) != 0 {
                if (flags & CONTACT_ENABLE_CONTACT_EVENTS) != 0 { push_begin_event(w, c) }
                c.flags = (c.flags & (0 - 1 - SIM_STARTED_TOUCHING)) | CONTACT_TOUCHING
                // Linked first: this wakes the other body and settles the sims.
                link_contact(w, c)
                old_local_index = c.local_index
                add_contact_to_graph(w, c)
                remove_non_touching_contact(w, AWAKE_SET, old_local_index)
            } else if (flags & SIM_STOPPED_TOUCHING) != 0 {
                c.flags = c.flags & (0 - 1 - SIM_STOPPED_TOUCHING) & (0 - 1 - CONTACT_TOUCHING)
                if (c.flags & CONTACT_ENABLE_CONTACT_EVENTS) != 0 { push_end_event(w, c) }
                color_index = c.color_index
                local_index = c.local_index
                unlink_contact(w, c)
                body_id_a = c.edge_a.body_id
                body_id_b = c.edge_b.body_id
                add_non_touching_contact(w, c)
                remove_contact_from_graph(w, body_id_a, body_id_b, color_index, local_index, (c.flags & SIM_MESH_CONTACT) != 0)
            }
            changed = changed + 1
            block = block & (block - (1 as long))
        }
        k = k + 1
    }
    return changed
}

// The end events are double buffered so the user reads last pass's after
// the next has begun; the step swaps them.
swap_end_events(w: *World) {
    w.end_event_index = 1 - w.end_event_index
    core.buffer_clear(end_events(w))
}

// --- contact validation --------------------------------------------------------------------------------------

// Every live contact is where its indices say (a colour's array or a
// set's indices), touching iff coloured or in a sleeping set, in its
// island iff touching; the pair set holds every contact's key; both
// bodies' lists close on their counts.
validate_contacts(w: *World) -> bool {
    live = 0
    i = 0
    while i < w.contacts.count {
        c = contact_at(w, i)
        if c.contact_id != NULL_INDEX {
            live = live + 1
            if c.contact_id != i { return false }
            if broad_phase.has_pair(&w.broad_phase, core.shape_pair_key(c.shape_id_a, c.shape_id_b, c.child_index)) == false { return false }
            touching = (c.flags & CONTACT_TOUCHING) != 0
            if c.color_index != NULL_INDEX {
                if c.set_index != AWAKE_SET || touching == false { return false }
                color = graph_color(w, c.color_index)
                if (c.flags & SIM_MESH_CONTACT) != 0 || c.color_index == OVERFLOW_INDEX {
                    if c.local_index >= color.contacts.count || contact_spec_at(color, c.local_index).contact_id != i { return false }
                } else {
                    if c.local_index >= color.convex_contacts.count || core.ints_get(&color.convex_contacts, c.local_index) != i { return false }
                }
                if c.island_id == NULL_INDEX { return false }
            } else {
                set = solver_set_at(w, c.set_index)
                if c.local_index >= set.contact_indices.count || core.ints_get(&set.contact_indices, c.local_index) != i { return false }
                if c.set_index == AWAKE_SET && touching { return false }
                if c.set_index >= FIRST_SLEEPING_SET && touching == false { return false }
                if c.set_index == DISABLED_SET && (touching || c.island_id != NULL_INDEX) { return false }
            }
            if c.island_id != NULL_INDEX {
                island = island_at(w, c.island_id)
                if c.island_index >= island.contacts.count || contact_link_at(island, c.island_index).contact_id != i { return false }
            }
        }
        i = i + 1
    }
    if live != core.idpool_count(&w.contact_id_pool) { return false }
    if broad_phase.pair_count(&w.broad_phase) != live { return false }
    // The bodies' lists.
    i = 0
    while i < w.bodies.count {
        body = body_at(w, i)
        if body.set_index != NULL_INDEX {
            count = 0
            key = body.head_contact_key
            prev = NULL_INDEX
            while key != NULL_INDEX {
                c = contact_at(w, key >> 1)
                edge_body = c.edge_b.body_id
                edge_prev = c.edge_b.prev_key
                if (key & 1) == 0 {
                    edge_body = c.edge_a.body_id
                    edge_prev = c.edge_a.prev_key
                }
                if edge_body != i || edge_prev != prev { return false }
                count = count + 1
                prev = key
                key = contact_edge_next(w, key)
            }
            if count != body.contact_count { return false }
        }
        i = i + 1
    }
    return true
}
