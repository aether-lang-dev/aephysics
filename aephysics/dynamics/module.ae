const SHAPE_ENABLE_CONTACT_EVENTS = 0x02
const SHAPE_ENABLE_CUSTOM_FILTERING = 0x04
const SHAPE_ENABLE_HIT_EVENTS = 0x08
const SHAPE_ENABLE_PRE_SOLVE_EVENTS = 0x10
const SHAPE_ENABLE_SPECULATIVE = 0x40

// --- definitions and ids -------------------------------------------------------------------------

struct WorldDef {
    gravity: Vec3
    hit_event_threshold: float     // the approach speed that makes a hit event
    restitution_threshold: float   // the approach speed under which there is no bounce
    restitution_iterations: int    // the restitution passes after the sub-steps, 0 to 63
    enable_restitution_propagation: bool // restitution passes reach contacts without restitution too
    // Contacts with a kinematic body take the static softness (twice the
    // contact hertz), as contacts with a static one do: a body the game
    // drives hard does not sink into what it meets. Off, the reference's
    // choice (a kinematic body's contacts are soft).
    enable_kinematic_static_softness: bool
    contact_speed: float           // the push-out speed
    contact_hertz: float           // the contact spring
    contact_damping_ratio: float
    maximum_linear_speed: float
    friction_callback: fn(float, long, float, long) -> float
    restitution_callback: fn(float, long, float, long) -> float
    enable_sleep: bool
    enable_continuous: bool
    static_body_count: int         // the capacities the world starts with
    dynamic_body_count: int
    static_shape_count: int
    dynamic_shape_count: int
    contact_count: int
    worker_count: int              // the threads a step runs over: 1 is the calling thread alone
    scheduler: ptr                 // a *Scheduler of the host's to step on (its worker count then rules), or null for the world's own
    user_data: ptr
}

struct MotionLocks {
    linear_x: bool
    linear_y: bool
    linear_z: bool
    angular_x: bool
    angular_y: bool
    angular_z: bool
}

struct BodyDef {
    kind: int                      // BODY_STATIC, BODY_KINEMATIC or BODY_DYNAMIC
    position: Vec3
    rotation: Quat
    linear_velocity: Vec3
    angular_velocity: Vec3
    linear_damping: float
    angular_damping: float
    gravity_scale: float
    sleep_threshold: float
    safety_factor: float
    name: string                   // copied for debugging; null for none
    user_data: ptr
    motion_locks: MotionLocks
    enable_sleep: bool
    is_awake: bool
    is_bullet: bool
    is_enabled: bool
    allow_fast_rotation: bool
    enable_contact_recycling: bool
}

struct ShapeDef {
    name: string                   // copied for debugging; null for none
    user_data: ptr
    materials: ptr                 // SurfaceMaterial[], per triangle material of a mesh, or null
    material_count: int
    base_material: SurfaceMaterial // the one material when materials is null
    density: float
    explosion_scale: float
    filter: Filter
    enable_custom_filtering: bool
    is_sensor: bool
    enable_sensor_events: bool
    enable_contact_events: bool
    enable_hit_events: bool
    enable_pre_solve_events: bool
    invoke_contact_creation: bool  // a static shape finds its pairs at once
    update_body_mass: bool
    enable_speculative_contact: bool
}

// Ids are an index plus one (so zero is null), the world, and the
// generation of the slot, so an id from before a slot was recycled fails.
struct WorldId {
    index1: int
    generation: int
}

struct BodyId {
    index1: int
    world0: int
    generation: int
}

struct ShapeId {
    index1: int
    world0: int
    generation: int
}

default_friction(friction_a: float, user_a: long, friction_b: float, user_b: long) -> float { return sqrt(friction_a * friction_b) }
default_restitution(restitution_a: float, user_a: long, restitution_b: float, user_b: long) -> float { return math.max_float(restitution_a, restitution_b) }

default_world_def() -> WorldDef {
    return WorldDef { gravity: math.vec3(0.0, 0.0 - 10.0, 0.0), hit_event_threshold: 1.0, restitution_threshold: 1.0, contact_speed: 3.0,
                      restitution_iterations: 2, enable_restitution_propagation: false, enable_kinematic_static_softness: false,
                      contact_hertz: 30.0, contact_damping_ratio: 10.0, maximum_linear_speed: 400.0,
                      friction_callback: default_friction, restitution_callback: default_restitution,
                      enable_sleep: true, enable_continuous: true, static_body_count: 0, dynamic_body_count: 0,
                      static_shape_count: 0, dynamic_shape_count: 0, contact_count: 0, worker_count: 1, scheduler: null, user_data: null }
}

default_body_def() -> BodyDef {
    return BodyDef { kind: BODY_STATIC, position: math.vec3_zero(), rotation: math.quat_identity(), linear_velocity: math.vec3_zero(),
                     angular_velocity: math.vec3_zero(), linear_damping: 0.0, angular_damping: 0.0, gravity_scale: 1.0,
                     sleep_threshold: 0.05, safety_factor: 0.5, name: null, user_data: null,
                     motion_locks: MotionLocks { linear_x: false, linear_y: false, linear_z: false, angular_x: false, angular_y: false, angular_z: false },
                     enable_sleep: true, is_awake: true, is_bullet: false, is_enabled: true, allow_fast_rotation: false, enable_contact_recycling: true }
}

default_shape_def() -> ShapeDef {
    return ShapeDef { name: null, user_data: null, materials: null, material_count: 0, base_material: material.default_surface_material(),
                      density: 1000.0, explosion_scale: 1.0, filter: shape.default_filter(), enable_custom_filtering: false,
                      is_sensor: false, enable_sensor_events: false, enable_contact_events: false, enable_hit_events: false,
                      enable_pre_solve_events: false, invoke_contact_creation: true, update_body_mass: true, enable_speculative_contact: true }
}

// The most points a manifold holds (b3GetMaxManifoldPoints).
get_max_manifold_points() -> int { return MAX_MANIFOLD_POINTS }

// Ids into 64-bit values and back (b3StoreBodyId and its siblings, id.h):
// the index in the high half, the world and the generation 16 bits each
// below it; a world id into 32 bits.
store_world_id(id: WorldId) -> int { return ((id.index1 & 65535) << 16) | (id.generation & 65535) }
load_world_id(x: int) -> WorldId { return WorldId { index1: (x >> 16) & 65535, generation: x & 65535 } }
store_id(index1: int, world0: int, generation: int) -> long {
    return ((index1 as long) << 32) | (((world0 & 65535) as long) << 16) | ((generation & 65535) as long)
}
stored_index(x: long) -> int { return ((x >> 32) & (4294967295 as long)) as int }
stored_world(x: long) -> int { return ((x >> 16) & (65535 as long)) as int }
stored_generation(x: long) -> int { return (x & (65535 as long)) as int }
store_body_id(id: BodyId) -> long { return store_id(id.index1, id.world0, id.generation) }
load_body_id(x: long) -> BodyId { return BodyId { index1: stored_index(x), world0: stored_world(x), generation: stored_generation(x) } }
store_shape_id(id: ShapeId) -> long { return store_id(id.index1, id.world0, id.generation) }
load_shape_id(x: long) -> ShapeId { return ShapeId { index1: stored_index(x), world0: stored_world(x), generation: stored_generation(x) } }
store_joint_id(id: JointId) -> long { return store_id(id.index1, id.world0, id.generation) }
load_joint_id(x: long) -> JointId { return JointId { index1: stored_index(x), world0: stored_world(x), generation: stored_generation(x) } }

null_body_id() -> BodyId { return BodyId { index1: 0, world0: 0, generation: 0 } }
null_shape_id() -> ShapeId { return ShapeId { index1: 0, world0: 0, generation: 0 } }

// --- the state --------------------------------------------------------------------------------------

// A body's organisation: where its sim lives, its lists, its island.
// What the collide pass and the constraint prepares read of every body
// comes first (its set, its sim's index, its kind), in one cache line with
// the lists the contacts walk.
struct Body {
    set_index: int                 // the solver set, or NULL_INDEX when the slot is free
    local_index: int               // the sim (and state) within the set
    kind: int
    flags: int
    head_contact_key: int          // [contact id : 31 | edge : 1]
    contact_count: int
    head_shape_id: int
    shape_count: int
    head_joint_key: int
    joint_count: int
    island_id: int                 // every enabled dynamic or kinematic body is in one
    island_index: int              // within the island's bodies
    sleep_threshold: float
    sleep_time: float
    sleep_velocity: float
    safety_factor: float
    mass: float
    inertia: Matrix3               // about the centre of mass, in the body's frame
    body_move_index: int
    id: int
    generation: int
    user_data: ptr
    name_id: int                   // the name's id in the world's name cache, or NULL_NAME
}

// What the solver reads and writes for an awake body.
struct BodyState {
    v: Vec3f                       // the linear velocity
    padding1: f32
    w: Vec3f                       // the angular velocity
    padding2: f32
    dp: Vec3f                      // the position's change this step (round-off stays small far out)
    flags: int
    dq: Quatf                      // the rotation's change this step (identity for a static body)
}

// What integration and collision need of a body, the reference's
// b3BodySim with its positions in double: the pose, the centre of mass
// and the time of impact's start centre are world positions; everything
// else is a body's own scale or a rate, single precision as the
// reference keeps it. What the recycling and the constraint prepares read
// first comes first: the pose, the centre, the flags and extents, the
// masses (the first three cache lines).
struct BodySim {
    transform: Transform           // of the body's origin
    center: Vec3                   // of mass, in world space
    flags: int
    min_extent: f32
    max_extent: Vec3f
    inv_mass: f32
    inv_inertia_world: Matrix3f
    local_center: Vec3f
    rotation0: Quatf               // for the time of impact
    center0: Vec3
    force: Vec3f
    torque: Vec3f
    linear_damping: f32
    angular_damping: f32
    gravity_scale: f32
    inv_inertia_local: Matrix3f
    body_id: int
}

// A shape in the world: its geometry (the shape module's Shape, with
// its density) and its place among its body's shapes and in the broad phase.
// Its fat box, the bounds the broad phase holds, is kept apart in the
// world's fat_aabbs (the collide pass reads only that of a shape); what
// finalize reads to refit it comes first, the geometry and the rest after.
struct WorldShape {
    id: int                        // NULL_INDEX when the slot is free
    body_id: int
    aabb: AABB
    aabb_margin: float
    proxy_key: int
    prev_shape_id: int
    next_shape_id: int
    sensor_index: int
    geometry: Shape
    explosion_scale: float
    local_centroid: Vec3
    material_count: int
    material: SurfaceMaterial      // the one material when materials is null
    materials: ptr                 // SurfaceMaterial[] when there are several
    filter: Filter
    user_data: ptr
    generation: int
    flags: int
    name_id: int                   // the name's id in the world's name cache, or NULL_NAME
}

struct ContactEdge {
    body_id: int
    prev_key: int
    next_key: int
}

// The persistent interaction of two shapes (its update comes with the next layer).
// What the collide pass reads and writes of every awake contact comes
// first: the shapes, the flags, the manifolds, the sims' indices and the
// recycling's cached pose (two cache lines); the graph's and the islands'
// bookkeeping after.
struct Contact {
    shape_id_a: int
    shape_id_b: int
    flags: int
    manifold_count: int
    manifolds: ptr                 // Manifold[manifold_count], a heap block of the contact's
    // The bodies' sims as encode_body_sim_index gives them (the reference's
    // encodedBodySimA/B), kept current as the bodies move between sets, so
    // the collide pass and the prepares reach a sim without the body.
    encoded_body_sim_a: int
    encoded_body_sim_b: int
    // For the recycling, single precision as the reference's: the bodies'
    // rotations and B's pose relative to A at the last narrow phase (a
    // relative pose of touching bodies is small; the world positions stay
    // in the body sims, in double).
    cached_rotation_a: Quatf
    cached_rotation_b: Quatf
    cached_relative_p: Vec3f
    cached_relative_q: Quatf
    set_index: int
    color_index: int
    local_index: int
    edge_a: ContactEdge
    edge_b: ContactEdge
    child_index: int
    island_id: int
    island_index: int
    contact_id: int
    friction: f32
    restitution: f32
    rolling_resistance: f32
    tangent_velocity: Vec3f
    // A mesh contact's triangles or a convex contact's simplex or axis, in
    // the same bytes (the reference's union): mesh_cache_of and
    // convex_cache_of, by SIM_MESH_CONTACT. CONTACT_CACHE_WORDS words cover
    // the larger, a TriangleCache (80 bytes).
    caches: long[10]
    generation: int
}

const CONTACT_CACHE_WORDS = 10
mesh_cache_of(c: *Contact) -> *MeshContactCache { return (&c.caches) as *MeshContactCache }
convex_cache_of(c: *Contact) -> *TriangleCache { return (&c.caches) as *TriangleCache }

// A contact point the solver works on: anchors relative to the bodies'
// centres of mass in world space, the separation, the impulses. Single
// precision, the reference's b3ManifoldPoint (56 bytes): the anchors are
// offsets of a body's size, never world positions, and a contact's
// numbers are what the float lanes solve in.
struct ManifoldPoint {
    anchor_a: Vec3f
    anchor_b: Vec3f
    separation: f32
    base_separation: f32
    normal_impulse: f32
    total_normal_impulse: f32
    normal_velocity: f32
    feature_id: int
    triangle_index: int
    persisted: bool
}

// Up to four points on a normal, with the accumulated friction and
// rolling (the reference's b3Manifold, 268 bytes).
struct Manifold {
    point0: ManifoldPoint
    point1: ManifoldPoint
    point2: ManifoldPoint
    point3: ManifoldPoint
    normal: Vec3f
    twist_impulse: f32
    friction_impulse: Vec3f
    rolling_impulse: Vec3f
    point_count: int
}

// A touching contact in a graph colour: its manifolds' place in the solver's array.
struct ContactSpec {
    contact_id: int
    manifold_start: int
    manifold_count: int
}

struct ContactId {
    index1: int
    world0: int
    generation: int
}

struct ContactBeginTouchEvent {
    shape_id_a: ShapeId
    shape_id_b: ShapeId
    contact_id: ContactId
}

struct ContactEndTouchEvent {
    shape_id_a: ShapeId
    shape_id_b: ShapeId
    contact_id: ContactId
}

struct JointEdge {
    body_id: int
    prev_key: int
    next_key: int
}

// A joint's organisation: where its sim lives, its edges on both bodies, its island.
struct Joint {
    user_data: ptr
    set_index: int                 // NULL_INDEX when the slot is free
    color_index: int               // NULL_INDEX unless awake
    local_index: int
    edge_a: JointEdge
    edge_b: JointEdge
    joint_id: int
    island_id: int
    island_index: int
    draw_scale: float
    kind: int
    generation: int
    collide_connected: bool
}

// A soft constraint's coefficients at a time step.
struct Softness {
    bias_rate: float
    mass_scale: float
    impulse_scale: float
}

struct JointId {
    index1: int
    world0: int
    generation: int
}

// The base of every joint definition. The frames are local to the
// bodies' origins, not their centres of mass, so a mass change or a
// new shape does not break the joint.
struct JointDef {
    user_data: ptr
    body_id_a: BodyId
    body_id_b: BodyId
    local_frame_a: Transform
    local_frame_b: Transform
    force_threshold: float         // for the joint events
    torque_threshold: float
    constraint_hertz: float        // advanced: the constraint's stiffness
    constraint_damping_ratio: float
    draw_scale: float
    collide_connected: bool        // whether the attached bodies collide
}

// A segment between a point on each body: a rope or a spring.
struct DistanceJointDef {
    base: JointDef
    length: float                  // the rest length, clamped to a stable minimum
    enable_spring: bool            // a spring instead of a rigid rod (the limit and motor need it)
    lower_spring_force: float      // the tension it sustains
    upper_spring_force: float      // the compression
    hertz: float
    damping_ratio: float
    enable_limit: bool
    min_length: float
    max_length: float
    enable_motor: bool
    max_motor_force: float
    motor_speed: float
}

// The relative position and velocity of two bodies driven.
struct MotorJointDef {
    base: JointDef
    linear_velocity: Vec3
    max_velocity_force: float
    angular_velocity: Vec3
    max_velocity_torque: float
    linear_hertz: float            // the position spring
    linear_damping_ratio: float
    max_spring_force: float
    angular_hertz: float
    angular_damping_ratio: float
    max_spring_torque: float
}

// Collision between two bodies disabled, nothing else.
struct FilterJointDef {
    base: JointDef
}

// The z axes of the two frames kept aligned by a spring (a body kept upright).
struct ParallelJointDef {
    base: JointDef
    hertz: float
    damping_ratio: float
    max_torque: float
}

// Body B slides along frame A's x axis, without rotating relative to A.
struct PrismaticJointDef {
    base: JointDef
    enable_spring: bool
    hertz: float
    damping_ratio: float
    target_translation: float
    enable_limit: bool
    lower_translation: float
    upper_translation: float
    enable_motor: bool
    max_motor_force: float
    motor_speed: float
}

// A point on B fixed to a point on A, rotation about the z axis.
struct RevoluteJointDef {
    base: JointDef
    target_angle: float            // B's angle minus A's in the reference state
    enable_spring: bool
    hertz: float
    damping_ratio: float
    enable_limit: bool
    lower_angle: float             // at least -0.99 pi
    upper_angle: float             // at most 0.99 pi
    enable_motor: bool
    max_motor_torque: float
    motor_speed: float
}

// A point on B fixed to a point on A, free rotation about it, a cone and a twist limit.
struct SphericalJointDef {
    base: JointDef
    enable_spring: bool
    hertz: float
    damping_ratio: float
    target_rotation: Quat          // frame B relative to frame A
    enable_cone_limit: bool        // the cone about frame A's z axis
    cone_angle: float
    cone_axis: Vec3                // the cone's centre in frame A: its z, the reference's, or any way off it
    // An elliptical cone: cone_angle reaches toward cone_major_axis (in
    // frame A, taken across the centre; zero for frame A's x) and
    // cone_minor_angle across it. 0 for the reference's circular cone.
    cone_minor_angle: float
    cone_major_axis: Vec3
    enable_twist_limit: bool       // the twist about frame B's z axis
    lower_twist_angle: float
    upper_twist_angle: float
    enable_motor: bool
    max_motor_torque: float
    motor_velocity: Vec3           // angular velocity of B relative to A, in world space
}

// Two bodies held together, with springs for softness.
struct WeldJointDef {
    base: JointDef
    linear_hertz: float            // zero for the stiffest
    angular_hertz: float
    linear_damping_ratio: float
    angular_damping_ratio: float
}

// A is the chassis, B the wheel: it spins about frame B's z axis,
// travels along frame A's x axis, and may steer about that axis.
struct WheelJointDef {
    base: JointDef
    enable_suspension_spring: bool
    suspension_hertz: float
    suspension_damping_ratio: float
    enable_suspension_limit: bool
    lower_suspension_limit: float
    upper_suspension_limit: float
    enable_spin_motor: bool
    max_spin_torque: float
    spin_speed: float
    enable_steering: bool
    steering_hertz: float
    steering_damping_ratio: float
    target_steering_angle: float
    max_steering_torque: float
    enable_steering_limit: bool
    lower_steering_limit: float
    upper_steering_limit: float
}

// The kinds' data, each laid over JointSim.data.
struct DistanceJoint {
    length: float
    hertz: float
    damping_ratio: float
    lower_spring_force: float
    upper_spring_force: float
    min_length: float
    max_length: float
    max_motor_force: float
    motor_speed: float
    impulse: float
    lower_impulse: float
    upper_impulse: float
    motor_impulse: float
    index_a: int
    index_b: int
    anchor_a: Vec3
    anchor_b: Vec3
    delta_center: Vec3
    distance_softness: Softness
    axial_mass: float
    enable_spring: bool
    enable_limit: bool
    enable_motor: bool
}

struct MotorJoint {
    linear_velocity: Vec3
    angular_velocity: Vec3
    max_velocity_force: float
    max_velocity_torque: float
    linear_hertz: float
    linear_damping_ratio: float
    max_spring_force: float
    angular_hertz: float
    angular_damping_ratio: float
    max_spring_torque: float
    linear_velocity_impulse: Vec3
    angular_velocity_impulse: Vec3
    linear_spring_impulse: Vec3
    angular_spring_impulse: Vec3
    linear_spring: Softness
    angular_spring: Softness
    index_a: int
    index_b: int
    frame_a: Transform
    frame_b: Transform
    delta_center: Vec3
    angular_mass: Matrix3
}

struct ParallelJoint {
    hertz: float
    damping_ratio: float
    max_torque: float
    perp_impulse: Vec2
    perp_axis_x: Vec3
    perp_axis_y: Vec3
    quat_a: Quat
    quat_b: Quat
    index_a: int
    index_b: int
    softness: Softness
}

struct PrismaticJoint {
    perp_impulse: Vec2
    angular_impulse: Vec3
    spring_impulse: float
    motor_impulse: float
    lower_impulse: float
    upper_impulse: float
    hertz: float
    damping_ratio: float
    max_motor_force: float
    motor_speed: float
    target_translation: float
    lower_translation: float
    upper_translation: float
    index_a: int
    index_b: int
    frame_a: Transform
    frame_b: Transform
    joint_axis: Vec3
    perp_axis_y: Vec3
    perp_axis_z: Vec3
    delta_center: Vec3
    delta_angle: float
    rotation_mass: Matrix3
    spring_softness: Softness
    enable_spring: bool
    enable_limit: bool
    enable_motor: bool
}

struct RevoluteJoint {
    linear_impulse: Vec3
    perp_impulse: Vec2
    spring_impulse: float
    motor_impulse: float
    lower_impulse: float
    upper_impulse: float
    hertz: float
    damping_ratio: float
    max_motor_torque: float
    motor_speed: float
    target_angle: float
    lower_angle: float
    upper_angle: float
    index_a: int
    index_b: int
    frame_a: Transform
    frame_b: Transform
    rotation_axis_z: Vec3
    perp_axis_x: Vec3
    perp_axis_y: Vec3
    delta_center: Vec3
    delta_angle: float
    axial_mass: float
    spring_softness: Softness
    enable_spring: bool
    enable_motor: bool
    enable_limit: bool
}

// The point constraint's fields first (every solve reads them), then the
// impulses and axes the warm start reads, the settings after.
struct SphericalJoint {
    enable_spring: bool
    enable_motor: bool
    enable_cone_limit: bool
    enable_twist_limit: bool
    index_a: int
    index_b: int
    linear_impulse: Vec3
    frame_a: Transform
    frame_b: Transform
    delta_center: Vec3
    spring_impulse: Vec3
    motor_impulse: Vec3
    lower_twist_impulse: float
    upper_twist_impulse: float
    swing_impulse: float
    swing_axis: Vec3
    twist_jacobian: Vec3
    hertz: float
    damping_ratio: float
    max_motor_torque: float
    motor_velocity: Vec3
    lower_twist_angle: float
    upper_twist_angle: float
    cone_angle: float
    cone_axis: Vec3                // unit, in frame A
    cone_major_axis: Vec3f         // in frame A: where an elliptical cone reaches cone_angle; zero for x
    cone_minor_angle: f32          // across it; 0 for a circular cone
    target_rotation: Quat
    rotation_mass: Matrix3
    swing_mass: float
    twist_mass: float
    spring_softness: Softness
}

struct WeldJoint {
    linear_hertz: float
    linear_damping_ratio: float
    angular_hertz: float
    angular_damping_ratio: float
    linear_spring: Softness
    angular_spring: Softness
    linear_impulse: Vec3
    angular_impulse: Vec3
    index_a: int
    index_b: int
    frame_a: Transform
    frame_b: Transform
    delta_center: Vec3
    angular_mass: Matrix3
}

struct WheelJoint {
    linear_impulse: Vec2
    angular_impulse: Vec2
    spin_impulse: float
    max_spin_torque: float
    spin_speed: float
    suspension_spring_impulse: float
    lower_suspension_impulse: float
    upper_suspension_impulse: float
    lower_suspension_limit: float
    upper_suspension_limit: float
    suspension_hertz: float
    suspension_damping_ratio: float
    steering_spring_impulse: float
    lower_steering_impulse: float
    upper_steering_impulse: float
    lower_steering_limit: float
    upper_steering_limit: float
    target_steering_angle: float
    max_steering_torque: float
    steering_hertz: float
    steering_damping_ratio: float
    index_a: int
    index_b: int
    frame_a: Transform
    frame_b: Transform
    delta_center: Vec3
    spin_mass: float
    suspension_mass: float
    steering_mass: float
    suspension_softness: Softness
    steering_softness: Softness
    enable_spin_motor: bool
    enable_suspension_spring: bool
    enable_suspension_limit: bool
    enable_steering: bool
    enable_steering_limit: bool
    enable_steering_motor: bool
}

// A joint's simulation data: the frames, the bodies' inverse masses
// (filled by the solver's prepare), the constraint's softness, the
// thresholds, and the kind's data in the block at the end (the
// reference's union: read through distance_joint_of and its siblings).
// What the warm start and the solve read comes first and the kind's data
// right after it, so a joint's pass touches as few lines as it can; the
// frames and settings only the prepare and the API read go last.
struct JointSim {
    kind: int
    fixed_rotation: bool
    inv_mass_a: float
    inv_mass_b: float
    inv_inertia_a: Matrix3f        // the body sims' world inertias, single precision as they are kept
    inv_inertia_b: Matrix3f
    constraint_softness: Softness
    force_threshold: float         // the solve's joint event test
    torque_threshold: float
    data: long[70]                 // JOINT_DATA_BYTES
    joint_id: int
    body_id_a: int
    body_id_b: int
    local_frame_a: Transform
    local_frame_b: Transform
    constraint_hertz: float
    constraint_damping_ratio: float
}

struct JointPair {
    joint: *Joint
    sim: *JointSim
}

struct JointReaction {
    force: float
    torque: float
}

// A sensor shape's overlaps: the visitors it found last pass and the
// pass before (keys of shape id and generation, sorted), and the hits
// the continuous pass reports between passes.
struct Sensor {
    hits: Buffer                   // long
    overlaps1: Buffer              // long
    overlaps2: Buffer              // long
    shape_id: int
}

struct SensorBeginTouchEvent {
    sensor_shape_id: ShapeId
    visitor_shape_id: ShapeId
}

struct SensorEndTouchEvent {
    sensor_shape_id: ShapeId
    visitor_shape_id: ShapeId
}

// A body that moved this step (one per awake body, in the awake set's order).
struct BodyMoveEvent {
    user_data: ptr
    transform: Transform
    body_id: BodyId
    fell_asleep: bool
}

// A contact that closed faster than the hit threshold this step.
struct ContactHitEvent {
    shape_id_a: ShapeId
    shape_id_b: ShapeId
    contact_id: ContactId
    point: Vec3
    normal: Vec3
    approach_speed: float
    user_material_id_a: long
    user_material_id_b: long
}

// A joint whose reaction crossed its force or torque threshold this step.
struct JointEvent {
    joint_id: JointId
    user_data: ptr
}

// A sensor a fast shape swept through, found by the continuous pass.
struct SensorHit {
    sensor_id: int
    visitor_id: int
}

// One colour of the constraint graph: no two constraints in it share a
// dynamic body, so the solver can run them side by side.
struct GraphColor {
    body_set: BitSet               // by body id; unused on the overflow colour
    joint_sims: Buffer             // JointSim
    convex_contacts: Ints      // contact ids (the wide solver's)
    contacts: Buffer               // ContactSpec (mesh contacts and the overflow's)
    contact_constraints: ptr       // the solver's ContactConstraint[contact_constraint_count] for the step
    manifold_constraints: ptr      // its ManifoldConstraint[manifold_constraint_count]
    contact_constraint_count: int
    manifold_constraint_count: int
    wide_constraints: ptr          // the wide solver's WideConstraint[wide_constraint_count] over convex_contacts
    wide_constraint_count: int
}

struct ConstraintGraph {
    colors: ptr                    // GraphColor[GRAPH_COLOR_COUNT], the overflow last
}

struct ContactLink {
    contact_id: int
    body_id_a: int
    body_id_b: int
}

struct JointLink {
    joint_id: int
    body_id_a: int
    body_id_b: int
}

// A group of bodies connected by constraints; it sleeps as one.
struct Island {
    set_index: int
    local_index: int
    island_id: int
    constraint_remove_count: int
    bodies: Ints
    contacts: Buffer               // ContactLink
    joints: Buffer                 // JointLink
}

struct IslandSim {
    island_id: int
}

// The simulation data of one set of bodies: static, disabled, awake, or one sleeping island.
struct SolverSet {
    body_sims: Buffer              // BodySim
    body_states: Buffer            // BodyState, the awake set only
    joint_sims: Buffer             // the joint layer's JointSim, sleeping and disabled sets
    contact_indices: Ints      // sleeping sets' contacts; the awake set's non-touching ones
    island_sims: Buffer            // IslandSim
    set_index: int                 // NULL_INDEX when unused
}

// A worker's own state through a step (b3TaskContext): the narrow
// phase's arena, the contacts whose touching changed and its counters;
// the solver's joints past their thresholds, contacts with a hit,
// islands kept awake, split candidate and sensor hits. Each worker
// writes only its own and the step merges them after.
struct TaskContext {
    arena: Arena
    contact_state: BitSet
    sat_call_count: int
    sat_cache_hit_count: int
    recycled_contact_count: int
    joint_state_bits: BitSet
    hit_event_bits: BitSet
    has_hit_events: bool
    awake_island_bits: BitSet
    split_island_id: int
    split_sleep_time: float
    sensor_hits: Buffer            // SensorHit, from the continuous pass
    manifold_counts: int[8]        // the collide pass's contacts by manifold count (1 to 7, the last 7 or more)
    distance_iterations: int       // the most any time of impact took, over the world's life
    push_back_iterations: int
    root_iterations: int
}

// Where a step's time went, in milliseconds (b3Profile): the broad
// phase's pairs, the narrow phase, the solve and its parts, the
// sensors, and the whole step.
// What a step spent, stage by stage, as the reference's b3Profile has it
// (bench/physics_world_box3d.c prints its columns): the phases of the
// step, and inside `constraints` the stages the workers run. The stages
// are filled only when the solver is timing them (AEPHYSICS_STAGES=1),
// since a clock around every block is worth having only when someone is
// reading it.
struct Profile {
    step: float
    pairs: float
    collide: float
    solve: float
    solver_setup: float
    constraints: float             // the stages over the workers, the split island and the merges
    transforms: float              // finalize: the bodies' transforms, bounds and proxies
    refit: float
    bullets: float
    sleep_islands: float
    sensors: float
    // The stages, per step, averaged over the run by whoever reads them.
    prepare_constraints: float
    integrate_velocities: float
    warm_start: float
    solve_impulses: float
    integrate_positions: float
    relax_impulses: float
    apply_restitution: float
    store_impulses: float
}

struct World {
    profile: Profile
    stack: Stack
    // A contact's manifolds come out of these, one allocator per manifold
    // count (the first hands out one manifold, the second two, and so on),
    // as the reference's world keeps them: allocated one by one from the
    // heap, the manifolds of neighbouring contacts were scattered and
    // every pass that walks the contacts missed the cache on each. The
    // narrow phase runs on every worker, so the lock is a word the
    // workers swap for.
    manifold_allocators: Buffer    // BlockAllocator
    manifold_lock: int
    broad_phase: BroadPhase
    constraint_graph: ConstraintGraph
    task_contexts: ptr             // TaskContext[worker_count]
    worker_count: int
    worker_base: int               // the first of the worker slots the world's steps run as
    owns_worker_slots: bool        // claimed for this world alone (else base 0, shared)
    scheduler: ptr                 // *Scheduler (aephysics.parallel), the step's threads
    owns_scheduler: bool           // made with the world, or the host's
    contact_state: BitSet          // the contacts whose touching changed this pass, every worker's merged
    contact_begin_events: Buffer   // ContactBeginTouchEvent
    contact_end_events0: Buffer    // ContactEndTouchEvent, double buffered
    contact_end_events1: Buffer
    end_event_index: int
    sat_call_count: int
    sat_cache_hit_count: int
    recycled_contact_count: int
    body_id_pool: IdPool
    bodies: Buffer                 // Body, sparse by id
    solver_set_id_pool: IdPool
    solver_sets: Buffer            // SolverSet
    joint_id_pool: IdPool
    joints: Buffer                 // Joint
    contact_id_pool: IdPool
    contacts: Buffer               // Contact
    island_id_pool: IdPool
    islands: Buffer                // Island
    shape_id_pool: IdPool
    shapes: Buffer                 // WorldShape
    fat_aabbs: Buffer              // AABBf by shape id: the fat boxes, dense for the collide pass (the reference's fatAABBs), in single precision rounded outward (#151)
    hull_entries: Buffer           // HullEntry: the hull database (the reference's hullDatabase)
    hull_heads: LongMap            // a hull's hash to the first entry of that hash
    hull_free: int                 // the first free entry, chained through next
    hull_count: int                // the distinct hulls held
    owned_geometry: Buffer         // OwnedGeometry: meshes, height fields and compounds the world was loaded with (aephysics.snapshot), freed with it
    sensors: Buffer                // Sensor
    sensor_begin_events: Buffer    // SensorBeginTouchEvent
    sensor_end_events0: Buffer     // SensorEndTouchEvent, double buffered with the contacts' index
    sensor_end_events1: Buffer
    sensor_event_bits: BitSet      // the sensors whose overlaps changed this pass
    custom_filter: fn(ShapeId, ShapeId, ptr) -> bool
    custom_filter_context: ptr
    has_custom_filter: bool
    pre_solve: fn(ShapeId, ShapeId, Vec3, Vec3, ptr) -> bool
    pre_solve_context: ptr
    has_pre_solve: bool
    body_move_events: Buffer       // BodyMoveEvent, one per awake body after a step
    contact_hit_events: Buffer     // ContactHitEvent
    joint_events: Buffer           // JointEvent
    joint_state_bits: BitSet       // the solver's: joints past their thresholds
    hit_event_bits: BitSet         // contacts with a hit
    awake_island_bits: BitSet      // islands a body kept awake
    split_island_candidate: int    // the sleepiest island that needs splitting
    split_sleep_time: float
    compound_shape_count: int
    step_index: long
    split_island_id: int
    gravity: Vec3
    hit_event_threshold: float
    restitution_threshold: float
    restitution_iterations: int
    enable_restitution_propagation: bool
    enable_kinematic_static_softness: bool
    max_linear_speed: float
    contact_speed: float
    contact_hertz: float
    contact_damping_ratio: float
    contact_recycle_distance: float
    friction_callback: fn(float, long, float, long) -> float
    restitution_callback: fn(float, long, float, long) -> float
    generation: int
    inv_h: float
    inv_dt: float
    world_id: int
    enable_sleep: bool
    locked: bool
    enable_warm_starting: bool
    enable_continuous: bool
    enable_speculative: bool
    in_use: bool
    user_data: ptr
    recording: ptr                 // *Recording while the world records (aephysics.recording), else null
    names: NameCache               // the bodies' and shapes' names, each once
    max_capacity: Capacity         // the most it has held at a step's start (b3World_GetMaxCapacity)
    manifold_counts: int[8]        // the last collide pass's contacts by manifold count, every worker's
    task_count: int                // the tasks the last step ran on the scheduler
}

// The buckets of the contacts' manifold counts (the reference's
// B3_CONTACT_MANIFOLD_COUNT_BUCKETS): a contact with n manifolds counts in
// bucket n - 1, the last holding seven or more.
const MANIFOLD_COUNT_BUCKETS = 8

count_manifolds(tc: *TaskContext, manifold_count: int) {
    bucket = math.min_int(manifold_count, MANIFOLD_COUNT_BUCKETS - 1)
    if bucket > 0 { tc.manifold_counts[bucket - 1] = tc.manifold_counts[bucket - 1] + 1 }
}

var g_worlds: ptr = null           // World[MAX_WORLDS]
var g_max_world_count = 0          // the most worlds there have been at once

worlds_ready() {
    if g_worlds == null { g_worlds = basics.alloc(MAX_WORLDS * sizeof(World)) }
}

// Every module's per-worker scratch allocated on the calling thread,
// before a step can reach it from several workers at once (each block
// is allocated once and kept for the program).
reserve_scratch() {
    contact_scratch_ready()
    child_scratch_ready()
    sensor_scratch_ready()
    closest_target()
    manifold.reserve_scratch()
    triangle_manifold.reserve_scratch()
    mesh.reserve_scratch()
    mesh_contact.reserve_scratch()
    height_field.reserve_scratch()
    sphere.reserve_scratch()
    compound.reserve_scratch()
    shape.reserve_scratch()
}

world_at(index: int) -> *World { return (g_worlds + index * sizeof(World)) as *World }

// --- element access ------------------------------------------------------------------------------

body_at(w: *World, id: int) -> *Body { return (w.bodies.data + id * sizeof(Body)) as *Body }
world_shape_at(w: *World, id: int) -> *WorldShape { return (w.shapes.data + id * sizeof(WorldShape)) as *WorldShape }
// A shape's fat box: the one its proxy holds, in single precision rounded
// outward, so the collide pass's overlap test is the broad phase's own.
shape_fat_aabb(w: *World, id: int) -> AABBf {
    boxes = w.fat_aabbs.data as AABBf[]
    return boxes[id]
}
set_shape_fat_aabb(w: *World, id: int, box: AABBf) {
    boxes = w.fat_aabbs.data as AABBf[]
    boxes[id] = box
}
island_at(w: *World, id: int) -> *Island { return (w.islands.data + id * sizeof(Island)) as *Island }
solver_set_at(w: *World, index: int) -> *SolverSet { return (w.solver_sets.data + index * sizeof(SolverSet)) as *SolverSet }
body_sim_at(set: *SolverSet, index: int) -> *BodySim { return (set.body_sims.data + index * sizeof(BodySim)) as *BodySim }
body_state_at(set: *SolverSet, index: int) -> *BodyState { return (set.body_states.data + index * sizeof(BodyState)) as *BodyState }
island_sim_at(set: *SolverSet, index: int) -> *IslandSim { return (set.island_sims.data + index * sizeof(IslandSim)) as *IslandSim }

get_solver_set(w: *World, index: int) -> *SolverSet { return solver_set_at(w, index) }
get_island(w: *World, id: int) -> *Island { return island_at(w, id) }
world_island_count(w: *World) -> int { return basics.idpool_count(&w.island_id_pool) }
world_solver_set_count(w: *World) -> int { return basics.idpool_count(&w.solver_set_id_pool) }

// --- worlds --------------------------------------------------------------------------------------------

get_world(index: int) -> *World {
    worlds_ready()
    return world_at(index)
}

world_is_valid(id: WorldId) -> bool {
    if id.index1 < 1 || id.index1 > MAX_WORLDS { return false }
    worlds_ready()
    w = world_at(id.index1 - 1)
    return w.in_use && w.generation == id.generation
}

get_world_from_id(id: WorldId) -> *World {
    worlds_ready()
    return world_at(id.index1 - 1)
}

empty_solver_set() -> SolverSet {
    return SolverSet { body_sims: basics.buffer_create(sizeof(BodySim), 0), body_states: basics.buffer_create(sizeof(BodyState), 0),
                       joint_sims: basics.buffer_create(sizeof(JointSim), 0), contact_indices: basics.ints_create(0),
                       island_sims: basics.buffer_create(sizeof(IslandSim), 0), set_index: NULL_INDEX }
}

// A new set at a free slot, reserved for the awake set's capacities.
create_solver_set(w: *World) -> int {
    set_id = basics.idpool_alloc(&w.solver_set_id_pool)
    if set_id == w.solver_sets.count {
        index = basics.buffer_push(&w.solver_sets)
        s = solver_set_at(w, index)
        made = empty_solver_set()
        s.body_sims = made.body_sims
        s.body_states = made.body_states
        s.joint_sims = made.joint_sims
        s.contact_indices = made.contact_indices
        s.island_sims = made.island_sims
    }
    s = solver_set_at(w, set_id)
    s.set_index = set_id
    return set_id
}

destroy_solver_set(w: *World, set_index: int) {
    s = solver_set_at(w, set_index)
    basics.buffer_destroy(&s.body_sims)
    basics.buffer_destroy(&s.body_states)
    basics.buffer_destroy(&s.joint_sims)
    basics.ints_destroy(&s.contact_indices)
    basics.buffer_destroy(&s.island_sims)
    basics.idpool_free(&w.solver_set_id_pool, set_index)
    s.set_index = NULL_INDEX
}

// A world at the first free slot: its pools, its broad phase, and the
// static, disabled and awake sets.
// A world definition's numbers, as its setters take them: finite gravity,
// thresholds, contact tuning and capacities not below zero, a positive
// speed cap.
valid_world_def(def: *WorldDef) -> bool {
    if math.is_valid_vec3(def.gravity) == false { return false }
    if valid_nonnegative(def.hit_event_threshold) == false || valid_nonnegative(def.restitution_threshold) == false { return false }
    if valid_nonnegative(def.contact_speed) == false || valid_nonnegative(def.contact_hertz) == false || valid_nonnegative(def.contact_damping_ratio) == false { return false }
    if math.is_valid_float(def.maximum_linear_speed) == false || def.maximum_linear_speed <= 0.0 { return false }
    if def.static_body_count < 0 || def.dynamic_body_count < 0 || def.static_shape_count < 0 || def.dynamic_shape_count < 0 || def.contact_count < 0 { return false }
    return true
}

create_world(def: *WorldDef) -> WorldId {
    if valid_world_def(def) == false { return WorldId { index1: 0, generation: 0 } }
    worlds_ready()
    index = NULL_INDEX
    i = 0
    while i < MAX_WORLDS && index == NULL_INDEX {
        if world_at(i).in_use == false { index = i }
        i = i + 1
    }
    if index == NULL_INDEX { return WorldId { index1: 0, generation: 0 } }
    w = world_at(index)
    generation = w.generation
    memset(w as ptr, 0, sizeof(World))
    w.world_id = index
    w.generation = generation
    w.in_use = true
    w.stack = basics.stack_create(2048)
    reserve_scratch()
    create_workers(w, def.scheduler, def.worker_count)
    w.friction_callback = def.friction_callback
    w.restitution_callback = def.restitution_callback
    w.user_data = def.user_data
    init_world_contents(w, def)
    g_max_world_count = math.max_int(g_max_world_count, get_world_count())
    return WorldId { index1: index + 1, generation: generation }
}

// The worlds there are (b3GetWorldCount), and the most there have been at
// once (b3GetMaxWorldCount).
get_world_count() -> int {
    if g_worlds == null { return 0 }
    count = 0
    i = 0
    while i < MAX_WORLDS {
        if world_at(i).in_use { count = count + 1 }
        i = i + 1
    }
    return count
}

get_max_world_count() -> int { return g_max_world_count }

// The world's maximum capacity brought up to what it holds now, at the
// start of a step (as the reference keeps it): a host sizes the next
// world's def from it to grow nothing while stepping.
track_capacity(w: *World) {
    c = &w.max_capacity
    c.static_shape_count = math.max_int(c.static_shape_count, dynamic_tree.tree_get_proxy_count(broad_phase.broad_phase_tree(&w.broad_phase, BODY_STATIC)))
    c.dynamic_shape_count = math.max_int(c.dynamic_shape_count, dynamic_tree.tree_get_proxy_count(broad_phase.broad_phase_tree(&w.broad_phase, BODY_DYNAMIC)))
    static_bodies = solver_set_at(w, STATIC_SET).body_sims.count
    c.static_body_count = math.max_int(c.static_body_count, static_bodies)
    c.dynamic_body_count = math.max_int(c.dynamic_body_count, world_body_count(w) - static_bodies)
    c.contact_count = math.max_int(c.contact_count, basics.idpool_count(&w.contact_id_pool))
}

// Everything a world holds (its bodies, shapes, joints, contacts, sets,
// islands, geometry and events), made fresh as `def` sizes and sets it;
// what the host wires in (workers, callbacks, filters, user data) is not
// touched.
init_world_contents(w: *World, def: *WorldDef) {
    memset((&w.profile) as ptr, 0, sizeof(Profile))
    w.manifold_allocators = basics.buffer_create(sizeof(BlockAllocator), 0)
    w.manifold_lock = 0
    w.sat_call_count = 0
    w.sat_cache_hit_count = 0
    w.recycled_contact_count = 0
    w.compound_shape_count = 0
    w.inv_h = 0.0
    w.inv_dt = 0.0
    w.names = basics.name_cache_create()
    w.contact_state = basics.bitset_create(64)
    w.contact_begin_events = basics.buffer_create(sizeof(ContactBeginTouchEvent), 4)
    w.contact_end_events0 = basics.buffer_create(sizeof(ContactEndTouchEvent), 4)
    w.contact_end_events1 = basics.buffer_create(sizeof(ContactEndTouchEvent), 4)
    w.end_event_index = 0
    create_graph(&w.constraint_graph, 16)
    broad_phase.create_broad_phase(&w.broad_phase, Capacity { static_shape_count: def.static_shape_count, dynamic_shape_count: def.dynamic_shape_count, contact_count: def.contact_count,
                                                              static_body_count: def.static_body_count, dynamic_body_count: def.dynamic_body_count })
    w.max_capacity = Capacity { static_shape_count: 0, dynamic_shape_count: 0, contact_count: 0, static_body_count: 0, dynamic_body_count: 0 }
    w.body_id_pool = basics.idpool_create()
    w.bodies = basics.buffer_create(sizeof(Body), math.max_int(16, def.static_body_count + def.dynamic_body_count))
    w.solver_set_id_pool = basics.idpool_create()
    w.solver_sets = basics.buffer_create(sizeof(SolverSet), 8)
    static_set = create_solver_set(w)
    create_solver_set(w)
    awake_set = create_solver_set(w)
    basics.buffer_reserve(&solver_set_at(w, static_set).body_sims, math.max_int(16, def.static_body_count))
    basics.buffer_reserve(&solver_set_at(w, awake_set).body_sims, math.max_int(16, def.dynamic_body_count))
    basics.buffer_reserve(&solver_set_at(w, awake_set).body_states, math.max_int(16, def.dynamic_body_count))
    w.shape_id_pool = basics.idpool_create()
    w.shapes = basics.buffer_create(sizeof(WorldShape), math.max_int(16, def.static_shape_count + def.dynamic_shape_count))
    w.fat_aabbs = basics.buffer_create(sizeof(AABBf), math.max_int(16, def.static_shape_count + def.dynamic_shape_count))
    w.hull_entries = basics.buffer_create(sizeof(HullEntry), 0)
    w.hull_heads = basics.map_create(16)
    w.hull_free = NULL_INDEX
    w.hull_count = 0
    w.owned_geometry = basics.buffer_create(sizeof(OwnedGeometry), 0)
    w.sensors = basics.buffer_create(sizeof(Sensor), 0)
    w.sensor_begin_events = basics.buffer_create(sizeof(SensorBeginTouchEvent), 4)
    w.sensor_end_events0 = basics.buffer_create(sizeof(SensorEndTouchEvent), 4)
    w.sensor_end_events1 = basics.buffer_create(sizeof(SensorEndTouchEvent), 4)
    w.sensor_event_bits = basics.bitset_create(64)
    w.body_move_events = basics.buffer_create(sizeof(BodyMoveEvent), math.max_int(16, def.dynamic_body_count))
    w.contact_hit_events = basics.buffer_create(sizeof(ContactHitEvent), 4)
    w.joint_events = basics.buffer_create(sizeof(JointEvent), 4)
    w.joint_state_bits = basics.bitset_create(64)
    w.hit_event_bits = basics.bitset_create(64)
    w.awake_island_bits = basics.bitset_create(64)
    w.split_island_candidate = NULL_INDEX
    w.split_sleep_time = 0.0
    w.contact_id_pool = basics.idpool_create()
    w.contacts = basics.buffer_create(sizeof(Contact), math.max_int(16, def.contact_count))
    w.joint_id_pool = basics.idpool_create()
    w.joints = basics.buffer_create(sizeof(Joint), 16)
    w.island_id_pool = basics.idpool_create()
    w.islands = basics.buffer_create(sizeof(Island), math.max_int(16, def.dynamic_body_count))
    w.step_index = 0 as long
    w.split_island_id = NULL_INDEX
    w.gravity = def.gravity
    w.hit_event_threshold = def.hit_event_threshold
    w.restitution_threshold = def.restitution_threshold
    w.restitution_iterations = math.clamp_int(def.restitution_iterations, 0, MAX_RESTITUTION_ITERATIONS)
    w.enable_restitution_propagation = def.enable_restitution_propagation
    w.enable_kinematic_static_softness = def.enable_kinematic_static_softness
    w.max_linear_speed = def.maximum_linear_speed
    w.contact_speed = def.contact_speed
    w.contact_hertz = def.contact_hertz
    w.contact_damping_ratio = def.contact_damping_ratio
    w.contact_recycle_distance = CONTACT_RECYCLE_DISTANCE
    w.enable_sleep = def.enable_sleep
    w.locked = false
    w.enable_warm_starting = true
    w.enable_continuous = def.enable_continuous
    w.enable_speculative = true
}

// Everything the world holds is freed; ids into it die with its generation.
destroy_world(id: WorldId) {
    if world_is_valid(id) == false { return }
    w = get_world_from_id(id)
    finish_recording(w)
    free_world_contents(w)
    destroy_workers(w)
    basics.stack_destroy(&w.stack)
    generation = w.generation
    memset(w as ptr, 0, sizeof(World))
    w.generation = generation + 1
    w.in_use = false
}

// The world emptied in place, as a new world from `def` is (the
// reference's deserialize into a shell): its id, workers, callbacks,
// filters and user data stay, so ids handed out before stay this world's.
// False for a world that is not one, is mid-step or records (the
// recording could not replay what it did not see).
reset_world(id: WorldId, def: *WorldDef) -> bool {
    if world_is_valid(id) == false || valid_world_def(def) == false { return false }
    w = get_world_from_id(id)
    if w.locked || w.recording != null { return false }
    free_world_contents(w)
    init_world_contents(w, def)
    return true
}

// What init_world_contents made, freed.
free_world_contents(w: *World) {
    // The shapes' materials and names, the bodies' names, the sensors'
    // lists and the contacts' caches.
    i = 0
    while i < w.shapes.count {
        s = world_shape_at(w, i)
        if s.id != NULL_INDEX && s.materials != null {
            basics.free_bytes(s.materials, s.material_count * sizeof(SurfaceMaterial))
            s.materials = null
        }
        i = i + 1
    }
    basics.name_cache_destroy(&w.names)
    i = 0
    while i < w.sensors.count {
        sensor = sensor_at(w, i)
        basics.buffer_destroy(&sensor.hits)
        basics.buffer_destroy(&sensor.overlaps1)
        basics.buffer_destroy(&sensor.overlaps2)
        i = i + 1
    }
    basics.buffer_destroy(&w.sensors)
    basics.buffer_destroy(&w.sensor_begin_events)
    basics.buffer_destroy(&w.sensor_end_events0)
    basics.buffer_destroy(&w.sensor_end_events1)
    basics.bitset_destroy(&w.sensor_event_bits)
    basics.buffer_destroy(&w.body_move_events)
    basics.buffer_destroy(&w.contact_hit_events)
    basics.buffer_destroy(&w.joint_events)
    basics.bitset_destroy(&w.joint_state_bits)
    basics.bitset_destroy(&w.hit_event_bits)
    basics.bitset_destroy(&w.awake_island_bits)
    i = 0
    while i < w.contacts.count {
        c = contact_at(w, i)
        if c.contact_id != NULL_INDEX {
            free_manifolds(w, c)
            if (c.flags & SIM_MESH_CONTACT) != 0 { mesh_contact.mesh_contact_cache_destroy(mesh_cache_of(c)) }
        }
        i = i + 1
    }
    allocators = w.manifold_allocators.data as BlockAllocator[]
    i = 0
    while i < w.manifold_allocators.count {
        basics.block_allocator_destroy(&allocators[i])
        i = i + 1
    }
    basics.buffer_destroy(&w.manifold_allocators)
    i = 0
    while i < w.islands.count {
        island = island_at(w, i)
        if island.island_id != NULL_INDEX {
            basics.ints_destroy(&island.bodies)
            basics.buffer_destroy(&island.contacts)
            basics.buffer_destroy(&island.joints)
        }
        i = i + 1
    }
    i = 0
    while i < w.solver_sets.count {
        set = solver_set_at(w, i)
        if set.set_index != NULL_INDEX { destroy_solver_set(w, i) }
        i = i + 1
    }
    basics.buffer_destroy(&w.solver_sets)
    basics.idpool_destroy(&w.solver_set_id_pool)
    basics.buffer_destroy(&w.bodies)
    basics.idpool_destroy(&w.body_id_pool)
    basics.buffer_destroy(&w.shapes)
    basics.buffer_destroy(&w.fat_aabbs)
    // The hulls the shapes still held, owned by the world.
    i = 0
    while i < w.hull_entries.count {
        entry = hull_entry_at(w, i)
        if entry.hull != null { hull.destroy_hull(entry.hull as *HullData) }
        i = i + 1
    }
    basics.buffer_destroy(&w.hull_entries)
    basics.map_destroy(&w.hull_heads)
    w.hull_count = 0
    i = 0
    while i < w.owned_geometry.count {
        owned = (w.owned_geometry.data + i * sizeof(OwnedGeometry)) as *OwnedGeometry
        basics.free_bytes(owned.block, owned.byte_count)
        i = i + 1
    }
    basics.buffer_destroy(&w.owned_geometry)
    basics.idpool_destroy(&w.shape_id_pool)
    basics.buffer_destroy(&w.contacts)
    basics.idpool_destroy(&w.contact_id_pool)
    basics.buffer_destroy(&w.joints)
    basics.idpool_destroy(&w.joint_id_pool)
    basics.buffer_destroy(&w.islands)
    basics.idpool_destroy(&w.island_id_pool)
    broad_phase.destroy_broad_phase(&w.broad_phase)
    destroy_graph(&w.constraint_graph)
    basics.bitset_destroy(&w.contact_state)
    basics.buffer_destroy(&w.contact_begin_events)
    basics.buffer_destroy(&w.contact_end_events0)
    basics.buffer_destroy(&w.contact_end_events1)
}

world_body_count(w: *World) -> int { return basics.idpool_count(&w.body_id_pool) }
world_shape_count(w: *World) -> int { return basics.idpool_count(&w.shape_id_pool) }
world_awake_body_count(w: *World) -> int { return solver_set_at(w, AWAKE_SET).body_sims.count }
world_set_gravity(w: *World, gravity: Vec3) { w.gravity = gravity }
world_get_gravity(w: *World) -> Vec3 { return w.gravity }

// --- islands --------------------------------------------------------------------------------------------

// A new island in a set (the awake one or a sleeping one).
create_island(w: *World, set_index: int) -> *Island {
    island_id = basics.idpool_alloc(&w.island_id_pool)
    if island_id == w.islands.count {
        index = basics.buffer_push(&w.islands)
        fresh = island_at(w, index)
        fresh.island_id = NULL_INDEX
        fresh.set_index = NULL_INDEX
    }
    set = solver_set_at(w, set_index)
    island = island_at(w, island_id)
    island.set_index = set_index
    island.local_index = set.island_sims.count
    island.island_id = island_id
    island.bodies = basics.ints_create(0)
    island.contacts = basics.buffer_create(sizeof(ContactLink), 0)
    island.joints = basics.buffer_create(sizeof(JointLink), 0)
    island.constraint_remove_count = 0
    sim_index = basics.buffer_push(&set.island_sims)
    island_sim_at(set, sim_index).island_id = island_id
    return island
}

// An empty island leaves its set (the last island sim moved into its slot) and frees its id.
destroy_island(w: *World, island_id: int) {
    if w.split_island_id == island_id { w.split_island_id = NULL_INDEX }
    island = island_at(w, island_id)
    set = solver_set_at(w, island.set_index)
    local_index = island.local_index
    last_index = set.island_sims.count - 1
    moved_island_id = island_sim_at(set, last_index).island_id
    island_sim_at(set, local_index).island_id = moved_island_id
    island_at(w, moved_island_id).local_index = local_index
    set.island_sims.count = set.island_sims.count - 1
    basics.ints_destroy(&island.bodies)
    basics.buffer_destroy(&island.contacts)
    basics.buffer_destroy(&island.joints)
    island.constraint_remove_count = 0
    island.local_index = NULL_INDEX
    island.island_id = NULL_INDEX
    island.set_index = NULL_INDEX
    basics.idpool_free(&w.island_id_pool, island_id)
}

// The island's bodies point back at it, and its set holds it.
validate_island(w: *World, island_id: int) -> bool {
    island = island_at(w, island_id)
    if island.island_id != island_id { return false }
    set = solver_set_at(w, island.set_index)
    if island.local_index < 0 || island.local_index >= set.island_sims.count { return false }
    if island_sim_at(set, island.local_index).island_id != island_id { return false }
    i = 0
    while i < island.bodies.count {
        body_id = basics.ints_get(&island.bodies, i)
        body = body_at(w, body_id)
        if body.island_id != island_id || body.island_index != i { return false }
        if body.set_index != island.set_index { return false }
        i = i + 1
    }
    return true
}

create_island_for_body(w: *World, set_index: int, body: *Body) {
    island = create_island(w, set_index)
    basics.ints_push(&island.bodies, body.id)
    body.island_id = island.island_id
    body.island_index = 0
}

remove_body_from_island(w: *World, body: *Body) {
    if body.island_id == NULL_INDEX { return }
    island_id = body.island_id
    island = island_at(w, island_id)
    local_index = body.island_index
    moved_body_id = basics.ints_get(&island.bodies, island.bodies.count - 1)
    basics.ints_set(&island.bodies, local_index, moved_body_id)
    body_at(w, moved_body_id).island_index = local_index
    island.bodies.count = island.bodies.count - 1
    if island.bodies.count == 0 { destroy_island(w, island.island_id) }
    body.island_id = NULL_INDEX
    body.island_index = NULL_INDEX
}

// --- bodies -------------------------------------------------------------------------------------------------

body_is_valid(id: BodyId) -> bool {
    if id.world0 < 0 || id.world0 >= MAX_WORLDS { return false }
    worlds_ready()
    w = world_at(id.world0)
    if w.in_use == false { return false }
    if id.index1 < 1 || id.index1 > w.bodies.count { return false }
    body = body_at(w, id.index1 - 1)
    if body.set_index == NULL_INDEX { return false }
    return body.generation == id.generation
}

get_body_full_id(w: *World, id: BodyId) -> *Body { return body_at(w, id.index1 - 1) }
get_body(w: *World, body_id: int) -> *Body { return body_at(w, body_id) }
get_body_sim(w: *World, body: *Body) -> *BodySim { return body_sim_at(solver_set_at(w, body.set_index), body.local_index) }

// A body's sim as a contact keeps it (b3EncodeBodySimIndex): its index for
// an awake body, -(index + 2) for a static one, NULL_INDEX for any other
// (asleep or disabled), whose sim is found through the body.
encode_body_sim_index(body: *Body) -> int {
    if body.set_index == AWAKE_SET { return body.local_index }
    if body.set_index == STATIC_SET { return 0 - (body.local_index + 2) }
    return NULL_INDEX
}
is_static_sim_index(encoded: int) -> bool { return encoded < NULL_INDEX }
// The awake index, or NULL_INDEX for a static or sleeping body.
decode_awake_index(encoded: int) -> int {
    if encoded >= 0 { return encoded }
    return NULL_INDEX
}
// What an encoding becomes when its body falls asleep: a static body's stays.
sleep_body_sim_index(encoded: int) -> int {
    if encoded >= 0 { return NULL_INDEX }
    return encoded
}

// A contact's body sim from its encoding, through the body when the body
// is neither awake nor static (b3ResolveContactBodySim).
resolve_contact_body_sim(w: *World, awake_sims: ptr, static_sims: ptr, encoded: int, body_id: int) -> *BodySim {
    if encoded >= 0 { return (awake_sims + encoded * sizeof(BodySim)) as *BodySim }
    if encoded < NULL_INDEX { return (static_sims + (0 - encoded - 2) * sizeof(BodySim)) as *BodySim }
    return get_body_sim(w, body_at(w, body_id))
}

// Every contact of a body given the body's encoding again, after its sim
// moved (b3RefreshBodyContactIndices).
refresh_body_contact_indices(w: *World, body: *Body) {
    encoded = encode_body_sim_index(body)
    key = body.head_contact_key
    while key != NULL_INDEX {
        c = contact_at(w, key >> 1)
        if (key & 1) == 0 { c.encoded_body_sim_a = encoded } else { c.encoded_body_sim_b = encoded }
        key = contact_edge_next(w, key)
    }
}

// The state exists for the awake set only; null otherwise.
get_body_state(w: *World, body: *Body) -> *BodyState {
    if body.set_index == AWAKE_SET { return body_state_at(solver_set_at(w, AWAKE_SET), body.local_index) }
    return null
}

get_body_transform(w: *World, body_id: int) -> Transform { return get_body_sim(w, body_at(w, body_id)).transform }

// The reference's b3HashWorldState: every live body's pose and, awake, its
// velocities, folded as their bits by 64-bit FNV-1a in body order. Two runs
// alike to the bit hash alike (worker parity, replay). The pose is held in
// double here, so its bits are the double's, as the reference's large world
// build mixes its positions. Aether's integers wrap (the language
// reference), so the multiply is the FNV's own.
hash_world_state(w: *World) -> long {
    // 14695981039346656037 and 1099511628211, the FNV-1a basis and prime.
    hash = 0 - 3750763034362895579
    prime = 1099511628211 as long
    i = 0
    while i < w.bodies.count {
        body = body_at(w, i)
        if body.id == i {
            xf = get_body_sim(w, body).transform
            hash = (hash ^ native.f64_bits(xf.p.x)) * prime
            hash = (hash ^ native.f64_bits(xf.p.y)) * prime
            hash = (hash ^ native.f64_bits(xf.p.z)) * prime
            hash = (hash ^ native.f64_bits(xf.q.x)) * prime
            hash = (hash ^ native.f64_bits(xf.q.y)) * prime
            hash = (hash ^ native.f64_bits(xf.q.z)) * prime
            hash = (hash ^ native.f64_bits(xf.q.w)) * prime
            state = get_body_state(w, body)
            if state != null {
                hash = (hash ^ native.f32_bits(state.v.x)) * prime
                hash = (hash ^ native.f32_bits(state.v.y)) * prime
                hash = (hash ^ native.f32_bits(state.v.z)) * prime
                hash = (hash ^ native.f32_bits(state.w.x)) * prime
                hash = (hash ^ native.f32_bits(state.w.y)) * prime
                hash = (hash ^ native.f32_bits(state.w.z)) * prime
            }
        }
        i = i + 1
    }
    return hash
}
make_body_id(w: *World, body_id: int) -> BodyId { return BodyId { index1: body_id + 1, world0: w.world_id, generation: body_at(w, body_id).generation } }

// The body's flags onto its sim and state, never the transient ones,
// keeping the flags only the sim holds: fast, which the next collide
// pass reads to keep a fast pair off recycling, and had a time of impact.
sync_body_flags(w: *World, body: *Body) {
    flags = body.flags & (0 - 1 - BODY_TRANSIENT_FLAGS)
    sim = get_body_sim(w, body)
    sim.flags = (sim.flags & (IS_FAST | HAD_TIME_OF_IMPACT)) | flags
    state = get_body_state(w, body)
    if state != null { state.flags = flags }
}

// A body in the set its definition puts it in: disabled, static, awake,
// or asleep in a set of its own; dynamic and kinematic bodies get an island.
// --- the inputs a world takes -------------------------------------------------
//
// The reference asserts every number that enters a world (b3IsValidVec3,
// b3IsValidFloat, b3IsValidQuat, non-negative where it must be), so a NaN
// or an infinity is caught where it comes in, not after it has spread
// through the solver to every body it touches. Asserts are compiled out
// of a release build; here such an input is refused instead: a creator
// returns its null id, a setter leaves what it would have changed.

// A finite number at or above zero.
valid_nonnegative(x: float) -> bool { return math.is_valid_float(x) && x >= 0.0 }

// A surface material the solver can use: finite, with friction,
// restitution and rolling resistance not below zero.
valid_material(m: SurfaceMaterial) -> bool { return material.is_valid_material(m) }

valid_body_def(def: *BodyDef) -> bool {
    if math.is_valid_position(def.position) == false || math.is_valid_quat(def.rotation) == false { return false }
    if math.is_valid_vec3(def.linear_velocity) == false || math.is_valid_vec3(def.angular_velocity) == false { return false }
    if valid_nonnegative(def.linear_damping) == false || valid_nonnegative(def.angular_damping) == false { return false }
    if valid_nonnegative(def.sleep_threshold) == false || valid_nonnegative(def.safety_factor) == false { return false }
    return math.is_valid_float(def.gravity_scale)
}

create_body(world_id: WorldId, def: *BodyDef) -> BodyId {
    if recording_on(world_id.index1 - 1) == false { return create_body_internal(world_id, def) }
    recorder = rec_begin(world_id.index1 - 1, OP_CREATE_BODY)
    rec_body_def(recorder, def)
    made = create_body_internal(world_id, def)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_body's work, unrecorded.
create_body_internal(world_id: WorldId, def: *BodyDef) -> BodyId {
    if world_is_valid(world_id) == false { return null_body_id() }
    if valid_body_def(def) == false { return null_body_id() }
    w = get_world_from_id(world_id)
    if w.locked { return null_body_id() }
    w.locked = true
    is_awake = (def.is_awake || def.enable_sleep == false) && def.is_enabled
    set_id = 0
    if def.is_enabled == false { set_id = DISABLED_SET }
    else if def.kind == BODY_STATIC { set_id = STATIC_SET }
    else if is_awake { set_id = AWAKE_SET }
    else { set_id = create_solver_set(w) }

    body_id = basics.idpool_alloc(&w.body_id_pool)
    lock_flags = 0
    if def.motion_locks.linear_x { lock_flags = lock_flags | LOCK_LINEAR_X }
    if def.motion_locks.linear_y { lock_flags = lock_flags | LOCK_LINEAR_Y }
    if def.motion_locks.linear_z { lock_flags = lock_flags | LOCK_LINEAR_Z }
    if def.motion_locks.angular_x { lock_flags = lock_flags | LOCK_ANGULAR_X }
    if def.motion_locks.angular_y { lock_flags = lock_flags | LOCK_ANGULAR_Y }
    if def.motion_locks.angular_z { lock_flags = lock_flags | LOCK_ANGULAR_Z }

    set = solver_set_at(w, set_id)
    sim_index = basics.buffer_push(&set.body_sims)
    sim = body_sim_at(set, sim_index)
    sim.transform = Transform { p: def.position, q: def.rotation }
    sim.center = def.position
    sim.rotation0 = math.narrow_quat(def.rotation)
    sim.center0 = def.position
    sim.local_center = math.narrow3(math.vec3_zero())
    sim.force = math.narrow3(math.vec3_zero())
    sim.torque = math.narrow3(math.vec3_zero())
    sim.inv_mass = 0.0
    sim.inv_inertia_local = math.narrow_mat3(math.mat3_zero())
    sim.inv_inertia_world = math.narrow_mat3(math.mat3_zero())
    sim.min_extent = math.HUGE
    sim.max_extent = math.narrow3(math.vec3_zero())
    sim.linear_damping = def.linear_damping
    sim.angular_damping = def.angular_damping
    sim.gravity_scale = def.gravity_scale
    sim.body_id = body_id
    flags = lock_flags
    if def.is_bullet { flags = flags | IS_BULLET }
    if def.allow_fast_rotation { flags = flags | ALLOW_FAST_ROTATION }
    if def.kind == BODY_DYNAMIC { flags = flags | DYNAMIC_FLAG }
    if def.enable_sleep { flags = flags | ENABLE_SLEEP }
    if def.enable_contact_recycling { flags = flags | ENABLE_CONTACT_RECYCLING }
    sim.flags = flags
    if set_id == AWAKE_SET {
        state_index = basics.buffer_push(&set.body_states)
        state = body_state_at(set, state_index)
        state.v = math.narrow3(def.linear_velocity)
        state.w = math.narrow3(def.angular_velocity)
        state.dp = math.vec3f_zero()
        state.dq = math.quatf_identity()
        state.flags = flags
    }

    if body_id == w.bodies.count {
        index = basics.buffer_push(&w.bodies)
        fresh = body_at(w, index)
        fresh.generation = 0
    }
    body = body_at(w, body_id)
    body.user_data = def.user_data
    body.set_index = set_id
    body.local_index = set.body_sims.count - 1
    body.generation = body.generation + 1
    body.head_shape_id = NULL_INDEX
    body.shape_count = 0
    body.head_contact_key = NULL_INDEX
    body.contact_count = 0
    body.head_joint_key = NULL_INDEX
    body.joint_count = 0
    body.island_id = NULL_INDEX
    body.island_index = NULL_INDEX
    body.body_move_index = NULL_INDEX
    body.id = body_id
    body.sleep_threshold = def.sleep_threshold
    body.sleep_time = 0.0
    body.sleep_velocity = 0.0
    body.safety_factor = def.safety_factor
    body.mass = 0.0
    body.inertia = math.mat3_zero()
    body.kind = def.kind
    body.flags = flags
    body.name_id = basics.name_cache_add(&w.names, def.name)
    if set_id >= AWAKE_SET { create_island_for_body(w, set_id, body) }
    w.locked = false
    return BodyId { index1: body_id + 1, world0: w.world_id, generation: body.generation }
}

is_body_awake(w: *World, body: *Body) -> bool { return body.set_index == AWAKE_SET }

// A sleeping body's whole set wakes.
wake_body(w: *World, body: *Body) -> bool {
    if body.set_index >= FIRST_SLEEPING_SET {
        wake_solver_set(w, body.set_index)
        return true
    }
    return false
}

// The body's joints and contacts, its shapes (their sensors and
// proxies), its island, its sim and state, then its id (the generation stays).
destroy_body(id: BodyId) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_DESTROY_BODY); rec_id(recorder, id.index1, id.generation); rec_end(recorder) }
    if body_is_valid(id) == false { return }
    w = world_at(id.world0)
    if w.locked { return }
    w.locked = true
    body = body_at(w, id.index1 - 1)
    // Bodies attached through joints or contacts wake, even when this one is static.
    key = body.head_joint_key
    while key != NULL_INDEX {
        j = joint_at(w, key >> 1)
        key = joint_edge_next(w, key)
        destroy_joint_internal(w, j, true)
    }
    destroy_body_contacts(w, body, true)
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        if s.geometry.kind == KIND_COMPOUND { w.compound_shape_count = w.compound_shape_count - 1 }
        if s.geometry.kind == KIND_HULL { remove_hull_from_database(w, s.geometry.hull) }
        if s.sensor_index != NULL_INDEX { destroy_sensor(w, s) }
        if s.proxy_key != NULL_INDEX {
            broad_phase.broad_phase_destroy_proxy(&w.broad_phase, s.proxy_key)
            s.proxy_key = NULL_INDEX
        }
        if s.materials != null {
            basics.free_bytes(s.materials, s.material_count * sizeof(SurfaceMaterial))
            s.materials = null
            s.material_count = 0
        }
        s.name_id = basics.NULL_NAME
        basics.idpool_free(&w.shape_id_pool, shape_id)
        set_shape_fat_aabb(w, shape_id, AABBf { lower: math.vec3f_zero(), upper: math.vec3f_zero() })
        s.id = NULL_INDEX
        shape_id = s.next_shape_id
    }
    body.name_id = basics.NULL_NAME
    remove_body_from_island(w, body)
    set = solver_set_at(w, body.set_index)
    moved_index = basics.buffer_remove_swap(&set.body_sims, body.local_index)
    if moved_index != NULL_INDEX && moved_index != body.local_index {
        moved_sim = body_sim_at(set, body.local_index)
        moved_body = body_at(w, moved_sim.body_id)
        moved_body.local_index = body.local_index
        refresh_body_contact_indices(w, moved_body)
    }
    if body.set_index == AWAKE_SET {
        basics.buffer_remove_swap(&set.body_states, body.local_index)
    } else if set.set_index >= FIRST_SLEEPING_SET && set.body_sims.count == 0 {
        destroy_solver_set(w, set.set_index)
    }
    basics.idpool_free(&w.body_id_pool, body.id)
    body.set_index = NULL_INDEX
    body.local_index = NULL_INDEX
    body.id = NULL_INDEX
    w.locked = false
}

// --- shapes -------------------------------------------------------------------------------------------------

// The margin a shape's fat bounds get: a fraction of its size, capped.
compute_shape_margin(g: *Shape) -> float {
    margin = 0.0
    kind = g.kind
    if kind == KIND_SPHERE { margin = g.sphere.radius }
    else if kind == KIND_CAPSULE { margin = 0.5 * math.distance(g.capsule.center2, g.capsule.center1) + g.capsule.radius }
    else if kind == KIND_HULL {
        points = hull.hull_points(g.hull)
        max_extent_sqr = 0.0
        i = 0
        while i < g.hull.vertex_count {
            max_extent_sqr = math.max_float(max_extent_sqr, math.distance_squared(points[i], g.hull.center))
            i = i + 1
        }
        margin = sqrt(max_extent_sqr)
    } else {
        // Static-only shapes: the broad phase uses the speculative distance for static proxies.
        return MAX_AABB_MARGIN
    }
    return math.min_float(MAX_AABB_MARGIN, AABB_MARGIN_FRACTION * margin)
}

// The shape's bounds with the speculative margin, and the fat bounds the
// broad phase holds (a static body's grow only by the speculative distance).
update_shape_aabbs(w: *World, s: *WorldShape, t: Transform, proxy_kind: int) {
    box = shape.compute_fat_shape_aabb(&s.geometry, t, SPECULATIVE_DISTANCE)
    s.aabb = box
    margin = s.aabb_margin
    if proxy_kind == BODY_STATIC { margin = SPECULATIVE_DISTANCE }
    set_shape_fat_aabb(w, s.id, math.aabb_round_out(AABB { lower: math.sub(box.lower, math.vec3(margin, margin, margin)), upper: math.add(box.upper, math.vec3(margin, margin, margin)) }))
}

create_shape_proxy(w: *World, s: *WorldShape, kind: int, t: Transform, force_pair_creation: bool) {
    update_shape_aabbs(w, s, t, kind)
    s.proxy_key = broad_phase.broad_phase_create_proxy(&w.broad_phase, kind, shape_fat_aabb(w, s.id), s.filter.category_bits, s.id, force_pair_creation)
}

// A shape on a body: its slot, its geometry, its materials, its proxy in
// the broad phase (unless the body is disabled), its place in the body's
// list, and the body's mass updated or marked dirty.
// A shape definition's numbers: the density not below zero, every material usable.
valid_shape_def(def: *ShapeDef) -> bool {
    if valid_nonnegative(def.density) == false || math.is_valid_float(def.explosion_scale) == false { return false }
    if valid_material(def.base_material) == false { return false }
    if def.materials != null {
        materials = def.materials as SurfaceMaterial[]
        i = 0
        while i < def.material_count {
            if valid_material(materials[i]) == false { return false }
            i = i + 1
        }
    }
    return true
}

create_shape(body_id: BodyId, def: *ShapeDef, geometry: Shape) -> ShapeId {
    if body_is_valid(body_id) == false { return null_shape_id() }
    w = world_at(body_id.world0)
    if w.locked { return null_shape_id() }
    body = body_at(w, body_id.index1 - 1)
    kind = geometry.kind
    // Compounds and height fields go on static bodies only.
    if body.kind != BODY_STATIC && (kind == KIND_COMPOUND || kind == KIND_HEIGHT_FIELD) { return null_shape_id() }
    if kind == KIND_COMPOUND && def.is_sensor { return null_shape_id() }
    if valid_shape_def(def) == false { return null_shape_id() }
    w.locked = true
    shape_id = basics.idpool_alloc(&w.shape_id_pool)
    if shape_id == w.shapes.count {
        index = basics.buffer_push(&w.shapes)
        fresh = world_shape_at(w, index)
        fresh.generation = 0
        basics.buffer_push(&w.fat_aabbs)
    }
    s = world_shape_at(w, shape_id)
    s.geometry = geometry
    s.geometry.density = def.density
    s.id = shape_id
    s.body_id = body.id
    s.explosion_scale = def.explosion_scale
    s.filter = def.filter
    s.user_data = def.user_data
    flags = 0
    if def.enable_sensor_events { flags = flags | SHAPE_ENABLE_SENSOR_EVENTS }
    if def.enable_contact_events { flags = flags | SHAPE_ENABLE_CONTACT_EVENTS }
    if def.enable_custom_filtering { flags = flags | SHAPE_ENABLE_CUSTOM_FILTERING }
    if def.enable_hit_events { flags = flags | SHAPE_ENABLE_HIT_EVENTS }
    if def.enable_pre_solve_events { flags = flags | SHAPE_ENABLE_PRE_SOLVE_EVENTS }
    if def.enable_speculative_contact { flags = flags | SHAPE_ENABLE_SPECULATIVE }
    s.flags = flags
    s.proxy_key = NULL_INDEX
    s.local_centroid = shape.get_shape_centroid(&s.geometry)
    s.aabb_margin = compute_shape_margin(&s.geometry)
    s.aabb = AABB { lower: math.vec3_zero(), upper: math.vec3_zero() }
    set_shape_fat_aabb(w, shape_id, math.aabb_round_out(s.aabb))
    s.generation = s.generation + 1
    s.sensor_index = NULL_INDEX
    s.name_id = basics.name_cache_add(&w.names, def.name)
    if kind == KIND_COMPOUND {
        w.compound_shape_count = w.compound_shape_count + 1
        // A copy of the compound's materials, so every shape frees its array the same way.
        count = s.geometry.compound.material_count
        s.material_count = count
        s.materials = basics.alloc(count * sizeof(SurfaceMaterial))
        memcpy(s.materials, (s.geometry.compound as ptr) + s.geometry.compound.material_offset, count * sizeof(SurfaceMaterial))
        s.material = compound.get_compound_material(s.geometry.compound, 0)
    } else if def.material_count > 1 && def.materials != null {
        s.material_count = def.material_count
        s.materials = basics.alloc(def.material_count * sizeof(SurfaceMaterial))
        memcpy(s.materials, def.materials, def.material_count * sizeof(SurfaceMaterial))
        given = def.materials as SurfaceMaterial[]
        s.material = given[0]
    } else {
        s.material = def.base_material
        if def.material_count == 1 && def.materials != null {
            given = def.materials as SurfaceMaterial[]
            s.material = given[0]
        }
        s.material_count = 1
        s.materials = null
    }
    s.geometry.material_count = s.material_count
    if body.set_index != DISABLED_SET {
        force = def.invoke_contact_creation && kind != KIND_COMPOUND
        create_shape_proxy(w, s, body.kind, get_body_sim(w, body).transform, force)
    }
    if body.head_shape_id != NULL_INDEX { world_shape_at(w, body.head_shape_id).prev_shape_id = shape_id }
    s.prev_shape_id = NULL_INDEX
    s.next_shape_id = body.head_shape_id
    body.head_shape_id = shape_id
    body.shape_count = body.shape_count + 1
    if def.is_sensor { create_sensor(w, s) }

    if def.update_body_mass {
        update_body_mass_data(w, body)
    } else if (body.flags & DIRTY_MASS) == 0 {
        body.flags = body.flags | DIRTY_MASS
        sync_body_flags(w, body)
    }
    w.locked = false
    return ShapeId { index1: shape_id + 1, world0: w.world_id, generation: s.generation }
}

// A sphere or capsule the narrow phase can use: finite centres, a finite
// radius not below zero.
valid_sphere(s: Sphere) -> bool { return math.is_valid_vec3(s.center) && valid_nonnegative(s.radius) }
valid_capsule(c: Capsule) -> bool { return math.is_valid_vec3(c.center1) && math.is_valid_vec3(c.center2) && valid_nonnegative(c.radius) }

create_sphere_shape(body_id: BodyId, def: *ShapeDef, s: Sphere) -> ShapeId {
    if recording_on(body_id.world0) == false { return create_sphere_shape_internal(body_id, def, s) }
    recorder = rec_begin(body_id.world0, OP_CREATE_SPHERE_SHAPE)
    rec_id(recorder, body_id.index1, body_id.generation)
    rec_shape_def(recorder, def)
    rec_sphere_value(recorder, s)
    made = create_sphere_shape_internal(body_id, def, s)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_sphere_shape's work, unrecorded.
create_sphere_shape_internal(body_id: BodyId, def: *ShapeDef, s: Sphere) -> ShapeId {
    if valid_sphere(s) == false { return null_shape_id() }
    return create_shape(body_id, def, shape.sphere_shape(s, def.density))
}

// A capsule whose centres are within the linear slop is made a sphere at
// their midpoint, as the reference's b3CreateCapsuleShape does: its segment
// has no direction to collide along.
create_capsule_shape(body_id: BodyId, def: *ShapeDef, c: Capsule) -> ShapeId {
    if recording_on(body_id.world0) == false { return create_capsule_shape_internal(body_id, def, c) }
    recorder = rec_begin(body_id.world0, OP_CREATE_CAPSULE_SHAPE)
    rec_id(recorder, body_id.index1, body_id.generation)
    rec_shape_def(recorder, def)
    rec_capsule_value(recorder, c)
    made = create_capsule_shape_internal(body_id, def, c)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_capsule_shape's work, unrecorded.
create_capsule_shape_internal(body_id: BodyId, def: *ShapeDef, c: Capsule) -> ShapeId {
    if valid_capsule(c) == false { return null_shape_id() }
    if math.distance_squared(c.center1, c.center2) <= math.LINEAR_SLOP * math.LINEAR_SLOP {
        middle = math.lerp(c.center1, c.center2, 0.5)
        return create_shape(body_id, def, shape.sphere_shape(Sphere { center: middle, radius: c.radius }, def.density))
    }
    return create_shape(body_id, def, shape.capsule_shape(c, def.density))
}

// --- recording (#149) ---------------------------------------------------------------------------

// The bytes a world writes while it records (aephysics.recording starts and
// stops it): every call that changes the world, as its opcode, the length
// of its arguments and the arguments field by field (never a struct's
// bytes, which carry pointers and the language's own bookkeeping), a state
// hash after every step, and at the end the geometry the calls named by
// id. The recording starts with a snapshot of the world, so a player
// begins where the recording did.
struct Recording {
    data: ptr
    size: int
    capacity: int
    record_start: int
    geometry: Buffer           // RecordedGeometry: the blocks the calls name, each once
    geometry_heads: LongMap    // a content hash to the first entry of that hash
    bounds: AABB               // every step's world bounds, joined
    have_bounds: bool
    owner: int                 // the recording world's index1 while it records, else 0
    lock: int                  // taken while a record goes in (rec_lock)
    tags: Buffer               // RecordedTag: the tagged queries' callers, each key once
    tag_heads: LongMap         // a tag's key to its entry
}

// One geometry block the calls named: the recording's own pointer-free
// copy, found again by its content (the hash, then every byte).
struct RecordedGeometry {
    hash: long
    kind: int
    byte_count: int
    block: ptr
    next: int
}

// The recording's file header, before the snapshot: a new major version
// is one older players cannot read; a new minor version only adds records,
// which older players skip.
const RECORDING_MAGIC = 0x43525041    // "APRC", little-endian
const RECORDING_MAJOR_VERSION = 1
const RECORDING_MINOR_VERSION = 1
const RECORDING_HEADER_BYTES = 32

const OP_STATE_HASH = 2
const OP_BOUNDS = 3
const OP_END = 4
