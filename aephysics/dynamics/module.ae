    shape_enable_sensor_events, shape_are_sensor_events_enabled, shape_get_sensor_capacity, shape_get_sensor_data,
    shape_get_contact_capacity, add_sensor_hit, overlap_sensors, validate_joints,
    BodyMoveEvent, ContactHitEvent, JointEvent, SensorHit, TIME_TO_SLEEP,
    world_body_move_event_count, world_body_move_event, world_contact_hit_event_count, world_contact_hit_event,
