// --- the hull database (the reference's hullDatabase, #147) -------------------------

// One entry of the world's hull database: an owned copy of a hull its
// shapes use and how many shapes hold it. Equal hulls (every byte; the
// hash only finds the candidates) share one entry, so shapes made from
// the same hull, or from one built again, hold one copy, and a caller's
// hull may be freed as soon as its shape is made.
struct HullEntry {
    hull: ptr        // *HullData, the world's; null when the entry is free
    hash: long
    ref_count: int
    next: int        // the next entry of the same hash, or the next free entry
}

hull_entry_at(w: *World, index: int) -> *HullEntry { return (w.hull_entries.data + index * sizeof(HullEntry)) as *HullEntry }

// The entry holding a hull equal to `h`, or NULL_INDEX.
find_hull_entry(w: *World, h: *HullData) -> int {
    index = basics.map_get(&w.hull_heads, h.hash, NULL_INDEX)
    while index != NULL_INDEX {
        entry = hull_entry_at(w, index)
        if hull.compare_hull_data(entry.hull as *HullData, h) { return index }
        index = entry.next
    }
    return NULL_INDEX
}

// A new entry for `owned` at the head of its hash's chain, held once.
insert_hull_entry(w: *World, owned: *HullData) -> *HullData {
    index = w.hull_free
    if index != NULL_INDEX {
        w.hull_free = hull_entry_at(w, index).next
    } else {
        index = basics.buffer_push(&w.hull_entries)
    }
    entry = hull_entry_at(w, index)
    entry.hull = owned as ptr
    entry.hash = owned.hash
    entry.ref_count = 1
    entry.next = basics.map_get(&w.hull_heads, owned.hash, NULL_INDEX)
    basics.map_set(&w.hull_heads, owned.hash, index)
    w.hull_count = w.hull_count + 1
    return owned
}

// The world's copy of `h`, held once more: the existing one when an equal
// hull is held, else a clone (b3AddHullToDatabase). Null when `h` is not
// a valid hull.
add_hull_to_database(w: *World, h: *HullData) -> *HullData {
    found = find_hull_entry(w, h)
    if found != NULL_INDEX {
        entry = hull_entry_at(w, found)
        entry.ref_count = entry.ref_count + 1
        return entry.hull as *HullData
    }
    clone = hull.clone_hull(h)
    if clone == null { return null }
    return insert_hull_entry(w, clone)
}

// As add_hull_to_database for a hull the world takes over: freed at once
// when an equal one is already held (b3AddOwnedHullToDatabase).
add_owned_hull_to_database(w: *World, owned: *HullData) -> *HullData {
    found = find_hull_entry(w, owned)
    if found != NULL_INDEX {
        entry = hull_entry_at(w, found)
        entry.ref_count = entry.ref_count + 1
        hull.destroy_hull(owned)
        return entry.hull as *HullData
    }
    return insert_hull_entry(w, owned)
}

// One hold of the world's copy given up; the copy is freed with its last
// (b3RemoveHullFromDatabase). `h` is the world's copy itself.
remove_hull_from_database(w: *World, h: *HullData) {
    previous = NULL_INDEX
    index = basics.map_get(&w.hull_heads, h.hash, NULL_INDEX)
    while index != NULL_INDEX {
        entry = hull_entry_at(w, index)
        if entry.hull == (h as ptr) {
            entry.ref_count = entry.ref_count - 1
            if entry.ref_count > 0 { return }
            if previous == NULL_INDEX {
                if entry.next == NULL_INDEX { basics.map_remove(&w.hull_heads, entry.hash) }
                else { basics.map_set(&w.hull_heads, entry.hash, entry.next) }
            } else {
                hull_entry_at(w, previous).next = entry.next
            }
            hull.destroy_hull(h)
            entry.hull = null
            entry.hash = 0 as long
            entry.next = w.hull_free
            w.hull_free = index
            w.hull_count = w.hull_count - 1
            return
        }
        previous = index
        index = entry.next
    }
}

// A block of geometry (a mesh's, a height field's, a compound's) the world
// owns: the copies a loaded snapshot's shapes point at, freed with the world.
struct OwnedGeometry {
    block: ptr
    byte_count: int
}

adopt_geometry(w: *World, block: ptr, byte_count: int) {
    index = basics.buffer_push(&w.owned_geometry)
    owned = (w.owned_geometry.data + index * sizeof(OwnedGeometry)) as *OwnedGeometry
    owned.block = block
    owned.byte_count = byte_count
}

// The distinct hulls a world holds for its shapes.
world_hull_count(world_id: WorldId) -> int {
    if world_is_valid(world_id) == false { return 0 }
    return get_world_from_id(world_id).hull_count
}

// The baked shapes are refused when they are missing or of another
// layout's version, as the reference refuses them. A hull shape holds the
// world's copy of its hull (the hull database), never the caller's: the
// caller may free its hull once the shape is made.
create_hull_shape(body_id: BodyId, def: *ShapeDef, h: *HullData) -> ShapeId {
    if recording_on(body_id.world0) == false { return create_hull_shape_internal(body_id, def, h) }
    recorder = rec_begin(body_id.world0, OP_CREATE_HULL_SHAPE)
    rec_id(recorder, body_id.index1, body_id.generation)
    rec_shape_def(recorder, def)
    rec_geometry(recorder, shape.SHAPE_HULL, h as ptr)
    made = create_hull_shape_internal(body_id, def, h)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_hull_shape's work, unrecorded.
create_hull_shape_internal(body_id: BodyId, def: *ShapeDef, h: *HullData) -> ShapeId {
    if h == null || h.version != hull.HULL_VERSION { return null_shape_id() }
    if body_is_valid(body_id) == false { return null_shape_id() }
    w = world_at(body_id.world0)
    if w.locked { return null_shape_id() }
    shared = add_hull_to_database(w, h)
    if shared == null { return null_shape_id() }
    id = create_shape(body_id, def, shape.hull_shape(shared, def.density))
    if id.index1 == 0 { remove_hull_from_database(w, shared) }
    return id
}

// A hull scaled (non-uniformly, or mirrored) then moved by `transform`,
// baked into the world's own copy and shared like any other
// (b3CreateTransformedHullShape). Refused when the result has no volume.
create_transformed_hull_shape(body_id: BodyId, def: *ShapeDef, h: *HullData, transform: Transform, scale: Vec3) -> ShapeId {
    if recording_on(body_id.world0) == false { return create_transformed_hull_shape_internal(body_id, def, h, transform, scale) }
    recorder = rec_begin(body_id.world0, OP_CREATE_TRANSFORMED_HULL_SHAPE)
    rec_id(recorder, body_id.index1, body_id.generation)
    rec_shape_def(recorder, def)
    rec_geometry(recorder, shape.SHAPE_HULL, h as ptr)
    rec_transform(recorder, transform)
    rec_vec3(recorder, scale)
    made = create_transformed_hull_shape_internal(body_id, def, h, transform, scale)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_transformed_hull_shape's work, unrecorded.
create_transformed_hull_shape_internal(body_id: BodyId, def: *ShapeDef, h: *HullData, transform: Transform, scale: Vec3) -> ShapeId {
    if h == null || h.version != hull.HULL_VERSION { return null_shape_id() }
    if math.is_valid_transform(transform) == false || math.is_valid_vec3(scale) == false { return null_shape_id() }
    if body_is_valid(body_id) == false { return null_shape_id() }
    w = world_at(body_id.world0)
    if w.locked { return null_shape_id() }
    baked = hull.clone_and_transform_hull(h, transform, scale)
    if baked == null { return null_shape_id() }
    shared = add_owned_hull_to_database(w, baked)
    id = create_shape(body_id, def, shape.hull_shape(shared, def.density))
    if id.index1 == 0 { remove_hull_from_database(w, shared) }
    return id
}
create_mesh_shape(body_id: BodyId, def: *ShapeDef, m: *MeshData, scale: Vec3) -> ShapeId {
    if recording_on(body_id.world0) == false { return create_mesh_shape_internal(body_id, def, m, scale) }
    recorder = rec_begin(body_id.world0, OP_CREATE_MESH_SHAPE)
    rec_id(recorder, body_id.index1, body_id.generation)
    rec_shape_def(recorder, def)
    rec_geometry(recorder, shape.SHAPE_MESH, m as ptr)
    rec_vec3(recorder, scale)
    made = create_mesh_shape_internal(body_id, def, m, scale)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_mesh_shape's work, unrecorded.
create_mesh_shape_internal(body_id: BodyId, def: *ShapeDef, m: *MeshData, scale: Vec3) -> ShapeId {
    if m == null || m.version != mesh.MESH_VERSION || math.is_valid_vec3(scale) == false { return null_shape_id() }
    return create_shape(body_id, def, shape.mesh_shape(mesh.mesh(m, math.safe_scale(scale)), math.max_int(def.material_count, 1)))
}
create_height_field_shape(body_id: BodyId, def: *ShapeDef, h: *HeightFieldData) -> ShapeId {
    if recording_on(body_id.world0) == false { return create_height_field_shape_internal(body_id, def, h) }
    recorder = rec_begin(body_id.world0, OP_CREATE_HEIGHT_FIELD_SHAPE)
    rec_id(recorder, body_id.index1, body_id.generation)
    rec_shape_def(recorder, def)
    rec_geometry(recorder, shape.SHAPE_HEIGHT_FIELD, h as ptr)
    made = create_height_field_shape_internal(body_id, def, h)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_height_field_shape's work, unrecorded.
create_height_field_shape_internal(body_id: BodyId, def: *ShapeDef, h: *HeightFieldData) -> ShapeId {
    if h == null || h.version != height_field.HEIGHT_FIELD_VERSION { return null_shape_id() }
    return create_shape(body_id, def, shape.height_field_shape(h, math.max_int(def.material_count, 1)))
}
create_compound_shape(body_id: BodyId, def: *ShapeDef, c: *CompoundData) -> ShapeId {
    if recording_on(body_id.world0) == false { return create_compound_shape_internal(body_id, def, c) }
    recorder = rec_begin(body_id.world0, OP_CREATE_COMPOUND_SHAPE)
    rec_id(recorder, body_id.index1, body_id.generation)
    rec_shape_def(recorder, def)
    rec_geometry(recorder, shape.SHAPE_COMPOUND, c as ptr)
    made = create_compound_shape_internal(body_id, def, c)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_compound_shape's work, unrecorded.
create_compound_shape_internal(body_id: BodyId, def: *ShapeDef, c: *CompoundData) -> ShapeId {
    if c == null || c.version != compound.COMPOUND_VERSION { return null_shape_id() }
    return create_shape(body_id, def, shape.compound_shape(c))
}

shape_is_valid(id: ShapeId) -> bool {
    if id.world0 < 0 || id.world0 >= MAX_WORLDS { return false }
    worlds_ready()
    w = world_at(id.world0)
    if w.in_use == false { return false }
    if id.index1 < 1 || id.index1 > w.shapes.count { return false }
    s = world_shape_at(w, id.index1 - 1)
    if s.id == NULL_INDEX { return false }
    return s.generation == id.generation
}

get_shape_full_id(w: *World, id: ShapeId) -> *WorldShape { return world_shape_at(w, id.index1 - 1) }
get_shape(w: *World, shape_id: int) -> *WorldShape { return world_shape_at(w, shape_id) }

// The shape leaves its body's list and the broad phase; the body's mass
// is updated when asked.
destroy_shape(id: ShapeId, update_body_mass: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_DESTROY_SHAPE); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, update_body_mass); rec_end(recorder) }
    if shape_is_valid(id) == false { return }
    w = world_at(id.world0)
    if w.locked { return }
    w.locked = true
    s = world_shape_at(w, id.index1 - 1)
    body = body_at(w, s.body_id)
    destroy_shape_contacts(w, s, true)
    if s.prev_shape_id != NULL_INDEX { world_shape_at(w, s.prev_shape_id).next_shape_id = s.next_shape_id }
    if s.next_shape_id != NULL_INDEX { world_shape_at(w, s.next_shape_id).prev_shape_id = s.prev_shape_id }
    if body.head_shape_id == s.id { body.head_shape_id = s.next_shape_id }
    body.shape_count = body.shape_count - 1
    if s.geometry.kind == KIND_COMPOUND { w.compound_shape_count = w.compound_shape_count - 1 }
    if s.geometry.kind == KIND_HULL { remove_hull_from_database(w, s.geometry.hull) }
    if s.sensor_index != NULL_INDEX { destroy_sensor(w, s) }
    if s.proxy_key != NULL_INDEX {
        broad_phase.broad_phase_destroy_proxy(&w.broad_phase, s.proxy_key)
        s.proxy_key = NULL_INDEX
    }
    if s.materials != null {
        basics.free_bytes(s.materials, s.material_count * sizeof(SurfaceMaterial))
        s.materials = null
        s.material_count = 0
    }
    s.name_id = basics.NULL_NAME
    basics.idpool_free(&w.shape_id_pool, s.id)
    set_shape_fat_aabb(w, s.id, AABBf { lower: math.vec3f_zero(), upper: math.vec3f_zero() })
    s.id = NULL_INDEX
    if update_body_mass { update_body_mass_data(w, body) }
    w.locked = false
}

shape_get_body(id: ShapeId) -> BodyId {
    w = world_at(id.world0)
    return make_body_id(w, get_shape_full_id(w, id).body_id)
}
shape_get_aabb(id: ShapeId) -> AABB { return get_shape_full_id(world_at(id.world0), id).aabb }
shape_get_type(id: ShapeId) -> int { return get_shape_full_id(world_at(id.world0), id).geometry.kind }
shape_get_density(id: ShapeId) -> float { return get_shape_full_id(world_at(id.world0), id).geometry.density }
shape_set_density(id: ShapeId, density: float, update_body_mass: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_SET_DENSITY); rec_id(recorder, id.index1, id.generation); rec_float(recorder, density); rec_bool(recorder, update_body_mass); rec_end(recorder) }
    if valid_nonnegative(density) == false { return }
    w = world_at(id.world0)
    // Not mid-step, and an unchanged density spares the mass update (b3Shape_SetDensity).
    if w.locked { return }
    s = get_shape_full_id(w, id)
    if density == s.geometry.density { return }
    s.geometry.density = density
    if update_body_mass { update_body_mass_data(w, body_at(w, s.body_id)) }
}
shape_get_filter(id: ShapeId) -> Filter { return get_shape_full_id(world_at(id.world0), id).filter }
// A new filter takes effect at once, as the reference's b3Shape_SetFilter
// has it: the shape's contacts are destroyed (its bodies woken), so a pair
// the filter now forbids stops colliding; its proxy is moved, so the pairs
// are tried again under the new filter on the next step; and when the
// category bits change it is made anew, since the tree keeps them for the
// queries. (Setting the field alone left forbidden contacts touching, never
// paired shapes the filter now allows, and queried the old category.)
// Sensor overlaps follow on the next step.
shape_set_filter(id: ShapeId, filter: Filter) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_SET_FILTER); rec_id(recorder, id.index1, id.generation); rec_filter_value(recorder, filter); rec_end(recorder) }
    w = world_at(id.world0)
    if w.locked { return }
    s = get_shape_full_id(w, id)
    old = s.filter
    if filter.category_bits == old.category_bits && filter.mask_bits == old.mask_bits && filter.group_index == old.group_index { return }
    s.filter = filter
    reset_shape_proxy(w, s, true, filter.category_bits != old.category_bits)
}

// A shape's contacts destroyed and its proxy refreshed at the body's
// transform: made anew (`remake`, for new category bits) or moved, either
// way flagged so the broad phase pairs it again (the reference's b3ResetProxy).
reset_shape_proxy(w: *World, s: *WorldShape, wake_bodies: bool, remake: bool) {
    w.locked = true
    destroy_shape_contacts(w, s, wake_bodies)
    body = body_at(w, s.body_id)
    t = get_body_transform(w, s.body_id)
    if s.proxy_key != NULL_INDEX {
        kind = broad_phase.proxy_type(s.proxy_key)
        update_shape_aabbs(w, s, t, kind)
        if remake {
            broad_phase.broad_phase_destroy_proxy(&w.broad_phase, s.proxy_key)
            s.proxy_key = broad_phase.broad_phase_create_proxy(&w.broad_phase, kind, shape_fat_aabb(w, s.id), s.filter.category_bits, s.id, true)
        } else {
            broad_phase.broad_phase_move_proxy(&w.broad_phase, s.proxy_key, shape_fat_aabb(w, s.id))
        }
    } else {
        // A disabled body's shape: its bounds kept current for when it returns.
        update_shape_aabbs(w, s, t, body.kind)
    }
    w.locked = false
}
shape_get_surface_material(id: ShapeId) -> SurfaceMaterial { return get_shape_full_id(world_at(id.world0), id).material }
// The materials a shape has: a mesh's or a compound's table, else one (b3Shape_GetMeshMaterialCount).
shape_get_mesh_material_count(id: ShapeId) -> int { return get_shape_full_id(world_at(id.world0), id).material_count }
shape_set_surface_material(id: ShapeId, m: SurfaceMaterial) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_SET_SURFACE_MATERIAL); rec_id(recorder, id.index1, id.generation); rec_surface_material_value(recorder, m); rec_end(recorder) }
    set_surface_material(id, m)
}

// The material set without recording it: the setters built on it record
// themselves.
set_surface_material(id: ShapeId, m: SurfaceMaterial) {
    if valid_material(m) == false { return }
    s = get_shape_full_id(world_at(id.world0), id)
    s.material = m
    if s.materials != null {
        materials = s.materials as SurfaceMaterial[]
        materials[0] = m
    }
}
shape_get_material_count(id: ShapeId) -> int { return get_shape_full_id(world_at(id.world0), id).material_count }
shape_is_sensor(id: ShapeId) -> bool { return get_shape_full_id(world_at(id.world0), id).sensor_index != NULL_INDEX }
shape_set_user_data(id: ShapeId, data: ptr) { get_shape_full_id(world_at(id.world0), id).user_data = data }
shape_get_user_data(id: ShapeId) -> ptr { return get_shape_full_id(world_at(id.world0), id).user_data }
shape_get_flags(id: ShapeId) -> int { return get_shape_full_id(world_at(id.world0), id).flags }
// A shape's geometry, in the body's frame (b3Shape_GetSphere and its siblings; the wrong kind asserts in the reference).
shape_get_sphere(id: ShapeId) -> Sphere { return get_shape_full_id(world_at(id.world0), id).geometry.sphere }
shape_get_capsule(id: ShapeId) -> Capsule { return get_shape_full_id(world_at(id.world0), id).geometry.capsule }
shape_get_hull(id: ShapeId) -> *HullData { return get_shape_full_id(world_at(id.world0), id).geometry.hull }
shape_get_mesh_data(id: ShapeId) -> *MeshData { return get_shape_full_id(world_at(id.world0), id).geometry.mesh.data }
shape_get_mesh(id: ShapeId) -> Mesh { return get_shape_full_id(world_at(id.world0), id).geometry.mesh }
shape_get_height_field(id: ShapeId) -> *HeightFieldData { return get_shape_full_id(world_at(id.world0), id).geometry.height_field }

// --- a shape's geometry changed after creation (b3Shape_SetSphere and its siblings) ---------------

// The shape takes the new geometry in place, keeping its density, filter,
// materials and flags: its centroid and margin recomputed, its contacts
// destroyed (its bodies woken, to react to it) and its proxy made anew.
// The body's mass is the caller's to update (body_apply_mass_from_shapes),
// as in the reference. A compound or height field (static-only shapes) is
// not changed, nor changed into.
shape_set_sphere(id: ShapeId, s: Sphere) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_SET_SPHERE); rec_id(recorder, id.index1, id.generation); rec_sphere_value(recorder, s); rec_end(recorder) }
    if valid_sphere(s) == false { return }
    change_shape_geometry(id, shape.sphere_shape(s, 0.0))
}
shape_set_capsule(id: ShapeId, c: Capsule) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_SET_CAPSULE); rec_id(recorder, id.index1, id.generation); rec_capsule_value(recorder, c); rec_end(recorder) }
    if valid_capsule(c) == false { return }
    change_shape_geometry(id, shape.capsule_shape(c, 0.0))
}
// The new hull is taken into the database before the old is given up, so
// `h` may be the shape's own copy; the same copy changes nothing (no
// contacts lost, no proxy made again), as in b3Shape_SetHull.
shape_set_hull(id: ShapeId, h: *HullData) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_SET_HULL); rec_id(recorder, id.index1, id.generation); rec_geometry(recorder, shape.SHAPE_HULL, h as ptr); rec_end(recorder) }
    if h == null || h.version != hull.HULL_VERSION { return }
    w = world_at(id.world0)
    if w.locked { return }
    s = get_shape_full_id(w, id)
    if s.geometry.kind == KIND_COMPOUND || s.geometry.kind == KIND_HEIGHT_FIELD { return }
    shared = add_hull_to_database(w, h)
    if shared == null { return }
    if s.geometry.kind == KIND_HULL && s.geometry.hull == shared {
        remove_hull_from_database(w, shared)
        return
    }
    change_shape_geometry(id, shape.hull_shape(shared, 0.0))
}
shape_set_mesh(id: ShapeId, m: *MeshData, scale: Vec3) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_SET_MESH); rec_id(recorder, id.index1, id.generation); rec_geometry(recorder, shape.SHAPE_MESH, m as ptr); rec_vec3(recorder, scale); rec_end(recorder) }
    if m == null || m.version != mesh.MESH_VERSION || math.is_valid_vec3(scale) == false { return }
    change_shape_geometry(id, shape.mesh_shape(mesh.mesh(m, math.safe_scale(scale)), 1))
}

change_shape_geometry(id: ShapeId, geometry: Shape) {
    w = world_at(id.world0)
    if w.locked { return }
    s = get_shape_full_id(w, id)
    if s.geometry.kind == KIND_COMPOUND || s.geometry.kind == KIND_HEIGHT_FIELD { return }
    // A hull the shape held goes back to the database.
    if s.geometry.kind == KIND_HULL { remove_hull_from_database(w, s.geometry.hull) }
    density = s.geometry.density
    s.geometry = geometry
    s.geometry.density = density
    s.geometry.material_count = s.material_count
    s.local_centroid = shape.get_shape_centroid(&s.geometry)
    s.aabb_margin = compute_shape_margin(&s.geometry)
    reset_shape_proxy(w, s, true, true)
}

// The first material's friction and restitution (b3Shape_SetFriction and
// its siblings); a contact takes them on its next update.
shape_get_friction(id: ShapeId) -> float { return get_shape_full_id(world_at(id.world0), id).material.friction }
shape_set_friction(id: ShapeId, friction: float) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_SET_FRICTION); rec_id(recorder, id.index1, id.generation); rec_float(recorder, friction); rec_end(recorder) }
    m = shape_get_surface_material(id)
    m.friction = friction
    set_surface_material(id, m)
}
shape_get_restitution(id: ShapeId) -> float { return get_shape_full_id(world_at(id.world0), id).material.restitution }
shape_set_restitution(id: ShapeId, restitution: float) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_SET_RESTITUTION); rec_id(recorder, id.index1, id.generation); rec_float(recorder, restitution); rec_end(recorder) }
    m = shape_get_surface_material(id)
    m.restitution = restitution
    set_surface_material(id, m)
}

// A mesh's materials by index (b3Shape_SetMeshMaterial): the first is the
// shape's material; an index out of range is ignored.
shape_get_mesh_surface_material(id: ShapeId, index: int) -> SurfaceMaterial {
    s = get_shape_full_id(world_at(id.world0), id)
    if s.materials == null || index <= 0 || index >= s.material_count { return s.material }
    materials = s.materials as SurfaceMaterial[]
    return materials[index]
}
shape_set_mesh_material(id: ShapeId, m: SurfaceMaterial, index: int) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_SET_MESH_MATERIAL); rec_id(recorder, id.index1, id.generation); rec_surface_material_value(recorder, m); rec_int(recorder, index); rec_end(recorder) }
    if valid_material(m) == false { return }
    s = get_shape_full_id(world_at(id.world0), id)
    if index < 0 || index >= s.material_count { return }
    if index == 0 {
        set_surface_material(id, m)
        return
    }
    materials = s.materials as SurfaceMaterial[]
    materials[index] = m
}

// Pre-solve events on a shape after its creation; a contact takes the flag when it is made.
shape_enable_pre_solve_events(id: ShapeId, flag: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_ENABLE_PRE_SOLVE_EVENTS); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, flag); rec_end(recorder) }
    s = get_shape_full_id(world_at(id.world0), id)
    if flag { s.flags = s.flags | SHAPE_ENABLE_PRE_SOLVE_EVENTS } else { s.flags = s.flags & (0 - 1 - SHAPE_ENABLE_PRE_SOLVE_EVENTS) }
}
shape_are_pre_solve_events_enabled(id: ShapeId) -> bool { return (get_shape_full_id(world_at(id.world0), id).flags & SHAPE_ENABLE_PRE_SOLVE_EVENTS) != 0 }

// --- wind (b3Shape_ApplyWind) ----------------------------------------------------------------------

// The force and torque a wind (a velocity, m/s) puts on a dynamic body's
// convex shape, added to the body's for the next step: the drag of air
// (1.225 kg/m^3) on the area the shape presents to the relative wind, the
// shape's own velocity scaled by `drag` taken off the wind, the speed
// capped at `max_speed`; capsules and hull faces add `lift` across the
// flow. A hull is taken face by face, each facing the wind adding its
// triangles' push at their centres. A sleeping body is woken when `wake`
// says so and left alone otherwise; other kinds of shape take no wind.
const AIR_DENSITY = 1.225

shape_apply_wind(id: ShapeId, wind: Vec3, drag: float, lift: float, max_speed: float, wake: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_APPLY_WIND); rec_id(recorder, id.index1, id.generation); rec_vec3(recorder, wind); rec_float(recorder, drag); rec_float(recorder, lift); rec_float(recorder, max_speed); rec_bool(recorder, wake); rec_end(recorder) }
    w = world_at(id.world0)
    if w.locked { return }
    s = get_shape_full_id(w, id)
    kind = s.geometry.kind
    if kind != KIND_SPHERE && kind != KIND_CAPSULE && kind != KIND_HULL { return }
    body = body_at(w, s.body_id)
    if body.kind != BODY_DYNAMIC || body.set_index == DISABLED_SET { return }
    if body.set_index >= FIRST_SLEEPING_SET && wake == false { return }
    if body.set_index != AWAKE_SET { wake_body(w, body) }
    sim = get_body_sim(w, body)
    state = get_body_state(w, body)
    q = sim.transform.q
    force = math.vec3_zero()
    torque = math.vec3_zero()
    if kind == KIND_SPHERE || kind == KIND_CAPSULE {
        lever = math.rotate_vector(q, math.sub(s.local_centroid, math.widen3(sim.local_center)))
        relative = math.mul_sub(wind, drag, math.add(math.widen3(state.v), math.cross(math.widen3(state.w), lever)))
        speed = math.length(relative)
        direction = math.normalize(relative)
        speed = math.min_float(speed, max_speed)
        if kind == KIND_SPHERE {
            r = s.geometry.sphere.radius
            force = math.mul_sv(0.5 * AIR_DENSITY * math.PI * r * r * speed * speed, direction)
            torque = math.cross(lever, force)
        } else {
            c = s.geometry.capsule
            d = math.rotate_vector(q, math.sub(c.center2, c.center1))
            r = c.radius
            area = math.PI * r * r + 2.0 * r * math.length(math.cross(d, direction))
            e = math.normalize(d)
            // The side's normal facing the wind, and the flow across it.
            normal = math.sub(math.mul_sv(math.dot(direction, e), e), direction)
            lift_direction = math.cross(math.cross(normal, direction), direction)
            force = math.mul_sv(0.5 * AIR_DENSITY * area * speed * speed, math.mul_add(direction, lift, lift_direction))
            torque = math.cross(math.mul_add(lever, r, normal), force)
        }
    } else {
        h = s.geometry.hull
        points = hull.hull_points(h)
        edges = hull.hull_edges(h)
        planes = hull.hull_planes(h)
        faces = hull.hull_faces(h)
        m = math.make_matrix_from_quat(q)
        f = 0
        while f < h.face_count {
            e1 = faces[f]
            e2 = edges[e1].next
            e3 = edges[e2].next
            p1 = points[edges[e1].origin]
            p2 = points[edges[e2].origin]
            v1 = math.mul_mv(m, p1)
            v2 = math.mul_mv(m, p2)
            normal = math.mul_mv(m, planes[f].normal)
            // The face as a fan of triangles from its first vertex.
            while e3 != e1 {
                p3 = points[edges[e3].origin]
                v3 = math.mul_mv(m, p3)
                centre = math.mul_sv(1.0 / 3.0, math.add(p1, math.add(p2, p3)))
                lever = math.mul_mv(m, math.sub(centre, math.widen3(sim.local_center)))
                relative = math.mul_sub(wind, drag, math.add(math.widen3(state.v), math.cross(math.widen3(state.w), lever)))
                speed = math.length(relative)
                direction = math.normalize(relative)
                if math.dot(normal, direction) < 0.0 - math.EPSILON {
                    area = 0.0 - 0.5 * math.dot(math.cross(math.sub(v2, v1), math.sub(v3, v1)), direction)
                    lift_direction = math.cross(math.cross(normal, direction), direction)
                    speed = math.min_float(speed, max_speed)
                    push = math.mul_sv(0.5 * AIR_DENSITY * area * speed * speed, math.mul_add(direction, lift, lift_direction))
                    force = math.add(force, push)
                    torque = math.add(torque, math.cross(lever, push))
                }
                p2 = p3
                v2 = v3
                e3 = edges[e3].next
            }
            f = f + 1
        }
    }
    sim.force = math.narrow3(math.add(math.widen3(sim.force), force))
    sim.torque = math.narrow3(math.add(math.widen3(sim.torque), torque))
}

// A label for debugging (b3Body_SetName and its siblings), kept in the
// world's name cache, so the caller's string may go; an empty name for
// none.
body_set_name(id: BodyId, name: string) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_NAME); rec_id(recorder, id.index1, id.generation); rec_string(recorder, name); rec_end(recorder) }
    w = world_at(id.world0)
    get_body_full_id(w, id).name_id = basics.name_cache_add(&w.names, name)
}
body_get_name(id: BodyId) -> string { w = world_at(id.world0); return basics.name_cache_text(&w.names, get_body_full_id(w, id).name_id) }
shape_set_name(id: ShapeId, name: string) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_SET_NAME); rec_id(recorder, id.index1, id.generation); rec_string(recorder, name); rec_end(recorder) }
    w = world_at(id.world0)
    get_shape_full_id(w, id).name_id = basics.name_cache_add(&w.names, name)
}
shape_get_name(id: ShapeId) -> string { w = world_at(id.world0); return basics.name_cache_text(&w.names, get_shape_full_id(w, id).name_id) }

// The world a body or shape belongs to, as an id (b3Body_GetWorld, b3Shape_GetWorld).
body_get_world(id: BodyId) -> WorldId { return WorldId { index1: id.world0 + 1, generation: world_at(id.world0).generation } }
shape_get_world(id: ShapeId) -> WorldId { return WorldId { index1: id.world0 + 1, generation: world_at(id.world0).generation } }

// The mass a shape alone gives (b3Shape_ComputeMassData).
shape_compute_mass_data(id: ShapeId) -> MassData { return shape.compute_shape_mass(&get_shape_full_id(world_at(id.world0), id).geometry) }

// The point of a convex shape (sphere, capsule, hull) closest to a world
// target, on its surface, in the world; the target itself when inside (b3Shape_GetClosestPoint).
shape_get_closest_point(id: ShapeId, target: Vec3) -> Vec3 {
    w = world_at(id.world0)
    s = get_shape_full_id(w, id)
    return closest_on_shape(s, get_body_transform(w, s.body_id), target).point
}

// The closest point on a body's convex shapes to a world target and how far
// it is (b3Body_GetClosestPoint, which reads the shapes without their radii:
// a sphere's centre, not its surface; here the radii are counted, so the
// point is on the surface). No convex shape gives the body's origin and the
// largest float.
body_get_closest_point(id: BodyId, target: Vec3) -> ClosestPoint {
    w = world_at(id.world0)
    t = get_body_transform(w, id.index1 - 1)
    best = ClosestPoint { point: t.p, distance: math.MAX_FLOAT }
    shape_id = get_body_full_id(w, id).head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        shape_id = s.next_shape_id
        found = closest_on_shape(s, t, target)
        if found.distance < best.distance { best = found }
    }
    return best
}

struct ClosestPoint {
    point: Vec3
    distance: float
}

var g_closest_target: ptr = null   // Vec3, the query's one point
closest_target() -> ptr {
    if g_closest_target == null { g_closest_target = basics.alloc(native.MAX_WORKERS * sizeof(Vec3)) }
    return native.scratch(g_closest_target, sizeof(Vec3))
}

closest_on_shape(s: *WorldShape, t: Transform, target: Vec3) -> ClosestPoint {
    kind = s.geometry.kind
    if kind != KIND_SPHERE && kind != KIND_CAPSULE && kind != KIND_HULL { return ClosestPoint { point: t.p, distance: math.MAX_FLOAT } }
    block = closest_target()
    (block as Vec3[])[0] = math.inv_transform_point(t, target)
    input = DistanceInput { proxy_a: shape.make_shape_proxy(&s.geometry), proxy_b: distance.shape_proxy(block, 1, 0.0),
                            transform: math.transform_identity(), use_radii: true }
    cache = distance.empty_cache()
    output = distance.shape_distance(&input, &cache, null, 0)
    point = output.point_a
    if output.distance == 0.0 { point = (block as Vec3[])[0] }
    return ClosestPoint { point: math.transform_point(t, point), distance: output.distance }
}

// --- mass ---------------------------------------------------------------------------------------------------

var g_masses: ptr = null   // MassData[]; the shapes' masses during an update
var g_mass_capacity = 0

// The body's mass, centre of mass, inertia about it (each shape's
// carried over by Steiner), the inverse inertia in the world, and its
// extents from the centre; static and kinematic bodies get no mass, and
// a kinematic one keeps its extents (for sleeping). Fixed rotation zeroes
// the inertia.
update_body_mass_data(w: *World, body: *Body) {
    sim = get_body_sim(w, body)
    body.flags = body.flags & (0 - 1 - DIRTY_MASS)
    sync_body_flags(w, body)
    body.mass = 0.0
    body.inertia = math.mat3_zero()
    sim.inv_mass = 0.0
    sim.inv_inertia_local = math.narrow_mat3(math.mat3_zero())
    sim.inv_inertia_world = math.narrow_mat3(math.mat3_zero())
    sim.local_center = math.narrow3(math.vec3_zero())
    sim.min_extent = math.HUGE
    sim.max_extent = math.narrow3(math.vec3_zero())
    if body.head_shape_id == NULL_INDEX { return }

    if body.kind != BODY_DYNAMIC {
        sim.center = sim.transform.p
        sim.center0 = sim.center
        if body.kind == BODY_KINEMATIC {
            shape_id = body.head_shape_id
            while shape_id != NULL_INDEX {
                s = world_shape_at(w, shape_id)
                extent = shape.compute_shape_extent(&s.geometry, math.vec3_zero())
                sim.min_extent = math.min_float(sim.min_extent, extent.min_extent)
                sim.max_extent = math.narrow3(math.max_vec3(math.widen3(sim.max_extent), extent.max_extent))
                shape_id = s.next_shape_id
            }
        }
        return
    }

    shape_count = body.shape_count
    if shape_count > g_mass_capacity {
        basics.free_bytes(g_masses, g_mass_capacity * sizeof(MassData))
        g_mass_capacity = math.max_int(shape_count, 8)
        g_masses = basics.alloc(g_mass_capacity * sizeof(MassData))
    }
    masses = g_masses as MassData[]
    local_center = math.vec3_zero()
    shape_id = body.head_shape_id
    shape_index = 0
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        shape_id = s.next_shape_id
        if s.geometry.density == 0.0 {
            masses[shape_index] = MassData { mass: 0.0, center: math.vec3_zero(), inertia: math.mat3_zero() }
        } else {
            mass_data = shape.compute_shape_mass(&s.geometry)
            body.mass = body.mass + mass_data.mass
            local_center = math.mul_add(local_center, mass_data.mass, mass_data.center)
            masses[shape_index] = mass_data
        }
        shape_index = shape_index + 1
    }
    if body.mass > 0.0 {
        sim.inv_mass = 1.0 / body.mass
        local_center = math.mul_sv(sim.inv_mass, local_center)
    }
    shape_index = 0
    while shape_index < shape_count {
        mass_data = masses[shape_index]
        if mass_data.mass != 0.0 {
            // Shifted to the centre of mass; it can only grow.
            offset = math.sub(local_center, mass_data.center)
            body.inertia = math.add_mm(body.inertia, math.add_mm(mass_data.inertia, math.steiner(mass_data.mass, offset)))
        }
        shape_index = shape_index + 1
    }
    determinant = math.det(body.inertia)
    if determinant > 0.0 {
        sim.inv_inertia_local = math.narrow_mat3(math.invert_t(body.inertia))
        rotation = math.make_matrix_from_quat(sim.transform.q)
        sim.inv_inertia_world = math.narrow_mat3(math.mul_mm(math.mul_mm(rotation, math.widen_mat3(sim.inv_inertia_local)), math.transpose(rotation)))
    }
    // The centre of mass moves: the velocity follows the new material point.
    old_center = sim.center
    sim.local_center = math.narrow3(local_center)
    sim.center = math.transform_point(sim.transform, local_center)
    sim.center0 = sim.center
    state = get_body_state(w, body)
    if state != null {
        state.v = math.narrow3(math.add(math.widen3(state.v), math.cross(math.widen3(state.w), math.sub(sim.center, old_center))))
    }
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        extent = shape.compute_shape_extent(&s.geometry, local_center)
        sim.min_extent = math.min_float(sim.min_extent, extent.min_extent)
        sim.max_extent = math.narrow3(math.max_vec3(math.widen3(sim.max_extent), extent.max_extent))
        shape_id = s.next_shape_id
    }
    // A moved centre of mass invalidates every cached manifold.
    invalidate_body_contacts(w, body)
    if (sim.flags & FIXED_ROTATION) == FIXED_ROTATION {
        body.inertia = math.mat3_zero()
        sim.inv_inertia_local = math.narrow_mat3(math.mat3_zero())
        sim.inv_inertia_world = math.narrow_mat3(math.mat3_zero())
    }
}

// --- the body's public face ------------------------------------------------------------------------------

body_world(id: BodyId) -> *World { return world_at(id.world0) }

body_get_position(id: BodyId) -> Vec3 { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).transform.p }
body_get_rotation(id: BodyId) -> Quat { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).transform.q }
body_get_transform(id: BodyId) -> Transform { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).transform }
body_get_local_point(id: BodyId, world_point: Vec3) -> Vec3 { return math.inv_transform_point(body_get_transform(id), world_point) }
body_get_world_point(id: BodyId, local_point: Vec3) -> Vec3 { return math.transform_point(body_get_transform(id), local_point) }
body_get_local_vector(id: BodyId, world_vector: Vec3) -> Vec3 { return math.inv_rotate_vector(body_get_rotation(id), world_vector) }
body_get_world_vector(id: BodyId, local_vector: Vec3) -> Vec3 { return math.rotate_vector(body_get_rotation(id), local_vector) }

// The body moved by hand: its centre and inverse world inertia follow,
// its shapes' bounds and proxies are updated at once (a static body's
// too, so contacts begin without a step).
body_set_transform(id: BodyId, position: Vec3, rotation: Quat) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_TRANSFORM); rec_id(recorder, id.index1, id.generation); rec_vec3(recorder, position); rec_quat(recorder, rotation); rec_end(recorder) }
    if math.is_valid_position(position) == false || math.is_valid_quat(rotation) == false { return }
    w = body_world(id)
    if w.locked { return }
    body = get_body_full_id(w, id)
    sim = get_body_sim(w, body)
    sim.transform = Transform { p: position, q: rotation }
    sim.center = math.transform_point(sim.transform, math.widen3(sim.local_center))
    sim.rotation0 = math.narrow_quat(rotation)
    sim.center0 = sim.center
    r = math.make_matrix_from_quat(rotation)
    sim.inv_inertia_world = math.narrow_mat3(math.mul_mm(math.mul_mm(r, math.widen_mat3(sim.inv_inertia_local)), math.transpose(r)))
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        // A disabled body's shapes have no proxy, but their bounds move
        // with it. The proxy moves only when the new bounds leave the old
        // fat ones, as the reference's does: a body moved a little every
        // frame is not taken out of the tree and put back each time.
        old_fat = shape_fat_aabb(w, s.id)
        update_shape_aabbs(w, s, sim.transform, body.kind)
        if math.aabbf_holds(old_fat, s.aabb) {
            set_shape_fat_aabb(w, s.id, old_fat)
        } else if s.proxy_key != NULL_INDEX {
            broad_phase.broad_phase_move_proxy(&w.broad_phase, s.proxy_key, shape_fat_aabb(w, s.id))
        }
        shape_id = s.next_shape_id
    }
    invalidate_body_contacts(w, body)
}

body_get_linear_velocity(id: BodyId) -> Vec3 {
    w = body_world(id)
    state = get_body_state(w, get_body_full_id(w, id))
    if state == null { return math.vec3_zero() }
    return math.widen3(state.v)
}

body_get_angular_velocity(id: BodyId) -> Vec3 {
    w = body_world(id)
    state = get_body_state(w, get_body_full_id(w, id))
    if state == null { return math.vec3_zero() }
    return math.widen3(state.w)
}

// A velocity wakes a sleeping body; a static body has none.
body_set_linear_velocity(id: BodyId, v: Vec3) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_LINEAR_VELOCITY); rec_id(recorder, id.index1, id.generation); rec_vec3(recorder, v); rec_end(recorder) }
    if math.is_valid_vec3(v) == false { return }
    w = body_world(id)
    body = get_body_full_id(w, id)
    if body.kind == BODY_STATIC { return }
    if math.length_squared(v) > 0.0 { wake_body(w, body) }
    state = get_body_state(w, body)
    if state != null { state.v = math.narrow3(v) }
}

// Forces and torques accumulate on the sim for the next step's
// integration; impulses change the velocities now. Each wakes the body
// when asked and does nothing to a body that is not awake after that.
awake_for_apply(w: *World, body: *Body, wake: bool) -> bool {
    if wake && body.set_index >= FIRST_SLEEPING_SET { wake_body(w, body) }
    return body.set_index == AWAKE_SET
}

// The velocities that carry the body to a target transform over one time
// step (b3Body_SetTargetTransform): how a kinematic body is moved by the
// game, so the solver sees it moving and what rides on it comes along. A
// sleeping body stays asleep when the movement would be below its
// sleep threshold, unless woken.
body_set_target_transform(id: BodyId, target: Transform, time_step: float, wake: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_TARGET_TRANSFORM); rec_id(recorder, id.index1, id.generation); rec_transform(recorder, target); rec_float(recorder, time_step); rec_bool(recorder, wake); rec_end(recorder) }
    if math.is_valid_world_transform(target) == false || math.is_valid_float(time_step) == false { return }
    w = body_world(id)
    body = get_body_full_id(w, id)
    if body.set_index == DISABLED_SET { return }
    if body.kind == BODY_STATIC || time_step <= 0.0 { return }
    if body.set_index != AWAKE_SET && wake == false { return }
    sim = get_body_sim(w, body)
    center1 = sim.center
    center2 = math.transform_point(target, math.widen3(sim.local_center))
    inv_time_step = 1.0 / time_step
    linear_velocity = math.mul_sv(inv_time_step, math.sub(center2, center1))
    // q' = 0.5 w q, so w = 2 (q2 - q1) conj(q1) / dt, along the shorter arc.
    q1 = sim.transform.q
    q2 = target.q
    if math.dot_quat(q1, q2) < 0.0 { q2 = math.negate_quat(q2) }
    dq = math.quat_vs(math.sub(math.qv(q2), math.qv(q1)), q2.w - q1.w)
    omega = math.mul_quat(dq, math.conjugate(q1))
    angular_velocity = math.mul_sv(2.0 * inv_time_step, math.qv(omega))
    if body.set_index != AWAKE_SET {
        max_velocity = math.length(linear_velocity) + math.length(math.mul(angular_velocity, math.widen3(sim.max_extent)))
        if max_velocity < body.sleep_threshold { return }
        wake_body(w, body)
    }
    state = get_body_state(w, body)
    state.v = math.narrow3(linear_velocity)
    state.w = math.narrow3(angular_velocity)
}

body_apply_force(id: BodyId, force: Vec3, point: Vec3, wake: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_APPLY_FORCE); rec_id(recorder, id.index1, id.generation); rec_vec3(recorder, force); rec_vec3(recorder, point); rec_bool(recorder, wake); rec_end(recorder) }
    if math.is_valid_vec3(force) == false || math.is_valid_position(point) == false { return }
    w = body_world(id)
    body = get_body_full_id(w, id)
    if awake_for_apply(w, body, wake) == false { return }
    sim = get_body_sim(w, body)
    sim.force = math.narrow3(math.add(math.widen3(sim.force), force))
    sim.torque = math.narrow3(math.add(math.widen3(sim.torque), math.cross(math.sub(point, sim.center), force)))
}

body_apply_force_to_center(id: BodyId, force: Vec3, wake: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_APPLY_FORCE_TO_CENTER); rec_id(recorder, id.index1, id.generation); rec_vec3(recorder, force); rec_bool(recorder, wake); rec_end(recorder) }
    if math.is_valid_vec3(force) == false { return }
    w = body_world(id)
    body = get_body_full_id(w, id)
    if awake_for_apply(w, body, wake) == false { return }
    sim = get_body_sim(w, body)
    sim.force = math.narrow3(math.add(math.widen3(sim.force), force))
}

body_apply_torque(id: BodyId, torque: Vec3, wake: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_APPLY_TORQUE); rec_id(recorder, id.index1, id.generation); rec_vec3(recorder, torque); rec_bool(recorder, wake); rec_end(recorder) }
    if math.is_valid_vec3(torque) == false { return }
    w = body_world(id)
    body = get_body_full_id(w, id)
    if awake_for_apply(w, body, wake) == false { return }
    sim = get_body_sim(w, body)
    sim.torque = math.narrow3(math.add(math.widen3(sim.torque), torque))
}

// The linear velocity after an impulse, capped at the world's maximum speed.
capped_linear_velocity(w: *World, v: Vec3) -> Vec3 {
    max_speed = w.max_linear_speed
    if math.length_squared(v) > max_speed * max_speed { return math.mul_sv(max_speed, math.normalize(v)) }
    return v
}

body_apply_linear_impulse(id: BodyId, impulse: Vec3, point: Vec3, wake: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_APPLY_LINEAR_IMPULSE); rec_id(recorder, id.index1, id.generation); rec_vec3(recorder, impulse); rec_vec3(recorder, point); rec_bool(recorder, wake); rec_end(recorder) }
    if math.is_valid_vec3(impulse) == false || math.is_valid_position(point) == false { return }
    w = body_world(id)
    body = get_body_full_id(w, id)
    if awake_for_apply(w, body, wake) == false { return }
    sim = get_body_sim(w, body)
    state = get_body_state(w, body)
    state.v = math.narrow3(capped_linear_velocity(w, math.mul_add(math.widen3(state.v), sim.inv_mass, impulse)))
    delta = math.mul_mv(math.widen_mat3(sim.inv_inertia_world), math.cross(math.sub(point, sim.center), impulse))
    state.w = math.narrow3(math.add(math.widen3(state.w), delta))
}

body_apply_linear_impulse_to_center(id: BodyId, impulse: Vec3, wake: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_APPLY_LINEAR_IMPULSE_TO_CENTER); rec_id(recorder, id.index1, id.generation); rec_vec3(recorder, impulse); rec_bool(recorder, wake); rec_end(recorder) }
    if math.is_valid_vec3(impulse) == false { return }
    w = body_world(id)
    body = get_body_full_id(w, id)
    if awake_for_apply(w, body, wake) == false { return }
    sim = get_body_sim(w, body)
    state = get_body_state(w, body)
    state.v = math.narrow3(capped_linear_velocity(w, math.mul_add(math.widen3(state.v), sim.inv_mass, impulse)))
}

// The angular impulse through the local inertia, so it is exact under rotation.
body_apply_angular_impulse(id: BodyId, impulse: Vec3, wake: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_APPLY_ANGULAR_IMPULSE); rec_id(recorder, id.index1, id.generation); rec_vec3(recorder, impulse); rec_bool(recorder, wake); rec_end(recorder) }
    if math.is_valid_vec3(impulse) == false { return }
    w = body_world(id)
    body = get_body_full_id(w, id)
    if awake_for_apply(w, body, wake) == false { return }
    sim = get_body_sim(w, body)
    state = get_body_state(w, body)
    local_impulse = math.inv_rotate_vector(sim.transform.q, impulse)
    local_delta = math.mul_mv(math.widen_mat3(sim.inv_inertia_local), local_impulse)
    state.w = math.narrow3(math.add(math.widen3(state.w), math.rotate_vector(sim.transform.q, local_delta)))
}

body_set_bullet(id: BodyId, flag: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_BULLET); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, flag); rec_end(recorder) }
    w = body_world(id)
    if w == null { return }
    body = get_body_full_id(w, id)
    new_flag = 0
    if flag { new_flag = IS_BULLET }
    if (body.flags & IS_BULLET) == new_flag { return }
    body.flags = (body.flags & (0 - 1 - IS_BULLET)) | new_flag
    sync_body_flags(w, body)
}

body_is_bullet(id: BodyId) -> bool {
    w = body_world(id)
    return (get_body_full_id(w, id).flags & IS_BULLET) != 0
}

// A body flag set after creation, the solver's copies kept in step.
set_body_flag(id: BodyId, bit: int, flag: bool) {
    w = body_world(id)
    if w == null { return }
    body = get_body_full_id(w, id)
    if flag { body.flags = body.flags | bit } else { body.flags = body.flags & (0 - 1 - bit) }
    sync_body_flags(w, body)
}

// Fast rotation (b3Body_AllowFastRotation): a body allowed it is not capped
// at the angular speed that keeps a step's turn small.
body_allow_fast_rotation(id: BodyId, flag: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_ALLOW_FAST_ROTATION); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, flag); rec_end(recorder) }
    set_body_flag(id, ALLOW_FAST_ROTATION, flag)
}
body_is_fast_rotation_allowed(id: BodyId) -> bool { return (get_body_full_id(body_world(id), id).flags & ALLOW_FAST_ROTATION) != 0 }

// Contact recycling (b3Body_EnableContactRecycling): a resting contact's
// manifold reused while the bodies barely move. A contact takes the flag
// when it is made, so the body's contacts are brought in line here (the
// reference's setter leaves them: one switched off went on recycling).
body_enable_contact_recycling(id: BodyId, flag: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_ENABLE_CONTACT_RECYCLING); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, flag); rec_end(recorder) }
    set_body_flag(id, ENABLE_CONTACT_RECYCLING, flag)
    w = body_world(id)
    if w == null { return }
    body = get_body_full_id(w, id)
    key = body.head_contact_key
    while key != NULL_INDEX {
        c = contact_at(w, key >> 1)
        key = contact_edge_next(w, key)
        both = (body_at(w, world_shape_at(w, c.shape_id_a).body_id).flags & ENABLE_CONTACT_RECYCLING) != 0 &&
               (body_at(w, world_shape_at(w, c.shape_id_b).body_id).flags & ENABLE_CONTACT_RECYCLING) != 0
        if both { c.flags = c.flags | CONTACT_RECYCLE } else { c.flags = c.flags & (0 - 1 - CONTACT_RECYCLE) }
    }
}
body_is_contact_recycling_enabled(id: BodyId) -> bool { return (get_body_full_id(body_world(id), id).flags & ENABLE_CONTACT_RECYCLING) != 0 }

// The share of its smallest extent a body may move in a step before the
// continuous pass sweeps it (b3Body_SetSafetyFactor).
body_set_safety_factor(id: BodyId, factor: float) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_SAFETY_FACTOR); rec_id(recorder, id.index1, id.generation); rec_float(recorder, factor); rec_end(recorder) }
    if valid_nonnegative(factor) == false { return }
    w = body_world(id)
    if w == null { return }
    get_body_full_id(w, id).safety_factor = factor
}
body_get_safety_factor(id: BodyId) -> float { return get_body_full_id(body_world(id), id).safety_factor }

body_set_angular_velocity(id: BodyId, v: Vec3) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_ANGULAR_VELOCITY); rec_id(recorder, id.index1, id.generation); rec_vec3(recorder, v); rec_end(recorder) }
    if math.is_valid_vec3(v) == false { return }
    w = body_world(id)
    body = get_body_full_id(w, id)
    if body.kind == BODY_STATIC { return }
    // The locks apply, so a locked axis does not wake the body.
    wx = v.x
    wy = v.y
    wz = v.z
    if (body.flags & LOCK_ANGULAR_X) != 0 { wx = 0.0 }
    if (body.flags & LOCK_ANGULAR_Y) != 0 { wy = 0.0 }
    if (body.flags & LOCK_ANGULAR_Z) != 0 { wz = 0.0 }
    locked = math.vec3(wx, wy, wz)
    if math.length_squared(locked) != 0.0 { wake_body(w, body) }
    state = get_body_state(w, body)
    if state != null { state.w = math.narrow3(locked) }
}

body_get_local_point_velocity(id: BodyId, local_point: Vec3) -> Vec3 {
    w = body_world(id)
    body = get_body_full_id(w, id)
    state = get_body_state(w, body)
    if state == null { return math.vec3_zero() }
    sim = get_body_sim(w, body)
    r = math.rotate_vector(sim.transform.q, math.sub(local_point, math.widen3(sim.local_center)))
    return math.add(math.widen3(state.v), math.cross(math.widen3(state.w), r))
}

body_get_world_point_velocity(id: BodyId, world_point: Vec3) -> Vec3 {
    w = body_world(id)
    body = get_body_full_id(w, id)
    state = get_body_state(w, body)
    if state == null { return math.vec3_zero() }
    sim = get_body_sim(w, body)
    return math.add(math.widen3(state.v), math.cross(math.widen3(state.w), math.sub(world_point, sim.center)))
}

body_get_type(id: BodyId) -> int { return get_body_full_id(body_world(id), id).kind }
body_get_mass(id: BodyId) -> float { return get_body_full_id(body_world(id), id).mass }
body_get_inverse_mass(id: BodyId) -> float { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).inv_mass }
body_get_local_rotational_inertia(id: BodyId) -> Matrix3 { return get_body_full_id(body_world(id), id).inertia }
body_get_world_inverse_rotational_inertia(id: BodyId) -> Matrix3 { w = body_world(id); return math.widen_mat3(get_body_sim(w, get_body_full_id(w, id)).inv_inertia_world) }
body_get_local_center(id: BodyId) -> Vec3 { w = body_world(id); return math.widen3(get_body_sim(w, get_body_full_id(w, id)).local_center) }
body_get_world_center(id: BodyId) -> Vec3 { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).center }
body_get_min_extent(id: BodyId) -> float { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).min_extent }
body_get_max_extent(id: BodyId) -> Vec3 { w = body_world(id); return math.widen3(get_body_sim(w, get_body_full_id(w, id)).max_extent) }
body_get_max_extent_origin(id: BodyId) -> Vec3 {
    w = body_world(id)
    sim = get_body_sim(w, get_body_full_id(w, id))
    return math.add(math.widen3(sim.max_extent), math.abs_vec3(math.widen3(sim.local_center)))
}

// Mass properties set by hand, bypassing the shapes: the inverses, the
// world inertia under the body's rotation, the velocity re-referenced
// to the new centre, the extents about it; fixed rotation zeroes the inertia.
body_set_mass_data(id: BodyId, mass_data: MassData) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_MASS_DATA); rec_id(recorder, id.index1, id.generation); rec_mass_data_value(recorder, mass_data); rec_end(recorder) }
    if valid_nonnegative(mass_data.mass) == false || math.is_valid_matrix3(mass_data.inertia) == false || math.is_valid_vec3(mass_data.center) == false { return }
    w = body_world(id)
    if w.locked { return }
    body = get_body_full_id(w, id)
    sim = get_body_sim(w, body)
    body.flags = body.flags & (0 - 1 - DIRTY_MASS)
    sync_body_flags(w, body)
    body.mass = mass_data.mass
    body.inertia = mass_data.inertia
    sim.local_center = math.narrow3(mass_data.center)
    old_center = sim.center
    sim.center = math.transform_point(sim.transform, mass_data.center)
    sim.center0 = sim.center
    sim.inv_mass = 0.0
    if body.mass > 0.0 { sim.inv_mass = 1.0 / body.mass }
    state = get_body_state(w, body)
    if state != null {
        state.v = math.narrow3(math.add(math.widen3(state.v), math.cross(math.widen3(state.w), math.sub(sim.center, old_center))))
    }
    determinant = math.det(body.inertia)
    if determinant > 0.0 {
        sim.inv_inertia_local = math.narrow_mat3(math.invert_t(body.inertia))
        r = math.make_matrix_from_quat(sim.transform.q)
        sim.inv_inertia_world = math.narrow_mat3(math.mul_mm(math.mul_mm(r, math.widen_mat3(sim.inv_inertia_local)), math.transpose(r)))
    } else {
        sim.inv_inertia_local = math.narrow_mat3(math.mat3_zero())
        sim.inv_inertia_world = math.narrow_mat3(math.mat3_zero())
    }
    if (sim.flags & FIXED_ROTATION) == FIXED_ROTATION {
        body.inertia = math.mat3_zero()
        sim.inv_inertia_local = math.narrow_mat3(math.mat3_zero())
        sim.inv_inertia_world = math.narrow_mat3(math.mat3_zero())
    }
    sim.min_extent = math.HUGE
    sim.max_extent = math.narrow3(math.vec3_zero())
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        extent = shape.compute_shape_extent(&s.geometry, mass_data.center)
        sim.min_extent = math.min_float(sim.min_extent, extent.min_extent)
        sim.max_extent = math.narrow3(math.max_vec3(math.widen3(sim.max_extent), extent.max_extent))
        shape_id = s.next_shape_id
    }
    invalidate_body_contacts(w, body)
}

body_get_mass_data(id: BodyId) -> MassData {
    w = body_world(id)
    body = get_body_full_id(w, id)
    return MassData { mass: body.mass, center: math.widen3(get_body_sim(w, body).local_center), inertia: body.inertia }
}

body_apply_mass_from_shapes(id: BodyId) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_APPLY_MASS_FROM_SHAPES); rec_id(recorder, id.index1, id.generation); rec_end(recorder) }
    w = body_world(id)
    if w.locked { return }
    update_body_mass_data(w, get_body_full_id(w, id))
}

body_set_linear_damping(id: BodyId, damping: float) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_LINEAR_DAMPING); rec_id(recorder, id.index1, id.generation); rec_float(recorder, damping); rec_end(recorder) }
    if valid_nonnegative(damping) == false { return }
    w = body_world(id)
    get_body_sim(w, get_body_full_id(w, id)).linear_damping = damping
}
body_get_linear_damping(id: BodyId) -> float { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).linear_damping }
body_set_angular_damping(id: BodyId, damping: float) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_ANGULAR_DAMPING); rec_id(recorder, id.index1, id.generation); rec_float(recorder, damping); rec_end(recorder) }
    if valid_nonnegative(damping) == false { return }
    w = body_world(id)
    get_body_sim(w, get_body_full_id(w, id)).angular_damping = damping
}
body_get_angular_damping(id: BodyId) -> float { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).angular_damping }
body_set_gravity_scale(id: BodyId, scale: float) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_GRAVITY_SCALE); rec_id(recorder, id.index1, id.generation); rec_float(recorder, scale); rec_end(recorder) }
    if math.is_valid_float(scale) == false { return }
    w = body_world(id)
    get_body_sim(w, get_body_full_id(w, id)).gravity_scale = scale
}
body_get_gravity_scale(id: BodyId) -> float { w = body_world(id); return get_body_sim(w, get_body_full_id(w, id)).gravity_scale }
body_set_user_data(id: BodyId, data: ptr) { get_body_full_id(body_world(id), id).user_data = data }
body_get_user_data(id: BodyId) -> ptr { return get_body_full_id(body_world(id), id).user_data }
body_is_awake(id: BodyId) -> bool { return get_body_full_id(body_world(id), id).set_index == AWAKE_SET }
body_is_enabled(id: BodyId) -> bool { return get_body_full_id(body_world(id), id).set_index != DISABLED_SET }
body_is_sleep_enabled(id: BodyId) -> bool { return (get_body_full_id(body_world(id), id).flags & ENABLE_SLEEP) != 0 }
body_get_sleep_threshold(id: BodyId) -> float { return get_body_full_id(body_world(id), id).sleep_threshold }
body_set_sleep_threshold(id: BodyId, threshold: float) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_SLEEP_THRESHOLD); rec_id(recorder, id.index1, id.generation); rec_float(recorder, threshold); rec_end(recorder) }
    if valid_nonnegative(threshold) == false { return }
    get_body_full_id(body_world(id), id).sleep_threshold = threshold
}
body_get_shape_count(id: BodyId) -> int { return get_body_full_id(body_world(id), id).shape_count }
body_get_flags(id: BodyId) -> int { return get_body_full_id(body_world(id), id).flags }

// Waking a sleeping body, or putting an awake one's island to sleep now
// (b3Body_SetAwake): split first if a constraint left it, so only what
// is still connected sleeps.
body_set_awake(id: BodyId, awake: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_AWAKE); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, awake); rec_end(recorder) }
    w = body_world(id)
    if w.locked { return }
    w.locked = true
    body = get_body_full_id(w, id)
    if awake {
        wake_body(w, body)
    } else if body.set_index == AWAKE_SET && body.island_id != NULL_INDEX {
        if island_at(w, body.island_id).constraint_remove_count > 0 { split_island(w, body.island_id) }
        try_sleep_island(w, body.island_id)
    }
    w.locked = false
}

body_enable_sleep(id: BodyId, enable: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_ENABLE_SLEEP); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, enable); rec_end(recorder) }
    w = body_world(id)
    body = get_body_full_id(w, id)
    // Unchanged is nothing to do: a repeated disable does not wake the body.
    if enable == ((body.flags & ENABLE_SLEEP) != 0) { return }
    if enable {
        body.flags = body.flags | ENABLE_SLEEP
    } else {
        body.flags = body.flags & (0 - 1 - ENABLE_SLEEP)
        wake_body(w, body)
    }
    sync_body_flags(w, body)
}

body_set_motion_locks(id: BodyId, locks: MotionLocks) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_MOTION_LOCKS); rec_id(recorder, id.index1, id.generation); rec_motion_locks_value(recorder, locks); rec_end(recorder) }
    w = body_world(id)
    body = get_body_full_id(w, id)
    flags = body.flags & (0 - 1 - ALL_LOCKS)
    if locks.linear_x { flags = flags | LOCK_LINEAR_X }
    if locks.linear_y { flags = flags | LOCK_LINEAR_Y }
    if locks.linear_z { flags = flags | LOCK_LINEAR_Z }
    if locks.angular_x { flags = flags | LOCK_ANGULAR_X }
    if locks.angular_y { flags = flags | LOCK_ANGULAR_Y }
    if locks.angular_z { flags = flags | LOCK_ANGULAR_Z }
    if flags == body.flags { return }
    fixed_before = (body.flags & FIXED_ROTATION) == FIXED_ROTATION
    fixed_after = (flags & FIXED_ROTATION) == FIXED_ROTATION
    body.flags = flags
    sync_body_flags(w, body)
    // A locked axis stops now, not after the next step's positions.
    state = get_body_state(w, body)
    if state != null {
        if locks.linear_x { state.v.x = 0.0 }
        if locks.linear_y { state.v.y = 0.0 }
        if locks.linear_z { state.v.z = 0.0 }
        if locks.angular_x { state.w.x = 0.0 }
        if locks.angular_y { state.w.y = 0.0 }
        if locks.angular_z { state.w.z = 0.0 }
    }
    // Only fixing or freeing the rotation changes the mass (its inertia);
    // any other lock leaves the mass alone, a custom one included.
    if fixed_before != fixed_after { update_body_mass_data(w, body) }
}

body_get_motion_locks(id: BodyId) -> MotionLocks {
    flags = get_body_full_id(body_world(id), id).flags
    return MotionLocks { linear_x: (flags & LOCK_LINEAR_X) != 0, linear_y: (flags & LOCK_LINEAR_Y) != 0, linear_z: (flags & LOCK_LINEAR_Z) != 0,
                         angular_x: (flags & LOCK_ANGULAR_X) != 0, angular_y: (flags & LOCK_ANGULAR_Y) != 0, angular_z: (flags & LOCK_ANGULAR_Z) != 0 }
}

// The body's shape ids into an array, up to the capacity; returns how many.
body_get_shapes(id: BodyId, shape_ids: ShapeId[], capacity: int) -> int {
    w = body_world(id)
    body = get_body_full_id(w, id)
    count = 0
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX && count < capacity {
        s = world_shape_at(w, shape_id)
        shape_ids[count] = ShapeId { index1: shape_id + 1, world0: w.world_id, generation: s.generation }
        count = count + 1
        shape_id = s.next_shape_id
    }
    return count
}

// The bounds of every shape on the body.
body_compute_aabb(id: BodyId) -> AABB {
    w = body_world(id)
    body = get_body_full_id(w, id)
    if body.head_shape_id == NULL_INDEX {
        p = get_body_sim(w, body).transform.p
        return AABB { lower: p, upper: p }
    }
    s = world_shape_at(w, body.head_shape_id)
    box = s.aabb
    shape_id = s.next_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        box = AABB { lower: math.min_vec3(box.lower, s.aabb.lower), upper: math.max_vec3(box.upper, s.aabb.upper) }
        shape_id = s.next_shape_id
    }
    return box
}

// --- validation ----------------------------------------------------------------------------------------------

// Every live body's sim is where its indices say, with a state in the
// awake set and none elsewhere, every set's sims point back at live
// bodies, every island is consistent, and the shape lists close.
validate_solver_sets(w: *World) -> bool {
    // Every contact's encodings are its bodies' (b3ValidateSolverSets).
    i = 0
    while i < w.contacts.count {
        c = contact_at(w, i)
        if c.contact_id != NULL_INDEX {
            if c.encoded_body_sim_a != encode_body_sim_index(body_at(w, c.edge_a.body_id)) { return false }
            if c.encoded_body_sim_b != encode_body_sim_index(body_at(w, c.edge_b.body_id)) { return false }
        }
        i = i + 1
    }
    body_count = 0
    i = 0
    while i < w.bodies.count {
        body = body_at(w, i)
        if body.set_index != NULL_INDEX {
            body_count = body_count + 1
            if body.id != i { return false }
            set = solver_set_at(w, body.set_index)
            if set.set_index != body.set_index { return false }
            if body.local_index < 0 || body.local_index >= set.body_sims.count { return false }
            if body_sim_at(set, body.local_index).body_id != i { return false }
            if body.set_index == AWAKE_SET && set.body_states.count != set.body_sims.count { return false }
            if body.set_index == DISABLED_SET && body.island_id != NULL_INDEX { return false }
            if body.set_index >= AWAKE_SET && body.island_id == NULL_INDEX { return false }
            if body.island_id != NULL_INDEX && validate_island(w, body.island_id) == false { return false }
            // The shape list.
            count = 0
            shape_id = body.head_shape_id
            prev = NULL_INDEX
            while shape_id != NULL_INDEX {
                s = world_shape_at(w, shape_id)
                if s.id != shape_id || s.body_id != i || s.prev_shape_id != prev { return false }
                if body.set_index != DISABLED_SET && s.proxy_key == NULL_INDEX { return false }
                if body.set_index == DISABLED_SET && s.proxy_key != NULL_INDEX { return false }
                count = count + 1
                prev = shape_id
                shape_id = s.next_shape_id
            }
            if count != body.shape_count { return false }
        }
        i = i + 1
    }
    if body_count != basics.idpool_count(&w.body_id_pool) { return false }
    sim_count = 0
    i = 0
    while i < w.solver_sets.count {
        set = solver_set_at(w, i)
        if set.set_index != NULL_INDEX {
            if set.set_index != i { return false }
            j = 0
            while j < set.body_sims.count {
                body = body_at(w, body_sim_at(set, j).body_id)
                if body.set_index != i || body.local_index != j { return false }
                j = j + 1
            }
            sim_count = sim_count + set.body_sims.count
            if i >= FIRST_SLEEPING_SET && set.body_sims.count == 0 { return false }
            if i == STATIC_SET && set.island_sims.count != 0 { return false }
            if i == DISABLED_SET && set.island_sims.count != 0 { return false }
        }
        i = i + 1
    }
    if sim_count != body_count { return false }
    return true
}

// --- element access, continued ----------------------------------------------------------------------

contact_at(w: *World, id: int) -> *Contact { return (w.contacts.data + id * sizeof(Contact)) as *Contact }
joint_at(w: *World, id: int) -> *Joint { return (w.joints.data + id * sizeof(Joint)) as *Joint }
manifold_at(c: *Contact, index: int) -> *Manifold { return (c.manifolds + index * sizeof(Manifold)) as *Manifold }
graph_color(w: *World, index: int) -> *GraphColor { return (w.constraint_graph.colors + index * sizeof(GraphColor)) as *GraphColor }
contact_spec_at(color: *GraphColor, index: int) -> *ContactSpec { return (color.contacts.data + index * sizeof(ContactSpec)) as *ContactSpec }
joint_sim_at(b: *Buffer, index: int) -> *JointSim { return (b.data + index * sizeof(JointSim)) as *JointSim }
contact_link_at(island: *Island, index: int) -> *ContactLink { return (island.contacts.data + index * sizeof(ContactLink)) as *ContactLink }
joint_link_at(island: *Island, index: int) -> *JointLink { return (island.joints.data + index * sizeof(JointLink)) as *JointLink }

// A manifold's point, by index (the points are four named fields).
manifold_point_at(m: *Manifold, index: int) -> *ManifoldPoint { return ((m as ptr) + index * sizeof(ManifoldPoint)) as *ManifoldPoint }

world_contact_count(w: *World) -> int { return basics.idpool_count(&w.contact_id_pool) }
get_contact(w: *World, contact_id: int) -> *Contact { return contact_at(w, contact_id) }

contact_is_valid(id: ContactId) -> bool {
    if id.world0 < 0 || id.world0 >= MAX_WORLDS { return false }
    worlds_ready()
    w = world_at(id.world0)
    if w.in_use == false { return false }
    if id.index1 < 1 || id.index1 > w.contacts.count { return false }
    c = contact_at(w, id.index1 - 1)
    return c.contact_id == id.index1 - 1 && c.generation == id.generation
}

// One contact's shapes and manifolds by its id (b3Contact_GetData): the
// manifolds are the contact's own, read until the next step; an id that is
// not a contact's gives none.
contact_get_data(id: ContactId) -> ContactData {
    if contact_is_valid(id) == false {
        return ContactData { contact_id: id, shape_id_a: null_shape_id(), shape_id_b: null_shape_id(), manifolds: null, manifold_count: 0 }
    }
    w = world_at(id.world0)
    c = contact_at(w, id.index1 - 1)
    manifolds = null
    count = 0
    if c.manifold_count > 0 {
        manifolds = c.manifolds
        count = c.manifold_count
    }
    return ContactData { contact_id: id, shape_id_a: make_shape_id(w, world_shape_at(w, c.shape_id_a)), shape_id_b: make_shape_id(w, world_shape_at(w, c.shape_id_b)),
                         manifolds: manifolds, manifold_count: count }
}

make_contact_id(w: *World, c: *Contact) -> ContactId { return ContactId { index1: c.contact_id + 1, world0: w.world_id, generation: c.generation } }
make_shape_id(w: *World, s: *WorldShape) -> ShapeId { return ShapeId { index1: s.id + 1, world0: w.world_id, generation: s.generation } }

// The events of the last collide pass.
world_contact_begin_event_count(w: *World) -> int { return w.contact_begin_events.count }
world_contact_begin_event(w: *World, index: int) -> ContactBeginTouchEvent {
    events = w.contact_begin_events.data as ContactBeginTouchEvent[]
    return events[index]
}
end_events(w: *World) -> *Buffer {
    if w.end_event_index == 0 { return &w.contact_end_events0 }
    return &w.contact_end_events1
}
world_contact_end_event_count(w: *World) -> int { return end_events(w).count }
world_contact_end_event(w: *World, index: int) -> ContactEndTouchEvent {
    events = end_events(w).data as ContactEndTouchEvent[]
    return events[index]
}

// --- the constraint graph ------------------------------------------------------------------------------

create_graph(g: *ConstraintGraph, body_capacity: int) {
    g.colors = basics.alloc(GRAPH_COLOR_COUNT * sizeof(GraphColor))
    capacity = math.max_int(body_capacity, 8)
    i = 0
    while i < GRAPH_COLOR_COUNT {
        color = (g.colors + i * sizeof(GraphColor)) as *GraphColor
        if i < OVERFLOW_INDEX {
            color.body_set = basics.bitset_create(capacity)
            basics.bitset_set_count_and_clear(&color.body_set, capacity)
        }
        color.joint_sims = basics.buffer_create(sizeof(JointSim), 0)
        color.convex_contacts = basics.ints_create(0)
        color.contacts = basics.buffer_create(sizeof(ContactSpec), 0)
        i = i + 1
    }
}

destroy_graph(g: *ConstraintGraph) {
    i = 0
    while i < GRAPH_COLOR_COUNT {
        color = (g.colors + i * sizeof(GraphColor)) as *GraphColor
        if i < OVERFLOW_INDEX { basics.bitset_destroy(&color.body_set) }
        basics.buffer_destroy(&color.joint_sims)
        basics.ints_destroy(&color.convex_contacts)
        basics.buffer_destroy(&color.contacts)
        i = i + 1
    }
    basics.free_bytes(g.colors, GRAPH_COLOR_COUNT * sizeof(GraphColor))
    g.colors = null
}

// The first colour where neither dynamic body is taken: dynamic pairs
// from the front, pairs with a static or kinematic body from the back
// (they get priority), the overflow when none is free.
assign_color(g: *ConstraintGraph, body_id_a: int, body_id_b: int, kind_a: int, kind_b: int) -> int {
    if kind_a == BODY_DYNAMIC && kind_b == BODY_DYNAMIC {
        i = 0
        while i < DYNAMIC_COLOR_COUNT {
            color = (g.colors + i * sizeof(GraphColor)) as *GraphColor
            if basics.bitset_get(&color.body_set, body_id_a) == false && basics.bitset_get(&color.body_set, body_id_b) == false {
                basics.bitset_set_grow(&color.body_set, body_id_a)
                basics.bitset_set_grow(&color.body_set, body_id_b)
                return i
            }
            i = i + 1
        }
    } else if kind_a == BODY_DYNAMIC {
        i = OVERFLOW_INDEX - 1
        while i >= 1 {
            color = (g.colors + i * sizeof(GraphColor)) as *GraphColor
            if basics.bitset_get(&color.body_set, body_id_a) == false {
                basics.bitset_set_grow(&color.body_set, body_id_a)
                return i
            }
            i = i - 1
        }
    } else if kind_b == BODY_DYNAMIC {
        i = OVERFLOW_INDEX - 1
        while i >= 1 {
            color = (g.colors + i * sizeof(GraphColor)) as *GraphColor
            if basics.bitset_get(&color.body_set, body_id_b) == false {
                basics.bitset_set_grow(&color.body_set, body_id_b)
                return i
            }
            i = i - 1
        }
    }
    return OVERFLOW_INDEX
}

// A touching contact into a colour: convex contacts into the wide array,
// mesh contacts and the overflow's into the scalar one.
add_contact_to_graph(w: *World, c: *Contact) {
    body_a = body_at(w, c.edge_a.body_id)
    body_b = body_at(w, c.edge_b.body_id)
    color_index = assign_color(&w.constraint_graph, body_a.id, body_b.id, body_a.kind, body_b.kind)
    is_scalar = (c.flags & SIM_MESH_CONTACT) != 0 || color_index == OVERFLOW_INDEX
    color = graph_color(w, color_index)
    c.color_index = color_index
    c.encoded_body_sim_a = encode_body_sim_index(body_a)
    c.encoded_body_sim_b = encode_body_sim_index(body_b)
    if is_scalar {
        c.local_index = color.contacts.count
        index = basics.buffer_push(&color.contacts)
        spec = contact_spec_at(color, index)
        spec.contact_id = c.contact_id
        spec.manifold_start = 0
        spec.manifold_count = c.manifold_count
    } else {
        c.local_index = color.convex_contacts.count
        basics.ints_push(&color.convex_contacts, c.contact_id)
    }
}

remove_contact_from_graph(w: *World, body_id_a: int, body_id_b: int, color_index: int, local_index: int, mesh_contact: bool) {
    color = graph_color(w, color_index)
    if color_index != OVERFLOW_INDEX {
        basics.bitset_clear(&color.body_set, body_id_a)
        basics.bitset_clear(&color.body_set, body_id_b)
    }
    if mesh_contact || color_index == OVERFLOW_INDEX {
        moved = basics.buffer_remove_swap(&color.contacts, local_index)
        if moved != NULL_INDEX && moved != local_index {
            contact_at(w, contact_spec_at(color, local_index).contact_id).local_index = local_index
        }
    } else {
        moved = basics.ints_remove_swap(&color.convex_contacts, local_index)
        if moved != NULL_INDEX && moved != local_index {
            contact_at(w, basics.ints_get(&color.convex_contacts, local_index)).local_index = local_index
        }
    }
}

// --- contacts ------------------------------------------------------------------------------------------------

// The pairs of kinds that collide, with the mesh-like or larger kind first.
contact_pair_supported(kind_a: int, kind_b: int) -> bool {
    convex_b = kind_b == KIND_SPHERE || kind_b == KIND_CAPSULE || kind_b == KIND_HULL
    if convex_b == false { return false }
    return kind_a == KIND_SPHERE && kind_b == KIND_SPHERE ||
           kind_a == KIND_CAPSULE && (kind_b == KIND_SPHERE || kind_b == KIND_CAPSULE) ||
           kind_a == KIND_HULL || kind_a == KIND_MESH || kind_a == KIND_HEIGHT_FIELD || kind_a == KIND_COMPOUND
}

// Whether the pair as given is the primary order, or must be flipped.
contact_pair_primary(kind_a: int, kind_b: int) -> bool {
    if kind_a == kind_b { return true }
    return contact_pair_supported(kind_a, kind_b)
}

// A contact between two shapes (a compound's child named), non-touching,
// in the awake set if either body is awake and the disabled set
// otherwise, linked into both bodies' lists and the broad phase's pair set.
create_contact(w: *World, shape_a: *WorldShape, shape_b: *WorldShape, child_index: int) {
    kind_a = shape_a.geometry.kind
    kind_b = shape_b.geometry.kind
    if contact_pair_supported(kind_a, kind_b) == false && contact_pair_supported(kind_b, kind_a) == false { return }
    if contact_pair_primary(kind_a, kind_b) == false {
        create_contact(w, shape_b, shape_a, child_index)
        return
    }
    body_a = body_at(w, shape_a.body_id)
    body_b = body_at(w, shape_b.body_id)
    set_index = DISABLED_SET
    if body_a.set_index == AWAKE_SET || body_b.set_index == AWAKE_SET { set_index = AWAKE_SET }
    set = solver_set_at(w, set_index)
    contact_id = basics.idpool_alloc(&w.contact_id_pool)
    if contact_id == w.contacts.count {
        index = basics.buffer_push(&w.contacts)
        contact_at(w, index).generation = 0
    }
    c = contact_at(w, contact_id)
    generation = c.generation
    memset(c as ptr, 0, sizeof(Contact))
    c.contact_id = contact_id
    c.generation = generation + 1
    c.set_index = set_index
    c.color_index = NULL_INDEX
    c.local_index = set.contact_indices.count
    c.island_id = NULL_INDEX
    c.island_index = NULL_INDEX
    c.encoded_body_sim_a = encode_body_sim_index(body_a)
    c.encoded_body_sim_b = encode_body_sim_index(body_b)
    c.shape_id_a = shape_a.id
    c.shape_id_b = shape_b.id
    c.child_index = child_index
    c.manifolds = null
    c.manifold_count = 0
    flags = 0
    if (body_a.flags & ENABLE_CONTACT_RECYCLING) != 0 && (body_b.flags & ENABLE_CONTACT_RECYCLING) != 0 { flags = flags | CONTACT_RECYCLE }
    if kind_a == KIND_MESH || kind_a == KIND_HEIGHT_FIELD { flags = flags | SIM_MESH_CONTACT }
    if kind_a == KIND_COMPOUND {
        child = compound.get_compound_child(shape_a.geometry.compound, child_index)
        if child.kind == KIND_MESH { flags = flags | SIM_MESH_CONTACT }
    }
    if body_a.kind == BODY_STATIC || body_b.kind == BODY_STATIC { flags = flags | CONTACT_STATIC }
    if (shape_a.flags & SHAPE_ENABLE_CONTACT_EVENTS) != 0 || (shape_b.flags & SHAPE_ENABLE_CONTACT_EVENTS) != 0 { flags = flags | CONTACT_ENABLE_CONTACT_EVENTS }
    if (shape_a.flags & SHAPE_ENABLE_SPECULATIVE) != 0 && (shape_b.flags & SHAPE_ENABLE_SPECULATIVE) != 0 { flags = flags | ENABLE_SPECULATIVE_POINTS }
    if (shape_a.flags & SHAPE_ENABLE_PRE_SOLVE_EVENTS) != 0 || (shape_b.flags & SHAPE_ENABLE_PRE_SOLVE_EVENTS) != 0 { flags = flags | SIM_ENABLE_PRE_SOLVE_EVENTS }
    c.flags = flags
    if (flags & SIM_MESH_CONTACT) != 0 {
        mesh_caches = (&c.caches) as MeshContactCache[]
        mesh_caches[0] = mesh_contact.mesh_contact_cache_create()
    } else {
        convex_caches = (&c.caches) as TriangleCache[]
        convex_caches[0] = TriangleCache { triangle_index: NULL_INDEX, simplex_cache: distance.empty_cache(), sat_cache: manifold.empty_sat_cache() }
    }
    // Into body A's list.
    c.edge_a = ContactEdge { body_id: shape_a.body_id, prev_key: NULL_INDEX, next_key: body_a.head_contact_key }
    key_a = (contact_id << 1) | 0
    if body_a.head_contact_key != NULL_INDEX { set_contact_edge_prev(w, body_a.head_contact_key, key_a) }
    body_a.head_contact_key = key_a
    body_a.contact_count = body_a.contact_count + 1
    // Into body B's list.
    c.edge_b = ContactEdge { body_id: shape_b.body_id, prev_key: NULL_INDEX, next_key: body_b.head_contact_key }
    key_b = (contact_id << 1) | 1
    if body_b.head_contact_key != NULL_INDEX { set_contact_edge_prev(w, body_b.head_contact_key, key_b) }
    body_b.head_contact_key = key_b
    body_b.contact_count = body_b.contact_count + 1
    broad_phase.add_pair(&w.broad_phase, basics.shape_pair_key(shape_a.id, shape_b.id, child_index))
    basics.ints_push(&set.contact_indices, contact_id)
    // The rolling resistance, assumed not to change.
    radius_a = 0.0
    if kind_a == KIND_SPHERE { radius_a = shape_a.geometry.sphere.radius }
    if kind_a == KIND_CAPSULE { radius_a = shape_a.geometry.capsule.radius }
    radius_b = 0.0
    if kind_b == KIND_SPHERE { radius_b = shape_b.geometry.sphere.radius }
    if kind_b == KIND_CAPSULE { radius_b = shape_b.geometry.capsule.radius }
    c.rolling_resistance = math.max_float(shape_a.material.rolling_resistance, shape_b.material.rolling_resistance) * math.max_float(radius_a, radius_b)
}

// The edge a key names (the contact's A or B side).
contact_edge_next(w: *World, key: int) -> int {
    c = contact_at(w, key >> 1)
    if (key & 1) == 0 { return c.edge_a.next_key }
    return c.edge_b.next_key
}

set_contact_edge_prev(w: *World, key: int, prev: int) {
    c = contact_at(w, key >> 1)
    if (key & 1) == 0 { c.edge_a.prev_key = prev } else { c.edge_b.prev_key = prev }
}

set_contact_edge_next(w: *World, key: int, next: int) {
    c = contact_at(w, key >> 1)
    if (key & 1) == 0 { c.edge_a.next_key = next } else { c.edge_b.next_key = next }
}

// The world's manifold lock: a word swapped from 0 to 1, spun on while
// another worker holds it. It is held for a free-list pop or push.
lock_manifolds(w: *World) {
    while native.atomic_cas((&w.manifold_lock) as ptr, 0, 1) == false { native.pause() }
}

unlock_manifolds(w: *World) { native.atomic_store((&w.manifold_lock) as ptr, 0) }

free_manifolds(w: *World, c: *Contact) {
    if c.manifold_count > 0 {
        lock_manifolds(w)
        allocators = w.manifold_allocators.data as BlockAllocator[]
        basics.block_free(&allocators[c.manifold_count - 1], c.manifolds)
        unlock_manifolds(w)
    }
    c.manifolds = null
    c.manifold_count = 0
}

// `count` manifolds, zeroed, from the allocator for that many.
allocate_manifolds(w: *World, c: *Contact, count: int) {
    free_manifolds(w, c)
    if count <= 0 { return }
    lock_manifolds(w)
    while w.manifold_allocators.count < count {
        at = basics.buffer_push(&w.manifold_allocators)
        allocators = w.manifold_allocators.data as BlockAllocator[]
        allocators[at] = basics.block_allocator_create((at + 1) * sizeof(Manifold))
    }
    allocators = w.manifold_allocators.data as BlockAllocator[]
    block = basics.block_allocate(&allocators[count - 1])
    unlock_manifolds(w)
    memset(block, 0, count * sizeof(Manifold))
    c.manifolds = block
    c.manifold_count = count
}

// The contact out of the pair set, both bodies' lists, its island, its
// colour or its set's indices; its bodies woken when asked and it was touching.
destroy_contact(w: *World, c: *Contact, wake_bodies: bool) {
    broad_phase.remove_pair(&w.broad_phase, basics.shape_pair_key(c.shape_id_a, c.shape_id_b, c.child_index))
    free_manifolds(w, c)
    body_id_a = c.edge_a.body_id
    body_id_b = c.edge_b.body_id
    body_a = body_at(w, body_id_a)
    body_b = body_at(w, body_id_b)
    flags = c.flags
    touching = (flags & CONTACT_TOUCHING) != 0
    if touching && (flags & CONTACT_ENABLE_CONTACT_EVENTS) != 0 {
        push_end_event(w, c)
    }
    contact_id = c.contact_id
    // Out of body A's list.
    if c.edge_a.prev_key != NULL_INDEX { set_contact_edge_next(w, c.edge_a.prev_key, c.edge_a.next_key) }
    if c.edge_a.next_key != NULL_INDEX { set_contact_edge_prev(w, c.edge_a.next_key, c.edge_a.prev_key) }
    if body_a.head_contact_key == ((contact_id << 1) | 0) { body_a.head_contact_key = c.edge_a.next_key }
    body_a.contact_count = body_a.contact_count - 1
    // Out of body B's list.
    if c.edge_b.prev_key != NULL_INDEX { set_contact_edge_next(w, c.edge_b.prev_key, c.edge_b.next_key) }
    if c.edge_b.next_key != NULL_INDEX { set_contact_edge_prev(w, c.edge_b.next_key, c.edge_b.prev_key) }
    if body_b.head_contact_key == ((contact_id << 1) | 1) { body_b.head_contact_key = c.edge_b.next_key }
    body_b.contact_count = body_b.contact_count - 1
    if (flags & SIM_MESH_CONTACT) != 0 { mesh_contact.mesh_contact_cache_destroy(mesh_cache_of(c)) }
    if c.island_id != NULL_INDEX { unlink_contact(w, c) }
    if c.color_index != NULL_INDEX {
        remove_contact_from_graph(w, body_id_a, body_id_b, c.color_index, c.local_index, (flags & SIM_MESH_CONTACT) != 0)
    } else {
        set = solver_set_at(w, c.set_index)
        local_index = c.local_index
        moved = basics.ints_remove_swap(&set.contact_indices, local_index)
        if moved != NULL_INDEX && moved != local_index {
            contact_at(w, basics.ints_get(&set.contact_indices, local_index)).local_index = local_index
        }
    }
    c.contact_id = NULL_INDEX
    c.set_index = NULL_INDEX
    c.color_index = NULL_INDEX
    c.local_index = NULL_INDEX
    basics.idpool_free(&w.contact_id_pool, contact_id)
    if wake_bodies && touching {
        wake_body(w, body_a)
        wake_body(w, body_b)
    }
}

push_end_event(w: *World, c: *Contact) {
    shape_a = world_shape_at(w, c.shape_id_a)
    shape_b = world_shape_at(w, c.shape_id_b)
    events = end_events(w)
    index = basics.buffer_push(events)
    target = (events.data + index * sizeof(ContactEndTouchEvent)) as *ContactEndTouchEvent
    target.shape_id_a = make_shape_id(w, shape_a)
    target.shape_id_b = make_shape_id(w, shape_b)
    target.contact_id = make_contact_id(w, c)
}

push_begin_event(w: *World, c: *Contact) {
    shape_a = world_shape_at(w, c.shape_id_a)
    shape_b = world_shape_at(w, c.shape_id_b)
    index = basics.buffer_push(&w.contact_begin_events)
    target = (w.contact_begin_events.data + index * sizeof(ContactBeginTouchEvent)) as *ContactBeginTouchEvent
    target.shape_id_a = make_shape_id(w, shape_a)
    target.shape_id_b = make_shape_id(w, shape_b)
    target.contact_id = make_contact_id(w, c)
}

// Every contact on a body destroyed (its joints with the joint layer).
destroy_body_contacts(w: *World, body: *Body, wake_bodies: bool) {
    key = body.head_contact_key
    while key != NULL_INDEX {
        c = contact_at(w, key >> 1)
        key = contact_edge_next(w, key)
        destroy_contact(w, c, wake_bodies)
    }
}

// Every contact on a shape destroyed.
destroy_shape_contacts(w: *World, s: *WorldShape, wake_bodies: bool) {
    body = body_at(w, s.body_id)
    key = body.head_contact_key
    while key != NULL_INDEX {
        c = contact_at(w, key >> 1)
        key = contact_edge_next(w, key)
        if c.shape_id_a == s.id || c.shape_id_b == s.id { destroy_contact(w, c, wake_bodies) }
    }
}

// The contacts' cached relative transforms invalidated (a centre of mass moved).
invalidate_body_contacts(w: *World, body: *Body) {
    key = body.head_contact_key
    while key != NULL_INDEX {
        c = contact_at(w, key >> 1)
        c.flags = c.flags & (0 - 1 - RELATIVE_TRANSFORM_VALID)
        key = contact_edge_next(w, key)
    }
}

var g_local_points: ptr = null   // LocalManifoldPoint[MAX_MANIFOLD_POINTS]
local_points() -> ptr { return native.scratch(g_local_points, MAX_MANIFOLD_POINTS * sizeof(LocalManifoldPoint)) }
var g_old_points: ptr = null     // ManifoldPoint[MAX_MANIFOLD_POINTS]
old_points() -> ptr { return native.scratch(g_old_points, MAX_MANIFOLD_POINTS * sizeof(ManifoldPoint)) }

contact_scratch_ready() {
    if g_local_points == null {
        g_local_points = basics.alloc(native.MAX_WORKERS * (MAX_MANIFOLD_POINTS * sizeof(LocalManifoldPoint)))
        g_old_points = basics.alloc(native.MAX_WORKERS * (MAX_MANIFOLD_POINTS * sizeof(ManifoldPoint)))
    }
}

// The manifold of two convex shapes (A's kind first: sphere < capsule <
// hull), computed in A's frame, its points as world-space anchors
// relative to each shape's origin, the old points' impulses kept by feature.
compute_convex_manifold(w: *World, c: *Contact, geometry_a: *Shape, xf_a: Transform, geometry_b: *Shape, xf_b: Transform) -> bool {
    contact_scratch_ready()
    kind_a = geometry_a.kind
    kind_b = geometry_b.kind
    m = manifold.local_manifold(local_points())
    transform_b_to_a = math.inv_mul_transforms(xf_a, xf_b)
    if kind_a == KIND_SPHERE {
        manifold.collide_spheres(&m, MAX_MANIFOLD_POINTS, geometry_a.sphere, geometry_b.sphere, transform_b_to_a)
    } else if kind_a == KIND_CAPSULE {
        if kind_b == KIND_SPHERE { manifold.collide_capsule_and_sphere(&m, MAX_MANIFOLD_POINTS, geometry_a.capsule, geometry_b.sphere, transform_b_to_a) }
        else { manifold.collide_capsules(&m, MAX_MANIFOLD_POINTS, geometry_a.capsule, geometry_b.capsule, transform_b_to_a) }
    } else {
        convex = convex_cache_of(c)
        if kind_b == KIND_SPHERE { manifold.collide_hull_and_sphere(&m, MAX_MANIFOLD_POINTS, geometry_a.hull, geometry_b.sphere, transform_b_to_a, &convex.simplex_cache) }
        else if kind_b == KIND_CAPSULE { manifold.collide_hull_and_capsule(&m, MAX_MANIFOLD_POINTS, geometry_a.hull, geometry_b.capsule, transform_b_to_a, &convex.simplex_cache) }
        else {
            manifold.collide_hulls(&m, MAX_MANIFOLD_POINTS, geometry_a.hull, geometry_b.hull, transform_b_to_a, &convex.sat_cache)
            tc = task_context(w)
            tc.sat_call_count = tc.sat_call_count + 1
            tc.sat_cache_hit_count = tc.sat_cache_hit_count + convex.sat_cache.hit
        }
    }
    if m.point_count == 0 {
        free_manifolds(w, c)
        return false
    }
    old = old_points() as ManifoldPoint[]
    old_count = 0
    if c.manifold_count == 0 {
        allocate_manifolds(w, c, 1)
    } else {
        first = manifold_at(c, 0)
        old_count = first.point_count
        i = 0
        while i < old_count {
            old[i] = point_copy(manifold_point_at(first, i))
            i = i + 1
        }
    }
    target = manifold_at(c, 0)
    target.point_count = m.point_count
    matrix_a = math.make_matrix_from_quat(xf_a.q)
    target.normal = math.narrow3(math.mul_mv(matrix_a, m.normal))
    offset = math.sub(xf_a.p, xf_b.p)
    i = 0
    while i < m.point_count {
        source = manifold.manifold_point(&m, i)
        p = manifold_point_at(target, i)
        anchor_a = math.mul_mv(matrix_a, source.point)
        p.anchor_a = math.narrow3(anchor_a)
        p.anchor_b = math.narrow3(math.add(anchor_a, offset))
        p.separation = source.separation
        p.feature_id = manifold.make_feature_id(source.pair)
        p.triangle_index = NULL_INDEX
        p.normal_velocity = 0.0
        p.total_normal_impulse = 0.0
        p.persisted = false
        p.normal_impulse = 0.0
        j = 0
        while j < old_count {
            if old[j].feature_id == p.feature_id && p.persisted == false {
                p.normal_impulse = old[j].normal_impulse
                p.persisted = true
                old[j].feature_id = 0 - 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return true
}

point_copy(p: *ManifoldPoint) -> ManifoldPoint {
    return ManifoldPoint { anchor_a: p.anchor_a, anchor_b: p.anchor_b, separation: p.separation, base_separation: p.base_separation,
                           normal_impulse: p.normal_impulse, total_normal_impulse: p.total_normal_impulse, normal_velocity: p.normal_velocity,
                           feature_id: p.feature_id, triangle_index: p.triangle_index, persisted: p.persisted }
}

// The friction and restitution through the world's callbacks.
mix_materials(w: *World, c: *Contact, material_a: SurfaceMaterial, material_b: SurfaceMaterial) {
    friction_fn = w.friction_callback
    restitution_fn = w.restitution_callback
    c.friction = friction_fn(material_a.friction, material_a.user_material_id, material_b.friction, material_b.user_material_id)
    c.restitution = restitution_fn(material_a.restitution, material_a.user_material_id, material_b.restitution, material_b.user_material_id)
}

// The convex manifold, flipped when the pair was flipped, with the
// materials mixed, the rolling resistance and the tangent velocity.
update_convex_contact(w: *World, c: *Contact, geometry_a: *Shape, material_a: SurfaceMaterial, flags_a: int, xf_a: Transform,
                      geometry_b: *Shape, material_b: SurfaceMaterial, flags_b: int, xf_b: Transform, flip: bool) -> bool {
    touching = compute_convex_manifold(w, c, geometry_a, xf_a, geometry_b, xf_b)
    if touching == false { return false }
    if flip {
        // The feature ids need only match, and flipping is consistent.
        m = manifold_at(c, 0)
        m.normal = Vec3f { x: 0.0 - m.normal.x, y: 0.0 - m.normal.y, z: 0.0 - m.normal.z }
        i = 0
        while i < m.point_count {
            p = manifold_point_at(m, i)
            swap = p.anchor_a
            p.anchor_a = p.anchor_b
            p.anchor_b = swap
            i = i + 1
        }
    }
    mix_materials(w, c, material_a, material_b)
    if material_a.rolling_resistance > 0.0 || material_b.rolling_resistance > 0.0 {
        radius_a = 0.0
        if geometry_a.kind == KIND_SPHERE { radius_a = geometry_a.sphere.radius }
        else if geometry_a.kind == KIND_CAPSULE { radius_a = geometry_a.capsule.radius }
        else if geometry_a.kind == KIND_HULL { radius_a = 0.25 * geometry_a.hull.inner_radius }
        radius_b = 0.0
        if geometry_b.kind == KIND_SPHERE { radius_b = geometry_b.sphere.radius }
        else if geometry_b.kind == KIND_CAPSULE { radius_b = geometry_b.capsule.radius }
        else if geometry_b.kind == KIND_HULL { radius_b = 0.25 * geometry_b.hull.inner_radius }
        c.rolling_resistance = math.max_float(material_a.rolling_resistance, material_b.rolling_resistance) * math.max_float(radius_a, radius_b)
    } else {
        c.rolling_resistance = 0.0
    }
    c.tangent_velocity = math.narrow3(math.sub(math.rotate_vector(xf_a.q, material_a.tangent_velocity), math.rotate_vector(xf_b.q, material_b.tangent_velocity)))
    if (flags_a & SHAPE_ENABLE_HIT_EVENTS) != 0 || (flags_b & SHAPE_ENABLE_HIT_EVENTS) != 0 {
        c.flags = c.flags | SIM_ENABLE_HIT_EVENT
    } else {
        c.flags = c.flags & (0 - 1 - SIM_ENABLE_HIT_EVENT)
    }
    return true
}

// A mesh or height field shape (or a compound's mesh child) against the
// convex shape B: the clusters from the mesh contact become manifolds
// matched to the old ones by normal (their friction, rolling and twist
// impulses kept) and by feature and triangle per point (the normal
// impulse kept); the materials per triangle averaged.
update_mesh_contact(w: *World, c: *Contact, mesh_geometry: *Shape, mesh_shape: *WorldShape, material_map: ptr, material_map_count: int, xf_a: Transform,
                    shape_b: *WorldShape, xf_b: Transform, is_fast: bool) -> bool {
    contact_scratch_ready()
    bounds_b = shape_b.aabb
    enable_speculative = (c.flags & ENABLE_SPECULATIVE_POINTS) != 0
    tc = task_context(w)
    mark = tc.arena.index
    r = mesh_contact.compute_mesh_manifolds(mesh_cache_of(c), mesh_geometry, xf_a, &shape_b.geometry, xf_b, bounds_b, is_fast, enable_speculative, &tc.arena)
    tc.sat_call_count = tc.sat_call_count + r.sat_calls
    tc.sat_cache_hit_count = tc.sat_cache_hit_count + r.sat_cache_hits
    cluster_count = r.cluster_count
    if cluster_count == 0 {
        free_manifolds(w, c)
        tc.arena.index = mark
        return false
    }
    // The old manifolds, kept aside for the matching.
    old_count = c.manifold_count
    old_block = null
    if old_count > 0 {
        old_block = basics.arena_bump(&tc.arena, old_count * sizeof(Manifold))
        memcpy(old_block, c.manifolds, old_count * sizeof(Manifold))
    }
    if old_count != cluster_count {
        allocate_manifolds(w, c, cluster_count)
    } else {
        memset(c.manifolds, 0, cluster_count * sizeof(Manifold))
    }
    consumed_block = null
    consumed = null as int[]
    if old_count > 0 {
        consumed_block = basics.arena_bump(&tc.arena, old_count * 4)
        memset(consumed_block, 0, old_count * 4)
        consumed = consumed_block as int[]
    }
    matrix_b = math.make_matrix_from_quat(xf_b.q)
    offset_a = math.sub(xf_b.p, xf_a.p)
    normal_match_tolerance = 0.995
    clusters = r.clusters as Cluster[]
    i = 0
    while i < cluster_count {
        cluster = clusters[i]
        m = manifold_at(c, i)
        m.point_count = cluster.point_count
        m.normal = math.narrow3(math.mul_mv(matrix_b, cluster.manifold_normal))
        best_dot = normal_match_tolerance
        best_index = NULL_INDEX
        j = 0
        while j < old_count {
            if consumed[j] == 0 {
                old_m = (old_block + j * sizeof(Manifold)) as *Manifold
                d = math.dot(math.widen3(old_m.normal), math.widen3(m.normal))
                if d > best_dot {
                    best_index = j
                    best_dot = d
                }
            }
            j = j + 1
        }
        matched = null as *Manifold
        if best_index != NULL_INDEX {
            matched = (old_block + best_index * sizeof(Manifold)) as *Manifold
            m.friction_impulse = matched.friction_impulse
            m.rolling_impulse = matched.rolling_impulse
            m.twist_impulse = matched.twist_impulse
            consumed[best_index] = 1
        }
        points = cluster.points as LocalManifoldPoint[]
        j = 0
        while j < cluster.point_count {
            source = points[j]
            p = manifold_point_at(m, j)
            // The points were computed in B's frame.
            anchor_b = math.mul_mv(matrix_b, source.point)
            p.anchor_b = math.narrow3(anchor_b)
            p.anchor_a = math.narrow3(math.add(anchor_b, offset_a))
            p.separation = source.separation - mesh_contact.MESH_REST_OFFSET
            p.feature_id = manifold.make_feature_id(source.pair)
            p.triangle_index = source.triangle_index
            p.normal_impulse = 0.0
            p.total_normal_impulse = 0.0
            p.normal_velocity = 0.0
            p.persisted = false
            if matched != null {
                k = 0
                while k < matched.point_count {
                    old_p = manifold_point_at(matched, k)
                    if p.persisted == false && p.feature_id == old_p.feature_id && p.triangle_index == old_p.triangle_index {
                        p.normal_impulse = old_p.normal_impulse
                        p.persisted = true
                        old_p.triangle_index = NULL_INDEX
                    }
                    k = k + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    // The materials: per triangle when the mesh carries several.
    material_b = shape_b.material
    tangent_velocity_a = math.vec3_zero()
    friction_fn = w.friction_callback
    restitution_fn = w.restitution_callback
    if mesh_shape.material_count > 1 {
        friction = 0.0
        restitution = 0.0
        sample_count = 0.0
        materials_a = mesh_shape.materials as SurfaceMaterial[]
        i = 0
        while i < cluster_count {
            m = manifold_at(c, i)
            j = 0
            while j < m.point_count {
                triangle_index = manifold_point_at(m, j).triangle_index
                material_index = 0
                if mesh_geometry.kind == KIND_MESH {
                    indices = mesh.mesh_material_indices(mesh_geometry.mesh.data)
                    material_index = indices[triangle_index]
                    if material_map != null {
                        map = material_map as int[]
                        material_index = map[math.clamp_int(material_index, 0, material_map_count - 1)]
                    }
                } else {
                    cell_materials = height_field.height_field_material_indices(mesh_geometry.height_field)
                    material_index = cell_materials[triangle_index >> 1] as int
                }
                material_index = math.clamp_int(material_index, 0, mesh_shape.material_count - 1)
                material_a = materials_a[material_index]
                friction = friction + friction_fn(material_a.friction, material_a.user_material_id, material_b.friction, material_b.user_material_id)
                restitution = restitution + restitution_fn(material_a.restitution, material_a.user_material_id, material_b.restitution, material_b.user_material_id)
                tangent_velocity_a = math.add(tangent_velocity_a, material_a.tangent_velocity)
                sample_count = sample_count + 1.0
                j = j + 1
            }
            i = i + 1
        }
        if sample_count > 0.0 {
            inv = 1.0 / sample_count
            c.friction = inv * friction
            c.restitution = inv * restitution
            tangent_velocity_a = math.mul_sv(inv, tangent_velocity_a)
        }
    } else {
        mix_materials(w, c, mesh_shape.material, material_b)
        tangent_velocity_a = mesh_shape.material.tangent_velocity
    }
    tangent_velocity_a = math.rotate_vector(xf_a.q, tangent_velocity_a)
    radius_b = 0.0
    if shape_b.geometry.kind == KIND_SPHERE { radius_b = shape_b.geometry.sphere.radius }
    else if shape_b.geometry.kind == KIND_CAPSULE { radius_b = shape_b.geometry.capsule.radius }
    else if shape_b.geometry.kind == KIND_HULL { radius_b = shape_b.geometry.hull.inner_radius }
    c.rolling_resistance = material_b.rolling_resistance * radius_b
    c.tangent_velocity = math.narrow3(math.sub(tangent_velocity_a, math.rotate_vector(xf_b.q, material_b.tangent_velocity)))
    tc.arena.index = mark
    return true
}

var g_child_geometry: ptr = null   // Shape: a compound's child as a shape
child_geometry() -> ptr { return native.scratch(g_child_geometry, sizeof(Shape)) }

// The contact's manifolds and whether it touches, for any pair: a
// compound's child stands in for the compound (its transform composed),
// a mesh or height field goes through the mesh contact, the rest
// through the convex manifolds; the anchors end relative to the centres
// of mass.
child_scratch_ready() {
    if g_child_geometry == null {
        g_child_geometry = basics.alloc(native.MAX_WORKERS * (sizeof(Shape)))
    }
}

update_contact(w: *World, c: *Contact, shape_a: *WorldShape, local_center_a: Vec3, xf_a: Transform, shape_b: *WorldShape,
               local_center_b: Vec3, xf_b: Transform, is_fast: bool) -> bool {
    child_scratch_ready()
    touching = false
    convex = true                  // a mesh or height field contact has no pre-solve, as the reference's has none
    kind_a = shape_a.geometry.kind
    if kind_a == KIND_COMPOUND {
        child = compound.get_compound_child(shape_a.geometry.compound, c.child_index)
        child_geometry = child_geometry() as *Shape
        materials_a = shape_a.materials as SurfaceMaterial[]
        child_material = materials_a[math.clamp_int(child.material_index0, 0, shape_a.material_count - 1)]
        if child.kind == KIND_CAPSULE {
            cg = shape.capsule_shape(child.capsule, 0.0)
            copy_geometry(child_geometry, cg)
            if shape_b.geometry.kind == KIND_HULL {
                touching = update_convex_contact(w, c, &shape_b.geometry, shape_b.material, shape_b.flags, xf_b, child_geometry, child_material, shape_a.flags, xf_a, true)
            } else {
                touching = update_convex_contact(w, c, child_geometry, child_material, shape_a.flags, xf_a, &shape_b.geometry, shape_b.material, shape_b.flags, xf_b, false)
            }
        } else if child.kind == KIND_HULL {
            cg = shape.hull_shape(child.hull, 0.0)
            copy_geometry(child_geometry, cg)
            xf_child = math.mul_transforms(xf_a, child.transform)
            touching = update_convex_contact(w, c, child_geometry, child_material, shape_a.flags, xf_child, &shape_b.geometry, shape_b.material, shape_b.flags, xf_b, false)
        } else if child.kind == KIND_MESH {
            cg = shape.mesh_shape(child.mesh, shape_a.material_count)
            copy_geometry(child_geometry, cg)
            xf_child = math.mul_transforms(xf_a, child.transform)
            // The child's own run of indices into the compound's materials.
            touching = update_mesh_contact(w, c, child_geometry, shape_a, child.material_indices, child.material_count, xf_child, shape_b, xf_b, is_fast)
            convex = false
            set_hit_event_flag(c, touching, shape_a.flags, shape_b.flags)
        } else {
            cg = shape.sphere_shape(child.sphere, 0.0)
            copy_geometry(child_geometry, cg)
            if shape_b.geometry.kind == KIND_CAPSULE || shape_b.geometry.kind == KIND_HULL {
                touching = update_convex_contact(w, c, &shape_b.geometry, shape_b.material, shape_b.flags, xf_b, child_geometry, child_material, shape_a.flags, xf_a, true)
            } else {
                touching = update_convex_contact(w, c, child_geometry, child_material, shape_a.flags, xf_a, &shape_b.geometry, shape_b.material, shape_b.flags, xf_b, false)
            }
        }
        // The anchors are relative to the child's origin: offset to the compound's.
        offset = math.rotate_vector(xf_a.q, child.transform.p)
        i = 0
        while i < c.manifold_count {
            m = manifold_at(c, i)
            j = 0
            while j < m.point_count {
                p = manifold_point_at(m, j)
                p.anchor_a = math.narrow3(math.add(math.widen3(p.anchor_a), offset))
                j = j + 1
            }
            i = i + 1
        }
    } else if kind_a == KIND_MESH || kind_a == KIND_HEIGHT_FIELD {
        touching = update_mesh_contact(w, c, &shape_a.geometry, shape_a, null, 0, xf_a, shape_b, xf_b, is_fast)
        convex = false
        set_hit_event_flag(c, touching, shape_a.flags, shape_b.flags)
    } else {
        touching = update_convex_contact(w, c, &shape_a.geometry, shape_a.material, shape_a.flags, xf_a, &shape_b.geometry, shape_b.material, shape_b.flags, xf_b, false)
    }
    // The pre-solve callback on a convex contact that wants it
    // (b3UpdateConvexContact): its first point in the world and the
    // normal; false disables the contact for this step -- the one-way
    // platform. The callback runs on the collide pass's workers.
    if touching && convex && w.has_pre_solve && (c.flags & SIM_ENABLE_PRE_SOLVE_EVENTS) != 0 {
        pre_solve = w.pre_solve
        m = manifold_at(c, 0)
        point = math.add(xf_a.p, math.widen3(manifold_point_at(m, 0).anchor_a))
        if pre_solve(make_shape_id(w, shape_a), make_shape_id(w, shape_b), point, math.widen3(m.normal), w.pre_solve_context) == false {
            free_manifolds(w, c)
            touching = false
        }
    }
    if touching {
        center_a = math.rotate_vector(xf_a.q, local_center_a)
        center_b = math.rotate_vector(xf_b.q, local_center_b)
        i = 0
        while i < c.manifold_count {
            m = manifold_at(c, i)
            j = 0
            while j < m.point_count {
                p = manifold_point_at(m, j)
                p.anchor_a = math.narrow3(math.sub(math.widen3(p.anchor_a), center_a))
                p.anchor_b = math.narrow3(math.sub(math.widen3(p.anchor_b), center_b))
                j = j + 1
            }
            i = i + 1
        }
        c.flags = c.flags | SIM_TOUCHING
    } else {
        c.flags = c.flags & (0 - 1 - SIM_TOUCHING)
    }
    return touching
}

copy_geometry(dst: *Shape, src: Shape) {
    dst.kind = src.kind
    dst.density = src.density
    dst.material_count = src.material_count
    dst.sphere = src.sphere
    dst.capsule = src.capsule
    dst.hull = src.hull
    dst.mesh = src.mesh
    dst.height_field = src.height_field
    dst.compound = src.compound
}

set_hit_event_flag(c: *Contact, touching: bool, flags_a: int, flags_b: int) {
    if touching && ((flags_a & SHAPE_ENABLE_HIT_EVENTS) != 0 || (flags_b & SHAPE_ENABLE_HIT_EVENTS) != 0) {
        c.flags = c.flags | SIM_ENABLE_HIT_EVENT
    } else {
        c.flags = c.flags & (0 - 1 - SIM_ENABLE_HIT_EVENT)
    }
}

// --- islands: linking, merging, splitting ------------------------------------------------------------------

// The smaller island's bodies, contacts and joints move into the larger; the survivor's id.
merge_islands(w: *World, island_id_a: int, island_id_b: int) -> int {
    if island_id_a == island_id_b { return island_id_a }
    if island_id_a == NULL_INDEX { return island_id_b }
    if island_id_b == NULL_INDEX { return island_id_a }
    island_a = island_at(w, island_id_a)
    island_b = island_at(w, island_id_b)
    big = island_a
    small = island_b
    if island_a.bodies.count < island_b.bodies.count {
        big = island_b
        small = island_a
    }
    big_id = big.island_id
    i = 0
    while i < small.bodies.count {
        body_id = basics.ints_get(&small.bodies, i)
        body = body_at(w, body_id)
        body.island_id = big_id
        body.island_index = big.bodies.count
        basics.ints_push(&big.bodies, body_id)
        i = i + 1
    }
    i = 0
    while i < small.contacts.count {
        link = contact_link_at(small, i)
        c = contact_at(w, link.contact_id)
        c.island_id = big_id
        c.island_index = big.contacts.count
        index = basics.buffer_push(&big.contacts)
        target = contact_link_at(big, index)
        target.contact_id = link.contact_id
        target.body_id_a = link.body_id_a
        target.body_id_b = link.body_id_b
        i = i + 1
    }
    i = 0
    while i < small.joints.count {
        jlink = joint_link_at(small, i)
        j = joint_at(w, jlink.joint_id)
        j.island_id = big_id
        j.island_index = big.joints.count
        index = basics.buffer_push(&big.joints)
        jtarget = joint_link_at(big, index)
        jtarget.joint_id = jlink.joint_id
        jtarget.body_id_a = jlink.body_id_a
        jtarget.body_id_b = jlink.body_id_b
        i = i + 1
    }
    big.constraint_remove_count = big.constraint_remove_count + small.constraint_remove_count
    destroy_island(w, small.island_id)
    return big_id
}

add_contact_to_island(w: *World, island_id: int, c: *Contact) {
    island = island_at(w, island_id)
    c.island_id = island_id
    c.island_index = island.contacts.count
    index = basics.buffer_push(&island.contacts)
    link = contact_link_at(island, index)
    link.contact_id = c.contact_id
    link.body_id_a = c.edge_a.body_id
    link.body_id_b = c.edge_b.body_id
}

// A touching contact joins its bodies' islands (waking a sleeping one
// when the other is awake) and merges them.
link_contact(w: *World, c: *Contact) {
    body_a = body_at(w, c.edge_a.body_id)
    body_b = body_at(w, c.edge_b.body_id)
    if body_a.set_index == AWAKE_SET && body_b.set_index >= FIRST_SLEEPING_SET { wake_solver_set(w, body_b.set_index) }
    if body_b.set_index == AWAKE_SET && body_a.set_index >= FIRST_SLEEPING_SET { wake_solver_set(w, body_a.set_index) }
    final_island = merge_islands(w, body_a.island_id, body_b.island_id)
    add_contact_to_island(w, final_island, c)
}

// A contact leaves its island, which notes a removed constraint (a split candidate).
unlink_contact(w: *World, c: *Contact) {
    island_id = c.island_id
    island = island_at(w, island_id)
    remove_index = c.island_index
    moved = basics.buffer_remove_swap(&island.contacts, remove_index)
    if moved != NULL_INDEX && moved != remove_index {
        contact_at(w, contact_link_at(island, remove_index).contact_id).island_index = remove_index
    }
    c.island_id = NULL_INDEX
    c.island_index = NULL_INDEX
    island.constraint_remove_count = island.constraint_remove_count + 1
}

add_joint_to_island(w: *World, island_id: int, j: *Joint) {
    island = island_at(w, island_id)
    j.island_id = island_id
    j.island_index = island.joints.count
    index = basics.buffer_push(&island.joints)
    link = joint_link_at(island, index)
    link.joint_id = j.joint_id
    link.body_id_a = j.edge_a.body_id
    link.body_id_b = j.edge_b.body_id
}

link_joint(w: *World, j: *Joint) {
    body_a = body_at(w, j.edge_a.body_id)
    body_b = body_at(w, j.edge_b.body_id)
    if body_a.set_index == AWAKE_SET && body_b.set_index >= FIRST_SLEEPING_SET { wake_solver_set(w, body_b.set_index) }
    else if body_b.set_index == AWAKE_SET && body_a.set_index >= FIRST_SLEEPING_SET { wake_solver_set(w, body_a.set_index) }
    final_island = merge_islands(w, body_a.island_id, body_b.island_id)
    add_joint_to_island(w, final_island, j)
}

unlink_joint(w: *World, j: *Joint) {
    if j.island_id == NULL_INDEX { return }
    island_id = j.island_id
    island = island_at(w, island_id)
    remove_index = j.island_index
    moved = basics.buffer_remove_swap(&island.joints, remove_index)
    if moved != NULL_INDEX && moved != remove_index {
        joint_at(w, joint_link_at(island, remove_index).joint_id).island_index = remove_index
    }
    j.island_id = NULL_INDEX
    j.island_index = NULL_INDEX
    island.constraint_remove_count = island.constraint_remove_count + 1
}

// Union-find with path halving.
find_parent(parents: int[], node: int) -> int {
    n = node
    while parents[n] != n {
        grand = parents[parents[n]]
        parents[n] = grand
        n = grand
    }
    return n
}

island_union(parents: int[], ranks: int[], node1: int, node2: int) {
    root1 = find_parent(parents, node1)
    root2 = find_parent(parents, node2)
    if root1 == root2 { return }
    if ranks[root1] < ranks[root2] {
        parents[root1] = root2
    } else if ranks[root1] > ranks[root2] {
        parents[root2] = root1
    } else {
        parents[root2] = root1
        ranks[root1] = ranks[root1] + 1
    }
}

// An awake island whose constraints were removed, split into its
// connected components by union-find over its contacts and joints
// (constraints to static bodies connect nothing); returns how many
// islands it became (one when still connected).
split_island(w: *World, base_id: int) -> int {
    base = island_at(w, base_id)
    body_count = base.bodies.count
    if body_count == 0 { return 1 }
    parents_block = basics.stack_alloc(&w.stack, body_count * 4)
    ranks_block = basics.stack_alloc(&w.stack, body_count * 4)
    parents = parents_block as int[]
    ranks = ranks_block as int[]
    i = 0
    while i < body_count {
        parents[i] = i
        ranks[i] = 0
        i = i + 1
    }
    i = 0
    while i < base.contacts.count {
        link = contact_link_at(base, i)
        index_a = body_at(w, link.body_id_a).island_index
        index_b = body_at(w, link.body_id_b).island_index
        if index_a != NULL_INDEX && index_b != NULL_INDEX { island_union(parents, ranks, index_a, index_b) }
        i = i + 1
    }
    i = 0
    while i < base.joints.count {
        jlink = joint_link_at(base, i)
        index_a = body_at(w, jlink.body_id_a).island_index
        index_b = body_at(w, jlink.body_id_b).island_index
        if index_a != NULL_INDEX && index_b != NULL_INDEX { island_union(parents, ranks, index_a, index_b) }
        i = i + 1
    }
    basics.stack_free(&w.stack, ranks_block)
    component_count = 0
    i = 0
    while i < body_count {
        parents[i] = find_parent(parents, i)
        if parents[i] == i { component_count = component_count + 1 }
        i = i + 1
    }
    if component_count == 1 {
        base.constraint_remove_count = 0
        basics.stack_free(&w.stack, parents_block)
        return 1
    }
    // The base island's arrays are detached and freed at the end; the
    // island slot is destroyed after the new ones are filled.
    base_bodies = base.bodies
    base_contacts = base.contacts
    base_joints = base.joints
    base.bodies = basics.ints_create(0)
    base.contacts = basics.buffer_create(sizeof(ContactLink), 0)
    base.joints = basics.buffer_create(sizeof(JointLink), 0)
    root_map_block = basics.stack_alloc(&w.stack, body_count * 4)
    root_map = root_map_block as int[]
    i = 0
    while i < body_count {
        root_map[i] = NULL_INDEX
        i = i + 1
    }
    island_ids_block = basics.stack_alloc(&w.stack, component_count * 4)
    island_ids = island_ids_block as int[]
    island_count = 0
    i = 0
    while i < body_count {
        root = parents[i]
        if root_map[root] == NULL_INDEX {
            root_map[root] = island_count
            fresh = create_island(w, AWAKE_SET)
            island_ids[island_count] = fresh.island_id
            island_count = island_count + 1
        }
        i = i + 1
    }
    base_body_ids = base_bodies.data as int[]
    i = 0
    while i < body_count {
        body_id = base_body_ids[i]
        new_island_id = island_ids[root_map[parents[i]]]
        body = body_at(w, body_id)
        fresh = island_at(w, new_island_id)
        body.island_id = new_island_id
        body.island_index = fresh.bodies.count
        basics.ints_push(&fresh.bodies, body_id)
        i = i + 1
    }
    i = 0
    while i < base_contacts.count {
        link = (base_contacts.data + i * sizeof(ContactLink)) as *ContactLink
        c = contact_at(w, link.contact_id)
        target_id = body_at(w, link.body_id_a).island_id
        if target_id == NULL_INDEX { target_id = body_at(w, link.body_id_b).island_id }
        target = island_at(w, target_id)
        c.island_id = target_id
        c.island_index = target.contacts.count
        index = basics.buffer_push(&target.contacts)
        moved = contact_link_at(target, index)
        moved.contact_id = link.contact_id
        moved.body_id_a = link.body_id_a
        moved.body_id_b = link.body_id_b
        i = i + 1
    }
    i = 0
    while i < base_joints.count {
        jlink = (base_joints.data + i * sizeof(JointLink)) as *JointLink
        j = joint_at(w, jlink.joint_id)
        target_id = body_at(w, jlink.body_id_a).island_id
        if target_id == NULL_INDEX { target_id = body_at(w, jlink.body_id_b).island_id }
        target = island_at(w, target_id)
        j.island_id = target_id
        j.island_index = target.joints.count
        index = basics.buffer_push(&target.joints)
        jmoved = joint_link_at(target, index)
        jmoved.joint_id = jlink.joint_id
        jmoved.body_id_a = jlink.body_id_a
        jmoved.body_id_b = jlink.body_id_b
        i = i + 1
    }
    destroy_island(w, base_id)
    basics.ints_destroy(&base_bodies)
    basics.buffer_destroy(&base_contacts)
    basics.buffer_destroy(&base_joints)
    basics.stack_free(&w.stack, island_ids_block)
    basics.stack_free(&w.stack, root_map_block)
    basics.stack_free(&w.stack, parents_block)
    return island_count
}

// --- sleeping and waking -------------------------------------------------------------------------------------

// A sleeping set's bodies and islands move into the awake set, its
// non-touching contacts from the disabled set into the awake set's, its
// touching contacts into the constraint graph, its joints too; then the
// set is destroyed.
wake_solver_set(w: *World, set_index: int) {
    set = solver_set_at(w, set_index)
    awake = solver_set_at(w, AWAKE_SET)
    disabled = solver_set_at(w, DISABLED_SET)
    i = 0
    while i < set.body_sims.count {
        sim = body_sim_at(set, i)
        body = body_at(w, sim.body_id)
        target = basics.buffer_push(&awake.body_sims)
        memcpy(awake.body_sims.data + target * sizeof(BodySim), sim as ptr, sizeof(BodySim))
        state_index = basics.buffer_push(&awake.body_states)
        state = body_state_at(awake, state_index)
        state.v = math.vec3f_zero()
        state.w = math.vec3f_zero()
        state.dp = math.vec3f_zero()
        state.dq = math.quatf_identity()
        state.flags = body.flags
        body.set_index = AWAKE_SET
        body.local_index = target
        body.sleep_time = 0.0
        // The body's non-touching contacts, from the disabled set to the
        // awake one, and its awake ones, with its index; the touching ones
        // take theirs entering the graph.
        key = body.head_contact_key
        while key != NULL_INDEX {
            c = contact_at(w, key >> 1)
            edge_index = key & 1
            key = contact_edge_next(w, key)
            if c.set_index == AWAKE_SET || c.set_index == DISABLED_SET {
                if edge_index == 0 { c.encoded_body_sim_a = target } else { c.encoded_body_sim_b = target }
            }
            if c.set_index == DISABLED_SET {
                local_index = c.local_index
                c.set_index = AWAKE_SET
                c.local_index = awake.contact_indices.count
                basics.ints_push(&awake.contact_indices, c.contact_id)
                moved = basics.ints_remove_swap(&disabled.contact_indices, local_index)
                if moved != NULL_INDEX && moved != local_index {
                    contact_at(w, basics.ints_get(&disabled.contact_indices, local_index)).local_index = local_index
                }
            }
        }
        i = i + 1
    }
    i = 0
    while i < set.contact_indices.count {
        c = contact_at(w, basics.ints_get(&set.contact_indices, i))
        add_contact_to_graph(w, c)
        c.set_index = AWAKE_SET
        i = i + 1
    }
    i = 0
    while i < set.joint_sims.count {
        jsim = joint_sim_at(&set.joint_sims, i)
        j = joint_at(w, jsim.joint_id)
        add_joint_to_graph(w, jsim, j)
        j.set_index = AWAKE_SET
        i = i + 1
    }
    i = 0
    while i < set.island_sims.count {
        island_id = island_sim_at(set, i).island_id
        island = island_at(w, island_id)
        island.set_index = AWAKE_SET
        island.local_index = awake.island_sims.count
        target = basics.buffer_push(&awake.island_sims)
        island_sim_at(awake, target).island_id = island_id
        i = i + 1
    }
    destroy_solver_set(w, set_index)
}

// A joint sim copied into a colour of the graph.
add_joint_to_graph(w: *World, sim: *JointSim, j: *Joint) {
    body_a = body_at(w, j.edge_a.body_id)
    body_b = body_at(w, j.edge_b.body_id)
    color_index = assign_color(&w.constraint_graph, body_a.id, body_b.id, body_a.kind, body_b.kind)
    color = graph_color(w, color_index)
    index = basics.buffer_push(&color.joint_sims)
    memcpy(color.joint_sims.data + index * sizeof(JointSim), sim as ptr, sizeof(JointSim))
    j.color_index = color_index
    j.local_index = index
}

remove_joint_from_graph(w: *World, body_id_a: int, body_id_b: int, color_index: int, local_index: int) {
    color = graph_color(w, color_index)
    if color_index != OVERFLOW_INDEX {
        basics.bitset_clear(&color.body_set, body_id_a)
        basics.bitset_clear(&color.body_set, body_id_b)
    }
    moved = basics.buffer_remove_swap(&color.joint_sims, local_index)
    if moved != NULL_INDEX && moved != local_index {
        joint_at(w, joint_sim_at(&color.joint_sims, local_index).joint_id).local_index = local_index
    }
}

// An awake island put to sleep in a set of its own: its bodies' sims
// move there (their states dropped), their non-touching contacts with
// other sleeping bodies to the disabled set, the island's touching
// contacts and joints out of the graph and into the set. Refused while
// the island has a pending split.
try_sleep_island(w: *World, island_id: int) -> bool {
    island = island_at(w, island_id)
    if island.set_index != AWAKE_SET { return false }
    if island.constraint_remove_count > 0 && island.bodies.count > 1 { return false }
    sleep_set_id = create_solver_set(w)
    sleep_set = solver_set_at(w, sleep_set_id)
    awake = solver_set_at(w, AWAKE_SET)
    disabled = solver_set_at(w, DISABLED_SET)
    basics.buffer_reserve(&sleep_set.body_sims, island.bodies.count)
    i = 0
    while i < island.bodies.count {
        body_id = basics.ints_get(&island.bodies, i)
        body = body_at(w, body_id)
        awake_index = body.local_index
        sleep_index = basics.buffer_push(&sleep_set.body_sims)
        memcpy(sleep_set.body_sims.data + sleep_index * sizeof(BodySim), body_sim_at(awake, awake_index) as ptr, sizeof(BodySim))
        moved = basics.buffer_remove_swap(&awake.body_sims, awake_index)
        if moved != NULL_INDEX && moved != awake_index {
            moved_body = body_at(w, body_sim_at(awake, awake_index).body_id)
            moved_body.local_index = awake_index
            // One of this island's bodies is re-encoded below as it sleeps.
            if moved_body.island_id != island_id { refresh_body_contact_indices(w, moved_body) }
        }
        basics.buffer_remove_swap(&awake.body_states, awake_index)
        body.set_index = sleep_set_id
        body.local_index = sleep_index
        // This step's move event says the body fell asleep (b3TrySleepIsland):
        // from the next step on it has none.
        if body.body_move_index != NULL_INDEX && body.body_move_index < w.body_move_events.count {
            body_move_event_at(w, body.body_move_index).fell_asleep = true
        }
        body.body_move_index = NULL_INDEX
        // Its non-touching contacts lose its index; those whose other body
        // is not awake go to the disabled set.
        key = body.head_contact_key
        while key != NULL_INDEX {
            c = contact_at(w, key >> 1)
            edge_index = key & 1
            key = contact_edge_next(w, key)
            if c.color_index != NULL_INDEX { continue }
            if edge_index == 0 { c.encoded_body_sim_a = NULL_INDEX } else { c.encoded_body_sim_b = NULL_INDEX }
            if c.set_index == DISABLED_SET { continue }
            other_id = c.edge_b.body_id
            if edge_index == 1 { other_id = c.edge_a.body_id }
            if body_at(w, other_id).set_index == AWAKE_SET { continue }
            local_index = c.local_index
            c.set_index = DISABLED_SET
            c.local_index = disabled.contact_indices.count
            basics.ints_push(&disabled.contact_indices, c.contact_id)
            moved_contact = basics.ints_remove_swap(&awake.contact_indices, local_index)
            if moved_contact != NULL_INDEX && moved_contact != local_index {
                contact_at(w, basics.ints_get(&awake.contact_indices, local_index)).local_index = local_index
            }
        }
        i = i + 1
    }
    i = 0
    while i < island.contacts.count {
        c = contact_at(w, contact_link_at(island, i).contact_id)
        color_index = c.color_index
        color = graph_color(w, color_index)
        if color_index != OVERFLOW_INDEX {
            basics.bitset_clear(&color.body_set, c.edge_a.body_id)
            basics.bitset_clear(&color.body_set, c.edge_b.body_id)
        }
        sleep_contact_index = sleep_set.contact_indices.count
        basics.ints_push(&sleep_set.contact_indices, c.contact_id)
        local_index = c.local_index
        if (c.flags & SIM_MESH_CONTACT) != 0 || color_index == OVERFLOW_INDEX {
            moved = basics.buffer_remove_swap(&color.contacts, local_index)
            if moved != NULL_INDEX && moved != local_index {
                contact_at(w, contact_spec_at(color, local_index).contact_id).local_index = local_index
            }
        } else {
            moved = basics.ints_remove_swap(&color.convex_contacts, local_index)
            if moved != NULL_INDEX && moved != local_index {
                contact_at(w, basics.ints_get(&color.convex_contacts, local_index)).local_index = local_index
            }
        }
        c.set_index = sleep_set_id
        c.color_index = NULL_INDEX
        c.local_index = sleep_contact_index
        c.encoded_body_sim_a = sleep_body_sim_index(c.encoded_body_sim_a)
        c.encoded_body_sim_b = sleep_body_sim_index(c.encoded_body_sim_b)
        i = i + 1
    }
    i = 0
    while i < island.joints.count {
        j = joint_at(w, joint_link_at(island, i).joint_id)
        color_index = j.color_index
        local_index = j.local_index
        color = graph_color(w, color_index)
        if color_index != OVERFLOW_INDEX {
            basics.bitset_clear(&color.body_set, j.edge_a.body_id)
            basics.bitset_clear(&color.body_set, j.edge_b.body_id)
        }
        sleep_joint_index = basics.buffer_push(&sleep_set.joint_sims)
        memcpy(sleep_set.joint_sims.data + sleep_joint_index * sizeof(JointSim), joint_sim_at(&color.joint_sims, local_index) as ptr, sizeof(JointSim))
        moved = basics.buffer_remove_swap(&color.joint_sims, local_index)
        if moved != NULL_INDEX && moved != local_index {
            joint_at(w, joint_sim_at(&color.joint_sims, local_index).joint_id).local_index = local_index
        }
        j.set_index = sleep_set_id
        j.color_index = NULL_INDEX
        j.local_index = sleep_joint_index
        i = i + 1
    }
    island_index = island.local_index
    sleep_island = basics.buffer_push(&sleep_set.island_sims)
    island_sim_at(sleep_set, sleep_island).island_id = island_id
    moved_island = basics.buffer_remove_swap(&awake.island_sims, island_index)
    if moved_island != NULL_INDEX && moved_island != island_index {
        island_at(w, island_sim_at(awake, island_index).island_id).local_index = island_index
    }
    island.set_index = sleep_set_id
    island.local_index = 0
    if w.split_island_id == island_id { w.split_island_id = NULL_INDEX }
    return true
}

// --- the pair filter and the collide pass ----------------------------------------------------------------------

// Whether two shapes may collide: not on one body, no sensors, the
// filters, no joint forbidding it, the world's custom filter.
should_pair(shape_id_a: int, shape_id_b: int, context: ptr) -> bool {
    w = context as *World
    shape_a = world_shape_at(w, shape_id_a)
    shape_b = world_shape_at(w, shape_id_b)
    if shape_a.body_id == shape_b.body_id { return false }
    if shape_a.sensor_index != NULL_INDEX || shape_b.sensor_index != NULL_INDEX { return false }
    if shape.should_shapes_collide(shape_a.filter, shape_b.filter) == false { return false }
    if should_bodies_collide(w, body_at(w, shape_a.body_id), body_at(w, shape_b.body_id)) == false { return false }
    if w.has_custom_filter && ((shape_a.flags & SHAPE_ENABLE_CUSTOM_FILTERING) != 0 || (shape_b.flags & SHAPE_ENABLE_CUSTOM_FILTERING) != 0) {
        filter = w.custom_filter
        if filter(make_shape_id(w, shape_a), make_shape_id(w, shape_b), w.custom_filter_context) == false { return false }
    }
    return true
}

compound_tree_of(shape_id: int, context: ptr) -> ptr {
    w = context as *World
    s = world_shape_at(w, shape_id)
    if s.geometry.kind != KIND_COMPOUND { return null }
    return (&s.geometry.compound.tree) as ptr
}

compound_transform_of(shape_id: int, context: ptr) -> Transform {
    w = context as *World
    s = world_shape_at(w, shape_id)
    return get_body_transform(w, s.body_id)
}

// The broad phase's new pairs become contacts.
update_pairs(w: *World) -> int {
    visitors = PairVisitors { should_pair: should_pair, compound_tree_of: compound_tree_of, compound_transform: compound_transform_of, context: w as ptr }
    count = broad_phase.update_broad_phase_pairs(&w.broad_phase, visitors, w.compound_shape_count > 0)
    i = 0
    while i < count {
        key = broad_phase.pair_key(&w.broad_phase, i)
        shape_a = world_shape_at(w, broad_phase.pair_key_shape_a(key))
        shape_b = world_shape_at(w, broad_phase.pair_key_shape_b(key))
        create_contact(w, shape_a, shape_b, broad_phase.pair_key_child(key))
        i = i + 1
    }
    return count
}

// The recycling: when the bodies barely moved relative to each other
// since the manifolds were computed, the anchors are kept and only the
// separations updated (the reference's persistent-manifold shortcut).
try_recycle_contact(w: *World, c: *Contact, sim_a: *BodySim, sim_b: *BodySim, static_a: bool, static_b: bool, tolerance: float) -> bool {
    xf_a = sim_a.transform
    xf_b = sim_b.transform
    rotation_a = math.widen_quat(c.cached_rotation_a)
    rotation_b = math.widen_quat(c.cached_rotation_b)
    angle_a = math.dot_quat(xf_a.q, rotation_a)
    angle_b = math.dot_quat(xf_b.q, rotation_b)
    angular_distance = math.min_float(angle_a * angle_a, angle_b * angle_b)
    xf = math.inv_mul_transforms(xf_a, xf_b)
    xfc = Transform { p: math.widen3(c.cached_relative_p), q: math.widen_quat(c.cached_relative_q) }
    max_extent_a = math.widen3(sim_a.max_extent)
    if static_a { max_extent_a = math.vec3_zero() }
    max_extent_b = math.widen3(sim_b.max_extent)
    if static_b { max_extent_b = math.vec3_zero() }
    max_extent = math.max_vec3(max_extent_a, max_extent_b)
    dist_squared = math.distance_squared(xf.p, xfc.p)
    if angular_distance <= CONTACT_RECYCLE_ANGULAR_DISTANCE || dist_squared >= tolerance * tolerance { return false }
    slack = tolerance - sqrt(dist_squared)
    qr = math.inv_mul_quat(xfc.q, xf.q)
    a = math.abs_vec3(math.qv(qr))
    arc = math.vec3(a.y * max_extent.z + a.z * max_extent.y, a.z * max_extent.x + a.x * max_extent.z, a.x * max_extent.y + a.y * max_extent.x)
    if 4.0 * math.length_squared(arc) >= slack * slack { return false }
    dq_a = math.mul_quat(xf_a.q, math.conjugate(rotation_a))
    dq_b = math.mul_quat(xf_b.q, math.conjugate(rotation_b))
    matrix_a = math.make_matrix_from_quat(dq_a)
    matrix_b = math.make_matrix_from_quat(dq_b)
    dc = math.sub(sim_b.center, sim_a.center)
    i = 0
    while i < c.manifold_count {
        m = manifold_at(c, i)
        normal = math.widen3(m.normal)
        j = 0
        while j < m.point_count {
            p = manifold_point_at(m, j)
            r_a = math.mul_mv(matrix_a, math.widen3(p.anchor_a))
            r_b = math.mul_mv(matrix_b, math.widen3(p.anchor_b))
            dp = math.add(dc, math.sub(r_b, r_a))
            p.separation = p.base_separation + math.dot(dp, normal)
            p.persisted = true
            j = j + 1
        }
        i = i + 1
    }
    tc = task_context(w)
    tc.recycled_contact_count = tc.recycled_contact_count + 1
    count_manifolds(tc, c.manifold_count)
    return true
}

// One awake contact's pass: destroyed when its proxies no longer
// overlap, recycled when its bodies barely moved, else its manifolds
// recomputed; a change of touching is noted for the state pass.
collide_contact(w: *World, contact_id: int) {
    c = contact_at(w, contact_id)
    shape_a = world_shape_at(w, c.shape_id_a)
    shape_b = world_shape_at(w, c.shape_id_b)
    if math.aabbf_overlaps(shape_fat_aabb(w, c.shape_id_a), shape_fat_aabb(w, c.shape_id_b)) == false {
        c.flags = (c.flags | SIM_DISJOINT) & (0 - 1 - SIM_TOUCHING)
        basics.bitset_set(&task_context(w).contact_state, contact_id)
        return
    }
    // The sims straight from the contact's encodings, the bodies only for
    // one asleep (a non-touching contact with a sleeping body).
    encoded_a = c.encoded_body_sim_a
    encoded_b = c.encoded_body_sim_b
    sim_a = resolve_contact_body_sim(w, solver_set_at(w, AWAKE_SET).body_sims.data, solver_set_at(w, STATIC_SET).body_sims.data, encoded_a, c.edge_a.body_id)
    sim_b = resolve_contact_body_sim(w, solver_set_at(w, AWAKE_SET).body_sims.data, solver_set_at(w, STATIC_SET).body_sims.data, encoded_b, c.edge_b.body_id)
    static_a = is_static_sim_index(encoded_a)
    static_b = is_static_sim_index(encoded_b)
    was_touching = (c.flags & SIM_TOUCHING) != 0
    is_fast = ((sim_a.flags | sim_b.flags) & IS_FAST) != 0
    recycle_distance = w.contact_recycle_distance
    tolerance = recycle_distance
    if was_touching == false { tolerance = math.min_float(recycle_distance, SPECULATIVE_DISTANCE) }
    if is_fast == false && recycle_distance > 0.0 && (c.flags & RELATIVE_TRANSFORM_VALID) != 0 && (c.flags & CONTACT_RECYCLE) != 0 {
        if try_recycle_contact(w, c, sim_a, sim_b, static_a, static_b, tolerance) { return }
    }
    c.cached_rotation_a = math.narrow_quat(sim_a.transform.q)
    c.cached_rotation_b = math.narrow_quat(sim_b.transform.q)
    relative = math.inv_mul_transforms(sim_a.transform, sim_b.transform)
    c.cached_relative_p = math.narrow3(relative.p)
    c.cached_relative_q = math.narrow_quat(relative.q)
    c.flags = c.flags | RELATIVE_TRANSFORM_VALID
    touching = update_contact(w, c, shape_a, math.widen3(sim_a.local_center), sim_a.transform, shape_b, math.widen3(sim_b.local_center), sim_b.transform, is_fast)
    count_manifolds(task_context(w), c.manifold_count)
    if touching && was_touching && (c.flags & SIM_MESH_CONTACT) != 0 {
        contact_spec_at(graph_color(w, c.color_index), c.local_index).manifold_count = c.manifold_count
    }
    if touching && was_touching == false {
        c.flags = c.flags | SIM_STARTED_TOUCHING
        basics.bitset_set(&task_context(w).contact_state, contact_id)
    } else if touching == false && was_touching {
        c.flags = c.flags | SIM_STOPPED_TOUCHING
        basics.bitset_set(&task_context(w).contact_state, contact_id)
    }
    i = 0
    while i < c.manifold_count {
        m = manifold_at(c, i)
        j = 0
        while j < m.point_count {
            p = manifold_point_at(m, j)
            p.base_separation = p.separation
            j = j + 1
        }
        i = i + 1
    }
}

add_non_touching_contact(w: *World, c: *Contact) {
    set = solver_set_at(w, AWAKE_SET)
    c.color_index = NULL_INDEX
    c.local_index = set.contact_indices.count
    basics.ints_push(&set.contact_indices, c.contact_id)
}

remove_non_touching_contact(w: *World, set_index: int, local_index: int) {
    set = solver_set_at(w, set_index)
    moved = basics.ints_remove_swap(&set.contact_indices, local_index)
    if moved != NULL_INDEX && moved != local_index {
        contact_at(w, basics.ints_get(&set.contact_indices, local_index)).local_index = local_index
    }
}

// The narrow phase for every awake contact (the graph's touching ones
// and the awake set's non-touching ones), then the state changes in
// contact id order: disjoint contacts destroyed, contacts that began
// touching linked into islands and the graph (with a begin event),
// contacts that stopped unlinked and back among the non-touching (with
// an end event). Returns how many contacts changed state.
// A block of the pass on one worker.
struct CollideTask {
    w: *World
    indices: ptr                   // int[], the contacts of the pass
}

// An awake or static body's sim, by a contact's encoding: its transform
// and centre lead it.
prefetch_sim(w: *World, encoded: int) {
    if encoded >= 0 { native.prefetch(body_sim_at(solver_set_at(w, AWAKE_SET), encoded) as ptr) }
    else if encoded < NULL_INDEX { native.prefetch(body_sim_at(solver_set_at(w, STATIC_SET), 0 - encoded - 2) as ptr) }
}

collide_range(start: int, end: int, worker: int, context: ptr) {
    task = context as *CollideTask
    indices = task.indices as int[]
    w = task.w
    i = start
    while i < end {
        // The contacts to come and their manifolds fetched ahead, as the
        // reference's narrow phase does: each pass's first touch of a
        // contact and of its separately allocated manifold missed the cache.
        // Further in, what a contact leads to: its bodies' sims four ahead,
        // the contact fetched by then (the fat boxes are dense, and the
        // shapes are read only when the manifolds are made again).
        if i + 8 < end { native.prefetch(contact_at(w, indices[i + 8]) as ptr) }
        if i + 4 < end {
            ahead = contact_at(w, indices[i + 4])
            native.prefetch(ahead.manifolds)
            prefetch_sim(w, ahead.encoded_body_sim_a)
            prefetch_sim(w, ahead.encoded_body_sim_b)
        }
        collide_contact(w, indices[i])
        i = i + 1
    }
}

// The calling worker's context, and any worker's.
// The calling worker's context: its slot less the world's base. A serial
// caller outside a step (a test driving the collide pass) is worker 0.
task_context(w: *World) -> *TaskContext {
    local = native.worker_index() - w.worker_base
    if local < 0 || local >= w.worker_count { local = 0 }
    return (w.task_contexts + local * sizeof(TaskContext)) as *TaskContext
}

// --- worker slots ------------------------------------------------------

// A world's run of worker slots, from the same mask the threads claim
// theirs from (aephysics.native): a world's workers and the program's
// other threads never share scratch, whichever threads they run on.
claim_worker_slots(count: int) -> int { return native.claim_slots(count) }

// A world's workers: the threads (the host's scheduler when it lends one,
// the reference's task callbacks: a game runs its physics on its own job
// system; else the world's own, destroyed with it), the worker slots its
// steps run as, and a task context each.
create_workers(w: *World, scheduler: ptr, count: int) {
    if scheduler != null {
        w.scheduler = scheduler
        w.owns_scheduler = false
        w.worker_count = parallel.scheduler_worker_count(scheduler as *Scheduler)
    } else {
        w.worker_count = math.clamp_int(count, 1, native.MAX_WORKERS)
        w.scheduler = parallel.create_scheduler(w.worker_count) as ptr
        w.owns_scheduler = true
    }
    // The world's steps run as worker slots of its own, so worlds stepped
    // at once on different threads use different scratch; with none free,
    // slot 0 on, shared, as before (such worlds step one at a time).
    w.worker_base = claim_worker_slots(w.worker_count)
    w.owns_worker_slots = w.worker_base >= 0
    if w.worker_base < 0 { w.worker_base = 0 }
    w.task_contexts = basics.alloc(w.worker_count * sizeof(TaskContext))
    i = 0
    while i < w.worker_count {
        tc = task_context_at(w, i)
        tc.arena = basics.arena_create(1 << 20)
        tc.contact_state = basics.bitset_create(64)
        tc.joint_state_bits = basics.bitset_create(64)
        tc.hit_event_bits = basics.bitset_create(64)
        tc.awake_island_bits = basics.bitset_create(64)
        tc.split_island_id = NULL_INDEX
        tc.sensor_hits = basics.buffer_create(sizeof(SensorHit), 4)
        i = i + 1
    }
}

destroy_workers(w: *World) {
    i = 0
    while i < w.worker_count {
        tc = task_context_at(w, i)
        basics.arena_destroy(&tc.arena)
        basics.bitset_destroy(&tc.contact_state)
        basics.bitset_destroy(&tc.joint_state_bits)
        basics.bitset_destroy(&tc.hit_event_bits)
        basics.bitset_destroy(&tc.awake_island_bits)
        basics.buffer_destroy(&tc.sensor_hits)
        i = i + 1
    }
    basics.free_bytes(w.task_contexts, w.worker_count * sizeof(TaskContext))
    if w.owns_worker_slots { release_worker_slots(w.worker_base, w.worker_count) }
    if w.owns_scheduler { parallel.destroy_scheduler(w.scheduler as *Scheduler) }
    w.task_contexts = null
}

// The worker count between steps (b3World_SetWorkerCount), clamped to
// [1, MAX_WORKERS]: the world's own threads, slots and task contexts made
// again for it. A world on a host's scheduler steps on that scheduler's
// workers, so its count is the host's to set, and this leaves it.
set_worker_count(w: *World, count: int) {
    if w.locked || w.owns_scheduler == false { return }
    clamped = math.clamp_int(count, 1, native.MAX_WORKERS)
    if clamped == w.worker_count { return }
    destroy_workers(w)
    create_workers(w, null, clamped)
}
release_worker_slots(start: int, count: int) { native.release_slots(start, count) }

// The calling thread made the world's first worker for a pass over it (a
// step, the collide pass, the solve); the index it had before, to give back.
enter_world(w: *World) -> int {
    caller = native.worker_index()
    native.set_worker_index(w.worker_base)
    return caller
}

leave_world(caller: int) { native.set_worker_index(caller) }
task_context_at(w: *World, index: int) -> *TaskContext { return (w.task_contexts + index * sizeof(TaskContext)) as *TaskContext }

// The collide pass as the world's workers, whatever the calling thread's index.
collide(w: *World) -> int {
    caller = enter_world(w)
    touching = collide_pass(w)
    leave_world(caller)
    return touching
}

collide_pass(w: *World) -> int {
    basics.buffer_clear(&w.contact_begin_events)
    touching_count = 0
    i = 0
    while i < GRAPH_COLOR_COUNT {
        color = graph_color(w, i)
        touching_count = touching_count + color.convex_contacts.count + color.contacts.count
        i = i + 1
    }
    awake = solver_set_at(w, AWAKE_SET)
    contact_count = touching_count + awake.contact_indices.count
    if contact_count == 0 { return 0 }
    indices_block = basics.stack_alloc(&w.stack, contact_count * 4)
    indices = indices_block as int[]
    n = 0
    i = 0
    while i < GRAPH_COLOR_COUNT {
        color = graph_color(w, i)
        j = 0
        while j < color.convex_contacts.count {
            indices[n] = basics.ints_get(&color.convex_contacts, j)
            n = n + 1
            j = j + 1
        }
        j = 0
        while j < color.contacts.count {
            indices[n] = contact_spec_at(color, j).contact_id
            n = n + 1
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < awake.contact_indices.count {
        indices[n] = basics.ints_get(&awake.contact_indices, i)
        n = n + 1
        i = i + 1
    }
    capacity = basics.idpool_capacity(&w.contact_id_pool)
    i = 0
    while i < w.worker_count {
        tc = task_context_at(w, i)
        basics.bitset_set_count_and_clear(&tc.contact_state, capacity)
        tc.sat_call_count = 0
        tc.sat_cache_hit_count = 0
        tc.recycled_contact_count = 0
        memset((&tc.manifold_counts) as ptr, 0, MANIFOLD_COUNT_BUCKETS * 4)
        i = i + 1
    }
    // The contacts in blocks over the workers; each writes its own context.
    task = CollideTask { w: w, indices: indices_block }
    parallel.parallel_for(w.scheduler as *Scheduler, collide_range, contact_count, 64, (&task) as ptr)
    basics.stack_free(&w.stack, indices_block)
    // The workers' state merged: the changed bits in one set, the counters summed.
    basics.bitset_set_count_and_clear(&w.contact_state, capacity)
    w.sat_call_count = 0
    w.sat_cache_hit_count = 0
    w.recycled_contact_count = 0
    memset((&w.manifold_counts) as ptr, 0, MANIFOLD_COUNT_BUCKETS * 4)
    i = 0
    while i < w.worker_count {
        tc = task_context_at(w, i)
        basics.bitset_union(&w.contact_state, &tc.contact_state)
        w.sat_call_count = w.sat_call_count + tc.sat_call_count
        w.sat_cache_hit_count = w.sat_cache_hit_count + tc.sat_cache_hit_count
        w.recycled_contact_count = w.recycled_contact_count + tc.recycled_contact_count
        b = 0
        while b < MANIFOLD_COUNT_BUCKETS {
            w.manifold_counts[b] = w.manifold_counts[b] + tc.manifold_counts[b]
            b = b + 1
        }
        basics.arena_sync(&tc.arena)
        i = i + 1
    }
    // The state changes, in id order.
    changed = 0
    bits = w.contact_state.bits as long[]
    k = 0
    while k < w.contact_state.block_count {
        block = bits[k]
        while block != (0 as long) {
            bit = basics.ctz64(block)
            contact_id = 64 * k + bit
            c = contact_at(w, contact_id)
            flags = c.flags
            if (flags & SIM_DISJOINT) != 0 {
                destroy_contact(w, c, false)
            } else if (flags & SIM_STARTED_TOUCHING) != 0 {
                if (flags & CONTACT_ENABLE_CONTACT_EVENTS) != 0 { push_begin_event(w, c) }
                c.flags = (c.flags & (0 - 1 - SIM_STARTED_TOUCHING)) | CONTACT_TOUCHING
                // Linked first: this wakes the other body and settles the sims.
                link_contact(w, c)
                old_local_index = c.local_index
                add_contact_to_graph(w, c)
                remove_non_touching_contact(w, AWAKE_SET, old_local_index)
            } else if (flags & SIM_STOPPED_TOUCHING) != 0 {
                c.flags = c.flags & (0 - 1 - SIM_STOPPED_TOUCHING) & (0 - 1 - CONTACT_TOUCHING)
                if (c.flags & CONTACT_ENABLE_CONTACT_EVENTS) != 0 { push_end_event(w, c) }
                color_index = c.color_index
                local_index = c.local_index
                unlink_contact(w, c)
                body_id_a = c.edge_a.body_id
                body_id_b = c.edge_b.body_id
                add_non_touching_contact(w, c)
                remove_contact_from_graph(w, body_id_a, body_id_b, color_index, local_index, (c.flags & SIM_MESH_CONTACT) != 0)
            }
            changed = changed + 1
            block = block & (block - (1 as long))
        }
        k = k + 1
    }
    return changed
}

// The end events are double buffered so the user reads last pass's after
// the next has begun; the step swaps them.
swap_end_events(w: *World) {
    w.end_event_index = 1 - w.end_event_index
    basics.buffer_clear(end_events(w))
    basics.buffer_clear(sensor_end_events(w))
}

// --- contact validation --------------------------------------------------------------------------------------

// Every live contact is where its indices say (a colour's array or a
// set's indices), touching iff coloured or in a sleeping set, in its
// island iff touching; the pair set holds every contact's key; both
// bodies' lists close on their counts.
validate_contacts(w: *World) -> bool {
    live = 0
    i = 0
    while i < w.contacts.count {
        c = contact_at(w, i)
        if c.contact_id != NULL_INDEX {
            live = live + 1
            if c.contact_id != i { return false }
            if broad_phase.has_pair(&w.broad_phase, basics.shape_pair_key(c.shape_id_a, c.shape_id_b, c.child_index)) == false { return false }
            touching = (c.flags & CONTACT_TOUCHING) != 0
            if c.color_index != NULL_INDEX {
                if c.set_index != AWAKE_SET || touching == false { return false }
                color = graph_color(w, c.color_index)
                if (c.flags & SIM_MESH_CONTACT) != 0 || c.color_index == OVERFLOW_INDEX {
                    if c.local_index >= color.contacts.count || contact_spec_at(color, c.local_index).contact_id != i { return false }
                } else {
                    if c.local_index >= color.convex_contacts.count || basics.ints_get(&color.convex_contacts, c.local_index) != i { return false }
                }
                if c.island_id == NULL_INDEX { return false }
            } else {
                set = solver_set_at(w, c.set_index)
                if c.local_index >= set.contact_indices.count || basics.ints_get(&set.contact_indices, c.local_index) != i { return false }
                if c.set_index == AWAKE_SET && touching { return false }
                if c.set_index >= FIRST_SLEEPING_SET && touching == false { return false }
                if c.set_index == DISABLED_SET && (touching || c.island_id != NULL_INDEX) { return false }
            }
            if c.island_id != NULL_INDEX {
                island = island_at(w, c.island_id)
                if c.island_index >= island.contacts.count || contact_link_at(island, c.island_index).contact_id != i { return false }
            }
        }
        i = i + 1
    }
    if live != basics.idpool_count(&w.contact_id_pool) { return false }
    if broad_phase.pair_count(&w.broad_phase) != live { return false }
    // The bodies' lists.
    i = 0
    while i < w.bodies.count {
        body = body_at(w, i)
        if body.set_index != NULL_INDEX {
            count = 0
            key = body.head_contact_key
            prev = NULL_INDEX
            while key != NULL_INDEX {
                c = contact_at(w, key >> 1)
                edge_body = c.edge_b.body_id
                edge_prev = c.edge_b.prev_key
                if (key & 1) == 0 {
                    edge_body = c.edge_a.body_id
                    edge_prev = c.edge_a.prev_key
                }
                if edge_body != i || edge_prev != prev { return false }
                count = count + 1
                prev = key
                key = contact_edge_next(w, key)
            }
            if count != body.contact_count { return false }
        }
        i = i + 1
    }
    return true
}

// --- joints -----------------------------------------------------------------------------------------------

// The softness of a spring at a time step (b3MakeSoft): the bias rate,
// the mass scale and the impulse scale, the last two summing to one.
make_soft(hertz: float, zeta: float, h: float) -> Softness {
    if hertz == 0.0 { return Softness { bias_rate: 0.0, mass_scale: 0.0, impulse_scale: 0.0 } }
    omega = 2.0 * math.PI * hertz
    a1 = 2.0 * zeta + h * omega
    a2 = h * omega * a1
    a3 = 1.0 / (1.0 + a2)
    return Softness { bias_rate: omega / a1, mass_scale: a2 * a3, impulse_scale: a3 }
}

default_joint_def() -> JointDef {
    max = math.MAX_FLOAT
    return JointDef { user_data: null, body_id_a: null_body_id(), body_id_b: null_body_id(),
                      local_frame_a: math.transform_identity(), local_frame_b: math.transform_identity(),
                      force_threshold: max, torque_threshold: max, constraint_hertz: 60.0, constraint_damping_ratio: 2.0,
                      draw_scale: 1.0, collide_connected: false }
}

default_parallel_joint_def() -> ParallelJointDef {
    max = math.MAX_FLOAT
    return ParallelJointDef { base: default_joint_def(), hertz: 1.0, damping_ratio: 1.0, max_torque: max }
}

default_distance_joint_def() -> DistanceJointDef {
    max = math.MAX_FLOAT
    huge = math.HUGE
    return DistanceJointDef { base: default_joint_def(), length: 1.0, enable_spring: false, lower_spring_force: 0.0 - max,
                              upper_spring_force: max, hertz: 0.0, damping_ratio: 0.0, enable_limit: false, min_length: 0.0,
                              max_length: huge, enable_motor: false, max_motor_force: 0.0, motor_speed: 0.0 }
}

default_motor_joint_def() -> MotorJointDef {
    return MotorJointDef { base: default_joint_def(), linear_velocity: math.vec3_zero(), max_velocity_force: 0.0,
                           angular_velocity: math.vec3_zero(), max_velocity_torque: 0.0, linear_hertz: 0.0, linear_damping_ratio: 0.0,
                           max_spring_force: 0.0, angular_hertz: 0.0, angular_damping_ratio: 0.0, max_spring_torque: 0.0 }
}

default_filter_joint_def() -> FilterJointDef { return FilterJointDef { base: default_joint_def() } }

default_prismatic_joint_def() -> PrismaticJointDef {
    return PrismaticJointDef { base: default_joint_def(), enable_spring: false, hertz: 0.0, damping_ratio: 0.0, target_translation: 0.0,
                               enable_limit: false, lower_translation: 0.0, upper_translation: 0.0, enable_motor: false,
                               max_motor_force: 0.0, motor_speed: 0.0 }
}

default_revolute_joint_def() -> RevoluteJointDef {
    return RevoluteJointDef { base: default_joint_def(), target_angle: 0.0, enable_spring: false, hertz: 0.0, damping_ratio: 0.0,
                              enable_limit: false, lower_angle: 0.0, upper_angle: 0.0, enable_motor: false, max_motor_torque: 0.0,
                              motor_speed: 0.0 }
}

default_spherical_joint_def() -> SphericalJointDef {
    return SphericalJointDef { base: default_joint_def(), enable_spring: false, hertz: 0.0, damping_ratio: 0.0,
                               target_rotation: math.quat_identity(), enable_cone_limit: false, cone_angle: 0.0,
                               cone_axis: math.vec3_axis_z(), cone_minor_angle: 0.0, cone_major_axis: math.vec3_zero(),
                               enable_twist_limit: false, lower_twist_angle: 0.0, upper_twist_angle: 0.0, enable_motor: false,
                               max_motor_torque: 0.0, motor_velocity: math.vec3_zero() }
}

default_weld_joint_def() -> WeldJointDef {
    return WeldJointDef { base: default_joint_def(), linear_hertz: 0.0, angular_hertz: 0.0, linear_damping_ratio: 0.0, angular_damping_ratio: 0.0 }
}

default_wheel_joint_def() -> WheelJointDef {
    return WheelJointDef { base: default_joint_def(), enable_suspension_spring: true, suspension_hertz: 1.0, suspension_damping_ratio: 0.7,
                           enable_suspension_limit: false, lower_suspension_limit: 0.0, upper_suspension_limit: 0.0,
                           enable_spin_motor: false, max_spin_torque: 0.0, spin_speed: 0.0, enable_steering: false, steering_hertz: 1.0,
                           steering_damping_ratio: 0.7, target_steering_angle: 0.0, max_steering_torque: 0.0, enable_steering_limit: false,
                           lower_steering_limit: 0.0, upper_steering_limit: 0.0 }
}

null_joint_id() -> JointId { return JointId { index1: 0, world0: 0, generation: 0 } }

// The kind's data inside a sim.
distance_joint_of(sim: *JointSim) -> *DistanceJoint { return (&sim.data) as *DistanceJoint }
motor_joint_of(sim: *JointSim) -> *MotorJoint { return (&sim.data) as *MotorJoint }
parallel_joint_of(sim: *JointSim) -> *ParallelJoint { return (&sim.data) as *ParallelJoint }
prismatic_joint_of(sim: *JointSim) -> *PrismaticJoint { return (&sim.data) as *PrismaticJoint }
revolute_joint_of(sim: *JointSim) -> *RevoluteJoint { return (&sim.data) as *RevoluteJoint }
spherical_joint_of(sim: *JointSim) -> *SphericalJoint { return (&sim.data) as *SphericalJoint }
weld_joint_of(sim: *JointSim) -> *WeldJoint { return (&sim.data) as *WeldJoint }
wheel_joint_of(sim: *JointSim) -> *WheelJoint { return (&sim.data) as *WheelJoint }

joint_is_valid(id: JointId) -> bool {
    if id.world0 < 0 || id.world0 >= MAX_WORLDS { return false }
    worlds_ready()
    w = world_at(id.world0)
    if w.in_use == false { return false }
    if id.index1 < 1 || id.index1 > w.joints.count { return false }
    j = joint_at(w, id.index1 - 1)
    if j.joint_id == NULL_INDEX { return false }
    return j.generation == id.generation
}

get_joint_full_id(w: *World, id: JointId) -> *Joint { return joint_at(w, id.index1 - 1) }
make_joint_id(w: *World, j: *Joint) -> JointId { return JointId { index1: j.joint_id + 1, world0: w.world_id, generation: j.generation } }

// The joint's sim: in its colour of the graph when awake, in its set otherwise.
get_joint_sim(w: *World, j: *Joint) -> *JointSim {
    if j.set_index == AWAKE_SET { return joint_sim_at(&graph_color(w, j.color_index).joint_sims, j.local_index) }
    return joint_sim_at(&solver_set_at(w, j.set_index).joint_sims, j.local_index)
}

// The sim of a joint id, when it is of the kind (null otherwise).
get_joint_sim_of_kind(id: JointId, kind: int) -> *JointSim {
    if joint_is_valid(id) == false { return null }
    w = world_at(id.world0)
    j = get_joint_full_id(w, id)
    if j.kind != kind { return null }
    return get_joint_sim(w, j)
}

// Every contact between two bodies destroyed (a joint that forbids their
// collision); walks the shorter list, and wakes nobody.
destroy_contacts_between_bodies(w: *World, body_a: *Body, body_b: *Body) {
    key = body_a.head_contact_key
    other_id = body_b.id
    if body_b.contact_count < body_a.contact_count {
        key = body_b.head_contact_key
        other_id = body_a.id
    }
    while key != NULL_INDEX {
        c = contact_at(w, key >> 1)
        edge_index = key & 1
        key = contact_edge_next(w, key)
        other = c.edge_b.body_id
        if edge_index == 1 { other = c.edge_a.body_id }
        if other == other_id { destroy_contact(w, c, false) }
    }
}

// A joint sim zeroed in a colour of the graph; its index in the joint.
// A new sim's joint and bodies, named before anything can move it: a
// merge of two sleeping sets finds each sim's joint by its id to fix the
// joint's set and index, so a sim still reading joint 0 would repoint
// joint 0 and leave its own joint at the destroyed set.
name_joint_sim(sim: *JointSim, j: *Joint) {
    sim.joint_id = j.joint_id
    sim.body_id_a = j.edge_a.body_id
    sim.body_id_b = j.edge_b.body_id
}

create_joint_in_graph(w: *World, j: *Joint) -> *JointSim {
    body_a = body_at(w, j.edge_a.body_id)
    body_b = body_at(w, j.edge_b.body_id)
    color_index = assign_color(&w.constraint_graph, body_a.id, body_b.id, body_a.kind, body_b.kind)
    color = graph_color(w, color_index)
    index = basics.buffer_push(&color.joint_sims)
    sim = joint_sim_at(&color.joint_sims, index)
    memset(sim as ptr, 0, sizeof(JointSim))
    name_joint_sim(sim, j)
    j.color_index = color_index
    j.local_index = index
    return sim
}

// A zeroed joint sim at the end of a set's; its index in the joint.
create_joint_in_set(w: *World, set_index: int, j: *Joint) -> *JointSim {
    set = solver_set_at(w, set_index)
    j.set_index = set_index
    j.local_index = set.joint_sims.count
    index = basics.buffer_push(&set.joint_sims)
    sim = joint_sim_at(&set.joint_sims, index)
    memset(sim as ptr, 0, sizeof(JointSim))
    name_joint_sim(sim, j)
    return sim
}

// The base of every joint (b3CreateJoint): the contacts between the
// bodies destroyed unless they may collide, the joint's slot and edges on
// both bodies, its sim in the disabled set when a body is disabled, the
// static set when neither is dynamic, the graph when either is awake
// (the other's set woken), else the sleeping set (two sleeping sets
// merged); then the island link. The world's lock is the caller's.
create_joint(w: *World, def: *JointDef, kind: int) -> JointPair {
    body_a = get_body_full_id(w, def.body_id_a)
    body_b = get_body_full_id(w, def.body_id_b)
    if def.collide_connected == false { destroy_contacts_between_bodies(w, body_a, body_b) }
    body_id_a = body_a.id
    body_id_b = body_b.id
    max_set_index = math.max_int(body_a.set_index, body_b.set_index)
    joint_id = basics.idpool_alloc(&w.joint_id_pool)
    if joint_id == w.joints.count {
        index = basics.buffer_push(&w.joints)
        fresh = joint_at(w, index)
        memset(fresh as ptr, 0, sizeof(Joint))
    }
    j = joint_at(w, joint_id)
    j.joint_id = joint_id
    j.user_data = def.user_data
    j.generation = j.generation + 1
    j.set_index = NULL_INDEX
    j.color_index = NULL_INDEX
    j.local_index = NULL_INDEX
    j.island_id = NULL_INDEX
    j.island_index = NULL_INDEX
    j.draw_scale = def.draw_scale
    j.kind = kind
    j.collide_connected = def.collide_connected
    // The doubly linked list on body A.
    j.edge_a.body_id = body_id_a
    j.edge_a.prev_key = NULL_INDEX
    j.edge_a.next_key = body_a.head_joint_key
    key_a = (joint_id << 1) | 0
    if body_a.head_joint_key != NULL_INDEX { set_joint_edge_prev(w, body_a.head_joint_key, key_a) }
    body_a.head_joint_key = key_a
    body_a.joint_count = body_a.joint_count + 1
    // And on body B.
    j.edge_b.body_id = body_id_b
    j.edge_b.prev_key = NULL_INDEX
    j.edge_b.next_key = body_b.head_joint_key
    key_b = (joint_id << 1) | 1
    if body_b.head_joint_key != NULL_INDEX { set_joint_edge_prev(w, body_b.head_joint_key, key_b) }
    body_b.head_joint_key = key_b
    body_b.joint_count = body_b.joint_count + 1

    sim = null as *JointSim
    if body_a.set_index == DISABLED_SET || body_b.set_index == DISABLED_SET {
        sim = create_joint_in_set(w, DISABLED_SET, j)
    } else if body_a.kind != BODY_DYNAMIC && body_b.kind != BODY_DYNAMIC {
        sim = create_joint_in_set(w, STATIC_SET, j)
    } else if body_a.set_index == AWAKE_SET || body_b.set_index == AWAKE_SET {
        if max_set_index >= FIRST_SLEEPING_SET { wake_solver_set(w, max_set_index) }
        j.set_index = AWAKE_SET
        sim = create_joint_in_graph(w, j)
    } else {
        // Between sleeping and/or static bodies: the sleeping set, two of them merged.
        sim = create_joint_in_set(w, max_set_index, j)
        if body_a.set_index != body_b.set_index && body_a.set_index >= FIRST_SLEEPING_SET && body_b.set_index >= FIRST_SLEEPING_SET {
            merge_solver_sets(w, body_a.set_index, body_b.set_index)
            // The merge moved the sim.
            sim = joint_sim_at(&solver_set_at(w, body_a.set_index).joint_sims, j.local_index)
        }
    }
    sim.joint_id = joint_id
    sim.body_id_a = body_id_a
    sim.body_id_b = body_id_b
    sim.local_frame_a = def.local_frame_a
    sim.local_frame_b = def.local_frame_b
    sim.kind = kind
    sim.constraint_hertz = def.constraint_hertz
    sim.constraint_damping_ratio = def.constraint_damping_ratio
    sim.constraint_softness = Softness { bias_rate: 0.0, mass_scale: 1.0, impulse_scale: 0.0 }
    sim.force_threshold = def.force_threshold
    sim.torque_threshold = def.torque_threshold
    if j.set_index > DISABLED_SET { link_joint(w, j) }
    return JointPair { joint: j, sim: sim }
}

set_joint_edge_prev(w: *World, key: int, prev: int) {
    j = joint_at(w, key >> 1)
    if (key & 1) == 0 { j.edge_a.prev_key = prev } else { j.edge_b.prev_key = prev }
}

set_joint_edge_next(w: *World, key: int, next: int) {
    j = joint_at(w, key >> 1)
    if (key & 1) == 0 { j.edge_a.next_key = next } else { j.edge_b.next_key = next }
}

joint_edge_next(w: *World, key: int) -> int {
    j = joint_at(w, key >> 1)
    if (key & 1) == 0 { return j.edge_a.next_key }
    return j.edge_b.next_key
}

joint_edge_prev(w: *World, key: int) -> int {
    j = joint_at(w, key >> 1)
    if (key & 1) == 0 { return j.edge_a.prev_key }
    return j.edge_b.prev_key
}

// The world of a joint definition, unlocked; null when it is not usable.
joint_world(world_id: WorldId, def: *JointDef) -> *World {
    if world_is_valid(world_id) == false { return null }
    w = get_world_from_id(world_id)
    if w.locked { return null }
    if body_is_valid(def.body_id_a) == false || body_is_valid(def.body_id_b) == false { return null }
    if def.body_id_a.world0 != w.world_id || def.body_id_b.world0 != w.world_id { return null }
    if def.body_id_a.index1 == def.body_id_b.index1 { return null }
    if math.is_valid_transform(def.local_frame_a) == false || math.is_valid_transform(def.local_frame_b) == false { return null }
    if valid_nonnegative(def.force_threshold) == false || valid_nonnegative(def.torque_threshold) == false { return null }
    if valid_nonnegative(def.constraint_hertz) == false || valid_nonnegative(def.constraint_damping_ratio) == false { return null }
    return w
}

// A spring's stiffness and damping, both finite and not below zero.
valid_spring(hertz: float, damping_ratio: float) -> bool { return valid_nonnegative(hertz) && valid_nonnegative(damping_ratio) }

// A lower and upper bound, finite and in order.
valid_range(lower: float, upper: float) -> bool { return math.is_valid_float(lower) && math.is_valid_float(upper) && lower <= upper }

create_distance_joint(world_id: WorldId, def: *DistanceJointDef) -> JointId {
    if recording_on(world_id.index1 - 1) == false { return create_distance_joint_internal(world_id, def) }
    recorder = rec_begin(world_id.index1 - 1, OP_CREATE_DISTANCE_JOINT)
    rec_distance_joint_def(recorder, def)
    made = create_distance_joint_internal(world_id, def)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_distance_joint's work, unrecorded.
create_distance_joint_internal(world_id: WorldId, def: *DistanceJointDef) -> JointId {
    w = joint_world(world_id, &def.base)
    if w == null { return null_joint_id() }
    if math.is_valid_float(def.length) == false || def.length <= 0.0 || valid_range(def.lower_spring_force, def.upper_spring_force) == false { return null_joint_id() }
    if valid_spring(def.hertz, def.damping_ratio) == false || math.is_valid_float(def.min_length) == false || math.is_valid_float(def.max_length) == false { return null_joint_id() }
    if valid_nonnegative(def.max_motor_force) == false || math.is_valid_float(def.motor_speed) == false { return null_joint_id() }
    w.locked = true
    pair = create_joint(w, &def.base, JOINT_DISTANCE)
    d = distance_joint_of(pair.sim)
    d.length = math.max_float(def.length, math.LINEAR_SLOP)
    d.hertz = def.hertz
    d.damping_ratio = def.damping_ratio
    d.lower_spring_force = def.lower_spring_force
    d.upper_spring_force = def.upper_spring_force
    d.min_length = math.max_float(def.min_length, math.LINEAR_SLOP)
    d.max_length = math.max_float(def.min_length, def.max_length)
    d.max_motor_force = def.max_motor_force
    d.motor_speed = def.motor_speed
    d.enable_spring = def.enable_spring
    d.enable_limit = def.enable_limit
    d.enable_motor = def.enable_motor
    w.locked = false
    return make_joint_id(w, pair.joint)
}

create_motor_joint(world_id: WorldId, def: *MotorJointDef) -> JointId {
    if recording_on(world_id.index1 - 1) == false { return create_motor_joint_internal(world_id, def) }
    recorder = rec_begin(world_id.index1 - 1, OP_CREATE_MOTOR_JOINT)
    rec_motor_joint_def(recorder, def)
    made = create_motor_joint_internal(world_id, def)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_motor_joint's work, unrecorded.
create_motor_joint_internal(world_id: WorldId, def: *MotorJointDef) -> JointId {
    w = joint_world(world_id, &def.base)
    if w == null { return null_joint_id() }
    if math.is_valid_vec3(def.linear_velocity) == false || math.is_valid_vec3(def.angular_velocity) == false { return null_joint_id() }
    if valid_nonnegative(def.max_velocity_force) == false || valid_nonnegative(def.max_velocity_torque) == false { return null_joint_id() }
    if valid_spring(def.linear_hertz, def.linear_damping_ratio) == false || valid_spring(def.angular_hertz, def.angular_damping_ratio) == false { return null_joint_id() }
    if valid_nonnegative(def.max_spring_force) == false || valid_nonnegative(def.max_spring_torque) == false { return null_joint_id() }
    w.locked = true
    pair = create_joint(w, &def.base, JOINT_MOTOR)
    m = motor_joint_of(pair.sim)
    m.linear_velocity = def.linear_velocity
    m.max_velocity_force = def.max_velocity_force
    m.angular_velocity = def.angular_velocity
    m.max_velocity_torque = def.max_velocity_torque
    m.linear_hertz = def.linear_hertz
    m.linear_damping_ratio = def.linear_damping_ratio
    m.max_spring_force = def.max_spring_force
    m.angular_hertz = def.angular_hertz
    m.angular_damping_ratio = def.angular_damping_ratio
    m.max_spring_torque = def.max_spring_torque
    w.locked = false
    return make_joint_id(w, pair.joint)
}

create_filter_joint(world_id: WorldId, def: *FilterJointDef) -> JointId {
    if recording_on(world_id.index1 - 1) == false { return create_filter_joint_internal(world_id, def) }
    recorder = rec_begin(world_id.index1 - 1, OP_CREATE_FILTER_JOINT)
    rec_filter_joint_def(recorder, def)
    made = create_filter_joint_internal(world_id, def)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_filter_joint's work, unrecorded.
create_filter_joint_internal(world_id: WorldId, def: *FilterJointDef) -> JointId {
    w = joint_world(world_id, &def.base)
    if w == null { return null_joint_id() }
    w.locked = true
    pair = create_joint(w, &def.base, JOINT_FILTER)
    w.locked = false
    return make_joint_id(w, pair.joint)
}

create_parallel_joint(world_id: WorldId, def: *ParallelJointDef) -> JointId {
    if recording_on(world_id.index1 - 1) == false { return create_parallel_joint_internal(world_id, def) }
    recorder = rec_begin(world_id.index1 - 1, OP_CREATE_PARALLEL_JOINT)
    rec_parallel_joint_def(recorder, def)
    made = create_parallel_joint_internal(world_id, def)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_parallel_joint's work, unrecorded.
create_parallel_joint_internal(world_id: WorldId, def: *ParallelJointDef) -> JointId {
    w = joint_world(world_id, &def.base)
    if w == null { return null_joint_id() }
    if valid_spring(def.hertz, def.damping_ratio) == false || valid_nonnegative(def.max_torque) == false { return null_joint_id() }
    w.locked = true
    pair = create_joint(w, &def.base, JOINT_PARALLEL)
    p = parallel_joint_of(pair.sim)
    p.hertz = def.hertz
    p.damping_ratio = def.damping_ratio
    p.max_torque = def.max_torque
    w.locked = false
    return make_joint_id(w, pair.joint)
}

create_prismatic_joint(world_id: WorldId, def: *PrismaticJointDef) -> JointId {
    if recording_on(world_id.index1 - 1) == false { return create_prismatic_joint_internal(world_id, def) }
    recorder = rec_begin(world_id.index1 - 1, OP_CREATE_PRISMATIC_JOINT)
    rec_prismatic_joint_def(recorder, def)
    made = create_prismatic_joint_internal(world_id, def)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_prismatic_joint's work, unrecorded.
create_prismatic_joint_internal(world_id: WorldId, def: *PrismaticJointDef) -> JointId {
    w = joint_world(world_id, &def.base)
    if w == null { return null_joint_id() }
    if valid_range(def.lower_translation, def.upper_translation) == false || math.is_valid_float(def.target_translation) == false { return null_joint_id() }
    if valid_spring(def.hertz, def.damping_ratio) == false || valid_nonnegative(def.max_motor_force) == false || math.is_valid_float(def.motor_speed) == false { return null_joint_id() }
    w.locked = true
    pair = create_joint(w, &def.base, JOINT_PRISMATIC)
    p = prismatic_joint_of(pair.sim)
    p.hertz = def.hertz
    p.damping_ratio = def.damping_ratio
    p.target_translation = def.target_translation
    p.lower_translation = def.lower_translation
    p.upper_translation = def.upper_translation
    p.max_motor_force = def.max_motor_force
    p.motor_speed = def.motor_speed
    p.enable_spring = def.enable_spring
    p.enable_limit = def.enable_limit
    p.enable_motor = def.enable_motor
    w.locked = false
    return make_joint_id(w, pair.joint)
}

create_revolute_joint(world_id: WorldId, def: *RevoluteJointDef) -> JointId {
    if recording_on(world_id.index1 - 1) == false { return create_revolute_joint_internal(world_id, def) }
    recorder = rec_begin(world_id.index1 - 1, OP_CREATE_REVOLUTE_JOINT)
    rec_revolute_joint_def(recorder, def)
    made = create_revolute_joint_internal(world_id, def)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_revolute_joint's work, unrecorded.
create_revolute_joint_internal(world_id: WorldId, def: *RevoluteJointDef) -> JointId {
    w = joint_world(world_id, &def.base)
    if w == null { return null_joint_id() }
    if math.is_valid_float(def.lower_angle) == false || math.is_valid_float(def.upper_angle) == false || math.is_valid_float(def.target_angle) == false { return null_joint_id() }
    if valid_spring(def.hertz, def.damping_ratio) == false || valid_nonnegative(def.max_motor_torque) == false || math.is_valid_float(def.motor_speed) == false { return null_joint_id() }
    w.locked = true
    pair = create_joint(w, &def.base, JOINT_REVOLUTE)
    r = revolute_joint_of(pair.sim)
    pi = math.PI
    r.hertz = def.hertz
    r.damping_ratio = def.damping_ratio
    r.target_angle = math.clamp_float(def.target_angle, 0.0 - pi, pi)
    lower = math.min_float(def.lower_angle, def.upper_angle)
    upper = math.max_float(def.lower_angle, def.upper_angle)
    r.lower_angle = math.clamp_float(lower, 0.0 - 0.99 * pi, 0.99 * pi)
    r.upper_angle = math.clamp_float(upper, 0.0 - 0.99 * pi, 0.99 * pi)
    r.max_motor_torque = def.max_motor_torque
    r.motor_speed = def.motor_speed
    r.enable_spring = def.enable_spring
    r.enable_limit = def.enable_limit
    r.enable_motor = def.enable_motor
    w.locked = false
    return make_joint_id(w, pair.joint)
}

create_spherical_joint(world_id: WorldId, def: *SphericalJointDef) -> JointId {
    if recording_on(world_id.index1 - 1) == false { return create_spherical_joint_internal(world_id, def) }
    recorder = rec_begin(world_id.index1 - 1, OP_CREATE_SPHERICAL_JOINT)
    rec_spherical_joint_def(recorder, def)
    made = create_spherical_joint_internal(world_id, def)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_spherical_joint's work, unrecorded.
create_spherical_joint_internal(world_id: WorldId, def: *SphericalJointDef) -> JointId {
    w = joint_world(world_id, &def.base)
    if w == null { return null_joint_id() }
    pi = math.PI
    if valid_nonnegative(def.cone_angle) == false || def.cone_angle > 0.99 * pi || math.is_valid_quat(def.target_rotation) == false { return null_joint_id() }
    if math.is_valid_float(def.lower_twist_angle) == false || math.is_valid_float(def.upper_twist_angle) == false { return null_joint_id() }
    if valid_spring(def.hertz, def.damping_ratio) == false || valid_nonnegative(def.max_motor_torque) == false || math.is_valid_vec3(def.motor_velocity) == false { return null_joint_id() }
    if math.is_valid_vec3(def.cone_axis) == false || math.length(def.cone_axis) < 0.001 { return null_joint_id() }
    if valid_nonnegative(def.cone_minor_angle) == false || def.cone_minor_angle > 0.99 * pi || math.is_valid_vec3(def.cone_major_axis) == false { return null_joint_id() }
    w.locked = true
    pair = create_joint(w, &def.base, JOINT_SPHERICAL)
    s = spherical_joint_of(pair.sim)
    s.hertz = def.hertz
    s.damping_ratio = def.damping_ratio
    s.target_rotation = def.target_rotation
    set_spherical_cone_axis(s, def.cone_axis)
    s.cone_angle = clamp_spherical_cone(s, def.cone_angle)
    s.cone_major_axis = math.narrow3(def.cone_major_axis)
    s.cone_minor_angle = spherical_cone_minor(s, def.cone_minor_angle)
    lower = math.min_float(def.lower_twist_angle, def.upper_twist_angle)
    upper = math.max_float(def.lower_twist_angle, def.upper_twist_angle)
    s.lower_twist_angle = math.clamp_float(lower, 0.0 - 0.99 * pi, 0.99 * pi)
    s.upper_twist_angle = math.clamp_float(upper, 0.0 - 0.99 * pi, 0.99 * pi)
    s.max_motor_torque = def.max_motor_torque
    s.motor_velocity = def.motor_velocity
    s.enable_spring = def.enable_spring
    s.enable_cone_limit = def.enable_cone_limit
    s.enable_twist_limit = def.enable_twist_limit
    s.enable_motor = def.enable_motor
    w.locked = false
    return make_joint_id(w, pair.joint)
}

// A spherical joint's cone centred on `axis` (in frame A, made unit). Off
// frame A's z it measures the swing as the angle from the centre to frame
// B's z; on it the reference's swing, bit for bit.
set_spherical_cone_axis(s: *SphericalJoint, axis: Vec3) { s.cone_axis = math.normalize(axis) }

// Whether the cone's centre is off frame A's z (read from the axis: the
// joint's data has no room left for a flag).
spherical_cone_off_axis(s: *SphericalJoint) -> bool { return s.cone_axis.x != 0.0 || s.cone_axis.y != 0.0 || s.cone_axis.z <= 0.0 }

// The reference bounds its cone at a right angle about frame A's z. A cone
// centred off the rest, a shoulder's, reaches farther: to 0.8 pi, short of
// the far pole where the swing's axis is lost.
clamp_spherical_cone(s: *SphericalJoint, angle: float) -> float {
    if spherical_cone_off_axis(s) { return math.clamp_float(angle, 0.0, 0.8 * math.PI) }
    return math.clamp_float(angle, 0.0, 0.5 * math.PI)
}

// The swing a spherical joint's cone limits, from the frames' relative rotation.
spherical_swing_angle(s: *SphericalJoint, rel_q: Quat) -> float {
    if spherical_cone_off_axis(s) == false { return math.get_swing_angle(rel_q) }
    b = math.rotate_vector(rel_q, math.vec3_axis_z())
    return math.atan2_approx(math.length(math.cross(s.cone_axis, b)), math.dot(s.cone_axis, b))
}

// Whether a spherical joint's cone is an ellipse (two half-angles) rather
// than the reference's circle.
spherical_cone_elliptical(s: *SphericalJoint) -> bool { return s.cone_minor_angle > 0.0 }

// An ellipse's minor half-angle as stored: 0 (the circle) when it is the
// major one in the precision it is kept in, so equal angles are the
// reference's circle, bit for bit.
spherical_cone_minor(s: *SphericalJoint, minor: float) -> f32 {
    clamped = clamp_spherical_cone(s, minor)
    if (clamped as f32) == (s.cone_angle as f32) { return 0.0 }
    return clamped as f32
}

// Where frame B's z is against an elliptical cone, in frame A: the angle
// from the centre, the direction it lies in (unit, across the centre) and
// that direction's parts along the ellipse's axes.
struct ConeReach {
    theta: float
    sin_theta: float
    cos_theta: float
    across: Vec3
    along_major: float
    along_minor: float
}

cone_reach(s: *SphericalJoint, b: Vec3) -> ConeReach {
    c = s.cone_axis
    cos_t = math.dot(c, b)
    lateral = math.sub(b, math.mul_sv(cos_t, c))
    sin_t = math.length(lateral)
    reach = ConeReach { theta: math.atan2_approx(sin_t, cos_t), sin_theta: sin_t, cos_theta: cos_t, across: math.vec3_zero(), along_major: 1.0, along_minor: 0.0 }
    if sin_t < math.EPSILON { return reach }
    d = math.mul_sv(1.0 / sin_t, lateral)
    // The ellipse's axes across the centre: the major one from
    // cone_major_axis (frame A's x when zero, its y when x lies along the
    // centre), the minor one square to it.
    major = math.widen3(s.cone_major_axis)
    if math.length_squared(major) == 0.0 { major = math.vec3_axis_x() }
    major = math.sub(major, math.mul_sv(math.dot(major, c), c))
    if math.length_squared(major) < 0.000001 { major = math.sub(math.vec3_axis_y(), math.mul_sv(c.y, c)) }
    major = math.normalize(major)
    minor = math.cross(c, major)
    reach.across = d
    reach.along_major = math.dot(d, major)
    reach.along_minor = math.dot(d, minor)
    return reach
}

// The ellipse's half-angle in a direction: the polar radius of an ellipse
// of half-angles a (along the major axis) and b (across it).
cone_radius(a: float, b: float, along_major: float, along_minor: float) -> float {
    return a * b / sqrt((b * along_major) * (b * along_major) + (a * along_minor) * (a * along_minor))
}

// How far frame B's z is inside the cone, radians: the limit's separation
// (negative past it). The circle's is the reference's, bit for bit; the
// ellipse's is its radius in frame B's direction less the angle there.
spherical_cone_gap(s: *SphericalJoint, rel_q: Quat) -> float {
    if spherical_cone_elliptical(s) == false { return s.cone_angle - spherical_swing_angle(s, rel_q) }
    reach = cone_reach(s, math.rotate_vector(rel_q, math.vec3_axis_z()))
    if reach.sin_theta < math.EPSILON { return math.min_float(s.cone_angle, s.cone_minor_angle as float) }
    return cone_radius(s.cone_angle, s.cone_minor_angle as float, reach.along_major, reach.along_minor) - reach.theta
}

// The world axis the cone limit pushes about, with frame B's z at
// `twist_axis` (world): for the circle the reference's, the centre crossed
// with B's z; for the ellipse the rotation that carries B's z along the
// ellipse's normal there (in the angles' plane, the gradient of
// (x/a)^2 + (y/b)^2), which is the circle's when a = b.
spherical_cone_push_axis(s: *SphericalJoint, frame_a_q: Quat, twist_axis: Vec3) -> Vec3 {
    if spherical_cone_elliptical(s) == false { return math.normalize(math.cross(math.rotate_vector(frame_a_q, s.cone_axis), twist_axis)) }
    b = math.inv_rotate_vector(frame_a_q, twist_axis)
    reach = cone_reach(s, b)
    if reach.sin_theta < math.EPSILON { return math.vec3_zero() }
    a = s.cone_angle
    minor = s.cone_minor_angle as float
    normal_major = reach.theta * reach.along_major / (a * a)
    normal_minor = reach.theta * reach.along_minor / (minor * minor)
    radial = normal_major * reach.along_major + normal_minor * reach.along_minor
    around = normal_minor * reach.along_major - normal_major * reach.along_minor
    // B's z moves along `outward` as the angle grows and along `sideways`
    // as the direction turns about the centre.
    outward = math.sub(math.mul_sv(reach.cos_theta, reach.across), math.mul_sv(reach.sin_theta, s.cone_axis))
    sideways = math.cross(s.cone_axis, reach.across)
    tangent = math.add(math.mul_sv(radial, outward), math.mul_sv(around, sideways))
    return math.rotate_vector(frame_a_q, math.normalize(math.cross(b, tangent)))
}

create_weld_joint(world_id: WorldId, def: *WeldJointDef) -> JointId {
    if recording_on(world_id.index1 - 1) == false { return create_weld_joint_internal(world_id, def) }
    recorder = rec_begin(world_id.index1 - 1, OP_CREATE_WELD_JOINT)
    rec_weld_joint_def(recorder, def)
    made = create_weld_joint_internal(world_id, def)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_weld_joint's work, unrecorded.
create_weld_joint_internal(world_id: WorldId, def: *WeldJointDef) -> JointId {
    w = joint_world(world_id, &def.base)
    if w == null { return null_joint_id() }
    if valid_spring(def.angular_hertz, def.angular_damping_ratio) == false || valid_spring(def.linear_hertz, def.linear_damping_ratio) == false { return null_joint_id() }
    w.locked = true
    pair = create_joint(w, &def.base, JOINT_WELD)
    weld = weld_joint_of(pair.sim)
    weld.linear_hertz = def.linear_hertz
    weld.linear_damping_ratio = def.linear_damping_ratio
    weld.angular_hertz = def.angular_hertz
    weld.angular_damping_ratio = def.angular_damping_ratio
    w.locked = false
    return make_joint_id(w, pair.joint)
}

create_wheel_joint(world_id: WorldId, def: *WheelJointDef) -> JointId {
    if recording_on(world_id.index1 - 1) == false { return create_wheel_joint_internal(world_id, def) }
    recorder = rec_begin(world_id.index1 - 1, OP_CREATE_WHEEL_JOINT)
    rec_wheel_joint_def(recorder, def)
    made = create_wheel_joint_internal(world_id, def)
    rec_id(recorder, made.index1, made.generation)
    rec_end(recorder)
    return made
}

// create_wheel_joint's work, unrecorded.
create_wheel_joint_internal(world_id: WorldId, def: *WheelJointDef) -> JointId {
    w = joint_world(world_id, &def.base)
    if w == null { return null_joint_id() }
    if valid_range(def.lower_suspension_limit, def.upper_suspension_limit) == false { return null_joint_id() }
    // Reversed steering limits would push the wheel both ways at once.
    if valid_range(def.lower_steering_limit, def.upper_steering_limit) == false { return null_joint_id() }
    if valid_spring(def.suspension_hertz, def.suspension_damping_ratio) == false || valid_spring(def.steering_hertz, def.steering_damping_ratio) == false { return null_joint_id() }
    if valid_nonnegative(def.max_spin_torque) == false || valid_nonnegative(def.max_steering_torque) == false { return null_joint_id() }
    if math.is_valid_float(def.spin_speed) == false || math.is_valid_float(def.target_steering_angle) == false { return null_joint_id() }
    w.locked = true
    pair = create_joint(w, &def.base, JOINT_WHEEL)
    wheel = wheel_joint_of(pair.sim)
    wheel.enable_suspension_spring = def.enable_suspension_spring
    wheel.suspension_hertz = def.suspension_hertz
    wheel.suspension_damping_ratio = def.suspension_damping_ratio
    wheel.enable_suspension_limit = def.enable_suspension_limit
    wheel.lower_suspension_limit = def.lower_suspension_limit
    wheel.upper_suspension_limit = def.upper_suspension_limit
    wheel.enable_spin_motor = def.enable_spin_motor
    wheel.max_spin_torque = def.max_spin_torque
    wheel.spin_speed = def.spin_speed
    wheel.enable_steering = def.enable_steering
    wheel.steering_hertz = def.steering_hertz
    wheel.steering_damping_ratio = def.steering_damping_ratio
    wheel.target_steering_angle = def.target_steering_angle
    wheel.max_steering_torque = def.max_steering_torque
    wheel.enable_steering_limit = def.enable_steering_limit
    wheel.lower_steering_limit = def.lower_steering_limit
    wheel.upper_steering_limit = def.upper_steering_limit
    w.locked = false
    return make_joint_id(w, pair.joint)
}

// The joint out of both bodies' lists, its island, its colour or set;
// its id freed (the generation kept); the bodies woken when asked.
destroy_joint_internal(w: *World, j: *Joint, wake_bodies: bool) {
    joint_id = j.joint_id
    body_a = body_at(w, j.edge_a.body_id)
    body_b = body_at(w, j.edge_b.body_id)
    // Out of body A's list.
    if j.edge_a.prev_key != NULL_INDEX { set_joint_edge_next(w, j.edge_a.prev_key, j.edge_a.next_key) }
    if j.edge_a.next_key != NULL_INDEX { set_joint_edge_prev(w, j.edge_a.next_key, j.edge_a.prev_key) }
    if body_a.head_joint_key == ((joint_id << 1) | 0) { body_a.head_joint_key = j.edge_a.next_key }
    body_a.joint_count = body_a.joint_count - 1
    // Out of body B's.
    if j.edge_b.prev_key != NULL_INDEX { set_joint_edge_next(w, j.edge_b.prev_key, j.edge_b.next_key) }
    if j.edge_b.next_key != NULL_INDEX { set_joint_edge_prev(w, j.edge_b.next_key, j.edge_b.prev_key) }
    if body_b.head_joint_key == ((joint_id << 1) | 1) { body_b.head_joint_key = j.edge_b.next_key }
    body_b.joint_count = body_b.joint_count - 1
    if j.island_id != NULL_INDEX { unlink_joint(w, j) }
    set_index = j.set_index
    local_index = j.local_index
    if set_index == AWAKE_SET {
        remove_joint_from_graph(w, j.edge_a.body_id, j.edge_b.body_id, j.color_index, local_index)
    } else {
        set = solver_set_at(w, set_index)
        moved = basics.buffer_remove_swap(&set.joint_sims, local_index)
        if moved != NULL_INDEX && moved != local_index {
            joint_at(w, joint_sim_at(&set.joint_sims, local_index).joint_id).local_index = local_index
        }
    }
    j.set_index = NULL_INDEX
    j.local_index = NULL_INDEX
    j.color_index = NULL_INDEX
    j.joint_id = NULL_INDEX
    basics.idpool_free(&w.joint_id_pool, joint_id)
    if wake_bodies {
        wake_body(w, body_a)
        wake_body(w, body_b)
    }
}

destroy_joint(id: JointId, wake_attached: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_DESTROY_JOINT); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, wake_attached); rec_end(recorder) }
    if joint_is_valid(id) == false { return }
    w = world_at(id.world0)
    if w.locked { return }
    w.locked = true
    destroy_joint_internal(w, get_joint_full_id(w, id), wake_attached)
    w.locked = false
}

// --- joint accessors ----------------------------------------------------------------------------------------

joint_get_type(id: JointId) -> int { return get_joint_full_id(world_at(id.world0), id).kind }
joint_get_body_a(id: JointId) -> BodyId {
    w = world_at(id.world0)
    return make_body_id(w, get_joint_full_id(w, id).edge_a.body_id)
}
joint_get_body_b(id: JointId) -> BodyId {
    w = world_at(id.world0)
    return make_body_id(w, get_joint_full_id(w, id).edge_b.body_id)
}
joint_get_world(id: JointId) -> WorldId {
    w = world_at(id.world0)
    return WorldId { index1: id.world0 + 1, generation: w.generation }
}
joint_set_local_frame_a(id: JointId, frame: Transform) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_JOINT_SET_LOCAL_FRAME_A); rec_id(recorder, id.index1, id.generation); rec_transform(recorder, frame); rec_end(recorder) }
    if math.is_valid_transform(frame) == false { return }
    w = world_at(id.world0)
    get_joint_sim(w, get_joint_full_id(w, id)).local_frame_a = frame
}
joint_get_local_frame_a(id: JointId) -> Transform {
    w = world_at(id.world0)
    return get_joint_sim(w, get_joint_full_id(w, id)).local_frame_a
}
joint_set_local_frame_b(id: JointId, frame: Transform) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_JOINT_SET_LOCAL_FRAME_B); rec_id(recorder, id.index1, id.generation); rec_transform(recorder, frame); rec_end(recorder) }
    if math.is_valid_transform(frame) == false { return }
    w = world_at(id.world0)
    get_joint_sim(w, get_joint_full_id(w, id)).local_frame_b = frame
}
joint_get_local_frame_b(id: JointId) -> Transform {
    w = world_at(id.world0)
    return get_joint_sim(w, get_joint_full_id(w, id)).local_frame_b
}
joint_set_user_data(id: JointId, data: ptr) { get_joint_full_id(world_at(id.world0), id).user_data = data }
joint_get_user_data(id: JointId) -> ptr { return get_joint_full_id(world_at(id.world0), id).user_data }
joint_get_collide_connected(id: JointId) -> bool { return get_joint_full_id(world_at(id.world0), id).collide_connected }
joint_is_awake(id: JointId) -> bool { return get_joint_full_id(world_at(id.world0), id).set_index == AWAKE_SET }

joint_set_constraint_tuning(id: JointId, hertz: float, damping_ratio: float) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_JOINT_SET_CONSTRAINT_TUNING); rec_id(recorder, id.index1, id.generation); rec_float(recorder, hertz); rec_float(recorder, damping_ratio); rec_end(recorder) }
    if valid_spring(hertz, damping_ratio) == false { return }
    w = world_at(id.world0)
    sim = get_joint_sim(w, get_joint_full_id(w, id))
    sim.constraint_hertz = hertz
    sim.constraint_damping_ratio = damping_ratio
}
// The joint's constraint stiffness and damping (b3Joint_GetConstraintTuning).
joint_get_constraint_tuning(id: JointId) -> (float, float) {
    w = world_at(id.world0)
    sim = get_joint_sim(w, get_joint_full_id(w, id))
    return sim.constraint_hertz, sim.constraint_damping_ratio
}
joint_get_constraint_hertz(id: JointId) -> float {
    w = world_at(id.world0)
    return get_joint_sim(w, get_joint_full_id(w, id)).constraint_hertz
}
joint_get_constraint_damping_ratio(id: JointId) -> float {
    w = world_at(id.world0)
    return get_joint_sim(w, get_joint_full_id(w, id)).constraint_damping_ratio
}
joint_set_force_threshold(id: JointId, threshold: float) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_JOINT_SET_FORCE_THRESHOLD); rec_id(recorder, id.index1, id.generation); rec_float(recorder, threshold); rec_end(recorder) }
    if valid_nonnegative(threshold) == false { return }
    w = world_at(id.world0)
    get_joint_sim(w, get_joint_full_id(w, id)).force_threshold = threshold
}
joint_get_force_threshold(id: JointId) -> float {
    w = world_at(id.world0)
    return get_joint_sim(w, get_joint_full_id(w, id)).force_threshold
}
joint_set_torque_threshold(id: JointId, threshold: float) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_JOINT_SET_TORQUE_THRESHOLD); rec_id(recorder, id.index1, id.generation); rec_float(recorder, threshold); rec_end(recorder) }
    if valid_nonnegative(threshold) == false { return }
    w = world_at(id.world0)
    get_joint_sim(w, get_joint_full_id(w, id)).torque_threshold = threshold
}
joint_get_torque_threshold(id: JointId) -> float {
    w = world_at(id.world0)
    return get_joint_sim(w, get_joint_full_id(w, id)).torque_threshold
}

// Whether the attached bodies collide: turning it on asks the broad
// phase for their pairs again (the body with fewer shapes is marked
// moved), turning it off destroys the contacts between them.
joint_set_collide_connected(id: JointId, should_collide: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_JOINT_SET_COLLIDE_CONNECTED); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, should_collide); rec_end(recorder) }
    w = world_at(id.world0)
    if w.locked { return }
    j = get_joint_full_id(w, id)
    if j.collide_connected == should_collide { return }
    j.collide_connected = should_collide
    body_a = body_at(w, j.edge_a.body_id)
    body_b = body_at(w, j.edge_b.body_id)
    if should_collide {
        shape_id = body_b.head_shape_id
        if body_a.shape_count < body_b.shape_count { shape_id = body_a.head_shape_id }
        while shape_id != NULL_INDEX {
            s = world_shape_at(w, shape_id)
            if s.proxy_key != NULL_INDEX { broad_phase.broad_phase_mark_proxy_moved_serial(&w.broad_phase, s.proxy_key) }
            shape_id = s.next_shape_id
        }
    } else {
        destroy_contacts_between_bodies(w, body_a, body_b)
    }
}

joint_wake_bodies(id: JointId) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_JOINT_WAKE_BODIES); rec_id(recorder, id.index1, id.generation); rec_end(recorder) }
    w = world_at(id.world0)
    if w.locked { return }
    w.locked = true
    j = get_joint_full_id(w, id)
    wake_body(w, body_at(w, j.edge_a.body_id))
    wake_body(w, body_at(w, j.edge_b.body_id))
    w.locked = false
}

// The force and torque a joint's impulses amount to over a step (for the joint events).
get_joint_reaction(w: *World, sim: *JointSim, inv_time_step: float) -> JointReaction {
    linear_impulse = 0.0
    angular_impulse = 0.0
    kind = sim.kind
    if kind == JOINT_PARALLEL {
        p = parallel_joint_of(sim)
        angular_impulse = math.length(math.vec3(p.perp_impulse.x, p.perp_impulse.y, 0.0))
    } else if kind == JOINT_DISTANCE {
        d = distance_joint_of(sim)
        linear_impulse = math.abs_float(d.impulse + d.lower_impulse - d.upper_impulse + d.motor_impulse)
    } else if kind == JOINT_MOTOR {
        m = motor_joint_of(sim)
        linear_impulse = math.length(math.add(m.linear_velocity_impulse, m.linear_spring_impulse))
        angular_impulse = math.length(math.add(m.angular_velocity_impulse, m.angular_spring_impulse))
    } else if kind == JOINT_PRISMATIC {
        pr = prismatic_joint_of(sim)
        // Every impulse the warm start applies, the spring's among them.
        linear_impulse = math.length(math.vec3(pr.spring_impulse + pr.motor_impulse + pr.lower_impulse - pr.upper_impulse, pr.perp_impulse.x, pr.perp_impulse.y))
        angular_impulse = math.length(pr.angular_impulse)
    } else if kind == JOINT_REVOLUTE {
        r = revolute_joint_of(sim)
        linear_impulse = math.length(r.linear_impulse)
        angular_impulse = math.length(math.vec3(r.perp_impulse.x, r.perp_impulse.y, r.spring_impulse + r.motor_impulse + r.lower_impulse - r.upper_impulse))
    } else if kind == JOINT_SPHERICAL {
        // As the warm start applies it: the cone limit along -swing_axis,
        // the twist limits along the twist's Jacobian.
        s = spherical_joint_of(sim)
        linear_impulse = math.length(s.linear_impulse)
        impulse = math.add(s.spring_impulse, s.motor_impulse)
        impulse = math.mul_sub(impulse, s.swing_impulse, s.swing_axis)
        impulse = math.mul_add(impulse, s.lower_twist_impulse - s.upper_twist_impulse, s.twist_jacobian)
        angular_impulse = math.length(impulse)
    } else if kind == JOINT_WELD {
        weld = weld_joint_of(sim)
        linear_impulse = math.length(weld.linear_impulse)
        angular_impulse = math.length(weld.angular_impulse)
    } else if kind == JOINT_WHEEL {
        wheel = wheel_joint_of(sim)
        axial = wheel.suspension_spring_impulse + wheel.lower_suspension_impulse - wheel.upper_suspension_impulse
        linear_impulse = sqrt(wheel.linear_impulse.x * wheel.linear_impulse.x + wheel.linear_impulse.y * wheel.linear_impulse.y + axial * axial)
        // The spin with the lock (unsteered) or the steering, on their
        // (orthogonal at rest) axes; the spin alone missed a wheel wrenched sideways.
        lock_x = wheel.angular_impulse.x
        lock_y = wheel.angular_impulse.y
        if wheel.enable_steering { lock_y = wheel.steering_spring_impulse + wheel.lower_steering_impulse - wheel.upper_steering_impulse }
        angular_impulse = sqrt(lock_x * lock_x + lock_y * lock_y + wheel.spin_impulse * wheel.spin_impulse)
    }
    return JointReaction { force: linear_impulse * inv_time_step, torque: angular_impulse * inv_time_step }
}

// How far the joint's frames are from where the constraint wants them,
// as a distance.
joint_get_linear_separation(id: JointId) -> float {
    w = world_at(id.world0)
    j = get_joint_full_id(w, id)
    base = get_joint_sim(w, j)
    xf_a = get_body_transform(w, j.edge_a.body_id)
    xf_b = get_body_transform(w, j.edge_b.body_id)
    p_a = math.transform_point(xf_a, base.local_frame_a.p)
    p_b = math.transform_point(xf_b, base.local_frame_b.p)
    dp = math.sub(p_b, p_a)
    kind = j.kind
    if kind == JOINT_DISTANCE {
        d = distance_joint_of(base)
        len = math.length(dp)
        if d.enable_spring {
            if d.enable_limit {
                if len < d.min_length { return d.min_length - len }
                if len > d.max_length { return len - d.max_length }
            }
            return 0.0
        }
        return math.abs_float(len - d.length)
    }
    if kind == JOINT_PRISMATIC {
        pr = prismatic_joint_of(base)
        return line_separation(dp, slide_axis(xf_a, base), pr.enable_limit, pr.lower_translation, pr.upper_translation)
    }
    if kind == JOINT_REVOLUTE || kind == JOINT_SPHERICAL { return math.length(dp) }
    if kind == JOINT_WELD {
        if weld_joint_of(base).linear_hertz == 0.0 { return math.length(dp) }
        return 0.0
    }
    if kind == JOINT_WHEEL {
        wheel = wheel_joint_of(base)
        return line_separation(dp, slide_axis(xf_a, base), wheel.enable_suspension_limit, wheel.lower_suspension_limit, wheel.upper_suspension_limit)
    }
    return 0.0
}

// The line a prismatic joint slides along and a wheel's suspension runs
// along: frame A's x in the world, as the solver takes it.
slide_axis(xf_a: Transform, base: *JointSim) -> Vec3 {
    return math.rotate_vector(math.mul_quat(xf_a.q, base.local_frame_a.q), math.vec3_axis_x())
}

// How far the anchors are off their line: everything of `dp` across the
// axis (both directions of the plane, in 3D) with what lies past a limit
// along it.
line_separation(dp: Vec3, axis: Vec3, enable_limit: bool, lower: float, upper: float) -> float {
    translation = math.dot(axis, dp)
    across = math.length_squared(math.mul_sub(dp, translation, axis))
    limit = 0.0
    if enable_limit {
        if translation < lower { limit = lower - translation }
        if upper < translation { limit = translation - upper }
    }
    return sqrt(across + limit * limit)
}

// The same as an angle (the wheel joint's is a todo in the reference: zero
// here), read between the joint's frames -- where its limits are -- not
// between its bodies, whose rotations differ by the frames' turn: a weld
// holding two turned bodies, or a ragdoll's joint at rest, reads nothing.
joint_get_angular_separation(id: JointId) -> float {
    w = world_at(id.world0)
    j = get_joint_full_id(w, id)
    base = get_joint_sim(w, j)
    xf_a = get_body_transform(w, j.edge_a.body_id)
    xf_b = get_body_transform(w, j.edge_b.body_id)
    q_a = math.mul_quat(xf_a.q, base.local_frame_a.q)
    q_b = math.mul_quat(xf_b.q, base.local_frame_b.q)
    if math.dot_quat(q_a, q_b) < 0.0 { q_b = math.negate_quat(q_b) }
    rel_q = math.inv_mul_quat(q_a, q_b)
    kind = j.kind
    // A turn about the frames' z that the joint leaves free is not error:
    // the error is the swing, the angle between the frames' z axes. (The
    // reference zeroes the relative rotation's z and takes the angle of
    // what is left; after half a turn about z what is left is near zero
    // all round and its angle reads up to pi -- a free hinge that had swung
    // round read as torn.)
    if kind == JOINT_PARALLEL { return math.get_swing_angle(rel_q) }
    if kind == JOINT_PRISMATIC { return math.get_quat_angle(rel_q) }
    if kind == JOINT_REVOLUTE {
        r = revolute_joint_of(base)
        error = math.get_swing_angle(rel_q)
        if r.enable_limit {
            // Past a limit, the excess of the hinge's angle adds.
            angle = math.get_twist_angle(rel_q)
            if angle < r.lower_angle { error = error + (r.lower_angle - angle) }
            if r.upper_angle < angle { error = error + (angle - r.upper_angle) }
        }
        return error
    }
    if kind == JOINT_SPHERICAL {
        s = spherical_joint_of(base)
        sum = 0.0
        if s.enable_cone_limit {
            swing = spherical_swing_angle(s, rel_q)
            sum = sum + math.max_float(0.0, swing - s.cone_angle)
        }
        if s.enable_twist_limit {
            twist = math.get_twist_angle(rel_q)
            sum = sum + math.max_float(0.0, s.lower_twist_angle - twist)
            sum = sum + math.max_float(0.0, twist - s.upper_twist_angle)
        }
        return sum
    }
    if kind == JOINT_WELD {
        if weld_joint_of(base).angular_hertz == 0.0 { return math.get_quat_angle(rel_q) }
        return 0.0
    }
    if kind == JOINT_WHEEL { return wheel_angular_separation(wheel_joint_of(base), q_a, q_b, rel_q) }
    return 0.0
}

// A wheel's angular separation (a todo in the reference, which reads 0).
// Unsteered, B turns only about its own z (the spin): the rest of the
// frames' relative rotation is the error, as a hinge's is. Steered, it
// also turns about A's x (the steering), so what is locked is B's spin
// axis leaning toward A's x; past a steering limit, the excess adds.
wheel_angular_separation(wheel: *WheelJoint, q_a: Quat, q_b: Quat, rel_q: Quat) -> float {
    if wheel.enable_steering == false { return math.get_swing_angle(rel_q) }
    matrix_a = math.make_matrix_from_quat(q_a)
    matrix_b = math.make_matrix_from_quat(q_b)
    toward = math.clamp_float(math.abs_float(math.dot(matrix_b.cz, matrix_a.cx)), 0.0, 1.0)
    lean = math.atan2_approx(toward, sqrt(1.0 - toward * toward))
    excess = 0.0
    if wheel.enable_steering_limit {
        angle = math.atan2_approx(0.0 - math.dot(matrix_b.cz, matrix_a.cy), math.dot(matrix_b.cz, matrix_a.cz))
        if angle < wheel.lower_steering_limit { excess = wheel.lower_steering_limit - angle }
        if wheel.upper_steering_limit < angle { excess = angle - wheel.upper_steering_limit }
    }
    return lean + excess
}

// Whether two bodies may collide: one must be dynamic and no joint
// between them may forbid it (the shorter joint list is walked).
should_bodies_collide(w: *World, body_a: *Body, body_b: *Body) -> bool {
    if body_a.kind != BODY_DYNAMIC && body_b.kind != BODY_DYNAMIC { return false }
    key = body_b.head_joint_key
    other_id = body_a.id
    if body_a.joint_count < body_b.joint_count {
        key = body_a.head_joint_key
        other_id = body_b.id
    }
    while key != NULL_INDEX {
        j = joint_at(w, key >> 1)
        edge_index = key & 1
        other = j.edge_b.body_id
        if edge_index == 1 { other = j.edge_a.body_id }
        if j.collide_connected == false && other == other_id { return false }
        key = joint_edge_next(w, key)
    }
    return true
}

world_set_custom_filter(w: *World, filter: fn(ShapeId, ShapeId, ptr) -> bool, context: ptr) {
    w.custom_filter = filter
    w.custom_filter_context = context
    w.has_custom_filter = true
}

world_clear_custom_filter(w: *World) { w.has_custom_filter = false }

// --- transfers between sets --------------------------------------------------------------------------------

// A body's sim from one set to another (its transient flags cleared),
// its state dropped or made fresh; the body's indices follow.
transfer_body(w: *World, target: *SolverSet, source: *SolverSet, body: *Body) {
    if target.set_index == source.set_index { return }
    source_index = body.local_index
    target_index = basics.buffer_push(&target.body_sims)
    memcpy(target.body_sims.data + target_index * sizeof(BodySim), body_sim_at(source, source_index) as ptr, sizeof(BodySim))
    target_sim = body_sim_at(target, target_index)
    target_sim.flags = target_sim.flags & (0 - 1 - (IS_FAST | IS_SPEED_CAPPED | HAD_TIME_OF_IMPACT))
    moved = basics.buffer_remove_swap(&source.body_sims, source_index)
    if moved != NULL_INDEX && moved != source_index {
        moved_body = body_at(w, body_sim_at(source, source_index).body_id)
        moved_body.local_index = source_index
        refresh_body_contact_indices(w, moved_body)
    }
    if source.set_index == AWAKE_SET {
        basics.buffer_remove_swap(&source.body_states, source_index)
    } else if target.set_index == AWAKE_SET {
        state_index = basics.buffer_push(&target.body_states)
        state = body_state_at(target, state_index)
        state.v = math.narrow3(math.vec3_zero())
        state.w = math.narrow3(math.vec3_zero())
        state.dp = math.narrow3(math.vec3_zero())
        state.dq = math.narrow_quat(math.quat_identity())
        state.flags = body.flags
    }
    body.set_index = target.set_index
    body.local_index = target_index
}

// A joint's sim from one set to another: out of a colour when leaving
// the awake set, into one when entering it.
transfer_joint(w: *World, target: *SolverSet, source: *SolverSet, j: *Joint) {
    if target.set_index == source.set_index { return }
    local_index = j.local_index
    color_index = j.color_index
    source_sim = null as *JointSim
    if source.set_index == AWAKE_SET {
        source_sim = joint_sim_at(&graph_color(w, color_index).joint_sims, local_index)
    } else {
        source_sim = joint_sim_at(&source.joint_sims, local_index)
    }
    if target.set_index == AWAKE_SET {
        add_joint_to_graph(w, source_sim, j)
        j.set_index = AWAKE_SET
    } else {
        j.set_index = target.set_index
        j.local_index = target.joint_sims.count
        j.color_index = NULL_INDEX
        target_index = basics.buffer_push(&target.joint_sims)
        memcpy(target.joint_sims.data + target_index * sizeof(JointSim), source_sim as ptr, sizeof(JointSim))
    }
    if source.set_index == AWAKE_SET {
        remove_joint_from_graph(w, j.edge_a.body_id, j.edge_b.body_id, color_index, local_index)
    } else {
        moved = basics.buffer_remove_swap(&source.joint_sims, local_index)
        if moved != NULL_INDEX && moved != local_index {
            joint_at(w, joint_sim_at(&source.joint_sims, local_index).joint_id).local_index = local_index
        }
    }
}

// Two sleeping sets into one (the smaller moves): bodies, contacts,
// joints and islands; the emptied set destroyed.
merge_solver_sets(w: *World, set_id1: int, set_id2: int) {
    id1 = set_id1
    id2 = set_id2
    if solver_set_at(w, id1).body_sims.count < solver_set_at(w, id2).body_sims.count {
        id1 = set_id2
        id2 = set_id1
    }
    set1 = solver_set_at(w, id1)
    set2 = solver_set_at(w, id2)
    i = 0
    while i < set2.body_sims.count {
        src = body_sim_at(set2, i)
        body = body_at(w, src.body_id)
        body.set_index = id1
        body.local_index = set1.body_sims.count
        index = basics.buffer_push(&set1.body_sims)
        memcpy(set1.body_sims.data + index * sizeof(BodySim), src as ptr, sizeof(BodySim))
        i = i + 1
    }
    i = 0
    while i < set2.contact_indices.count {
        contact_index = basics.ints_get(&set2.contact_indices, i)
        c = contact_at(w, contact_index)
        c.set_index = id1
        c.local_index = set1.contact_indices.count
        basics.ints_push(&set1.contact_indices, contact_index)
        i = i + 1
    }
    i = 0
    while i < set2.joint_sims.count {
        jsrc = joint_sim_at(&set2.joint_sims, i)
        j = joint_at(w, jsrc.joint_id)
        j.set_index = id1
        j.local_index = set1.joint_sims.count
        jindex = basics.buffer_push(&set1.joint_sims)
        memcpy(set1.joint_sims.data + jindex * sizeof(JointSim), jsrc as ptr, sizeof(JointSim))
        i = i + 1
    }
    i = 0
    while i < set2.island_sims.count {
        island_id = island_sim_at(set2, i).island_id
        island = island_at(w, island_id)
        island.set_index = id1
        island.local_index = set1.island_sims.count
        iindex = basics.buffer_push(&set1.island_sims)
        island_sim_at(set1, iindex).island_id = island_id
        i = i + 1
    }
    destroy_solver_set(w, id2)
}

// --- a body's type and enabling -------------------------------------------------------------------------------

// The body's type changed (b3Body_SetType): its contacts destroyed, its
// set woken, its joints parked in the static set while the body moves
// to the static or awake set and its island is made or dropped, the
// joints back where a dynamic body puts them, the proxies remade in the
// right tree, the joints relinked. Refused for compound and height
// field shapes on a body that would move.
body_set_type(id: BodyId, kind: int) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_SET_TYPE); rec_id(recorder, id.index1, id.generation); rec_int(recorder, kind); rec_end(recorder) }
    if body_is_valid(id) == false { return }
    w = world_at(id.world0)
    if w.locked { return }
    body = body_at(w, id.index1 - 1)
    original = body.kind
    if original == kind { return }
    if kind != BODY_STATIC {
        shape_id = body.head_shape_id
        while shape_id != NULL_INDEX {
            s = world_shape_at(w, shape_id)
            if s.geometry.kind == KIND_COMPOUND || s.geometry.kind == KIND_HEIGHT_FIELD { return }
            shape_id = s.next_shape_id
        }
    }
    w.locked = true
    if body.set_index == DISABLED_SET {
        body.kind = kind
        if kind == BODY_DYNAMIC { body.flags = body.flags | DYNAMIC_FLAG } else { body.flags = body.flags & (0 - 1 - DYNAMIC_FLAG) }
        sync_body_flags(w, body)
        update_body_mass_data(w, body)
        w.locked = false
        return
    }
    destroy_body_contacts(w, body, false)
    wake_body(w, body)
    static_set = solver_set_at(w, STATIC_SET)
    key = body.head_joint_key
    while key != NULL_INDEX {
        j = joint_at(w, key >> 1)
        key = joint_edge_next(w, key)
        if j.set_index == DISABLED_SET { continue }
        // The attached bodies wake (a static body's wake above wakes no one).
        wake_body(w, body_at(w, j.edge_a.body_id))
        wake_body(w, body_at(w, j.edge_b.body_id))
        unlink_joint(w, j)
        transfer_joint(w, static_set, solver_set_at(w, j.set_index), j)
    }
    body.kind = kind
    if kind == BODY_DYNAMIC { body.flags = body.flags | DYNAMIC_FLAG } else { body.flags = body.flags & (0 - 1 - DYNAMIC_FLAG) }
    awake_set = solver_set_at(w, AWAKE_SET)
    target_set = awake_set
    if kind == BODY_STATIC { target_set = static_set }
    transfer_body(w, target_set, solver_set_at(w, body.set_index), body)
    if original == BODY_STATIC {
        create_island_for_body(w, AWAKE_SET, body)
    } else if kind == BODY_STATIC {
        remove_body_from_island(w, body)
    }
    key = body.head_joint_key
    while key != NULL_INDEX {
        j = joint_at(w, key >> 1)
        key = joint_edge_next(w, key)
        if j.set_index == DISABLED_SET { continue }
        if body_at(w, j.edge_a.body_id).kind == BODY_DYNAMIC || body_at(w, j.edge_b.body_id).kind == BODY_DYNAMIC {
            transfer_joint(w, awake_set, static_set, j)
        }
    }
    t = get_body_sim(w, body).transform
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        shape_id = s.next_shape_id
        if s.proxy_key != NULL_INDEX { broad_phase.broad_phase_destroy_proxy(&w.broad_phase, s.proxy_key) }
        create_shape_proxy(w, s, kind, t, true)
    }
    key = body.head_joint_key
    while key != NULL_INDEX {
        j = joint_at(w, key >> 1)
        edge_index = key & 1
        key = joint_edge_next(w, key)
        other_id = j.edge_b.body_id
        if edge_index == 1 { other_id = j.edge_a.body_id }
        other = body_at(w, other_id)
        if other.set_index == DISABLED_SET { continue }
        if body.kind != BODY_DYNAMIC && other.kind != BODY_DYNAMIC { continue }
        link_joint(w, j)
    }
    sync_body_flags(w, body)
    update_body_mass_data(w, body)
    w.locked = false
}

// The body out of the simulation: its contacts destroyed (the touching
// bodies woken), its joints unlinked and parked in the disabled set with
// it, its proxies removed, its island left.
body_disable(id: BodyId) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_DISABLE); rec_id(recorder, id.index1, id.generation); rec_end(recorder) }
    if body_is_valid(id) == false { return }
    w = world_at(id.world0)
    if w.locked { return }
    body = body_at(w, id.index1 - 1)
    if body.set_index == DISABLED_SET { return }
    w.locked = true
    destroy_body_contacts(w, body, true)
    set = solver_set_at(w, body.set_index)
    disabled = solver_set_at(w, DISABLED_SET)
    key = body.head_joint_key
    while key != NULL_INDEX {
        j = joint_at(w, key >> 1)
        key = joint_edge_next(w, key)
        if j.set_index == DISABLED_SET { continue }
        unlink_joint(w, j)
        transfer_joint(w, disabled, solver_set_at(w, j.set_index), j)
    }
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        shape_id = s.next_shape_id
        if s.proxy_key != NULL_INDEX {
            broad_phase.broad_phase_destroy_proxy(&w.broad_phase, s.proxy_key)
            s.proxy_key = NULL_INDEX
        }
    }
    remove_body_from_island(w, body)
    source_index = body.set_index
    transfer_body(w, disabled, set, body)
    // A sleeping set left empty (its last body disabled, its island gone
    // with it) is nothing anyone will wake: destroyed, not leaked.
    if source_index >= FIRST_SLEEPING_SET && set.body_sims.count == 0 && set.island_sims.count == 0 && set.joint_sims.count == 0 && set.contact_indices.count == 0 {
        destroy_solver_set(w, source_index)
    }
    w.locked = false
}

// The body back: into the static or awake set, its proxies remade, an
// island of its own, its joints whose other body is enabled into the
// right set and linked (a sleeping other body wakes through the link).
body_enable(id: BodyId) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_ENABLE); rec_id(recorder, id.index1, id.generation); rec_end(recorder) }
    if body_is_valid(id) == false { return }
    w = world_at(id.world0)
    if w.locked { return }
    body = body_at(w, id.index1 - 1)
    if body.set_index != DISABLED_SET { return }
    disabled = solver_set_at(w, DISABLED_SET)
    set_id = AWAKE_SET
    if body.kind == BODY_STATIC { set_id = STATIC_SET }
    transfer_body(w, solver_set_at(w, set_id), disabled, body)
    t = get_body_sim(w, body).transform
    shape_id = body.head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        shape_id = s.next_shape_id
        create_shape_proxy(w, s, body.kind, t, true)
    }
    if set_id != STATIC_SET { create_island_for_body(w, set_id, body) }
    key = body.head_joint_key
    while key != NULL_INDEX {
        j = joint_at(w, key >> 1)
        key = joint_edge_next(w, key)
        body_a = body_at(w, j.edge_a.body_id)
        body_b = body_at(w, j.edge_b.body_id)
        if body_a.set_index == DISABLED_SET || body_b.set_index == DISABLED_SET { continue }
        // A joint with no dynamic body is static, as create_joint makes it:
        // a kinematic body is in the awake set but never solved against.
        joint_set_id = body_a.set_index
        if body_a.kind != BODY_DYNAMIC && body_b.kind != BODY_DYNAMIC { joint_set_id = STATIC_SET }
        else if body_a.set_index == STATIC_SET { joint_set_id = body_b.set_index }
        transfer_joint(w, solver_set_at(w, joint_set_id), disabled, j)
        if joint_set_id != STATIC_SET { link_joint(w, j) }
    }
}

body_get_joint_count(id: BodyId) -> int { return get_body_full_id(world_at(id.world0), id).joint_count }
body_get_contact_capacity(id: BodyId) -> int {
    w = world_at(id.world0)
    return get_body_full_id(w, id).contact_count
}

// The touching contacts on a body (b3Body_GetContactData): their ids,
// the shapes, and the manifolds to read points and impulses from.
struct ContactData {
    contact_id: ContactId
    shape_id_a: ShapeId
    shape_id_b: ShapeId
    manifolds: ptr                 // Manifold[manifold_count], the contact's own
    manifold_count: int
}

body_get_contact_data(id: BodyId, data: ContactData[], capacity: int) -> int {
    w = world_at(id.world0)
    if w.locked { return 0 }
    body = get_body_full_id(w, id)
    key = body.head_contact_key
    count = 0
    while key != NULL_INDEX && count < capacity {
        c = contact_at(w, key >> 1)
        if (c.flags & CONTACT_TOUCHING) != 0 {
            data[count] = ContactData { contact_id: make_contact_id(w, c), shape_id_a: make_shape_id(w, world_shape_at(w, c.shape_id_a)),
                                        shape_id_b: make_shape_id(w, world_shape_at(w, c.shape_id_b)), manifolds: c.manifolds, manifold_count: c.manifold_count }
            count = count + 1
        }
        key = contact_edge_next(w, key)
    }
    return count
}

// The joints on a body, by id.
body_get_joints(id: BodyId, joints: JointId[], capacity: int) -> int {
    w = world_at(id.world0)
    body = get_body_full_id(w, id)
    key = body.head_joint_key
    count = 0
    while key != NULL_INDEX && count < capacity {
        j = joint_at(w, key >> 1)
        joints[count] = make_joint_id(w, j)
        count = count + 1
        key = joint_edge_next(w, key)
    }
    return count
}

world_joint_count(w: *World) -> int { return basics.idpool_count(&w.joint_id_pool) }

// --- sensors -------------------------------------------------------------------------------------------------

// A sensor's visitor, as one key: the shape id above its generation.
visitor_key(shape_id: int, generation: int) -> long { return ((shape_id as long) << 32) | (generation as long) }
visitor_shape_id(key: long) -> int { return (key >> 32) as int }
visitor_generation(key: long) -> int { return key as int }

sensor_at(w: *World, index: int) -> *Sensor { return (w.sensors.data + index * sizeof(Sensor)) as *Sensor }
sensor_end_events(w: *World) -> *Buffer {
    if w.end_event_index == 0 { return &w.sensor_end_events0 }
    return &w.sensor_end_events1
}
world_sensor_count(w: *World) -> int { return w.sensors.count }
world_sensor_begin_event_count(w: *World) -> int { return w.sensor_begin_events.count }
world_sensor_begin_event(w: *World, index: int) -> SensorBeginTouchEvent {
    events = w.sensor_begin_events.data as SensorBeginTouchEvent[]
    return events[index]
}
world_sensor_end_event_count(w: *World) -> int { return sensor_end_events(w).count }
world_sensor_end_event(w: *World, index: int) -> SensorEndTouchEvent {
    events = sensor_end_events(w).data as SensorEndTouchEvent[]
    return events[index]
}

push_sensor_begin_event(w: *World, sensor_id: ShapeId, visitor: long) {
    index = basics.buffer_push(&w.sensor_begin_events)
    events = w.sensor_begin_events.data as SensorBeginTouchEvent[]
    events[index] = SensorBeginTouchEvent { sensor_shape_id: sensor_id,
                                            visitor_shape_id: ShapeId { index1: visitor_shape_id(visitor) + 1, world0: w.world_id, generation: visitor_generation(visitor) } }
}

push_sensor_end_event(w: *World, sensor_id: ShapeId, visitor: long) {
    b = sensor_end_events(w)
    index = basics.buffer_push(b)
    events = b.data as SensorEndTouchEvent[]
    events[index] = SensorEndTouchEvent { sensor_shape_id: sensor_id,
                                          visitor_shape_id: ShapeId { index1: visitor_shape_id(visitor) + 1, world0: w.world_id, generation: visitor_generation(visitor) } }
}

// A sensor for a shape: its overlap lists, its place among the world's.
create_sensor(w: *World, s: *WorldShape) {
    s.sensor_index = w.sensors.count
    index = basics.buffer_push(&w.sensors)
    sensor = sensor_at(w, index)
    sensor.hits = basics.buffer_create(8, 4)
    sensor.overlaps1 = basics.buffer_create(8, 16)
    sensor.overlaps2 = basics.buffer_create(8, 16)
    sensor.shape_id = s.id
}

// The sensor's overlaps end, its lists go, the last sensor takes its slot.
destroy_sensor(w: *World, s: *WorldShape) {
    sensor = sensor_at(w, s.sensor_index)
    sensor_id = make_shape_id(w, s)
    overlaps = sensor.overlaps2.data as long[]
    i = 0
    while i < sensor.overlaps2.count {
        push_sensor_end_event(w, sensor_id, overlaps[i])
        i = i + 1
    }
    basics.buffer_destroy(&sensor.hits)
    basics.buffer_destroy(&sensor.overlaps1)
    basics.buffer_destroy(&sensor.overlaps2)
    moved = basics.buffer_remove_swap(&w.sensors, s.sensor_index)
    if moved != NULL_INDEX && moved != s.sensor_index {
        world_shape_at(w, sensor_at(w, s.sensor_index).shape_id).sensor_index = s.sensor_index
    }
    s.sensor_index = NULL_INDEX
}

shape_enable_sensor_events(id: ShapeId, flag: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_ENABLE_SENSOR_EVENTS); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, flag); rec_end(recorder) }
    s = get_shape_full_id(world_at(id.world0), id)
    if flag { s.flags = s.flags | SHAPE_ENABLE_SENSOR_EVENTS } else { s.flags = s.flags & (0 - 1 - SHAPE_ENABLE_SENSOR_EVENTS) }
}
shape_are_sensor_events_enabled(id: ShapeId) -> bool { return (get_shape_full_id(world_at(id.world0), id).flags & SHAPE_ENABLE_SENSOR_EVENTS) != 0 }

// Contact and hit events on a shape after its creation (b3Shape_EnableContactEvents, b3Shape_EnableHitEvents).
shape_enable_contact_events(id: ShapeId, flag: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_ENABLE_CONTACT_EVENTS); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, flag); rec_end(recorder) }
    s = get_shape_full_id(world_at(id.world0), id)
    if flag { s.flags = s.flags | SHAPE_ENABLE_CONTACT_EVENTS } else { s.flags = s.flags & (0 - 1 - SHAPE_ENABLE_CONTACT_EVENTS) }
}
shape_are_contact_events_enabled(id: ShapeId) -> bool { return (get_shape_full_id(world_at(id.world0), id).flags & SHAPE_ENABLE_CONTACT_EVENTS) != 0 }
// Hit events on every shape of a body (b3Body_EnableHitEvents).
body_enable_hit_events(id: BodyId, flag: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_BODY_ENABLE_HIT_EVENTS); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, flag); rec_end(recorder) }
    w = world_at(id.world0)
    shape_id = get_body_full_id(w, id).head_shape_id
    while shape_id != NULL_INDEX {
        s = world_shape_at(w, shape_id)
        if flag { s.flags = s.flags | SHAPE_ENABLE_HIT_EVENTS } else { s.flags = s.flags & (0 - 1 - SHAPE_ENABLE_HIT_EVENTS) }
        shape_id = s.next_shape_id
    }
}
shape_enable_hit_events(id: ShapeId, flag: bool) {
    if recording_on(id.world0) { recorder = rec_begin(id.world0, OP_SHAPE_ENABLE_HIT_EVENTS); rec_id(recorder, id.index1, id.generation); rec_bool(recorder, flag); rec_end(recorder) }
    s = get_shape_full_id(world_at(id.world0), id)
    if flag { s.flags = s.flags | SHAPE_ENABLE_HIT_EVENTS } else { s.flags = s.flags & (0 - 1 - SHAPE_ENABLE_HIT_EVENTS) }
}
shape_are_hit_events_enabled(id: ShapeId) -> bool { return (get_shape_full_id(world_at(id.world0), id).flags & SHAPE_ENABLE_HIT_EVENTS) != 0 }

// The shapes a sensor overlaps, as of the last pass.
shape_get_sensor_capacity(id: ShapeId) -> int {
    w = world_at(id.world0)
    s = get_shape_full_id(w, id)
    if s.sensor_index == NULL_INDEX { return 0 }
    return sensor_at(w, s.sensor_index).overlaps2.count
}

shape_get_sensor_data(id: ShapeId, visitors: ShapeId[], capacity: int) -> int {
    w = world_at(id.world0)
    s = get_shape_full_id(w, id)
    if s.sensor_index == NULL_INDEX { return 0 }
    sensor = sensor_at(w, s.sensor_index)
    count = math.min_int(sensor.overlaps2.count, capacity)
    overlaps = sensor.overlaps2.data as long[]
    i = 0
    while i < count {
        visitors[i] = ShapeId { index1: visitor_shape_id(overlaps[i]) + 1, world0: w.world_id, generation: visitor_generation(overlaps[i]) }
        i = i + 1
    }
    return count
}

shape_get_contact_capacity(id: ShapeId) -> int {
    w = world_at(id.world0)
    s = get_shape_full_id(w, id)
    if s.sensor_index != NULL_INDEX { return 0 }
    return body_at(w, s.body_id).contact_count
}

// The touching contacts of one shape (b3Shape_GetContactData): its body's,
// those that involve it; none for a sensor.
shape_get_contact_data(id: ShapeId, data: ContactData[], capacity: int) -> int {
    w = world_at(id.world0)
    if w.locked { return 0 }
    s = get_shape_full_id(w, id)
    if s.sensor_index != NULL_INDEX { return 0 }
    key = body_at(w, s.body_id).head_contact_key
    count = 0
    while key != NULL_INDEX && count < capacity {
        c = contact_at(w, key >> 1)
        if (c.shape_id_a == s.id || c.shape_id_b == s.id) && (c.flags & CONTACT_TOUCHING) != 0 {
            data[count] = ContactData { contact_id: make_contact_id(w, c), shape_id_a: make_shape_id(w, world_shape_at(w, c.shape_id_a)),
                                        shape_id_b: make_shape_id(w, world_shape_at(w, c.shape_id_b)), manifolds: c.manifolds, manifold_count: c.manifold_count }
            count = count + 1
        }
        key = contact_edge_next(w, key)
    }
    return count
}

// A sensor hit found by the continuous pass, kept until the next overlap pass.
add_sensor_hit(w: *World, sensor_shape: *WorldShape, visitor: *WorldShape) {
    sensor = sensor_at(w, sensor_shape.sensor_index)
    index = basics.buffer_push(&sensor.hits)
    hits = sensor.hits.data as long[]
    hits[index] = visitor_key(visitor.id, visitor.generation)
}

struct SensorQueryContext {
    w: *World
    sensor: *Sensor
    sensor_shape: *WorldShape
    transform: Transform
}

var g_sensor_points: ptr = null   // Vec3[MAX_SHAPE_CAST_POINTS]: the visitor in the sensor's frame
sensor_points() -> ptr { return native.scratch(g_sensor_points, distance.MAX_SHAPE_CAST_POINTS * sizeof(Vec3)) }

sensor_scratch_ready() {
    if g_sensor_points == null { g_sensor_points = basics.alloc(native.MAX_WORKERS * (distance.MAX_SHAPE_CAST_POINTS * sizeof(Vec3))) }
}

// Whether a convex visitor overlaps the sensor's shape: the visitor's
// proxy in the sensor's frame against the sensor's geometry.
overlap_sensor(sensor_shape: *WorldShape, sensor_transform: Transform, visitor: *WorldShape, visitor_transform: Transform) -> bool {
    sensor_scratch_ready()
    // A hull visitor against a round sensor: asked the other way round, so
    // the hull's face planes can answer most of it without GJK (overlap is
    // symmetric; both sides test the same slop).
    sensor_kind = sensor_shape.geometry.kind
    if visitor.geometry.kind == KIND_HULL && (sensor_kind == KIND_SPHERE || sensor_kind == KIND_CAPSULE) {
        sensor_proxy = shape.make_shape_proxy(&sensor_shape.geometry)
        to_visitor = math.inv_mul_transforms(visitor_transform, sensor_transform)
        local = sensor_points() as Vec3[]
        sensor_at_points = sensor_proxy.points as Vec3[]
        k = 0
        while k < sensor_proxy.count {
            local[k] = math.transform_point(to_visitor, sensor_at_points[k])
            k = k + 1
        }
        return hull.overlap_hull(visitor.geometry.hull, math.transform_identity(), distance.shape_proxy(sensor_points(), sensor_proxy.count, sensor_proxy.radius))
    }
    proxy = shape.make_shape_proxy(&visitor.geometry)
    relative = math.inv_mul_transforms(sensor_transform, visitor_transform)
    count = math.min_int(proxy.count, distance.MAX_SHAPE_CAST_POINTS)
    points = proxy.points as Vec3[]
    local_points = sensor_points() as Vec3[]
    i = 0
    while i < count {
        local_points[i] = math.transform_point(relative, points[i])
        i = i + 1
    }
    return shape.overlap_shape(&sensor_shape.geometry, math.transform_identity(), distance.shape_proxy(sensor_points(), count, proxy.radius))
}

// A tree's proxy near a sensor: a convex shape on another body that
// wants sensor events, passing the filters, and overlapping.
sensor_query_visitor(proxy_id: int, user_data: long, context: ptr) -> bool {
    qc = context as *SensorQueryContext
    w = qc.w
    shape_id = user_data as int
    sensor_shape = qc.sensor_shape
    if shape_id == sensor_shape.id { return true }
    other = world_shape_at(w, shape_id)
    if shape.is_convex(other.geometry.kind) == false { return true }
    if (other.flags & SHAPE_ENABLE_SENSOR_EVENTS) == 0 { return true }
    if other.body_id == sensor_shape.body_id { return true }
    if shape.should_shapes_collide(sensor_shape.filter, other.filter) == false { return true }
    if w.has_custom_filter && ((sensor_shape.flags & SHAPE_ENABLE_CUSTOM_FILTERING) != 0 || (other.flags & SHAPE_ENABLE_CUSTOM_FILTERING) != 0) {
        filter = w.custom_filter
        if filter(make_shape_id(w, sensor_shape), make_shape_id(w, other), w.custom_filter_context) == false { return true }
    }
    other_transform = get_body_transform(w, other.body_id)
    if overlap_sensor(sensor_shape, qc.transform, other, other_transform) == false { return true }
    sensor = qc.sensor
    index = basics.buffer_push(&sensor.overlaps2)
    overlaps = sensor.overlaps2.data as long[]
    overlaps[index] = visitor_key(shape_id, other.generation)
    return true
}

// The sensors' pass (b3OverlapSensors, one worker): each sensor's last
// overlaps become the previous ones, the hits seed the new ones, the
// three trees are queried, the new list sorted and made unique; where
// the lists differ, begin and end events in shape id order. A disabled
// sensor drops all its overlaps.
overlap_sensors(w: *World) {
    basics.buffer_clear(&w.sensor_begin_events)
    sensor_count = w.sensors.count
    if sensor_count == 0 { return }
    basics.bitset_set_count_and_clear(&w.sensor_event_bits, sensor_count)
    sensor_index = 0
    while sensor_index < sensor_count {
        sensor = sensor_at(w, sensor_index)
        sensor_shape = world_shape_at(w, sensor.shape_id)
        temp = sensor.overlaps1
        sensor.overlaps1 = sensor.overlaps2
        sensor.overlaps2 = temp
        basics.buffer_clear(&sensor.overlaps2)
        hits = sensor.hits.data as long[]
        i = 0
        while i < sensor.hits.count {
            index = basics.buffer_push(&sensor.overlaps2)
            seeded = sensor.overlaps2.data as long[]
            seeded[index] = hits[i]
            i = i + 1
        }
        basics.buffer_clear(&sensor.hits)
        body = body_at(w, sensor_shape.body_id)
        if body.set_index == DISABLED_SET || (sensor_shape.flags & SHAPE_ENABLE_SENSOR_EVENTS) == 0 {
            if sensor.overlaps1.count != 0 { basics.bitset_set(&w.sensor_event_bits, sensor_index) }
            sensor_index = sensor_index + 1
            continue
        }
        qc = SensorQueryContext { w: w, sensor: sensor, sensor_shape: sensor_shape, transform: get_body_sim(w, body).transform }
        bounds = sensor_shape.aabb
        mask = sensor_shape.filter.mask_bits
        dynamic_tree.tree_query(broad_phase.broad_phase_tree(&w.broad_phase, BODY_STATIC), bounds, mask, false, sensor_query_visitor, (&qc) as ptr)
        dynamic_tree.tree_query(broad_phase.broad_phase_tree(&w.broad_phase, BODY_KINEMATIC), bounds, mask, false, sensor_query_visitor, (&qc) as ptr)
        dynamic_tree.tree_query(broad_phase.broad_phase_tree(&w.broad_phase, BODY_DYNAMIC), bounds, mask, false, sensor_query_visitor, (&qc) as ptr)
        overlaps = sensor.overlaps2.data as long[]
        broad_phase.sort_longs(overlaps, sensor.overlaps2.count)
        unique = 0
        i = 0
        while i < sensor.overlaps2.count {
            if unique == 0 || visitor_shape_id(overlaps[i]) != visitor_shape_id(overlaps[unique - 1]) {
                overlaps[unique] = overlaps[i]
                unique = unique + 1
            }
            i = i + 1
        }
        sensor.overlaps2.count = unique
        count1 = sensor.overlaps1.count
        if count1 != unique {
            basics.bitset_set(&w.sensor_event_bits, sensor_index)
        } else {
            previous = sensor.overlaps1.data as long[]
            i = 0
            while i < count1 {
                if previous[i] != overlaps[i] {
                    basics.bitset_set(&w.sensor_event_bits, sensor_index)
                    i = count1
                }
                i = i + 1
            }
        }
        sensor_index = sensor_index + 1
    }
    // The events, in sensor order then shape id order.
    sensor_index = 0
    while sensor_index < sensor_count {
        if basics.bitset_get(&w.sensor_event_bits, sensor_index) {
            sensor = sensor_at(w, sensor_index)
            sensor_shape = world_shape_at(w, sensor.shape_id)
            sensor_id = make_shape_id(w, sensor_shape)
            count1 = sensor.overlaps1.count
            count2 = sensor.overlaps2.count
            refs1 = sensor.overlaps1.data as long[]
            refs2 = sensor.overlaps2.data as long[]
            index1 = 0
            index2 = 0
            while index1 < count1 && index2 < count2 {
                r1 = refs1[index1]
                r2 = refs2[index2]
                if visitor_shape_id(r1) == visitor_shape_id(r2) {
                    if visitor_generation(r1) < visitor_generation(r2) {
                        push_sensor_end_event(w, sensor_id, r1)
                        index1 = index1 + 1
                    } else if visitor_generation(r1) > visitor_generation(r2) {
                        push_sensor_begin_event(w, sensor_id, r2)
                        index2 = index2 + 1
                    } else {
                        index1 = index1 + 1
                        index2 = index2 + 1
                    }
                } else if visitor_shape_id(r1) < visitor_shape_id(r2) {
                    push_sensor_end_event(w, sensor_id, r1)
                    index1 = index1 + 1
                } else {
                    push_sensor_begin_event(w, sensor_id, r2)
                    index2 = index2 + 1
                }
            }
            while index1 < count1 {
                push_sensor_end_event(w, sensor_id, refs1[index1])
                index1 = index1 + 1
            }
            while index2 < count2 {
                push_sensor_begin_event(w, sensor_id, refs2[index2])
                index2 = index2 + 1
            }
        }
        sensor_index = sensor_index + 1
    }
}

// --- the step's events and helpers ---------------------------------------------------------------------------

body_move_event_at(w: *World, index: int) -> *BodyMoveEvent { return (w.body_move_events.data + index * sizeof(BodyMoveEvent)) as *BodyMoveEvent }
task_sensor_hit_at(tc: *TaskContext, index: int) -> *SensorHit { return (tc.sensor_hits.data + index * sizeof(SensorHit)) as *SensorHit }
world_body_move_event_count(w: *World) -> int { return w.body_move_events.count }
world_body_move_event(w: *World, index: int) -> BodyMoveEvent {
    events = w.body_move_events.data as BodyMoveEvent[]
    return events[index]
}
world_contact_hit_event_count(w: *World) -> int { return w.contact_hit_events.count }
world_contact_hit_event(w: *World, index: int) -> ContactHitEvent {
    events = w.contact_hit_events.data as ContactHitEvent[]
    return events[index]
}
world_joint_event_count(w: *World) -> int { return w.joint_events.count }
world_joint_event(w: *World, index: int) -> JointEvent {
    events = w.joint_events.data as JointEvent[]
    return events[index]
}

// The pre-solve callback: a continuous hit it refuses is ignored.
world_set_pre_solve(w: *World, callback_fn: fn(ShapeId, ShapeId, Vec3, Vec3, ptr) -> bool, context: ptr) {
    w.pre_solve = callback_fn
    w.pre_solve_context = context
    w.has_pre_solve = true
}

world_clear_pre_solve(w: *World) { w.has_pre_solve = false }

// The user material id of a hit point on a shape: a mesh's or height
// field's per-triangle material, a compound child's through its map, a
// convex shape's first (b3GetShapeUserMaterialId).
shape_user_material_id(s: *WorldShape, child_index: int, triangle_index: int) -> long {
    if s.material_count == 0 { return 0 as long }
    material_index = 0
    kind = s.geometry.kind
    if kind == KIND_MESH {
        indices = mesh.mesh_material_indices(s.geometry.mesh.data)
        material_index = indices[triangle_index]
    } else if kind == KIND_HEIGHT_FIELD {
        material_index = height_field.get_height_field_material(s.geometry.height_field, triangle_index)
    } else if kind == KIND_COMPOUND {
        child = compound.get_compound_child(s.geometry.compound, child_index)
        if child.kind == KIND_MESH {
            indices = mesh.mesh_material_indices(child.mesh.data)
            material_index = compound.child_material(child, indices[triangle_index])
        } else {
            material_index = child.material_index0
        }
    }
    material_index = math.clamp_int(material_index, 0, s.material_count - 1)
    if s.materials == null { return s.material.user_material_id }
    materials = s.materials as SurfaceMaterial[]
    return materials[material_index].user_material_id
}

// A body's motion over the step relative to a base point (the sweep in
// single precision near the base).
make_relative_sweep(sim: *BodySim, base: Vec3) -> Sweep {
    return Sweep { local_center: math.widen3(sim.local_center), c1: math.sub(sim.center0, base), c2: math.sub(sim.center, base),
                   q1: math.widen_quat(sim.rotation0), q2: sim.transform.q }
}

// --- joint and sensor validation ------------------------------------------------------------------------------

// Every live joint is where its indices say (a colour or a set), in the
// set its bodies' sets and types dictate, in an island iff out of the
// static and disabled sets; the sets' and colours' sims point back; both
// bodies' lists close on their counts; every sensor and its shape agree.
validate_joints(w: *World) -> bool {
    live = 0
    i = 0
    while i < w.joints.count {
        j = joint_at(w, i)
        if j.joint_id != NULL_INDEX {
            live = live + 1
            if j.joint_id != i { return false }
            body_a = body_at(w, j.edge_a.body_id)
            body_b = body_at(w, j.edge_b.body_id)
            if body_a.set_index == DISABLED_SET || body_b.set_index == DISABLED_SET {
                if j.set_index != DISABLED_SET { return false }
            } else if body_a.kind != BODY_DYNAMIC && body_b.kind != BODY_DYNAMIC {
                if j.set_index != STATIC_SET { return false }
            } else if body_a.set_index == AWAKE_SET || body_b.set_index == AWAKE_SET {
                if j.set_index != AWAKE_SET { return false }
            } else {
                if j.set_index != math.max_int(body_a.set_index, body_b.set_index) { return false }
            }
            if j.set_index == AWAKE_SET {
                if j.color_index < 0 || j.color_index >= GRAPH_COLOR_COUNT { return false }
                color = graph_color(w, j.color_index)
                if j.local_index >= color.joint_sims.count || joint_sim_at(&color.joint_sims, j.local_index).joint_id != i { return false }
                if j.color_index != OVERFLOW_INDEX {
                    if body_a.kind == BODY_DYNAMIC && basics.bitset_get(&color.body_set, body_a.id) == false { return false }
                    if body_b.kind == BODY_DYNAMIC && basics.bitset_get(&color.body_set, body_b.id) == false { return false }
                }
            } else {
                if j.color_index != NULL_INDEX { return false }
                set = solver_set_at(w, j.set_index)
                if j.local_index >= set.joint_sims.count || joint_sim_at(&set.joint_sims, j.local_index).joint_id != i { return false }
            }
            sim = get_joint_sim(w, j)
            if sim.body_id_a != j.edge_a.body_id || sim.body_id_b != j.edge_b.body_id || sim.kind != j.kind { return false }
            if j.set_index > DISABLED_SET {
                if j.island_id == NULL_INDEX { return false }
                island = island_at(w, j.island_id)
                if j.island_index >= island.joints.count || joint_link_at(island, j.island_index).joint_id != i { return false }
            } else if j.island_id != NULL_INDEX { return false }
        }
        i = i + 1
    }
    if live != basics.idpool_count(&w.joint_id_pool) { return false }
    // The sets' and colours' sims.
    i = 0
    while i < w.solver_sets.count {
        set = solver_set_at(w, i)
        if set.set_index != NULL_INDEX {
            k = 0
            while k < set.joint_sims.count {
                j = joint_at(w, joint_sim_at(&set.joint_sims, k).joint_id)
                if j.set_index != i || j.local_index != k { return false }
                k = k + 1
            }
        }
        i = i + 1
    }
    i = 0
    while i < GRAPH_COLOR_COUNT {
        color = graph_color(w, i)
        k = 0
        while k < color.joint_sims.count {
            j = joint_at(w, joint_sim_at(&color.joint_sims, k).joint_id)
            if j.set_index != AWAKE_SET || j.color_index != i || j.local_index != k { return false }
            k = k + 1
        }
        i = i + 1
    }
    // The bodies' lists.
    i = 0
    while i < w.bodies.count {
        body = body_at(w, i)
        if body.set_index != NULL_INDEX {
            count = 0
            key = body.head_joint_key
            prev = NULL_INDEX
            while key != NULL_INDEX {
                j = joint_at(w, key >> 1)
                edge_body = j.edge_b.body_id
                if (key & 1) == 0 { edge_body = j.edge_a.body_id }
                if edge_body != i || joint_edge_prev(w, key) != prev { return false }
                count = count + 1
                prev = key
                key = joint_edge_next(w, key)
            }
            if count != body.joint_count { return false }
        }
        i = i + 1
    }
    // The sensors.
    i = 0
    while i < w.sensors.count {
        sensor = sensor_at(w, i)
        s = world_shape_at(w, sensor.shape_id)
        if s.id != sensor.shape_id || s.sensor_index != i { return false }
        i = i + 1
    }
    i = 0
    while i < w.shapes.count {
        s = world_shape_at(w, i)
        if s.id != NULL_INDEX && s.sensor_index != NULL_INDEX {
            if s.sensor_index >= w.sensors.count || sensor_at(w, s.sensor_index).shape_id != i { return false }
        }
        i = i + 1
    }
    return true
}
