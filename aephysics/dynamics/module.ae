    Manifold, ManifoldPoint, ContactSpec, ContactId, ContactBeginTouchEvent, ContactEndTouchEvent, JointSim, GraphColor, ConstraintGraph,
    GRAPH_COLOR_COUNT, OVERFLOW_INDEX, DYNAMIC_COLOR_COUNT, MAX_MANIFOLD_POINTS,
    CONTACT_TOUCHING, CONTACT_ENABLE_CONTACT_EVENTS, CONTACT_STATIC, CONTACT_RECYCLE, SIM_TOUCHING, SIM_MESH_CONTACT,
    SIM_ENABLE_HIT_EVENT, RELATIVE_TRANSFORM_VALID, ENABLE_SPECULATIVE_POINTS,
    contact_at, joint_at, manifold_at, manifold_point_at, graph_color, contact_spec_at, joint_sim_at, contact_link_at, joint_link_at,
    world_contact_count, get_contact, contact_is_valid, make_contact_id, make_shape_id,
    world_contact_begin_event_count, world_contact_begin_event, world_contact_end_event_count, world_contact_end_event, swap_end_events,
    create_graph, destroy_graph, add_contact_to_graph, remove_contact_from_graph, add_joint_to_graph, remove_joint_from_graph,
    create_contact, destroy_contact, update_contact, contact_edge_next, invalidate_body_contacts,
    merge_islands, link_contact, unlink_contact, link_joint, unlink_joint, split_island, try_sleep_island,
    update_pairs, collide, validate_contacts,
    Softness, JointDef, DistanceJointDef, MotorJointDef, FilterJointDef, ParallelJointDef, PrismaticJointDef, RevoluteJointDef,
    SphericalJointDef, WeldJointDef, WheelJointDef, JointId, JointPair, JointReaction,
    DistanceJoint, MotorJoint, ParallelJoint, PrismaticJoint, RevoluteJoint, SphericalJoint, WeldJoint, WheelJoint,
    JOINT_PARALLEL, JOINT_DISTANCE, JOINT_FILTER, JOINT_MOTOR, JOINT_PRISMATIC, JOINT_REVOLUTE, JOINT_SPHERICAL, JOINT_WELD, JOINT_WHEEL,
    JOINT_DATA_BYTES,
    make_soft, default_joint_def, default_parallel_joint_def, default_distance_joint_def, default_motor_joint_def,
    default_filter_joint_def, default_prismatic_joint_def, default_revolute_joint_def, default_spherical_joint_def,
    default_weld_joint_def, default_wheel_joint_def, null_joint_id,
    distance_joint_of, motor_joint_of, parallel_joint_of, prismatic_joint_of, revolute_joint_of, spherical_joint_of, weld_joint_of, wheel_joint_of,
    joint_is_valid, get_joint_full_id, make_joint_id, get_joint_sim, get_joint_sim_of_kind, joint_edge_next,
