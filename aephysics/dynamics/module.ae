// Whether the world of this index is recording: the hooks' test, false
// for an index that is not a world's.
recording_on(world0: int) -> bool {
    if g_worlds == null || world0 < 0 || world0 >= MAX_WORLDS { return false }
    w = world_at(world0)
    return w.in_use && w.recording != null
}

rec_grow(r: *Recording, n: int) {
    if r.size + n <= r.capacity { return }
    capacity = math.max_int(math.max_int(2 * r.capacity, r.size + n), 4096)
    block = basics.alloc(capacity)
    if r.data != null {
        memcpy(block, r.data, r.size)
        basics.free_bytes(r.data, r.capacity)
    }
    r.data = block
    r.capacity = capacity
}

rec_raw(r: *Recording, src: ptr, n: int) {
    if n <= 0 { return }
    rec_grow(r, n)
    memcpy(r.data + r.size, src, n)
    r.size = r.size + n
}

// A record begun: its opcode and a length filled in by rec_end, the
// recording held between them.
rec_begin(world0: int, op: int) -> *Recording {
    r = world_at(world0).recording as *Recording
    rec_lock(r)
    rec_int(r, op)
    r.record_start = r.size
    rec_int(r, 0)
    return r
}

rec_end(r: *Recording) {
    length = r.size - r.record_start - 4
    memcpy(r.data + r.record_start, (&length) as ptr, 4)
    rec_unlock(r)
}

rec_int(r: *Recording, v: int) {
    holder = v
    rec_raw(r, (&holder) as ptr, 4)
}

rec_long(r: *Recording, v: long) {
    holder = v
    rec_raw(r, (&holder) as ptr, 8)
}

rec_float(r: *Recording, v: float) {
    holder = v
    rec_raw(r, (&holder) as ptr, 8)
}

rec_bool(r: *Recording, v: bool) {
    if v { rec_int(r, 1) } else { rec_int(r, 0) }
}

rec_vec3(r: *Recording, v: Vec3) {
    rec_float(r, v.x)
    rec_float(r, v.y)
    rec_float(r, v.z)
}

rec_quat(r: *Recording, q: Quat) {
    rec_float(r, q.x)
    rec_float(r, q.y)
    rec_float(r, q.z)
    rec_float(r, q.w)
}

rec_transform(r: *Recording, t: Transform) {
    rec_vec3(r, t.p)
    rec_quat(r, t.q)
}

// A body, shape or joint id without its world: the player's world stands in.
rec_id(r: *Recording, index1: int, generation: int) {
    rec_int(r, index1)
    rec_int(r, generation)
}

// A string's length and bytes, or -1 for none.
rec_string(r: *Recording, s: string) {
    if s == null {
        rec_int(r, NULL_INDEX)
        return
    }
    n = string.length(s)
    rec_int(r, n)
    rec_raw(r, string.aether_string_raw_ptr(s), n)
}

// A shape def's materials: their count, then each one, or -1 for none.
rec_materials(r: *Recording, materials: ptr, count: int) {
    if materials == null || count <= 0 {
        rec_int(r, NULL_INDEX)
        return
    }
    rec_int(r, count)
    each = materials as SurfaceMaterial[]
    i = 0
    while i < count {
        rec_surface_material(r, &each[i])
        i = i + 1
    }
}

// A geometry block by its id in the recording, interned by content: the
// first call to name a block copies it (a compound's tree pointers
// cleared), later ones find it. -1 for none.
rec_geometry(r: *Recording, kind: int, block: ptr) {
    if block == null {
        rec_int(r, NULL_INDEX)
        return
    }
    byte_count = 0
    if kind == shape.SHAPE_HULL { byte_count = (block as *HullData).byte_count }
    else if kind == shape.SHAPE_MESH { byte_count = (block as *MeshData).byte_count }
    else if kind == shape.SHAPE_HEIGHT_FIELD { byte_count = (block as *HeightFieldData).byte_count }
    else if kind == shape.SHAPE_COMPOUND { byte_count = (block as *CompoundData).byte_count }
    copy = basics.alloc(byte_count)
    memcpy(copy, block, byte_count)
    if kind == shape.SHAPE_COMPOUND {
        c = copy as *CompoundData
        c.tree.nodes = null
        c.tree.proxies = null
        c.tree.stack = null
        c.tree.stack_dist = null
    }
    rec_int(r, intern_geometry(r, kind, basics.hash_bytes(copy, byte_count), copy, byte_count))
}

// The id of a block among the recording's (the reference's
// b3InternGeometry): the one with the same kind and bytes, found by its
// content hash and then every byte, so two blocks on one hash stay two;
// else `copy` (alloc's, the recording's from now, freed when found)
// becomes a new one.
intern_geometry(r: *Recording, kind: int, hash: long, copy: ptr, byte_count: int) -> int {
    index = basics.map_get(&r.geometry_heads, hash, NULL_INDEX)
    while index != NULL_INDEX {
        entry = recorded_geometry_at(r, index)
        if entry.kind == kind && entry.byte_count == byte_count && memcmp(entry.block, copy, byte_count) == 0 {
            basics.free_bytes(copy, byte_count)
            return index
        }
        index = entry.next
    }
    index = basics.buffer_push(&r.geometry)
    entry = recorded_geometry_at(r, index)
    entry.hash = hash
    entry.kind = kind
    entry.byte_count = byte_count
    entry.block = copy
    entry.next = basics.map_get(&r.geometry_heads, hash, NULL_INDEX)
    basics.map_set(&r.geometry_heads, hash, index)
    return index
}

recorded_geometry_at(r: *Recording, index: int) -> *RecordedGeometry { return (r.geometry.data + index * sizeof(RecordedGeometry)) as *RecordedGeometry }

// The recording finished (aephysics.recording's stop, and a recording
// world's destroy): the joined bounds and the end marker, then the
// geometry the calls named, and the header told where that is.
finish_recording(w: *World) {
    if w.recording == null { return }
    r = w.recording as *Recording
    w.recording = null
    r.owner = 0
    rec_lock(r)
    rec_int(r, OP_BOUNDS)
    r.record_start = r.size
    rec_int(r, 0)
    rec_bool(r, r.have_bounds)
    rec_vec3(r, r.bounds.lower)
    rec_vec3(r, r.bounds.upper)
    bounds_length = r.size - r.record_start - 4
    memcpy(r.data + r.record_start, (&bounds_length) as ptr, 4)
    rec_int(r, OP_END)
    rec_int(r, 0)
    registry_offset = r.size
    rec_int(r, r.geometry.count)
    i = 0
    while i < r.geometry.count {
        entry = recorded_geometry_at(r, i)
        rec_int(r, entry.kind)
        rec_int(r, entry.byte_count)
        rec_raw(r, entry.block, entry.byte_count)
        i = i + 1
    }
    // The tagged queries' callers: each key, its id and its name.
    rec_int(r, r.tags.count)
    i = 0
    while i < r.tags.count {
        tag = recorded_tag_at(r, i)
        rec_long(r, tag.key)
        rec_long(r, tag.id)
        if tag.name == null { rec_int(r, NULL_INDEX) } else {
            rec_int(r, tag.length)
            rec_raw(r, tag.name, tag.length)
        }
        i = i + 1
    }
    registry_bytes = r.size - registry_offset
    memcpy(r.data + 12, (&registry_offset) as ptr, 4)
    memcpy(r.data + 16, (&registry_bytes) as ptr, 4)
    rec_unlock(r)
}

// --- recorded queries ---------------------------------------------------------------------------

// A query's caller, as the recording knows it: the key (query_tag_key)
// the viewer follows it by across frames, and the id and name it hashes,
// kept once per key in the recording's tag table.
struct RecordedTag {
    key: long
    id: long
    name: ptr          // its bytes and a terminating zero (alloc's), or null
    length: int
}

recorded_tag_at(r: *Recording, index: int) -> *RecordedTag { return (r.tags.data + index * sizeof(RecordedTag)) as *RecordedTag }

// The recording's own, while records go in from several threads: queries
// may run at once on a world that is not stepping.
rec_lock(r: *Recording) {
    while native.atomic_cas((&r.lock) as ptr, 0, 1) == false { native.pause() }
}

rec_unlock(r: *Recording) { native.atomic_store((&r.lock) as ptr, 0) }

// A query's bytes, written while it runs (its hits come one visit at a
// time) and committed whole after, so concurrent queries never interleave.
rec_payload_create() -> *Recording { return basics.alloc(sizeof(Recording)) as *Recording }

rec_payload_destroy(payload: *Recording) {
    if payload.data != null { basics.free_bytes(payload.data, payload.capacity) }
    basics.free_bytes(payload as ptr, sizeof(Recording))
}

// The int written `at` bytes into the payload replaced (a count reserved
// before its items).
rec_patch_int(payload: *Recording, at: int, v: int) {
    holder = v
    memcpy(payload.data + at, (&holder) as ptr, 4)
}

// A query's caller as one key: 64-bit FNV-1a over the id's eight bytes,
// then the name's (the reference's b3HashQueryTag); never 0, so the key
// says whether the query was tagged.
query_tag_key(id: long, name: string) -> long {
    // 14695981039346656037 and 1099511628211, the FNV-1a basis and prime.
    hash = 0 - 3750763034362895579
    prime = 1099511628211 as long
    i = 0
    while i < 8 {
        hash = (hash ^ (basics.lsr(id, 8 * i) & (255 as long))) * prime
        i = i + 1
    }
    if name != null {
        bytes = string.aether_string_raw_ptr(name)
        n = string.length(name)
        i = 0
        while i < n {
            hash = (hash ^ (native.load_u8(bytes, i as long) as long)) * prime
            i = i + 1
        }
    }
    if hash == (0 as long) { return 1 as long }
    return hash
}

// The key's id and name kept, the first ones for a key.
intern_tag(r: *Recording, key: long, id: long, name: string) {
    if basics.map_has(&r.tag_heads, key) { return }
    index = basics.buffer_push(&r.tags)
    tag = recorded_tag_at(r, index)
    tag.key = key
    tag.id = id
    tag.name = null
    tag.length = 0
    if name != null && string.length(name) > 0 {
        tag.length = string.length(name)
        tag.name = basics.alloc(tag.length + 1)
        memcpy(tag.name, string.aether_string_raw_ptr(name), tag.length)
    }
    basics.map_set(&r.tag_heads, key, index)
}

// The recording's tags forgotten, ready for a fresh session.
clear_tags(r: *Recording) {
    i = 0
    while i < r.tags.count {
        tag = recorded_tag_at(r, i)
        if tag.name != null { basics.free_bytes(tag.name, tag.length + 1) }
        i = i + 1
    }
    r.tags.count = 0
    basics.map_clear(&r.tag_heads)
}

// A query's record committed into its world's recording, its tag record
// first when the filter names its caller (both under the lock, so they
// stay together whatever else records at once).
rec_commit_query(world0: int, op: int, payload: *Recording, tag_id: long, tag_name: string) {
    r = world_at(world0).recording as *Recording
    if r == null { return }
    rec_lock(r)
    if tag_id != (0 as long) || (tag_name != null && string.length(tag_name) > 0) {
        key = query_tag_key(tag_id, tag_name)
        intern_tag(r, key, tag_id, tag_name)
        rec_int(r, OP_QUERY_TAG)
        rec_int(r, 8)
        rec_long(r, key)
    }
    rec_int(r, op)
    rec_int(r, payload.size)
    rec_raw(r, payload.data, payload.size)
    rec_unlock(r)
}

rec_aabb(r: *Recording, box: AABB) {
    rec_vec3(r, box.lower)
    rec_vec3(r, box.upper)
}

// A query's filter: its bits (its caller rides the tag record).
rec_query_filter(r: *Recording, filter: QueryFilter) {
    rec_long(r, filter.category_bits)
    rec_long(r, filter.mask_bits)
}

// A convex proxy: its points, then its radius.
rec_shape_proxy(r: *Recording, proxy: ShapeProxy) {
    count = math.clamp_int(proxy.count, 0, distance.MAX_SHAPE_CAST_POINTS)
    rec_int(r, count)
    points = proxy.points as Vec3[]
    i = 0
    while i < count {
        rec_vec3(r, points[i])
        i = i + 1
    }
    rec_float(r, proxy.radius)
}

