import aephysics.sphere
import aephysics.capsule
import aephysics.compound
import aephysics.shape
import aephysics.broad_phase
import aephysics.mesh_contact

exports (
    WorldDef, BodyDef, ShapeDef, MotionLocks, WorldId, BodyId, ShapeId,
    World, Body, BodySim, BodyState, WorldShape, Contact, ContactEdge, Joint, JointEdge,
    SolverSet, Island, IslandSim, ContactLink, JointLink,
    NULL_INDEX, MAX_WORLDS, STATIC_SET, DISABLED_SET, AWAKE_SET, FIRST_SLEEPING_SET, SPECULATIVE_DISTANCE,
    BODY_STATIC, BODY_KINEMATIC, BODY_DYNAMIC,
    LOCK_LINEAR_X, LOCK_LINEAR_Y, LOCK_LINEAR_Z, LOCK_ANGULAR_X, LOCK_ANGULAR_Y, LOCK_ANGULAR_Z,
    IS_FAST, IS_BULLET, IS_SPEED_CAPPED, HAD_TIME_OF_IMPACT, ALLOW_FAST_ROTATION, ENLARGE_BOUNDS,
    DYNAMIC_FLAG, ENABLE_SLEEP, ENABLE_CONTACT_RECYCLING, DIRTY_MASS, ALL_LOCKS, FIXED_ROTATION, BODY_TRANSIENT_FLAGS,
    SHAPE_ENABLE_SENSOR_EVENTS, SHAPE_ENABLE_CONTACT_EVENTS, SHAPE_ENABLE_CUSTOM_FILTERING, SHAPE_ENABLE_HIT_EVENTS,
    SHAPE_ENABLE_PRE_SOLVE_EVENTS, SHAPE_ENABLE_SPECULATIVE,
    default_world_def, default_body_def, default_shape_def, null_body_id, null_shape_id,
    create_world, destroy_world, world_is_valid, get_world, world_body_count, world_shape_count, world_awake_body_count,
    world_set_gravity, world_get_gravity,
    create_body, destroy_body, body_is_valid, get_body_full_id, get_body, get_body_sim, get_body_state, get_body_transform,
    make_body_id, sync_body_flags, update_body_mass_data, is_body_awake, wake_body,
    body_get_position, body_get_rotation, body_get_transform, body_set_transform,
    body_get_local_point, body_get_world_point, body_get_local_vector, body_get_world_vector,
