    body_set_gravity_scale, body_get_gravity_scale, body_set_user_data, body_get_user_data,
    body_is_awake, body_set_awake, body_is_enabled, body_is_sleep_enabled, body_enable_sleep,
    body_set_sleep_threshold, body_get_sleep_threshold, body_get_shape_count, body_get_shapes, body_compute_aabb,
    body_set_motion_locks, body_get_motion_locks, body_get_flags,
    create_sphere_shape, create_capsule_shape, create_hull_shape, create_mesh_shape, create_height_field_shape,
    create_compound_shape, destroy_shape, shape_is_valid, get_shape_full_id, get_shape, shape_get_body,
    shape_get_aabb, shape_get_type, shape_get_density, shape_set_density, shape_get_filter, shape_set_filter,
    shape_get_surface_material, shape_set_surface_material, shape_get_material_count, shape_is_sensor,
    shape_set_user_data, shape_get_user_data, shape_get_flags,
