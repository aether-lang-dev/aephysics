        a_joint_id_id = read_joint_id(p)
        a_bool_flag = read_bool(p)
        if p.ok { joint_solver.wheel_joint_enable_suspension_limit(a_joint_id_id, a_bool_flag) }
        return true
    }
    if op == dynamics.OP_WHEEL_JOINT_SET_SUSPENSION_LIMITS {
        a_joint_id_id = read_joint_id(p)
        a_float_lower = read_float(p)
        a_float_upper = read_float(p)
        if p.ok { joint_solver.wheel_joint_set_suspension_limits(a_joint_id_id, a_float_lower, a_float_upper) }
        return true
    }
    if op == dynamics.OP_WHEEL_JOINT_ENABLE_SPIN_MOTOR {
        a_joint_id_id = read_joint_id(p)
        a_bool_flag = read_bool(p)
        if p.ok { joint_solver.wheel_joint_enable_spin_motor(a_joint_id_id, a_bool_flag) }
        return true
    }
    if op == dynamics.OP_WHEEL_JOINT_SET_SPIN_MOTOR_SPEED {
        a_joint_id_id = read_joint_id(p)
        a_float_value = read_float(p)
        if p.ok { joint_solver.wheel_joint_set_spin_motor_speed(a_joint_id_id, a_float_value) }
        return true
    }
    if op == dynamics.OP_WHEEL_JOINT_SET_MAX_SPIN_TORQUE {
        a_joint_id_id = read_joint_id(p)
        a_float_value = read_float(p)
        if p.ok { joint_solver.wheel_joint_set_max_spin_torque(a_joint_id_id, a_float_value) }
        return true
    }
    if op == dynamics.OP_WHEEL_JOINT_ENABLE_STEERING {
        a_joint_id_id = read_joint_id(p)
        a_bool_flag = read_bool(p)
        if p.ok { joint_solver.wheel_joint_enable_steering(a_joint_id_id, a_bool_flag) }
        return true
    }
    if op == dynamics.OP_WHEEL_JOINT_SET_STEERING_HERTZ {
        a_joint_id_id = read_joint_id(p)
        a_float_value = read_float(p)
        if p.ok { joint_solver.wheel_joint_set_steering_hertz(a_joint_id_id, a_float_value) }
        return true
    }
    if op == dynamics.OP_WHEEL_JOINT_SET_STEERING_DAMPING_RATIO {
        a_joint_id_id = read_joint_id(p)
        a_float_value = read_float(p)
        if p.ok { joint_solver.wheel_joint_set_steering_damping_ratio(a_joint_id_id, a_float_value) }
        return true
    }
    if op == dynamics.OP_WHEEL_JOINT_SET_MAX_STEERING_TORQUE {
        a_joint_id_id = read_joint_id(p)
        a_float_value = read_float(p)
        if p.ok { joint_solver.wheel_joint_set_max_steering_torque(a_joint_id_id, a_float_value) }
        return true
    }
    if op == dynamics.OP_WHEEL_JOINT_ENABLE_STEERING_LIMIT {
        a_joint_id_id = read_joint_id(p)
        a_bool_flag = read_bool(p)
        if p.ok { joint_solver.wheel_joint_enable_steering_limit(a_joint_id_id, a_bool_flag) }
        return true
    }
    if op == dynamics.OP_WHEEL_JOINT_SET_STEERING_LIMITS {
        a_joint_id_id = read_joint_id(p)
        a_float_lower = read_float(p)
        a_float_upper = read_float(p)
        if p.ok { joint_solver.wheel_joint_set_steering_limits(a_joint_id_id, a_float_lower, a_float_upper) }
        return true
    }
    if op == dynamics.OP_WHEEL_JOINT_SET_TARGET_STEERING_ANGLE {
        a_joint_id_id = read_joint_id(p)
        a_float_value = read_float(p)
        if p.ok { joint_solver.wheel_joint_set_target_steering_angle(a_joint_id_id, a_float_value) }
        return true
    }
    return false
}
