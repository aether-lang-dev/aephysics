// Recording and replay (#149, the reference's recording.c and
// recording_replay.c): a world records every call that changes it while a
// recording is started, and a player replays the recording into a world of
// its own, frame by frame (a frame is the calls before a step, the step and
// the state check after it), checking after every step that its world
// hashes as the recorded one did.
//
// A recording is a header, a snapshot of the world it started from
// (aephysics.snapshot), the world's state hash, then one record per call
// (its opcode, its length and its arguments field by field, written by the
// hooks at the top of every recorded function in dynamics, physics_world
// and joint_solver; a create's record ends with the id it made, which the
// replay must make too), a state hash after every step, the joined bounds,
// an end marker, and last the geometry the calls named, each block once.
//
// The player owns a copy of the bytes and a world it restores in place, so
// the world's id stays the same through a restart or a seek backward; it
// keeps keyframes (a snapshot every so many frames, the spacing widening to
// stay under a memory budget) to seek backward without replaying from the
// start, and the bodies in the order they were made (a destroyed one
// leaves a hole) so a viewer's selection survives seeking. A record it does
// not know is skipped, as a newer minor version may add some; a record
// that does not read whole, or a create that makes another id than the one
// recorded, stops the replay (the player has failed); a state hash that
// differs marks the frame it was found at (the player has diverged) and the
// replay goes on.
//
// The world queries are recorded too, each with every visit and the
// caller's answer to it, and asked again on replay with the same answers;
// a query whose filter names its caller (its id and name) carries a key a
// viewer can follow it by. The player keeps the queries of the frame it
// last played, with their hits.
//
// Not recorded: what the host wires in (user data, callbacks, filters, the
// worker count).

import std.string
import std.fs
import aephysics.math
import aephysics.native
import aephysics.basics
import aephysics.distance
import aephysics.hull
import aephysics.mesh
import aephysics.height_field
import aephysics.compound
import aephysics.shape
import aephysics.material
import aephysics.manifold
import aephysics.dynamics
import aephysics.joint_solver
import aephysics.physics_world
import aephysics.snapshot
import aephysics.debug_draw

exports (
    Player, PlayerInfo, QueryInfo, QueryHit, QUERY_OVERLAP_AABB, QUERY_OVERLAP_SHAPE, QUERY_CAST_RAY, QUERY_CAST_SHAPE,
    QUERY_CAST_RAY_CLOSEST, QUERY_CAST_MOVER, QUERY_COLLIDE_MOVER, player_frame_query_count, player_frame_query,
    player_frame_query_hit, player_draw_frame_queries, player_set_debug_shape_callbacks, create_recording, destroy_recording, recording_data, recording_size, start_recording,
    stop_recording, save_recording_to_file, load_recording_from_file, create_player, destroy_player, player_step_frame,
    player_sub_step_frame, player_restart, player_seek_frame, player_world, player_frame, player_frame_count,
    player_at_end, player_at_pre_step, player_has_diverged, player_diverge_frame, player_failed, player_info,
    player_set_worker_count, player_set_keyframe_policy, player_keyframe_budget, player_keyframe_min_interval,
    player_keyframe_interval, player_keyframe_bytes, player_keyframe_count, player_body_count, player_body_id,
    validate_replay
)

extern memcpy(dst: ptr, src: ptr, size: int) -> ptr
extern memset(block: ptr, value: int, size: int) -> ptr
extern memchr(block: ptr, value: int, size: int) -> ptr

const NULL_INDEX = 0 - 1
const STRING_SLOTS = 4
const MAX_RECORDED_MATERIALS = 65536
const DEFAULT_KEYFRAME_INTERVAL = 16
const DEFAULT_KEYFRAME_BUDGET = 536870912

// --- recordings -------------------------------------------------------------------------------------

// A recording to start a world into: empty until then, the host's to free.
create_recording() -> *Recording {
    r = basics.alloc(sizeof(Recording)) as *Recording
    r.data = null
    r.size = 0
    r.capacity = 0
    r.record_start = 0
    r.geometry = basics.buffer_create(sizeof(RecordedGeometry), 0)
    r.geometry_heads = basics.map_create(16)
    r.have_bounds = false
    r.owner = 0
    r.lock = 0
    r.tags = basics.buffer_create(sizeof(RecordedTag), 0)
    r.tag_heads = basics.map_create(16)
    return r
}

// The recording's geometry copies and tags forgotten, ready for a fresh
// session.
clear_session(r: *Recording) {
    dynamics.clear_tags(r)
    i = 0
    while i < r.geometry.count {
        entry = dynamics.recorded_geometry_at(r, i)
        basics.free_bytes(entry.block, entry.byte_count)
        i = i + 1
    }
    r.geometry.count = 0
    basics.map_clear(&r.geometry_heads)
}

// The recording freed; a world still recording into it stops first, so it
// never writes into freed memory.
destroy_recording(r: *Recording) {
    if r == null { return }
    if r.owner != 0 { dynamics.finish_recording(dynamics.get_world(r.owner - 1)) }
    clear_session(r)
    basics.buffer_destroy(&r.geometry)
    basics.map_destroy(&r.geometry_heads)
    basics.buffer_destroy(&r.tags)
    basics.map_destroy(&r.tag_heads)
    if r.data != null { basics.free_bytes(r.data, r.capacity) }
    basics.free_bytes(r as ptr, sizeof(Recording))
}

recording_data(r: *Recording) -> ptr { return r.data }
recording_size(r: *Recording) -> int { return r.size }

// The world starts recording into `r` (b3World_StartRecording): the
// header, a snapshot of the world as it is, its state's hash; then every
// call that changes it until stop_recording or its destroy. False for a
// world that is not one, is mid-step or already records, and for a
// recording another world is writing. A recording started again begins a
// fresh session.
start_recording(world_id: WorldId, r: *Recording) -> bool {
    if r == null || r.owner != 0 || dynamics.world_is_valid(world_id) == false { return false }
    w = dynamics.get_world(world_id.index1 - 1)
    if w.locked || w.recording != null { return false }
    snap, snap_count = snapshot.save_world(world_id)
    if snap == null { return false }
    r.size = 0
    r.have_bounds = false
    clear_session(r)
    dynamics.rec_int(r, dynamics.RECORDING_MAGIC)
    dynamics.rec_int(r, dynamics.RECORDING_MAJOR_VERSION)
    dynamics.rec_int(r, snap_count)
    dynamics.rec_int(r, 0)
    dynamics.rec_int(r, 0)
    dynamics.rec_int(r, dynamics.RECORDING_MINOR_VERSION)
    dynamics.rec_int(r, 0)
    dynamics.rec_int(r, 0)
    dynamics.rec_raw(r, snap, snap_count)
    snapshot.free_snapshot(snap, snap_count)
    w.recording = r as ptr
    r.owner = world_id.index1
    recorder = dynamics.rec_begin(world_id.index1 - 1, dynamics.OP_STATE_HASH)
    dynamics.rec_long(recorder, dynamics.hash_world_state(w))
    dynamics.rec_end(recorder)
    return true
}

// The world stops recording (b3World_StopRecording); the recording is
// whole: its bounds, its end, the geometry the calls named.
stop_recording(world_id: WorldId) {
    if dynamics.world_is_valid(world_id) == false { return }
    w = dynamics.get_world(world_id.index1 - 1)
    if w.locked { return }
    dynamics.finish_recording(w)
}

save_recording_to_file(r: *Recording, path: string) -> bool {
    if r == null || r.size <= 0 { return false }
    err = fs.write_binary(path, (r.data as byte[])[0..r.size])
    return string.length(err) == 0
}

// A recording read from a file, to play; null when there is no such file.
// Whether its bytes are a recording is the player's to find out.
load_recording_from_file(path: string) -> *Recording {
    data, length, err = fs.read_binary(path)
    if string.length(err) > 0 { return null }
    if length <= 0 {
        string.free(data)
        return null
    }
    r = create_recording()
    dynamics.rec_raw(r, string.aether_string_raw_ptr(data), length)
    string.free(data)
    return r
}

// --- the player -------------------------------------------------------------------------------------

// What a recording holds, read once when it is opened so a viewer can
// frame and label it (b3RecPlayerInfo).
struct PlayerInfo {
    frame_count: int               // the recorded steps
    worker_count: int              // the replay world's
    time_step: float               // the first step's
    sub_step_count: int            // the first step's
    bounds: AABB                   // every step's bodies joined, zero when none were recorded
}

// A geometry block the recording's calls name, the player's own copy.
struct PlayerGeometry {
    kind: int
    byte_count: int
    block: ptr
}

// The world as it was at a frame, to seek back to: its snapshot, where the
// next frame's records start, the divergence found so far and the bodies
// in the order they were made.
struct Keyframe {
    frame: int
    cursor: int
    block: ptr
    byte_count: int
    diverged: bool
    diverge_frame: int
    bodies: ptr                    // BodyId[body_count]
    body_count: int
}

struct Player {
    data: ptr                      // the recording, the player's own copy
    size: int
    def: WorldDef                  // the world it plays into
    world_id: WorldId
    snapshot_at: int               // the recording's snapshot: frame 0
    snapshot_bytes: int
    ops_start: int
    ops_end: int                   // where the records end (the geometry's offset)
    cursor: int
    record_end: int                // the end of the record being read
    ok: bool                       // the record being read reads whole so far
    failed: bool                   // a record did not read whole or made another id: nothing after it runs
    frame: int
    frame_count: int
    at_end: bool
    at_pre_step: bool
    diverged: bool
    diverge_frame: int
    time_step: float
    sub_step_count: int
    bounds: AABB
    materials: ptr                 // a shape def's materials while its call runs
    material_count: int
    strings: ptr                   // ptr[STRING_SLOTS]: the record's strings while its call runs
    string_bytes: ptr              // int[STRING_SLOTS]
    string_count: int
    geometry: Buffer               // PlayerGeometry
    bodies: Buffer                 // BodyId in the order they were made, null ids where destroyed
    frame0_bodies: Buffer          // BodyId: the bodies of the recording's snapshot
    keyframes: Buffer              // Keyframe
    keyframe_interval: int
    keyframe_min_interval: int
    keyframe_budget: long
    keyframe_bytes: long
    last_keyframe_frame: int
    tags: Buffer                   // PlayerTag: the tagged queries' callers
    tag_index: LongMap             // a tag's key to its entry
    proxy_points: ptr              // Vec3[MAX_SHAPE_CAST_POINTS]: a recorded proxy's points
    replay_hits: Buffer            // RecordedHit: the visits of the query being asked again
    replay_planes: Buffer          // PlaneResult: a mover's recorded planes
    frame_queries: Buffer          // FrameQuery: the queries of the frame last played
    frame_hits: Buffer             // QueryHit
    frame_proxy_points: Buffer     // Vec3: the frame's proxy queries' points
    pending_key: long              // the key of the tag record just read, for the query after it
}

player_geometry_at(p: *Player, index: int) -> *PlayerGeometry { return (p.geometry.data + index * sizeof(PlayerGeometry)) as *PlayerGeometry }
keyframe_at(p: *Player, index: int) -> *Keyframe { return (p.keyframes.data + index * sizeof(Keyframe)) as *Keyframe }

read_header_int(data: ptr, at: int) -> int {
    holder = 0
    memcpy((&holder) as ptr, data + at, 4)
    return holder
}

read_header_float(data: ptr, at: int) -> float {
    holder = 0.0
    memcpy((&holder) as ptr, data + at, 8)
    return holder
}

// A player of the recording in `size` bytes, its world stepped by
// `worker_count` workers (a count other than the recorded one makes the
// state checks a test of determinism across threads); null when the bytes
// are not a recording of this major version and layout, any section fails
// its checks, or the snapshot does not load.
create_player(data: ptr, size: int, worker_count: int) -> *Player {
    if data == null || size < dynamics.RECORDING_HEADER_BYTES { return null }
    if read_header_int(data, 0) != dynamics.RECORDING_MAGIC || read_header_int(data, 4) != dynamics.RECORDING_MAJOR_VERSION { return null }
    snap_bytes = read_header_int(data, 8)
    registry_offset = read_header_int(data, 12)
    registry_bytes = read_header_int(data, 16)
    if snap_bytes <= 0 || snap_bytes > size - dynamics.RECORDING_HEADER_BYTES { return null }
    ops_start = dynamics.RECORDING_HEADER_BYTES + snap_bytes
    if registry_offset < ops_start || registry_offset > size - 4 || registry_bytes != size - registry_offset { return null }
    p = basics.alloc(sizeof(Player)) as *Player
    p.data = basics.alloc(size)
    memcpy(p.data, data, size)
    p.size = size
    p.def = dynamics.default_world_def()
    p.def.worker_count = math.clamp_int(worker_count, 1, native.MAX_WORKERS)
    p.snapshot_at = dynamics.RECORDING_HEADER_BYTES
    p.snapshot_bytes = snap_bytes
    p.ops_start = ops_start
    p.ops_end = registry_offset
    p.cursor = ops_start
    p.diverge_frame = NULL_INDEX
    p.strings = basics.alloc(STRING_SLOTS * 8)
    p.string_bytes = basics.alloc(STRING_SLOTS * 4)
    p.geometry = basics.buffer_create(sizeof(PlayerGeometry), 0)
    p.bodies = basics.buffer_create(sizeof(BodyId), 0)
    p.frame0_bodies = basics.buffer_create(sizeof(BodyId), 0)
    p.keyframes = basics.buffer_create(sizeof(Keyframe), 0)
    p.tags = basics.buffer_create(sizeof(PlayerTag), 0)
    p.tag_index = basics.map_create(16)
    p.proxy_points = basics.alloc(distance.MAX_SHAPE_CAST_POINTS * sizeof(Vec3))
    p.replay_hits = basics.buffer_create(sizeof(RecordedHit), 0)
    p.replay_planes = basics.buffer_create(sizeof(PlaneResult), 0)
    p.frame_queries = basics.buffer_create(sizeof(FrameQuery), 0)
    p.frame_hits = basics.buffer_create(sizeof(QueryHit), 0)
    p.frame_proxy_points = basics.buffer_create(sizeof(Vec3), 0)
    p.keyframe_interval = DEFAULT_KEYFRAME_INTERVAL
    p.keyframe_min_interval = DEFAULT_KEYFRAME_INTERVAL
    p.keyframe_budget = DEFAULT_KEYFRAME_BUDGET as long
    p.world_id = WorldId { index1: 0, generation: 0 }
    if load_geometry(p, registry_offset, registry_bytes) == false || scan_records(p) == false {
        destroy_player(p)
        return null
    }
    p.world_id = snapshot.load_world(&p.def, p.data + p.snapshot_at, p.snapshot_bytes)
    if dynamics.world_is_valid(p.world_id) == false {
        destroy_player(p)
        return null
    }
    // The snapshot's bodies were not made by a create record: the world is
    // walked once for them, in slot order.
    w = dynamics.get_world(p.world_id.index1 - 1)
    i = 0
    while i < w.bodies.count {
        b = dynamics.body_at(w, i)
        if b.set_index != NULL_INDEX {
            index = basics.buffer_push(&p.frame0_bodies)
            each = p.frame0_bodies.data as BodyId[]
            each[index] = BodyId { index1: i + 1, world0: p.world_id.index1 - 1, generation: b.generation }
        }
        i = i + 1
    }
    copy_bodies(&p.bodies, p.frame0_bodies.data, p.frame0_bodies.count)
    return p
}

// The player freed: its world first, then the geometry the world used.
destroy_player(p: *Player) {
    if p == null { return }
    if dynamics.world_is_valid(p.world_id) { dynamics.destroy_world(p.world_id) }
    i = 0
    while i < p.geometry.count {
        g = player_geometry_at(p, i)
        basics.free_bytes(g.block, g.byte_count)
        i = i + 1
    }
    basics.buffer_destroy(&p.geometry)
    clear_keyframes(p)
    basics.buffer_destroy(&p.keyframes)
    basics.buffer_destroy(&p.bodies)
    basics.buffer_destroy(&p.frame0_bodies)
    free_tags(p)
    basics.free_bytes(p.proxy_points, distance.MAX_SHAPE_CAST_POINTS * sizeof(Vec3))
    basics.buffer_destroy(&p.replay_hits)
    basics.buffer_destroy(&p.replay_planes)
    basics.buffer_destroy(&p.frame_queries)
    basics.buffer_destroy(&p.frame_hits)
    basics.buffer_destroy(&p.frame_proxy_points)
    release_record(p)
    basics.free_bytes(p.strings, STRING_SLOTS * 8)
    basics.free_bytes(p.string_bytes, STRING_SLOTS * 4)
    basics.free_bytes(p.data, p.size)
    basics.free_bytes(p as ptr, sizeof(Player))
}

// The geometry the records name: each block copied out and checked as
// bytes from outside are.
load_geometry(p: *Player, offset: int, byte_count: int) -> bool {
    at = offset
    end = offset + byte_count
    count = read_header_int(p.data, at)
    at = at + 4
    if count < 0 || basics.section_fits(at, count, 8, end) == false { return false }
    i = 0
    while i < count {
        if at + 8 > end { return false }
        kind = read_header_int(p.data, at)
        n = read_header_int(p.data, at + 4)
        at = at + 8
        if n <= 0 || n > end - at { return false }
        block = basics.alloc(n)
        memcpy(block, p.data + at, n)
        at = at + n
        index = basics.buffer_push(&p.geometry)
        g = player_geometry_at(p, index)
        g.kind = kind
        g.byte_count = n
        g.block = block
        valid = false
        if kind == shape.SHAPE_HULL { valid = hull.hull_bytes_valid(block as *HullData, n) && (block as *HullData).byte_count == n }
        else if kind == shape.SHAPE_MESH { valid = mesh.mesh_bytes_valid(block as *MeshData, n) && (block as *MeshData).byte_count == n }
        else if kind == shape.SHAPE_HEIGHT_FIELD { valid = height_field.height_field_bytes_valid(block as *HeightFieldData, n) && (block as *HeightFieldData).byte_count == n }
        else if kind == shape.SHAPE_COMPOUND { valid = compound.convert_bytes_to_compound(block, n) != null }
        if valid == false { return false }
        i = i + 1
    }
    return load_tags(p, at, end)
}

// The records walked once without running them: their framing checked up
// to the end marker, the frames counted, the first step's tuning and the
// bounds read for the info.
scan_records(p: *Player) -> bool {
    at = p.ops_start
    frames = 0
    while at < p.ops_end {
        if at + 8 > p.ops_end { return false }
        op = read_header_int(p.data, at)
        length = read_header_int(p.data, at + 4)
        if length < 0 || length > p.ops_end - at - 8 { return false }
        payload = at + 8
        at = payload + length
        if op == dynamics.OP_STEP {
            if frames == 0 && length >= 12 {
                p.time_step = read_header_float(p.data, payload)
                p.sub_step_count = read_header_int(p.data, payload + 8)
            }
            frames = frames + 1
        } else if op == dynamics.OP_BOUNDS && length >= 52 {
            if read_header_int(p.data, payload) == 1 {
                lower = math.vec3(read_header_float(p.data, payload + 4), read_header_float(p.data, payload + 12), read_header_float(p.data, payload + 20))
                upper = math.vec3(read_header_float(p.data, payload + 28), read_header_float(p.data, payload + 36), read_header_float(p.data, payload + 44))
                p.bounds = AABB { lower: lower, upper: upper }
            }
        } else if op == dynamics.OP_END {
            p.frame_count = frames
            return at == p.ops_end
        }
    }
    return false
}

copy_bodies(into: *Buffer, from: ptr, count: int) {
    into.count = 0
    basics.buffer_reserve(into, count)
    if count > 0 { memcpy(into.data, from, count * sizeof(BodyId)) }
    into.count = count
}

// --- reading a record -------------------------------------------------------------------------------

need(p: *Player, n: int) -> bool {
    if p.ok == false { return false }
    if n < 0 || n > p.record_end - p.cursor {
        p.ok = false
        return false
    }
    return true
}

read_int(p: *Player) -> int {
    if need(p, 4) == false { return 0 }
    holder = 0
    memcpy((&holder) as ptr, p.data + p.cursor, 4)
    p.cursor = p.cursor + 4
    return holder
}

read_long(p: *Player) -> long {
    if need(p, 8) == false { return 0 as long }
    holder = 0 as long
    memcpy((&holder) as ptr, p.data + p.cursor, 8)
    p.cursor = p.cursor + 8
    return holder
}

read_float(p: *Player) -> float {
    if need(p, 8) == false { return 0.0 }
    holder = 0.0
    memcpy((&holder) as ptr, p.data + p.cursor, 8)
    p.cursor = p.cursor + 8
    return holder
}

read_bool(p: *Player) -> bool {
    v = read_int(p)
    if v != 0 && v != 1 { p.ok = false }
    return v == 1
}

read_vec3(p: *Player) -> Vec3 {
    x = read_float(p)
    y = read_float(p)
    z = read_float(p)
    return math.vec3(x, y, z)
}

read_quat(p: *Player) -> Quat {
    x = read_float(p)
    y = read_float(p)
    z = read_float(p)
    w = read_float(p)
    return Quat { x: x, y: y, z: z, w: w }
}

read_transform(p: *Player) -> Transform {
    position = read_vec3(p)
    rotation = read_quat(p)
    return Transform { p: position, q: rotation }
}

// Ids in the player's world: the recorded index and generation, the
// world the player's own.
read_body_id(p: *Player) -> BodyId {
    index1 = read_int(p)
    generation = read_int(p)
    return BodyId { index1: index1, world0: p.world_id.index1 - 1, generation: generation }
}

read_shape_id(p: *Player) -> ShapeId {
    index1 = read_int(p)
    generation = read_int(p)
    return ShapeId { index1: index1, world0: p.world_id.index1 - 1, generation: generation }
}

read_joint_id(p: *Player) -> JointId {
    index1 = read_int(p)
    generation = read_int(p)
    return JointId { index1: index1, world0: p.world_id.index1 - 1, generation: generation }
}

// A create's call made an id; the record says which it made when it was
// recorded. Another one means the worlds have parted: the replay stops.
check_made(p: *Player, index1: int, generation: int, recorded_index1: int, recorded_generation: int) {
    if index1 != recorded_index1 || generation != recorded_generation { p.ok = false }
}

// A string, held until the record's call is done; null for none.
read_string(p: *Player) -> string {
    n = read_int(p)
    if p.ok == false || n == NULL_INDEX { return null }
    if need(p, n) == false || p.string_count >= STRING_SLOTS {
        p.ok = false
        return null
    }
    block = basics.alloc(n + 1)
    memcpy(block, p.data + p.cursor, n)
    memset(block + n, 0, 1)
    p.cursor = p.cursor + n
    slots = p.strings as ptr[]
    sizes = p.string_bytes as int[]
    slots[p.string_count] = block
    sizes[p.string_count] = n + 1
    p.string_count = p.string_count + 1
    return native.name_text(block)
}

// A shape def's materials, held until the record's call is done.
read_materials(p: *Player) -> ptr {
    count = read_int(p)
    p.material_count = 0
    if p.ok == false || count == NULL_INDEX { return null }
    if count <= 0 || count > MAX_RECORDED_MATERIALS || p.materials != null {
        p.ok = false
        return null
    }
    p.materials = basics.alloc(count * sizeof(SurfaceMaterial))
    p.material_count = count
    each = p.materials as SurfaceMaterial[]
    i = 0
    while i < count {
        each[i] = read_surface_material(p)
        i = i + 1
    }
    return p.materials
}

// A geometry block the recording holds, by id, of the kind the call takes.
read_geometry(p: *Player, kind: int) -> ptr {
    id = read_int(p)
    if p.ok == false || id == NULL_INDEX { return null }
    if id < 0 || id >= p.geometry.count || player_geometry_at(p, id).kind != kind {
        p.ok = false
        return null
    }
    return player_geometry_at(p, id).block
}

// What the record's call held, given back.
release_record(p: *Player) {
    if p.materials != null {
        basics.free_bytes(p.materials, p.material_count * sizeof(SurfaceMaterial))
        p.materials = null
        p.material_count = 0
    }
    slots = p.strings as ptr[]
    sizes = p.string_bytes as int[]
    i = 0
    while i < p.string_count {
        basics.free_bytes(slots[i], sizes[i])
        i = i + 1
    }
    p.string_count = 0
}

// A body made: the next ordinal. Ordinals are never reused.
track_body_create(p: *Player, id: BodyId) {
    index = basics.buffer_push(&p.bodies)
    each = p.bodies.data as BodyId[]
    each[index] = id
}

// A body destroyed leaves a hole, so the ordinals after it stay.
track_body_destroy(p: *Player, id: BodyId) {
    if id.index1 == 0 { return }
    each = p.bodies.data as BodyId[]
    i = 0
    while i < p.bodies.count {
        if each[i].index1 == id.index1 && each[i].generation == id.generation {
            each[i] = dynamics.null_body_id()
            return
        }
        i = i + 1
    }
}

// --- playing ----------------------------------------------------------------------------------------

// The next record run: its call made, its check done, or skipped when this
// player does not know it. Its opcode, or NULL_INDEX when it does not read
// whole or its create made another id (the player has failed).
run_record(p: *Player) -> int {
    if p.failed || p.cursor + 8 > p.ops_end {
        p.failed = true
        return NULL_INDEX
    }
    op = read_header_int(p.data, p.cursor)
    length = read_header_int(p.data, p.cursor + 4)
    if length < 0 || length > p.ops_end - p.cursor - 8 {
        p.failed = true
        return NULL_INDEX
    }
    p.cursor = p.cursor + 8
    p.record_end = p.cursor + length
    p.ok = true
    if op == dynamics.OP_END {
        p.cursor = p.record_end
        return op
    }
    known = dispatch(p, op)
    release_record(p)
    if known == false {
        // A newer minor version's record: skipped, as the reference does.
        p.cursor = p.record_end
        return op
    }
    if p.ok == false || p.cursor != p.record_end {
        p.failed = true
        return NULL_INDEX
    }
    return op
}

// The frame just stepped kept, when it falls on the keyframe spacing.
keyframe_boundary(p: *Player) {
    if p.frame > p.last_keyframe_frame && p.frame % p.keyframe_interval == 0 { capture_keyframe(p) }
}

// The next frame played (b3RecPlayer_StepFrame): its records up to and
// through its step and the state check after it. False at the end of the
// recording or when the player has failed.
player_step_frame(p: *Player) -> bool {
    p.at_pre_step = false
    if p.at_end { return false }
    clear_frame_queries(p)
    stepped = false
    while true {
        if p.failed || p.cursor >= p.ops_end {
            p.at_end = true
            return stepped
        }
        // Once stepped, only the state check still belongs to this frame.
        if stepped && read_header_int(p.data, p.cursor) != dynamics.OP_STATE_HASH {
            keyframe_boundary(p)
            return true
        }
        op = run_record(p)
        if op == NULL_INDEX || op == dynamics.OP_END {
            p.at_end = true
            return stepped
        }
        if op == dynamics.OP_STEP {
            p.frame = p.frame + 1
            stepped = true
        }
    }
    return stepped
}

// The next frame played in two calls when it makes a body
// (b3RecPlayer_SubStepFrame): the first stops before its step, so a viewer
// can draw the new bodies where they were made; the next steps.
player_sub_step_frame(p: *Player) {
    if p.at_end { return }
    if p.at_pre_step == false { clear_frame_queries(p) }
    stepped = false
    made_a_body = false
    while true {
        if p.failed || p.cursor >= p.ops_end {
            p.at_end = true
            p.at_pre_step = false
            return
        }
        next = read_header_int(p.data, p.cursor)
        if stepped && next != dynamics.OP_STATE_HASH {
            keyframe_boundary(p)
            return
        }
        if p.at_pre_step == false && made_a_body && next == dynamics.OP_STEP {
            p.at_pre_step = true
            return
        }
        op = run_record(p)
        if op == NULL_INDEX || op == dynamics.OP_END {
            p.at_end = true
            p.at_pre_step = false
            return
        }
        if op == dynamics.OP_CREATE_BODY { made_a_body = true }
        if op == dynamics.OP_STEP {
            p.at_pre_step = false
            p.frame = p.frame + 1
            stepped = true
        }
    }
}

// Back to frame 0 (b3RecPlayer_Restart), the world restored in place so its
// id stays.
player_restart(p: *Player) {
    if snapshot.restore_world(p.world_id, &p.def, p.data + p.snapshot_at, p.snapshot_bytes) == false {
        p.failed = true
        p.at_end = true
        return
    }
    p.cursor = p.ops_start
    p.failed = false
    p.diverged = false
    p.diverge_frame = NULL_INDEX
    p.frame = 0
    p.at_end = false
    p.at_pre_step = false
    clear_frame_queries(p)
    copy_bodies(&p.bodies, p.frame0_bodies.data, p.frame0_bodies.count)
}

// The world at `frame` (b3RecPlayer_SeekFrame): backward from the latest
// keyframe before it, or from frame 0; forward through a keyframe when one
// lies between; then frame by frame. It stops at the last frame when asked
// past the end.
player_seek_frame(p: *Player, frame: int) {
    p.at_pre_step = false
    target = math.max_int(frame, 0)
    best = NULL_INDEX
    i = 0
    while i < p.keyframes.count {
        k = keyframe_at(p, i)
        if k.frame < target && (best == NULL_INDEX || k.frame > keyframe_at(p, best).frame) { best = i }
        i = i + 1
    }
    if target < p.frame {
        if best != NULL_INDEX { restore_keyframe(p, keyframe_at(p, best)) } else { player_restart(p) }
    } else if best != NULL_INDEX && keyframe_at(p, best).frame > p.frame {
        restore_keyframe(p, keyframe_at(p, best))
    }
    while p.frame < target && player_step_frame(p) {}
}

// The world as the keyframe holds it, in place, and the player where it was.
restore_keyframe(p: *Player, k: *Keyframe) {
    if snapshot.restore_world(p.world_id, &p.def, k.block, k.byte_count) == false {
        p.failed = true
        p.at_end = true
        return
    }
    p.cursor = k.cursor
    p.failed = false
    p.diverged = k.diverged
    p.diverge_frame = k.diverge_frame
    p.frame = k.frame
    p.at_end = false
    p.at_pre_step = false
    clear_frame_queries(p)
    copy_bodies(&p.bodies, k.bodies, k.body_count)
}

free_keyframe(k: *Keyframe) {
    snapshot.free_snapshot(k.block, k.byte_count)
    if k.bodies != null { basics.free_bytes(k.bodies, k.body_count * sizeof(BodyId)) }
}

keyframe_cost(k: *Keyframe) -> long { return (k.byte_count + k.body_count * sizeof(BodyId)) as long }

clear_keyframes(p: *Player) {
    i = 0
    while i < p.keyframes.count {
        free_keyframe(keyframe_at(p, i))
        i = i + 1
    }
    p.keyframes.count = 0
    p.keyframe_bytes = 0 as long
}

// The frame just completed kept as a keyframe. Over the budget, the
// spacing doubles and the keyframes off the wider grid go, until it fits
// or nothing more can go (the newest is always kept).
capture_keyframe(p: *Player) {
    block, byte_count = snapshot.save_world(p.world_id)
    if block == null { return }
    cost = (byte_count + p.bodies.count * sizeof(BodyId)) as long
    while p.keyframes.count > 0 && p.keyframe_bytes + cost > p.keyframe_budget {
        p.keyframe_interval = p.keyframe_interval * 2
        kept = 0
        kept_bytes = 0 as long
        i = 0
        while i < p.keyframes.count {
            k = keyframe_at(p, i)
            if k.frame % p.keyframe_interval == 0 {
                if kept != i { memcpy(keyframe_at(p, kept) as ptr, k as ptr, sizeof(Keyframe)) }
                kept_bytes = kept_bytes + keyframe_cost(keyframe_at(p, kept))
                kept = kept + 1
            } else {
                free_keyframe(k)
            }
            i = i + 1
        }
        progress = kept < p.keyframes.count
        p.keyframes.count = kept
        p.keyframe_bytes = kept_bytes
        if progress == false { break }
    }
    index = basics.buffer_push(&p.keyframes)
    k = keyframe_at(p, index)
    k.frame = p.frame
    k.cursor = p.cursor
    k.block = block
    k.byte_count = byte_count
    k.diverged = p.diverged
    k.diverge_frame = p.diverge_frame
    k.body_count = p.bodies.count
    k.bodies = null
    if p.bodies.count > 0 {
        k.bodies = basics.alloc(p.bodies.count * sizeof(BodyId))
        memcpy(k.bodies, p.bodies.data, p.bodies.count * sizeof(BodyId))
    }
    p.keyframe_bytes = p.keyframe_bytes + cost
    p.last_keyframe_frame = p.frame
}

// The keyframes' memory budget and finest spacing
// (b3RecPlayer_SetKeyframePolicy): a budget or spacing not above zero keeps
// the one there was. The keyframes kept so far go; a restart fills them
// again under the new policy.
player_set_keyframe_policy(p: *Player, budget_bytes: long, min_interval_frames: int) {
    if budget_bytes > (0 as long) { p.keyframe_budget = budget_bytes }
    if min_interval_frames > 0 { p.keyframe_min_interval = min_interval_frames }
    clear_keyframes(p)
    p.keyframe_interval = p.keyframe_min_interval
    p.last_keyframe_frame = 0
}

// The replay world's workers, now and through every restore.
player_set_worker_count(p: *Player, count: int) {
    p.def.worker_count = math.clamp_int(count, 1, native.MAX_WORKERS)
    if dynamics.world_is_valid(p.world_id) { physics_world.set_worker_count(p.world_id, p.def.worker_count) }
}

player_info(p: *Player) -> PlayerInfo {
    return PlayerInfo { frame_count: p.frame_count, worker_count: p.def.worker_count, time_step: p.time_step, sub_step_count: p.sub_step_count, bounds: p.bounds }
}

player_keyframe_budget(p: *Player) -> long { return p.keyframe_budget }
player_keyframe_min_interval(p: *Player) -> int { return p.keyframe_min_interval }
player_keyframe_interval(p: *Player) -> int { return p.keyframe_interval }
player_keyframe_bytes(p: *Player) -> long { return p.keyframe_bytes }
player_keyframe_count(p: *Player) -> int { return p.keyframes.count }
player_world(p: *Player) -> WorldId { return p.world_id }
player_frame(p: *Player) -> int { return p.frame }
player_frame_count(p: *Player) -> int { return p.frame_count }
player_at_end(p: *Player) -> bool { return p.at_end }
player_at_pre_step(p: *Player) -> bool { return p.at_pre_step }
player_has_diverged(p: *Player) -> bool { return p.diverged }
player_diverge_frame(p: *Player) -> int { return p.diverge_frame }
player_failed(p: *Player) -> bool { return p.failed }

// The bodies made so far, in order, holes included.
player_body_count(p: *Player) -> int { return p.bodies.count }

// The body made `ordinal`-th, or a null id when there is none or it was
// destroyed.
player_body_id(p: *Player, ordinal: int) -> BodyId {
    if ordinal < 0 || ordinal >= p.bodies.count { return dynamics.null_body_id() }
    each = p.bodies.data as BodyId[]
    return each[ordinal]
}

// Whether the recording replays whole without diverging (b3ValidateReplay).
validate_replay(data: ptr, size: int, worker_count: int) -> bool {
    p = create_player(data, size, worker_count)
    if p == null { return false }
    while player_step_frame(p) {
        if p.diverged { break }
    }
    result = p.failed == false && p.diverged == false
    destroy_player(p)
    return result
}

// --- the queries replayed ---------------------------------------------------------------------------

// A recorded query asked again in the player's world, through a
// trampoline that compares each visit with the recorded one and gives the
// caller's recorded answer back, so the query runs as it did; any
// difference (a shape, a point, a count, the tree visits) marks the
// player diverged. Then it is kept with its hits for the frame, for a
// viewer to read (b3RecPlayer_GetFrameQuery).

// The kinds of query a frame keeps (b3RecQueryType).
const QUERY_OVERLAP_AABB = 0
const QUERY_OVERLAP_SHAPE = 1
const QUERY_CAST_RAY = 2
const QUERY_CAST_SHAPE = 3
const QUERY_CAST_RAY_CLOSEST = 4
const QUERY_CAST_MOVER = 5
const QUERY_COLLIDE_MOVER = 6

// A query of the frame last played (b3RecQueryInfo).
struct QueryInfo {
    kind: int                      // QUERY_*
    filter: QueryFilter            // its bits, and its caller's id and name
    aabb: AABB                     // where it looked: the box, or the shape swept along the translation
    origin: Vec3
    translation: Vec3
    fraction: float                // a cast mover's answer, the closest ray's hit; 1 otherwise
    hit_count: int
    key: long                      // its caller's key, 0 when untagged
}

// One result of a query of the frame last played (b3RecQueryHit): a
// shape, and for a cast its point, normal and fraction; a mover's plane
// gives its point and normal.
struct QueryHit {
    shape: ShapeId
    point: Vec3
    normal: Vec3
    fraction: float
}

// A visit as recorded, to compare and answer with.
struct RecordedHit {
    shape: ShapeId
    point: Vec3
    normal: Vec3
    fraction: float
    user_material_id: long
    triangle_index: int
    child_index: int
    answer_float: float
    answer_bool: bool
    plane_start: int               // a mover's planes in replay_planes
    plane_count: int
}

struct FrameQuery {
    kind: int
    filter: QueryFilter
    aabb: AABB
    origin: Vec3
    translation: Vec3
    fraction: float
    hit_start: int
    hit_count: int
    key: long
    mover: Capsule                 // a mover query's capsule, relative to the origin
    proxy_start: int               // a proxy query's points in frame_proxy_points, relative to the origin
    proxy_count: int
    proxy_radius: float
}

// A tagged query's caller, from the recording's tag table.
struct PlayerTag {
    key: long
    id: long
    name: ptr                      // its bytes and a zero (alloc's), or null
    length: int
}

struct ReplayQuery {
    p: *Player
    cursor: int
    count: int
}

recorded_hit_at(p: *Player, index: int) -> *RecordedHit { return (p.replay_hits.data + index * sizeof(RecordedHit)) as *RecordedHit }
frame_query_at(p: *Player, index: int) -> *FrameQuery { return (p.frame_queries.data + index * sizeof(FrameQuery)) as *FrameQuery }
frame_hit_at(p: *Player, index: int) -> *QueryHit { return (p.frame_hits.data + index * sizeof(QueryHit)) as *QueryHit }
player_tag_at(p: *Player, index: int) -> *PlayerTag { return (p.tags.data + index * sizeof(PlayerTag)) as *PlayerTag }
replay_plane_at(p: *Player, index: int) -> *PlaneResult { return (p.replay_planes.data + index * sizeof(PlaneResult)) as *PlaneResult }

// The recording's tag table, after the geometry: each key, its id and its
// name. A recording made before queries were recorded has none. Bytes
// after it (a newer minor version's) are left alone.
load_tags(p: *Player, at: int, end: int) -> bool {
    if at == end { return true }
    if at + 4 > end { return false }
    count = read_header_int(p.data, at)
    at = at + 4
    if count < 0 || basics.section_fits(at, count, 20, end) == false { return false }
    i = 0
    while i < count {
        if at + 20 > end { return false }
        key = read_header_long(p.data, at)
        id = read_header_long(p.data, at + 8)
        n = read_header_int(p.data, at + 16)
        at = at + 20
        if key == (0 as long) || (n != NULL_INDEX && (n <= 0 || n > end - at)) || basics.map_has(&p.tag_index, key) { return false }
        index = basics.buffer_push(&p.tags)
        tag = player_tag_at(p, index)
        tag.key = key
        tag.id = id
        tag.name = null
        tag.length = 0
        if n != NULL_INDEX {
            if memchr(p.data + at, 0, n) != null { return false }
            tag.name = basics.alloc(n + 1)
            tag.length = n
            memcpy(tag.name, p.data + at, n)
            at = at + n
        }
        basics.map_set(&p.tag_index, key, index)
        i = i + 1
    }
    return true
}

read_header_long(data: ptr, at: int) -> long {
    holder = 0 as long
    memcpy((&holder) as ptr, data + at, 8)
    return holder
}

free_tags(p: *Player) {
    i = 0
    while i < p.tags.count {
        tag = player_tag_at(p, i)
        if tag.name != null { basics.free_bytes(tag.name, tag.length + 1) }
        i = i + 1
    }
    basics.buffer_destroy(&p.tags)
    basics.map_destroy(&p.tag_index)
}

// The frame's queries forgotten, before the next frame's come.
clear_frame_queries(p: *Player) {
    p.frame_queries.count = 0
    p.frame_hits.count = 0
    p.frame_proxy_points.count = 0
    p.pending_key = 0 as long
}

// The proxy the query asked with, kept for drawing it.
stash_proxy(p: *Player, q: *FrameQuery, proxy: ShapeProxy) {
    q.proxy_start = p.frame_proxy_points.count
    q.proxy_count = proxy.count
    q.proxy_radius = proxy.radius
    points = proxy.points as Vec3[]
    i = 0
    while i < proxy.count {
        index = basics.buffer_push(&p.frame_proxy_points)
        kept = p.frame_proxy_points.data as Vec3[]
        kept[index] = points[i]
        i = i + 1
    }
}

read_aabb(p: *Player) -> AABB {
    lower = read_vec3(p)
    upper = read_vec3(p)
    return AABB { lower: lower, upper: upper }
}

read_query_filter(p: *Player) -> QueryFilter {
    filter = shape.default_query_filter()
    filter.category_bits = read_long(p)
    filter.mask_bits = read_long(p)
    return filter
}

// A proxy's points into the player's own block.
read_shape_proxy(p: *Player) -> ShapeProxy {
    count = read_int(p)
    if count < 0 || count > distance.MAX_SHAPE_CAST_POINTS {
        p.ok = false
        count = 0
    }
    points = p.proxy_points as Vec3[]
    i = 0
    while i < count {
        points[i] = read_vec3(p)
        i = i + 1
    }
    radius = read_float(p)
    return distance.shape_proxy(p.proxy_points, count, radius)
}

read_plane_result(p: *Player) -> PlaneResult {
    normal = read_vec3(p)
    offset = read_float(p)
    point = read_vec3(p)
    triangle_index = read_int(p)
    child_index = read_int(p)
    material_index = read_int(p)
    return PlaneResult { plane: Plane { normal: normal, offset: offset }, point: point, triangle_index: triangle_index,
                         child_index: child_index, material_index: material_index }
}

// A count of items of at least `least` bytes each, which the record must
// have room for: a count from the file never sizes an allocation it could
// not fill.
read_count(p: *Player, least: int) -> int {
    n = read_int(p)
    if p.ok == false { return 0 }
    if n < 0 || n > (p.record_end - p.cursor) / least {
        p.ok = false
        return 0
    }
    return n
}

// The recorded visits made ready: `n` of them, each zeroed.
ready_hits(p: *Player, n: int) {
    p.replay_hits.count = 0
    basics.buffer_reserve(&p.replay_hits, n)
    if n > 0 { memset(p.replay_hits.data, 0, n * sizeof(RecordedHit)) }
    p.replay_hits.count = n
}

// An overlap's visits: each shape and the caller's answer.
read_overlap_hits(p: *Player) -> int {
    n = read_count(p, 12)
    ready_hits(p, n)
    i = 0
    while i < n {
        h = recorded_hit_at(p, i)
        h.shape = read_shape_id(p)
        h.answer_bool = read_bool(p)
        i = i + 1
    }
    return n
}

// A cast's hits: everything the visitor was given and its answer.
read_cast_hits(p: *Player) -> int {
    n = read_count(p, 88)
    ready_hits(p, n)
    i = 0
    while i < n {
        h = recorded_hit_at(p, i)
        h.shape = read_shape_id(p)
        h.point = read_vec3(p)
        h.normal = read_vec3(p)
        h.fraction = read_float(p)
        h.user_material_id = read_long(p)
        h.triangle_index = read_int(p)
        h.child_index = read_int(p)
        h.answer_float = read_float(p)
        i = i + 1
    }
    return n
}

same_vec3(a: Vec3, b: Vec3) -> bool { return a.x == b.x && a.y == b.y && a.z == b.z }

same_plane(a: PlaneResult, b: PlaneResult) -> bool {
    return same_vec3(a.plane.normal, b.plane.normal) && a.plane.offset == b.plane.offset && same_vec3(a.point, b.point) &&
           a.triangle_index == b.triangle_index && a.child_index == b.child_index && a.material_index == b.material_index
}

// The next recorded visit, or null when the query visits more than it did.
next_hit(rq: *ReplayQuery) -> *RecordedHit {
    if rq.cursor >= rq.count {
        rq.p.diverged = true
        return null
    }
    h = recorded_hit_at(rq.p, rq.cursor)
    rq.cursor = rq.cursor + 1
    return h
}

replay_overlap_visit(shape_id: ShapeId, context: ptr) -> bool {
    rq = context as *ReplayQuery
    h = next_hit(rq)
    if h == null { return false }
    if shape_id.index1 != h.shape.index1 || shape_id.generation != h.shape.generation { rq.p.diverged = true }
    return h.answer_bool
}

replay_cast_visit(shape_id: ShapeId, point: Vec3, normal: Vec3, fraction: float, user_material_id: long, triangle_index: int, child_index: int, context: ptr) -> float {
    rq = context as *ReplayQuery
    h = next_hit(rq)
    if h == null { return 0.0 }
    if shape_id.index1 != h.shape.index1 || shape_id.generation != h.shape.generation || same_vec3(point, h.point) == false ||
       same_vec3(normal, h.normal) == false || fraction != h.fraction || user_material_id != h.user_material_id ||
       triangle_index != h.triangle_index || child_index != h.child_index {
        rq.p.diverged = true
    }
    return h.answer_float
}

replay_plane_visit(shape_id: ShapeId, planes: PlaneResult[], count: int, context: ptr) -> bool {
    rq = context as *ReplayQuery
    h = next_hit(rq)
    if h == null { return true }
    if shape_id.index1 != h.shape.index1 || shape_id.generation != h.shape.generation || count != h.plane_count { rq.p.diverged = true }
    recorded = rq.p.replay_planes.data as PlaneResult[]
    i = 0
    while i < count && i < h.plane_count {
        if same_plane(planes[i], recorded[h.plane_start + i]) == false { rq.p.diverged = true }
        i = i + 1
    }
    return h.answer_bool
}

// The visits compared to the end and the tree's work with the recorded.
check_replayed(p: *Player, rq: *ReplayQuery, stats: TreeStats, nodes: int, leaves: int) {
    if rq.cursor != rq.count || stats.node_visits != nodes || stats.leaf_visits != leaves { p.diverged = true }
}

// Where a query looked: its points (relative to the origin) at the origin
// and at the end of the translation, fattened by the radius.
query_bounds(origin: Vec3, translation: Vec3, points: ptr, count: int, radius: float) -> AABB {
    local = points as Vec3[]
    lower = origin
    upper = origin
    first = true
    end = math.add(origin, translation)
    i = 0
    while i < math.max_int(count, 1) {
        offset = math.vec3_zero()
        if count > 0 { offset = local[i] }
        a = math.add(origin, offset)
        b = math.add(end, offset)
        if first {
            lower = math.min_vec3(a, b)
            upper = math.max_vec3(a, b)
            first = false
        } else {
            lower = math.min_vec3(lower, math.min_vec3(a, b))
            upper = math.max_vec3(upper, math.max_vec3(a, b))
        }
        i = i + 1
    }
    r = math.vec3(radius, radius, radius)
    return AABB { lower: math.sub(lower, r), upper: math.add(upper, r) }
}

// The query kept for the frame, with the caller's key from the tag
// record before it, and its hits from the recorded visits.
stash_query(p: *Player, kind: int, filter: QueryFilter, aabb: AABB, origin: Vec3, translation: Vec3, fraction: float, hit_count: int) -> *FrameQuery {
    index = basics.buffer_push(&p.frame_queries)
    q = frame_query_at(p, index)
    q.kind = kind
    q.filter = filter
    q.aabb = aabb
    q.origin = origin
    q.translation = translation
    q.fraction = fraction
    q.key = p.pending_key
    p.pending_key = 0 as long
    q.hit_start = p.frame_hits.count
    q.hit_count = hit_count
    q.mover = Capsule { center1: math.vec3_zero(), center2: math.vec3_zero(), radius: 0.0 }
    q.proxy_start = 0
    q.proxy_count = 0
    q.proxy_radius = 0.0
    return q
}

stash_hit(p: *Player, shape_id: ShapeId, point: Vec3, normal: Vec3, fraction: float) {
    index = basics.buffer_push(&p.frame_hits)
    h = frame_hit_at(p, index)
    h.shape = shape_id
    h.point = point
    h.normal = normal
    h.fraction = fraction
}

stash_recorded_hits(p: *Player, n: int) {
    i = 0
    while i < n {
        h = recorded_hit_at(p, i)
        stash_hit(p, h.shape, h.point, h.normal, h.fraction)
        i = i + 1
    }
}

replay_overlap_aabb(p: *Player) {
    box = read_aabb(p)
    filter = read_query_filter(p)
    n = read_overlap_hits(p)
    nodes = read_int(p)
    leaves = read_int(p)
    if p.ok == false { return }
    rq = ReplayQuery { p: p, cursor: 0, count: n }
    stats = physics_world.overlap_aabb(p.world_id, box, filter, replay_overlap_visit, (&rq) as ptr)
    check_replayed(p, &rq, stats, nodes, leaves)
    stash_query(p, QUERY_OVERLAP_AABB, filter, box, math.vec3_zero(), math.vec3_zero(), 1.0, n)
    stash_recorded_hits(p, n)
}

replay_overlap_shape(p: *Player) {
    origin = read_vec3(p)
    proxy = read_shape_proxy(p)
    filter = read_query_filter(p)
    n = read_overlap_hits(p)
    nodes = read_int(p)
    leaves = read_int(p)
    if p.ok == false { return }
    rq = ReplayQuery { p: p, cursor: 0, count: n }
    stats = physics_world.overlap_shape(p.world_id, origin, proxy, filter, replay_overlap_visit, (&rq) as ptr)
    check_replayed(p, &rq, stats, nodes, leaves)
    box = query_bounds(origin, math.vec3_zero(), proxy.points, proxy.count, proxy.radius)
    kept_query = stash_query(p, QUERY_OVERLAP_SHAPE, filter, box, origin, math.vec3_zero(), 1.0, n)
    stash_proxy(p, kept_query, proxy)
    stash_recorded_hits(p, n)
}

replay_cast_ray(p: *Player) {
    origin = read_vec3(p)
    translation = read_vec3(p)
    filter = read_query_filter(p)
    n = read_cast_hits(p)
    nodes = read_int(p)
    leaves = read_int(p)
    if p.ok == false { return }
    rq = ReplayQuery { p: p, cursor: 0, count: n }
    stats = physics_world.cast_ray(p.world_id, origin, translation, filter, replay_cast_visit, (&rq) as ptr)
    check_replayed(p, &rq, stats, nodes, leaves)
    stash_query(p, QUERY_CAST_RAY, filter, query_bounds(origin, translation, null, 0, 0.0), origin, translation, 1.0, n)
    stash_recorded_hits(p, n)
}

replay_cast_shape(p: *Player) {
    origin = read_vec3(p)
    proxy = read_shape_proxy(p)
    translation = read_vec3(p)
    filter = read_query_filter(p)
    n = read_cast_hits(p)
    nodes = read_int(p)
    leaves = read_int(p)
    if p.ok == false { return }
    rq = ReplayQuery { p: p, cursor: 0, count: n }
    stats = physics_world.cast_shape(p.world_id, origin, proxy, translation, filter, replay_cast_visit, (&rq) as ptr)
    check_replayed(p, &rq, stats, nodes, leaves)
    box = query_bounds(origin, translation, proxy.points, proxy.count, proxy.radius)
    kept_query = stash_query(p, QUERY_CAST_SHAPE, filter, box, origin, translation, 1.0, n)
    stash_proxy(p, kept_query, proxy)
    stash_recorded_hits(p, n)
}

replay_cast_ray_closest(p: *Player) {
    origin = read_vec3(p)
    translation = read_vec3(p)
    filter = read_query_filter(p)
    hit = read_bool(p)
    shape_id = read_shape_id(p)
    point = read_vec3(p)
    normal = read_vec3(p)
    fraction = read_float(p)
    user_material_id = read_long(p)
    triangle_index = read_int(p)
    child_index = read_int(p)
    nodes = read_int(p)
    leaves = read_int(p)
    if p.ok == false { return }
    got = physics_world.cast_ray_closest(p.world_id, origin, translation, filter)
    if got.hit != hit || got.node_visits != nodes || got.leaf_visits != leaves { p.diverged = true }
    else if hit {
        if got.shape_id.index1 != shape_id.index1 || got.shape_id.generation != shape_id.generation || same_vec3(got.point, point) == false ||
           same_vec3(got.normal, normal) == false || got.fraction != fraction || got.user_material_id != user_material_id ||
           got.triangle_index != triangle_index || got.child_index != child_index {
            p.diverged = true
        }
    }
    hits = 0
    if hit { hits = 1 }
    result_fraction = 1.0
    if hit { result_fraction = fraction }
    stash_query(p, QUERY_CAST_RAY_CLOSEST, filter, query_bounds(origin, translation, null, 0, 0.0), origin, translation, result_fraction, hits)
    if hit { stash_hit(p, shape_id, point, normal, fraction) }
}

replay_cast_mover(p: *Player) {
    origin = read_vec3(p)
    mover = read_capsule(p)
    translation = read_vec3(p)
    filter = read_query_filter(p)
    n = read_overlap_hits(p)
    fraction = read_float(p)
    if p.ok == false { return }
    rq = ReplayQuery { p: p, cursor: 0, count: n }
    got = physics_world.cast_mover(p.world_id, origin, mover, translation, filter, true, replay_overlap_visit, (&rq) as ptr)
    if rq.cursor != n || got != fraction { p.diverged = true }
    centres = p.proxy_points as Vec3[]
    centres[0] = mover.center1
    centres[1] = mover.center2
    box = query_bounds(origin, translation, p.proxy_points, 2, mover.radius)
    kept_query = stash_query(p, QUERY_CAST_MOVER, filter, box, origin, translation, fraction, 0)
    kept_query.mover = mover
}

replay_collide_mover(p: *Player) {
    origin = read_vec3(p)
    mover = read_capsule(p)
    filter = read_query_filter(p)
    groups = read_count(p, 16)
    ready_hits(p, groups)
    p.replay_planes.count = 0
    i = 0
    while i < groups && p.ok {
        h = recorded_hit_at(p, i)
        h.shape = read_shape_id(p)
        count = read_count(p, 68)
        h.plane_start = p.replay_planes.count
        h.plane_count = count
        k = 0
        while k < count {
            plane = read_plane_result(p)
            index = basics.buffer_push(&p.replay_planes)
            stored = p.replay_planes.data as PlaneResult[]
            stored[index] = plane
            k = k + 1
        }
        h.answer_bool = read_bool(p)
        i = i + 1
    }
    if p.ok == false { return }
    rq = ReplayQuery { p: p, cursor: 0, count: groups }
    physics_world.collide_mover(p.world_id, origin, mover, filter, replay_plane_visit, (&rq) as ptr)
    if rq.cursor != groups { p.diverged = true }
    centres = p.proxy_points as Vec3[]
    centres[0] = mover.center1
    centres[1] = mover.center2
    box = query_bounds(origin, math.vec3_zero(), p.proxy_points, 2, mover.radius)
    kept_query = stash_query(p, QUERY_COLLIDE_MOVER, filter, box, origin, math.vec3_zero(), 1.0, p.replay_planes.count)
    kept_query.mover = mover
    i = 0
    while i < groups {
        h = recorded_hit_at(p, i)
        k = 0
        while k < h.plane_count {
            kept_plane = replay_plane_at(p, h.plane_start + k)
            stash_hit(p, h.shape, math.add(origin, kept_plane.point), kept_plane.plane.normal, 0.0)
            k = k + 1
        }
        i = i + 1
    }
}

// A query record run; false for an opcode that is not one.
dispatch_query(p: *Player, op: int) -> bool {
    if op == dynamics.OP_QUERY_TAG {
        p.pending_key = read_long(p)
        return true
    }
    if op == dynamics.OP_QUERY_OVERLAP_AABB { replay_overlap_aabb(p) }
    else if op == dynamics.OP_QUERY_OVERLAP_SHAPE { replay_overlap_shape(p) }
    else if op == dynamics.OP_QUERY_CAST_RAY { replay_cast_ray(p) }
    else if op == dynamics.OP_QUERY_CAST_SHAPE { replay_cast_shape(p) }
    else if op == dynamics.OP_QUERY_CAST_RAY_CLOSEST { replay_cast_ray_closest(p) }
    else if op == dynamics.OP_QUERY_CAST_MOVER { replay_cast_mover(p) }
    else if op == dynamics.OP_QUERY_COLLIDE_MOVER { replay_collide_mover(p) }
    else { return false }
    return true
}

// The queries of the frame last played.
player_frame_query_count(p: *Player) -> int { return p.frame_queries.count }

// A query of the frame last played, its caller's id and name from the tag
// table; an empty one for an index out of range.
player_frame_query(p: *Player, index: int) -> QueryInfo {
    if index < 0 || index >= p.frame_queries.count {
        return QueryInfo { kind: NULL_INDEX, filter: shape.default_query_filter(), aabb: AABB { lower: math.vec3_zero(), upper: math.vec3_zero() },
                           origin: math.vec3_zero(), translation: math.vec3_zero(), fraction: 1.0, hit_count: 0, key: 0 as long }
    }
    q = frame_query_at(p, index)
    filter = q.filter
    if q.key != (0 as long) {
        tag_index = basics.map_get(&p.tag_index, q.key, NULL_INDEX)
        if tag_index != NULL_INDEX {
            tag = player_tag_at(p, tag_index)
            filter.id = tag.id
            if tag.name != null { filter.name = native.name_text(tag.name) }
        }
    }
    return QueryInfo { kind: q.kind, filter: filter, aabb: q.aabb, origin: q.origin, translation: q.translation, fraction: q.fraction,
                       hit_count: q.hit_count, key: q.key }
}

// One result of a query of the frame last played; an empty one out of range.
player_frame_query_hit(p: *Player, query: int, hit: int) -> QueryHit {
    no_hit = QueryHit { shape: dynamics.null_shape_id(), point: math.vec3_zero(), normal: math.vec3_zero(), fraction: 0.0 }
    if query < 0 || query >= p.frame_queries.count { return no_hit }
    q = frame_query_at(p, query)
    if hit < 0 || hit >= q.hit_count { return no_hit }
    hits = p.frame_hits.data as QueryHit[]
    return hits[q.hit_start + hit]
}

// --- drawing ----------------------------------------------------------------------------------------

// The host's debug shape callbacks for the player's world, now and through
// every restore (b3RecPlayer_SetDebugShapeCallbacks): what the old ones
// made is given back to them, and the player rewinds to frame 0.
player_set_debug_shape_callbacks(p: *Player, create: fn(*DebugShape, ptr) -> ptr, destroy: fn(ptr, ptr), context: ptr) {
    p.def.create_debug_shape = create
    p.def.destroy_debug_shape = destroy
    p.def.user_debug_shape_context = context
    if dynamics.world_is_valid(p.world_id) { dynamics.set_debug_shape_callbacks(dynamics.get_world(p.world_id.index1 - 1), create, destroy, context) }
    player_restart(p)
}

// The colour of a query, or the one reserved for the selected query.
query_color(selected: bool, base: int) -> int {
    if selected { return debug_draw.COLOR_PLUM }
    return base
}

// Each reported overlap's shape by its bounds; a shape destroyed since is
// skipped.
draw_hit_bounds(p: *Player, q: *FrameQuery, draw: *DebugDraw, color: int) {
    bounds = draw.draw_bounds
    hits = p.frame_hits.data as QueryHit[]
    i = q.hit_start
    while i < q.hit_start + q.hit_count {
        if dynamics.shape_is_valid(hits[i].shape) { bounds(dynamics.shape_get_aabb(hits[i].shape), color, draw.context) }
        i = i + 1
    }
}

// A recorded proxy at `base`: a point without radius as a fat point, with
// one as a sphere, two with a radius as a capsule, more as their points.
draw_proxy(p: *Player, draw: *DebugDraw, base: Vec3, q: *FrameQuery, color: int) {
    points = p.frame_proxy_points.data as Vec3[]
    if q.proxy_count == 1 {
        at = math.add(base, points[q.proxy_start])
        if q.proxy_radius > 0.0 {
            sphere = draw.draw_sphere
            sphere(at, q.proxy_radius, color, 0.5, draw.context)
        } else {
            dot = draw.draw_point
            dot(at, 10.0, color, draw.context)
        }
    } else if q.proxy_count == 2 && q.proxy_radius > 0.0 {
        capsule = draw.draw_capsule
        capsule(math.add(base, points[q.proxy_start]), math.add(base, points[q.proxy_start + 1]), q.proxy_radius, color, 0.5, draw.context)
    } else if q.proxy_count >= 2 {
        dot = draw.draw_point
        i = 0
        while i < q.proxy_count {
            dot(math.add(base, points[q.proxy_start + i]), 6.0, color, draw.context)
            i = i + 1
        }
    }
}

// The queries of the frame last played, drawn (b3RecPlayer_DrawFrameQueries):
// every one when `query` is below zero, else that one; the `selected` one
// in the reserved colour and labelled with its caller.
player_draw_frame_queries(p: *Player, draw: *DebugDraw, query: int, selected: int) {
    segment = draw.draw_segment
    dot = draw.draw_point
    capsule = draw.draw_capsule
    hits = p.frame_hits.data as QueryHit[]
    qi = 0
    while qi < p.frame_queries.count {
        if query < 0 || qi == query {
            q = frame_query_at(p, qi)
            chosen = qi == selected
            if q.kind == QUERY_CAST_RAY || q.kind == QUERY_CAST_RAY_CLOSEST {
                segment(q.origin, math.add(q.origin, q.translation), query_color(chosen, debug_draw.COLOR_YELLOW), draw.context)
                i = q.hit_start
                while i < q.hit_start + q.hit_count {
                    dot(hits[i].point, 4.0, query_color(chosen, debug_draw.COLOR_YELLOW), draw.context)
                    segment(hits[i].point, math.add(hits[i].point, math.mul_sv(0.2, hits[i].normal)), query_color(chosen, debug_draw.COLOR_YELLOW_GREEN), draw.context)
                    i = i + 1
                }
            } else if q.kind == QUERY_CAST_SHAPE {
                segment(q.origin, math.add(q.origin, q.translation), query_color(chosen, debug_draw.COLOR_SKY_BLUE), draw.context)
                draw_proxy(p, draw, q.origin, q, query_color(chosen, debug_draw.COLOR_LIGHT_GREEN))
                i = q.hit_start
                while i < q.hit_start + q.hit_count {
                    dot(hits[i].point, 4.0, query_color(chosen, debug_draw.COLOR_SKY_BLUE), draw.context)
                    segment(hits[i].point, math.add(hits[i].point, math.mul_sv(0.2, hits[i].normal)), query_color(chosen, debug_draw.COLOR_LIGHT_SKY_BLUE), draw.context)
                    draw_proxy(p, draw, math.add(q.origin, math.mul_sv(hits[i].fraction, q.translation)), q, query_color(chosen, debug_draw.COLOR_SKY_BLUE))
                    i = i + 1
                }
            } else if q.kind == QUERY_CAST_MOVER {
                c1 = math.add(q.origin, q.mover.center1)
                c2 = math.add(q.origin, q.mover.center2)
                capsule(c1, c2, q.mover.radius, query_color(chosen, debug_draw.COLOR_LIGHT_SKY_BLUE), 0.6, draw.context)
                if q.fraction > 0.01 {
                    moved = math.mul_sv(q.fraction, q.translation)
                    capsule(math.add(c1, moved), math.add(c2, moved), q.mover.radius, debug_draw.COLOR_LIGHT_SKY_BLUE, 0.3, draw.context)
                }
            } else if q.kind == QUERY_COLLIDE_MOVER {
                capsule(math.add(q.origin, q.mover.center1), math.add(q.origin, q.mover.center2), q.mover.radius, query_color(chosen, debug_draw.COLOR_TAN), 0.6, draw.context)
                i = q.hit_start
                while i < q.hit_start + q.hit_count {
                    segment(hits[i].point, math.add(hits[i].point, math.mul_sv(0.2, hits[i].normal)), query_color(chosen, debug_draw.COLOR_ORANGE), draw.context)
                    i = i + 1
                }
            } else if q.kind == QUERY_OVERLAP_AABB {
                bounds = draw.draw_bounds
                bounds(q.aabb, query_color(chosen, debug_draw.COLOR_LIME_GREEN), draw.context)
                draw_hit_bounds(p, q, draw, query_color(chosen, debug_draw.COLOR_MAGENTA))
            } else if q.kind == QUERY_OVERLAP_SHAPE {
                draw_proxy(p, draw, q.origin, q, query_color(chosen, debug_draw.COLOR_LIME_GREEN))
                draw_hit_bounds(p, q, draw, query_color(chosen, debug_draw.COLOR_MAGENTA))
            }
            if chosen && q.key != (0 as long) { draw_query_label(p, draw, q) }
        }
        qi = qi + 1
    }
}

// The selected query's caller at its origin: its name and id, its name,
// or its id; an overlap box's at its centre, a mover's past its top.
draw_query_label(p: *Player, draw: *DebugDraw, q: *FrameQuery) {
    name = ""
    id = 0 as long
    tag_index = basics.map_get(&p.tag_index, q.key, NULL_INDEX)
    if tag_index != NULL_INDEX {
        tag = player_tag_at(p, tag_index)
        id = tag.id
        if tag.name != null { name = native.name_text(tag.name) }
    }
    text = "#${id}"
    if string.length(name) > 0 && id != (0 as long) { text = "${name} (${id})" }
    else if string.length(name) > 0 { text = name }
    at = q.origin
    if q.kind == QUERY_OVERLAP_AABB { at = math.aabb_center(q.aabb) }
    else if q.kind == QUERY_CAST_MOVER || q.kind == QUERY_COLLIDE_MOVER {
        c1 = math.add(q.origin, q.mover.center1)
        c2 = math.add(q.origin, q.mover.center2)
        at = math.add(c2, math.mul_sv(1.25 * q.mover.radius, math.normalize(math.sub(c2, c1))))
    }
    label = draw.draw_string
    label(at, text, debug_draw.COLOR_WHITE, draw.context)
}

// --- the records ------------------------------------------------------------------------------------

// The record's call made in the player's world, or its check done; false
// for an opcode this player does not know.
dispatch(p: *Player, op: int) -> bool {
    if op == dynamics.OP_STATE_HASH {
        recorded = read_long(p)
        if p.ok && dynamics.hash_world_state(dynamics.get_world(p.world_id.index1 - 1)) != recorded { p.diverged = true }
        // The first frame found parted: a query that answered differently
        // before this frame's step is found here too.
        if p.diverged && p.diverge_frame < 0 { p.diverge_frame = p.frame }
        return true
    }
    if op == dynamics.OP_BOUNDS {
        // Read for the info when the player opened.
        _have = read_bool(p)
        _lower = read_vec3(p)
        _upper = read_vec3(p)
        return true
    }
    if dispatch_query(p, op) { return true }
    return dispatch_call(p, op)
}

read_body_def(p: *Player) -> BodyDef {
    v = dynamics.default_body_def()
    v.kind = read_int(p)
    v.position = read_vec3(p)
    v.rotation = read_quat(p)
    v.linear_velocity = read_vec3(p)
    v.angular_velocity = read_vec3(p)
    v.linear_damping = read_float(p)
    v.angular_damping = read_float(p)
    v.gravity_scale = read_float(p)
    v.sleep_threshold = read_float(p)
    v.safety_factor = read_float(p)
    v.name = read_string(p)
    v.motion_locks = read_motion_locks(p)
    v.enable_sleep = read_bool(p)
    v.is_awake = read_bool(p)
    v.is_bullet = read_bool(p)
    v.is_enabled = read_bool(p)
    v.allow_fast_rotation = read_bool(p)
    v.enable_contact_recycling = read_bool(p)
    return v
}

read_shape_def(p: *Player) -> ShapeDef {
    v = dynamics.default_shape_def()
    v.name = read_string(p)
    v.materials = read_materials(p)
    v.material_count = p.material_count
    v.base_material = read_surface_material(p)
    v.density = read_float(p)
    v.explosion_scale = read_float(p)
    v.filter = read_filter(p)
    v.enable_custom_filtering = read_bool(p)
    v.is_sensor = read_bool(p)
    v.enable_sensor_events = read_bool(p)
    v.enable_contact_events = read_bool(p)
    v.enable_hit_events = read_bool(p)
    v.enable_pre_solve_events = read_bool(p)
    v.invoke_contact_creation = read_bool(p)
    v.update_body_mass = read_bool(p)
    v.enable_speculative_contact = read_bool(p)
    return v
}

read_joint_def(p: *Player) -> JointDef {
    v = dynamics.default_joint_def()
    v.body_id_a = read_body_id(p)
    v.body_id_b = read_body_id(p)
    v.local_frame_a = read_transform(p)
    v.local_frame_b = read_transform(p)
    v.force_threshold = read_float(p)
    v.torque_threshold = read_float(p)
    v.constraint_hertz = read_float(p)
    v.constraint_damping_ratio = read_float(p)
    v.draw_scale = read_float(p)
    v.collide_connected = read_bool(p)
    return v
}

read_distance_joint_def(p: *Player) -> DistanceJointDef {
    v = dynamics.default_distance_joint_def()
    v.base = read_joint_def(p)
    v.length = read_float(p)
    v.enable_spring = read_bool(p)
    v.lower_spring_force = read_float(p)
    v.upper_spring_force = read_float(p)
    v.hertz = read_float(p)
    v.damping_ratio = read_float(p)
    v.enable_limit = read_bool(p)
    v.min_length = read_float(p)
    v.max_length = read_float(p)
    v.enable_motor = read_bool(p)
    v.max_motor_force = read_float(p)
    v.motor_speed = read_float(p)
    return v
}

read_motor_joint_def(p: *Player) -> MotorJointDef {
    v = dynamics.default_motor_joint_def()
    v.base = read_joint_def(p)
    v.linear_velocity = read_vec3(p)
    v.max_velocity_force = read_float(p)
    v.angular_velocity = read_vec3(p)
    v.max_velocity_torque = read_float(p)
    v.linear_hertz = read_float(p)
    v.linear_damping_ratio = read_float(p)
    v.max_spring_force = read_float(p)
    v.angular_hertz = read_float(p)
    v.angular_damping_ratio = read_float(p)
    v.max_spring_torque = read_float(p)
    return v
}

read_filter_joint_def(p: *Player) -> FilterJointDef {
    v = dynamics.default_filter_joint_def()
    v.base = read_joint_def(p)
    return v
}

read_parallel_joint_def(p: *Player) -> ParallelJointDef {
    v = dynamics.default_parallel_joint_def()
    v.base = read_joint_def(p)
    v.hertz = read_float(p)
    v.damping_ratio = read_float(p)
    v.max_torque = read_float(p)
    return v
}

read_prismatic_joint_def(p: *Player) -> PrismaticJointDef {
    v = dynamics.default_prismatic_joint_def()
    v.base = read_joint_def(p)
    v.enable_spring = read_bool(p)
    v.hertz = read_float(p)
    v.damping_ratio = read_float(p)
    v.target_translation = read_float(p)
    v.enable_limit = read_bool(p)
    v.lower_translation = read_float(p)
    v.upper_translation = read_float(p)
    v.enable_motor = read_bool(p)
    v.max_motor_force = read_float(p)
    v.motor_speed = read_float(p)
    return v
}

read_revolute_joint_def(p: *Player) -> RevoluteJointDef {
    v = dynamics.default_revolute_joint_def()
    v.base = read_joint_def(p)
    v.target_angle = read_float(p)
    v.enable_spring = read_bool(p)
    v.hertz = read_float(p)
    v.damping_ratio = read_float(p)
    v.enable_limit = read_bool(p)
    v.lower_angle = read_float(p)
    v.upper_angle = read_float(p)
    v.enable_motor = read_bool(p)
    v.max_motor_torque = read_float(p)
    v.motor_speed = read_float(p)
    return v
}

read_spherical_joint_def(p: *Player) -> SphericalJointDef {
    v = dynamics.default_spherical_joint_def()
    v.base = read_joint_def(p)
    v.enable_spring = read_bool(p)
    v.hertz = read_float(p)
    v.damping_ratio = read_float(p)
    v.target_rotation = read_quat(p)
    v.enable_cone_limit = read_bool(p)
    v.cone_angle = read_float(p)
    v.cone_axis = read_vec3(p)
    v.cone_minor_angle = read_float(p)
    v.cone_major_axis = read_vec3(p)
    v.enable_twist_limit = read_bool(p)
    v.lower_twist_angle = read_float(p)
    v.upper_twist_angle = read_float(p)
    v.enable_motor = read_bool(p)
    v.max_motor_torque = read_float(p)
    v.motor_velocity = read_vec3(p)
    return v
}

read_weld_joint_def(p: *Player) -> WeldJointDef {
    v = dynamics.default_weld_joint_def()
    v.base = read_joint_def(p)
    v.linear_hertz = read_float(p)
    v.angular_hertz = read_float(p)
    v.linear_damping_ratio = read_float(p)
    v.angular_damping_ratio = read_float(p)
    return v
}

read_wheel_joint_def(p: *Player) -> WheelJointDef {
    v = dynamics.default_wheel_joint_def()
    v.base = read_joint_def(p)
    v.enable_suspension_spring = read_bool(p)
    v.suspension_hertz = read_float(p)
    v.suspension_damping_ratio = read_float(p)
    v.enable_suspension_limit = read_bool(p)
    v.lower_suspension_limit = read_float(p)
    v.upper_suspension_limit = read_float(p)
    v.enable_spin_motor = read_bool(p)
    v.max_spin_torque = read_float(p)
    v.spin_speed = read_float(p)
    v.enable_steering = read_bool(p)
    v.steering_hertz = read_float(p)
    v.steering_damping_ratio = read_float(p)
    v.target_steering_angle = read_float(p)
    v.max_steering_torque = read_float(p)
    v.enable_steering_limit = read_bool(p)
    v.lower_steering_limit = read_float(p)
    v.upper_steering_limit = read_float(p)
    return v
}

read_mass_data(p: *Player) -> MassData {
    v = MassData { mass: 0.0, center: math.vec3_zero(), inertia: Matrix3 { cx: math.vec3_zero(), cy: math.vec3_zero(), cz: math.vec3_zero() } }
    v.mass = read_float(p)
    v.center = read_vec3(p)
    v.inertia = read_matrix3(p)
    return v
}

read_motion_locks(p: *Player) -> MotionLocks {
    v = MotionLocks { linear_x: false, linear_y: false, linear_z: false, angular_x: false, angular_y: false, angular_z: false }
    v.linear_x = read_bool(p)
    v.linear_y = read_bool(p)
    v.linear_z = read_bool(p)
    v.angular_x = read_bool(p)
    v.angular_y = read_bool(p)
    v.angular_z = read_bool(p)
    return v
}

read_filter(p: *Player) -> Filter {
    v = Filter { category_bits: 0 as long, mask_bits: 0 as long, group_index: 0 }
    v.category_bits = read_long(p)
    v.mask_bits = read_long(p)
    v.group_index = read_int(p)
    return v
}

read_surface_material(p: *Player) -> SurfaceMaterial {
    v = SurfaceMaterial { friction: 0.0, restitution: 0.0, rolling_resistance: 0.0, tangent_velocity: math.vec3_zero(), user_material_id: 0 as long, custom_color: 0 }
    v.friction = read_float(p)
    v.restitution = read_float(p)
    v.rolling_resistance = read_float(p)
    v.tangent_velocity = read_vec3(p)
    v.user_material_id = read_long(p)
    v.custom_color = read_int(p)
    return v
}

read_sphere(p: *Player) -> Sphere {
    v = Sphere { center: math.vec3_zero(), radius: 0.0 }
    v.center = read_vec3(p)
    v.radius = read_float(p)
    return v
}

read_capsule(p: *Player) -> Capsule {
    v = Capsule { center1: math.vec3_zero(), center2: math.vec3_zero(), radius: 0.0 }
    v.center1 = read_vec3(p)
    v.center2 = read_vec3(p)
    v.radius = read_float(p)
    return v
}

read_matrix3(p: *Player) -> Matrix3 {
    v = Matrix3 { cx: math.vec3_zero(), cy: math.vec3_zero(), cz: math.vec3_zero() }
    v.cx = read_vec3(p)
    v.cy = read_vec3(p)
    v.cz = read_vec3(p)
    return v
}

read_explosion_def(p: *Player) -> ExplosionDef {
    v = physics_world.default_explosion_def()
    v.mask_bits = read_long(p)
    v.position = read_vec3(p)
    v.radius = read_float(p)
    v.falloff = read_float(p)
    v.impulse_per_area = read_float(p)
    return v
}

// The calls, one case an opcode.
dispatch_call(p: *Player, op: int) -> bool {
    if op == dynamics.OP_CREATE_BODY {
        a_world_id_world_id = p.world_id
        a_body_def_def = read_body_def(p)
        recorded_index1 = read_int(p)
        recorded_generation = read_int(p)
        if p.ok {
            made_body = dynamics.create_body(a_world_id_world_id, &a_body_def_def)
            check_made(p, made_body.index1, made_body.generation, recorded_index1, recorded_generation)
            track_body_create(p, made_body)
        }
        return true
    }
    if op == dynamics.OP_DESTROY_BODY {
        a_body_id_id = read_body_id(p)
        if p.ok {
            track_body_destroy(p, a_body_id_id)
            dynamics.destroy_body(a_body_id_id)
        }
        return true
    }
    if op == dynamics.OP_BODY_SET_TRANSFORM {
        a_body_id_id = read_body_id(p)
        a_vec3_position = read_vec3(p)
        a_quat_rotation = read_quat(p)
        if p.ok { dynamics.body_set_transform(a_body_id_id, a_vec3_position, a_quat_rotation) }
        return true
    }
    if op == dynamics.OP_BODY_SET_LINEAR_VELOCITY {
        a_body_id_id = read_body_id(p)
        a_vec3_v = read_vec3(p)
        if p.ok { dynamics.body_set_linear_velocity(a_body_id_id, a_vec3_v) }
        return true
    }
    if op == dynamics.OP_BODY_SET_ANGULAR_VELOCITY {
        a_body_id_id = read_body_id(p)
        a_vec3_v = read_vec3(p)
        if p.ok { dynamics.body_set_angular_velocity(a_body_id_id, a_vec3_v) }
        return true
    }
    if op == dynamics.OP_BODY_SET_TARGET_TRANSFORM {
        a_body_id_id = read_body_id(p)
        a_transform_target = read_transform(p)
        a_float_time_step = read_float(p)
        a_bool_wake = read_bool(p)
        if p.ok { dynamics.body_set_target_transform(a_body_id_id, a_transform_target, a_float_time_step, a_bool_wake) }
        return true
    }
    if op == dynamics.OP_BODY_APPLY_FORCE {
        a_body_id_id = read_body_id(p)
        a_vec3_force = read_vec3(p)
        a_vec3_point = read_vec3(p)
        a_bool_wake = read_bool(p)
        if p.ok { dynamics.body_apply_force(a_body_id_id, a_vec3_force, a_vec3_point, a_bool_wake) }
        return true
    }
    if op == dynamics.OP_BODY_APPLY_FORCE_TO_CENTER {
        a_body_id_id = read_body_id(p)
        a_vec3_force = read_vec3(p)
        a_bool_wake = read_bool(p)
        if p.ok { dynamics.body_apply_force_to_center(a_body_id_id, a_vec3_force, a_bool_wake) }
        return true
    }
    if op == dynamics.OP_BODY_APPLY_TORQUE {
        a_body_id_id = read_body_id(p)
        a_vec3_torque = read_vec3(p)
        a_bool_wake = read_bool(p)
        if p.ok { dynamics.body_apply_torque(a_body_id_id, a_vec3_torque, a_bool_wake) }
        return true
    }
    if op == dynamics.OP_BODY_APPLY_LINEAR_IMPULSE {
        a_body_id_id = read_body_id(p)
        a_vec3_impulse = read_vec3(p)
        a_vec3_point = read_vec3(p)
        a_bool_wake = read_bool(p)
        if p.ok { dynamics.body_apply_linear_impulse(a_body_id_id, a_vec3_impulse, a_vec3_point, a_bool_wake) }
        return true
    }
    if op == dynamics.OP_BODY_APPLY_LINEAR_IMPULSE_TO_CENTER {
        a_body_id_id = read_body_id(p)
        a_vec3_impulse = read_vec3(p)
        a_bool_wake = read_bool(p)
        if p.ok { dynamics.body_apply_linear_impulse_to_center(a_body_id_id, a_vec3_impulse, a_bool_wake) }
        return true
    }
    if op == dynamics.OP_BODY_APPLY_ANGULAR_IMPULSE {
        a_body_id_id = read_body_id(p)
        a_vec3_impulse = read_vec3(p)
        a_bool_wake = read_bool(p)
        if p.ok { dynamics.body_apply_angular_impulse(a_body_id_id, a_vec3_impulse, a_bool_wake) }
        return true
    }
    if op == dynamics.OP_BODY_SET_BULLET {
        a_body_id_id = read_body_id(p)
        a_bool_flag = read_bool(p)
        if p.ok { dynamics.body_set_bullet(a_body_id_id, a_bool_flag) }
        return true
    }
    if op == dynamics.OP_BODY_SET_MASS_DATA {
        a_body_id_id = read_body_id(p)
        a_mass_mass_data = read_mass_data(p)
        if p.ok { dynamics.body_set_mass_data(a_body_id_id, a_mass_mass_data) }
        return true
    }
    if op == dynamics.OP_BODY_APPLY_MASS_FROM_SHAPES {
        a_body_id_id = read_body_id(p)
        if p.ok { dynamics.body_apply_mass_from_shapes(a_body_id_id) }
        return true
    }
    if op == dynamics.OP_BODY_SET_LINEAR_DAMPING {
        a_body_id_id = read_body_id(p)
        a_float_damping = read_float(p)
        if p.ok { dynamics.body_set_linear_damping(a_body_id_id, a_float_damping) }
        return true
    }
    if op == dynamics.OP_BODY_SET_ANGULAR_DAMPING {
        a_body_id_id = read_body_id(p)
        a_float_damping = read_float(p)
        if p.ok { dynamics.body_set_angular_damping(a_body_id_id, a_float_damping) }
        return true
    }
    if op == dynamics.OP_BODY_SET_GRAVITY_SCALE {
        a_body_id_id = read_body_id(p)
        a_float_scale = read_float(p)
        if p.ok { dynamics.body_set_gravity_scale(a_body_id_id, a_float_scale) }
        return true
    }
    if op == dynamics.OP_BODY_SET_AWAKE {
        a_body_id_id = read_body_id(p)
        a_bool_awake = read_bool(p)
        if p.ok { dynamics.body_set_awake(a_body_id_id, a_bool_awake) }
        return true
    }
    if op == dynamics.OP_BODY_ENABLE_SLEEP {
        a_body_id_id = read_body_id(p)
        a_bool_enable = read_bool(p)
        if p.ok { dynamics.body_enable_sleep(a_body_id_id, a_bool_enable) }
        return true
    }
    if op == dynamics.OP_BODY_SET_SLEEP_THRESHOLD {
        a_body_id_id = read_body_id(p)
        a_float_threshold = read_float(p)
        if p.ok { dynamics.body_set_sleep_threshold(a_body_id_id, a_float_threshold) }
        return true
    }
    if op == dynamics.OP_BODY_SET_MOTION_LOCKS {
        a_body_id_id = read_body_id(p)
        a_motion_locks_locks = read_motion_locks(p)
        if p.ok { dynamics.body_set_motion_locks(a_body_id_id, a_motion_locks_locks) }
        return true
    }
    if op == dynamics.OP_CREATE_SPHERE_SHAPE {
        a_body_id_body_id = read_body_id(p)
        a_shape_def_def = read_shape_def(p)
        a_sphere_s = read_sphere(p)
        recorded_index1 = read_int(p)
        recorded_generation = read_int(p)
        if p.ok {
            made_shape = dynamics.create_sphere_shape(a_body_id_body_id, &a_shape_def_def, a_sphere_s)
            check_made(p, made_shape.index1, made_shape.generation, recorded_index1, recorded_generation)
        }
        return true
    }
    if op == dynamics.OP_CREATE_CAPSULE_SHAPE {
        a_body_id_body_id = read_body_id(p)
        a_shape_def_def = read_shape_def(p)
        a_capsule_c = read_capsule(p)
        recorded_index1 = read_int(p)
        recorded_generation = read_int(p)
        if p.ok {
            made_shape = dynamics.create_capsule_shape(a_body_id_body_id, &a_shape_def_def, a_capsule_c)
            check_made(p, made_shape.index1, made_shape.generation, recorded_index1, recorded_generation)
        }
        return true
    }
    if op == dynamics.OP_CREATE_HULL_SHAPE {
        a_body_id_body_id = read_body_id(p)
        a_shape_def_def = read_shape_def(p)
        a_ptr__hull_h = read_geometry(p, shape.SHAPE_HULL) as *HullData
        recorded_index1 = read_int(p)
        recorded_generation = read_int(p)
        if p.ok {
            made_shape = dynamics.create_hull_shape(a_body_id_body_id, &a_shape_def_def, a_ptr__hull_h)
            check_made(p, made_shape.index1, made_shape.generation, recorded_index1, recorded_generation)
        }
        return true
    }
    if op == dynamics.OP_CREATE_TRANSFORMED_HULL_SHAPE {
        a_body_id_body_id = read_body_id(p)
        a_shape_def_def = read_shape_def(p)
        a_ptr__hull_h = read_geometry(p, shape.SHAPE_HULL) as *HullData
        a_transform_transform = read_transform(p)
        a_vec3_scale = read_vec3(p)
        recorded_index1 = read_int(p)
        recorded_generation = read_int(p)
        if p.ok {
            made_shape = dynamics.create_transformed_hull_shape(a_body_id_body_id, &a_shape_def_def, a_ptr__hull_h, a_transform_transform, a_vec3_scale)
            check_made(p, made_shape.index1, made_shape.generation, recorded_index1, recorded_generation)
        }
        return true
    }
    if op == dynamics.OP_CREATE_MESH_SHAPE {
        a_body_id_body_id = read_body_id(p)
        a_shape_def_def = read_shape_def(p)
        a_ptr__mesh_m = read_geometry(p, shape.SHAPE_MESH) as *MeshData
        a_vec3_scale = read_vec3(p)
        recorded_index1 = read_int(p)
        recorded_generation = read_int(p)
        if p.ok {
            made_shape = dynamics.create_mesh_shape(a_body_id_body_id, &a_shape_def_def, a_ptr__mesh_m, a_vec3_scale)
            check_made(p, made_shape.index1, made_shape.generation, recorded_index1, recorded_generation)
        }
        return true
    }
    if op == dynamics.OP_CREATE_HEIGHT_FIELD_SHAPE {
        a_body_id_body_id = read_body_id(p)
        a_shape_def_def = read_shape_def(p)
        a_ptr__height_field_h = read_geometry(p, shape.SHAPE_HEIGHT_FIELD) as *HeightFieldData
        recorded_index1 = read_int(p)
        recorded_generation = read_int(p)
        if p.ok {
            made_shape = dynamics.create_height_field_shape(a_body_id_body_id, &a_shape_def_def, a_ptr__height_field_h)
            check_made(p, made_shape.index1, made_shape.generation, recorded_index1, recorded_generation)
        }
        return true
    }
    if op == dynamics.OP_CREATE_COMPOUND_SHAPE {
        a_body_id_body_id = read_body_id(p)
        a_shape_def_def = read_shape_def(p)
        a_ptr__compound_c = read_geometry(p, shape.SHAPE_COMPOUND) as *CompoundData
        recorded_index1 = read_int(p)
        recorded_generation = read_int(p)
        if p.ok {
            made_shape = dynamics.create_compound_shape(a_body_id_body_id, &a_shape_def_def, a_ptr__compound_c)
            check_made(p, made_shape.index1, made_shape.generation, recorded_index1, recorded_generation)
        }
        return true
    }
    if op == dynamics.OP_DESTROY_SHAPE {
        a_shape_id_id = read_shape_id(p)
        a_bool_update_body_mass = read_bool(p)
        if p.ok { dynamics.destroy_shape(a_shape_id_id, a_bool_update_body_mass) }
        return true
    }
    if op == dynamics.OP_SHAPE_SET_DENSITY {
        a_shape_id_id = read_shape_id(p)
        a_float_density = read_float(p)
        a_bool_update_body_mass = read_bool(p)
        if p.ok { dynamics.shape_set_density(a_shape_id_id, a_float_density, a_bool_update_body_mass) }
        return true
    }
    if op == dynamics.OP_SHAPE_SET_FILTER {
        a_shape_id_id = read_shape_id(p)
        a_filter_filter = read_filter(p)
        if p.ok { dynamics.shape_set_filter(a_shape_id_id, a_filter_filter) }
        return true
    }
    if op == dynamics.OP_SHAPE_SET_SURFACE_MATERIAL {
        a_shape_id_id = read_shape_id(p)
        a_surface_material_m = read_surface_material(p)
        if p.ok { dynamics.shape_set_surface_material(a_shape_id_id, a_surface_material_m) }
        return true
    }
    if op == dynamics.OP_SHAPE_SET_SPHERE {
        a_shape_id_id = read_shape_id(p)
        a_sphere_s = read_sphere(p)
        if p.ok { dynamics.shape_set_sphere(a_shape_id_id, a_sphere_s) }
        return true
    }
    if op == dynamics.OP_SHAPE_SET_CAPSULE {
        a_shape_id_id = read_shape_id(p)
        a_capsule_c = read_capsule(p)
        if p.ok { dynamics.shape_set_capsule(a_shape_id_id, a_capsule_c) }
        return true
    }
    if op == dynamics.OP_SHAPE_SET_HULL {
        a_shape_id_id = read_shape_id(p)
        a_ptr__hull_h = read_geometry(p, shape.SHAPE_HULL) as *HullData
        if p.ok { dynamics.shape_set_hull(a_shape_id_id, a_ptr__hull_h) }
        return true
    }
    if op == dynamics.OP_SHAPE_SET_MESH {
        a_shape_id_id = read_shape_id(p)
        a_ptr__mesh_m = read_geometry(p, shape.SHAPE_MESH) as *MeshData
        a_vec3_scale = read_vec3(p)
        if p.ok { dynamics.shape_set_mesh(a_shape_id_id, a_ptr__mesh_m, a_vec3_scale) }
        return true
    }
    if op == dynamics.OP_SHAPE_SET_FRICTION {
        a_shape_id_id = read_shape_id(p)
        a_float_friction = read_float(p)
        if p.ok { dynamics.shape_set_friction(a_shape_id_id, a_float_friction) }
        return true
    }
    if op == dynamics.OP_SHAPE_SET_RESTITUTION {
        a_shape_id_id = read_shape_id(p)
        a_float_restitution = read_float(p)
        if p.ok { dynamics.shape_set_restitution(a_shape_id_id, a_float_restitution) }
        return true
    }
    if op == dynamics.OP_SHAPE_SET_MESH_MATERIAL {
        a_shape_id_id = read_shape_id(p)
        a_surface_material_m = read_surface_material(p)
        a_int_index = read_int(p)
        if p.ok { dynamics.shape_set_mesh_material(a_shape_id_id, a_surface_material_m, a_int_index) }
        return true
    }
    if op == dynamics.OP_SHAPE_ENABLE_PRE_SOLVE_EVENTS {
        a_shape_id_id = read_shape_id(p)
        a_bool_flag = read_bool(p)
        if p.ok { dynamics.shape_enable_pre_solve_events(a_shape_id_id, a_bool_flag) }
        return true
    }
    if op == dynamics.OP_BODY_ENABLE_HIT_EVENTS {
        a_body_id_id = read_body_id(p)
        a_bool_flag = read_bool(p)
        if p.ok { dynamics.body_enable_hit_events(a_body_id_id, a_bool_flag) }
        return true
    }
    if op == dynamics.OP_BODY_ALLOW_FAST_ROTATION {
        a_body_id_id = read_body_id(p)
        a_bool_flag = read_bool(p)
        if p.ok { dynamics.body_allow_fast_rotation(a_body_id_id, a_bool_flag) }
        return true
    }
    if op == dynamics.OP_BODY_ENABLE_CONTACT_RECYCLING {
        a_body_id_id = read_body_id(p)
        a_bool_flag = read_bool(p)
        if p.ok { dynamics.body_enable_contact_recycling(a_body_id_id, a_bool_flag) }
        return true
    }
    if op == dynamics.OP_BODY_SET_SAFETY_FACTOR {
        a_body_id_id = read_body_id(p)
        a_float_factor = read_float(p)
