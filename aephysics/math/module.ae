// aephysics.math -- the vector math a rigid-body engine is built on.
//
// The functions and tolerances follow Box3D's math_functions (Erin Catto,
// MIT), the reference this engine is measured against, so a test or an
// algorithm written against the reference reads the same here: the names
// are the reference's without its prefix, in snake case
// (b3MakeQuatFromAxisAngle is make_quat_from_axis_angle).
//
// One deliberate difference: Aether's float is a C double, so the whole
// port is double precision. Box3D keeps floats and adds double world
// positions for large worlds (b3Pos, b3WorldTransform); here a position is
// a Vec3 and a world transform a Transform, and the narrowing helpers
// (round_down_float, round_up_float, to_pos, to_vec3) are identities kept
// for the callers that read like the original. The approximate atan2,
// cosine and sine are ported as they are, since they exist for
// cross-platform determinism, not speed: a game's replay has to agree on
// every platform, and libm's do not.
//
// Exceptions and assertions: Box3D asserts on bad input in debug builds.
// Here the same conditions are the validity functions (is_valid_vec3,
// is_normalized, ...) a caller checks where it matters, and the functions
// return what the original returns on the degenerate case.
import std.string

exports (
    Vec2, Vec3, CosSin, Quat, Transform, Matrix2, Matrix3, AABB, Plane, SegmentDistanceResult,
    PI, TWO_PI, PI_OVER_TWO, PI_OVER_FOUR, SQRT3, DEG_TO_RAD, RAD_TO_DEG, MIN_SCALE,
    EPSILON, TINY, MAX_FLOAT, HUGE,
    vec2, vec3, quat, quat_vs, qv, transform, matrix3, aabb, plane,
    vec3_zero, vec3_one, vec3_axis_x, vec3_axis_y, vec3_axis_z,
    quat_identity, transform_identity, mat3_zero, mat3_identity, aabb_empty,
    min_int, max_int, clamp_int, abs_float, min_float, max_float, clamp_float, lerp_float,
    sqrt_float, atan2_approx, compute_cos_sin, sin_approx, cos_approx, unwind_angle,
    add, sub, mul, neg, dot, length, length_squared, distance, distance_squared,
    normalize, get_length_and_normalize, perp, is_normalized, mul_add, mul_sub, mul_sv,
    cross, lerp, blend2, blend3, skew, delta_quat_to_rotation, integrate_rotation, modified_cross, abs_vec3, sign, min_vec3, max_vec3, clamp_vec3, safe_scale, scalar_triple_product,
    is_normalized_quat, rotate_vector, inv_rotate_vector, dot_quat, mul_quat, inv_mul_quat,
    conjugate, negate_quat, normalize_quat, make_quat_from_axis_angle, get_axis_angle,
    get_quat_angle, make_quat_from_matrix, compute_quat_between_unit_vectors,
    get_twist_angle, get_swing_angle, nlerp,
    mul_transforms, inv_mul_transforms, invert_transform, transform_point, inv_transform_point,
    to_pos, to_vec3, round_down_float, round_up_float, sub_pos, offset_pos, lerp_position,
    transform_world_point, inv_transform_world_point, mul_world_transforms,
    inv_mul_world_transforms, to_relative_transform, make_world_transform, offset_aabb,
    det, mul_mv, negate_mat3, add_mm, sub_mm, mul_sm, mul_mm, transpose, invert_matrix,
    matrix2, dot2, add2, sub2, mul_sv2, mul_add2, mul_mv2, det2, invert2, solve2,
    solve3, invert_t, abs_matrix3, make_matrix_from_quat, make_diagonal_matrix, steiner,
    sphere_inertia, cylinder_inertia, box_inertia,
    make_aabb, aabb_contains, aabb_area, aabb_center, aabb_extents, aabb_union, aabb_inflate,
    aabb_overlaps, aabb_transform, closest_point_to_aabb, ray_cast_aabb, aabb_add_point,
    LINEAR_SLOP, max_element, max_element_index, make_plane_from_normal_and_point,
    make_plane_from_points, make_normal_from_points, transform_plane, plane_separation,
    signed_volume, rotate_inertia, transform_inertia, distance_squared_2,
    point_to_segment_distance, line_distance, segment_distance,
    is_valid_float, is_valid_vec3, is_valid_quat, is_valid_transform, is_valid_matrix3,
    is_valid_aabb, is_bounded_aabb, is_sane_aabb, is_valid_plane, is_valid_position,
    is_valid_world_transform,
    vec3_text, quat_text
)

extern sqrt(x: float) -> float
extern remainder(x: float, y: float) -> float

const PI = 3.14159265359
const TWO_PI = 6.28318530718
const PI_OVER_TWO = 1.570796326795
const PI_OVER_FOUR = 0.7853981633975
const SQRT3 = 1.732050808
const DEG_TO_RAD = 0.01745329251
const RAD_TO_DEG = 57.2957795131
// Minimum scale used for scaling collision meshes, etc.
const MIN_SCALE = 0.01
// Box3D's tolerances are written against float's epsilon and smallest
// normal; they are design tolerances, kept as numbers rather than retyped.
// (Aether has no exponent literals: 1.1920929e-7 is written out.)
const EPSILON = 0.00000011920929
const TINY = 0.0000000000000000000000000000000000000117549435
const MAX_FLOAT = 340282346600000000000000000000000000000.0
// Reasonable bound on a world coordinate (B3_HUGE with a metre as the
// length unit; Box3D scales it by the length units per metre).
const HUGE = 100000.0
// The linear slop: the collision margin, 5 mm, with the length unit a metre.
const LINEAR_SLOP = 0.005

struct Vec2 {
    x: float
    y: float
}

// A 2x2 matrix by columns.
struct Matrix2 {
    cx: Vec2
    cy: Vec2
}

struct Vec3 {
    x: float
    y: float
    z: float
}

// Cosine and sine pair, from the deterministic approximation.
struct CosSin {
    cosine: float
    sine: float
}

// A quaternion: x, y, z the vector part and w the scalar, the layout every
// engine shares (ae3d.core defines the same Quat); the maths reads it
// through qv and quat_vs, the reference's {v, s}.
struct Quat {
    x: float
    y: float
    z: float
    w: float
}

// A rigid transform: a position and a rotation.
struct Transform {
    p: Vec3
    q: Quat
}

// A 3x3 matrix, by columns.
struct Matrix3 {
    cx: Vec3
    cy: Vec3
    cz: Vec3
}

// An axis-aligned bounding box.
struct AABB {
    lower: Vec3
    upper: Vec3
}

// A plane: separation = dot(normal, point) - offset.
struct Plane {
    normal: Vec3
    offset: float
}

// The closest points between two segments or infinite lines.
struct SegmentDistanceResult {
    point1: Vec3
    fraction1: float
    point2: Vec3
    fraction2: float
}

vec2(x: float, y: float) -> Vec2 { return Vec2 { x: x, y: y } }
vec3(x: float, y: float, z: float) -> Vec3 { return Vec3 { x: x, y: y, z: z } }
quat(x: float, y: float, z: float, w: float) -> Quat { return Quat { x: x, y: y, z: z, w: w } }
// A quaternion from its vector and scalar parts, and the vector part back:
// the maths below is written in those terms (the reference's b3Quat {v, s}).
quat_vs(v: Vec3, s: float) -> Quat { return Quat { x: v.x, y: v.y, z: v.z, w: s } }
qv(q: Quat) -> Vec3 { return Vec3 { x: q.x, y: q.y, z: q.z } }
transform(p: Vec3, q: Quat) -> Transform { return Transform { p: p, q: q } }
matrix3(cx: Vec3, cy: Vec3, cz: Vec3) -> Matrix3 { return Matrix3 { cx: cx, cy: cy, cz: cz } }
aabb(lower: Vec3, upper: Vec3) -> AABB { return AABB { lower: lower, upper: upper } }
plane(normal: Vec3, offset: float) -> Plane { return Plane { normal: normal, offset: offset } }

vec3_zero() -> Vec3 { return Vec3 { x: 0.0, y: 0.0, z: 0.0 } }
vec3_one() -> Vec3 { return Vec3 { x: 1.0, y: 1.0, z: 1.0 } }
vec3_axis_x() -> Vec3 { return Vec3 { x: 1.0, y: 0.0, z: 0.0 } }
vec3_axis_y() -> Vec3 { return Vec3 { x: 0.0, y: 1.0, z: 0.0 } }
vec3_axis_z() -> Vec3 { return Vec3 { x: 0.0, y: 0.0, z: 1.0 } }
quat_identity() -> Quat { return Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 } }
transform_identity() -> Transform { return Transform { p: vec3_zero(), q: quat_identity() } }
mat3_zero() -> Matrix3 { return Matrix3 { cx: vec3_zero(), cy: vec3_zero(), cz: vec3_zero() } }
mat3_identity() -> Matrix3 { return Matrix3 { cx: vec3_axis_x(), cy: vec3_axis_y(), cz: vec3_axis_z() } }
// The box no point is in: a union with it is the other box.
aabb_empty() -> AABB {
    return AABB { lower: Vec3 { x: MAX_FLOAT, y: MAX_FLOAT, z: MAX_FLOAT },
                  upper: Vec3 { x: 0.0 - MAX_FLOAT, y: 0.0 - MAX_FLOAT, z: 0.0 - MAX_FLOAT } }
}

// --- scalars ---------------------------------------------------------------

min_int(a: int, b: int) -> int {
    if a < b { return a }
    return b
}
max_int(a: int, b: int) -> int {
    if a > b { return a }
    return b
}
clamp_int(a: int, lower: int, upper: int) -> int {
    if a < lower { return lower }
    if upper < a { return upper }
    return a
}
abs_float(a: float) -> float {
    if a < 0.0 { return 0.0 - a }
    return a
}
min_float(a: float, b: float) -> float {
    if a < b { return a }
    return b
}
max_float(a: float, b: float) -> float {
    if a > b { return a }
    return b
}
clamp_float(a: float, lower: float, upper: float) -> float {
    if a < lower { return lower }
    if upper < a { return upper }
    return a
}
lerp_float(a: float, b: float, alpha: float) -> float { return (1.0 - alpha) * a + alpha * b }
sqrt_float(a: float) -> float { return sqrt(a) }

// An approximate arctangent in [-pi, pi], hand coded for cross-platform
// determinism (the standard library's is not). Accurate to about 0.0023
// degrees. https://stackoverflow.com/questions/46210708
atan2_approx(y: float, x: float) -> float {
    // (0, 0) answers 0 like atan2f, rather than NaN.
    if x == 0.0 && y == 0.0 { return 0.0 }
    ax = abs_float(x)
    ay = abs_float(y)
    mx = max_float(ay, ax)
    mn = min_float(ay, ax)
    a = mn / mx

    // Minimax polynomial approximation to atan(a) on [0,1]
    s = a * a
    c = s * a
    q = s * s
    r = 0.024840285 * q + 0.18681418
    t = 0.0 - 0.094097948 * q - 0.33213072
    r = r * s + t
    r = r * c + a

    // Map to the full circle. The original folds with float pi, which is
    // also its B3_PI; here the fold uses PI itself, so the result never
    // lands past the PI the callers compare against.
    if ay > ax { r = PI_OVER_TWO - r }
    if x < 0.0 { r = PI - r }
    if y < 0.0 { r = 0.0 - r }
    return r
}

// Approximate cosine and sine for determinism (Bhaskara's formulas,
// normalised as a pair). Accurate to about 0.1 degrees.
compute_cos_sin(radians: float) -> CosSin {
    x = unwind_angle(radians)
    pi2 = PI * PI

    // cosine needs the angle in [-pi/2, pi/2]
    c = 0.0
    if x < 0.0 - 0.5 * PI {
        y = x + PI
        y2 = y * y
        c = 0.0 - (pi2 - 4.0 * y2) / (pi2 + y2)
    } else if x > 0.5 * PI {
        y = x - PI
        y2 = y * y
        c = 0.0 - (pi2 - 4.0 * y2) / (pi2 + y2)
    } else {
        y2 = x * x
        c = (pi2 - 4.0 * y2) / (pi2 + y2)
    }

    // sine needs the angle in [0, pi]
    s = 0.0
    if x < 0.0 {
        y = x + PI
        s = 0.0 - 16.0 * y * (PI - y) / (5.0 * pi2 - 4.0 * y * (PI - y))
    } else {
        s = 16.0 * x * (PI - x) / (5.0 * pi2 - 4.0 * x * (PI - x))
    }

    mag = sqrt(s * s + c * c)
    inv_mag = 0.0
    if mag > 0.0 { inv_mag = 1.0 / mag }
    return CosSin { cosine: c * inv_mag, sine: s * inv_mag }
}

sin_approx(radians: float) -> float { return compute_cos_sin(radians).sine }
cos_approx(radians: float) -> float { return compute_cos_sin(radians).cosine }

// Any angle into [-pi, pi].
unwind_angle(radians: float) -> float { return remainder(radians, 2.0 * PI) }

// --- vectors ---------------------------------------------------------------

add(a: Vec3, b: Vec3) -> Vec3 { return Vec3 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z } }
sub(a: Vec3, b: Vec3) -> Vec3 { return Vec3 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z } }
// Component-wise product.
mul(a: Vec3, b: Vec3) -> Vec3 { return Vec3 { x: a.x * b.x, y: a.y * b.y, z: a.z * b.z } }
neg(a: Vec3) -> Vec3 { return Vec3 { x: 0.0 - a.x, y: 0.0 - a.y, z: 0.0 - a.z } }
dot(a: Vec3, b: Vec3) -> float { return a.x * b.x + a.y * b.y + a.z * b.z }
length(v: Vec3) -> float { return sqrt(dot(v, v)) }
length_squared(a: Vec3) -> float { return a.x * a.x + a.y * a.y + a.z * a.z }
distance(a: Vec3, b: Vec3) -> float { return length(sub(b, a)) }
distance_squared(a: Vec3, b: Vec3) -> float { return length_squared(sub(b, a)) }

// A unit vector, or zero for an input too small to have a direction.
normalize(a: Vec3) -> Vec3 {
    ls = a.x * a.x + a.y * a.y + a.z * a.z
    if ls > 1000.0 * TINY {
        s = 1.0 / sqrt(ls)
        return Vec3 { x: s * a.x, y: s * a.y, z: s * a.z }
    }
    return vec3_zero()
}

// The unit vector and, in `length_out[0]`, the length; zero and zero for
// an input too small.
get_length_and_normalize(length_out: float[], a: Vec3) -> Vec3 {
    ls = a.x * a.x + a.y * a.y + a.z * a.z
    if ls > 1000.0 * TINY {
        l = sqrt(ls)
        length_out[0] = l
        s = 1.0 / l
        return Vec3 { x: s * a.x, y: s * a.y, z: s * a.z }
    }
    length_out[0] = 0.0
    return vec3_zero()
}

// A unit vector perpendicular to the supplied one. A unit vector has at
// least one component of 0.57735 or more, so one of the two choices is
// well away from zero.
perp(a: Vec3) -> Vec3 {
    if a.x < 0.0 - 0.5 || 0.5 < a.x {
        return normalize(Vec3 { x: a.y, y: 0.0 - a.x, z: 0.0 })
    }
    return normalize(Vec3 { x: 0.0, y: a.z, z: 0.0 - a.y })
}

is_normalized(a: Vec3) -> bool {
    aa = dot(a, a)
    return abs_float(1.0 - aa) < 100.0 * EPSILON
}

// a + s * b
mul_add(a: Vec3, s: float, b: Vec3) -> Vec3 { return Vec3 { x: a.x + s * b.x, y: a.y + s * b.y, z: a.z + s * b.z } }
// a - s * b
mul_sub(a: Vec3, s: float, b: Vec3) -> Vec3 { return Vec3 { x: a.x - s * b.x, y: a.y - s * b.y, z: a.z - s * b.z } }
// s * a
mul_sv(s: float, a: Vec3) -> Vec3 { return Vec3 { x: s * a.x, y: s * a.y, z: s * a.z } }

cross(a: Vec3, b: Vec3) -> Vec3 {
    return Vec3 { x: a.y * b.z - a.z * b.y, y: a.z * b.x - a.x * b.z, z: a.x * b.y - a.y * b.x }
}

// dot(a, cross(b, c))
scalar_triple_product(a: Vec3, b: Vec3, c: Vec3) -> float { return dot(a, cross(b, c)) }

lerp(a: Vec3, b: Vec3, alpha: float) -> Vec3 {
    return Vec3 { x: (1.0 - alpha) * a.x + alpha * b.x,
                  y: (1.0 - alpha) * a.y + alpha * b.y,
                  z: (1.0 - alpha) * a.z + alpha * b.z }
}

// s * a + t * b
blend2(s: float, a: Vec3, t: float, b: Vec3) -> Vec3 {
    return Vec3 { x: s * a.x + t * b.x, y: s * a.y + t * b.y, z: s * a.z + t * b.z }
}

blend3(s: float, a: Vec3, t: float, b: Vec3, u: float, c: Vec3) -> Vec3 {
    return Vec3 { x: s * a.x + t * b.x + u * c.x, y: s * a.y + t * b.y + u * c.y, z: s * a.z + t * b.z + u * c.z }
}

// The cross product with every term positive: a bound on the velocity of
// a body's farthest point from the magnitudes of its spin and extent.
modified_cross(a: Vec3, b: Vec3) -> Vec3 {
    return Vec3 { x: a.y * b.z + a.z * b.y, y: a.z * b.x + a.x * b.z, z: a.x * b.y + a.y * b.x }
}

// The rotation advanced by a small rotation vector (a quaternion
// derivative step, renormalised).
integrate_rotation(q1: Quat, delta_rotation: Vec3) -> Quat {
    qd = mul_quat(quat_vs(mul_sv(0.5, delta_rotation), 0.0), q1)
    return normalize_quat(quat_vs(add(qv(q1), qv(qd)), qd.w + q1.w))
}

// The matrix of the cross product: skew(v) * a = cross(v, a).
skew(v: Vec3) -> Matrix3 {
    return Matrix3 { cx: Vec3 { x: 0.0, y: v.z, z: 0.0 - v.y }, cy: Vec3 { x: 0.0 - v.z, y: 0.0, z: v.x }, cz: Vec3 { x: v.y, y: 0.0 - v.x, z: 0.0 } }
}

// The small rotation taking q to the target, as a vector (twice the
// vector part of the difference times the conjugate), the polarity
// corrected so the shorter way is taken.
delta_quat_to_rotation(q: Quat, target: Quat) -> Vec3 {
    s = q
    if dot_quat(q, target) < 0.0 { s = negate_quat(q) }
    diff = quat_vs(sub(qv(target), qv(s)), target.w - s.w)
    product = mul_quat(diff, conjugate(s))
    return mul_sv(2.0, qv(product))
}

abs_vec3(a: Vec3) -> Vec3 { return Vec3 { x: abs_float(a.x), y: abs_float(a.y), z: abs_float(a.z) } }

// Component-wise -1 or 1 (1 for zero).
sign(a: Vec3) -> Vec3 {
    sx = 0.0 - 1.0
    sy = 0.0 - 1.0
    sz = 0.0 - 1.0
    if a.x >= 0.0 { sx = 1.0 }
    if a.y >= 0.0 { sy = 1.0 }
    if a.z >= 0.0 { sz = 1.0 }
    return Vec3 { x: sx, y: sy, z: sz }
}

min_vec3(a: Vec3, b: Vec3) -> Vec3 { return Vec3 { x: min_float(a.x, b.x), y: min_float(a.y, b.y), z: min_float(a.z, b.z) } }
max_vec3(a: Vec3, b: Vec3) -> Vec3 { return Vec3 { x: max_float(a.x, b.x), y: max_float(a.y, b.y), z: max_float(a.z, b.z) } }
clamp_vec3(a: Vec3, lower: Vec3, upper: Vec3) -> Vec3 {
    return Vec3 { x: clamp_float(a.x, lower.x, upper.x), y: clamp_float(a.y, lower.y, upper.y), z: clamp_float(a.z, lower.z, upper.z) }
}

// A scale safe for scaling collision: negative allowed, never near zero.
safe_scale(a: Vec3) -> Vec3 {
    min_scale = Vec3 { x: MIN_SCALE, y: MIN_SCALE, z: MIN_SCALE }
    return mul(sign(a), max_vec3(abs_vec3(a), min_scale))
}

// --- quaternions -----------------------------------------------------------

is_normalized_quat(q: Quat) -> bool {
    qq = q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w
    return 1.0 - 20.0 * EPSILON < qq && qq < 1.0 + 20.0 * EPSILON
}

// v + 2 * cross(qv(q), cross(qv(q), v) + q.w * v)
rotate_vector(q: Quat, v: Vec3) -> Vec3 {
    t1 = cross(qv(q), v)
    t2 = mul_add(t1, q.w, v)
    t3 = cross(qv(q), t2)
    return mul_add(v, 2.0, t3)
}

// v + 2 * cross(qv(q), cross(qv(q), v) - q.w * v)
inv_rotate_vector(q: Quat, v: Vec3) -> Vec3 {
    t1 = cross(qv(q), v)
    t2 = mul_sub(t1, q.w, v)
    t3 = cross(qv(q), t2)
    return mul_add(v, 2.0, t3)
}

// Useful for polarity tests.
dot_quat(a: Quat, b: Quat) -> float { return a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w }

mul_quat(q1: Quat, q2: Quat) -> Quat {
    t1 = cross(qv(q1), qv(q2))
    t2 = mul_add(t1, q1.w, qv(q2))
    t3 = mul_add(t2, q2.w, qv(q1))
    return quat_vs(t3, q1.w * q2.w - dot(qv(q1), qv(q2)))
}

// inv(q1) * q2
inv_mul_quat(q1: Quat, q2: Quat) -> Quat {
    t1 = cross(qv(q2), qv(q1))
    t2 = mul_add(t1, q1.w, qv(q2))
    t3 = mul_sub(t2, q2.w, qv(q1))
    return quat_vs(t3, q1.w * q2.w + dot(qv(q1), qv(q2)))
}

// The cheap inverse.
conjugate(q: Quat) -> Quat { return quat_vs(neg(qv(q)), q.w) }
negate_quat(q: Quat) -> Quat { return quat_vs(neg(qv(q)), 0.0 - q.w) }

normalize_quat(q: Quat) -> Quat {
    ls = dot_quat(q, q)
    if ls > 1000.0 * TINY {
        s = 1.0 / sqrt(ls)
        return quat_vs(Vec3 { x: s * q.x, y: s * q.y, z: s * q.z }, s * q.w)
    }
    return quat_identity()
}

// The rotation about a unit axis by an angle.
make_quat_from_axis_angle(axis: Vec3, radians: float) -> Quat {
    cs = compute_cos_sin(0.5 * radians)
    return quat_vs(Vec3 { x: cs.sine * axis.x, y: cs.sine * axis.y, z: cs.sine * axis.z }, cs.cosine)
}

// The axis of a unit quaternion, and in `radians_out[0]` its angle; a zero
// axis for no rotation.
get_axis_angle(radians_out: float[], q: Quat) -> Vec3 {
    l = sqrt(q.x * q.x + q.y * q.y + q.z * q.z)
    radians_out[0] = 2.0 * atan2_approx(l, q.w)
    if l > 0.0 {
        inv = 1.0 / l
        return Vec3 { x: inv * q.x, y: inv * q.y, z: inv * q.z }
    }
    return vec3_zero()
}

get_quat_angle(q: Quat) -> float {
    l = sqrt(q.x * q.x + q.y * q.y + q.z * q.z)
    return 2.0 * atan2_approx(l, q.w)
}

// A quaternion from a rotation matrix, normalised at the end, which is
// what keeps the four branches accurate.
make_quat_from_matrix(m: Matrix3) -> Quat {
    c1 = m.cx
    c2 = m.cy
    c3 = m.cz
    trace = c1.x + c2.y + c3.z
    q = quat_identity()
    if trace >= 0.0 {
        q = quat_vs(Vec3 { x: c2.z - c3.y, y: c3.x - c1.z, z: c1.y - c2.x }, trace + 1.0)
    } else if c1.x > c2.y && c1.x > c3.z {
        q = quat_vs(Vec3 { x: c1.x - c2.y - c3.z + 1.0, y: c2.x + c1.y, z: c3.x + c1.z }, c2.z - c3.y)
    } else if c2.y > c3.z {
        q = quat_vs(Vec3 { x: c1.y + c2.x, y: c2.y - c3.z - c1.x + 1.0, z: c3.y + c2.z }, c3.x - c1.z)
    } else {
        q = quat_vs(Vec3 { x: c1.z + c3.x, y: c2.z + c3.y, z: c3.z - c1.x - c2.y + 1.0 }, c1.y - c2.x)
    }
    return normalize_quat(q)
}

// The rotation taking unit vector v1 to unit vector v2; for anti-parallel
// vectors, a half turn about a perpendicular.
compute_quat_between_unit_vectors(v1: Vec3, v2: Vec3) -> Quat {
    m = lerp(v1, v2, 0.5)
    tolerance = 100.0 * EPSILON
    out = quat_identity()
    if length_squared(m) > tolerance * tolerance {
        out = quat_vs(cross(v1, m), dot(v1, m))
    } else if abs_float(v1.x) > 0.5 {
        out = quat_vs(Vec3 { x: v1.y, y: 0.0 - v1.x, z: 0.0 }, 0.0)
    } else {
        out = quat_vs(Vec3 { x: 0.0, y: v1.z, z: 0.0 - v1.y }, 0.0)
    }
    return normalize_quat(out)
}

// Twist about the z axis, for twist and revolute limits. The polarity is
// accounted for, so the angle stays in [-pi, pi] without unwinding.
get_twist_angle(q: Quat) -> float {
    twist = 0.0
    if q.w < 0.0 { twist = atan2_approx(0.0 - q.z, 0.0 - q.w) } else { twist = atan2_approx(q.z, q.w) }
    return 2.0 * twist
}

// Swing angle for a cone limit, in [0, pi]; polarity cannot matter since
// every term is squared.
get_swing_angle(q: Quat) -> float {
    x = sqrt(q.z * q.z + q.w * q.w)
    y = sqrt(q.x * q.x + q.y * q.y)
    return 2.0 * atan2_approx(y, x)
}

// Linear interpolation of two quaternions, normalised, along the shorter
// arc.
nlerp(q1: Quat, q2: Quat, alpha: float) -> Quat {
    a = q1
    if dot_quat(q1, q2) < 0.0 { a = negate_quat(q1) }
    return normalize_quat(quat_vs(lerp(qv(a), qv(q2), alpha), (1.0 - alpha) * a.w + alpha * q2.w))
}

// --- transforms ------------------------------------------------------------

// a * b: applied to a point in frame B, first into frame A, then the world.
mul_transforms(a: Transform, b: Transform) -> Transform {
    return Transform { p: add(rotate_vector(a.q, b.p), a.p), q: mul_quat(a.q, b.q) }
}

// The transform taking a point in frame B to a point in frame A, both
// frames in the world.
inv_mul_transforms(a: Transform, b: Transform) -> Transform {
    return Transform { p: inv_rotate_vector(a.q, sub(b.p, a.p)), q: inv_mul_quat(a.q, b.q) }
}

invert_transform(t: Transform) -> Transform {
    return Transform { p: inv_rotate_vector(t.q, neg(t.p)), q: conjugate(t.q) }
}

transform_point(t: Transform, v: Vec3) -> Vec3 { return add(rotate_vector(t.q, v), t.p) }
inv_transform_point(t: Transform, v: Vec3) -> Vec3 { return inv_rotate_vector(t.q, sub(v, t.p)) }

// The world-position boundary. Box3D crosses from double world positions
// to a float interior here; in a double port these are identities, kept so
// the callers read as the original.
to_pos(v: Vec3) -> Vec3 { return v }
to_vec3(p: Vec3) -> Vec3 { return p }
round_down_float(x: float) -> float { return x }
round_up_float(x: float) -> float { return x }
sub_pos(a: Vec3, b: Vec3) -> Vec3 { return sub(a, b) }
offset_pos(p: Vec3, d: Vec3) -> Vec3 { return add(p, d) }
lerp_position(a: Vec3, b: Vec3, t: float) -> Vec3 { return lerp(a, b, t) }
transform_world_point(t: Transform, p: Vec3) -> Vec3 { return transform_point(t, p) }
inv_transform_world_point(t: Transform, p: Vec3) -> Vec3 { return inv_transform_point(t, p) }
mul_world_transforms(a: Transform, b: Transform) -> Transform { return mul_transforms(a, b) }
inv_mul_world_transforms(a: Transform, b: Transform) -> Transform { return inv_mul_transforms(a, b) }
to_relative_transform(t: Transform, base: Vec3) -> Transform { return Transform { p: sub(t.p, base), q: t.q } }
make_world_transform(t: Transform) -> Transform { return t }
offset_aabb(local_box: AABB, origin: Vec3) -> AABB {
    return AABB { lower: add(origin, local_box.lower), upper: add(origin, local_box.upper) }
}

// --- matrices --------------------------------------------------------------

det(m: Matrix3) -> float { return dot(m.cx, cross(m.cy, m.cz)) }

// m * a, a as a column.
mul_mv(m: Matrix3, a: Vec3) -> Vec3 {
    return Vec3 { x: m.cx.x * a.x + m.cy.x * a.y + m.cz.x * a.z,
                  y: m.cx.y * a.x + m.cy.y * a.y + m.cz.y * a.z,
                  z: m.cx.z * a.x + m.cy.z * a.y + m.cz.z * a.z }
}

negate_mat3(a: Matrix3) -> Matrix3 { return Matrix3 { cx: neg(a.cx), cy: neg(a.cy), cz: neg(a.cz) } }
// --- 2D -----------------------------------------------------------------------------------------------

matrix2(cx: Vec2, cy: Vec2) -> Matrix2 { return Matrix2 { cx: cx, cy: cy } }
dot2(a: Vec2, b: Vec2) -> float { return a.x * b.x + a.y * b.y }
add2(a: Vec2, b: Vec2) -> Vec2 { return Vec2 { x: a.x + b.x, y: a.y + b.y } }
sub2(a: Vec2, b: Vec2) -> Vec2 { return Vec2 { x: a.x - b.x, y: a.y - b.y } }
mul_sv2(s: float, a: Vec2) -> Vec2 { return Vec2 { x: s * a.x, y: s * a.y } }
mul_add2(a: Vec2, s: float, b: Vec2) -> Vec2 { return Vec2 { x: a.x + s * b.x, y: a.y + s * b.y } }
mul_mv2(m: Matrix2, a: Vec2) -> Vec2 { return Vec2 { x: m.cx.x * a.x + m.cy.x * a.y, y: m.cx.y * a.x + m.cy.y * a.y } }
det2(m: Matrix2) -> float { return m.cx.x * m.cy.y - m.cx.y * m.cy.x }

// The inverse, or zero when singular.
invert2(m: Matrix2) -> Matrix2 {
    d = det2(m)
    if abs_float(d) > 1000.0 * TINY {
        inv = 1.0 / d
        return Matrix2 { cx: Vec2 { x: inv * m.cy.y, y: 0.0 - inv * m.cx.y }, cy: Vec2 { x: 0.0 - inv * m.cy.x, y: inv * m.cx.x } }
    }
    return Matrix2 { cx: Vec2 { x: 0.0, y: 0.0 }, cy: Vec2 { x: 0.0, y: 0.0 } }
}

// m x = b for a positive semi-definite m; zero when singular.
solve2(m: Matrix2, b: Vec2) -> Vec2 {
    d = det2(m)
    if d > 1000.0 * TINY {
        inv = 1.0 / d
        return Vec2 { x: inv * m.cy.y * b.x - inv * m.cy.x * b.y, y: 0.0 - inv * m.cx.y * b.x + inv * m.cx.x * b.y }
    }
    return Vec2 { x: 0.0, y: 0.0 }
}

add_mm(a: Matrix3, b: Matrix3) -> Matrix3 { return Matrix3 { cx: add(a.cx, b.cx), cy: add(a.cy, b.cy), cz: add(a.cz, b.cz) } }
sub_mm(a: Matrix3, b: Matrix3) -> Matrix3 { return Matrix3 { cx: sub(a.cx, b.cx), cy: sub(a.cy, b.cy), cz: sub(a.cz, b.cz) } }
mul_sm(s: float, a: Matrix3) -> Matrix3 { return Matrix3 { cx: mul_sv(s, a.cx), cy: mul_sv(s, a.cy), cz: mul_sv(s, a.cz) } }
// a * b
mul_mm(a: Matrix3, b: Matrix3) -> Matrix3 { return Matrix3 { cx: mul_mv(a, b.cx), cy: mul_mv(a, b.cy), cz: mul_mv(a, b.cz) } }

transpose(m: Matrix3) -> Matrix3 {
    return Matrix3 { cx: Vec3 { x: m.cx.x, y: m.cy.x, z: m.cz.x },
                     cy: Vec3 { x: m.cx.y, y: m.cy.y, z: m.cz.y },
                     cz: Vec3 { x: m.cx.z, y: m.cy.z, z: m.cz.z } }
}

// The general inverse; zero for a singular matrix.
invert_matrix(m: Matrix3) -> Matrix3 {
    d = det(m)
    if abs_float(d) > 1000.0 * TINY {
        inv = 1.0 / d
        out = Matrix3 { cx: mul_sv(inv, cross(m.cy, m.cz)), cy: mul_sv(inv, cross(m.cz, m.cx)), cz: mul_sv(inv, cross(m.cx, m.cy)) }
        return transpose(out)
    }
    return mat3_zero()
}

// inv(m) * a, without forming the inverse; zero for a singular matrix.
solve3(m: Matrix3, a: Vec3) -> Vec3 {
    d = det(m)
    if abs_float(d) > 1000.0 * TINY {
        inv = 1.0 / d
        sx = cross(m.cy, m.cz)
        sy = cross(m.cz, m.cx)
        sz = cross(m.cx, m.cy)
        return Vec3 { x: inv * dot(sx, a), y: inv * dot(sy, a), z: inv * dot(sz, a) }
    }
    return vec3_zero()
}

// The inverse transposed; zero for a singular matrix.
invert_t(m: Matrix3) -> Matrix3 {
    d = det(m)
    if abs_float(d) > 1000.0 * TINY {
        inv = 1.0 / d
        return Matrix3 { cx: mul_sv(inv, cross(m.cy, m.cz)), cy: mul_sv(inv, cross(m.cz, m.cx)), cz: mul_sv(inv, cross(m.cx, m.cy)) }
    }
    return mat3_zero()
}

abs_matrix3(m: Matrix3) -> Matrix3 { return Matrix3 { cx: abs_vec3(m.cx), cy: abs_vec3(m.cy), cz: abs_vec3(m.cz) } }

// The rotation matrix of a unit quaternion, for rotating many vectors.
make_matrix_from_quat(q: Quat) -> Matrix3 {
    xx = q.x * q.x
    yy = q.y * q.y
    zz = q.z * q.z
    xy = q.x * q.y
    xz = q.x * q.z
    xw = q.x * q.w
    yz = q.y * q.z
    yw = q.y * q.w
    zw = q.z * q.w
    return Matrix3 { cx: Vec3 { x: 1.0 - 2.0 * (yy + zz), y: 2.0 * (xy + zw), z: 2.0 * (xz - yw) },
                     cy: Vec3 { x: 2.0 * (xy - zw), y: 1.0 - 2.0 * (xx + zz), z: 2.0 * (yz + xw) },
                     cz: Vec3 { x: 2.0 * (xz + yw), y: 2.0 * (yz - xw), z: 1.0 - 2.0 * (xx + yy) } }
}

make_diagonal_matrix(a: float, b: float, c: float) -> Matrix3 {
    return Matrix3 { cx: Vec3 { x: a, y: 0.0, z: 0.0 }, cy: Vec3 { x: 0.0, y: b, z: 0.0 }, cz: Vec3 { x: 0.0, y: 0.0, z: c } }
}

// The inertia of a point mass at an offset (the parallel axis theorem):
// Io = Ic + steiner, Ic = Io - steiner.
steiner(mass: float, origin: Vec3) -> Matrix3 {
    ixx = mass * (origin.y * origin.y + origin.z * origin.z)
    iyy = mass * (origin.x * origin.x + origin.z * origin.z)
    izz = mass * (origin.x * origin.x + origin.y * origin.y)
    ixy = 0.0 - mass * origin.x * origin.y
    ixz = 0.0 - mass * origin.x * origin.z
    iyz = 0.0 - mass * origin.y * origin.z
    return Matrix3 { cx: Vec3 { x: ixx, y: ixy, z: ixz }, cy: Vec3 { x: ixy, y: iyy, z: iyz }, cz: Vec3 { x: ixz, y: iyz, z: izz } }
}

sphere_inertia(mass: float, radius: float) -> Matrix3 {
    i = 0.4 * mass * radius * radius
    return make_diagonal_matrix(i, i, i)
}

// A cylinder along y.
cylinder_inertia(mass: float, radius: float, height: float) -> Matrix3 {
    ixx = mass * (3.0 * radius * radius + height * height) / 12.0
    iyy = 0.5 * mass * radius * radius
    return make_diagonal_matrix(ixx, iyy, ixx)
}

box_inertia(mass: float, lower: Vec3, upper: Vec3) -> Matrix3 {
    d = sub(upper, lower)
    ixx = mass * (d.y * d.y + d.z * d.z) / 12.0
    iyy = mass * (d.x * d.x + d.z * d.z) / 12.0
    izz = mass * (d.x * d.x + d.y * d.y) / 12.0
    return make_diagonal_matrix(ixx, iyy, izz)
}

// --- bounding boxes --------------------------------------------------------

// The box of a point cloud (`points` packed xyz, `count` of them), grown by
// a radius.
make_aabb(points: float[], count: int, radius: float) -> AABB {
    lower = Vec3 { x: points[0], y: points[1], z: points[2] }
    upper = lower
    i = 1
    while i < count {
        p = Vec3 { x: points[i * 3], y: points[i * 3 + 1], z: points[i * 3 + 2] }
        lower = min_vec3(lower, p)
        upper = max_vec3(upper, p)
        i = i + 1
    }
    r = Vec3 { x: radius, y: radius, z: radius }
    return AABB { lower: sub(lower, r), upper: add(upper, r) }
}

// Does a fully contain b?
aabb_contains(a: AABB, b: AABB) -> bool {
    if a.lower.x > b.lower.x || b.upper.x > a.upper.x { return false }
    if a.lower.y > b.lower.y || b.upper.y > a.upper.y { return false }
    if a.lower.z > b.lower.z || b.upper.z > a.upper.z { return false }
    return true
}

// The surface area, what the dynamic tree's cost is measured in.
aabb_area(a: AABB) -> float {
    d = sub(a.upper, a.lower)
    return 2.0 * (d.x * d.y + d.y * d.z + d.z * d.x)
}

aabb_center(a: AABB) -> Vec3 { return mul_sv(0.5, add(a.upper, a.lower)) }
aabb_extents(a: AABB) -> Vec3 { return mul_sv(0.5, sub(a.upper, a.lower)) }
aabb_union(a: AABB, b: AABB) -> AABB { return AABB { lower: min_vec3(a.lower, b.lower), upper: max_vec3(a.upper, b.upper) } }

aabb_inflate(a: AABB, extension: float) -> AABB {
    r = Vec3 { x: extension, y: extension, z: extension }
    return AABB { lower: sub(a.lower, r), upper: add(a.upper, r) }
}

aabb_overlaps(a: AABB, b: AABB) -> bool {
    if a.upper.x < b.lower.x || a.lower.x > b.upper.x { return false }
    if a.upper.y < b.lower.y || a.lower.y > b.upper.y { return false }
    if a.upper.z < b.lower.z || a.lower.z > b.upper.z { return false }
    return true
}

// The box of a transformed box: larger than the box of the transformed
// shape would be.
aabb_transform(t: Transform, a: AABB) -> AABB {
    center = transform_point(t, aabb_center(a))
    m = make_matrix_from_quat(t.q)
    extent = mul_mv(abs_matrix3(m), aabb_extents(a))
    return AABB { lower: sub(center, extent), upper: add(center, extent) }
}

closest_point_to_aabb(point: Vec3, a: AABB) -> Vec3 { return clamp_vec3(point, a.lower, a.upper) }
aabb_add_point(a: AABB, point: Vec3) -> AABB { return AABB { lower: min_vec3(a.lower, point), upper: max_vec3(a.upper, point) } }

// --- planes and inertia (math_internal.h) ------------------------------------

max_element(v: Vec3) -> float { return max_float(v.x, max_float(v.y, v.z)) }

max_element_index(v: Vec3) -> int {
    if v.x < v.y {
        if v.y < v.z { return 2 }
        return 1
    }
    if v.x < v.z { return 2 }
    return 0
}

make_plane_from_normal_and_point(normal: Vec3, point: Vec3) -> Plane {
    return Plane { normal: normal, offset: dot(normal, point) }
}

make_plane_from_points(point1: Vec3, point2: Vec3, point3: Vec3) -> Plane {
    normal = normalize(cross(sub(point2, point1), sub(point3, point1)))
    return Plane { normal: normal, offset: dot(normal, point1) }
}

make_normal_from_points(point1: Vec3, point2: Vec3, point3: Vec3) -> Vec3 {
    return normalize(cross(sub(point2, point1), sub(point3, point1)))
}

// normal2 = q * normal1; offset2 = dot(normal2, p) + offset1
transform_plane(t: Transform, p: Plane) -> Plane {
    normal = rotate_vector(t.q, p.normal)
    return Plane { normal: normal, offset: p.offset + dot(normal, t.p) }
}

// The signed distance of a point from a plane.
plane_separation(p: Plane, point: Vec3) -> float { return dot(p.normal, point) - p.offset }

// Negative if p is below the triangle v1-v2-v3.
signed_volume(v1: Vec3, v2: Vec3, v3: Vec3, p: Vec3) -> float {
    n = cross(sub(v2, v1), sub(v3, v1))
    return dot(n, sub(p, v1))
}

rotate_inertia(q: Quat, central_inertia: Matrix3) -> Matrix3 {
    r = make_matrix_from_quat(q)
    return mul_mm(r, mul_mm(central_inertia, transpose(r)))
}

transform_inertia(t: Transform, central_inertia: Matrix3, mass: float) -> Matrix3 {
    return add_mm(rotate_inertia(t.q, central_inertia), steiner(mass, t.p))
}

distance_squared_2(a: Vec2, b: Vec2) -> float {
    dx = b.x - a.x
    dy = b.y - a.y
    return dx * dx + dy * dy
}

// One axis of the slab test: narrows [t_min, t_max] (as fractions[0..1])
// to the slab, false when the interval empties.
slab_axis(ray_start: float, ray_component: float, box_min: float, box_max: float, fractions: float[]) -> bool {
    if abs_float(ray_component) < EPSILON {
        // Parallel to the slab: inside it or not at all.
        return ray_start >= box_min && ray_start <= box_max
    }
    t1 = (box_min - ray_start) / ray_component
    t2 = (box_max - ray_start) / ray_component
    if t1 > t2 {
        swap = t1
        t1 = t2
        t2 = swap
    }
    fractions[0] = max_float(fractions[0], t1)
    fractions[1] = min_float(fractions[1], t2)
    return fractions[0] <= fractions[1]
}

// The segment p1-p2 against the box by the slab method (Real-Time
// Collision Detection, p. 179). On a hit, fractions[0] and [1] are where
// the segment enters and leaves, clamped to [0, 1].
ray_cast_aabb(a: AABB, p1: Vec3, p2: Vec3, fractions: float[]) -> bool {
    d = sub(p2, p1)
    ray_length = length(d)
    if ray_length < EPSILON {
        inside = p1.x >= a.lower.x && p1.x <= a.upper.x && p1.y >= a.lower.y && p1.y <= a.upper.y &&
                 p1.z >= a.lower.z && p1.z <= a.upper.z
        if inside {
            fractions[0] = 0.0
            fractions[1] = 0.0
        }
        return inside
    }
    ray_dir = mul_sv(1.0 / ray_length, d)
    fractions[0] = 0.0
    fractions[1] = ray_length
    if slab_axis(p1.x, ray_dir.x, a.lower.x, a.upper.x, fractions) == false { return false }
    if slab_axis(p1.y, ray_dir.y, a.lower.y, a.upper.y, fractions) == false { return false }
    if slab_axis(p1.z, ray_dir.z, a.lower.z, a.upper.z, fractions) == false { return false }
    if fractions[1] < 0.0 { return false }
    fractions[0] = clamp_float(fractions[0] / ray_length, 0.0, 1.0)
    fractions[1] = clamp_float(fractions[1] / ray_length, 0.0, 1.0)
    return true
}

// --- segments --------------------------------------------------------------

// The closest point on the segment a-b to q.
point_to_segment_distance(a: Vec3, b: Vec3, q: Vec3) -> Vec3 {
    ab = sub(b, a)
    aq = sub(q, a)
    alpha = dot(ab, aq)
    if alpha <= 0.0 { return a }
    denominator = dot(ab, ab)
    if alpha > denominator { return b }
    return mul_add(a, alpha / denominator, ab)
}

// The closest points on two infinite lines p1 + s1 d1 and p2 + s2 d2.
line_distance(p1: Vec3, d1: Vec3, p2: Vec3, d2: Vec3) -> SegmentDistanceResult {
    a11 = dot(d1, d1)
    a12 = 0.0 - dot(d1, d2)
    a21 = dot(d2, d1)
    a22 = 0.0 - dot(d2, d2)
    w = sub(p1, p2)
    b1 = 0.0 - dot(d1, w)
    b2 = 0.0 - dot(d2, w)
    d = a11 * a22 - a12 * a21
    if d * d < 1000.0 * TINY {
        // Parallel: project p2 onto the first line.
        s1 = dot(sub(p2, p1), d1) / dot(d1, d1)
        return SegmentDistanceResult { point1: mul_add(p1, s1, d1), fraction1: s1, point2: p2, fraction2: 0.0 }
    }
    s1 = (a22 * b1 - a12 * b2) / d
    s2 = (a11 * b2 - a21 * b1) / d
    return SegmentDistanceResult { point1: mul_add(p1, s1, d1), fraction1: s1, point2: mul_add(p2, s2, d2), fraction2: s2 }
}

// The closest points on two segments p1-q1 and p2-q2.
segment_distance(p1: Vec3, q1: Vec3, p2: Vec3, q2: Vec3) -> SegmentDistanceResult {
    d1 = sub(q1, p1)
    d2 = sub(q2, p2)
    r = sub(p1, p2)
    a = dot(d1, d1)
    b = dot(d1, d2)
    c = dot(d1, r)
    e = dot(d2, d2)
    f = dot(d2, r)

    if a < 100.0 * EPSILON && e < 100.0 * EPSILON {
        // Both segments are points.
        return SegmentDistanceResult { point1: p1, fraction1: 0.0, point2: p2, fraction2: 0.0 }
    }
    if a < 100.0 * EPSILON {
        // The first is a point.
        s2 = clamp_float(f / e, 0.0, 1.0)
        return SegmentDistanceResult { point1: p1, fraction1: 0.0, point2: mul_add(p2, s2, d2), fraction2: s2 }
    }
    if e < 100.0 * EPSILON {
        // The second is a point.
        s1 = clamp_float((0.0 - c) / a, 0.0, 1.0)
        return SegmentDistanceResult { point1: mul_add(p1, s1, d1), fraction1: s1, point2: p2, fraction2: 0.0 }
    }

    denom = a * e - b * b
    s1 = 0.0
    if denom > 1000.0 * TINY { s1 = clamp_float((b * f - c * e) / denom, 0.0, 1.0) }
    s2 = (b * s1 + f) / e
    if s2 < 0.0 {
        s1 = clamp_float((0.0 - c) / a, 0.0, 1.0)
        s2 = 0.0
    } else if s2 > 1.0 {
        s1 = clamp_float((b - c) / a, 0.0, 1.0)
        s2 = 1.0
    }
    return SegmentDistanceResult { point1: mul_add(p1, s1, d1), fraction1: s1, point2: mul_add(p2, s2, d2), fraction2: s2 }
}

// --- validity --------------------------------------------------------------

// Not NaN, not infinite. A NaN is the one number not equal to itself, and
// an infinity the one whose difference with itself is not zero.
is_valid_float(a: float) -> bool {
    if a != a { return false }
    d = a - a
    return d == 0.0
}

is_valid_vec3(a: Vec3) -> bool { return is_valid_float(a.x) && is_valid_float(a.y) && is_valid_float(a.z) }

// Valid and normalised.
is_valid_quat(q: Quat) -> bool {
    if !is_valid_vec3(qv(q)) || !is_valid_float(q.w) { return false }
    return is_normalized_quat(q)
}

is_valid_transform(a: Transform) -> bool { return is_valid_vec3(a.p) && is_valid_quat(a.q) }
is_valid_matrix3(a: Matrix3) -> bool { return is_valid_vec3(a.cx) && is_valid_vec3(a.cy) && is_valid_vec3(a.cz) }

// Valid, with the upper bound at or above the lower.
is_valid_aabb(a: AABB) -> bool {
    if !is_valid_vec3(a.lower) || !is_valid_vec3(a.upper) { return false }
    if a.lower.x > a.upper.x || a.lower.y > a.upper.y || a.lower.z > a.upper.z { return false }
    return true
}

// Reasonably close to the origin (within HUGE).
is_bounded_aabb(a: AABB) -> bool {
    if a.lower.x < 0.0 - HUGE || a.lower.y < 0.0 - HUGE || a.lower.z < 0.0 - HUGE { return false }
    if a.upper.x > HUGE || a.upper.y > HUGE || a.upper.z > HUGE { return false }
    return true
}

is_sane_aabb(a: AABB) -> bool { return is_valid_aabb(a) && is_bounded_aabb(a) }

is_valid_plane(a: Plane) -> bool {
    if !is_valid_vec3(a.normal) || !is_normalized(a.normal) { return false }
    return is_valid_float(a.offset)
}

is_valid_position(p: Vec3) -> bool { return is_valid_vec3(p) }
is_valid_world_transform(t: Transform) -> bool { return is_valid_position(t.p) && is_valid_quat(t.q) }

// --- text ------------------------------------------------------------------

vec3_text(v: Vec3) -> string { return "(${v.x}, ${v.y}, ${v.z})" }
quat_text(q: Quat) -> string { return "(${q.x}, ${q.y}, ${q.z}; ${q.w})" }
