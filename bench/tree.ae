// The dynamic tree on the same scene as bench/tree_box3d.c: 10,000 boxes
// inserted one by one, 100 full rebuilds, 100,000 box queries, 10,000 ray
// casts, then every proxy enlarged and a partial rebuild, ten rounds.
// Single thread, wall time per phase. Same random sequence as the
// reference's, so the hit counts should match.
import std.string
import std.os
import aephysics.math
import aephysics.dynamic_tree

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

clock() -> long { return os.now_monotonic_ns() }
ms(ns: long) -> float { return (ns as float) / 1000000.0 }

const N = 10000
const QUERIES = 100000
const RAYS = 10000

var seed = 12345
var hits = 0

next_random() -> int {
    seed = 1664525 * seed + 1013904223
    return seed
}

random_float(lo: float, hi: float) -> float {
    t = (((next_random() >> 8) & 0xFFFFFF) as float) / 16777216.0
    return lo + t * (hi - lo)
}

random_box(extent: float, largest: float) -> AABB {
    c = math.vec3(random_float(0.0 - extent, extent), random_float(0.0 - extent, extent), random_float(0.0 - extent, extent))
    h = math.vec3(random_float(0.1, largest), random_float(0.1, largest), random_float(0.1, largest))
    return math.aabb(math.sub(c, h), math.add(c, h))
}

count_hit(proxy_id: int, user_data: long, context: ptr) -> bool {
    hits = hits + 1
    return true
}

ray_hit(input: *RayCastInput, proxy_id: int, user_data: long, context: ptr) -> float {
    hits = hits + 1
    return input.max_fraction
}

main() {
    tree = dynamic_tree.tree_create(16)
    boxes_block = calloc(N, sizeof(AABB))
    boxes = boxes_block as AABB[]
    ids_block = calloc(N, 4)
    ids = ids_block as int[]

    t0 = clock()
    i = 0
    while i < N {
        boxes[i] = random_box(100.0, 1.0)
        ids[i] = dynamic_tree.tree_create_proxy(&tree, boxes[i], dynamic_tree.default_category_bits(), i as long)
        i = i + 1
    }
    t1 = clock()
    k = 0
    while k < 100 {
        dynamic_tree.tree_rebuild(&tree, true)
        k = k + 1
    }
    t2 = clock()

    hits = 0
    q = 0
    while q < QUERIES {
        box = random_box(100.0, 2.0)
        dynamic_tree.tree_query(&tree, box, dynamic_tree.default_mask_bits(), false, count_hit, null)
        q = q + 1
    }
    t3 = clock()
    query_hits = hits

    hits = 0
    r = 0
    while r < RAYS {
        input = RayCastInput {
            origin: math.vec3(random_float(0.0 - 100.0, 100.0), random_float(0.0 - 100.0, 100.0), random_float(0.0 - 100.0, 100.0)),
            translation: math.vec3(random_float(0.0 - 200.0, 200.0), random_float(0.0 - 200.0, 200.0), random_float(0.0 - 200.0, 200.0)),
            max_fraction: 1.0
        }
        dynamic_tree.tree_ray_cast(&tree, &input, dynamic_tree.default_mask_bits(), false, ray_hit, null)
        r = r + 1
    }
    t4 = clock()
    ray_hits = hits

    move_ticks = 0 as long
    rebuild_ticks = 0 as long
    round = 0
    while round < 10 {
        a = clock()
        i = 0
        while i < N {
            d = math.vec3(random_float(0.0 - 1.0, 1.0), random_float(0.0 - 1.0, 1.0), random_float(0.0 - 1.0, 1.0))
            boxes[i] = math.aabb(math.add(boxes[i].lower, d), math.add(boxes[i].upper, d))
            dynamic_tree.tree_enlarge_proxy(&tree, ids[i], math.aabb_union(dynamic_tree.tree_get_aabb(&tree, ids[i]), boxes[i]))
            i = i + 1
        }
        b = clock()
        dynamic_tree.tree_rebuild(&tree, false)
        c = clock()
        move_ticks = move_ticks + (b - a)
        rebuild_ticks = rebuild_ticks + (c - b)
        round = round + 1
    }

    println("aephysics tree: insert ${N} ${ms(t1 - t0)} ms, 100x full rebuild ${ms(t2 - t1)} ms, ${QUERIES} queries ${ms(t3 - t2)} ms (${query_hits} hits), ${RAYS} rays ${ms(t4 - t3)} ms (${ray_hits} hits), 10x enlarge-all ${ms(move_ticks)} ms, 10x partial rebuild ${ms(rebuild_ticks)} ms, height ${dynamic_tree.tree_get_height(&tree)}, area ratio ${dynamic_tree.tree_get_area_ratio(&tree)}")
    dynamic_tree.tree_destroy(&tree)
    free(boxes_block)
    free(ids_block)
}
