// aephysics.basics against the reference's (Box3D's) test_bitset.c, test_id.c, test_table.c,
// test_container.c and test_allocator.c: the bit math, a bit set filled
// along the Fibonacci numbers, the hash set over shape-pair keys filled,
// thinned, searched and emptied, the arrays, the id pool, the stack and
// the arena. Every allocation the module counts is freed by the end.

import std.string
import std.mem
import aephysics.basics

extern calloc(count: int, size: int) -> ptr
extern exit(code: int)
extern free(p: ptr)
extern log2(x: float) -> float
extern floor(x: float) -> float

var failures = 0
var checks = 0

ensure(name: string, ok: bool) {
    checks = checks + 1
    if !ok {
        println("basics: FAIL ${name}")
        failures = failures + 1
    }
}

const BIT_COUNT = 169
const SET_SPAN = 317

struct Holder {
    values: Ints
}

struct Thing {
    id: int
    weight: float
    tag: long
}

// The name cache (the reference's test_name_cache.c CacheUnit): an empty
// or no name is the null id, which stands for nothing; distinct names get
// distinct ids and read back; the same name again is the same id and no
// second entry; a long name reads back whole; a different name on an id
// already taken gets another id and keeps its own text; a snapshot's
// names load with their ids, and bad ones are refused; everything comes
// back when the cache goes.
name_cache_unit() {
    before = basics.alloc_count()
    before_bytes = basics.bytes_in_use()
    c = basics.name_cache_create()
    ensure("names: empty is none", basics.name_cache_add(&c, "") == basics.NULL_NAME)
    ensure("names: null is none", basics.name_cache_add(&c, null) == basics.NULL_NAME)
    ensure("names: none stands for nothing", basics.name_cache_find(&c, basics.NULL_NAME) == null && string.length(basics.name_cache_text(&c, basics.NULL_NAME)) == 0)
    crate = basics.name_cache_add(&c, "crate")
    barrel = basics.name_cache_add(&c, "barrel")
    ensure("names: distinct ids", crate != basics.NULL_NAME && barrel != basics.NULL_NAME && crate != barrel)
    ensure("names: read back", string.equals(basics.name_cache_text(&c, crate), "crate") == 1 && string.equals(basics.name_cache_text(&c, barrel), "barrel") == 1)
    ensure("names: the same name, the same id, one entry", basics.name_cache_add(&c, "crate") == crate && basics.name_cache_count(&c) == 2)
    // The id is the reference's b3Hash32 of the bytes (FNV-1a, Murmur3's
    // finish), its values from the reference's own function compiled in C.
    ensure("names: the reference's hash of crate", basics.name_hash32(string.aether_string_raw_ptr("crate"), 5) == (3832558763 as long) && crate == 0 - 462408533)
    ensure("names: the reference's hash of barrel", basics.name_hash32(string.aether_string_raw_ptr("barrel"), 6) == (2907559280 as long) && barrel == 0 - 1387408016)
    long_block = calloc(4096, 1)
    long_bytes = long_block as byte[]
    i = 0
    while i < 4095 {
        long_bytes[i] = (97 + i % 26) as byte
        i = i + 1
    }
    long_name = string.from_cstr(long_block)
    long_id = basics.name_cache_add(&c, long_name)
    ensure("names: a long name whole", string.length(basics.name_cache_text(&c, long_id)) == 4095 && string.equals(basics.name_cache_text(&c, long_id), long_name) == 1 && basics.name_cache_count(&c) == 3)
    string.free(long_name)
    free(long_block)
    // Another name on a taken id: loaded under crate's id first, "crate"
    // itself then probes past it.
    d = basics.name_cache_create()
    other = string.aether_string_raw_ptr("other")
    ensure("names: loaded with its id", basics.name_cache_load(&d, crate, other, 5))
    moved = basics.name_cache_add(&d, "crate")
    ensure("names: a collision takes the next id", moved == crate + 1 && string.equals(basics.name_cache_text(&d, crate), "other") == 1 && string.equals(basics.name_cache_text(&d, moved), "crate") == 1)
    ensure("names: and finds it again", basics.name_cache_add(&d, "crate") == moved && basics.name_cache_count(&d) == 2)
    ensure("names: a taken id refused", basics.name_cache_load(&d, crate, other, 5) == false)
    ensure("names: the null id refused", basics.name_cache_load(&d, basics.NULL_NAME, other, 5) == false)
    ensure("names: an empty name refused", basics.name_cache_load(&d, 77, other, 0) == false)
    ensure("names: a zero inside refused", basics.name_cache_load(&d, 78, string.aether_string_raw_ptr("crate"), 6) == false)
    basics.name_cache_destroy(&d)
    basics.name_cache_destroy(&c)
    ensure("names: nothing left (${basics.alloc_count() - before} blocks, ${basics.bytes_in_use() - before_bytes} bytes)", basics.alloc_count() == before && basics.bytes_in_use() == before_bytes)
}

main() {
    // Bit math.
    ensure("clz of 9 is 28", basics.clz32(9) == 31 - 3)
    ensure("clz of 0 is 32", basics.clz32(0) == 32)
    ensure("ctz of 8 is 3", basics.ctz32(8) == 3)
    ensure("ctz64 of 1<<40 is 40", basics.ctz64((1 as long) << 40) == 40)
    ensure("popcount of 0xFF is 8", basics.pop_count64(255 as long) == 8)
    ensure("popcount of -1 is 64", basics.pop_count64(0 - 1 as long) == 64)
    ensure("lsr of -1 by 33 is 31 ones", basics.lsr(0 - 1 as long, 33) == ((1 as long) << 31) - 1)
    i = 1
    while i < 1000 {
        e1 = basics.lower_power_of_2_exponent(i)
        e2 = floor(log2(i as float)) as int
        ensure("the lower power of two exponent matches log2", e1 == e2)
        i = i + 1
    }
    ensure("the bounding power of 3008 is 12", basics.bounding_power_of_2(3008) == 12)
    ensure("rounding 3008 up gives 4096", basics.round_up_power_of_2(3008) == 4096)
    ensure("a power of two is one", basics.is_power_of_2(1024) && !basics.is_power_of_2(1000))

    // The bit set, along the Fibonacci numbers.
    bits = basics.bitset_create(BIT_COUNT)
    basics.bitset_set_count_and_clear(&bits, BIT_COUNT)
    values_block = calloc(BIT_COUNT, 4)
    values = values_block as int[]
    i1 = 0
    i2 = 1
    basics.bitset_set(&bits, i1)
    values[i1] = 1
    while i2 < BIT_COUNT {
        basics.bitset_set(&bits, i2)
        values[i2] = 1
        next = i1 + i2
        i1 = i2
        i2 = next
    }
    i = 0
    set_bits = 0
    while i < BIT_COUNT {
        ensure("a bit reads as it was set", basics.bitset_get(&bits, i) == (values[i] == 1))
        if values[i] == 1 { set_bits = set_bits + 1 }
        i = i + 1
    }
    ensure("the set counts its bits", basics.bitset_count(&bits) == set_bits)
    ensure("a bit past the end reads clear", !basics.bitset_get(&bits, 10000))
    basics.bitset_clear(&bits, 1)
    ensure("a cleared bit is clear", !basics.bitset_get(&bits, 1))
    basics.bitset_set_grow(&bits, 500)
    ensure("setting past the end grows the set", basics.bitset_get(&bits, 500) && bits.block_count == 8)
    other = basics.bitset_create(BIT_COUNT)
    basics.bitset_set_count_and_clear(&other, 512)
    basics.bitset_set(&other, 7)
    basics.bitset_union(&bits, &other)
    ensure("a union carries the other's bits over", basics.bitset_get(&bits, 7))
    basics.bitset_destroy(&other)
    basics.bitset_destroy(&bits)
    free(values_block)

    // The id pool: dense, recycled.
    pool = basics.idpool_create()
    a = basics.idpool_alloc(&pool)
    b = basics.idpool_alloc(&pool)
    c = basics.idpool_alloc(&pool)
    ensure("ids are dense from zero", a == 0 && b == 1 && c == 2)
    basics.idpool_free(&pool, b)
    ensure("a freed id is out of the count", basics.idpool_count(&pool) == 2 && basics.idpool_capacity(&pool) == 3)
    ensure("and is the next one handed out", basics.idpool_alloc(&pool) == 1)
    basics.idpool_destroy(&pool)

    // The hash set over shape-pair keys: fill, thin, search, empty.
    item_count = (SET_SPAN * SET_SPAN - SET_SPAN) / 2
    removed_block = calloc(item_count, 4)
    removed = removed_block as int[]
    set = basics.set_create(16)
    ensure("a pair key is the same either way round", basics.shape_pair_key(3, 9, 0) == basics.shape_pair_key(9, 3, 0))
    ensure("a child index tells pairs apart", basics.shape_pair_key(3, 9, 1) != basics.shape_pair_key(3, 9, 0))
    i = 0
    while i < SET_SPAN {
        j = i + 1
        while j < SET_SPAN {
            basics.set_add(&set, basics.shape_pair_key(i, j, 0))
            j = j + 1
        }
        i = i + 1
    }
    ensure("every pair is in the set once", basics.set_count(&set) == item_count)
    ensure("adding a key again says so", basics.set_add(&set, basics.shape_pair_key(0, 1, 0)))
    ensure("and does not count it twice", basics.set_count(&set) == item_count)
    k = 0
    remove_count = 0
    i = 0
    while i < SET_SPAN {
        j = i + 1
        while j < SET_SPAN {
            if j == i + 1 {
                basics.set_remove(&set, basics.shape_pair_key(i, j, 0))
                removed[k] = 1
                remove_count = remove_count + 1
            } else {
                removed[k] = 0
            }
            k = k + 1
            j = j + 1
        }
        i = i + 1
    }
    ensure("removing takes the count down", basics.set_count(&set) == item_count - remove_count)
    k = 0
    i = 0
    while i < SET_SPAN {
        j = i + 1
        while j < SET_SPAN {
            key = basics.shape_pair_key(j, i, 0)
            found = basics.set_contains(&set, key)
            ensure("every kept key is found and every removed one is not", found == (removed[k] == 0))
            ensure("the hashed lookup agrees", basics.set_contains_hashed(&set, key, basics.key_hash(key)) == found)
            k = k + 1
            j = j + 1
        }
        i = i + 1
    }
    ensure("removing a key that is not there says so", !basics.set_remove(&set, basics.shape_pair_key(0, 1, 0)))
    i = 0
    while i < SET_SPAN {
        j = i + 1
        while j < SET_SPAN {
            basics.set_remove(&set, basics.shape_pair_key(i, j, 0))
            j = j + 1
        }
        i = i + 1
    }
    ensure("the emptied set is empty", basics.set_count(&set) == 0)
    basics.set_clear(&set)
    basics.set_destroy(&set)
    free(removed_block)

    // Arrays: ints and a buffer of structs.
    ints = basics.ints_create(0)
    i = 0
    while i < 100 {
        basics.ints_push(&ints, i * i)
        i = i + 1
    }
    ensure("an int array holds what was pushed", basics.ints_count(&ints) == 100 && basics.ints_get(&ints, 9) == 81)
    ensure("it grew as needed", basics.ints_capacity(&ints) >= 100)
    ensure("pop gives the last", basics.ints_pop(&ints) == 99 * 99 && basics.ints_count(&ints) == 99)
    basics.ints_remove_swap(&ints, 0)
    ensure("remove-swap moves the last into the hole", basics.ints_get(&ints, 0) == 98 * 98 && basics.ints_count(&ints) == 98)
    basics.ints_destroy(&ints)

    things = basics.buffer_create(sizeof(Thing), 2)
    i = 0
    while i < 50 {
        at = basics.buffer_push(&things)
        items = things.data as Thing[]
        items[at] = Thing { id: i, weight: i as float * 0.5, tag: (i * 7) as long }
        i = i + 1
    }
    items = things.data as Thing[]
    ensure("a buffer holds its structs", basics.buffer_count(&things) == 50 && items[20].id == 20 && items[20].weight == 10.0 && items[20].tag == 140)
    basics.buffer_remove_swap(&things, 3)
    items = things.data as Thing[]
    ensure("remove-swap on a buffer moves the last in", items[3].id == 49 && basics.buffer_count(&things) == 49)
    basics.buffer_destroy(&things)

    // test_container.c's TestArrayRemove: reserved to the count, then
    // drained by remove-swaps from the front, summing as it goes.
    draining = basics.ints_create(0)
    basics.ints_reserve(&draining, 100)
    ensure("reserve: the capacity and nothing in it", basics.ints_capacity(&draining) == 100 && basics.ints_count(&draining) == 0)
    i = 0
    while i < 100 {
        basics.ints_push(&draining, i)
        i = i + 1
    }
    drained = 0
    while basics.ints_count(&draining) > 0 {
        drained = drained + basics.ints_get(&draining, 0)
        basics.ints_remove_swap(&draining, 0)
    }
    ensure("remove-swap from the front drains every value (${drained})", drained == 100 * 99 / 2)
    basics.ints_destroy(&draining)
    // TestArrayPop: popped to empty.
    popping = basics.ints_create(10)
    i = 0
    while i < 10 {
        basics.ints_push(&popping, i)
        i = i + 1
    }
    popped = 0
    while basics.ints_count(&popping) > 0 { popped = popped + basics.ints_pop(&popping) }
    ensure("pop to empty gives every value (${popped})", popped == 10 * 9 / 2 && basics.ints_capacity(&popping) == 10)
    basics.ints_destroy(&popping)
    // TestStructWithArray: an array held in a struct.
    holder = Holder { values: basics.ints_create(0) }
    basics.ints_push(&holder.values, 1)
    basics.ints_push(&holder.values, 2)
    basics.ints_push(&holder.values, 3)
    held = 0
    i = 0
    while i < basics.ints_count(&holder.values) {
        held = held + basics.ints_get(&holder.values, i)
        i = i + 1
    }
    ensure("an array in a struct holds what was pushed", held == 6)
    basics.ints_destroy(&holder.values)

    // test_allocator.c: two elements allocated, freed, the allocator
    // destroyed (TestBlockAllocate, TestBlockClear); then, for elements of
    // 12 bytes, a manifold and three, more than a block's worth, every one
    // 16-byte aligned, freed, allocated again from the free list, still
    // aligned (TestBlockAlignment).
    blocks = basics.block_allocator_create(8)
    first = basics.block_allocate(&blocks)
    second = basics.block_allocate(&blocks)
    ensure("block allocator: two elements", first != null && second != null && first != second)
    basics.block_free(&blocks, first)
    basics.block_free(&blocks, second)
    ensure("block allocator: both freed", blocks.allocation_count == 0)
    basics.block_allocator_destroy(&blocks)
    sizes = [ 12, 268, 3 * 268 ]
    element_count = basics.BLOCK_SIZE + 8
    elements_block = calloc(element_count, 8)
    elements = elements_block as ptr[]
    k = 0
    while k < 3 {
        sized = basics.block_allocator_create(sizes[k])
        round = 0
        while round < 2 {
            aligned = true
            j = 0
            while j < element_count {
                elements[j] = basics.block_allocate(&sized)
                if elements[j] == null || (mem.ptr_to_long(elements[j]) & (15 as long)) != (0 as long) { aligned = false }
                j = j + 1
            }
            ensure("block allocator: ${element_count} elements of ${sizes[k]} bytes, 16-byte aligned (round ${round})", aligned)
            j = 0
            while j < element_count {
                basics.block_free(&sized, elements[j])
                j = j + 1
            }
            round = round + 1
        }
        ensure("block allocator: the second round reused the blocks (${sized.blocks.count})", sized.blocks.count == 2 && sized.allocation_count == 0)
        basics.block_allocator_destroy(&sized)
        k = k + 1
    }
    free(elements_block)

    // The stack: LIFO, with the heap past its capacity.
    stack = basics.stack_create(256)
    first = basics.stack_alloc(&stack, 100)
    second = basics.stack_alloc(&stack, 100)
    ensure("stack allocations are aligned", (second - first) == 112)
    third = basics.stack_alloc(&stack, 100)
    ensure("past the block the stack still hands out memory", third != null)
    ensure("and counts it", basics.stack_allocation(&stack) == 336 && basics.stack_max_allocation(&stack) == 336)
    basics.stack_free(&stack, third)
    basics.stack_free(&stack, second)
    basics.stack_free(&stack, first)
    ensure("freed in order, nothing is left", basics.stack_allocation(&stack) == 0)
    basics.stack_destroy(&stack)

    // The arena: bump, overflow, sync grows.
    arena = basics.arena_create(128)
    p1 = basics.arena_bump(&arena, 40)
    p2 = basics.arena_bump(&arena, 40)
    ensure("bumps are aligned", (p2 - p1) == 48)
    p3 = basics.arena_bump(&arena, 200)
    ensure("an overflow still hands out memory", p3 != null)
    basics.arena_sync(&arena)
    ensure("after a sync the arena fits the step's peak", basics.arena_capacity(&arena) >= 96 + 200)
    ensure("and starts over", basics.arena_bump(&arena, 8) == arena.memory)
    basics.arena_destroy(&arena)

    // The long map against a plain table of 512 keys: sets, gets and
    // removes in a scrambled order, through growth, each removal leaving
    // every other key reachable (the run behind it moved back, #147).
    map = basics.map_create(4)
    model_block = calloc(512, 4)
    model = model_block as int[]
    i = 0
    while i < 512 {
        model[i] = 0 - 1
        i = i + 1
    }
    seed = 12345
    map_ok = true
    round = 0
    while round < 20000 {
        seed = (seed * 1103515245 + 12345) & 2147483647
        k = (seed >> 8) & 511
        // Keys spread wide and clustered both, so runs form and wrap.
        key = ((k as long) * (2654435761 as long)) ^ ((k & 7) as long)
        op = (seed >> 4) & 3
        if op == 0 || op == 1 {
            was = basics.map_set(&map, key, round)
            if was != (model[k] >= 0) { map_ok = false }
            model[k] = round
        } else if op == 2 {
            taken = basics.map_remove(&map, key)
            if taken != (model[k] >= 0) { map_ok = false }
            model[k] = 0 - 1
        } else {
            if basics.map_get(&map, key, 0 - 1) != model[k] { map_ok = false }
        }
        round = round + 1
    }
    live = 0
    i = 0
    while i < 512 {
        key = ((i as long) * (2654435761 as long)) ^ ((i & 7) as long)
        if basics.map_get(&map, key, 0 - 1) != model[i] { map_ok = false }
        if model[i] >= 0 { live = live + 1 }
        i = i + 1
    }
    ensure("the long map agrees with a plain table through 20000 sets, removes and gets", map_ok)
    ensure("its count is the live keys' (${basics.map_count(&map)} against ${live})", basics.map_count(&map) == live)
    ensure("a missing key is not removed", basics.map_remove(&map, 999999 as long) == false)
    i = 0
    while i < 512 {
        basics.map_remove(&map, ((i as long) * (2654435761 as long)) ^ ((i & 7) as long))
        i = i + 1
    }
    ensure("every key removed leaves it empty", basics.map_count(&map) == 0)
    basics.map_destroy(&map)
    free(model_block)

    ensure("every allocation the module counted was freed", basics.alloc_count() == 0 && basics.bytes_in_use() == 0)

    name_cache_unit()
    println("basics: ${checks} checks")
    if failures == 0 {
        println("basics: all checks passed")
    } else {
        println("basics: ${failures} failure(s)")
        exit(1)
    }
}
