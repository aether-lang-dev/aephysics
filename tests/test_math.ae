// aephysics.math against the reference's test_math.c (Box3D): the deterministic atan2,
// cosine and sine against libm within their stated accuracy; vectors,
// transforms, quaternions and matrices against each other. The tolerances
// are the original's (float epsilons on double arithmetic, so they are
// loose here); where the original asserts a range, this checks it.

import std.string
import aephysics.math

extern atan2(y: float, x: float) -> float
extern cos(x: float) -> float
extern sin(x: float) -> float
extern calloc(count: int, size: int) -> ptr
extern exit(code: int)
extern free(p: ptr)
extern nextafterf(x: f32, y: f32) -> f32

var failures = 0
var checks = 0

ensure(name: string, ok: bool) {
    checks = checks + 1
    if !ok {
        println("math: FAIL ${name}")
        failures = failures + 1
    }
}

ensure_small(name: string, value: float, tolerance: float) {
    ensure(name, math.abs_float(value) < tolerance)
}

// The single-precision family beside the double one: every operation is
// the double's, written once at a float's width, so a result converted
// from one is the other to what a float can hold (#42). The tolerance is
// a float's epsilon, scaled by the size of what is being compared.
// The boxes the tree keeps in single precision (#151): a coordinate rounded
// down is the nearest float at or below it and rounded up the nearest at
// or above, the two the same float when it is one and adjacent floats when
// not, at the origin, at 1e7, past a float's range and at the infinities;
// a box rounded outward holds the double box; the float box operations.
var g_zero_m = 0.0

outward_rounding() {
    values_block = calloc(12, 8)
    values = values_block as float[]
    values[0] = 0.0
    values[1] = 0.1
    values[2] = 0.0 - 0.1
    values[3] = 10000000.1
    values[4] = 0.0 - 10000000.3
    values[5] = 1.0 / 3.0
    values[6] = 0.5
    values[7] = 1.0e-42
    values[8] = 3.5e38
    values[9] = 0.0 - 3.5e38
    values[10] = 16777217.0
    values[11] = 123456.789
    held = true
    tight = true
    i = 0
    while i < 12 {
        x = values[i]
        down = math.round_down_f32(x)
        up = math.round_up_f32(x)
        if (down as float) > x || (up as float) < x { held = false }
        exact = ((x as f32) as float) == x
        if exact && (down != up || (down as float) != x) { tight = false }
        if exact == false && nextafterf(down, math.infinity_f32()) != up { tight = false }
        i = i + 1
    }
    ensure("rounding: down at or below, up at or above, every value", held)
    ensure("rounding: one float when exact, adjacent floats when not", tight)
    inf = 1.0 / g_zero_m
    ensure("rounding: the infinities stay infinite", (math.round_down_f32(inf) as float) == inf && (math.round_up_f32(0.0 - inf) as float) == 0.0 - inf)
    far = math.aabb(math.vec3(10000000.01, 0.0 - 0.3, 5.7), math.vec3(10000000.02, 0.4, 5.71))
    out = math.aabb_round_out(far)
    ensure("rounding: a centimetre box at 1e7 is held by its float box", math.aabb_contains(math.aabb_widen(out), far) && math.aabbf_holds(out, far))
    ensure("rounding: and the float box is a float step wider at most", (out.upper.x as float) - (out.lower.x as float) <= 0.01 + 2.0)
    a = math.aabb_round_out(math.aabb(math.vec3(0.0, 0.0, 0.0), math.vec3(1.0, 1.0, 1.0)))
    b = math.aabb_round_out(math.aabb(math.vec3(0.5, 0.5, 0.5), math.vec3(2.0, 2.0, 2.0)))
    c = math.aabb_round_out(math.aabb(math.vec3(1.5, 0.0, 0.0), math.vec3(2.0, 1.0, 1.0)))
    ensure("float boxes: overlap and not", math.aabbf_overlaps(a, b) && math.aabbf_overlaps(a, c) == false)
    u = math.aabbf_union(a, c)
    ensure("float boxes: the union contains both", math.aabbf_contains(u, a) && math.aabbf_contains(u, c) && math.aabbf_contains(a, u) == false)
    ensure("float boxes: the empty box overlaps nothing", math.aabbf_overlaps(math.aabbf_empty(), u) == false && math.is_valid_aabbf(u) && math.is_valid_aabbf(math.aabbf_empty()) == false)
    free(values_block)
}

single_precision() {
    a = math.vec3(0.35, 0.0 - 1.25, 2.5)
    b = math.vec3(0.0 - 0.75, 0.5, 1.5)
    af = math.narrow3(a)
    bf = math.narrow3(b)
    ensure_close_f32("narrowing and widening keeps a vector", math.widen3(af), a, 10.0)
    ensure_close_f32("the sum", math.widen3(math.addf(af, bf)), math.add(a, b), 10.0)
    ensure_close_f32("the difference", math.widen3(math.subf(af, bf)), math.sub(a, b), 10.0)
    ensure_close_f32("the cross product", math.widen3(math.crossf(af, bf)), math.cross(a, b), 10.0)
    ensure_small("the dot product", (math.dotf(af, bf) as float) - math.dot(a, b), 10.0 * math.EPSILON_F32)
    ensure_small("the length", (math.lengthf(af) as float) - math.length(a), 10.0 * math.EPSILON_F32)
    ensure_close_f32("the unit vector", math.widen3(math.normalizef(af)), math.normalize(a), 10.0)
    ensure_close_f32("a + s * b", math.widen3(math.mul_addf(af, 0.25, bf)), math.mul_add(a, 0.25, b), 10.0)
    ensure("a perpendicular is perpendicular and unit",
           math.abs_f32(math.dotf(math.perpf(af), af)) < 100.0 * math.EPSILON_F32 && math.is_normalizedf(math.perpf(af)))
    ensure("a zero vector normalises to zero", math.lengthf(math.normalizef(math.vec3f_zero())) == 0.0)

    // A rotation, a matrix and their products.
    q = math.make_quat_from_axis_angle(math.normalize(math.vec3(0.3, 0.7, 0.0 - 0.2)), 0.85)
    qf = math.narrow_quat(q)
    ensure_close_f32("a vector turned by a rotation", math.widen3(math.rotate_vectorf(qf, af)), math.rotate_vector(q, a), 20.0)
    ensure_close_f32("and turned back", math.widen3(math.inv_rotate_vectorf(qf, math.rotate_vectorf(qf, af))), a, 20.0)
    turned = math.mul_quat(q, q)
    turnedf = math.mul_quatf(qf, qf)
    ensure_small("two rotations composed", (turnedf.w as float) - turned.w, 20.0 * math.EPSILON_F32)
    m = math.matrix3(math.vec3(2.0, 0.1, 0.0), math.vec3(0.0 - 0.3, 1.5, 0.2), math.vec3(0.0, 0.0, 0.75))
    mf = math.narrow_mat3(m)
    ensure_close_f32("a matrix times a vector", math.widen3(math.mul_mvf(mf, af)), math.mul_mv(m, a), 20.0)
    ensure_close_f32("the inverse times the vector", math.widen3(math.mul_mvf(math.invert_matrixf(mf), af)),
                     math.mul_mv(math.invert_matrix(m), a), 200.0)
    ensure("a singular matrix inverts to zero",
           math.lengthf(math.mul_mvf(math.invert_matrixf(math.mat3f_zero()), af)) == 0.0)
}

// Two vectors the same to a float's precision, scaled by their size.
ensure_close_f32(name: string, got: Vec3, want: Vec3, scale: float) {
    reach = math.length(want)
    if reach < 1.0 { reach = 1.0 }
    ensure_small(name, math.distance(got, want), scale * reach * math.EPSILON_F32)
}

// 0.0023 degrees
const ATAN_TOL = 0.00004

main() {
    // The approximations against libm, over twenty turns.
    t = 0.0 - 10.0
    worst_cs = 0.0
    worst_atan = 0.0
    while t < 10.0 {
        angle = math.PI * t
        cs = math.compute_cos_sin(angle)
        c = cos(angle)
        s = sin(angle)
        // Accurate to about 0.1 degrees (0.002 radians).
        ensure_small("cosine approximation", cs.cosine - c, 0.002)
        ensure_small("sine approximation", cs.sine - s, 0.002)
        worst_cs = math.max_float(worst_cs, math.max_float(math.abs_float(cs.cosine - c), math.abs_float(cs.sine - s)))

        xn = math.unwind_angle(angle)
        a = math.atan2_approx(s, c)
        ensure("atan2 is a number", math.is_valid_float(a))
        diff = math.abs_float(a - xn)
        // The two can differ by a full turn (-pi and pi).
        if diff > math.PI { diff = diff - 2.0 * math.PI }
        ensure_small("atan2 of the unwound angle", diff, ATAN_TOL)
        worst_atan = math.max_float(worst_atan, math.abs_float(diff))
        t = t + 0.01
    }

    y = 0.0 - 1.0
    while y <= 1.0 {
        x = 0.0 - 1.0
        while x <= 1.0 {
            a1 = math.atan2_approx(y, x)
            a2 = atan2(y, x)
            ensure("atan2 over the square is a number", math.is_valid_float(a1))
            ensure_small("atan2 over the square", a1 - a2, ATAN_TOL)
            x = x + 0.01
        }
        y = y + 0.01
    }
    ensure_small("atan2 straight up", math.atan2_approx(1.0, 0.0) - atan2(1.0, 0.0), ATAN_TOL)
    ensure_small("atan2 straight down", math.atan2_approx(0.0 - 1.0, 0.0) - atan2(0.0 - 1.0, 0.0), ATAN_TOL)
    ensure_small("atan2 right", math.atan2_approx(0.0, 1.0) - atan2(0.0, 1.0), ATAN_TOL)
    ensure_small("atan2 left", math.atan2_approx(0.0, 0.0 - 1.0) - atan2(0.0, 0.0 - 1.0), ATAN_TOL)
    ensure_small("atan2 at the origin", math.atan2_approx(0.0, 0.0) - atan2(0.0, 0.0), ATAN_TOL)

    zero = math.vec3_zero()
    one = math.vec3_one()
    two = math.vec3(2.0, 2.0, 2.0)
    v = math.add(one, two)
    ensure("one and two are three", v.x == 3.0 && v.y == 3.0)
    v = math.sub(zero, two)
    ensure("nothing less two is minus two", v.x == 0.0 - 2.0 && v.y == 0.0 - 2.0)
    v = math.add(two, two)
    ensure("two and two are not five", v.x != 5.0 && v.y != 5.0)

    axis = math.normalize(math.vec3(0.0 - 0.75, 0.5, 1.0))
    transform1 = math.transform(math.vec3(0.0 - 2.0, 3.0, 0.0), math.quat_identity())
    transform2 = math.transform(math.vec3(1.0, 0.0, 0.0), math.make_quat_from_axis_angle(axis, math.PI))
    combined = math.mul_transforms(transform2, transform1)
    v = math.transform_point(transform2, math.transform_point(transform1, two))
    u = math.transform_point(combined, two)
    ensure_small("a product of transforms transforms as both, x", u.x - v.x, 10.0 * math.EPSILON)
    ensure_small("a product of transforms transforms as both, y", u.y - v.y, 10.0 * math.EPSILON)

    v = math.transform_point(transform1, two)
    v = math.inv_transform_point(transform1, v)
    ensure_small("a transform and its inverse cancel, x", v.x - two.x, 8.0 * math.EPSILON)
    ensure_small("a transform and its inverse cancel, y", v.y - two.y, 8.0 * math.EPSILON)

    rel = math.inv_mul_transforms(transform1, transform2)
    v = math.inv_transform_point(transform1, math.transform_point(transform2, two))
    u = math.transform_point(rel, two)
    ensure_small("a relative transform is the two applied, x", u.x - v.x, 10.0 * math.EPSILON)
    ensure_small("a relative transform is the two applied, y", u.y - v.y, 10.0 * math.EPSILON)

    // Quaternions.
    axis = math.vec3(0.0, 0.0, 1.0)
    q1 = math.make_quat_from_axis_angle(axis, 0.0 - 0.5 * math.PI)
    q2 = math.compute_quat_between_unit_vectors(math.vec3(1.0, 0.0, 0.0), math.vec3(0.0, 0.0 - 1.0, 0.0))
    ensure_small("a quarter turn about z from an axis-angle and from two vectors agree, x", q1.x - q2.x, math.EPSILON)
    ensure_small("... y", q1.y - q2.y, math.EPSILON)
    ensure_small("... z", q1.z - q2.z, math.EPSILON)
    ensure_small("... s", q1.w - q2.w, math.EPSILON)

    q3 = math.normalize_quat(math.quat(1.0, 0.0 - 2.0, 3.0, 4.0))
    q4 = math.inv_mul_quat(q3, q1)
    q5 = math.mul_quat(q3, q4)
    ensure_small("q3 * (inv(q3) * q1) is q1, x", q1.x - q5.x, math.EPSILON)
    ensure_small("... y", q1.y - q5.y, math.EPSILON)
    ensure_small("... z", q1.z - q5.z, math.EPSILON)
    ensure_small("... s", q1.w - q5.w, math.EPSILON)

    q6 = math.compute_quat_between_unit_vectors(math.vec3(0.0, 1.0, 0.0), math.vec3(0.0, 0.0 - 1.0, 0.0))
    ensure_small("anti-parallel vectors give a half turn", q6.w, math.EPSILON)

    // The rotation between every pair of directions rotates one onto the
    // other, and its twist stays in range.
    v = math.normalize(math.vec3(0.2, 0.0 - 0.5, 3.0))
    pairs = 0
    z = 0.0 - 1.0
    while z <= 1.0 {
        y = 0.0 - 1.0
        while y <= 1.0 {
            x = 0.0 - 1.0
            while x <= 1.0 {
                if !(x == 0.0 && y == 0.0 && z == 0.0) {
                    u = math.normalize(math.vec3(x, y, z))
                    r = math.compute_quat_between_unit_vectors(v, u)
                    ensure("the rotation between two directions is valid", math.is_valid_quat(r))
                    w = math.rotate_vector(r, v)
                    ensure_small("the triple product identity", math.dot(math.qv(r), math.cross(u, w)) - math.scalar_triple_product(math.qv(r), u, w), math.EPSILON)
                    // Lots of round-off at large angles.
                    ensure_small("the rotation lands on the target, x", w.x - u.x, 0.001)
                    ensure_small("... y", w.y - u.y, 0.001)
                    ensure_small("... z", w.z - u.z, 0.001)
                    twist = math.get_twist_angle(r)
                    ensure("the twist angle is in range", 0.0 - math.PI <= twist && twist <= math.PI)
                    pairs = pairs + 1
                }
                x = x + 0.02
            }
            y = y + 0.02
        }
        z = z + 0.02
    }

    q = math.quat(0.0 - 0.0558656752, 0.0 - 0.188799798, 0.00689807534, 0.0 - 0.980401039)
    twist = math.get_twist_angle(q)
    ensure("a negative-polarity twist stays in range", 0.0 - math.PI <= twist && twist <= math.PI)
    swing = math.get_swing_angle(q)
    ensure("the swing angle is in range", 0.0 <= swing && swing <= math.PI)

    // Matrices.
    m = math.matrix3(math.vec3(3.0, 1.0, 0.0 - 1.0), math.vec3(0.0 - 1.0, 3.0, 1.0), math.vec3(1.0, 0.0 - 1.0, 3.0))
    mi = math.invert_matrix(m)
    id = math.mul_mm(m, mi)
    ensure_small("m * inv(m) is the identity, diagonal", id.cx.x - 1.0, 100.0 * math.EPSILON)
    ensure_small("m * inv(m) is the identity, off-diagonal", id.cy.x, 100.0 * math.EPSILON)
    ensure_small("... and the last diagonal", id.cz.z - 1.0, 100.0 * math.EPSILON)
    b = math.vec3(1.0, 2.0, 3.0)
    sol = math.solve3(m, b)
    back = math.mul_mv(m, sol)
    ensure_small("solve3 solves, x", back.x - b.x, 100.0 * math.EPSILON)
    ensure_small("solve3 solves, y", back.y - b.y, 100.0 * math.EPSILON)
    ensure_small("solve3 solves, z", back.z - b.z, 100.0 * math.EPSILON)
    mt = math.invert_t(m)
    tt = math.transpose(mi)
    ensure_small("invert_t is the transposed inverse", mt.cx.y - tt.cx.y, 100.0 * math.EPSILON)
    singular = math.matrix3(math.vec3(1.0, 2.0, 3.0), math.vec3(2.0, 4.0, 6.0), math.vec3(0.0, 1.0, 0.0))
    ensure("a singular matrix inverts to nothing", math.det(math.invert_matrix(singular)) == 0.0)
    // test_math.c's MathTest, the rest: every component of m inv(m), the
    // vector through m and back, inv(m) v against solve3.
    ensure_small("m * inv(m), cx.y", id.cx.y, math.EPSILON)
    ensure_small("m * inv(m), cx.z", id.cx.z, math.EPSILON)
    ensure_small("m * inv(m), cy.y", id.cy.y - 1.0, math.EPSILON)
    ensure_small("m * inv(m), cy.z", id.cy.z, math.EPSILON)
    ensure_small("m * inv(m), cz.x", id.cz.x, math.EPSILON)
    ensure_small("m * inv(m), cz.y", id.cz.y, math.EPSILON)
    v3 = math.vec3(1.0, 0.0 - 2.0, 3.0)
    round_trip = math.mul_mv(mi, math.mul_mv(m, v3))
    ensure_small("inv(m) m v is v", math.length(math.sub(round_trip, v3)), math.EPSILON)
    ensure_small("inv(m) v is solve3(m, v)", math.length(math.sub(math.mul_mv(mi, v3), math.solve3(m, v3))), math.EPSILON)
    // The 2x2: m inv(m), the vector there and back, inv(m) v against solve2.
    m2 = math.matrix2(math.vec2(3.0, 1.0), math.vec2(0.0 - 1.0, 3.0))
    mi2 = math.invert2(m2)
    c0 = math.mul_mv2(m2, mi2.cx)
    c1 = math.mul_mv2(m2, mi2.cy)
    ensure_small("2x2: m * inv(m), cx.x", c0.x - 1.0, math.EPSILON)
    ensure_small("2x2: m * inv(m), cx.y", c0.y, math.EPSILON)
    ensure_small("2x2: m * inv(m), cy.x", c1.x, math.EPSILON)
    ensure_small("2x2: m * inv(m), cy.y", c1.y - 1.0, math.EPSILON)
    v2 = math.vec2(1.0, 0.0 - 2.0)
    back2 = math.mul_mv2(mi2, math.mul_mv2(m2, v2))
    ensure_small("2x2: inv(m) m v is v, x", back2.x - v2.x, math.EPSILON)
    ensure_small("2x2: inv(m) m v is v, y", back2.y - v2.y, math.EPSILON)
    w2 = math.mul_mv2(mi2, v2)
    u2 = math.solve2(m2, v2)
    ensure_small("2x2: inv(m) v is solve2, x", w2.x - u2.x, math.EPSILON)
    ensure_small("2x2: inv(m) v is solve2, y", w2.y - u2.y, math.EPSILON)
    w2 = math.mul_mv2(m2, u2)
    ensure_small("2x2: m solve2(m, v) is v, x", w2.x - v2.x, 10.0 * math.EPSILON)
    ensure_small("2x2: m solve2(m, v) is v, y", w2.y - v2.y, 10.0 * math.EPSILON)
    ensure("2x2: a singular matrix inverts to zero", math.det2(math.invert2(math.matrix2(math.vec2(1.0, 2.0), math.vec2(2.0, 4.0)))) == 0.0)
    // The normalised lerp from the identity to a quarter turn about z: the
    // twist follows alpha to within a degree.
    q_end = math.make_quat_from_axis_angle(math.vec3_axis_z(), 0.5 * math.PI)
    i = 0
    while i <= 100 {
        alpha = (i as float) / 100.0
        twist_now = math.get_twist_angle(math.nlerp(math.quat_identity(), q_end, alpha))
        ensure_small("nlerp: the twist at ${alpha}", alpha * 0.5 * math.PI - twist_now, math.DEG_TO_RAD)
        i = i + 1
    }
    // The arbitrary perpendicular of the reference's unit normal.
    normal = math.vec3(0.504055440, 0.621548057, 0.599671543)
    ensure_small("arbitrary_perp is perpendicular", math.dot(normal, math.arbitrary_perp(normal)), 2.0 * math.EPSILON)
    ensure_small("arbitrary_perp is unit", math.length(math.arbitrary_perp(normal)) - 1.0, math.EPSILON)

    // A rotation as a matrix and back.
    q = math.normalize_quat(math.quat(0.3, 0.0 - 0.4, 0.5, 0.7))
    rm = math.make_matrix_from_quat(q)
    ensure_small("a rotation matrix has determinant one", math.det(rm) - 1.0, 10.0 * math.EPSILON)
    rv = math.mul_mv(rm, b)
    qv = math.rotate_vector(q, b)
    ensure_small("the matrix rotates as the quaternion, x", rv.x - qv.x, 10.0 * math.EPSILON)
    ensure_small("... z", rv.z - qv.z, 10.0 * math.EPSILON)
    qb = math.make_quat_from_matrix(rm)
    if math.dot_quat(qb, q) < 0.0 { qb = math.negate_quat(qb) }
    ensure_small("the quaternion comes back from its matrix, x", qb.x - q.x, 10.0 * math.EPSILON)
    ensure_small("... s", qb.w - q.w, 10.0 * math.EPSILON)

    // Inertia: a sphere's is the same about every axis, a box's follows
    // its sides, a point mass offset adds the parallel-axis terms.
    si = math.sphere_inertia(2.0, 0.5)
    ensure_small("a sphere's inertia", si.cx.x - 0.4 * 2.0 * 0.25, math.EPSILON)
    bi = math.box_inertia(1.0, math.vec3(0.0 - 1.0, 0.0 - 2.0, 0.0 - 3.0), math.vec3(1.0, 2.0, 3.0))
    ensure("a box's inertia is largest about its shortest side", bi.cx.x > bi.cz.z)
    st = math.steiner(3.0, math.vec3(1.0, 0.0, 0.0))
    ensure_small("an offset along x adds nothing about x", st.cx.x, math.EPSILON)
    ensure_small("... and m d^2 about y", st.cy.y - 3.0, math.EPSILON)

    // Boxes.
    pts_block = calloc(9, 8)
    pts = pts_block as float[]
    pts[0] = 1.0
    pts[1] = 2.0
    pts[2] = 3.0
    pts[3] = 0.0 - 1.0
    pts[4] = 0.0
    pts[5] = 5.0
    pts[6] = 0.0
    pts[7] = 0.0 - 4.0
    pts[8] = 0.0
    box = math.make_aabb(pts, 3, 0.5)
    free(pts_block)
    ensure("a point cloud's box holds every point, lower", box.lower.x == 0.0 - 1.5 && box.lower.y == 0.0 - 4.5 && box.lower.z == 0.0 - 0.5)
    ensure("... upper", box.upper.x == 1.5 && box.upper.y == 2.5 && box.upper.z == 5.5)
    ensure("the box is valid", math.is_valid_aabb(box) && math.is_sane_aabb(box))
    inner = math.aabb(math.vec3(0.0, 0.0, 0.0), math.vec3(1.0, 1.0, 1.0))
    ensure("a box contains a box inside it", math.aabb_contains(box, inner))
    ensure("and not one outside", !math.aabb_contains(inner, box))
    ensure("overlapping boxes overlap", math.aabb_overlaps(box, inner))
    far = math.aabb(math.vec3(10.0, 10.0, 10.0), math.vec3(11.0, 11.0, 11.0))
    ensure("separated boxes do not", !math.aabb_overlaps(box, far))
    joined = math.aabb_union(inner, far)
    ensure("a union spans both", joined.lower.x == 0.0 && joined.upper.x == 11.0)
    ensure("the empty box unions to the other", math.aabb_union(math.aabb_empty(), far).lower.x == 10.0)
    ensure_small("a unit cube's area is six", math.aabb_area(inner) - 6.0, math.EPSILON)
    turned = math.aabb_transform(math.transform(math.vec3(0.0, 0.0, 0.0), math.make_quat_from_axis_angle(math.vec3(0.0, 0.0, 1.0), 0.25 * math.PI)), inner)
    ensure("a turned box's box is wider than the box", turned.upper.x - turned.lower.x > 1.0 && turned.upper.x - turned.lower.x < 1.5)
    ensure("the closest point to a box is clamped", math.closest_point_to_aabb(math.vec3(5.0, 0.5, 0.0 - 3.0), inner).x == 1.0)

    // Segments.
    cp = math.point_to_segment_distance(math.vec3(0.0, 0.0, 0.0), math.vec3(2.0, 0.0, 0.0), math.vec3(1.0, 1.0, 0.0))
    ensure("the closest point on a segment is the projection", cp.x == 1.0 && cp.y == 0.0)
    cp = math.point_to_segment_distance(math.vec3(0.0, 0.0, 0.0), math.vec3(2.0, 0.0, 0.0), math.vec3(5.0, 1.0, 0.0))
    ensure("and an end past the end", cp.x == 2.0)
    sd = math.segment_distance(math.vec3(0.0, 0.0, 0.0), math.vec3(2.0, 0.0, 0.0), math.vec3(1.0, 1.0, 0.0 - 1.0), math.vec3(1.0, 1.0, 1.0))
    ensure_small("crossing segments meet above each other, fraction 1", sd.fraction1 - 0.5, 10.0 * math.EPSILON)
    ensure_small("... fraction 2", sd.fraction2 - 0.5, 10.0 * math.EPSILON)
    ensure_small("... a unit apart", math.distance(sd.point1, sd.point2) - 1.0, 10.0 * math.EPSILON)
    ld = math.line_distance(math.vec3(0.0, 0.0, 0.0), math.vec3(1.0, 0.0, 0.0), math.vec3(0.0, 1.0, 5.0), math.vec3(0.0, 0.0, 1.0))
    ensure_small("skew lines' closest points", ld.point1.x, 10.0 * math.EPSILON)
    ensure_small("... on the second line", ld.point2.z, 10.0 * math.EPSILON)

    // Validity.
    ensure("a number is valid", math.is_valid_float(1.5))
    inf = math.MAX_FLOAT * math.MAX_FLOAT * math.MAX_FLOAT * math.MAX_FLOAT * math.MAX_FLOAT * math.MAX_FLOAT * math.MAX_FLOAT * math.MAX_FLOAT * math.MAX_FLOAT
    ensure("infinity is not", !math.is_valid_float(inf))
    ensure("nor NaN", !math.is_valid_float(inf - inf))
    ensure("a unit quaternion is valid", math.is_valid_quat(q))
    ensure("an unnormalised one is not", !math.is_valid_quat(math.quat(1.0, 1.0, 1.0, 1.0)))
    ensure("a plane with a unit normal is valid", math.is_valid_plane(math.plane(math.vec3(0.0, 1.0, 0.0), 2.0)))
    ensure("one without is not", !math.is_valid_plane(math.plane(math.vec3(0.0, 2.0, 0.0), 2.0)))
    ensure("a box beyond HUGE is not bounded", !math.is_bounded_aabb(math.aabb(math.vec3(0.0, 0.0, 0.0), math.vec3(1000000000.0, 0.0, 0.0))))
    ensure("a perpendicular is perpendicular and unit", math.abs_float(math.dot(math.perp(v), v)) < 10.0 * math.EPSILON && math.is_normalized(math.perp(v)))
    ensure("safe scale keeps a scale off zero", math.safe_scale(math.vec3(0.0, 0.0 - 0.001, 2.0)).y == 0.0 - math.MIN_SCALE)

    single_precision()
    outward_rounding()
    println("math: ${checks} checks, ${pairs} direction pairs; cos/sin off libm by at most ${worst_cs}, atan2 by ${worst_atan}")
    if failures == 0 {
        println("math: all checks passed")
    } else {
        println("math: ${failures} failure(s)")
        exit(1)
    }
}
