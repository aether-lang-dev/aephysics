// aephysics.physics_world against the reference's tests: test_world.c's
// HelloWorld (a cube on the ground after ninety steps), the contact
// events of a bouncing sphere, the hit events with their materials, a
// ball stopped by a thin wall with its move event matching its
// transform, a sensor swept by a bullet (one begin, one end), an
// explosion pushing a sphere the same near and far from the origin;
// test_body_query.c's casts, overlaps and mover queries against one
// body at a transform of the caller's, far from the origin too; the
// world queries over every shape; a wave pile stepping alike twice,
// with its sleep step as the checksum; and the hull database
// (TestHullDatabase, #147).
import std.string
import aephysics.math
import aephysics.basics
import aephysics.dynamic_tree
import aephysics.hull
import aephysics.manifold
import aephysics.mesh
import aephysics.height_field
import aephysics.compound
import aephysics.material
import aephysics.shape
import aephysics.distance
import aephysics.broad_phase
import aephysics.dynamics
import aephysics.physics_world
import aephysics.native
import aephysics.joint_solver

extern exit(code: int)
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern cos(x: float) -> float
extern sin(x: float) -> float
extern sqrt(x: float) -> float

var failures = 0
var checks = 0

ensure(name: string, ok: bool) {
    checks = checks + 1
    if !ok {
        println("physics_world: FAIL ${name}")
        failures = failures + 1
    }
}

small(name: string, value: float, tolerance: float) {
    ensure("${name} (${value})", math.abs_float(value) < tolerance)
}

same_shape(a: ShapeId, b: ShapeId) -> bool { return a.index1 == b.index1 && a.world0 == b.world0 && a.generation == b.generation }
same_body(a: BodyId, b: BodyId) -> bool { return a.index1 == b.index1 && a.world0 == b.world0 && a.generation == b.generation }

identity_at(x: float, y: float, z: float) -> Transform { return Transform { p: math.vec3(x, y, z), q: math.quat_identity() } }

var g_point: ptr = null   // Vec3[1]: a one-point proxy's point

point_proxy(p: Vec3, radius: float) -> ShapeProxy {
    if g_point == null { g_point = basics.alloc(sizeof(Vec3)) }
    points = g_point as Vec3[]
    points[0] = p
    return distance.shape_proxy(g_point, 1, radius)
}

// --- test_world.c ------------------------------------------------------------------------------------------------

test_hello_world() {
    wdef = dynamics.default_world_def()
    wdef.gravity = math.vec3(0.0, 0.0 - 10.0, 0.0)
    world_id = dynamics.create_world(&wdef)
    ensure("hello: a valid world", physics_world.is_valid(world_id))
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 10.0, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    ground_box = hull.make_box_hull(50.0, 10.0, 50.0)
    gsdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(ground, &gsdef, ground_box)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.position = math.vec3(0.0, 4.0, 0.0)
    body = dynamics.create_body(world_id, &bdef)
    cube = hull.make_box_hull(1.0, 1.0, 1.0)
    sdef = dynamics.default_shape_def()
    sdef.density = 1.0
    sdef.base_material.friction = 0.3
    dynamics.create_hull_shape(body, &sdef, cube)
    i = 0
    while i < 90 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        i = i + 1
    }
    position = dynamics.body_get_position(body)
    rotation = dynamics.body_get_rotation(body)
    dynamics.destroy_world(world_id)
    small("hello: resting a unit above the ground", position.y - 1.0, 0.01)
    small("hello: upright x", rotation.x, 0.01)
    small("hello: upright z", rotation.z, 0.01)
    ensure("hello: the world is gone", physics_world.is_valid(world_id) == false && physics_world.body_event_count(world_id) == 0)
    hull.destroy_hull(ground_box)
    hull.destroy_hull(cube)
}

test_contact_events() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 0.5, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    ground_box = hull.make_box_hull(10.0, 0.5, 10.0)
    gsdef = dynamics.default_shape_def()
    ground_shape = dynamics.create_hull_shape(ground, &gsdef, ground_box)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.position = math.vec3(0.0, 5.0, 0.0)
    ball = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    sdef.density = 1.0
    sdef.enable_contact_events = true
    sdef.base_material.restitution = 0.6
    ball_shape = dynamics.create_sphere_shape(ball, &sdef, manifold.sphere(math.vec3_zero(), 0.5))
    begins = 0
    ends = 0
    ids_checked = false
    i = 0
    while i < 120 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        begin_count = physics_world.contact_begin_event_count(world_id)
        if begin_count > 0 && ids_checked == false {
            be = physics_world.contact_begin_event(world_id, 0)
            a_ball = same_shape(be.shape_id_a, ball_shape)
            b_ball = same_shape(be.shape_id_b, ball_shape)
            a_ground = same_shape(be.shape_id_a, ground_shape)
            b_ground = same_shape(be.shape_id_b, ground_shape)
            ensure("events: the pair", (a_ball && b_ground) || (a_ground && b_ball))
            ensure("events: a valid contact id", dynamics.contact_is_valid(be.contact_id))
            ids_checked = true
        }
        begins = begins + begin_count
        ends = ends + physics_world.contact_end_event_count(world_id)
        i = i + 1
    }
    dynamics.destroy_world(world_id)
    ensure("events: ids checked", ids_checked)
    ensure("events: began (${begins}) and ended (${ends}) touching", begins >= 1 && ends >= 1)
    hull.destroy_hull(ground_box)
}

// The pre-solve callback on an ordinary contact (b3UpdateConvexContact):
// a platform whose callback says no is passed through, the one-way
// platform; one that says yes holds the box. It was consulted only by the
// continuous sweep, so a box falling at normal speed landed either way.
var g_pre_solve_answer = false
var g_pre_solve_calls = 0

pre_solve_answer(shape_a: ShapeId, shape_b: ShapeId, point: Vec3, normal: Vec3, context: ptr) -> bool {
    g_pre_solve_calls = g_pre_solve_calls + 1
    return g_pre_solve_answer
}

pre_solve_drop(answer: bool) -> float {
    g_pre_solve_answer = answer
    g_pre_solve_calls = 0
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    physics_world.set_pre_solve_callback(world_id, pre_solve_answer, null)
    gdef = dynamics.default_body_def()
    platform = dynamics.create_body(world_id, &gdef)
    slab = hull.make_box_hull(4.0, 0.1, 4.0)
    gsdef = dynamics.default_shape_def()
    gsdef.enable_pre_solve_events = true
    dynamics.create_hull_shape(platform, &gsdef, slab)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.position = math.vec3(0.0, 1.0, 0.0)
    box_body = dynamics.create_body(world_id, &bdef)
    cube = hull.make_box_hull(0.25, 0.25, 0.25)
    sdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(box_body, &sdef, cube)
    i = 0
    while i < 90 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        i = i + 1
    }
    y = dynamics.body_get_position(box_body).y
    dynamics.destroy_world(world_id)
    hull.destroy_hull(slab)
    hull.destroy_hull(cube)
    return y
}

test_pre_solve() {
    through = pre_solve_drop(false)
    ensure("pre-solve: consulted (${g_pre_solve_calls})", g_pre_solve_calls > 0)
    ensure("pre-solve: no passes the box through (y ${through})", through < 0.0 - 1.0)
    held = pre_solve_drop(true)
    ensure("pre-solve: yes holds the box (y ${held})", held > 0.3 && held < 0.4)
}

// A mesh flattened by a zero scale is clamped to the smallest scale (the
// reference's b3SafeScale) rather than divided by: a ray down onto it
// hits, where it used to miss.
test_mesh_scale() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    grid = mesh.create_grid_mesh(8, 8, 1.0, 1, true)
    bdef = dynamics.default_body_def()
    ground = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    flat = dynamics.create_mesh_shape(ground, &sdef, grid, math.vec3(1.0, 0.0, 1.0))
    out = physics_world.shape_ray_cast(flat, math.vec3(0.3, 5.0, 0.2), math.vec3(0.0, 0.0 - 10.0, 0.0))
    ensure("mesh scale: a ray hits the flattened mesh (${out.hit}, ${out.fraction})", out.hit && math.abs_float(out.fraction - 0.5) < 0.01 && out.normal.y > 0.99)
    dynamics.shape_set_mesh(flat, grid, math.vec3(1.0, 0.0, 1.0))
    out = physics_world.shape_ray_cast(flat, math.vec3(0.3, 5.0, 0.2), math.vec3(0.0, 0.0 - 10.0, 0.0))
    ensure("mesh scale: and once set again", out.hit && math.abs_float(out.fraction - 0.5) < 0.01)
    dynamics.destroy_world(world_id)
    mesh.destroy_mesh(grid)
}

// The step a body falls asleep, its move event says so (b3TrySleepIsland);
// it used to read false on every event, so a sync that drops sleeping
// bodies never saw one go.
test_fell_asleep() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    w = dynamics.get_world(world_id.index1 - 1)
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 0.5, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    slab = hull.make_box_hull(4.0, 0.5, 4.0)
    sdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(ground, &sdef, slab)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.position = math.vec3(0.0, 0.3, 0.0)
    box_body = dynamics.create_body(world_id, &bdef)
    cube = hull.make_box_hull(0.25, 0.25, 0.25)
    dynamics.create_hull_shape(box_body, &sdef, cube)
    slept_step = 0 - 1
    reported = false
    i = 0
    while i < 600 && slept_step < 0 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        if dynamics.body_is_awake(box_body) == false {
            slept_step = i
            j = 0
            while j < dynamics.world_body_move_event_count(w) {
                event = dynamics.world_body_move_event(w, j)
                if event.body_id.index1 == box_body.index1 && event.fell_asleep { reported = true }
                j = j + 1
            }
        }
        i = i + 1
    }
    ensure("fell asleep: the box slept (step ${slept_step})", slept_step >= 0)
    ensure("fell asleep: that step's move event says so", reported)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(slab)
    hull.destroy_hull(cube)
}

// A static shape made to touch a resting body, then the static tree
// rebuilt before the step: the full build keeps the new proxy's moved
// flag (Box3D 79fc559), so the pair is still found.
test_rebuilt_static_pairs() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    w = dynamics.get_world(world_id.index1 - 1)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.gravity_scale = 0.0
    bdef.position = math.vec3(0.0, 0.5, 0.0)
    box_body = dynamics.create_body(world_id, &bdef)
    cube = hull.make_box_hull(0.5, 0.5, 0.5)
    sdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(box_body, &sdef, cube)
    physics_world.step(world_id, 1.0 / 60.0, 4)
    physics_world.step(world_id, 1.0 / 60.0, 4)
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 0.49, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    slab = hull.make_box_hull(4.0, 0.5, 4.0)
    dynamics.create_hull_shape(ground, &sdef, slab)
    physics_world.rebuild_static_tree(world_id)
    physics_world.step(world_id, 1.0 / 60.0, 4)
    ensure("rebuilt static tree: the new pair found (${dynamics.world_contact_count(w)} contacts)", dynamics.world_contact_count(w) == 1)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(cube)
    hull.destroy_hull(slab)
}

// test_world.c's EmptyWorld: an empty world steps 60 times and is gone
// once destroyed.
test_empty_world() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    ensure("empty world: valid", dynamics.world_is_valid(world_id))
    i = 0
    while i < 60 {
        physics_world.step(world_id, 1.0 / 60.0, 1)
        i = i + 1
    }
    dynamics.destroy_world(world_id)
    ensure("empty world: gone", dynamics.world_is_valid(world_id) == false)
}

// DestroyAllBodiesWorld: ten bodies made one a step, then destroyed one a
// step, stepping all along; none left by the counters.
test_destroy_all_bodies_world() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    ids_block = calloc(10, sizeof(BodyId))
    ids = ids_block as BodyId[]
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    cube = hull.make_cube_hull(0.5)
    count = 0
    creating = true
    i = 0
    while i < 2 * 10 + 10 {
        if creating {
            if count < 10 {
                ids[count] = dynamics.create_body(world_id, &bdef)
                sdef = dynamics.default_shape_def()
                dynamics.create_hull_shape(ids[count], &sdef, cube)
                count = count + 1
            } else {
                creating = false
            }
        } else if count > 0 {
            dynamics.destroy_body(ids[count - 1])
            count = count - 1
        }
        physics_world.step(world_id, 1.0 / 60.0, 3)
        i = i + 1
    }
    ensure("destroy all bodies: none left (${physics_world.get_counters(world_id).body_count})", physics_world.get_counters(world_id).body_count == 0)
    dynamics.destroy_world(world_id)
    ensure("destroy all bodies: the world gone", dynamics.world_is_valid(world_id) == false)
    hull.destroy_hull(cube)
    free(ids_block)
}

// TestWorldRecycle: half the worlds, each with a body and ten steps, made
// and destroyed a hundred times over.
test_world_recycle() {
    count = dynamics.MAX_WORLDS / 2
    ids_block = calloc(count, sizeof(WorldId))
    ids = ids_block as WorldId[]
    all_valid = true
    all_gone = true
    round = 0
    while round < 100 {
        wdef = dynamics.default_world_def()
        j = 0
        while j < count {
            ids[j] = dynamics.create_world(&wdef)
            if dynamics.world_is_valid(ids[j]) == false { all_valid = false }
            bdef = dynamics.default_body_def()
            dynamics.create_body(ids[j], &bdef)
            j = j + 1
        }
        j = 0
        while j < count {
            k = 0
            while k < 10 {
                physics_world.step(ids[j], 1.0 / 60.0, 1)
                k = k + 1
            }
            j = j + 1
        }
        j = count - 1
        while j >= 0 {
            dynamics.destroy_world(ids[j])
            if dynamics.world_is_valid(ids[j]) { all_gone = false }
            j = j - 1
        }
        round = round + 1
    }
    ensure("world recycle: every world valid when made", all_valid)
    ensure("world recycle: every world gone when destroyed", all_gone)
    free(ids_block)
}

var g_filter_context_null = true

filter_all(a: ShapeId, b: ShapeId, context: ptr) -> bool {
    if context != null { g_filter_context_null = false }
    return true
}

pre_solve_none(a: ShapeId, b: ShapeId, point: Vec3, normal: Vec3, context: ptr) -> bool {
    if context != null { g_filter_context_null = false }
    return false
}

// TestWorldCoverage: every world setting set and read back, the callbacks
// set, an explosion over an empty world, and a step of a whole second.
test_world_coverage() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    physics_world.enable_sleeping(world_id, true)
    physics_world.enable_sleeping(world_id, false)
    ensure("coverage: sleeping off", physics_world.is_sleeping_enabled(world_id) == false)
    physics_world.enable_continuous(world_id, false)
    physics_world.enable_continuous(world_id, true)
    ensure("coverage: continuous on", physics_world.is_continuous_enabled(world_id))
    physics_world.set_restitution_threshold(world_id, 0.0)
    physics_world.set_restitution_threshold(world_id, 2.0)
    ensure("coverage: restitution threshold", physics_world.get_restitution_threshold(world_id) == 2.0)
    physics_world.set_hit_event_threshold(world_id, 0.0)
    physics_world.set_hit_event_threshold(world_id, 100.0)
    ensure("coverage: hit event threshold", physics_world.get_hit_event_threshold(world_id) == 100.0)
    physics_world.set_custom_filter_callback(world_id, filter_all, null)
    physics_world.set_pre_solve_callback(world_id, pre_solve_none, null)
    g = math.vec3(1.0, 2.0, 0.0)
    physics_world.set_gravity(world_id, g)
    v = physics_world.get_gravity(world_id)
    ensure("coverage: gravity", v.x == g.x && v.y == g.y)
    edef = physics_world.default_explosion_def()
    physics_world.explode(world_id, &edef)
    physics_world.set_contact_tuning(world_id, 10.0, 2.0, 4.0)
    physics_world.set_maximum_linear_speed(world_id, 10.0)
    ensure("coverage: maximum linear speed", physics_world.get_maximum_linear_speed(world_id) == 10.0)
    physics_world.enable_warm_starting(world_id, true)
    ensure("coverage: warm starting on", physics_world.is_warm_starting_enabled(world_id))
    ensure("coverage: nothing awake", physics_world.get_awake_body_count(world_id) == 0)
    marker = calloc(1, 8)
    physics_world.set_user_data(world_id, marker)
    ensure("coverage: user data", physics_world.get_user_data(world_id) == marker)
    physics_world.step(world_id, 1.0, 1)
    ensure("coverage: the callbacks saw no context", g_filter_context_null)
    dynamics.destroy_world(world_id)
    free(marker)
}

// SetBulletDriftTest: the bullet flag set or cleared after creation holds
// through set_motion_locks, which syncs the body's flags to its sim.
test_set_bullet_drift() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.is_bullet = false
    a = dynamics.create_body(world_id, &bdef)
    ensure("bullet drift: made plain", dynamics.body_is_bullet(a) == false)
    dynamics.body_set_bullet(a, true)
    ensure("bullet drift: set", dynamics.body_is_bullet(a))
    locks = MotionLocks { linear_x: true, linear_y: false, linear_z: false, angular_x: false, angular_y: false, angular_z: false }
    dynamics.body_set_motion_locks(a, locks)
    ensure("bullet drift: still a bullet after the motion locks", dynamics.body_is_bullet(a))
    bdef.is_bullet = true
    b = dynamics.create_body(world_id, &bdef)
    ensure("bullet drift: made a bullet", dynamics.body_is_bullet(b))
    dynamics.body_set_bullet(b, false)
    ensure("bullet drift: cleared", dynamics.body_is_bullet(b) == false)
    dynamics.body_set_motion_locks(b, locks)
    ensure("bullet drift: still plain after the motion locks", dynamics.body_is_bullet(b) == false)
    dynamics.destroy_world(world_id)
}

// EnableSleepFlagSyncTest and EnableContactRecyclingTest: flags made off
// in the def, turned on, read back, and a step taken.
test_def_flags() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.enable_sleep = false
    sleeper = dynamics.create_body(world_id, &bdef)
    ensure("sleep flag: off from the def", dynamics.body_is_sleep_enabled(sleeper) == false)
    dynamics.body_enable_sleep(sleeper, true)
    ensure("sleep flag: on", dynamics.body_is_sleep_enabled(sleeper))
    bdef.enable_sleep = true
    recycler = dynamics.create_body(world_id, &bdef)
    ensure("recycling: on by default", dynamics.body_is_contact_recycling_enabled(recycler))
    dynamics.body_enable_contact_recycling(recycler, false)
    ensure("recycling: off", dynamics.body_is_contact_recycling_enabled(recycler) == false)
    dynamics.body_enable_contact_recycling(recycler, true)
    ensure("recycling: on again", dynamics.body_is_contact_recycling_enabled(recycler))
    bdef.enable_contact_recycling = false
    opted_out = dynamics.create_body(world_id, &bdef)
    ensure("recycling: off from the def", dynamics.body_is_contact_recycling_enabled(opted_out) == false)
    physics_world.step(world_id, 1.0 / 60.0, 4)
    ensure("def flags: valid after a step", dynamics.validate_solver_sets(dynamics.get_world(world_id.index1 - 1)))
    dynamics.destroy_world(world_id)
}

// TestCompoundShapeCount: the world's compound count back to zero both
// when the shape is destroyed and when its body takes it away.
test_compound_shape_count() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    w = dynamics.get_world(world_id.index1 - 1)
    ensure("compound count: none at first", w.compound_shape_count == 0)
    box = hull.make_box_hull(1.0, 1.0, 1.0)
    hulls_block = calloc(1, sizeof(CompoundHullDef))
    hulls = hulls_block as CompoundHullDef[]
    hulls[0] = compound.compound_hull_def(box, math.transform_identity(), material.default_surface_material())
    cdef = compound.compound_def()
    cdef.hulls = hulls_block
    cdef.hull_count = 1
    c = compound.create_compound(&cdef)
    ensure("compound count: the compound made", c != null)
    bdef = dynamics.default_body_def()
    sdef = dynamics.default_shape_def()
    body = dynamics.create_body(world_id, &bdef)
    shape_id = dynamics.create_compound_shape(body, &sdef, c)
    ensure("compound count: one", w.compound_shape_count == 1)
    dynamics.destroy_shape(shape_id, true)
    ensure("compound count: none after the shape is destroyed", w.compound_shape_count == 0)
    dynamics.destroy_body(body)
    body = dynamics.create_body(world_id, &bdef)
    dynamics.create_compound_shape(body, &sdef, c)
    ensure("compound count: one again", w.compound_shape_count == 1)
    dynamics.destroy_body(body)
    ensure("compound count: none after its body is destroyed", w.compound_shape_count == 0)
    dynamics.destroy_world(world_id)
    compound.destroy_compound(c)
    hull.destroy_hull(box)
    free(hulls_block)
}

moved_node_count(t: *DynamicTree) -> int {
    nodes = t.nodes as DynamicTreeNode[]
    count = 0
    i = 0
    while i < t.node_end {
        flag = nodes[i].flag_index
        if dynamic_tree.is_empty_node(flag) == false && dynamic_tree.is_node_moved(flag) { count = count + 1 }
        i = i + 1
    }
    return count
}

// TestEnlargedProxyDestroyed: a proxy enlarged in one step whose body is
// destroyed before the next leaves no node marked moved, and the next
// step leaves the tree in depth-first order (the reference's issue 149).
test_enlarged_proxy_destroyed() {
    wdef = dynamics.default_world_def()
    wdef.gravity = math.vec3_zero()
    world_id = dynamics.create_world(&wdef)
    w = dynamics.get_world(world_id.index1 - 1)
    trees = w.broad_phase.trees as DynamicTree[]
    tree = &trees[dynamics.BODY_DYNAMIC]
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    sdef = dynamics.default_shape_def()
    ball = manifold.sphere(math.vec3_zero(), 0.25)
    // Resting bodies keep the tree deep enough that the mover has an
    // ancestor that outlives it.
    i = 0
    while i < 8 {
        bdef.position = math.vec3(2.0 * (i as float), 0.0, 0.0)
        resting = dynamics.create_body(world_id, &bdef)
        dynamics.create_sphere_shape(resting, &sdef, ball)
        i = i + 1
    }
    // This one outruns its margin every step.
    bdef.position = math.vec3(7.0, 1.0, 0.0)
    bdef.linear_velocity = math.vec3(6.0, 0.0, 0.0)
    mover = dynamics.create_body(world_id, &bdef)
    dynamics.create_sphere_shape(mover, &sdef, ball)
    physics_world.step(world_id, 1.0 / 60.0, 4)
    ensure("enlarged proxy: the step marked nodes moved (${moved_node_count(tree)})", moved_node_count(tree) > 0)
    dynamics.destroy_body(mover)
    ensure("enlarged proxy: the tree valid with nothing marked after the destroy", dynamic_tree.tree_validate(tree) && moved_node_count(tree) == 0)
    physics_world.step(world_id, 1.0 / 60.0, 4)
    ensure("enlarged proxy: nothing marked after the next step", moved_node_count(tree) == 0)
    ensure("enlarged proxy: depth-first order after the next step", tree.dfs_ordered)
    dynamics.destroy_world(world_id)
}

// test_id.c's IdTest: a 64-bit value through a body, shape and joint id
// and back, and a world id through its 32 bits.
test_ids() {
    x = (0x01234567 as long) << 32 | (0x89ABCDEF as long)
    ensure("ids: a body id stores what it loaded", dynamics.store_body_id(dynamics.load_body_id(x)) == x)
    ensure("ids: a shape id stores what it loaded", dynamics.store_shape_id(dynamics.load_shape_id(x)) == x)
    ensure("ids: a joint id stores what it loaded", dynamics.store_joint_id(dynamics.load_joint_id(x)) == x)
    b = dynamics.load_body_id(x)
    ensure("ids: the index high, the world and generation below", b.index1 == 0x01234567 && b.world0 == 0x89AB && b.generation == 0xCDEF)
    wid = WorldId { index1: 3, generation: 517 }
    back = dynamics.load_world_id(dynamics.store_world_id(wid))
    ensure("ids: a world id through 32 bits", back.index1 == 3 && back.generation == 517)
    // test_manifold.c's MaxPointCountTest.
    ensure("the most points a manifold holds", dynamics.get_max_manifold_points() == dynamics.MAX_MANIFOLD_POINTS && dynamics.MAX_MANIFOLD_POINTS == 4)
}

// test_world.c's TestOverflowColorPile (shared/overflow_color.c): 25 boxes
// in five rings about a tall heavy hub, each touching it from the first
// step, more dynamic contacts on one body than the dynamic colours hold, so
// some go to the overflow colour; ten steps through the overflow's solve.
// The awake contact count is the reference's: the graph's contacts and
// the awake non-touching ones.
test_overflow_color_pile() {
    wdef = dynamics.default_world_def()
    wdef.worker_count = 1
    world_id = dynamics.create_world(&wdef)
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 1.0, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    slab = hull.make_box_hull(20.0, 1.0, 20.0)
    sdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(ground, &sdef, slab)
    hub_half_x = 0.5
    hub_half_y = 2.5
    hdef = dynamics.default_body_def()
    hdef.kind = dynamics.BODY_DYNAMIC
    hdef.position = math.vec3(0.0, hub_half_y, 0.0)
    hub = dynamics.create_body(world_id, &hdef)
    hub_box = hull.make_box_hull(hub_half_x, hub_half_y, 0.5)
    hsdef = dynamics.default_shape_def()
    hsdef.density = 50.0
    dynamics.create_hull_shape(hub, &hsdef, hub_box)
    neighbor_half = 0.2
    ring_radius = hub_half_x + neighbor_half - 0.03
    neighbor_box = hull.make_box_hull(neighbor_half, neighbor_half, neighbor_half)
    ndef = dynamics.default_shape_def()
    ring = 0
    while ring < 5 {
        y = neighbor_half + 0.05 + 0.5 * (ring as float)
        offset = 0.0
        if (ring & 1) != 0 { offset = math.PI / 5.0 }
        slot = 0
        while slot < 5 {
            theta = offset + (2.0 * math.PI * (slot as float)) / 5.0
            bdef = dynamics.default_body_def()
            bdef.kind = dynamics.BODY_DYNAMIC
            bdef.position = math.vec3(ring_radius * cos(theta), y, ring_radius * sin(theta))
            body = dynamics.create_body(world_id, &bdef)
            dynamics.create_hull_shape(body, &ndef, neighbor_box)
            slot = slot + 1
        }
        ring = ring + 1
    }
    i = 0
    while i < 10 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        i = i + 1
    }
    counters = physics_world.get_counters(world_id)
    overflow = counters.color_counts[dynamics.GRAPH_COLOR_COUNT - 1]
    ensure("overflow pile: some contacts in the overflow colour (${overflow})", overflow > 0)
    in_colors = 0
    k = 0
    while k < dynamics.GRAPH_COLOR_COUNT {
        in_colors = in_colors + counters.color_counts[k]
        k = k + 1
    }
    w = dynamics.get_world(world_id.index1 - 1)
    non_touching = dynamics.get_solver_set(w, dynamics.AWAKE_SET).contact_indices.count
    ensure("overflow pile: the colours hold every touching contact (${in_colors} of ${counters.contact_count}, ${non_touching} not touching)",
           in_colors + non_touching == counters.contact_count)
    ensure("overflow pile: the awake contacts are the graph's and the non-touching (${counters.awake_contact_count})",
           counters.awake_contact_count == counters.contact_count)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(slab)
    hull.destroy_hull(hub_box)
    hull.destroy_hull(neighbor_box)
}

// test_world.c's TestSetWorkerCount: the count set between steps, 1 to 4,
// 4 again, then 0 and -5 (each becomes 1) and past the cap (becomes it),
// clamped as the reference clamps it. The reference moves its junkyard's
// pusher between the changes; here a pile steps between them, and the
// steps of every count give the run of one worker throughout, bit for bit.
pile_world(worker_count: int, slab: *HullData, cube: *HullData) -> WorldId {
    wdef = dynamics.default_world_def()
    wdef.worker_count = worker_count
    world_id = dynamics.create_world(&wdef)
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 0.5, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    sdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(ground, &sdef, slab)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    i = 0
    while i < 64 {
        bdef.position = math.vec3(((i % 4) as float) * 1.1 - 1.6, 0.5 + 1.05 * ((i / 16) as float), (((i / 4) % 4) as float) * 1.1 - 1.6)
        body = dynamics.create_body(world_id, &bdef)
        dynamics.create_hull_shape(body, &sdef, cube)
        i = i + 1
    }
    return world_id
}

pile_sum(world_id: WorldId) -> float {
    w = dynamics.get_world(world_id.index1 - 1)
    sum = 0.0
    i = 0
    while i < w.bodies.count {
        body = dynamics.body_at(w, i)
        if body.set_index != dynamics.NULL_INDEX && body.kind == dynamics.BODY_DYNAMIC {
            p = dynamics.get_body_sim(w, body).transform.p
            sum = sum + p.x * 3.0 + p.y * 5.0 + p.z * 7.0
        }
        i = i + 1
    }
    return sum
}

test_set_worker_count() {
    slab = hull.make_box_hull(10.0, 0.5, 10.0)
    cube = hull.make_cube_hull(0.5)
    world_id = pile_world(1, slab, cube)
    ensure("worker count: one", physics_world.get_worker_count(world_id) == 1)
    steps_block = calloc(6, 4)
    counts = steps_block as int[]
    counts[0] = 4
    counts[1] = 4
    counts[2] = 0
    counts[3] = 0 - 5
    counts[4] = native.MAX_WORKERS + 10
    counts[5] = 2
    expected = [ 4, 4, 1, 1, native.MAX_WORKERS, 2 ]
    physics_world.step(world_id, 1.0 / 60.0, 4)
    i = 0
    while i < 6 {
        physics_world.set_worker_count(world_id, counts[i])
        got = physics_world.get_worker_count(world_id)
        ensure("worker count: set ${counts[i]}, gets ${got}", got == expected[i])
        j = 0
        while j < 5 {
            physics_world.step(world_id, 1.0 / 60.0, 4)
            j = j + 1
        }
        ensure("worker count: valid stepping at ${got}", dynamics.validate_solver_sets(dynamics.get_world(world_id.index1 - 1)))
        i = i + 1
    }
    changed = pile_sum(world_id)
    dynamics.destroy_world(world_id)
    // The same pile on one worker throughout.
    single = pile_world(1, slab, cube)
    k = 0
    while k < 31 {
        physics_world.step(single, 1.0 / 60.0, 4)
        k = k + 1
    }
    ensure("worker count: changing it between steps changes nothing (${changed} against ${pile_sum(single)})", changed == pile_sum(single))
    dynamics.destroy_world(single)
    free(steps_block)
    hull.destroy_hull(slab)
    hull.destroy_hull(cube)
}

// test_world.c's TestCompoundHitEvents: a sphere driven down onto either
// hull child of a static compound; its hit event carries the sphere's
// material id on one side and the struck child's (11 or 22) on the other,
// never the first child's for both.
test_compound_hit_events() {
    side = 0
    while side < 2 {
        expected = 11 as long
        spawn_x = 0.0 - 3.0
        if side == 1 {
            expected = 22 as long
            spawn_x = 3.0
        }
        wdef = dynamics.default_world_def()
        wdef.hit_event_threshold = 1.0
        world_id = dynamics.create_world(&wdef)
        box_a = hull.make_box_hull(1.0, 1.0, 1.0)
        box_b = hull.make_box_hull(1.0, 1.0, 1.0)
        mat_a = material.default_surface_material()
        mat_a.user_material_id = 11 as long
        mat_b = material.default_surface_material()
        mat_b.user_material_id = 22 as long
        hulls_block = calloc(2, sizeof(CompoundHullDef))
        hulls = hulls_block as CompoundHullDef[]
        hulls[0] = compound.compound_hull_def(box_a, Transform { p: math.vec3(0.0 - 3.0, 0.0, 0.0), q: math.quat_identity() }, mat_a)
        hulls[1] = compound.compound_hull_def(box_b, Transform { p: math.vec3(3.0, 0.0, 0.0), q: math.quat_identity() }, mat_b)
        cdef = compound.compound_def()
        cdef.hulls = hulls_block
        cdef.hull_count = 2
        c = compound.create_compound(&cdef)
        ensure("compound hit events: the compound made", c != null)
        sbdef = dynamics.default_body_def()
        holder = dynamics.create_body(world_id, &sbdef)
        csdef = dynamics.default_shape_def()
        dynamics.create_compound_shape(holder, &csdef, c)
        bdef = dynamics.default_body_def()
        bdef.kind = dynamics.BODY_DYNAMIC
        bdef.gravity_scale = 0.0
        bdef.position = math.vec3(spawn_x, 3.0, 0.0)
        bdef.linear_velocity = math.vec3(0.0, 0.0 - 30.0, 0.0)
        ball = dynamics.create_body(world_id, &bdef)
        bsdef = dynamics.default_shape_def()
        bsdef.density = 1.0
        bsdef.enable_hit_events = true
        bsdef.base_material.user_material_id = 99 as long
        dynamics.create_sphere_shape(ball, &bsdef, manifold.sphere(math.vec3_zero(), 0.5))
        hits = 0
        got_a = 0 as long
        got_b = 0 as long
        i = 0
        while i < 30 {
            physics_world.step(world_id, 1.0 / 60.0, 4)
            count = physics_world.contact_hit_event_count(world_id)
            if count > 0 && hits == 0 {
                hit = physics_world.contact_hit_event(world_id, 0)
                got_a = hit.user_material_id_a
                got_b = hit.user_material_id_b
            }
            hits = hits + count
            i = i + 1
        }
        dynamics.destroy_world(world_id)
        compound.destroy_compound(c)
        hull.destroy_hull(box_a)
        hull.destroy_hull(box_b)
        free(hulls_block)
        ensure("compound hit events (side ${side}): a hit (${hits})", hits >= 1)
        ensure("compound hit events (side ${side}): the sphere's material (${got_a} ${got_b})", got_a == (99 as long) || got_b == (99 as long))
        ensure("compound hit events (side ${side}): the struck child's material", got_a == expected || got_b == expected)
        side = side + 1
    }
}

var g_friction_calls = 0
var g_saw_child0 = false
var g_saw_child1 = false
var g_mixed_friction = 0.0

capture_friction(friction_a: float, id_a: long, friction_b: float, id_b: long) -> float {
    g_friction_calls = g_friction_calls + 1
    if id_a == (101 as long) || id_b == (101 as long) { g_saw_child0 = true }
    if id_a == (202 as long) || id_b == (202 as long) {
        g_saw_child1 = true
        g_mixed_friction = sqrt(friction_a * friction_b)
    }
    return sqrt(friction_a * friction_b)
}

// TestCompoundContactMaterials: a unit-friction sphere struck down onto
// child 1 of a compound whose child 0 has friction 0.04 and child 1 0.81,
// for sphere, capsule and hull children: the friction callback sees child
// 1's material, never child 0's, and mixes to sqrt(0.81) = 0.9.
test_compound_contact_materials() {
    mat0 = material.default_surface_material()
    mat0.friction = 0.04
    mat0.user_material_id = 101 as long
    mat1 = material.default_surface_material()
    mat1.friction = 0.81
    mat1.user_material_id = 202 as long
    box = hull.make_box_hull(0.5, 0.5, 0.5)
    spheres_block = calloc(2, sizeof(CompoundSphereDef))
    spheres = spheres_block as CompoundSphereDef[]
    spheres[0] = compound.compound_sphere_def(manifold.sphere(math.vec3(0.0 - 3.0, 0.0, 0.0), 0.5), mat0)
    spheres[1] = compound.compound_sphere_def(manifold.sphere(math.vec3(3.0, 0.0, 0.0), 0.5), mat1)
    capsules_block = calloc(2, sizeof(CompoundCapsuleDef))
    capsules = capsules_block as CompoundCapsuleDef[]
    capsules[0] = compound.compound_capsule_def(manifold.capsule(math.vec3(0.0 - 3.0, 0.0, 0.0 - 0.5), math.vec3(0.0 - 3.0, 0.0, 0.5), 0.5), mat0)
    capsules[1] = compound.compound_capsule_def(manifold.capsule(math.vec3(3.0, 0.0, 0.0 - 0.5), math.vec3(3.0, 0.0, 0.5), 0.5), mat1)
    hulls_block = calloc(2, sizeof(CompoundHullDef))
    hulls = hulls_block as CompoundHullDef[]
    hulls[0] = compound.compound_hull_def(box, Transform { p: math.vec3(0.0 - 3.0, 0.0, 0.0), q: math.quat_identity() }, mat0)
    hulls[1] = compound.compound_hull_def(box, Transform { p: math.vec3(3.0, 0.0, 0.0), q: math.quat_identity() }, mat1)
    kind = 0
    while kind < 3 {
        cdef = compound.compound_def()
        if kind == 0 {
            cdef.spheres = spheres_block
            cdef.sphere_count = 2
        } else if kind == 1 {
            cdef.capsules = capsules_block
            cdef.capsule_count = 2
        } else {
            cdef.hulls = hulls_block
            cdef.hull_count = 2
        }
        c = compound.create_compound(&cdef)
        ensure("compound materials (kind ${kind}): the compound made", c != null)
        g_friction_calls = 0
        g_saw_child0 = false
        g_saw_child1 = false
        g_mixed_friction = 0.0
        wdef = dynamics.default_world_def()
        wdef.friction_callback = capture_friction
        world_id = dynamics.create_world(&wdef)
        sbdef = dynamics.default_body_def()
        holder = dynamics.create_body(world_id, &sbdef)
        csdef = dynamics.default_shape_def()
        dynamics.create_compound_shape(holder, &csdef, c)
        bdef = dynamics.default_body_def()
        bdef.kind = dynamics.BODY_DYNAMIC
        bdef.gravity_scale = 0.0
        bdef.position = math.vec3(3.0, 3.0, 0.0)
        bdef.linear_velocity = math.vec3(0.0, 0.0 - 30.0, 0.0)
        ball = dynamics.create_body(world_id, &bdef)
        bsdef = dynamics.default_shape_def()
        bsdef.density = 1.0
        bsdef.base_material.friction = 1.0
        bsdef.base_material.user_material_id = 999 as long
        dynamics.create_sphere_shape(ball, &bsdef, manifold.sphere(math.vec3_zero(), 0.5))
        i = 0
        while i < 30 {
            physics_world.step(world_id, 1.0 / 60.0, 4)
            i = i + 1
        }
        dynamics.destroy_world(world_id)
        compound.destroy_compound(c)
        ensure("compound materials (kind ${kind}): the callback called (${g_friction_calls})", g_friction_calls > 0)
        ensure("compound materials (kind ${kind}): never child 0's material", g_saw_child0 == false)
        ensure("compound materials (kind ${kind}): child 1's material", g_saw_child1)
        small("compound materials (kind ${kind}): mixed to 0.9", g_mixed_friction - 0.9, 0.00001)
        kind = kind + 1
    }
    hull.destroy_hull(box)
    free(spheres_block)
    free(capsules_block)
    free(hulls_block)
}

// test_broad_phase.c's BroadPhaseStressTest: a swarm of up to 64 bodies
// churning through every proxy change the world offers (made and destroyed,
// teleported, sped up, disabled and enabled, bullet on and off, its type
// changed, welded with collision off and toggled, the static clutter moved,
// the static tree rebuilt) among 60 static boxes and height fields, over
// kilometre height-field tiles two kilometres from the origin; after every
// step a zero step finds the pairs, and the pair set is checked against
// every live shape pair by brute force. Three seeds, at one worker, at four,
// and at three with sleep on (where only a missing pair is a bug: a sleeping
// contact is not refreshed, so a stale one may outlive its overlap).
var g_stress_seed: long = 0

stress_next() -> long {
    x = g_stress_seed
    x = (x ^ (x << 13)) & (4294967295 as long)
    x = x ^ (x >> 17)
    x = (x ^ (x << 5)) & (4294967295 as long)
    g_stress_seed = x
    return x
}

stress_float(lower: float, upper: float) -> float {
    u = ((stress_next() & (16777215 as long)) as float) / 16777216.0
    return lower + (upper - lower) * u
}

stress_int(count: int) -> int { return (stress_next() % (count as long)) as int }

stress_origin() -> Vec3 { return math.vec3(0.0 - 1900.0, 0.0, 1330.0) }

stress_position() -> Vec3 {
    e = 12.0
    x = stress_float(0.0 - e, e)
    y = stress_float(0.0 - e, e)
    z = stress_float(0.0 - e, e)
    return math.add(stress_origin(), math.vec3(x, y, z))
}

stress_velocity() -> Vec3 {
    s = 12.0
    if stress_int(4) == 0 { s = 40.0 }
    x = stress_float(0.0 - s, s)
    y = stress_float(0.0 - s, s)
    z = stress_float(0.0 - s, s)
    return math.vec3(x, y, z)
}

stress_body(world_id: WorldId, box: *HullData) -> BodyId {
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    if stress_int(10) == 0 { bdef.kind = dynamics.BODY_KINEMATIC }
    bdef.position = stress_position()
    bdef.linear_velocity = stress_velocity()
    bdef.is_bullet = stress_int(3) == 0
    bdef.gravity_scale = 0.0
    body = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    sdef.filter.category_bits = (1 as long) << stress_int(3)
    if stress_int(4) == 0 { sdef.filter.mask_bits = 5 as long }
    count = 1 + stress_int(2)
    i = 0
    while i < count {
        if stress_int(2) == 0 {
            cx = stress_float(0.0 - 1.0, 1.0)
            r = stress_float(0.2, 1.5)
            dynamics.create_sphere_shape(body, &sdef, manifold.sphere(math.vec3(cx, 0.0, 0.0), r))
        } else {
            dynamics.create_hull_shape(body, &sdef, box)
        }
        i = i + 1
    }
    return body
}

// The pair set against every live, filtered, overlapping pair of shapes.
stress_pairs_hold(world_id: WorldId, sleeping: bool) -> bool {
    w = dynamics.get_world(world_id.index1 - 1)
    count = w.shapes.count
    i = 0
    while i < count {
        a = dynamics.world_shape_at(w, i)
        if a.id != dynamics.NULL_INDEX && a.proxy_key != dynamics.NULL_INDEX && a.sensor_index == dynamics.NULL_INDEX {
            body_a = dynamics.body_at(w, a.body_id)
            j = i + 1
            while j < count {
                b = dynamics.world_shape_at(w, j)
                if b.id != dynamics.NULL_INDEX && b.proxy_key != dynamics.NULL_INDEX && b.sensor_index == dynamics.NULL_INDEX && a.body_id != b.body_id {
                    body_b = dynamics.body_at(w, b.body_id)
                    expected = shape.should_shapes_collide(a.filter, b.filter) && dynamics.should_bodies_collide(w, body_a, body_b) &&
                               math.aabbf_overlaps(dynamics.shape_fat_aabb(w, i), dynamics.shape_fat_aabb(w, j))
                    actual = broad_phase.has_pair(&w.broad_phase, basics.shape_pair_key(i, j, 0))
                    if (sleeping && actual && expected == false) == false && expected != actual { return false }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return true
}

broad_phase_stress(workers: int, seed: long, sleeping: bool) -> bool {
    wdef = dynamics.default_world_def()
    wdef.worker_count = workers
    wdef.enable_sleep = sleeping
    wdef.gravity = math.vec3_zero()
    world_id = dynamics.create_world(&wdef)
    g_stress_seed = seed
    box = hull.make_box_hull(0.95, 0.6, 2.2)
    // Kilometre tiles far from the origin under the swarm, as a streamed terrain.
    tile = height_field.create_grid(65, 65, math.vec3(16.0, 1.0, 16.0), false)
    i = 0
    while i < 9 {
        tdef = dynamics.default_body_def()
        tdef.position = math.vec3(0.0 - 3072.0 + 1024.0 * ((i % 3) as float), 0.0 - 30.0, 1024.0 * ((i / 3) as float))
        tile_body = dynamics.create_body(world_id, &tdef)
        tsdef = dynamics.default_shape_def()
        tsdef.enable_speculative_contact = false
        dynamics.create_height_field_shape(tile_body, &tsdef, tile)
        i = i + 1
    }
    // Static clutter in the swarm; some asks for its contacts when made.
    statics_block = calloc(60, sizeof(BodyId))
    statics = statics_block as BodyId[]
    grid = height_field.create_grid(5, 5, math.vec3(2.0, 1.0, 2.0), false)
    static_box = hull.make_box_hull(3.0, 0.5, 3.0)
    i = 0
    while i < 60 {
        sbdef = dynamics.default_body_def()
        sbdef.position = stress_position()
        statics[i] = dynamics.create_body(world_id, &sbdef)
        ssdef = dynamics.default_shape_def()
        ssdef.invoke_contact_creation = (i % 4) == 0
        ssdef.enable_speculative_contact = (i % 2) == 0
        if i % 3 == 0 { dynamics.create_height_field_shape(statics[i], &ssdef, grid) }
        else { dynamics.create_hull_shape(statics[i], &ssdef, static_box) }
        i = i + 1
    }
    slots_block = calloc(64, sizeof(BodyId))
    slots = slots_block as BodyId[]
    active_block = calloc(64, 4)
    active = active_block as int[]
    i = 0
    while i < 64 {
        if stress_int(4) != 0 {
            slots[i] = stress_body(world_id, box)
            active[i] = 1
        }
        i = i + 1
    }
    joints_block = calloc(4, sizeof(JointId))
    joints = joints_block as JointId[]
    joint_count = 0
    ok = true
    step = 0
    while step < 400 && ok {
        mutations = stress_int(4)
        m = 0
        while m < mutations {
            slot = stress_int(64)
            action = stress_int(12)
            if active[slot] == 0 {
                if action < 6 {
                    slots[slot] = stress_body(world_id, box)
                    active[slot] = 1
                }
            } else if action == 0 {
                dynamics.destroy_body(slots[slot])
                active[slot] = 0
            } else if action == 1 || action == 2 {
                dynamics.body_set_transform(slots[slot], stress_position(), math.quat_identity())
            } else if action == 3 {
                dynamics.body_set_linear_velocity(slots[slot], stress_velocity())
            } else if action == 4 {
                dynamics.body_disable(slots[slot])
            } else if action == 5 {
                dynamics.body_enable(slots[slot])
            } else if action == 6 {
                dynamics.body_set_bullet(slots[slot], stress_int(2) == 0)
            } else if action == 7 {
                kind = stress_int(3)
                if kind == 0 { dynamics.body_set_type(slots[slot], dynamics.BODY_STATIC) }
                else if kind == 1 { dynamics.body_set_type(slots[slot], dynamics.BODY_KINEMATIC) }
                else { dynamics.body_set_type(slots[slot], dynamics.BODY_DYNAMIC) }
                if dynamics.body_get_type(slots[slot]) != dynamics.BODY_STATIC { dynamics.body_set_linear_velocity(slots[slot], stress_velocity()) }
            } else if action == 8 {
                // A weld that stops collision, or one toggled.
                if joint_count < 4 {
                    other = stress_int(64)
                    if other != slot && active[other] != 0 && dynamics.body_get_type(slots[slot]) == dynamics.BODY_DYNAMIC &&
                       dynamics.body_get_type(slots[other]) == dynamics.BODY_DYNAMIC {
                        jdef = dynamics.default_weld_joint_def()
                        jdef.base.body_id_a = slots[slot]
                        jdef.base.body_id_b = slots[other]
                        jdef.base.collide_connected = false
                        joints[joint_count] = dynamics.create_weld_joint(world_id, &jdef)
                        joint_count = joint_count + 1
                    }
                } else {
                    joint = joints[stress_int(joint_count)]
                    if dynamics.joint_is_valid(joint) { dynamics.joint_set_collide_connected(joint, stress_int(2) == 0) }
                }
            } else if action == 9 {
                dynamics.body_set_transform(statics[stress_int(60)], stress_position(), math.quat_identity())
            } else if action == 10 {
                physics_world.rebuild_static_tree(world_id)
            }
            m = m + 1
        }
        // Joints whose bodies were destroyed went with them.
        j = 0
        while j < joint_count {
            if dynamics.joint_is_valid(joints[j]) == false {
                joints[j] = joints[joint_count - 1]
                joint_count = joint_count - 1
            } else {
                j = j + 1
            }
        }
        // The swarm kept in the clutter.
        i = 0
        while i < 64 {
            if active[i] != 0 && dynamics.body_is_enabled(slots[i]) {
                d = math.sub(dynamics.body_get_position(slots[i]), stress_origin())
                if math.abs_float(d.x) > 24.0 || math.abs_float(d.y) > 24.0 || math.abs_float(d.z) > 24.0 {
                    dynamics.body_set_transform(slots[i], stress_position(), math.quat_identity())
                    dynamics.body_set_linear_velocity(slots[i], stress_velocity())
                }
            }
            i = i + 1
        }
        physics_world.step(world_id, 1.0 / 60.0, 4)
        // A zero step finds the pairs and purges disjoint contacts, moving nothing.
        physics_world.step(world_id, 0.0, 1)
        if stress_pairs_hold(world_id, sleeping) == false {
            println("physics_world: broad phase stress: pairs wrong at workers ${workers} seed ${seed} sleep ${sleeping} step ${step}")
            ok = false
        }
        step = step + 1
    }
    dynamics.destroy_world(world_id)
    height_field.destroy_height_field(grid)
    height_field.destroy_height_field(tile)
    hull.destroy_hull(box)
    hull.destroy_hull(static_box)
    free(statics_block)
    free(slots_block)
    free(active_block)
    free(joints_block)
    return ok
}

test_broad_phase_stress() {
    seeds_block = calloc(3, 8)
    seeds = seeds_block as long[]
    seeds[0] = 12345 as long
    seeds[1] = 12648430 as long
    seeds[2] = 777 as long
    i = 0
    while i < 3 {
        ensure("broad phase stress, seed ${seeds[i]}: one worker", broad_phase_stress(1, seeds[i], false))
        ensure("broad phase stress, seed ${seeds[i]}: four workers", broad_phase_stress(4, seeds[i], false))
        ensure("broad phase stress, seed ${seeds[i]}: three workers with sleep", broad_phase_stress(3, seeds[i], true))
        i = i + 1
    }
    free(seeds_block)
}

// test_broad_phase.c's StaticRebuildKeepsMarks: the broad phase keeps a
// static proxy's pending pair mark in the static tree, so a full rebuild
// between a static change and the next step must not wipe it. Both ways a
// static proxy is marked: a static body teleported under a resting sphere,
// and a shape made there with invoke_contact_creation.
static_rebuild_keeps_marks(use_invoke: bool) {
    wdef = dynamics.default_world_def()
    wdef.gravity = math.vec3_zero()
    world_id = dynamics.create_world(&wdef)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.position = math.vec3(0.0, 1.0, 0.0)
    sphere_id = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    dynamics.create_sphere_shape(sphere_id, &sdef, manifold.sphere(math.vec3_zero(), 0.5))
    bdef.kind = dynamics.BODY_STATIC
    bdef.position = math.vec3(100.0, 0.0, 0.0)
    ground = dynamics.create_body(world_id, &bdef)
    slab = hull.make_box_hull(2.0, 0.5, 2.0)
    if use_invoke == false { dynamics.create_hull_shape(ground, &sdef, slab) }
    // Settled, so the resting sphere carries no mark of its own.
    i = 0
    while i < 3 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        i = i + 1
    }
    dynamics.body_set_transform(ground, math.vec3_zero(), math.quat_identity())
    if use_invoke {
        idef = dynamics.default_shape_def()
        idef.invoke_contact_creation = true
        dynamics.create_hull_shape(ground, &idef, slab)
    }
    physics_world.rebuild_static_tree(world_id)
    physics_world.step(world_id, 1.0 / 60.0, 4)
    ensure("static rebuild keeps the marks (invoke ${use_invoke}): the sphere's contact (${dynamics.body_get_contact_capacity(sphere_id)})",
           dynamics.body_get_contact_capacity(sphere_id) == 1)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(slab)
}

// A ball of the given restitution dropped from 2 m onto a slab under the
// world's restitution settings: the highest it rises after its first bounce.
bounce_peak(restitution: float, iterations: int) -> float {
    wdef = dynamics.default_world_def()
    wdef.restitution_iterations = iterations
    world_id = dynamics.create_world(&wdef)
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 0.5, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    slab = hull.make_box_hull(4.0, 0.5, 4.0)
    gsdef = dynamics.default_shape_def()
    gsdef.base_material.restitution = restitution
    dynamics.create_hull_shape(ground, &gsdef, slab)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.position = math.vec3(0.0, 2.5, 0.0)
    ball = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    sdef.base_material.restitution = restitution
    dynamics.create_sphere_shape(ball, &sdef, manifold.sphere(math.vec3_zero(), 0.5))
    bounced = false
    peak = 0.0
    i = 0
    while i < 240 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        v = dynamics.body_get_linear_velocity(ball)
        y = dynamics.body_get_position(ball).y - 0.5
        if bounced == false && v.y > 0.0 { bounced = true }
        if bounced && y > peak { peak = y }
        i = i + 1
    }
    dynamics.destroy_world(world_id)
    hull.destroy_hull(slab)
    return peak
}

// The restitution of Box3D main: passes the world sets (two by default),
// a Poisson impulse that never adds energy, propagation on request; and
// the pushing pass no longer counted in the total impulse.
test_restitution() {
    full = bounce_peak(1.0, 2)
    ensure("restitution: a perfect bounce gains nothing (peak ${full} of 2)", full <= 2.0 + 0.02 && full > 1.8)
    half = bounce_peak(0.5, 2)
    ensure("restitution: half restitution rises a quarter (${half})", half > 0.4 && half < 0.6)
    unbounced = bounce_peak(1.0, 0)
    ensure("restitution: no passes, no bounce (${unbounced})", unbounced < 0.1)

    wdef = dynamics.default_world_def()
    ensure("restitution: two passes by default", wdef.restitution_iterations == 2 && wdef.enable_restitution_propagation == false)
    world_id = dynamics.create_world(&wdef)
    physics_world.set_restitution_iterations(world_id, 100)
    ensure("restitution: passes clamped to 63", physics_world.get_restitution_iterations(world_id) == 63)
    physics_world.set_restitution_iterations(world_id, 0 - 3)
    ensure("restitution: and to 0", physics_world.get_restitution_iterations(world_id) == 0)
    physics_world.enable_restitution_propagation(world_id, true)
    ensure("restitution: propagation on", physics_world.is_restitution_propagation_enabled(world_id))
    dynamics.destroy_world(world_id)

    // A resting cube's total impulse is a step's weight: the relaxed passes'
    // impulse summed over the sub-steps, the pushing passes not counted.
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 0.5, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    slab = hull.make_box_hull(4.0, 0.5, 4.0)
    sdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(ground, &sdef, slab)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.position = math.vec3(0.0, 0.5, 0.0)
    cube_body = dynamics.create_body(world_id, &bdef)
    cube = hull.make_box_hull(0.5, 0.5, 0.5)
    dynamics.create_hull_shape(cube_body, &sdef, cube)
    i = 0
    while i < 60 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        i = i + 1
    }
    data_block = calloc(4, sizeof(ContactData))
    data = data_block as ContactData[]
    count = dynamics.body_get_contact_data(cube_body, data, 4)
    total = 0.0
    if count == 1 {
        m = data[0].manifolds as *Manifold
        j = 0
        while j < m.point_count {
            total = total + dynamics.manifold_point_at(m, j).total_normal_impulse
            j = j + 1
        }
    }
    weight = dynamics.body_get_mass(cube_body) * 10.0 / 60.0
    ensure("restitution: a resting cube's total impulse is a step's weight (${total} of ${weight})", count == 1 && math.abs_float(total - weight) < 0.1 * weight)
    free(data_block)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(slab)
    hull.destroy_hull(cube)
}

// Two joint fixes from an audit of the joint solvers against Box3D: the
// prismatic's axis rows run for a pair that cannot turn, and a spring
// set to no stiffness lets go instead of pushing on with its last impulse.
test_joint_springs_and_locks() {
    // An elevator: a rotation-locked box on a vertical prismatic joint to
    // the ground, limited to half a metre down; gravity pulls it to the limit.
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    gdef = dynamics.default_body_def()
    ground = dynamics.create_body(world_id, &gdef)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.position = math.vec3(0.0, 2.0, 0.0)
    bdef.motion_locks = MotionLocks { linear_x: false, linear_y: false, linear_z: false, angular_x: true, angular_y: true, angular_z: true }
    car = dynamics.create_body(world_id, &bdef)
    cube = hull.make_box_hull(0.5, 0.5, 0.5)
    sdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(car, &sdef, cube)
    pdef = dynamics.default_prismatic_joint_def()
    pdef.base.body_id_a = ground
    pdef.base.body_id_b = car
    up = math.make_quat_from_axis_angle(math.vec3(0.0, 0.0, 1.0), 0.5 * math.PI)
    pdef.base.local_frame_a = Transform { p: math.vec3(0.0, 2.0, 0.0), q: up }
    pdef.base.local_frame_b = Transform { p: math.vec3_zero(), q: up }
    pdef.enable_limit = true
    pdef.lower_translation = 0.0 - 0.5
    pdef.upper_translation = 0.5
    dynamics.create_prismatic_joint(world_id, &pdef)
    i = 0
    while i < 120 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        i = i + 1
    }
    y = dynamics.body_get_position(car).y
    ensure("joints: a rotation-locked elevator stops at its limit (y ${y})", math.abs_float(y - 1.5) < 0.05)
    dynamics.destroy_world(world_id)

    // A hinge spring let go: spinning against an 8 Hz spring, then the spring
    // set to no stiffness; the box spins on freely, no torque left on it.
    wdef = dynamics.default_world_def()
    wdef.gravity = math.vec3_zero()
    world_id = dynamics.create_world(&wdef)
    ground = dynamics.create_body(world_id, &gdef)
    bdef.position = math.vec3_zero()
    bdef.motion_locks = MotionLocks { linear_x: false, linear_y: false, linear_z: false, angular_x: false, angular_y: false, angular_z: false }
    bdef.angular_velocity = math.vec3(0.0, 0.0, 3.0)
    wheel = dynamics.create_body(world_id, &bdef)
    dynamics.create_hull_shape(wheel, &sdef, cube)
    rdef = dynamics.default_revolute_joint_def()
    rdef.base.body_id_a = ground
    rdef.base.body_id_b = wheel
    rdef.enable_spring = true
    rdef.hertz = 8.0
    rdef.damping_ratio = 0.1
    hinge = dynamics.create_revolute_joint(world_id, &rdef)
    i = 0
    while i < 5 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        i = i + 1
    }
    joint_solver.revolute_joint_set_spring_hertz(hinge, 0.0)
    physics_world.step(world_id, 1.0 / 60.0, 4)
    w0 = dynamics.body_get_angular_velocity(wheel).z
    i = 0
    while i < 30 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        i = i + 1
    }
    w1 = dynamics.body_get_angular_velocity(wheel).z
    ensure("joints: a spring of no stiffness pushes no more (${w0} -> ${w1})", math.abs_float(w1 - w0) < 0.01)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(cube)
}

// The parallel step's bookkeeping: a four-worker world allocating from its
// workers (every new mesh contact grows a triangle cache in the collide pass)
// frees everything it counted; and a step from a thread that is not worker 0
// of anything (a host pool's thread) runs as worker 0 and gives the index back.
test_parallel_bookkeeping() {
    before = basics.alloc_count()
    wdef = dynamics.default_world_def()
    wdef.worker_count = 4
    world_id = dynamics.create_world(&wdef)
    grid = mesh.create_grid_mesh(16, 16, 1.0, 1, true)
    gdef = dynamics.default_body_def()
    ground = dynamics.create_body(world_id, &gdef)
    sdef = dynamics.default_shape_def()
    dynamics.create_mesh_shape(ground, &sdef, grid, math.vec3_one())
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    i = 0
    while i < 200 {
        bdef.position = math.vec3(-7.5 + ((i % 15) as float), 0.6 + 0.01 * ((i / 15) as float), -7.0 + ((i / 15) as float))
        ball = dynamics.create_body(world_id, &bdef)
        dynamics.create_sphere_shape(ball, &sdef, manifold.sphere(math.vec3_zero(), 0.4))
        i = i + 1
    }
    i = 0
    while i < 20 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        i = i + 1
    }
    dynamics.destroy_world(world_id)
    mesh.destroy_mesh(grid)
    ensure("parallel: everything the workers counted freed (${basics.alloc_count() - before})", basics.alloc_count() == before)

    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    slab = hull.make_box_hull(4.0, 0.5, 4.0)
    gdef.position = math.vec3(0.0, 0.0 - 0.5, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    dynamics.create_hull_shape(ground, &sdef, slab)
    bdef.position = math.vec3(0.0, 0.45, 0.0)
    ball = dynamics.create_body(world_id, &bdef)
    dynamics.create_sphere_shape(ball, &sdef, manifold.sphere(math.vec3_zero(), 0.5))
    native.set_worker_index(5)
    physics_world.step(world_id, 1.0 / 60.0, 4)
    physics_world.step(world_id, 1.0 / 60.0, 4)
    after = native.worker_index()
    native.set_worker_index(0)
    ensure("parallel: a host thread's index given back (${after})", after == 5)
    ensure("parallel: the ball rests on the slab", dynamics.world_contact_count(dynamics.get_world(world_id.index1 - 1)) == 1)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(slab)
}

test_hit_events() {
    wdef = dynamics.default_world_def()
    wdef.hit_event_threshold = 1.0
    world_id = dynamics.create_world(&wdef)
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 0.5, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    ground_box = hull.make_box_hull(10.0, 0.5, 10.0)
    gsdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(ground, &gsdef, ground_box)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.gravity_scale = 0.0
    bdef.position = math.vec3(0.0, 2.0, 0.0)
    bdef.linear_velocity = math.vec3(0.0, 0.0 - 30.0, 0.0)
    ball = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    sdef.density = 1.0
    sdef.enable_hit_events = true
    sdef.base_material.user_material_id = 7 as long
    dynamics.create_sphere_shape(ball, &sdef, manifold.sphere(math.vec3_zero(), 0.5))
    hits = 0
    speed = 0.0
    normal = math.vec3_zero()
    material_a = 0 as long
    material_b = 0 as long
    i = 0
    while i < 30 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        count = physics_world.contact_hit_event_count(world_id)
        if count > 0 && hits == 0 {
            hit = physics_world.contact_hit_event(world_id, 0)
            speed = hit.approach_speed
            normal = hit.normal
            material_a = hit.user_material_id_a
            material_b = hit.user_material_id_b
        }
        hits = hits + count
        i = i + 1
    }
    dynamics.destroy_world(world_id)
    ensure("hit: at least one (${hits})", hits >= 1)
    ensure("hit: fast (${speed})", speed > 1.0)
    small("hit: normal along y (x)", normal.x, 0.01)
    small("hit: normal along y (z)", normal.z, 0.01)
    ensure("hit: the sphere's material id", material_a == (7 as long) || material_b == (7 as long))
    hull.destroy_hull(ground_box)
}

// A time of impact takes back the gravity of the time it lost: a ball at
// 120 m/s reaching a wall a third of the way through a step has fallen
// for that third, not the whole step (current Box3D's b3SolveContinuous).
test_continuous_gravity() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    physics_world.enable_continuous(world_id, true)
    g = physics_world.get_gravity(world_id).y
    wall_def = dynamics.default_body_def()
    wall = dynamics.create_body(world_id, &wall_def)
    wall_box = hull.make_box_hull(0.1, 5.0, 5.0)
    sdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(wall, &sdef, wall_box)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.position = math.vec3(3.0, 0.0, 0.0)
    bdef.linear_velocity = math.vec3(0.0 - 120.0, 0.0, 0.0)
    ball = dynamics.create_body(world_id, &bdef)
    sdef.density = 1.0
    dynamics.create_sphere_shape(ball, &sdef, manifold.sphere(math.vec3_zero(), 0.25))
    dt = 1.0 / 60.0
    // A free step, then the step that reaches the wall.
    physics_world.step(world_id, dt, 4)
    free_dv = dynamics.body_get_linear_velocity(ball).y
    vy0 = free_dv
    physics_world.step(world_id, dt, 4)
    x = dynamics.body_get_position(ball).x
    dv = dynamics.body_get_linear_velocity(ball).y - vy0
    ensure("continuous gravity: the free step fell a whole step (${free_dv})", math.abs_float(free_dv - g * dt) < 0.0001)
    ensure("continuous gravity: stopped at the wall (${x})", 0.2 < x && x < 0.5)
    ensure("continuous gravity: fell only until the impact (${dv} of ${g * dt})", dv < 0.0 && dv > 0.6 * g * dt)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(wall_box)
}

test_continuous_move_event() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    physics_world.enable_continuous(world_id, true)
    wall_def = dynamics.default_body_def()
    wall = dynamics.create_body(world_id, &wall_def)
    wall_box = hull.make_box_hull(0.1, 5.0, 5.0)
    sdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(wall, &sdef, wall_box)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.gravity_scale = 0.0
    bdef.position = math.vec3(3.0, 0.0, 0.0)
    bdef.linear_velocity = math.vec3(0.0 - 30.0, 0.0, 0.0)
    ball = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    sdef.density = 1.0
    dynamics.create_sphere_shape(ball, &sdef, manifold.sphere(math.vec3_zero(), 0.25))
    have_move = false
    all_match = true
    s = 0
    while s < 30 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        xf = dynamics.body_get_transform(ball)
        i = 0
        while i < physics_world.body_event_count(world_id) {
            event = physics_world.body_event(world_id, i)
            if same_body(event.body_id, ball) {
                have_move = true
                if event.transform.p.x != xf.p.x || event.transform.p.y != xf.p.y || event.transform.p.z != xf.p.z { all_match = false }
                if event.transform.q.x != xf.q.x || event.transform.q.w != xf.q.w { all_match = false }
            }
            i = i + 1
        }
        s = s + 1
    }
    ensure("continuous: move events for the ball", have_move)
    ensure("continuous: the move event carries the impact pose", all_match)
    final = dynamics.body_get_position(ball)
    ensure("continuous: stopped at the wall (${final.x})", 0.2 < final.x && final.x < 0.8)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(wall_box)
}

test_sensor_stepped() {
    // The reference's TestSensor: a bullet through a wall that reports sensor events, one begin and one end.
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    wall_def = dynamics.default_body_def()
    wall_def.position = math.vec3(1.5, 11.0, 0.0)
    wall = dynamics.create_body(world_id, &wall_def)
    wall_box = hull.make_box_hull(0.5, 10.0, 1.0)
    sdef = dynamics.default_shape_def()
    sdef.enable_sensor_events = true
    dynamics.create_hull_shape(wall, &sdef, wall_box)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.is_bullet = true
    bdef.gravity_scale = 0.0
    bdef.position = math.vec3(7.39814, 4.0, 0.0)
    bdef.linear_velocity = math.vec3(0.0 - 20.0, 0.0, 0.0)
    bullet = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    sdef.is_sensor = true
    sdef.enable_sensor_events = true
    dynamics.create_sphere_shape(bullet, &sdef, manifold.sphere(math.vec3_zero(), 0.1))
    begins = 0
    ends = 0
    steps = 0
    while steps < 200 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        if physics_world.sensor_begin_event_count(world_id) > 0 { begins = begins + 1 }
        if physics_world.sensor_end_event_count(world_id) > 0 { ends = ends + 1 }
        steps = steps + 1
        if dynamics.body_get_position(bullet).x < 0.0 - 1.0 { steps = 1000 }
    }
    dynamics.destroy_world(world_id)
    ensure("sensor: one begin (${begins})", begins == 1)
    ensure("sensor: one end (${ends})", ends == 1)
    hull.destroy_hull(wall_box)
}

run_explosion(base: Vec3) -> Vec3 {
    wdef = dynamics.default_world_def()
    wdef.gravity = math.vec3_zero()
    world_id = dynamics.create_world(&wdef)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.position = base
    body = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    dynamics.create_sphere_shape(body, &sdef, manifold.sphere(math.vec3_zero(), 1.0))
    edef = physics_world.default_explosion_def()
    edef.position = math.add(base, math.vec3(3.0, 0.0, 0.0))
    edef.radius = 5.0
    edef.falloff = 0.0
    edef.impulse_per_area = 10.0
    physics_world.explode(world_id, &edef)
    v = dynamics.body_get_linear_velocity(body)
    w = dynamics.body_get_angular_velocity(body)
    ensure("explosion: no spin", math.length(w) < 0.000001)
    dynamics.destroy_world(world_id)
    return v
}

test_explosion() {
    near = run_explosion(math.vec3_zero())
    ensure("explosion: pushed back along -x (${near.x})", near.x < 0.0 - 0.0001)
    small("explosion: no y", near.y, 0.000001)
    small("explosion: no z", near.z, 0.000001)
    far = run_explosion(math.vec3(10000000.0, 10000000.0, 10000000.0))
    small("explosion: the same far from the origin", math.length(math.sub(far, near)), 0.00001)
}

// --- test_body_query.c ----------------------------------------------------------------------------------------------

query_world(body: BodyId[]) -> WorldId {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    bdef = dynamics.default_body_def()
    body[0] = dynamics.create_body(world_id, &bdef)
    return world_id
}

test_body_queries() {
    ids_block = calloc(2, sizeof(BodyId))
    ids = ids_block as BodyId[]
    filter = shape.default_query_filter()
    sdef = dynamics.default_shape_def()

    // CastRayHitsSphere: a sphere at (5, 0, 0), a ray along +x.
    world_id = query_world(ids)
    dynamics.create_sphere_shape(ids[0], &sdef, manifold.sphere(math.vec3_zero(), 1.0))
    result = physics_world.body_cast_ray(ids[0], math.vec3_zero(), math.vec3(10.0, 0.0, 0.0), filter, 1.0, identity_at(5.0, 0.0, 0.0))
    ensure("ray: hit", result.hit && dynamics.shape_is_valid(result.shape_id))
    small("ray: fraction 0.4", result.fraction - 0.4, 0.00001)
    small("ray: normal -x", result.normal.x + 1.0, 0.00001)
    small("ray: point at 4", result.point.x - 4.0, 0.0001)
    // CastRayMiss.
    result = physics_world.body_cast_ray(ids[0], math.vec3_zero(), math.vec3(0.0, 10.0, 0.0), filter, 1.0, identity_at(5.0, 0.0, 0.0))
    ensure("ray: miss", result.hit == false)
    dynamics.destroy_world(world_id)

    // CastRayClosestShape: the nearer of two spheres, whatever the list order.
    world_id = query_world(ids)
    near_id = dynamics.create_sphere_shape(ids[0], &sdef, manifold.sphere(math.vec3_zero(), 1.0))
    dynamics.create_sphere_shape(ids[0], &sdef, manifold.sphere(math.vec3(4.0, 0.0, 0.0), 1.0))
    result = physics_world.body_cast_ray(ids[0], math.vec3(0.0 - 5.0, 0.0, 0.0), math.vec3(10.0, 0.0, 0.0), filter, 1.0, identity_at(0.0, 0.0, 0.0))
    ensure("ray: the nearer shape", result.hit && same_shape(result.shape_id, near_id))
    small("ray: its fraction", result.fraction - 0.4, 0.00001)
    dynamics.destroy_world(world_id)

    // CastRayRotatedBody: the local (0, 2, 0) sphere turned a quarter about z sits at (-2, 0, 0).
    world_id = query_world(ids)
    dynamics.create_sphere_shape(ids[0], &sdef, manifold.sphere(math.vec3(0.0, 2.0, 0.0), 0.5))
    turned = Transform { p: math.vec3_zero(), q: math.make_quat_from_axis_angle(math.vec3_axis_z(), 0.5 * math.PI) }
    result = physics_world.body_cast_ray(ids[0], math.vec3_zero(), math.vec3(0.0 - 4.0, 0.0, 0.0), filter, 1.0, turned)
    ensure("ray: hit the turned sphere", result.hit)
    small("ray: fraction 0.375", result.fraction - 0.375, 0.00001)
    small("ray: normal +x", result.normal.x - 1.0, 0.00001)
    small("ray: point at -1.5", result.point.x + 1.5, 0.0001)
    dynamics.destroy_world(world_id)

    // CastRayFarFromOrigin: the same hit a million away.
    world_id = query_world(ids)
    dynamics.create_sphere_shape(ids[0], &sdef, manifold.sphere(math.vec3_zero(), 1.0))
    origin = math.vec3(1000000.0, 0.0 - 2000000.0, 500000.0)
    result = physics_world.body_cast_ray(ids[0], origin, math.vec3(10.0, 0.0, 0.0), filter, 1.0, Transform { p: math.add(origin, math.vec3(5.0, 0.0, 0.0)), q: math.quat_identity() })
    ensure("ray far: hit", result.hit)
    small("ray far: fraction 0.4", result.fraction - 0.4, 0.00001)
    small("ray far: normal -x", result.normal.x + 1.0, 0.00001)
    small("ray far: normal y", result.normal.y, 0.00001)
    dynamics.destroy_world(world_id)

    // CastShapeHitsBox: a sphere proxy of 0.5 into a unit box whose face is at x = 4.
    world_id = query_world(ids)
    box = hull.make_box_hull(1.0, 1.0, 1.0)
    dynamics.create_hull_shape(ids[0], &sdef, box)
    proxy = point_proxy(math.vec3_zero(), 0.5)
    result = physics_world.body_cast_shape(ids[0], math.vec3_zero(), proxy, math.vec3(10.0, 0.0, 0.0), filter, 1.0, false, identity_at(5.0, 0.0, 0.0))
    ensure("shape cast: hit", result.hit && dynamics.shape_is_valid(result.shape_id))
    small("shape cast: fraction 0.35 (with the cast's skin)", result.fraction - 0.35, 0.01)
    small("shape cast: normal -x", result.normal.x + 1.0, 0.0001)
    small("shape cast: point at 4", result.point.x - 4.0, 0.001)
    // CastShapeMiss.
    result = physics_world.body_cast_shape(ids[0], math.vec3_zero(), proxy, math.vec3(0.0, 10.0, 0.0), filter, 1.0, false, identity_at(5.0, 0.0, 0.0))
    ensure("shape cast: miss", result.hit == false)
    // CastShapeFarFromOrigin.
    result = physics_world.body_cast_shape(ids[0], origin, proxy, math.vec3(10.0, 0.0, 0.0), filter, 1.0, false, Transform { p: math.add(origin, math.vec3(5.0, 0.0, 0.0)), q: math.quat_identity() })
    ensure("shape cast far: hit", result.hit)
    small("shape cast far: fraction", result.fraction - 0.35, 0.01)
    small("shape cast far: normal", result.normal.x + 1.0, 0.0001)
    // OverlapTrue / OverlapFalse / OverlapRespectsBodyTransform / OverlapFilter.
    ensure("overlap: at the box's centre", physics_world.body_overlap_shape(ids[0], math.vec3(5.0, 0.0, 0.0), proxy, filter, identity_at(5.0, 0.0, 0.0)))
    ensure("overlap: far away", physics_world.body_overlap_shape(ids[0], math.vec3(20.0, 0.0, 0.0), proxy, filter, identity_at(5.0, 0.0, 0.0)) == false)
    ensure("overlap: the given transform decides", physics_world.body_overlap_shape(ids[0], math.vec3_zero(), proxy, filter, identity_at(0.0, 0.0, 0.0)) &&
                                                     physics_world.body_overlap_shape(ids[0], math.vec3_zero(), proxy, filter, identity_at(20.0, 0.0, 0.0)) == false)
    no_mask = shape.default_query_filter()
    no_mask.mask_bits = 0 as long
    ensure("overlap: a zero mask rejects", physics_world.body_overlap_shape(ids[0], math.vec3_zero(), proxy, no_mask, identity_at(0.0, 0.0, 0.0)) == false)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(box)

    // CastShapeRotatedBody.
    world_id = query_world(ids)
    dynamics.create_sphere_shape(ids[0], &sdef, manifold.sphere(math.vec3(0.0, 2.0, 0.0), 1.0))
    result = physics_world.body_cast_shape(ids[0], math.vec3_zero(), proxy, math.vec3(0.0 - 4.0, 0.0, 0.0), filter, 1.0, false, turned)
    ensure("shape cast turned: hit", result.hit)
    small("shape cast turned: fraction 0.125", result.fraction - 0.125, 0.01)
    small("shape cast turned: normal +x", result.normal.x - 1.0, 0.0001)
    small("shape cast turned: point at -1", result.point.x + 1.0, 0.001)
    dynamics.destroy_world(world_id)

    // MoverTouchesBox / MoverSeparated / MoverRotatedBody / MoverCapacity.
    world_id = query_world(ids)
    half = hull.make_box_hull(0.5, 0.5, 0.5)
    dynamics.create_hull_shape(ids[0], &sdef, half)
    planes_block = calloc(4, sizeof(BodyPlaneResult))
    planes = planes_block as BodyPlaneResult[]
    mover = Capsule { center1: math.vec3(0.0 - 0.3, 0.6, 0.0), center2: math.vec3(0.3, 0.6, 0.0), radius: 0.2 }
    count = physics_world.body_collide_mover(ids[0], planes, 4, math.vec3_zero(), mover, filter, identity_at(0.0, 0.0, 0.0))
    ensure("mover: one plane", count == 1 && dynamics.shape_is_valid(planes[0].shape_id))
    ensure("mover: the plane faces up", math.is_normalized(planes[0].result.plane.normal) && planes[0].result.plane.normal.y > 0.99)
    small("mover: a tenth in", planes[0].result.plane.offset - 0.1, 0.0001)
    mover.center1.y = 5.0
    mover.center2.y = 5.0
    ensure("mover: separated", physics_world.body_collide_mover(ids[0], planes, 4, math.vec3_zero(), mover, filter, identity_at(0.0, 0.0, 0.0)) == 0)
    mover = Capsule { center1: math.vec3(0.0 - 0.3, 0.0, 0.6), center2: math.vec3(0.3, 0.0, 0.6), radius: 0.2 }
    about_x = Transform { p: math.vec3_zero(), q: math.make_quat_from_axis_angle(math.vec3_axis_x(), 0.5 * math.PI) }
    count = physics_world.body_collide_mover(ids[0], planes, 4, math.vec3_zero(), mover, filter, about_x)
    ensure("mover turned: the plane faces +z", count == 1 && planes[0].result.plane.normal.z > 0.99)
    small("mover turned: a tenth in", planes[0].result.plane.offset - 0.1, 0.0001)
    dynamics.destroy_world(world_id)
    world_id = query_world(ids)
    dynamics.create_sphere_shape(ids[0], &sdef, manifold.sphere(math.vec3(0.0 - 0.4, 0.6, 0.0), 0.5))
    dynamics.create_sphere_shape(ids[0], &sdef, manifold.sphere(math.vec3(0.4, 0.6, 0.0), 0.5))
    mover = Capsule { center1: math.vec3(0.0 - 1.0, 0.0, 0.0), center2: math.vec3(1.0, 0.0, 0.0), radius: 0.2 }
    ensure("mover: capped at the capacity", physics_world.body_collide_mover(ids[0], planes, 1, math.vec3_zero(), mover, filter, identity_at(0.0, 0.0, 0.0)) == 1)
    ensure("mover: both spheres", physics_world.body_collide_mover(ids[0], planes, 4, math.vec3_zero(), mover, filter, identity_at(0.0, 0.0, 0.0)) == 2)
    dynamics.destroy_world(world_id)

    // MoverTOIHitsBox / Separated / Overlapped / ClosestShape.
    standing = Capsule { center1: math.vec3_zero(), center2: math.vec3(0.0, 1.0, 0.0), radius: 0.25 }
    world_id = query_world(ids)
    box_shape = dynamics.create_hull_shape(ids[0], &sdef, half)
    toi = physics_world.body_time_of_impact_mover(ids[0], math.vec3_zero(), standing, math.vec3(10.0, 0.0, 0.0), filter, identity_at(5.0, 0.0, 0.0), identity_at(5.0, 0.0, 0.0))
    small("mover toi: 4.25 of 10 free", toi.fraction - 0.425, 0.01)
    ensure("mover toi: normal -x", math.is_normalized(toi.normal) && math.abs_float(toi.normal.x + 1.0) < 0.001)
    ensure("mover toi: the shape identified", dynamics.shape_is_valid(toi.shape_id) && same_shape(toi.shape_id, box_shape))
    toi = physics_world.body_time_of_impact_mover(ids[0], math.vec3_zero(), standing, math.vec3(0.0, 10.0, 0.0), filter, identity_at(5.0, 0.0, 0.0), identity_at(5.0, 0.0, 0.0))
    ensure("mover toi: separated", math.abs_float(toi.fraction - 1.0) < 0.000001 && dynamics.shape_is_valid(toi.shape_id) == false)
    toi = physics_world.body_time_of_impact_mover(ids[0], math.vec3_zero(), standing, math.vec3(10.0, 0.0, 0.0), filter, identity_at(0.0, 0.0, 0.0), identity_at(0.0, 0.0, 0.0))
    ensure("mover toi: an overlap is ignored", math.abs_float(toi.fraction - 1.0) < 0.000001 && toi.shape_id.index1 == 0)
    dynamics.destroy_world(world_id)
    world_id = query_world(ids)
    other_def = dynamics.default_body_def()
    ids[1] = dynamics.create_body(world_id, &other_def)
    near_first = dynamics.create_sphere_shape(ids[0], &sdef, manifold.sphere(math.vec3(5.0, 0.0, 0.0), 0.5))
    dynamics.create_sphere_shape(ids[0], &sdef, manifold.sphere(math.vec3(9.0, 0.0, 0.0), 0.5))
    dynamics.create_sphere_shape(ids[1], &sdef, manifold.sphere(math.vec3(9.0, 0.0, 0.0), 0.5))
    near_last = dynamics.create_sphere_shape(ids[1], &sdef, manifold.sphere(math.vec3(5.0, 0.0, 0.0), 0.5))
    toi = physics_world.body_time_of_impact_mover(ids[0], math.vec3_zero(), standing, math.vec3(10.0, 0.0, 0.0), filter, identity_at(0.0, 0.0, 0.0), identity_at(0.0, 0.0, 0.0))
    ensure("mover toi: the nearer, listed first", same_shape(toi.shape_id, near_first))
    small("mover toi: its fraction (4.25 of 10)", toi.fraction - 0.425, 0.01)
    toi = physics_world.body_time_of_impact_mover(ids[1], math.vec3_zero(), standing, math.vec3(10.0, 0.0, 0.0), filter, identity_at(0.0, 0.0, 0.0), identity_at(0.0, 0.0, 0.0))
    ensure("mover toi: the nearer, listed last", same_shape(toi.shape_id, near_last))
    dynamics.destroy_world(world_id)
    hull.destroy_hull(half)
    free(planes_block)
    free(ids_block)
}

// test_body_query.c, the rest (#143): the hull-proxy overlaps, the
// compound on a turned body through both overlaps, and the mover's time
// of impact against one body in every case the reference asks.
hull_proxy(h: *HullData) -> ShapeProxy { return distance.shape_proxy(hull.hull_points(h) as ptr, h.vertex_count, 0.0) }

overlap_count(world_id: WorldId, origin: Vec3, proxy: ShapeProxy) -> int {
    counter = calloc(1, 4)
    physics_world.overlap_shape(world_id, origin, proxy, shape.default_query_filter(), count_overlap, counter)
    n = (counter as int[])[0]
    free(counter)
    return n
}

test_overlap_proxies() {
    // OverlapHullProxyEquivalence: a box baked about the target with a zero
    // origin finds what the same box at the local origin finds with the
    // target as origin; both miss far away.
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    bdef = dynamics.default_body_def()
    bdef.position = math.vec3(10.0, 0.0, 0.0)
    body = dynamics.create_body(world_id, &bdef)
    box = hull.make_box_hull(1.0, 1.0, 1.0)
    sdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(body, &sdef, box)
    physics_world.step(world_id, 1.0 / 60.0, 1)
    local = hull.make_box_hull(5.0, 5.0, 5.0)
    baked = hull.make_transformed_box_hull(5.0, 5.0, 5.0, identity_at(10.0, 0.0, 0.0))
    baked_hits = overlap_count(world_id, math.vec3_zero(), hull_proxy(baked))
    local_hits = overlap_count(world_id, math.vec3(10.0, 0.0, 0.0), hull_proxy(local))
    ensure("hull proxy: baked about the target, a hit (${baked_hits})", baked_hits == 1)
    ensure("hull proxy: the local box at the target's origin agrees (${local_hits})", local_hits == baked_hits)
    far = hull.make_transformed_box_hull(5.0, 5.0, 5.0, identity_at(100.0, 0.0, 0.0))
    baked_hits = overlap_count(world_id, math.vec3_zero(), hull_proxy(far))
    local_hits = overlap_count(world_id, math.vec3(100.0, 0.0, 0.0), hull_proxy(local))
    ensure("hull proxy: both miss far away", baked_hits == 0 && local_hits == 0)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(box)
    hull.destroy_hull(local)
    hull.destroy_hull(baked)
    hull.destroy_hull(far)
    // OverlapHullProxyRotation: a 4 m bar along x reaches a box at x = 3;
    // turned a quarter about y it lies along z and misses.
    world_id = dynamics.create_world(&wdef)
    bdef.position = math.vec3(3.0, 0.0, 0.0)
    body = dynamics.create_body(world_id, &bdef)
    cube = hull.make_box_hull(0.5, 0.5, 0.5)
    dynamics.create_hull_shape(body, &sdef, cube)
    physics_world.step(world_id, 1.0 / 60.0, 1)
    aligned = hull.make_transformed_box_hull(4.0, 0.3, 0.3, math.transform_identity())
    turned = hull.make_transformed_box_hull(4.0, 0.3, 0.3, Transform { p: math.vec3_zero(), q: math.make_quat_from_axis_angle(math.vec3_axis_y(), 0.5 * math.PI) })
    ensure("hull proxy: the bar along x reaches the box", overlap_count(world_id, math.vec3_zero(), hull_proxy(aligned)) == 1)
    ensure("hull proxy: turned along z it misses", overlap_count(world_id, math.vec3_zero(), hull_proxy(turned)) == 0)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(cube)
    hull.destroy_hull(aligned)
    hull.destroy_hull(turned)
    // OverlapCompoundRotatedBody: two sphere children at x = -3 and 3 on a
    // body turned a quarter about z at (10, 20, 30); a point on the second
    // child (swung to +y) overlaps, through the world and the body, and the
    // gap between them stays empty.
    world_id = dynamics.create_world(&wdef)
    mat = material.default_surface_material()
    spheres_block = calloc(2, sizeof(CompoundSphereDef))
    spheres = spheres_block as CompoundSphereDef[]
    spheres[0] = compound.compound_sphere_def(manifold.sphere(math.vec3(0.0 - 3.0, 0.0, 0.0), 0.5), mat)
    spheres[1] = compound.compound_sphere_def(manifold.sphere(math.vec3(3.0, 0.0, 0.0), 0.5), mat)
    cdef = compound.compound_def()
    cdef.spheres = spheres_block
    cdef.sphere_count = 2
    c = compound.create_compound(&cdef)
    pose = Transform { p: math.vec3(10.0, 20.0, 30.0), q: math.make_quat_from_axis_angle(math.vec3_axis_z(), 0.5 * math.PI) }
    cbdef = dynamics.default_body_def()
    cbdef.position = pose.p
    cbdef.rotation = pose.q
    holder = dynamics.create_body(world_id, &cbdef)
    dynamics.create_compound_shape(holder, &sdef, c)
    filter = shape.default_query_filter()
    on_child = math.transform_point(pose, math.vec3(3.0, 0.0, 0.0))
    ensure("compound on a turned body: the world overlap finds the second child", overlap_count(world_id, math.vec3_zero(), point_proxy(on_child, 0.1)) == 1)
    ensure("compound on a turned body: the body overlap too", physics_world.body_overlap_shape(holder, math.vec3_zero(), point_proxy(on_child, 0.1), filter, pose))
    in_gap = math.transform_point(pose, math.vec3_zero())
    ensure("compound on a turned body: the gap is empty to the world", overlap_count(world_id, math.vec3_zero(), point_proxy(in_gap, 0.25)) == 0)
    ensure("compound on a turned body: and to the body", physics_world.body_overlap_shape(holder, math.vec3_zero(), point_proxy(in_gap, 0.25), filter, pose) == false)
    dynamics.destroy_world(world_id)
    compound.destroy_compound(c)
    free(spheres_block)
}

var g_toi_seed: long = 0

// The reference test's XorShift32: 24 bits over [lower, upper].
toi_random(lower: float, upper: float) -> float {
    x = g_toi_seed
    x = (x ^ (x << 13)) & (4294967295 as long)
    x = x ^ (x >> 17)
    x = (x ^ (x << 5)) & (4294967295 as long)
    g_toi_seed = x
    unit = ((x >> 8) as float) / 16777216.0
    return lower + (upper - lower) * unit
}

toi_random_vector(lower: float, upper: float) -> Vec3 {
    x = toi_random(lower, upper)
    y = toi_random(lower, upper)
    z = toi_random(lower, upper)
    return math.vec3(x, y, z)
}

toi_random_direction() -> Vec3 {
    while true {
        v = toi_random_vector(0.0 - 1.0, 1.0)
        len = math.length(v)
        if 0.1 < len && len < 1.0 { return math.mul_sv(1.0 / len, v) }
    }
    return math.vec3_axis_x()
}

test_mover_time_of_impact() {
    ids_block = calloc(2, sizeof(BodyId))
    ids = ids_block as BodyId[]
    filter = shape.default_query_filter()
    sdef = dynamics.default_shape_def()
    standing = Capsule { center1: math.vec3_zero(), center2: math.vec3(0.0, 1.0, 0.0), radius: 0.25 }
    sweep = math.vec3(10.0, 0.0, 0.0)
    // MoverTOIKeepsHitAfterMiss: an off-path sphere listed last does not
    // erase the on-path hit.
    world_id = query_world(ids)
    dynamics.create_sphere_shape(ids[0], &sdef, manifold.sphere(math.vec3(5.0, 0.0, 20.0), 0.5))
    on_path = dynamics.create_sphere_shape(ids[0], &sdef, manifold.sphere(math.vec3(5.0, 0.0, 0.0), 0.5))
    toi = physics_world.body_time_of_impact_mover(ids[0], math.vec3_zero(), standing, sweep, filter, identity_at(0.0, 0.0, 0.0), identity_at(0.0, 0.0, 0.0))
    small("mover toi, a miss after the hit: the fraction", toi.fraction - 0.425, 0.01)
    ensure("mover toi, a miss after the hit: the on-path sphere", same_shape(toi.shape_id, on_path))
    dynamics.destroy_world(world_id)
    // MoverTOIMoverOffset: the mover and the body slid 2 m together.
    world_id = query_world(ids)
    box = hull.make_box_hull(0.5, 0.5, 0.5)
    dynamics.create_hull_shape(ids[0], &sdef, box)
    a = physics_world.body_time_of_impact_mover(ids[0], math.vec3_zero(), standing, sweep, filter, identity_at(5.0, 0.0, 0.0), identity_at(5.0, 0.0, 0.0))
    shifted = Capsule { center1: math.vec3(2.0, 0.0, 0.0), center2: math.vec3(2.0, 1.0, 0.0), radius: 0.25 }
    b = physics_world.body_time_of_impact_mover(ids[0], math.vec3_zero(), shifted, sweep, filter, identity_at(7.0, 0.0, 0.0), identity_at(7.0, 0.0, 0.0))
    small("mover toi, both moved: the same fraction", b.fraction - a.fraction, 0.0001)
    small("mover toi, both moved: the point moved by 2", b.point.x - a.point.x - 2.0, 0.001)
    // MoverTOIFarFromOrigin: a million metres out, the same fraction and
    // the point in the origin's frame.
    origin = math.vec3(1000000.0, 0.0 - 2000000.0, 500000.0)
    body_far = Transform { p: math.add(origin, math.vec3(5.0, 0.0, 0.0)), q: math.quat_identity() }
    toi = physics_world.body_time_of_impact_mover(ids[0], origin, standing, sweep, filter, body_far, body_far)
    small("mover toi, far out: the fraction", toi.fraction - 0.425, 0.01)
    small("mover toi, far out: the normal", toi.normal.x + 1.0, 0.001)
    small("mover toi, far out: the point in the origin's frame", (toi.point.x - origin.x) - 4.4, 0.5)
    // MoverTOIFilter: a zero mask rejects every category.
    no_mask = shape.default_query_filter()
    no_mask.mask_bits = 0 as long
    toi = physics_world.body_time_of_impact_mover(ids[0], math.vec3_zero(), standing, sweep, no_mask, identity_at(5.0, 0.0, 0.0), identity_at(5.0, 0.0, 0.0))
    small("mover toi, filtered: no hit", toi.fraction - 1.0, 0.000001)
    dynamics.destroy_world(world_id)
    // MoverTOIOverlapSkipsShape: the shape the mover starts in is skipped,
    // the one on its path still hit.
    world_id = query_world(ids)
    dynamics.create_hull_shape(ids[0], &sdef, box)
    offset_box = hull.make_offset_box_hull(0.5, 0.5, 0.5, math.vec3(5.0, 0.0, 0.0))
    on_box = dynamics.create_hull_shape(ids[0], &sdef, offset_box)
    toi = physics_world.body_time_of_impact_mover(ids[0], math.vec3_zero(), standing, sweep, filter, identity_at(0.0, 0.0, 0.0), identity_at(0.0, 0.0, 0.0))
    small("mover toi, started inside one: the other's fraction", toi.fraction - 0.425, 0.01)
    ensure("mover toi, started inside one: the other shape", same_shape(toi.shape_id, on_box))
    small("mover toi, started inside one: the normal", toi.normal.x + 1.0, 0.001)
    dynamics.destroy_world(world_id)
    // MoverTOIRotatingBody: a bar turning a quarter about y between the two
    // transforms reaches a mover its start pose clears.
    world_id = query_world(ids)
    bar = hull.make_box_hull(2.0, 0.25, 0.25)
    bar_shape = dynamics.create_hull_shape(ids[0], &sdef, bar)
    at = math.vec3(0.0, 0.0, 2.1)
    turned = Transform { p: math.vec3_zero(), q: math.make_quat_from_axis_angle(math.vec3_axis_y(), 0.5 * math.PI) }
    spinning = physics_world.body_time_of_impact_mover(ids[0], at, standing, math.vec3_zero(), filter, identity_at(0.0, 0.0, 0.0), turned)
    ensure("mover toi, a turning bar: a hit inside the sweep (${spinning.fraction})", 0.0 < spinning.fraction && spinning.fraction < 1.0)
    still = physics_world.body_time_of_impact_mover(ids[0], at, standing, math.vec3_zero(), filter, identity_at(0.0, 0.0, 0.0), identity_at(0.0, 0.0, 0.0))
    ensure("mover toi, the bar held still: clear", math.abs_float(still.fraction - 1.0) < 0.000001 && still.shape_id.index1 == 0)
    // MoverTOIMatchesSweep: 2,000 random movers, origins, translations and
    // body turns; the query agrees with the raw time of impact it builds,
    // any root strictly inside the sweep counting as a hit.
    g_toi_seed = 2654435769 as long
    points_block = calloc(2, sizeof(Vec3))
    points = points_block as Vec3[]
    hits = 0
    agree = true
    k = 0
    while k < 2000 {
        c1 = toi_random_vector(0.0 - 0.2, 0.2)
        length = toi_random(0.05, 1.5)
        c2 = math.mul_add(c1, length, toi_random_direction())
        radius = toi_random(0.05, 0.5)
        mover = Capsule { center1: c1, center2: c2, radius: radius }
        points[0] = c1
        points[1] = c2
        o = toi_random_vector(0.0 - 3.5, 3.5)
        travel = toi_random(0.0, 3.0)
        translation = math.mul_sv(travel, toi_random_direction())
        axis1 = toi_random_direction()
        angle1 = toi_random(0.0, math.PI)
        t1 = Transform { p: math.vec3_zero(), q: math.make_quat_from_axis_angle(axis1, angle1) }
        axis2 = toi_random_direction()
        angle2 = toi_random(0.001, math.PI)
        spin = math.make_quat_from_axis_angle(axis2, angle2)
        shift = toi_random_vector(0.0 - 1.0, 1.0)
        t2 = Transform { p: shift, q: math.mul_quat(spin, t1.q) }
        result = physics_world.body_time_of_impact_mover(ids[0], o, mover, translation, filter, t1, t2)
        xf1 = math.to_relative_transform(t1, o)
        xf2 = math.to_relative_transform(t2, o)
        input = TOIInput { proxy_a: hull_proxy(bar), proxy_b: distance.shape_proxy(points_block, 2, radius),
                           sweep_a: Sweep { local_center: math.vec3_zero(), c1: xf1.p, c2: xf2.p, q1: t1.q, q2: t2.q },
                           sweep_b: Sweep { local_center: math.vec3_zero(), c1: math.vec3_zero(), c2: translation, q1: math.quat_identity(), q2: math.quat_identity() },
                           max_fraction: 1.0 }
        raw = distance.time_of_impact(&input)
        if 0.0 < raw.fraction && raw.fraction < 1.0 {
            same = math.abs_float(result.fraction - raw.fraction) < 0.000001 && same_shape(result.shape_id, bar_shape) &&
                   math.is_normalized(result.normal) && math.length(math.sub(math.sub(result.point, o), raw.point)) < 0.0001
            if same == false { agree = false }
            hits = hits + 1
        } else {
            if math.abs_float(result.fraction - 1.0) >= 0.000001 || result.shape_id.index1 != 0 { agree = false }
        }
        k = k + 1
    }
    ensure("mover toi against the raw sweep: every case agrees (${hits} hits of 2000)", agree)
    ensure("mover toi against the raw sweep: some hits", hits > 0)
    dynamics.destroy_world(world_id)
    hull.destroy_hull(box)
    hull.destroy_hull(offset_box)
    hull.destroy_hull(bar)
    free(points_block)
    free(ids_block)
}

// --- the world queries ----------------------------------------------------------------------------------------------

count_overlap(id: ShapeId, context: ptr) -> bool {
    counter = context as int[]
    counter[0] = counter[0] + 1
    return true
}

count_and_clip(id: ShapeId, point: Vec3, normal: Vec3, fraction: float, material: long, triangle: int, child: int, context: ptr) -> float {
    counter = context as int[]
    counter[0] = counter[0] + 1
    return 1.0
}

count_planes(id: ShapeId, planes: PlaneResult[], count: int, context: ptr) -> bool {
    counter = context as int[]
    counter[0] = counter[0] + count
    return true
}

test_world_queries() {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    sdef = dynamics.default_shape_def()
    filter = shape.default_query_filter()
    // Three spheres along x at 5, 10 and 15, on two bodies (a static and a dynamic one).
    adef = dynamics.default_body_def()
    a = dynamics.create_body(world_id, &adef)
    first = dynamics.create_sphere_shape(a, &sdef, manifold.sphere(math.vec3(5.0, 0.0, 0.0), 1.0))
    dynamics.create_sphere_shape(a, &sdef, manifold.sphere(math.vec3(15.0, 0.0, 0.0), 1.0))
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.position = math.vec3(10.0, 0.0, 0.0)
    b = dynamics.create_body(world_id, &bdef)
    sdef.density = 1.0
    dynamics.create_sphere_shape(b, &sdef, manifold.sphere(math.vec3_zero(), 1.0))
    counter_block = calloc(1, 4)
    counter = counter_block as int[]
    // The closest ray hit is the first sphere.
    ray = physics_world.cast_ray_closest(world_id, math.vec3_zero(), math.vec3(20.0, 0.0, 0.0), filter)
    ensure("world ray: the first sphere", ray.hit && same_shape(ray.shape_id, first))
    small("world ray: fraction 0.2", ray.fraction - 0.2, 0.00001)
    small("world ray: point at 4", ray.point.x - 4.0, 0.0001)
    ensure("world ray: visited the trees", ray.node_visits > 0)
    ray = physics_world.cast_ray_closest(world_id, math.vec3(0.0, 5.0, 0.0), math.vec3(20.0, 0.0, 0.0), filter)
    ensure("world ray: miss", ray.hit == false)
    // Every hit along the ray with a callback that keeps going: three.
    counter[0] = 0
    physics_world.cast_ray(world_id, math.vec3_zero(), math.vec3(20.0, 0.0, 0.0), filter, count_and_clip, counter_block)
    ensure("world ray: all three (${counter[0]})", counter[0] == 3)
    // Overlaps by box and by proxy.
    counter[0] = 0
    physics_world.overlap_aabb(world_id, AABB { lower: math.vec3(3.0, 0.0 - 1.0, 0.0 - 1.0), upper: math.vec3(11.5, 1.0, 1.0) }, filter, count_overlap, counter_block)
    ensure("world overlap box: two (${counter[0]})", counter[0] == 2)
    counter[0] = 0
    physics_world.overlap_shape(world_id, math.vec3(10.0, 0.0, 0.0), point_proxy(math.vec3_zero(), 1.5), filter, count_overlap, counter_block)
    ensure("world overlap shape: the middle one (${counter[0]})", counter[0] == 1)
    counter[0] = 0
    physics_world.overlap_shape(world_id, math.vec3(10.0, 5.0, 0.0), point_proxy(math.vec3_zero(), 1.5), filter, count_overlap, counter_block)
    ensure("world overlap shape: none above", counter[0] == 0)
    // A shape cast along the row: three hits when nothing clips.
    counter[0] = 0
    physics_world.cast_shape(world_id, math.vec3_zero(), point_proxy(math.vec3_zero(), 0.25), math.vec3(20.0, 0.0, 0.0), filter, count_and_clip, counter_block)
    ensure("world shape cast: all three (${counter[0]})", counter[0] == 3)
    // The mover's cast stops before the first sphere; its planes near the first.
    standing = Capsule { center1: math.vec3_zero(), center2: math.vec3(0.0, 1.0, 0.0), radius: 0.25 }
    fraction = physics_world.cast_mover(world_id, math.vec3_zero(), standing, math.vec3(10.0, 0.0, 0.0), filter, false, count_overlap, null)
    ensure("world mover cast: stops at the first sphere (${fraction})", fraction > 0.35 && fraction < 0.4)
    counter[0] = 0
    physics_world.collide_mover(world_id, math.vec3(4.0, 0.0, 0.0), Capsule { center1: math.vec3(0.0, 0.0 - 0.5, 0.0), center2: math.vec3(0.0, 0.5, 0.0), radius: 0.3 }, filter, count_planes, counter_block)
    ensure("world mover planes: the first sphere's (${counter[0]})", counter[0] == 1)
    // The bounds and counters.
    bounds = physics_world.get_bounds(world_id)
    ensure("world bounds: spans the row", bounds.lower.x < 4.1 && bounds.upper.x > 15.9)
    counters = physics_world.get_counters(world_id)
    ensure("world counters", counters.body_count == 2 && counters.shape_count == 3 && counters.contact_count == 0)
    // Settings round trip.
    physics_world.set_gravity(world_id, math.vec3(0.0, 0.0 - 5.0, 0.0))
    ensure("gravity set", physics_world.get_gravity(world_id).y == 0.0 - 5.0)
    physics_world.set_hit_event_threshold(world_id, 2.0)
    ensure("hit threshold set", physics_world.get_hit_event_threshold(world_id) == 2.0)
    physics_world.enable_sleeping(world_id, false)
    ensure("sleeping off", physics_world.is_sleeping_enabled(world_id) == false)
    physics_world.enable_sleeping(world_id, true)
    ensure("sleeping on", physics_world.is_sleeping_enabled(world_id))
    ensure("one awake body", physics_world.get_awake_body_count(world_id) == 1)
    free(counter_block)
    dynamics.destroy_world(world_id)
}

// --- determinism ----------------------------------------------------------------------------------------------------

// A wave pile of cubes: the step every body fell asleep on, and a hash of the resting positions.
wave_pile(cube: *HullData) -> long {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 0.5, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    slab = hull.make_box_hull(20.0, 0.5, 20.0)
    gsdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(ground, &gsdef, slab)
    sdef = dynamics.default_shape_def()
    sdef.density = 1.0
    count = 60
    i = 0
    while i < count {
        bdef = dynamics.default_body_def()
        bdef.kind = dynamics.BODY_DYNAMIC
        x = (i % 6) as float * 1.1 - 2.75
        z = ((i / 6) % 5) as float * 1.1 - 2.2
        y = 1.0 + (i / 30) as float * 1.2 + 0.3 * math.sin_approx(0.7 * (i as float))
        bdef.position = math.vec3(x, y, z)
        id = dynamics.create_body(world_id, &bdef)
        dynamics.create_hull_shape(id, &sdef, cube)
        i = i + 1
    }
    sleep_step = 0
    step = 0
    while step < 600 && sleep_step == 0 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        step = step + 1
        if physics_world.get_awake_body_count(world_id) == 0 { sleep_step = step }
    }
    // The checksum: the positions summed with weights (no integer overflow, exact to compare).
    hash = 0.0
    i = 1
    while i <= count {
        p = dynamics.body_get_position(dynamics.make_body_id(dynamics.get_world(world_id.index1 - 1), i))
        hash = hash + p.x * 1.0 + p.y * 0.001 + p.z * 1000.0
        i = i + 1
    }
    dynamics.destroy_world(world_id)
    hull.destroy_hull(slab)
    println("physics_world: wave pile slept at step ${sleep_step}, checksum ${hash}")
    g_sleep_step = sleep_step
    return hash
}

var g_sleep_step = 0

test_determinism() {
    cube = hull.make_box_hull(0.5, 0.5, 0.5)
    first = wave_pile(cube)
    first_step = g_sleep_step
    second = wave_pile(cube)
    ensure("determinism: the wave pile repeats", first == second && g_sleep_step == first_step)
    ensure("determinism: it slept", first_step > 0)
    hull.destroy_hull(cube)
}

// The reference's TestHullDatabase: two shapes made from one hull hold one
// world-owned copy, not the caller's hull; a hull built again finds the
// same copy; setting a shape's hull to its own copy keeps it; destroying
// one shape keeps the other's; the world drains to no hulls. Past it: the
// caller frees its hull as soon as the shape is made and the shape still
// collides; transformed hulls bake once per transform and scale and are
// refused without volume; a hull given up by set_hull, by a change to a
// sphere or by its body's destruction goes when its last holder does; a
// world destroyed holding hulls frees them; nothing counted is left over.
test_hull_database() {
    before = basics.alloc_count()
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    box = hull.make_box_hull(0.5, 0.5, 0.5)
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    body_a = dynamics.create_body(world_id, &bdef)
    body_b = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    shape_a = dynamics.create_hull_shape(body_a, &sdef, box)
    shape_b = dynamics.create_hull_shape(body_b, &sdef, box)
    got_a = dynamics.shape_get_hull(shape_a)
    got_b = dynamics.shape_get_hull(shape_b)
    ensure("hull database: both shapes hold the one copy", got_a == got_b)
    ensure("hull database: the copy is the world's, not the caller's", got_a != box)
    ensure("hull database: one hull held", dynamics.world_hull_count(world_id) == 1)

    box2 = hull.make_box_hull(0.5, 0.5, 0.5)
    body_c = dynamics.create_body(world_id, &bdef)
    shape_c = dynamics.create_hull_shape(body_c, &sdef, box2)
    ensure("hull database: a box built again finds the same copy", dynamics.shape_get_hull(shape_c) == got_a)
    dynamics.destroy_shape(shape_c, true)
    hull.destroy_hull(box2)

    box3 = hull.make_box_hull(0.3, 0.3, 0.3)
    body_d = dynamics.create_body(world_id, &bdef)
    shape_d = dynamics.create_hull_shape(body_d, &sdef, box3)
    got_d = dynamics.shape_get_hull(shape_d)
    ensure("hull database: another hull is another copy", got_d != got_a && dynamics.world_hull_count(world_id) == 2)
    dynamics.shape_set_hull(shape_d, got_d)
    ensure("hull database: a shape's hull set to its own copy keeps it", dynamics.shape_get_hull(shape_d) == got_d && dynamics.world_hull_count(world_id) == 2)
    dynamics.destroy_shape(shape_d, true)
    ensure("hull database: its last holder gone, the copy goes", dynamics.world_hull_count(world_id) == 1)

    dynamics.destroy_shape(shape_a, true)
    ensure("hull database: one shape gone, the other's copy stays", dynamics.shape_get_hull(shape_b) == got_b && dynamics.world_hull_count(world_id) == 1)
    dynamics.destroy_shape(shape_b, true)
    ensure("hull database: drained", dynamics.world_hull_count(world_id) == 0)

    // The caller's hull freed at once: the shape still lands on the ground.
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 1.0, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    slab = hull.make_box_hull(20.0, 1.0, 20.0)
    dynamics.create_hull_shape(ground, &sdef, slab)
    hull.destroy_hull(slab)
    bdef.position = math.vec3(0.0, 2.0, 0.0)
    faller = dynamics.create_body(world_id, &bdef)
    temporary = hull.make_box_hull(0.5, 0.5, 0.5)
    falling = dynamics.create_hull_shape(faller, &sdef, temporary)
    hull.destroy_hull(temporary)
    i = 0
    while i < 120 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        i = i + 1
    }
    y = dynamics.body_get_position(faller).y
    ensure("hull database: a hull freed by its caller still collides (at ${y})", math.abs_float(y - 0.5) < 0.02)

    // Transformed hulls: baked once per transform and scale.
    xf = Transform { p: math.vec3(0.0, 0.25, 0.0), q: math.make_quat_from_axis_angle(math.vec3_axis_y(), 0.3) }
    held = dynamics.world_hull_count(world_id)
    body_e = dynamics.create_body(world_id, &bdef)
    t1 = dynamics.create_transformed_hull_shape(body_e, &sdef, box, xf, math.vec3(2.0, 1.0, 1.0))
    t2 = dynamics.create_transformed_hull_shape(body_e, &sdef, box, xf, math.vec3(2.0, 1.0, 1.0))
    ensure("hull database: one transform and scale baked once", dynamics.shape_get_hull(t1) == dynamics.shape_get_hull(t2) && dynamics.world_hull_count(world_id) == held + 1)
    stretched = dynamics.shape_get_hull(t1)
    ensure("hull database: the baked hull is stretched (${stretched.volume})", math.abs_float(stretched.volume - 2.0) < 0.000001)
    mirrored = dynamics.create_transformed_hull_shape(body_e, &sdef, box, xf, math.vec3(0.0 - 1.0, 1.0, 1.0))
    ensure("hull database: a mirror is its own hull, of the same volume", dynamics.shape_is_valid(mirrored) &&
           dynamics.world_hull_count(world_id) == held + 2 && math.abs_float(dynamics.shape_get_hull(mirrored).volume - 1.0) < 0.000001)
    // A zero scale is made safe, as the reference's b3SafeScale makes it:
    // the least scale, a thin hull of its own.
    flat = dynamics.create_transformed_hull_shape(body_e, &sdef, box, xf, math.vec3(1.0, 0.0, 1.0))
    ensure("hull database: a zero scale becomes the least scale, a thin hull", dynamics.shape_is_valid(flat) &&
           dynamics.world_hull_count(world_id) == held + 3 && math.abs_float(dynamics.shape_get_hull(flat).volume - math.MIN_SCALE) < 0.000001)
    ensure("hull database: no hull, no shape", dynamics.shape_is_valid(dynamics.create_transformed_hull_shape(body_e, &sdef, null, xf, math.vec3_one())) == false)
    nowhere = dynamics.create_hull_shape(dynamics.BodyId { index1: 0, world0: world_id.index1 - 1, generation: 0 }, &sdef, box)
    ensure("hull database: no body, no shape and no hull held", dynamics.shape_is_valid(nowhere) == false && dynamics.world_hull_count(world_id) == held + 3)

    // A hull given up by set_hull and by a change to a sphere.
    other = hull.make_box_hull(0.2, 0.4, 0.6)
    dynamics.shape_set_hull(t1, other)
    ensure("hull database: set to another hull, the baked one still held by its twin", dynamics.world_hull_count(world_id) == held + 4 &&
           dynamics.shape_get_hull(t2) == stretched)
    dynamics.shape_set_sphere(t2, Sphere { center: math.vec3_zero(), radius: 0.5 })
    ensure("hull database: its twin a sphere now, the baked hull goes", dynamics.world_hull_count(world_id) == held + 3)
    hull.destroy_hull(other)

    // Destroying the body gives up all of its hulls.
    dynamics.destroy_body(body_e)
    ensure("hull database: the body's hulls go with it", dynamics.world_hull_count(world_id) == held)

    // The world destroyed holding hulls frees them.
    ensure("hull database: the ground's and the faller's hulls held to the end", dynamics.world_hull_count(world_id) == 2 && dynamics.shape_is_valid(falling))
    dynamics.destroy_world(world_id)
    hull.destroy_hull(box)
    hull.destroy_hull(box3)
    ensure("hull database: nothing counted left over (${basics.alloc_count() - before})", basics.alloc_count() == before)
}

main() {
    dynamics.reserve_scratch()
    before = basics.alloc_count()
    test_hello_world()
    test_contact_events()
    test_hit_events()
    test_pre_solve()
    test_mesh_scale()
    test_fell_asleep()
    test_rebuilt_static_pairs()
    static_rebuild_keeps_marks(false)
    static_rebuild_keeps_marks(true)
    test_empty_world()
    test_destroy_all_bodies_world()
    test_world_recycle()
    test_world_coverage()
    test_set_bullet_drift()
    test_def_flags()
    test_compound_shape_count()
    test_enlarged_proxy_destroyed()
    test_ids()
    test_overflow_color_pile()
    test_set_worker_count()
    test_compound_hit_events()
    test_compound_contact_materials()
    test_broad_phase_stress()
    test_restitution()
    test_joint_springs_and_locks()
    test_parallel_bookkeeping()
    test_continuous_move_event()
    test_continuous_gravity()
    test_sensor_stepped()
    test_explosion()
    test_body_queries()
    test_overlap_proxies()
    test_mover_time_of_impact()
    test_world_queries()
    test_determinism()
    test_hull_database()
    // The scratch stays allocated: the worlds, the masses, the sweep and query buffers, the solvers' dummies (the modules' scratch is reserved before the count). The mover's planes are each query's own now, freed with it.
    ensure("every other counted allocation was freed (${basics.alloc_count() - before})", basics.alloc_count() == before + 8)
    println("physics_world: ${checks} checks")
    if failures == 0 {
        println("physics_world: all checks passed")
    } else {
        println("physics_world: ${failures} failure(s)")
        exit(1)
    }
}
