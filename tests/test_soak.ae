// aephysics soaked: seeded piles of every convex kind (boxes, spheres,
// capsules, hulls of random points), thrown spinning into a walled pen,
// stepped for fifteen seconds. Whatever the dice give, the world never
// makes energy (motion and height together never rise past where they
// began), no body moves faster than its fall allows, none gets through
// the walls, shapes that hit overlap no more than one step of their
// speed and at rest no more than the slop, and the pile falls asleep. The
// checks a crazy result fails: an explosion, a tunnel, a jitter that
// never settles.
//
// The reference (e77352c) on the same dice, its port drawing them in the
// same order, agrees nearly to the digit: the same starting energies to
// the joule, none gained, the fastest body 11.3546 m/s on seed 1 in both,
// the deepest overlap in the fall 0.160931 m against our 0.160922
// (dynamic bodies have no continuous collision in either, so a body
// meeting another at 9 m/s goes a step's 15 cm in before its contact
// exists), at rest 0.8 to 4.7 mm against our 0.6 to 5.0, every body
// asleep at the end in both.
import std.string
import aephysics.math
import aephysics.basics
import aephysics.hull
import aephysics.manifold
import aephysics.shape
import aephysics.dynamics
import aephysics.physics_world

extern exit(code: int)
extern sqrt(x: float) -> float

var failures = 0
var checks = 0

ensure(name: string, ok: bool) {
    checks = checks + 1
    if !ok {
        println("soak: FAIL ${name}")
        failures = failures + 1
    }
}

// xorshift32, as the determinism test's.
const RAND_LIMIT = 32767
const MASK32: long = 4294967295
var g_random_seed: long = 1

random_int() -> int {
    x = g_random_seed
    x = (x ^ (x << 13)) & MASK32
    x = x ^ (x >> 17)
    x = (x ^ (x << 5)) & MASK32
    g_random_seed = x
    return (x % ((RAND_LIMIT + 1) as long)) as int
}

random_float_range(lo: float, hi: float) -> float {
    r = (random_int() & RAND_LIMIT) as float
    return (hi - lo) * (r / (RAND_LIMIT as float)) + lo
}

random_vec3_uniform(lo: float, hi: float) -> Vec3 {
    x = random_float_range(lo, hi)
    y = random_float_range(lo, hi)
    z = random_float_range(lo, hi)
    return math.vec3(x, y, z)
}

// The draws are made one statement at a time: C fixes no order for a
// call's arguments, and the reference's port must draw the same dice.
random_quat() -> Quat {
    v = random_vec3_uniform(0.0 - 1.0, 1.0)
    w = random_float_range(0.0 - 1.0, 1.0)
    return math.normalize_quat(math.quat_vs(v, w))
}

const SIDE = 4
const LAYERS = 4
const BODY_COUNT = 64
const SPACING = 1.8
const STEPS = 900
const GRAVITY = 10.0
const PEN = 7.0

// Shapes hold their hulls: kept until the world is gone.
var g_hulls: ptr = null
var g_hull_count = 0

keep(h: *HullData) {
    (g_hulls as ptr[])[g_hull_count] = h as ptr
    g_hull_count = g_hull_count + 1
}

free_hulls() {
    i = 0
    while i < g_hull_count {
        hull.destroy_hull((g_hulls as ptr[])[i] as *HullData)
        i = i + 1
    }
    g_hull_count = 0
}

// The motion and height of every body: half m v squared, half w.Iw in the
// body's frame, m g y at its centre of mass.
energy_of(bodies: BodyId[]) -> float {
    total = 0.0
    i = 0
    while i < BODY_COUNT {
        id = bodies[i]
        md = dynamics.body_get_mass_data(id)
        v = dynamics.body_get_linear_velocity(id)
        w = math.inv_rotate_vector(dynamics.body_get_rotation(id), dynamics.body_get_angular_velocity(id))
        total = total + 0.5 * md.mass * math.dot(v, v) + 0.5 * math.dot(w, math.mul_mv(md.inertia, w)) +
                md.mass * GRAVITY * dynamics.body_get_world_center(id).y
        i = i + 1
    }
    return total
}

kinetic_of(bodies: BodyId[]) -> float {
    total = 0.0
    i = 0
    while i < BODY_COUNT {
        id = bodies[i]
        md = dynamics.body_get_mass_data(id)
        v = dynamics.body_get_linear_velocity(id)
        w = math.inv_rotate_vector(dynamics.body_get_rotation(id), dynamics.body_get_angular_velocity(id))
        total = total + 0.5 * md.mass * math.dot(v, v) + 0.5 * math.dot(w, math.mul_mv(md.inertia, w))
        i = i + 1
    }
    return total
}

// One body of a kind the dice pick: a box, a sphere, a capsule or a hull
// of random points, each fitting the spacing so none starts touching.
add_body(world_id: WorldId, p: Vec3) -> BodyId {
    bdef = dynamics.default_body_def()
    bdef.kind = dynamics.BODY_DYNAMIC
    bdef.position = p
    bdef.rotation = random_quat()
    bdef.linear_velocity = random_vec3_uniform(0.0 - 2.0, 2.0)
    bdef.angular_velocity = random_vec3_uniform(0.0 - 3.0, 3.0)
    body = dynamics.create_body(world_id, &bdef)
    sdef = dynamics.default_shape_def()
    sdef.base_material.restitution = random_float_range(0.0, 0.6)
    // A ball on a flat floor rolls for ever: a little resistance lets it stop.
    sdef.base_material.rolling_resistance = 0.05
    kind = random_int() % 4
    if kind == 0 {
        hx = random_float_range(0.1, 0.5)
        hy = random_float_range(0.1, 0.5)
        hz = random_float_range(0.1, 0.5)
        box = hull.make_box_hull(hx, hy, hz)
        dynamics.create_hull_shape(body, &sdef, box)
        keep(box)
    } else if kind == 1 {
        radius = random_float_range(0.1, 0.4)
        dynamics.create_sphere_shape(body, &sdef, manifold.sphere(math.vec3_zero(), radius))
    } else if kind == 2 {
        half = random_float_range(0.1, 0.4)
        radius = random_float_range(0.1, 0.3)
        dynamics.create_capsule_shape(body, &sdef, manifold.capsule(math.vec3(0.0, 0.0 - half, 0.0), math.vec3(0.0, half, 0.0), radius))
    } else {
        points_block = basics.alloc(12 * sizeof(Vec3))
        points = points_block as Vec3[]
        k = 0
        while k < 12 {
            points[k] = random_vec3_uniform(0.0 - 0.4, 0.4)
            k = k + 1
        }
        h = hull.create_hull(points, 12, 12)
        if h == null {
            dynamics.create_sphere_shape(body, &sdef, manifold.sphere(math.vec3_zero(), 0.3))
        } else {
            dynamics.create_hull_shape(body, &sdef, h)
            keep(h)
        }
        basics.free_bytes(points_block, 12 * sizeof(Vec3))
    }
    return body
}

// The deepest any two shapes touching on a body overlap: the most negative
// separation of its contacts' points.
var g_contacts: ptr = null
const CONTACT_CAPACITY = 64

deepest_on(id: BodyId) -> float {
    data = g_contacts as ContactData[]
    count = dynamics.body_get_contact_data(id, data, CONTACT_CAPACITY)
    deepest = 0.0
    i = 0
    while i < count {
        k = 0
        while k < data[i].manifold_count {
            m = (data[i].manifolds + k * sizeof(Manifold)) as *Manifold
            j = 0
            while j < m.point_count {
                deepest = math.min_float(deepest, dynamics.manifold_point_at(m, j).separation)
                j = j + 1
            }
            k = k + 1
        }
        i = i + 1
    }
    return deepest
}

soak(seed: int) {
    g_random_seed = seed as long
    wdef = dynamics.default_world_def()
    wdef.gravity = math.vec3(0.0, 0.0 - GRAVITY, 0.0)
    world_id = dynamics.create_world(&wdef)
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 0.5, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    // A floor walled in four metres past the pile on every side.
    gsdef = dynamics.default_shape_def()
    floor = hull.make_box_hull(PEN, 0.5, PEN)
    dynamics.create_hull_shape(ground, &gsdef, floor)
    keep(floor)
    wall_x = hull.make_offset_box_hull(0.5, 3.0, PEN, math.vec3(PEN + 0.5, 3.0, 0.0))
    dynamics.create_hull_shape(ground, &gsdef, wall_x)
    keep(wall_x)
    wall_nx = hull.make_offset_box_hull(0.5, 3.0, PEN, math.vec3(0.0 - PEN - 0.5, 3.0, 0.0))
    dynamics.create_hull_shape(ground, &gsdef, wall_nx)
    keep(wall_nx)
    wall_z = hull.make_offset_box_hull(PEN, 3.0, 0.5, math.vec3(0.0, 3.0, PEN + 0.5))
    dynamics.create_hull_shape(ground, &gsdef, wall_z)
    keep(wall_z)
    wall_nz = hull.make_offset_box_hull(PEN, 3.0, 0.5, math.vec3(0.0, 3.0, 0.0 - PEN - 0.5))
    dynamics.create_hull_shape(ground, &gsdef, wall_nz)
    keep(wall_nz)

    bodies_block = basics.alloc(BODY_COUNT * sizeof(BodyId))
    bodies = bodies_block as BodyId[]
    top = 0.0
    n = 0
    layer = 0
    while layer < LAYERS {
        row = 0
        while row < SIDE {
            column = 0
            while column < SIDE {
                p = math.vec3(SPACING * ((column as float) - 1.5), 1.0 + SPACING * (layer as float), SPACING * ((row as float) - 1.5))
                top = math.max_float(top, p.y)
                bodies[n] = add_body(world_id, p)
                n = n + 1
                column = column + 1
            }
            row = row + 1
        }
        layer = layer + 1
    }

    start = energy_of(bodies)
    // The fastest any body may go: thrown at up to 2 m/s per axis from the
    // top layer, it falls the whole height; spin adds its rim's speed.
    speed_cap = 1.25 * sqrt(12.0 + 2.0 * GRAVITY * (top + 1.0)) + 6.0
    peak = start
    fastest = 0.0
    lowest = 0.0
    farthest = 0.0
    finite = true
    s = 0
    while s < STEPS {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        i = 0
        while i < BODY_COUNT {
            id = bodies[i]
            p = dynamics.body_get_position(id)
            v = dynamics.body_get_linear_velocity(id)
            if math.is_valid_vec3(p) == false || math.is_valid_vec3(v) == false || math.is_valid_quat(dynamics.body_get_rotation(id)) == false {
                finite = false
            }
            fastest = math.max_float(fastest, math.length(v))
            lowest = math.min_float(lowest, deepest_on(id))
            farthest = math.max_float(farthest, math.max_float(math.abs_float(p.x), math.abs_float(p.z)))
            i = i + 1
        }
        peak = math.max_float(peak, energy_of(bodies))
        s = s + 1
    }
    rest = kinetic_of(bodies)
    resting_deepest = 0.0
    i = 0
    while i < BODY_COUNT {
        resting_deepest = math.min_float(resting_deepest, deepest_on(bodies[i]))
        i = i + 1
    }
    awake = physics_world.get_awake_body_count(world_id)
    // The energy that can be lost: from the start down to every body on the ground.
    span = start
    rise = (peak - start) / span
    println("soak: seed ${seed}: energy ${start} J, highest ${peak} J (+${rise * 100.0}%), fastest ${fastest} m/s (cap ${speed_cap}), deepest overlap ${lowest} m, at rest ${resting_deepest} m, farthest ${farthest} m, resting motion ${rest} J, awake ${awake}")
    ensure("seed ${seed}: every body stays finite", finite)
    ensure("seed ${seed}: the world makes no energy (+${rise * 100.0}% at the most)", rise < 0.01)
    ensure("seed ${seed}: no body outruns its fall (${fastest} m/s)", fastest < speed_cap)
    ensure("seed ${seed}: shapes that hit overlap no more than a step of their speed (${lowest} m)", lowest > 0.0 - fastest / 60.0 - 0.02)
    ensure("seed ${seed}: at rest they overlap no more than the slop allows (${resting_deepest} m)", resting_deepest > 0.0 - 0.01)
    ensure("seed ${seed}: no body gets through the walls (${farthest} m out)", farthest < PEN)
    ensure("seed ${seed}: the pile comes to rest (${rest} J of ${start} J moving, ${awake} awake)", rest < 0.001 * start)
    basics.free_bytes(bodies_block, BODY_COUNT * sizeof(BodyId))
    dynamics.destroy_world(world_id)
    free_hulls()
}

main() {
    g_hulls = basics.alloc((BODY_COUNT + 5) * 8)
    g_contacts = basics.alloc(CONTACT_CAPACITY * sizeof(ContactData))
    soak(1)
    soak(7)
    soak(42)
    soak(2026)
    println("soak: ${checks} checks")
    if failures == 0 {
        println("soak: all checks passed")
    } else {
        println("soak: ${failures} failure(s)")
        exit(1)
    }
}
