// aephysics.human's checks: the figure builds as the reference's (twelve
// bodies, eleven joints of the right kinds, three filter joints), falls
// onto a slab and sleeps in one piece (every joint intact, the bones
// within reach of their parents), stands under the align spring, holds
// its pose on motor anchors and on parallel anchors, takes a kick, and
// its friction, spring and damping setters reach every joint; two
// figures dropped alike land alike.
import std.string
import aephysics.math
import aephysics.basics
import aephysics.hull
import aephysics.manifold
import aephysics.shape
import aephysics.dynamics
import aephysics.joint_solver
import aephysics.human
import aephysics.physics_world

extern calloc(count: int, size: int) -> ptr
extern exit(code: int)
extern free(p: ptr)
extern atan2(y: float, x: float) -> float

var failures = 0
var checks = 0

ensure(name: string, ok: bool) {
    checks = checks + 1
    if !ok {
        println("human: FAIL ${name}")
        failures = failures + 1
    }
}

// A world with a slab for the figure to land on (the world keeps the
// hull by reference: it lives until main ends).
var g_slab: ptr = null

world_with_ground() -> WorldId {
    wdef = dynamics.default_world_def()
    world_id = dynamics.create_world(&wdef)
    gdef = dynamics.default_body_def()
    gdef.position = math.vec3(0.0, 0.0 - 1.0, 0.0)
    ground = dynamics.create_body(world_id, &gdef)
    sdef = dynamics.default_shape_def()
    dynamics.create_hull_shape(ground, &sdef, g_slab as *HullData)
    return world_id
}

ground_of(world_id: WorldId) -> BodyId { return dynamics.make_body_id(dynamics.get_world(world_id.index1 - 1), 0) }

// The farthest any bone's joint anchor sits from its parent's: a joint torn would show here.
worst_joint_separation(h: *Human) -> float {
    worst = 0.0
    i = 1
    while i < human.BONE_COUNT {
        bone = human.bone_at(h, i)
        separation = dynamics.joint_get_linear_separation(bone.joint_id)
        if separation > worst { worst = separation }
        i = i + 1
    }
    return worst
}

steps(world_id: WorldId, count: int) {
    s = 0
    while s < count {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        s = s + 1
    }
}

// The bones' positions, for comparing two figures.
positions(h: *Human) -> ptr {
    block = calloc(human.BONE_COUNT, sizeof(Vec3))
    p = block as Vec3[]
    i = 0
    while i < human.BONE_COUNT {
        p[i] = dynamics.body_get_position(human.bone_at(h, i).body_id)
        i = i + 1
    }
    return block
}

test_build_and_fall() {
    world_id = world_with_ground()
    h = Human { bones: null, filter_joints: null, filter_joint_count: 0, friction_torque: 0.0, is_spawned: false }
    human.create_human(&h, world_id, math.vec3(0.0, 1.0, 0.0), 5.0, 1.0, 0.7, 1, null)
    ensure("built: spawned", h.is_spawned)
    ensure("built: three filter joints", h.filter_joint_count == human.FILTER_JOINT_COUNT)
    counters = physics_world.get_counters(world_id)
    ensure("built: 13 bodies, 14 joints (${counters.body_count}, ${counters.joint_count})", counters.body_count == 13 && counters.joint_count == 14)
    spherical = 0
    revolute = 0
    i = 1
    while i < human.BONE_COUNT {
        bone = human.bone_at(&h, i)
        ensure("built: bone ${i} has a valid joint to bone ${bone.parent_index}", dynamics.joint_is_valid(bone.joint_id) && bone.parent_index >= 0 && bone.parent_index < i)
        kind = dynamics.joint_get_type(bone.joint_id)
        if kind == dynamics.JOINT_SPHERICAL { spherical = spherical + 1 }
        if kind == dynamics.JOINT_REVOLUTE { revolute = revolute + 1 }
        i = i + 1
    }
    ensure("built: seven spherical and four revolute joints (${spherical}, ${revolute})", spherical == 7 && revolute == 4)
    ensure("built: the pelvis has no joint", dynamics.joint_is_valid(human.bone_at(&h, human.BONE_PELVIS).joint_id) == false)
    ensure("built: the joints start closed", worst_joint_separation(&h) < 0.001)
    // The bones' capsules are readable back, the calf's shin and foot among them.
    shapes_block = calloc(4, sizeof(ShapeId))
    shapes = shapes_block as ShapeId[]
    calf_shapes = dynamics.body_get_shapes(human.bone_at(&h, human.BONE_CALF_L).body_id, shapes, 4)
    ensure("built: the calf carries two capsules (${calf_shapes})", calf_shapes == 2 && dynamics.shape_get_type(shapes[0]) == shape.SHAPE_CAPSULE && dynamics.shape_get_type(shapes[1]) == shape.SHAPE_CAPSULE)
    if calf_shapes == 2 {
        // The list runs newest first: the foot, then the shin.
        foot = dynamics.shape_get_capsule(shapes[0])
        shin = dynamics.shape_get_capsule(shapes[1])
        ensure("built: the shin and foot capsules read back (${shin.radius}, ${foot.radius})", math.abs_float(shin.radius - 0.08) < 0.000001 && math.abs_float(foot.radius - 0.07) < 0.000001)
    }
    free(shapes_block)
    head_before = dynamics.body_get_position(human.bone_at(&h, human.BONE_NECK).body_id)
    ensure("built: the head is up (${head_before.y})", head_before.y > 2.3)

    // The figure falls from a metre and comes to rest in one piece.
    slept = 0
    s = 0
    while s < 900 && slept == 0 {
        physics_world.step(world_id, 1.0 / 60.0, 4)
        s = s + 1
        if physics_world.get_awake_body_count(world_id) == 0 { slept = s }
    }
    ensure("fall: the figure slept (step ${slept})", slept > 0)
    ensure("fall: the joints held (${worst_joint_separation(&h)})", worst_joint_separation(&h) < 0.01)
    lowest = 100.0
    highest = 0.0 - 100.0
    i = 0
    while i < human.BONE_COUNT {
        y = dynamics.body_get_position(human.bone_at(&h, i).body_id).y
        if y < lowest { lowest = y }
        if y > highest { highest = y }
        i = i + 1
    }
    ensure("fall: it lies on the slab (${lowest}, ${highest})", lowest > 0.0 && highest < 0.8)
    // The contacts under it are readable per body: the calves' feet touch the slab.
    contacts_block = calloc(8, sizeof(ContactData))
    contacts = contacts_block as ContactData[]
    touching = 0
    i = 0
    while i < human.BONE_COUNT {
        touching = touching + dynamics.body_get_contact_data(human.bone_at(&h, i).body_id, contacts, 8)
        i = i + 1
    }
    ensure("fall: bones touch the slab or each other (${touching} contacts)", touching >= 4)
    count = dynamics.body_get_contact_data(human.bone_at(&h, human.BONE_PELVIS).body_id, contacts, 8)
    if count > 0 {
        ensure("fall: the pelvis's first contact has a manifold with points and a normal", contacts[0].manifold_count >= 1 && (contacts[0].manifolds as *Manifold).point_count >= 1 && math.is_normalized((contacts[0].manifolds as *Manifold).normal))
    }
    free(contacts_block)

    // The setters reach every joint.
    human.human_set_joint_friction_torque(&h, 2.0)
    ensure("setters: the friction torque is kept", h.friction_torque == 2.0)
    lower_arm = human.bone_at(&h, human.BONE_LOWER_ARM_L)
    ensure("setters: the elbow's motor torque scaled by its friction (${joint_solver.revolute_joint_get_max_motor_torque(lower_arm.joint_id)})",
           math.abs_float(joint_solver.revolute_joint_get_max_motor_torque(lower_arm.joint_id) - 0.12) < 0.0001)
    human.human_set_joint_spring_hertz(&h, 3.0)
    human.human_set_joint_damping_ratio(&h, 0.5)
    spine = human.bone_at(&h, human.BONE_SPINE_01)
    ensure("setters: the spine's spring", joint_solver.spherical_joint_get_spring_hertz(spine.joint_id) == 3.0 && joint_solver.spherical_joint_get_spring_damping_ratio(spine.joint_id) == 0.5)
    ensure("setters: the elbow's spring", joint_solver.revolute_joint_get_spring_hertz(lower_arm.joint_id) == 3.0 && joint_solver.revolute_joint_get_spring_damping_ratio(lower_arm.joint_id) == 0.5)
    human.human_set_bullet(&h, true)
    ensure("setters: every bone a bullet", dynamics.body_is_bullet(human.bone_at(&h, human.BONE_CALF_R).body_id))
    human.human_set_bullet(&h, false)
    ensure("setters: and back", dynamics.body_is_bullet(human.bone_at(&h, human.BONE_CALF_R).body_id) == false)

    // A kick wakes it and sets it turning.
    human.human_set_velocity(&h, math.vec3(0.0, 2.0, 0.0))
    human.human_apply_angular_impulse(&h, math.vec3(0.0, 0.0, 3.0))
    ensure("kick: awake (${physics_world.get_awake_body_count(world_id)})", physics_world.get_awake_body_count(world_id) == 12)
    ensure("kick: the spine spins", math.length(dynamics.body_get_angular_velocity(spine.body_id)) > 1.0)
    ensure("kick: the head rises", dynamics.body_get_linear_velocity(human.bone_at(&h, human.BONE_NECK).body_id).y > 1.9)

    human.destroy_human(&h)
    ensure("destroyed: nothing left but the ground", physics_world.get_counters(world_id).body_count == 1 && physics_world.get_counters(world_id).joint_count == 0)
    dynamics.destroy_world(world_id)
}

test_align_spring() {
    world_id = world_with_ground()
    h = Human { bones: null, filter_joints: null, filter_joint_count: 0, friction_torque: 0.0, is_spawned: false }
    human.create_human(&h, world_id, math.vec3(0.0, 0.05, 0.0), 5.0, 1.0, 0.7, 1, null)
    human.human_align_spring(&h, world_id, ground_of(world_id), 25.0, 1.0)
    pelvis = human.bone_at(&h, human.BONE_PELVIS)
    ensure("align: the pelvis got its joint", dynamics.joint_is_valid(pelvis.joint_id))
    steps(world_id, 240)
    // The joint's frame on the pelvis was built with its z up; the spring keeps it so.
    frame_b = dynamics.joint_get_local_frame_b(pelvis.joint_id)
    up = math.rotate_vector(dynamics.body_get_rotation(pelvis.body_id), math.rotate_vector(frame_b.q, math.vec3_axis_z()))
    ensure("align: the pelvis stays upright after four seconds (${up.y})", up.y > 0.95)
    pelvis_y = dynamics.body_get_position(pelvis.body_id).y
    ensure("align: the pelvis stays off the ground (${pelvis_y})", pelvis_y > 0.3)
    human.destroy_human(&h)
    dynamics.destroy_world(world_id)
}

// Anchors hold the pose against gravity: after two seconds every bone is
// within a hand of where it started.
drift_on_anchors(parallel: bool) -> float {
    world_id = world_with_ground()
    h = Human { bones: null, filter_joints: null, filter_joint_count: 0, friction_torque: 0.0, is_spawned: false }
    human.create_human(&h, world_id, math.vec3(0.0, 1.0, 0.0), 5.0, 0.0, 0.7, 1, null)
    if parallel { human.human_create_parallel_anchors(&h, world_id) } else { human.human_create_motor_anchors(&h, world_id) }
    before = positions(&h)
    steps(world_id, 120)
    after = positions(&h)
    a = before as Vec3[]
    b = after as Vec3[]
    worst = 0.0
    i = 0
    while i < human.BONE_COUNT {
        d = math.distance(a[i], b[i])
        if d > worst { worst = d }
        i = i + 1
    }
    free(before)
    free(after)
    ensure("anchors: an anchor and its joint per bone", dynamics.body_is_valid(human.bone_at(&h, human.BONE_NECK).anchor_id) && dynamics.joint_is_valid(human.bone_at(&h, human.BONE_NECK).anchor_joint_id))
    // Let go: the anchors are gone, the figure falls.
    human.human_destroy_anchors(&h)
    ensure("anchors: let go, none is left on a bone", dynamics.body_is_valid(human.bone_at(&h, human.BONE_NECK).anchor_id) == false && dynamics.joint_is_valid(human.bone_at(&h, human.BONE_NECK).anchor_joint_id) == false)
    ensure("anchors: let go, the world holds the figure and the ground alone", physics_world.get_counters(world_id).body_count == 1 + human.BONE_COUNT)
    human.destroy_human(&h)
    ensure("anchors: destroyed with the figure", physics_world.get_counters(world_id).body_count == 1)
    dynamics.destroy_world(world_id)
    return worst
}

test_anchors() {
    motor = drift_on_anchors(false)
    ensure("motor anchors hold the pose in the air (${motor})", motor < 0.15)
    // Parallel anchors hold rotation only: the figure falls but keeps its shape.
    parallel = drift_on_anchors(true)
    ensure("parallel anchors let it fall (${parallel})", parallel > 0.3)
}

// The anchors driven: every anchor's target moved two metres along x
// over two seconds, and the figure walks there behind them, the pelvis
// within a hand of its target and the shape kept.
test_driven_anchors() {
    world_id = world_with_ground()
    h = Human { bones: null, filter_joints: null, filter_joint_count: 0, friction_torque: 0.0, is_spawned: false }
    human.create_human(&h, world_id, math.vec3(0.0, 1.0, 0.0), 5.0, 0.0, 0.7, 1, null)
    ensure("driven: no anchors before they are made", human.human_has_anchors(&h) == false)
    human.human_create_motor_anchors(&h, world_id)
    ensure("driven: anchors made", human.human_has_anchors(&h))
    rest = positions(&h)
    at_rest = rest as Vec3[]
    step = 1.0 / 60.0
    k = 1
    while k <= 120 {
        along = 2.0 * (k as float) / 120.0
        i = 0
        while i < human.BONE_COUNT {
            target = Transform { p: math.add(at_rest[i], math.vec3(along, 0.0, 0.0)), q: dynamics.body_get_rotation(human.bone_at(&h, i).anchor_id) }
            human.human_set_anchor_target(&h, i, target, step)
            i = i + 1
        }
        physics_world.step(world_id, step, 4)
        k = k + 1
    }
    pelvis = dynamics.body_get_position(human.bone_at(&h, human.BONE_PELVIS).body_id)
    ensure("driven: the pelvis followed its anchor two metres along (${pelvis.x})", math.abs_float(pelvis.x - 2.0) < 0.15 && math.abs_float(pelvis.y - at_rest[human.BONE_PELVIS].y) < 0.15)
    neck = dynamics.body_get_position(human.bone_at(&h, human.BONE_NECK).body_id)
    ensure("driven: the neck came along above it (${neck.y})", neck.y > pelvis.y + 0.3 && math.abs_float(neck.x - 2.0) < 0.3)
    human.human_set_anchor_target(&h, human.BONE_NECK, Transform { p: math.vec3(0.0, 0.0, 0.0), q: math.quat_identity() }, step)
    free(rest)
    human.human_destroy_anchors(&h)
    ensure("driven: let go, no anchors", human.human_has_anchors(&h) == false)
    human.human_set_anchor_target(&h, human.BONE_NECK, Transform { p: math.vec3(0.0, 0.0, 0.0), q: math.quat_identity() }, step)
    human.destroy_human(&h)
    dynamics.destroy_world(world_id)
}

// --- a shape fitted to a rig ------------------------------------------------------------------

// The landmarks of a shape: heads, tails (Vec3[BONE_COUNT] each) and the
// two toes (Vec3[2]), in one block of 2 * BONE_COUNT + 2.
landmarks(shape: ptr) -> ptr {
    block = calloc(2 * human.BONE_COUNT + 2, sizeof(Vec3))
    v = block as Vec3[]
    i = 0
    while i < human.BONE_COUNT {
        v[i] = human.human_shape_head(shape, i)
        v[human.BONE_COUNT + i] = human.human_shape_tail(shape, i)
        i = i + 1
    }
    v[2 * human.BONE_COUNT] = human.human_shape_toe(shape, human.BONE_CALF_L)
    v[2 * human.BONE_COUNT + 1] = human.human_shape_toe(shape, human.BONE_CALF_R)
    return block
}

near_vec(a: Vec3, b: Vec3, within: float) -> bool { return math.length(math.sub(a, b)) < within }

// The angle between two lines, radians.
angle_between(a: Vec3, b: Vec3) -> float {
    return atan2(math.length(math.cross(a, b)), math.dot(a, b))
}

// A joint's rest angle in a shape: the bone's joint frame against its parent's.
rest_angle(shape: ptr, index: int) -> Quat {
    spec = human.spec_at(shape, index)
    parent = human.spec_at(shape, spec.parent)
    qa = math.mul_quat(parent.reference.q, spec.frame_a.q)
    qb = math.mul_quat(spec.reference.q, spec.frame_b.q)
    return math.inv_mul_quat(qa, qb)
}

same_rotation(a: Quat, b: Quat) -> bool { return math.abs_float(math.dot_quat(math.normalize_quat(a), math.normalize_quat(b))) > 0.999999 }

// Fitted to its own landmarks, the reference's shape is the reference's
// (its joints' frames to 10 um: the reference rounds them to one).
test_fit_identity() {
    shape = human.human_reference_shape()
    reference = human.human_reference_shape()
    block = landmarks(shape)
    human.human_fit_shape(shape, block, block + human.BONE_COUNT * sizeof(Vec3), block + 2 * human.BONE_COUNT * sizeof(Vec3))
    same = true
    i = 0
    while i < human.BONE_COUNT {
        a = human.spec_at(shape, i)
        b = human.spec_at(reference, i)
        if !near_vec(a.reference.p, b.reference.p, 0.000001) || !same_rotation(a.reference.q, b.reference.q) { same = false }
        if !near_vec(a.capsule.center1, b.capsule.center1, 0.000001) || !near_vec(a.capsule.center2, b.capsule.center2, 0.000001) { same = false }
        if math.abs_float(a.capsule.radius - b.capsule.radius) > 0.000001 { same = false }
        if a.has_foot && (!near_vec(a.foot.center1, b.foot.center1, 0.000001) || !near_vec(a.foot.center2, b.foot.center2, 0.000001)) { same = false }
        if i > 0 && (!near_vec(a.frame_a.p, b.frame_a.p, 0.00001) || !same_rotation(a.frame_a.q, b.frame_a.q)) { same = false }
        i = i + 1
    }
    ensure("fit: the reference fitted to its own landmarks is the reference", same)
    free(block)
    free(shape)
    free(reference)
}

// A rig of the reference's size with the spine curved as MPFB's is (the
// lower spine leaning 7.6 degrees forward, the chest 9 back, the neck's
// base 14 cm forward of the chest's) and the left toe turned out 20
// degrees: the fitted shape puts every joint at the rig's, runs every
// bone along the rig's line, keeps every joint's rest angle, turns the
// foot, and builds a figure whose joints start closed and which lands
// in one piece.
test_fit_curved() {
    shape = human.human_reference_shape()
    reference = human.human_reference_shape()
    block = landmarks(reference)
    v = block as Vec3[]
    heads = block
    tails = block + human.BONE_COUNT * sizeof(Vec3)
    toes = block + 2 * human.BONE_COUNT * sizeof(Vec3)
    tail_at = tails as Vec3[]
    toe_at = toes as Vec3[]
    // Forward: the way the toes point, level.
    fl = math.sub(toe_at[0], tail_at[human.BONE_CALF_L])
    fr = math.sub(toe_at[1], tail_at[human.BONE_CALF_R])
    forward = math.normalize(math.vec3(fl.x + fr.x, 0.0, fl.z + fr.z))
    side = math.cross(math.vec3(0.0, 1.0, 0.0), forward)
    // The spine, curved: each segment's length kept, its line turned.
    spine = v[human.BONE_SPINE_01]
    lower = math.length(math.sub(v[human.BONE_SPINE_03], spine))
    chest_at = math.mul_add(spine, lower, math.rotate_vector(math.make_quat_from_axis_angle(side, 0.1326), math.vec3(0.0, 1.0, 0.0)))
    upper = math.length(math.sub(v[human.BONE_NECK], v[human.BONE_SPINE_03]))
    neck_at = math.mul_add(math.mul_add(chest_at, upper, math.rotate_vector(math.make_quat_from_axis_angle(side, 0.0 - 0.157), math.vec3(0.0, 1.0, 0.0))), 0.14, forward)
    moved = math.sub(neck_at, v[human.BONE_NECK])
    v[human.BONE_SPINE_03] = chest_at
    v[human.BONE_NECK] = neck_at
    v[human.BONE_UPPER_ARM_L] = math.add(v[human.BONE_UPPER_ARM_L], moved)
    v[human.BONE_UPPER_ARM_R] = math.add(v[human.BONE_UPPER_ARM_R], moved)
    v[human.BONE_LOWER_ARM_L] = math.add(v[human.BONE_LOWER_ARM_L], moved)
    v[human.BONE_LOWER_ARM_R] = math.add(v[human.BONE_LOWER_ARM_R], moved)
    tail_at[human.BONE_SPINE_01] = chest_at
    tail_at[human.BONE_SPINE_03] = neck_at
    tail_at[human.BONE_NECK] = math.add(tail_at[human.BONE_NECK], moved)
    tail_at[human.BONE_UPPER_ARM_L] = v[human.BONE_LOWER_ARM_L]
    tail_at[human.BONE_UPPER_ARM_R] = v[human.BONE_LOWER_ARM_R]
    tail_at[human.BONE_LOWER_ARM_L] = math.add(tail_at[human.BONE_LOWER_ARM_L], moved)
    tail_at[human.BONE_LOWER_ARM_R] = math.add(tail_at[human.BONE_LOWER_ARM_R], moved)
    // The left toe turned out about the shin.
    shin = math.normalize(math.sub(tail_at[human.BONE_CALF_L], v[human.BONE_CALF_L]))
    toe_at[0] = math.add(tail_at[human.BONE_CALF_L], math.rotate_vector(math.make_quat_from_axis_angle(shin, 0.349), math.sub(toe_at[0], tail_at[human.BONE_CALF_L])))
    human.human_fit_shape(shape, heads, tails, toes)

    worst_head = 0.0
    worst_line = 0.0
    worst_rest = 1.0
    i = 0
    while i < human.BONE_COUNT {
        off = math.length(math.sub(human.human_shape_head(shape, i), v[i]))
        if off > worst_head { worst_head = off }
        line = angle_between(math.sub(human.human_shape_tail(shape, i), human.human_shape_head(shape, i)), math.sub(tail_at[i], v[i]))
        if line > worst_line { worst_line = line }
        if i > 0 {
            d = math.abs_float(math.dot_quat(math.normalize_quat(rest_angle(shape, i)), math.normalize_quat(rest_angle(reference, i))))
            if d < worst_rest { worst_rest = d }
            // The joint's frame on the parent sits at the bone's head.
            spec = human.spec_at(shape, i)
            at = math.transform_point(human.spec_at(shape, spec.parent).reference, spec.frame_a.p)
            off = math.length(math.sub(at, v[i]))
            if off > worst_head { worst_head = off }
        }
        i = i + 1
    }
    ensure("fit: every joint at the rig's (${worst_head * 1000.0} mm off)", worst_head < 0.000001)
    ensure("fit: every bone along the rig's line (${worst_line} rad off)", worst_line < 0.0001)
    ensure("fit: every joint's rest angle kept (${worst_rest})", worst_rest > 0.999999)
    ensure("fit: the chest's line runs forward to the neck's base as the rig's does", math.dot(math.sub(human.human_shape_tail(shape, human.BONE_SPINE_03), human.human_shape_head(shape, human.BONE_SPINE_03)), forward) > 0.05)
    toe = math.sub(human.human_shape_toe(shape, human.BONE_CALF_L), tail_at[human.BONE_CALF_L])
    want = math.sub(toe_at[0], tail_at[human.BONE_CALF_L])
    toe_off = angle_between(math.sub(toe, math.mul_sv(math.dot(toe, shin), shin)), math.sub(want, math.mul_sv(math.dot(want, shin), shin)))
    ensure("fit: the left foot turned out to the rig's toe (${toe_off} rad off)", toe_off < 0.001)
    ensure("fit: the right foot as it was", near_vec(human.human_shape_toe(shape, human.BONE_CALF_R), toe_at[1], 0.000001))

    // Built, its joints start closed and its bodies are where the shape put them.
    world_id = world_with_ground()
    h = Human { bones: null, filter_joints: null, filter_joint_count: 0, friction_torque: 0.0, is_spawned: false }
    human.create_human_shaped(&h, world_id, Transform { p: math.vec3(0.0, 0.5, 0.0), q: math.make_quat_from_axis_angle(math.vec3(0.0, 1.0, 0.0), 0.7) }, shape, 5.0, 1.0, 0.7, 1, null)
    ensure("fit: the curved figure's joints start closed (${worst_joint_separation(&h)})", worst_joint_separation(&h) < 0.001)
    calf = human.bone_at(&h, human.BONE_CALF_L)
    ensure("fit: a calf knows its shin from its foot", dynamics.shape_get_capsule(calf.shape_id).radius > dynamics.shape_get_capsule(calf.foot_shape_id).radius &&
        dynamics.shape_is_valid(human.bone_at(&h, human.BONE_THIGH_L).foot_shape_id) == false)
    steps(world_id, 600)
    ensure("fit: the curved figure lands in one piece (${worst_joint_separation(&h)})", worst_joint_separation(&h) < 0.05)
    human.destroy_human(&h)
    dynamics.destroy_world(world_id)
    free(block)
    free(shape)
    free(reference)
}

// The same figure dropped in two worlds lands bit for bit alike.
drop_alone() -> ptr {
    world_id = world_with_ground()
    h = Human { bones: null, filter_joints: null, filter_joint_count: 0, friction_torque: 0.0, is_spawned: false }
    human.create_human(&h, world_id, math.vec3(0.0, 1.5, 0.0), 5.0, 1.0, 0.7, 1, null)
    human.human_apply_angular_impulse(&h, math.vec3(1.0, 2.0, 3.0))
    steps(world_id, 300)
    p = positions(&h)
    human.destroy_human(&h)
    dynamics.destroy_world(world_id)
    return p
}

test_alike() {
    pa_block = drop_alone()
    pb_block = drop_alone()
    pa = pa_block as Vec3[]
    pb = pb_block as Vec3[]
    same = true
    i = 0
    while i < human.BONE_COUNT {
        if pa[i].x != pb[i].x || pa[i].y != pb[i].y || pa[i].z != pb[i].z { same = false }
        i = i + 1
    }
    ensure("alike: the same figure dropped twice lands bit for bit alike", same)
    ensure("alike: it moved (${pa[human.BONE_NECK].y})", pa[human.BONE_NECK].y < 1.5)
    free(pa_block)
    free(pb_block)
}

main() {
    g_slab = hull.make_box_hull(20.0, 1.0, 20.0) as ptr
    test_build_and_fall()
    test_align_spring()
    test_anchors()
    test_driven_anchors()
    test_alike()
    test_fit_identity()
    test_fit_curved()
    hull.destroy_hull(g_slab as *HullData)
    println("human: ${checks} checks")
    if failures == 0 {
        println("human: all checks passed")
    } else {
        println("human: ${failures} failure(s)")
        exit(1)
    }
}
